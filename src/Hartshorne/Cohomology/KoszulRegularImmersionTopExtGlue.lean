import Hartshorne.Cohomology.KoszulRegularImmersionTopExtRestrictIso
import Hartshorne.RingedSpace.ModuleRestrictGlue

/-!
# Local top-Ext isomorphisms on sections

Towards gluing the local isomorphisms `ℰxt^r_Y(i_* 𝒪_X, M)|_{V} ≅ (i_* i^* M)|_{V}` of a
Koszul-regular immersion:

* change of Koszul-regular generators: two Koszul-regular sequences generating the same ideal `I`
  differ by a matrix whose determinant is a unit modulo `I`
  (`Hartshorne.Koszul.exists_vecMul_eq_det_isUnit_mod`);
* the local isomorphisms on `V` and on a smaller Koszul chart `W ⊆ V` induce the same maps on
  sections over the opens contained in `W`
  (`Hartshorne.KoszulImmersion.localApp_localTopExtIso_inv_restrict`).
-/

universe u

open CategoryTheory Opposite TopologicalSpace

/- Sections of restricted and transported modules are only definitionally sections of the
original modules. -/
set_option backward.isDefEq.respectTransparency false

namespace Hartshorne

namespace Koszul

variable {A : Type u} [CommRing A] {r : ℕ}

/-- If every `gⱼ` lies in the ideal generated by `f₁, …, f_r`, then `g = f Q` for a matrix `Q`. -/
theorem exists_vecMul_eq_of_span_le (f g : Fin r → A)
    (h : Ideal.span (Set.range g) ≤ Ideal.span (Set.range f)) :
    ∃ Q : Matrix (Fin r) (Fin r) A, Matrix.vecMul f Q = g := by
  have hc : ∀ j, ∃ c : Fin r → A, ∑ i, c i • f i = g j := fun j =>
    (Submodule.mem_span_range_iff_exists_fun A).mp (h (Ideal.subset_span ⟨j, rfl⟩))
  choose c hc using hc
  refine ⟨Matrix.of fun i j => c j i, funext fun j => ?_⟩
  rw [← hc j]
  simp only [Matrix.vecMul, dotProduct, Matrix.of_apply, smul_eq_mul, mul_comm]

/-- **Self-transitions of a Koszul-regular sequence are trivial modulo the ideal.** If `f` is
Koszul-regular on `A` and `f Q = f`, then `Q ≡ 1` entrywise modulo `I = (f₁, …, f_r)`. -/
theorem sub_one_mem_of_vecMul_eq_self {f : Fin r → A} (hf : IsKoszulRegular f (ModuleCat.of A A))
    (Q : Matrix (Fin r) (Fin r) A) (hQ : Matrix.vecMul f Q = f) (i j : Fin r) :
    (Q - 1) i j ∈ Ideal.span (Set.range f) := by
  refine mem_of_sum_mul_mem_sq f hf (fun i => (Q - 1) i j) ?_ i
  have h : ∑ i, (Q - 1) i j * f i = Matrix.vecMul f Q j - f j := by
    simp only [Matrix.sub_apply, sub_mul, Finset.sum_sub_distrib, Matrix.vecMul, dotProduct,
      mul_comm (f _)]
    congr 1
    rw [Finset.sum_eq_single j (fun b _ hb => by rw [Matrix.one_apply_ne hb, zero_mul])
      (fun h => absurd (Finset.mem_univ j) h), Matrix.one_apply_eq, one_mul]
  rw [h, hQ, sub_self]
  exact Submodule.zero_mem _

/-- If `Q ≡ 1` entrywise modulo an ideal `I`, then `det Q ≡ 1` modulo `I`. -/
theorem det_sub_one_mem {I : Ideal A} (Q : Matrix (Fin r) (Fin r) A)
    (hQ : ∀ i j, (Q - 1) i j ∈ I) : Q.det - 1 ∈ I := by
  rw [← Ideal.Quotient.eq, RingHom.map_det, map_one]
  have : (Ideal.Quotient.mk I).mapMatrix Q = 1 := by
    ext i j
    have h : Ideal.Quotient.mk I (Q i j) =
        Ideal.Quotient.mk I ((1 : Matrix (Fin r) (Fin r) A) i j) :=
      Ideal.Quotient.eq.mpr (by simpa only [Matrix.sub_apply] using hQ i j)
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, h, Matrix.one_apply, Matrix.one_apply]
    split_ifs <;> simp
  rw [this, Matrix.det_one]

/-- **Change of Koszul-regular generators.** If `f` and `g` are Koszul-regular sequences of the
same length generating the same ideal `I`, then `g = f Q` for a matrix `Q` whose determinant is a
unit modulo `I`: there is `c` with `det Q · c ≡ 1` modulo `I`. -/
theorem exists_vecMul_eq_det_isUnit_mod {f g : Fin r → A}
    (hf : IsKoszulRegular f (ModuleCat.of A A))
    (h : Ideal.span (Set.range g) = Ideal.span (Set.range f)) :
    ∃ Q : Matrix (Fin r) (Fin r) A, Matrix.vecMul f Q = g ∧
      ∃ c : A, Q.det * c - 1 ∈ Ideal.span (Set.range f) := by
  obtain ⟨Q, hQ⟩ := exists_vecMul_eq_of_span_le f g h.le
  obtain ⟨P, hP⟩ := exists_vecMul_eq_of_span_le g f h.ge
  refine ⟨Q, hQ, P.det, ?_⟩
  rw [← Matrix.det_mul]
  refine det_sub_one_mem _ (sub_one_mem_of_vecMul_eq_self hf _ ?_)
  rw [← Matrix.vecMul_vecMul, hQ, hP]

end Koszul

namespace Ringed

namespace RestrictGlue

open SheafExtRestrict Transport RestrictCompose

variable {X : TopCat.{u}} {R : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}
  {E T : SheafOfModules.{u} (ringCatSheafOf R)}

/-- If a morphism `φ` on `U` restricted to the open `V'` of `U` corresponds to a morphism `φ'` on
the open `V` of `X` underlying `V'` (through `restrictCompIsoApp`), then `φ` and `φ'` induce the
same maps on sections over the opens of `X` contained in `V`. -/
lemma localApp_eq_of_restrictCompIsoApp {U : Opens X} {V' : Opens ((Opens.toTopCat X).obj U)}
    (φ : (moduleRestrict U).obj E ⟶ (moduleRestrict U).obj T)
    (φ' : (moduleRestrict ((incl U).obj V')).obj E ⟶ (moduleRestrict ((incl U).obj V')).obj T)
    (heq : (moduleRestrict (R := restrictRingSheaf R U) V').map φ ≫
        (restrictCompIsoApp U V' R T).hom =
      (restrictCompIsoApp U V' R E).hom ≫ (transport (ringTransport U V' R)).map φ')
    {O : Opens X} (hO : O ≤ (incl U).obj V') (x : E.val.obj (op O)) :
    localApp φ (hO.trans (show (incl U).obj V' ≤ U from functor_obj_le V')) x =
      localApp φ' hO x := by
  have hOU : O ≤ U := hO.trans (show (incl U).obj V' ≤ U from functor_obj_le V')
  have hsub : subOpen U O ≤ V' := by
    have : subOpen U O ≤ subOpen U ((incl U).obj V') := (Opens.map U.inclusion').monotone hO
    exact this.trans (Opens.map_functor_eq V').le
  let W'' := subOpen V' (subOpen U O)
  let c := V'.isOpenEmbedding.functor.obj W''
  have hc : U.isOpenEmbedding.functor.obj c = O := by
    simp only [c, W'']
    rw [functor_obj_subOpen hsub, functor_obj_subOpen hOU]
  let c' := (opensEquiv (homeo U V')).functor.obj W''
  have hc' : ((incl U).obj V').isOpenEmbedding.functor.obj c' = O :=
    (le_antisymm (jB_le_jA U V' W'') (jA_le_jB U V' W'')).trans hc
  rw [localApp_eq_of_functor_obj_eq φ hOU c hc, localApp_eq_of_functor_obj_eq φ' hO c' hc']
  have key := congrArg (fun g => g.val.app (op W'') (E.val.map (homOfLE hc.le).op x)) heq
  change T.val.map (homOfLE (jB_le_jA U V' W'')).op (φ.val.app (op c)
      (E.val.map (homOfLE hc.le).op x)) = φ'.val.app (op c')
        (E.val.map (homOfLE (jB_le_jA U V' W'')).op (E.val.map (homOfLE hc.le).op x)) at key
  rw [map_map] at key
  rw [← key, map_map]

end RestrictGlue

end Ringed

namespace KoszulImmersion

open AlgebraicGeometry Koszul Ringed.KoszulSheaf Ringed.Transport Ringed.RestrictCompose
  Ringed.SheafExtRestrict Ringed.RestrictGlue

variable {Y : Scheme.{u}} {X : Scheme.{u}} (i : X ⟶ Y) {s : ℕ} (M : Y.Modules)

/-- `localTopExtIso_restrict` for the inverse isomorphisms. -/
lemma localTopExtIso_inv_restrict {V₀ : Y.Opens} (W' : Opens ((Opens.toTopCat Y).obj V₀))
    (hV₀ : IsAffineOpen V₀) (f : Fin (s + 1) → Γ(Y, V₀)) [IsClosedImmersion i]
    [M.IsQuasicoherent] (hI : i.ker.ideal ⟨V₀, hV₀⟩ = Ideal.span (Set.range f))
    (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, V₀) Γ(Y, V₀)))
    (hW : IsAffineOpen ((incl V₀).obj W'))
    (hI' : i.ker.ideal ⟨_, hW⟩ = Ideal.span (Set.range (fun j => resRing W' (f j))))
    (hf' : IsKoszulRegular (fun j => resRing W' (f j))
      (ModuleCat.of Γ(Y, (incl V₀).obj W') Γ(Y, (incl V₀).obj W'))) :
    (Ringed.moduleRestrict W').map (localTopExtIso hV₀ i f M hI hf).inv ≫
        (restrictCompIsoApp V₀ W' Y.sheaf ((Ringed.sheafExt (R := Y.sheaf)
          ((Scheme.Modules.pushforward i).obj (SheafOfModules.unit X.ringCatSheaf)) (s + 1)).obj
            M)).hom =
      (restrictCompIsoApp V₀ W' Y.sheaf
          ((Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M))).hom ≫
        (transport (ringTransport V₀ W' Y.sheaf)).map
          (localTopExtIso hW i (fun j => resRing W' (f j)) M hI' hf').inv := by
  have h := localTopExtIso_restrict W' hV₀ i f M hI hf hW hI' hf'
  change ((Ringed.moduleRestrict W').mapIso (localTopExtIso hV₀ i f M hI hf)).inv ≫ _ =
    _ ≫ ((transport (ringTransport V₀ W' Y.sheaf)).mapIso
      (localTopExtIso hW i (fun j => resRing W' (f j)) M hI' hf')).inv
  rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
  exact h.symm

/-- **Local top-Ext isomorphisms on sections, for a smaller chart.** Let `V` be an affine open on
which the ideal of `i` is generated by a Koszul-regular sequence `f`, and `W ⊆ V` an affine open on
which the restricted sequence has the same properties. Then the inverses of the local
isomorphisms `ℰxt^r_Y(i_* 𝒪_X, M)|_{V} ≅ (i_* i^* M)|_{V}` and
`ℰxt^r_Y(i_* 𝒪_X, M)|_{W} ≅ (i_* i^* M)|_{W}` induce the same maps on sections over every open
contained in `W`. -/
theorem localApp_localTopExtIso_inv_restrict [IsClosedImmersion i] [M.IsQuasicoherent]
    {V W : Y.Opens} (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V)
    (f : Fin (s + 1) → Γ(Y, V)) (hI : i.ker.ideal ⟨V, hV⟩ = Ideal.span (Set.range f))
    (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, V) Γ(Y, V)))
    (hI' : i.ker.ideal ⟨W, hW⟩ =
      Ideal.span (Set.range (fun j => Y.presheaf.map (homOfLE hWV).op (f j))))
    (hf' : IsKoszulRegular (fun j => Y.presheaf.map (homOfLE hWV).op (f j))
      (ModuleCat.of Γ(Y, W) Γ(Y, W)))
    {U : Y.Opens} (hU : U ≤ W)
    (x : ((Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M)).val.obj
      (op U)) :
    localApp (localTopExtIso hV i f M hI hf).inv (hU.trans hWV) x =
      localApp (localTopExtIso hW i _ M hI' hf').inv hU x := by
  obtain ⟨W', rfl⟩ : ∃ W' : Opens ((Opens.toTopCat Y).obj V), (incl V).obj W' = W :=
    ⟨subOpen V W, functor_obj_subOpen hWV⟩
  exact localApp_eq_of_restrictCompIsoApp _ _
    (localTopExtIso_inv_restrict i M W' hV f hI hf hW hI' hf') hU x

end KoszulImmersion

end Hartshorne
