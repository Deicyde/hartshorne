import Hartshorne.Scheme.QuasicoherentAbelianClosure
import Hartshorne.Cohomology.ModuleSheavesEnoughInjectives
import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.Subobject

/-!
# Coherent subsheaves of a quasi-coherent sheaf

Hartshorne II, Exercise 5.15(e).  Let `X` be a locally Noetherian scheme and `F` a
quasi-coherent `𝒪_X`-module.  A coherent subsheaf of `F` is a subobject of `F` in the category
of `𝒪_X`-modules whose underlying module is coherent.

We show:

* the kernel and the image of a morphism from a coherent module to a quasi-coherent module are
  coherent (on an affine open `Spec A` this is the statement that a submodule of a finitely
  generated module over a Noetherian ring is finitely generated);
* consequently the sum of two coherent subsheaves (the image of their direct sum) is coherent,
  and the zero subsheaf is coherent, so the poset of coherent subsheaves of `F` is filtered;
* the coherent subsheaves form a diagram in `𝒪_X`-modules with a canonical cocone with vertex
  `F` given by the inclusions;
* in a Grothendieck abelian category, a directed family of subobjects of `X` whose supremum is
  `X` has the inclusions as a colimit cocone; `𝒪_X`-modules form such a category;
* hence the cocone of coherent subsheaves is a colimit cocone as soon as every local section of
  `F` is a section of some coherent subsheaf of `F`.

That last hypothesis holds on a Noetherian scheme by the extension statement of
Hartshorne II, Exercise 5.15(d), applied to the subsheaf generated by a local section; this is
done in `Hartshorne.Cohomology.QuasicoherentFilteredUnionCoherent`.
-/

open CategoryTheory CategoryTheory.Limits

namespace Hartshorne

open AlgebraicGeometry QuasicoherentAbelianAux

universe w v u' u

noncomputable section

section General

variable {C : Type u'} [Category.{v} C] {X : C}

/-- The diagram of a family of subobjects of `X`, given by a predicate, ordered by inclusion. -/
@[simps]
def subobjectFamilyDiagram (p : Subobject X → Prop) : {P : Subobject X // p P} ⥤ C where
  obj P := (P.1 : C)
  map h := Subobject.ofLE _ _ (leOfHom h)
  map_id P := by simp
  map_comp h h' := by simp

/-- The cocone with vertex `X` over a family of subobjects of `X`, given by the inclusions. -/
@[simps]
def subobjectFamilyCocone (p : Subobject X → Prop) : Cocone (subobjectFamilyDiagram p) where
  pt := X
  ι :=
    { app P := P.1.arrow
      naturality := by
        intros
        exact (Subobject.ofLE_arrow _).trans (Category.comp_id _).symm }

/-- In a Grothendieck abelian category, a directed family of subobjects of `X` whose supremum is
`X` has `X` as its colimit, the inclusions forming a colimit cocone. -/
theorem nonempty_isColimit_subobjectFamilyCocone [Abelian C] [IsGrothendieckAbelian.{w} C]
    (p : Subobject X → Prop) [IsDirectedOrder {P : Subobject X // p P}]
    [Nonempty {P : Subobject X // p P}] (h : ⨆ P : {P : Subobject X // p P}, P.1 = ⊤) :
    Nonempty (IsColimit (subobjectFamilyCocone p)) := by
  let Q := {P : Subobject X // p P}
  have : Small.{w} Q := small_subtype _ _
  let J := Shrink.{w} Q
  let _ : Preorder J := Preorder.lift (equivShrink Q).symm
  let _ : SmallCategory J := Preorder.smallCategory J
  let e : J ≃o Q := { toEquiv := (equivShrink Q).symm, map_rel_iff' := Iff.rfl }
  have : IsFiltered J := IsFiltered.of_equivalence e.equivalence.symm
  let G : J ⥤ MonoOver X :=
    e.equivalence.functor ⋙ (show Monotone (fun P : Q => P.1) from fun _ _ h => h).functor ⋙
      Subobject.representative
  let c : Cocone (G ⋙ MonoOver.forget X) :=
    { pt := Over.mk (𝟙 X)
      ι :=
        { app j := Over.homMk (e j).1.arrow ((Category.comp_id _).trans rfl)
          naturality j j' f := by
            ext
            exact (MonoOver.w (G.map f)).trans (Category.comp_id _).symm } }
  have : Mono c.pt.hom := inferInstanceAs (Mono (𝟙 X))
  have hc : Subobject.mk c.pt.hom = ⨆ j, Subobject.mk (G.obj j).obj.hom := by
    have h' : ⨆ j, (e j).1 = ⊤ := by
      rw [← h]
      exact e.toEquiv.iSup_comp (g := fun P : Q => P.1)
    simpa [c, G, ← Subobject.top_eq_id] using h'.symm
  have hcol := IsGrothendieckAbelian.isColimitMapCoconeOfSubobjectMkEqISup G c hc
  exact ⟨IsColimit.ofWhiskerEquivalence e.equivalence hcol⟩

end General

variable {X : Scheme.{u}}

/-- On a locally Noetherian scheme, the kernel of a morphism from a coherent module to a
quasi-coherent module is coherent. -/
theorem isCoherent_kernel_of_isQuasicoherent [IsLocallyNoetherian X] {A F : X.Modules}
    (f : A ⟶ F) (hA : IsCoherent A) [F.IsQuasicoherent] : IsCoherent (kernel f) := by
  rw [isCoherent_iff_forall_isFiniteTilde] at hA ⊢
  intro U
  have := isNoetherianRing_affineOpen U
  obtain ⟨M, hM, ⟨eA⟩⟩ := hA U
  have hF := (isQuasicoherent_iff_forall_essImage F).mp inferInstance U
  refine ⟨_, ?_, ⟨kernelTildeIso eA hF.getIso _ ≪≫ (specRestrictionKernelIso f U).symm⟩⟩
  exact Module.Finite.of_injective
    (kernel.ι ((tilde.functor _).preimage
      (eA.hom ≫ (specRestrictFunctor U).map f ≫ hF.getIso.inv))).hom
    ((ModuleCat.mono_iff_injective _).mp inferInstance)

/-- On a locally Noetherian scheme, the image of a morphism from a coherent module to a
quasi-coherent module is coherent. -/
theorem isCoherent_image_of_isQuasicoherent [IsLocallyNoetherian X] {A F : X.Modules}
    (f : A ⟶ F) (hA : IsCoherent A) [F.IsQuasicoherent] : IsCoherent (image f) :=
  isCoherent_of_iso (Abelian.coimageIsoImage' f)
    (isCoherent_cokernel _ (isCoherent_kernel_of_isQuasicoherent f hA) hA)

variable (F : X.Modules)

/-- The coherent subsheaves of an `𝒪_X`-module `F`: subobjects of `F` whose underlying module
is coherent, ordered by inclusion. -/
abbrev CoherentSubobject : Type (u + 1) :=
  {P : Subobject F // IsCoherent (P : X.Modules)}

/-- The zero subsheaf is coherent. -/
instance : Nonempty (CoherentSubobject F) :=
  ⟨⟨⊥, isCoherent_of_isZero (IsZero.of_iso (isZero_zero _) Subobject.botCoeIsoZero)⟩⟩

/-- On a locally Noetherian scheme, any two coherent subsheaves of a quasi-coherent module are
contained in a third one, namely the image of their direct sum. -/
instance [IsLocallyNoetherian X] [F.IsQuasicoherent] : IsDirectedOrder (CoherentSubobject F) where
  directed P Q := by
    let g : (P.1 : X.Modules) ⊞ (Q.1 : X.Modules) ⟶ F := biprod.desc P.1.arrow Q.1.arrow
    have hsum : IsCoherent ((P.1 : X.Modules) ⊞ (Q.1 : X.Modules)) :=
      isCoherent_of_iso (biprod.isoProd _ _).symm
        ((coherentModules X).prop_prod _ _ P.2 Q.2)
    refine ⟨⟨imageSubobject g, isCoherent_of_iso (imageSubobjectIso g).symm
      (isCoherent_image_of_isQuasicoherent g hsum)⟩, ?_, ?_⟩
    · exact Subobject.le_of_comm (biprod.inl ≫ factorThruImageSubobject g)
        (by simp [g])
    · exact Subobject.le_of_comm (biprod.inr ≫ factorThruImageSubobject g)
        (by simp [g])

/-- **Hartshorne II, Exercise 5.15(e) (filteredness).** On a locally Noetherian scheme, the
poset of coherent subsheaves of a quasi-coherent module is filtered. -/
theorem coherentSubobject_isFiltered [IsLocallyNoetherian X] [F.IsQuasicoherent] :
    IsFiltered (CoherentSubobject F) :=
  inferInstance

/-- The diagram of coherent subsheaves of `F`, sending each one to its underlying module. -/
abbrev coherentSubobjectDiagram : CoherentSubobject F ⥤ X.Modules :=
  subobjectFamilyDiagram fun P : Subobject F => IsCoherent (P : X.Modules)

/-- The canonical cocone over the diagram of coherent subsheaves of `F`, with vertex `F`, given
by the inclusions. -/
abbrev coherentSubobjectCocone : Cocone (coherentSubobjectDiagram F) :=
  subobjectFamilyCocone fun P : Subobject F => IsCoherent (P : X.Modules)

variable {F}

/-- Module sheaves on a scheme form a Grothendieck abelian category: module sheafification
transfers exactness of filtered colimits and a separator from module presheaves. -/
private theorem modules_isGrothendieckAbelian (X : Scheme.{u}) :
    IsGrothendieckAbelian.{u} X.Modules := by
  let R := X.ringCatSheaf
  let _ : HasSeparator (PresheafOfModules.{u} R.obj) :=
    ⟨∐ fun U : X.Opens => (PresheafOfModules.free R.obj).obj (yoneda.obj U),
      (PresheafOfModules.freeYoneda.isSeparating R.obj).isSeparator_coproduct⟩
  let _ : IsGrothendieckAbelian.{u} (PresheafOfModules.{u} R.obj) :=
    { hasFilteredColimitsOfSize := ⟨fun _ _ _ => inferInstance⟩
      ab5OfSize := ⟨fun K _ _ =>
        HasExactColimitsOfShape.domain_of_functor K (PresheafOfModules.toPresheaf R.obj)⟩ }
  let adj := PresheafOfModules.sheafificationAdjunction (𝟙 R.obj)
  let S := separator (PresheafOfModules.{u} R.obj)
  have hS : IsSeparator ((PresheafOfModules.sheafification (𝟙 R.obj)).obj S) := by
    rw [isSeparator_def]
    intro M N f g hfg
    apply (SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj)).map_injective
    apply (isSeparator_separator (PresheafOfModules.{u} R.obj)).def
    intro a
    have ha := congrArg (adj.homEquiv S N) (hfg ((adj.homEquiv S M).symm a))
    simpa only [adj.homEquiv_naturality_right, Equiv.apply_symm_apply] using ha
  exact
    { hasFilteredColimitsOfSize := ⟨fun _ _ _ => inferInstance⟩
      ab5OfSize := ⟨fun K _ _ => adj.hasExactColimitsOfShape K⟩
      hasSeparator := ⟨_, hS⟩ }

/-- A subobject of an `𝒪_X`-module `F` containing every member of a family of subobjects is
all of `F` as soon as every local section of `F` is a section of some member of the family. -/
theorem subobject_eq_top_of_forall_mem_range (p : Subobject F → Prop)
    (h : ∀ (U : X.Opens) (s : Γ(F, U)), ∃ P : Subobject F, p P ∧ s ∈ Set.range (P.arrow.app U))
    (S : Subobject F) (hS : ∀ P, p P → P ≤ S) : S = ⊤ := by
  have hq : cokernel.π S.arrow = 0 := by
    ext U s
    obtain ⟨P, hP, t, rfl⟩ := h U s
    have hPS : P.arrow ≫ cokernel.π S.arrow = 0 := by
      rw [← Subobject.ofLE_arrow (hS P hP), Category.assoc, cokernel.condition, Limits.comp_zero]
    simpa using congr(($hPS).app U t)
  have : Epi S.arrow := Abelian.epi_of_cokernel_π_eq_zero _ hq
  have : IsIso S.arrow := isIso_of_mono_of_epi _
  exact Subobject.eq_top_of_isIso_arrow S

/-- **Hartshorne II, Exercise 5.15(e), reduction.** On a locally Noetherian scheme, if every
local section of a quasi-coherent module `F` is a section of some coherent subsheaf of `F`, then
`F` is the colimit (the filtered union) of its coherent subsheaves. -/
theorem nonempty_isColimit_coherentSubobjectCocone_of_forall_mem [IsLocallyNoetherian X]
    [F.IsQuasicoherent]
    (h : ∀ (U : X.Opens) (s : Γ(F, U)), ∃ P : CoherentSubobject F,
      s ∈ Set.range (P.1.arrow.app U)) :
    Nonempty (IsColimit (coherentSubobjectCocone F)) := by
  let _ := modules_isGrothendieckAbelian X
  have htop : ⨆ P : CoherentSubobject F, P.1 = ⊤ := by
    refine subobject_eq_top_of_forall_mem_range
      (fun P : Subobject F => IsCoherent (P : X.Modules))
      (fun U s => ?_) _ fun P hP => ?_
    · obtain ⟨P, hP⟩ := h U s
      exact ⟨P.1, P.2, hP⟩
    · exact le_iSup (fun P : CoherentSubobject F => P.1) ⟨P, hP⟩
  exact nonempty_isColimit_subobjectFamilyCocone.{u}
    (fun P : Subobject F => IsCoherent (P : X.Modules)) htop

end

end Hartshorne
