/-!
# Koszul-regular closed immersions

Hartshorne, *Algebraic Geometry*, III.7, proof of Theorem 7.11 (pp. 245–246); Stacks Project,
Lemmas 48.15.5–6 (tags 0BQZ, 0BR0).

A sequence `f₁, …, f_r` in a ring `A` is *Koszul-regular* on an `A`-module `M`
(`Hartshorne.Koszul.IsKoszulRegular`) if the Koszul complex `K_•(f; M)` is exact in positive
degrees. A regular sequence is Koszul-regular (Hartshorne III.7, Proposition 7.10A,
`Hartshorne.Koszul.sequenceKoszulComplex_exactAt_of_isWeaklyRegular`). Koszul-regularity on `A`
passes to every flat `A`-module (`Hartshorne.Koszul.IsKoszulRegular.of_flat`) and along every flat
base change (`Hartshorne.Koszul.IsKoszulRegular.baseChange`).

A closed immersion `i : X ⟶ Y` is a *Koszul-regular immersion of codimension `r`*
(`Hartshorne.IsKoszulRegularImmersion`) if every point of `Y` has an affine open neighbourhood `U`
on which the ideal sheaf `I` of `i` is generated by a Koszul-regular sequence `f₁, …, f_r` of
sections of `𝒪_Y` over `U`.

## Main results

* `Hartshorne.isKoszulRegular_sections_of_isFiniteLocallyFree`: a Koszul-regular sequence of
  sections over an affine open `U` is, near every point of `U`, Koszul-regular on the sections of
  any finite locally free `𝒪_Y`-module `M`: every point of `U` has a basic open neighbourhood
  `D(g) ⊆ U` such that the restricted sequence is Koszul-regular on `Γ(M, D(g))`.
* `Hartshorne.IsKoszulRegularImmersion.exists_isKoszulRegular_sections`: for a Koszul-regular
  immersion and a finite locally free `M`, the defining sequences can be chosen near every point
  to be Koszul-regular on `M` as well.

## Proof

On a basic open `D(g) ⊆ U`, the ring `Γ(Y, D(g))` is a localization of `Γ(Y, U)`, so it is flat
over `Γ(Y, U)`, and Koszul-regularity is preserved by flat base change. Choosing `D(g)` inside an
open on which `M` is free, `Γ(M, D(g))` is a free, hence flat, `Γ(Y, D(g))`-module, and
Koszul-regularity passes to flat modules: if `K_•(f; A)` is exact then so is
`K_•(f; A) ⊗_A M = K_•(f; M)`.
-/

universe u

open CategoryTheory TensorProduct

namespace Hartshorne

namespace Koszul

variable {A : Type u} [CommRing A]

/-- A sequence `f₁, …, f_r` is *Koszul-regular* on an `A`-module `M` if the Koszul complex
`K_•(f; M)` is exact in every positive degree. -/
def IsKoszulRegular {r : ℕ} (f : Fin r → A) (M : ModuleCat.{u} A) : Prop :=
  ∀ n, (sequenceKoszulComplex f M).ExactAt (n + 1)

variable {r : ℕ} (f : Fin r → A)

lemma IsKoszulRegular.of_iso {M N : ModuleCat.{u} A} (e : M ≅ N) (h : IsKoszulRegular f M) :
    IsKoszulRegular f N := fun n =>
  (h n).of_iso ((koszulFunctor (koszulForm f)).mapIso e)

lemma isKoszulRegular_iff_exact (M : ModuleCat.{u} A) :
    IsKoszulRegular f M ↔ ∀ n, Function.Exact ((contraction (koszulForm f) (n + 1)).rTensor M)
      ((contraction (koszulForm f) n).rTensor M) :=
  forall_congr' fun n => koszulComplex_exactAt_succ_iff _ M n

/-- A Koszul-regular sequence on `A` is Koszul-regular on every flat `A`-module. -/
lemma IsKoszulRegular.of_flat (h : IsKoszulRegular f (ModuleCat.of A A)) (M : Type u)
    [AddCommGroup M] [Module A M] [Module.Flat A M] : IsKoszulRegular f (ModuleCat.of A M) := by
  rw [isKoszulRegular_iff_exact] at h ⊢
  intro n
  have h₀ : Function.Exact (contraction (koszulForm f) (n + 1)) (contraction (koszulForm f) n) :=
    (Function.Exact.iff_of_ladder_linearEquiv (e₁ := TensorProduct.rid A _)
      (e₂ := TensorProduct.rid A _) (e₃ := TensorProduct.rid A _)
      (f₁₂ := (contraction (koszulForm f) (n + 1)).rTensor A)
      (f₂₃ := (contraction (koszulForm f) n).rTensor A)
      (g₁₂ := contraction (koszulForm f) (n + 1)) (g₂₃ := contraction (koszulForm f) n)
      (by ext; simp) (by ext; simp)).2 (h n)
  exact Module.Flat.rTensor_exact M h₀

/-- A Koszul-regular sequence on `A` stays Koszul-regular after a flat base change `A → B`. -/
lemma IsKoszulRegular.baseChange (h : IsKoszulRegular f (ModuleCat.of A A)) (B : Type u)
    [CommRing B] [Algebra A B] [Module.Flat A B] :
    IsKoszulRegular (fun i => algebraMap A B (f i)) (ModuleCat.of B B) := by
  have hK : ∀ n,
      (baseChangeComplex B (sequenceKoszulComplex f (ModuleCat.of A A))).ExactAt (n + 1) := by
    intro n
    rw [HomologicalComplex.exactAt_iff' _ (n + 1 + 1) (n + 1) n (by simp) (by simp),
      ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
    change Function.Exact
      ((baseChangeComplex B (sequenceKoszulComplex f (ModuleCat.of A A))).d (n + 1 + 1) (n + 1)).hom
      ((baseChangeComplex B (sequenceKoszulComplex f (ModuleCat.of A A))).d (n + 1) n).hom
    rw [baseChangeComplex_d, baseChangeComplex_d]
    change Function.Exact
      (((sequenceKoszulComplex f (ModuleCat.of A A)).d (n + 1 + 1) (n + 1)).hom.baseChange B)
      (((sequenceKoszulComplex f (ModuleCat.of A A)).d (n + 1) n).hom.baseChange B)
    rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
    have := h n
    rw [HomologicalComplex.exactAt_iff' _ (n + 1 + 1) (n + 1) n (by simp) (by simp),
      ShortComplex.ShortExact.moduleCat_exact_iff_function_exact] at this
    exact Module.Flat.lTensor_exact B this
  have h' : IsKoszulRegular (fun i => algebraMap A B (f i)) (ModuleCat.of B (B ⊗[A] A)) :=
    fun n => (hK n).of_iso (sequenceKoszulBaseChangeIso f B (ModuleCat.of A A))
  exact h'.of_iso _ (TensorProduct.AlgebraTensorModule.rid A B B).toModuleIso

end Koszul

open AlgebraicGeometry Limits Opposite Koszul

section Sections

variable {Y : Scheme.{u}}

attribute [local instance] HasFiniteBiproducts.of_hasFiniteProducts

/-- On an open `V` inside an open `W` over which `M|_W` is free of finite rank, the sections
`Γ(M, V)` form a free `Γ(Y, V)`-module. -/
lemma module_free_sections_of_iso_free {M : Y.Modules} {W : Y.Opens} {n : ℕ}
    (α : M.over W ≅ SheafOfModules.free (ULift.{u} (Fin n))) {V : Y.Opens} (hVW : V ≤ W) :
    Module.Free Γ(Y, V) Γ(M, V) := by
  let O : (Over W)ᵒᵖ := op (Over.mk (homOfLE hVW))
  let E := SheafOfModules.forget (Y.ringCatSheaf.over W) ⋙ PresheafOfModules.evaluation _ O
  have : E.Additive := by dsimp only [E]; infer_instance
  have : PreservesFiniteBiproducts E := inferInstance
  let un := SheafOfModules.unit (Y.ringCatSheaf.over W)
  let e : E.obj (M.over W) ≅ ModuleCat.of _ (Fin n → E.obj un) :=
    E.mapIso (α ≪≫ (biproduct.isoCoproduct (fun _ : ULift.{u} (Fin n) => un)).symm ≪≫
        biproduct.whiskerEquiv (f := fun _ : ULift.{u} (Fin n) => un)
          (g := fun _ : Fin n => un) Equiv.ulift (fun _ => Iso.refl _)) ≪≫
      E.mapBiproduct (fun _ : Fin n => un) ≪≫ ModuleCat.biproductIsoPi _
  have : Module.Free ((Y.ringCatSheaf.over W).obj.obj O) (E.obj un) :=
    Module.Free.self ((Y.ringCatSheaf.over W).obj.obj O)
  have : Module.Free ((Y.ringCatSheaf.over W).obj.obj O) (E.obj (M.over W)) :=
    Module.Free.of_equiv e.toLinearEquiv.symm
  exact this

variable {r : ℕ}

/-- A Koszul-regular sequence of sections over an affine open `U` stays Koszul-regular on every
basic open `D(g) ⊆ U`: `Γ(Y, D(g))` is a localization of `Γ(Y, U)`, hence flat. -/
lemma isKoszulRegular_basicOpen {U : Y.Opens} (hU : IsAffineOpen U) {f : Fin r → Γ(Y, U)}
    (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U))) (g : Γ(Y, U)) :
    IsKoszulRegular (fun j => algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g) (f j))
      (ModuleCat.of Γ(Y, Y.basicOpen g) Γ(Y, Y.basicOpen g)) := by
  have := hU.isLocalization_basicOpen g
  have : Module.Flat Γ(Y, U) Γ(Y, Y.basicOpen g) := IsLocalization.flat _ (Submonoid.powers g)
  exact IsKoszulRegular.baseChange f hf _

/-- **A Koszul-regular sequence is regular on a finite locally free module.** Let `f₁, …, f_r`
be sections over an affine open `U` of a scheme `Y` forming a Koszul-regular sequence in
`Γ(Y, U)`, and let `M` be a finite locally free `𝒪_Y`-module. Every point of `U` has a basic open
neighbourhood `D(g) ⊆ U` on which the restricted sequence is Koszul-regular on `Γ(M, D(g))`. -/
theorem isKoszulRegular_sections_of_isFiniteLocallyFree {U : Y.Opens} (hU : IsAffineOpen U)
    {f : Fin r → Γ(Y, U)} (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U)))
    {M : Y.Modules} (hM : Ringed.IsFiniteLocallyFree (R := Y.sheaf) M) {y : Y} (hy : y ∈ U) :
    ∃ g : Γ(Y, U), y ∈ Y.basicOpen g ∧
      IsKoszulRegular (fun j => algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g) (f j))
          (ModuleCat.of Γ(Y, Y.basicOpen g) Γ(Y, Y.basicOpen g)) ∧
      IsKoszulRegular (fun j => algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g) (f j))
          (ModuleCat.of Γ(Y, Y.basicOpen g) Γ(M, Y.basicOpen g)) := by
  obtain ⟨W, hyW, n, ⟨α⟩⟩ := hM y
  obtain ⟨g, hgW, hyg⟩ := hU.exists_basicOpen_le ⟨y, hyW⟩ hy
  have := module_free_sections_of_iso_free α hgW
  exact ⟨g, hyg, isKoszulRegular_basicOpen hU hf g,
    IsKoszulRegular.of_flat _ (isKoszulRegular_basicOpen hU hf g) _⟩

end Sections

section Immersion

variable {X Y : Scheme.{u}}

/-- **Koszul-regular closed immersions of codimension `r`.** A closed immersion `i : X ⟶ Y`
whose ideal sheaf `I` is locally generated by Koszul-regular sequences of length `r`: every point
of `Y` has an affine open neighbourhood `U` with a sequence `f₁, …, f_r ∈ Γ(Y, U)` that generates
`I(U)` and whose Koszul complex `K_•(f; Γ(Y, U))` is exact in positive degrees. -/
structure IsKoszulRegularImmersion (i : X ⟶ Y) (r : ℕ) : Prop where
  isClosedImmersion : IsClosedImmersion i
  exists_isKoszulRegular : ∀ y : Y, ∃ U : Y.affineOpens, y ∈ (U : Y.Opens) ∧
    ∃ f : Fin r → Γ(Y, U), i.ker.ideal U = Ideal.span (Set.range f) ∧
      IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U))

variable {i : X ⟶ Y} {r : ℕ}

/-- **The defining sequences of a Koszul-regular immersion are regular on a finite locally free
module.** For a codimension-`r` Koszul-regular closed immersion `i : X ⟶ Y` with ideal sheaf `I`
and a finite locally free `𝒪_Y`-module `M`, every point of `Y` has an affine open neighbourhood
`U` with a sequence `f₁, …, f_r` generating `I(U)` that is Koszul-regular both on `Γ(Y, U)` and on
`Γ(M, U)`. -/
theorem IsKoszulRegularImmersion.exists_isKoszulRegular_sections
    (h : IsKoszulRegularImmersion i r) {M : Y.Modules}
    (hM : Ringed.IsFiniteLocallyFree (R := Y.sheaf) M) (y : Y) :
    ∃ U : Y.affineOpens, y ∈ (U : Y.Opens) ∧
      ∃ f : Fin r → Γ(Y, U), i.ker.ideal U = Ideal.span (Set.range f) ∧
        IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U)) ∧
        IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(M, U)) := by
  obtain ⟨U, hyU, f, hI, hf⟩ := h.exists_isKoszulRegular y
  obtain ⟨g, hyg, hfg, hMg⟩ := isKoszulRegular_sections_of_isFiniteLocallyFree U.2 hf hM hyU
  refine ⟨Y.affineBasicOpen g, hyg, fun j => algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g) (f j), ?_,
    hfg, hMg⟩
  rw [← i.ker.map_ideal_basicOpen U g, hI, Ideal.map_span, ← Set.range_comp]
  rfl

end Immersion

end Hartshorne
