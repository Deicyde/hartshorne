/-!
# Koszul-regular closed immersions

Hartshorne, *Algebraic Geometry*, III.7, proof of Theorem 7.11 (pp. 245–246); Stacks Project,
Lemmas 48.15.5–6 (tags 0BQZ, 0BR0).

A sequence `f₁, …, f_r` in a ring `A` is *Koszul-regular* on an `A`-module `M`
(`Hartshorne.Koszul.IsKoszulRegular`) if the Koszul complex `K_•(f; M)` is exact in positive
degrees. A regular sequence is Koszul-regular (Hartshorne III.7, Proposition 7.10A,
`Hartshorne.Koszul.sequenceKoszulComplex_exactAt_of_isWeaklyRegular`). Koszul-regularity on `A`
passes to every flat `A`-module (`Hartshorne.Koszul.IsKoszulRegular.of_flat`) and along every flat
base change (`Hartshorne.Koszul.IsKoszulRegular.baseChange`).

A closed immersion `i : X ⟶ Y` is a *Koszul-regular immersion of codimension `r`*
(`Hartshorne.IsKoszulRegularImmersion`) if every point of `Y` has an affine open neighbourhood `U`
on which the ideal sheaf `I` of `i` is generated by a Koszul-regular sequence `f₁, …, f_r` of
sections of `𝒪_Y` over `U`.

## Main results

* `Hartshorne.isKoszulRegular_sections_of_isFiniteLocallyFree`: a Koszul-regular sequence of
  sections over an affine open `U` is, near every point of `U`, Koszul-regular on the sections of
  any finite locally free `𝒪_Y`-module `M`: every point of `U` has a basic open neighbourhood
  `D(g) ⊆ U` such that the restricted sequence is Koszul-regular on `Γ(M, D(g))`.
* `Hartshorne.IsKoszulRegularImmersion.exists_isKoszulRegular_sections`: for a Koszul-regular
  immersion and a finite locally free `M`, the defining sequences can be chosen near every point
  to be Koszul-regular on `M` as well.
* Koszul self-duality (`Hartshorne.Koszul.koszulDualEquiv`): for `q + p = r`,
  `⋀^q A^r ⊗ P ≅ Hom(⋀^p A^r, P)`, `η ⊗ m ↦ (ω ↦ [η ∧ ω] m)`, where `[-]` is the coefficient of
  `e₁ ∧ ⋯ ∧ e_r`; under it the transpose of the Koszul differential is the Koszul differential up
  to sign (`Hartshorne.Koszul.lcomp_contraction_comp_koszulDualEquiv`).
* The dual `Hom_A(K_•(f; A), P)` of the Koszul resolution of `A / (f)` is exact in degrees
  `0, …, r - 1` when `f` is Koszul-regular on `P`
  (`Hartshorne.Koszul.injective_lcomp_sequenceKoszulComplex_d`,
  `Hartshorne.Koszul.exact_lcomp_sequenceKoszulComplex_d`), and its top cohomology is
  `P / (f) P` through evaluation at `e₁ ∧ ⋯ ∧ e_r ⊗ 1` (`Hartshorne.Koszul.koszulDualTopMap`,
  `Hartshorne.Koszul.exact_koszulDualTopMap`, `Hartshorne.Koszul.koszulDualTopMap_apply`).
* The determinant transition law (`Hartshorne.Koszul.koszulDualTopMap_changeOfBasis`): replacing
  `f` by `f Q` for an invertible matrix `Q` multiplies the top identification by `det Q`.
* `Hartshorne.IsKoszulRegularImmersion.exists_koszulDual`: the local Koszul calculation for a
  Koszul-regular immersion and a finite locally free `M`.
* The conormal module of a Koszul-regular sequence (`Hartshorne.Koszul.cotangentBasis`): if `f` is
  Koszul-regular on `A` and `I = (f₁, …, f_r)`, the classes of `f₁, …, f_r` form a basis of
  `I/I²` over `A/I` (`Hartshorne.Koszul.mem_of_sum_mul_mem_sq`). If `∑ aⱼ fⱼ ∈ I²`, subtracting
  an expression `∑ cⱼ fⱼ` with `cⱼ ∈ I` gives a Koszul `1`-cycle, which is a boundary; the
  Koszul differentials take values in `I K_•` (`Hartshorne.Koszul.contraction_mem_smul_top`), so
  every `aⱼ` lies in `I`. For an `A`-algebra `B` killing `I`, `B ⊗_A I` is free on
  `1 ⊗ f₁, …, 1 ⊗ f_r` (`Hartshorne.Koszul.baseChangeIdealEquiv`,
  `Hartshorne.Koszul.baseChangeIdealBasis`).

## Proof

On a basic open `D(g) ⊆ U`, the ring `Γ(Y, D(g))` is a localization of `Γ(Y, U)`, so it is flat
over `Γ(Y, U)`, and Koszul-regularity is preserved by flat base change. Choosing `D(g)` inside an
open on which `M` is free, `Γ(M, D(g))` is a free, hence flat, `Γ(Y, D(g))`-module, and
Koszul-regularity passes to flat modules: if `K_•(f; A)` is exact then so is
`K_•(f; A) ⊗_A M = K_•(f; M)`.

For the duality, contraction `φ ⌋ -` is a graded derivation of the exterior algebra
(`Hartshorne.Koszul.contractLeft_mul_of_mem`); since `η ∧ ω = 0` in degree `r + 1`, this gives
`[(φ ⌋ η) ∧ ω] = (-1)^q [η ∧ (φ ⌋ ω)]` for `η` of degree `q + 1`. The wedge pairing
`⋀^q A^r → (⋀^p A^r)^∨` is perfect (`Hartshorne.Koszul.wedgeDual_bijective`, from the perfect
exterior pairing of a free module), so `Hom(K_p, P) ≅ K_{r-p}(f; P)` compatibly with the
differentials up to sign, and `Hᵖ(Hom(K_•(f; A), P)) ≅ H_{r-p}(K_•(f; P))`.
-/

universe u

open CategoryTheory TensorProduct

namespace Hartshorne

namespace Koszul

variable {A : Type u} [CommRing A]

/-- A sequence `f₁, …, f_r` is *Koszul-regular* on an `A`-module `M` if the Koszul complex
`K_•(f; M)` is exact in every positive degree. -/
def IsKoszulRegular {r : ℕ} (f : Fin r → A) (M : ModuleCat.{u} A) : Prop :=
  ∀ n, (sequenceKoszulComplex f M).ExactAt (n + 1)

variable {r : ℕ} (f : Fin r → A)

lemma IsKoszulRegular.of_iso {M N : ModuleCat.{u} A} (e : M ≅ N) (h : IsKoszulRegular f M) :
    IsKoszulRegular f N := fun n =>
  (h n).of_iso ((koszulFunctor (koszulForm f)).mapIso e)

lemma isKoszulRegular_iff_exact (M : ModuleCat.{u} A) :
    IsKoszulRegular f M ↔ ∀ n, Function.Exact ((contraction (koszulForm f) (n + 1)).rTensor M)
      ((contraction (koszulForm f) n).rTensor M) :=
  forall_congr' fun n => koszulComplex_exactAt_succ_iff _ M n

/-- A Koszul-regular sequence on `A` is Koszul-regular on every flat `A`-module. -/
lemma IsKoszulRegular.of_flat (h : IsKoszulRegular f (ModuleCat.of A A)) (M : Type u)
    [AddCommGroup M] [Module A M] [Module.Flat A M] : IsKoszulRegular f (ModuleCat.of A M) := by
  rw [isKoszulRegular_iff_exact] at h ⊢
  intro n
  have h₀ : Function.Exact (contraction (koszulForm f) (n + 1)) (contraction (koszulForm f) n) :=
    (Function.Exact.iff_of_ladder_linearEquiv (e₁ := TensorProduct.rid A _)
      (e₂ := TensorProduct.rid A _) (e₃ := TensorProduct.rid A _)
      (f₁₂ := (contraction (koszulForm f) (n + 1)).rTensor A)
      (f₂₃ := (contraction (koszulForm f) n).rTensor A)
      (g₁₂ := contraction (koszulForm f) (n + 1)) (g₂₃ := contraction (koszulForm f) n)
      (by ext; simp) (by ext; simp)).2 (h n)
  exact Module.Flat.rTensor_exact M h₀

/-- A Koszul-regular sequence on `A` stays Koszul-regular after a flat base change `A → B`. -/
lemma IsKoszulRegular.baseChange (h : IsKoszulRegular f (ModuleCat.of A A)) (B : Type u)
    [CommRing B] [Algebra A B] [Module.Flat A B] :
    IsKoszulRegular (fun i => algebraMap A B (f i)) (ModuleCat.of B B) := by
  have hK : ∀ n,
      (baseChangeComplex B (sequenceKoszulComplex f (ModuleCat.of A A))).ExactAt (n + 1) := by
    intro n
    rw [HomologicalComplex.exactAt_iff' _ (n + 1 + 1) (n + 1) n (by simp) (by simp),
      ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
    change Function.Exact
      ((baseChangeComplex B (sequenceKoszulComplex f (ModuleCat.of A A))).d (n + 1 + 1) (n + 1)).hom
      ((baseChangeComplex B (sequenceKoszulComplex f (ModuleCat.of A A))).d (n + 1) n).hom
    rw [baseChangeComplex_d, baseChangeComplex_d]
    change Function.Exact
      (((sequenceKoszulComplex f (ModuleCat.of A A)).d (n + 1 + 1) (n + 1)).hom.baseChange B)
      (((sequenceKoszulComplex f (ModuleCat.of A A)).d (n + 1) n).hom.baseChange B)
    rw [LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
    have := h n
    rw [HomologicalComplex.exactAt_iff' _ (n + 1 + 1) (n + 1) n (by simp) (by simp),
      ShortComplex.ShortExact.moduleCat_exact_iff_function_exact] at this
    exact Module.Flat.lTensor_exact B this
  have h' : IsKoszulRegular (fun i => algebraMap A B (f i)) (ModuleCat.of B (B ⊗[A] A)) :=
    fun n => (hK n).of_iso (sequenceKoszulBaseChangeIso f B (ModuleCat.of A A))
  exact h'.of_iso _ (TensorProduct.AlgebraTensorModule.rid A B B).toModuleIso

section Duality

/-! ### Self-duality of the Koszul complex -/

open ExteriorAlgebra

variable {V : Type u} [AddCommGroup V] [Module A V]

lemma mul_mem_exteriorPower {p q : ℕ} {x y : ExteriorAlgebra A V} (hx : x ∈ ⋀[A]^p V)
    (hy : y ∈ ⋀[A]^q V) : x * y ∈ ⋀[A]^(p + q) V := by
  rw [exteriorPower, pow_add]
  exact Submodule.mul_mem_mul hx hy

/-- Contraction by a linear form is a graded derivation of the exterior algebra:
`φ ⌋ (x y) = (φ ⌋ x) y + (-1)^p x (φ ⌋ y)` for `x` of degree `p`. -/
lemma contractLeft_mul_of_mem (φ : Module.Dual A V) :
    ∀ (p : ℕ) {x : ExteriorAlgebra A V}, x ∈ ⋀[A]^p V → ∀ y : ExteriorAlgebra A V,
      CliffordAlgebra.contractLeft φ (x * y) =
        CliffordAlgebra.contractLeft φ x * y +
          (-1 : A) ^ p • (x * CliffordAlgebra.contractLeft φ y)
  | 0, x, hx, y => by
    rw [exteriorPower, pow_zero, Submodule.mem_one] at hx
    obtain ⟨a, rfl⟩ := hx
    rw [CliffordAlgebra.contractLeft_algebraMap_mul, CliffordAlgebra.contractLeft_algebraMap,
      zero_mul, zero_add, pow_zero, one_smul]
  | p + 1, x, hx, y => by
    rw [exteriorPower, pow_succ'] at hx
    induction hx using Submodule.mul_induction_on' with
    | mem_mul_mem m hm z hz =>
      obtain ⟨v, rfl⟩ := hm
      rw [mul_assoc, CliffordAlgebra.contractLeft_ι_mul, CliffordAlgebra.contractLeft_ι_mul,
        contractLeft_mul_of_mem φ p hz y]
      simp only [pow_succ, mul_add, sub_mul, smul_mul_assoc, mul_smul_comm, mul_assoc,
        mul_neg_one, neg_smul]
      abel
    | add a _ b _ ha hb => rw [add_mul, map_add, map_add, ha, hb, add_mul, add_mul, smul_add]; abel


variable (r : ℕ)

/-- The top subset `{1, …, r}` of `Fin r`, indexing the basis `e₁ ∧ ⋯ ∧ e_r` of `⋀^r A^r`. -/
def topIndex : Set.powersetCard (Fin r) r :=
  ⟨Finset.univ, Set.powersetCard.mem_iff.2 (by simp)⟩

instance : Subsingleton (Set.powersetCard (Fin r) r) :=
  ExteriorPerfectPairing.powersetCard_subsingleton (r := r) (s := 0) (by simp)

/-- The coefficient of `e₁ ∧ ⋯ ∧ e_r` in an element of the exterior algebra of `A^r`. -/
noncomputable def topCoord : ExteriorAlgebra A (Fin r → A) →ₗ[A] A :=
  ((Pi.basisFun A (Fin r)).exteriorPower r).coord (topIndex r) ∘ₗ
    DirectSum.component A ℕ (fun i : ℕ => ⋀[A]^i (Fin r → A)) r ∘ₗ
      (DirectSum.decomposeLinearEquiv (fun i : ℕ => ⋀[A]^i (Fin r → A))).toLinearMap

variable {r}

lemma topCoord_of_mem_ne {n : ℕ} {x : ExteriorAlgebra A (Fin r → A)} (hx : x ∈ ⋀[A]^n (Fin r → A))
    (hn : n ≠ r) : topCoord r x = 0 := by
  have : DirectSum.decompose (fun i : ℕ => ⋀[A]^i (Fin r → A)) x r = 0 :=
    Subtype.ext (DirectSum.decompose_of_mem_ne _ hx hn)
  change ((Pi.basisFun A (Fin r)).exteriorPower r).coord (topIndex r)
    (DirectSum.decompose (fun i : ℕ => ⋀[A]^i (Fin r → A)) x r) = 0
  rw [this, map_zero]

lemma topCoord_of_mem {x : ExteriorAlgebra A (Fin r → A)} (hx : x ∈ ⋀[A]^r (Fin r → A)) :
    topCoord r x = ((Pi.basisFun A (Fin r)).exteriorPower r).coord (topIndex r) ⟨x, hx⟩ := by
  have : DirectSum.decompose (fun i : ℕ => ⋀[A]^i (Fin r → A)) x r = ⟨x, hx⟩ :=
    Subtype.ext (DirectSum.decompose_of_mem_same _ hx)
  change ((Pi.basisFun A (Fin r)).exteriorPower r).coord (topIndex r)
    (DirectSum.decompose (fun i : ℕ => ⋀[A]^i (Fin r → A)) x r) = _
  rw [this]

/-- The exterior powers of `A^r` above the rank vanish. -/
lemma eq_zero_of_mem_exteriorPower_of_lt {n : ℕ} (hn : r < n) {x : ExteriorAlgebra A (Fin r → A)}
    (hx : x ∈ ⋀[A]^n (Fin r → A)) : x = 0 := by
  have : IsEmpty (Set.powersetCard (Fin r) n) := ⟨fun t => by
    have := Set.powersetCard.card_eq t
    have := Finset.card_le_univ (t : Finset (Fin r))
    simp at this
    omega⟩
  have h := ((Pi.basisFun A (Fin r)).exteriorPower n).sum_repr ⟨x, hx⟩
  rw [Finset.univ_eq_empty, Finset.sum_empty] at h
  exact congrArg Subtype.val h.symm

/-- The multiplication `⋀^q A^r × ⋀^p A^r → ⋀^{q+p} A^r`. -/
noncomputable def wedgeMul (q p : ℕ) :
    ⋀[A]^q (Fin r → A) →ₗ[A] ⋀[A]^p (Fin r → A) →ₗ[A] ⋀[A]^(q + p) (Fin r → A) :=
  LinearMap.mk₂ A
    (fun x y => ⟨(x : ExteriorAlgebra A (Fin r → A)) * y, mul_mem_exteriorPower x.2 y.2⟩)
    (fun _ _ _ => Subtype.ext (add_mul _ _ _)) (fun _ _ _ => Subtype.ext (smul_mul_assoc _ _ _))
    (fun _ _ _ => Subtype.ext (mul_add _ _ _)) (fun _ _ _ => Subtype.ext (mul_smul_comm _ _ _))

/-- The pairing `⋀^q A^r → (⋀^p A^r)^∨`, `η ↦ (ω ↦ [η ∧ ω])`, where `[-]` is the coefficient of
`e₁ ∧ ⋯ ∧ e_r`. -/
noncomputable def wedgeDual (q p : ℕ) :
    ⋀[A]^q (Fin r → A) →ₗ[A] Module.Dual A (⋀[A]^p (Fin r → A)) :=
  ((LinearMap.mul A (ExteriorAlgebra A (Fin r → A))).compl₁₂ (⋀[A]^q (Fin r → A)).subtype
    (⋀[A]^p (Fin r → A)).subtype).compr₂ (topCoord r)

lemma wedgeDual_apply (q p : ℕ) (η : ⋀[A]^q (Fin r → A)) (ω : ⋀[A]^p (Fin r → A)) :
    wedgeDual q p η ω =
      topCoord r ((η : ExteriorAlgebra A (Fin r → A)) * (ω : ExteriorAlgebra A (Fin r → A))) :=
  rfl

/-- **The perfect exterior pairing of `A^r`**: for `q + p = r`, `η ↦ (ω ↦ [η ∧ ω])` is a bijection
`⋀^q A^r → (⋀^p A^r)^∨`. -/
lemma wedgeDual_bijective {q p : ℕ} (h : q + p = r) :
    Function.Bijective (wedgeDual (A := A) (r := r) q p) := by
  classical
  let b := Pi.basisFun A (Fin r)
  have hμ := ExteriorPerfectPairing.bijective_μ_basis (wedgeMul q p) (fun _ _ => rfl) b
    (by simpa using h)
  -- the top coordinate is a bijection on `⋀^{q+p} A^r`
  have htop : Function.Bijective fun z : ⋀[A]^(q + p) (Fin r → A) =>
      topCoord r (z : ExteriorAlgebra A (Fin r → A)) := by
    subst h
    have hB : ∀ z : ⋀[A]^(q + p) (Fin (q + p) → A),
        topCoord (q + p) (z : ExteriorAlgebra A (Fin (q + p) → A)) =
          (b.exteriorPower (q + p)).repr z (topIndex (q + p)) := fun z => by
      rw [topCoord_of_mem z.2]
      rfl
    refine ⟨fun z z' hzz' => ?_, fun a => ⟨a • b.exteriorPower (q + p) (topIndex (q + p)), ?_⟩⟩
    · simp only [hB] at hzz'
      apply (b.exteriorPower (q + p)).repr.injective
      ext t
      rwa [Subsingleton.elim t (topIndex (q + p))]
    · simp only [hB, map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul,
        mul_one, Finsupp.single_eq_same]
  let e₁ : Module.Dual A (⋀[A]^p (Fin r → A)) ≃ₗ[A] (Set.powersetCard (Fin r) p → A) :=
    ((b.exteriorPower p).constr A).symm
  have hcomp : (e₁ ∘ wedgeDual q p) =
      (fun g : Set.powersetCard (Fin r) p → ⋀[A]^(q + p) (Fin r → A) =>
          fun J => topCoord r (g J : ExteriorAlgebra A (Fin r → A))) ∘
        (fun x : ⋀[A]^q (Fin r → A) => fun J : Set.powersetCard (Fin r) p =>
          wedgeMul q p x (exteriorPower.ιMulti_family A p b J)) := by
    funext x J
    simp only [Function.comp_apply, e₁, Module.Basis.constr_symm_apply, exteriorPower.basis_apply]
    rfl
  have : Function.Bijective (e₁ ∘ wedgeDual q p) := by
    rw [hcomp]
    refine Function.Bijective.comp ⟨fun g g' hg => ?_, fun g => ?_⟩ hμ
    · funext J
      exact htop.1 (congrFun hg J)
    · exact ⟨fun J => (htop.2 (g J)).choose, funext fun J => (htop.2 (g J)).choose_spec⟩
  exact (Function.Bijective.of_comp_iff' e₁.bijective _).1 this

/-- **Koszul duality**: for `q + p = r`, the isomorphism `⋀^q A^r ⊗ P ≅ Hom(⋀^p A^r, P)`,
`η ⊗ m ↦ (ω ↦ [η ∧ ω] m)`. -/
noncomputable def koszulDualEquiv {q p : ℕ} (h : q + p = r) (P : Type u) [AddCommGroup P]
    [Module A P] : (⋀[A]^q (Fin r → A) ⊗[A] P) ≃ₗ[A] (⋀[A]^p (Fin r → A) →ₗ[A] P) :=
  (LinearEquiv.ofBijective _ (wedgeDual_bijective h)).rTensor P ≪≫ₗ
    dualTensorHomEquiv A (⋀[A]^p (Fin r → A)) P

lemma koszulDualEquiv_tmul {q p : ℕ} (h : q + p = r) (P : Type u) [AddCommGroup P] [Module A P]
    (η : ⋀[A]^q (Fin r → A)) (m : P) (ω : ⋀[A]^p (Fin r → A)) :
    koszulDualEquiv h P (η ⊗ₜ m) ω =
      topCoord r ((η : ExteriorAlgebra A (Fin r → A)) * (ω : ExteriorAlgebra A (Fin r → A))) • m :=
  rfl

/-- Under Koszul duality the transpose of the contraction is the contraction, up to the sign
`(-1)^q`: `[(φ ⌋ η) ∧ ω] = (-1)^q [η ∧ (φ ⌋ ω)]` for `η` of degree `q + 1`. -/
lemma lcomp_contraction_comp_koszulDualEquiv (φ : Module.Dual A (Fin r → A)) {q p : ℕ}
    (h₁ : q + 1 + p = r) (h₂ : q + (p + 1) = r) (P : Type u) [AddCommGroup P] [Module A P] :
    LinearMap.lcomp A P (contraction φ p) ∘ₗ (koszulDualEquiv h₁ P).toLinearMap =
      (koszulDualEquiv h₂ P).toLinearMap ∘ₗ ((-1 : A) ^ q • (contraction φ q).rTensor P) := by
  refine TensorProduct.ext' fun η m => LinearMap.ext fun ω => ?_
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearMap.lcomp_apply,
    LinearMap.smul_apply, map_smul, LinearMap.rTensor_tmul, LinearMap.smul_apply,
    koszulDualEquiv_tmul, coe_contraction]
  have hzero : (η : ExteriorAlgebra A (Fin r → A)) * (ω : ExteriorAlgebra A (Fin r → A)) = 0 :=
    eq_zero_of_mem_exteriorPower_of_lt (n := q + 1 + (p + 1)) (by omega)
      (mul_mem_exteriorPower η.2 ω.2)
  have hder := contractLeft_mul_of_mem φ (q + 1) η.2 (ω : ExteriorAlgebra A (Fin r → A))
  rw [hzero, map_zero, eq_comm, add_eq_zero_iff_eq_neg] at hder
  have hsq : ((-1 : A) ^ q * (-1) ^ q) = 1 := by rw [← mul_pow]; simp
  have key : topCoord r (CliffordAlgebra.contractLeft φ (η : ExteriorAlgebra A (Fin r → A)) *
      (ω : ExteriorAlgebra A (Fin r → A))) = (-1) ^ q * topCoord r
        ((η : ExteriorAlgebra A (Fin r → A)) *
          CliffordAlgebra.contractLeft φ (ω : ExteriorAlgebra A (Fin r → A))) := by
    rw [hder, map_neg, map_smul, smul_eq_mul, pow_succ]
    ring
  rw [key, smul_smul, ← mul_assoc, hsq, one_mul]

/-- Exactness of `M₁ → M₂ → M₃` is unchanged when both maps are multiplied by units. -/
lemma exact_smul_iff {M₁ M₂ M₃ : Type*} [AddCommMonoid M₁] [Module A M₁] [AddCommMonoid M₂]
    [Module A M₂] [AddCommMonoid M₃] [Module A M₃] (F : M₁ →ₗ[A] M₂) (G : M₂ →ₗ[A] M₃) {a b : A}
    (ha : IsUnit a) (hb : IsUnit b) :
    Function.Exact (a • F) (b • G) ↔ Function.Exact F G := by
  have hr : Set.range (a • F) = Set.range F := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨a • x, by simp⟩
    · rintro ⟨x, rfl⟩
      refine ⟨((ha.unit⁻¹ : Aˣ) : A) • x, ?_⟩
      rw [LinearMap.smul_apply, map_smul, smul_smul, IsUnit.mul_val_inv, one_smul]
  refine forall_congr' fun y => ?_
  rw [LinearMap.smul_apply, hb.smul_eq_zero, hr]

lemma isUnit_neg_one_pow (n : ℕ) : IsUnit ((-1 : A) ^ n) := (isUnit_one.neg).pow n

/-- **Koszul duality, middle degrees.** If the Koszul complex `K_•(φ; P)` is exact in positive
degrees, then the dual complex `Hom(⋀^• A^r, P)` is exact in degrees `1, …, r - 1`. -/
theorem exact_lcomp_contraction (φ : Module.Dual A (Fin r → A)) (P : Type u) [AddCommGroup P]
    [Module A P] (hP : ∀ n, Function.Exact ((contraction φ (n + 1)).rTensor P)
      ((contraction φ n).rTensor P)) {p : ℕ} (hp : p + 2 ≤ r) :
    Function.Exact (LinearMap.lcomp A P (contraction φ p))
      (LinearMap.lcomp A P (contraction φ (p + 1))) := by
  obtain ⟨q, rfl⟩ : ∃ q, r = q + 1 + 1 + p := ⟨r - p - 2, by omega⟩
  have hsq₁ := lcomp_contraction_comp_koszulDualEquiv φ (q := q + 1) (p := p) (by omega)
    (by omega) P
  have hsq₂ := lcomp_contraction_comp_koszulDualEquiv φ (q := q) (p := p + 1) (by omega)
    (by omega) P
  rw [Function.Exact.iff_of_ladder_linearEquiv hsq₁ hsq₂]
  exact (exact_smul_iff ((contraction φ (q + 1)).rTensor P) ((contraction φ q).rTensor P)
    (isUnit_neg_one_pow (q + 1)) (isUnit_neg_one_pow q)).2 (hP q)

/-- **Koszul duality, degree zero.** If `K_•(φ; P)` is exact in positive degrees and `r > 0`, the
first map `Hom(⋀^0 A^r, P) → Hom(⋀^1 A^r, P)` of the dual complex is injective. -/
theorem injective_lcomp_contraction_zero (φ : Module.Dual A (Fin r → A)) (P : Type u)
    [AddCommGroup P] [Module A P] (hP : ∀ n, Function.Exact ((contraction φ (n + 1)).rTensor P)
      ((contraction φ n).rTensor P)) (hr : 0 < r) :
    Function.Injective (LinearMap.lcomp A P (contraction φ 0)) := by
  obtain ⟨q, rfl⟩ : ∃ q, r = q + 1 := ⟨r - 1, by omega⟩
  have hsq := lcomp_contraction_comp_koszulDualEquiv φ (q := q) (p := 0) (by omega) (by omega) P
  have hinj : Function.Injective ((contraction φ q).rTensor P) := by
    have : Subsingleton (⋀[A]^(q + 1 + 1) (Fin (q + 1) → A) ⊗[A] P) := by
      have : Subsingleton (⋀[A]^(q + 1 + 1) (Fin (q + 1) → A)) :=
        ⟨fun x y => Subtype.ext ((eq_zero_of_mem_exteriorPower_of_lt (by omega) x.2).trans
          (eq_zero_of_mem_exteriorPower_of_lt (by omega) y.2).symm)⟩
      infer_instance
    refine (injective_iff_map_eq_zero _).2 fun x hx => ?_
    obtain ⟨y, hy⟩ := ((hP q) x).1 hx
    rw [← hy, Subsingleton.elim y 0, map_zero]
  have hcomp : Function.Injective
      (LinearMap.lcomp A P (contraction φ 0) ∘ₗ
        (koszulDualEquiv (A := A) (r := q + 1) (q := q + 1) (p := 0)
          (by omega) P).toLinearMap) := by
    rw [hsq, LinearMap.coe_comp]
    refine (koszulDualEquiv _ P).injective.comp ?_
    intro x y hxy
    rw [LinearMap.smul_apply, LinearMap.smul_apply,
      (isUnit_neg_one_pow q).smul_left_cancel] at hxy
    exact hinj hxy
  rw [LinearMap.coe_comp] at hcomp
  exact (Function.Injective.of_comp_iff' _ (koszulDualEquiv _ P).bijective).1 hcomp

/-- **Koszul duality, top degree.** If `K_•(φ; P)` is exact in positive degrees and `r > 0`, the
cokernel of the last map `Hom(⋀^{r-1} A^r, P) → Hom(⋀^r A^r, P)` of the dual complex is
`P / I P`, `I = φ(A^r)`: the map `Hom(⋀^r A^r, P) → P / I P` below is surjective with kernel the
image of that map. -/
theorem exact_lcomp_contraction_top (φ : Module.Dual A (Fin r → A)) (P : Type u)
    [AddCommGroup P] [Module A P] {s : ℕ} (hs : s + 1 = r) :
    Function.Exact (LinearMap.lcomp A P (contraction φ s))
        (augmentationLinearMap φ P ∘ₗ
          (koszulDualEquiv (A := A) (r := r) (q := 0) (p := s + 1) (by omega) P).symm.toLinearMap) ∧
      Function.Surjective
        (augmentationLinearMap φ P ∘ₗ
          (koszulDualEquiv (A := A) (r := r) (q := 0) (p := s + 1) (by omega)
            P).symm.toLinearMap) := by
  subst hs
  have hsq := lcomp_contraction_comp_koszulDualEquiv φ (q := 0) (p := s) (by omega) (by omega) P
  rw [pow_zero, one_smul] at hsq
  refine ⟨?_, (augmentationLinearMap_surjective φ P).comp (LinearEquiv.surjective _)⟩
  refine (Function.Exact.iff_of_ladder_linearEquiv (e₃ := LinearEquiv.refl A _) hsq ?_).2
    (exact_contraction_augmentationLinearMap φ P)
  ext x
  simp

/-! ### The dual of the Koszul resolution -/

/-- `Hom(⋀^n A^r ⊗ A, P) ≅ Hom(⋀^n A^r, P)`, precomposition with `ω ↦ ω ⊗ 1`. -/
noncomputable def homRid (n : ℕ) (P : Type u) [AddCommGroup P] [Module A P] :
    (⋀[A]^n (Fin r → A) ⊗[A] A →ₗ[A] P) ≃ₗ[A] (⋀[A]^n (Fin r → A) →ₗ[A] P) :=
  LinearEquiv.arrowCongr (TensorProduct.rid A _) (LinearEquiv.refl A P)

lemma lcomp_contraction_comp_homRid (φ : Module.Dual A (Fin r → A)) (p : ℕ) (P : Type u)
    [AddCommGroup P] [Module A P] :
    LinearMap.lcomp A P (contraction φ p) ∘ₗ (homRid p P).toLinearMap =
      (homRid (p + 1) P).toLinearMap ∘ₗ LinearMap.lcomp A P ((contraction φ p).rTensor A) := by
  ext g ω
  simp [homRid]

variable (f : Fin r → A)

lemma sequenceKoszulComplex_d_hom (n : ℕ) :
    ((sequenceKoszulComplex f (ModuleCat.of A A)).d (n + 1) n).hom =
      (contraction (koszulForm f) n).rTensor A := by
  rw [koszulComplex_d]
  rfl

/-- **The dual of the Koszul resolution is exact below the top degree** (Hartshorne III.7, proof
of Theorem 7.11). If `f₁, …, f_r` is Koszul-regular on `P`, the complex
`Hom_A(K_•(f; A), P)` is exact in degrees `1, …, r - 1`. -/
theorem exact_lcomp_sequenceKoszulComplex_d (P : Type u) [AddCommGroup P] [Module A P]
    (hP : IsKoszulRegular f (ModuleCat.of A P)) {p : ℕ} (hp : p + 2 ≤ r) :
    Function.Exact
      (LinearMap.lcomp A P ((sequenceKoszulComplex f (ModuleCat.of A A)).d (p + 1) p).hom)
      (LinearMap.lcomp A P
        ((sequenceKoszulComplex f (ModuleCat.of A A)).d (p + 1 + 1) (p + 1)).hom) := by
  rw [sequenceKoszulComplex_d_hom, sequenceKoszulComplex_d_hom]
  refine (Function.Exact.iff_of_ladder_linearEquiv
    (lcomp_contraction_comp_homRid (koszulForm f) p P)
    (lcomp_contraction_comp_homRid (koszulForm f) (p + 1) P)).1 ?_
  exact exact_lcomp_contraction (koszulForm f) P ((isKoszulRegular_iff_exact f _).1 hP) hp

/-- **The dual of the Koszul resolution is injective in degree zero** (for `r > 0`): if
`f₁, …, f_r` is Koszul-regular on `P`, then `Hom_A(K_0, P) → Hom_A(K_1, P)` is injective. -/
theorem injective_lcomp_sequenceKoszulComplex_d (P : Type u) [AddCommGroup P] [Module A P]
    (hP : IsKoszulRegular f (ModuleCat.of A P)) (hr : 0 < r) :
    Function.Injective
      (LinearMap.lcomp A P ((sequenceKoszulComplex f (ModuleCat.of A A)).d (0 + 1) 0).hom) := by
  rw [sequenceKoszulComplex_d_hom]
  have h := injective_lcomp_contraction_zero (koszulForm f) P
    ((isKoszulRegular_iff_exact f (ModuleCat.of A P)).1 hP) hr
  have hsq := lcomp_contraction_comp_homRid (koszulForm f) 0 P
  have : Function.Injective ((homRid (0 + 1) P).toLinearMap ∘ₗ
      LinearMap.lcomp A P ((contraction (koszulForm f) 0).rTensor A)) := by
    rw [← hsq, LinearMap.coe_comp]
    exact h.comp (homRid 0 P).injective
  rw [LinearMap.coe_comp] at this
  exact Function.Injective.of_comp this

/-- The map `Hom_A(K_r, P) → P / (f₁, …, f_r) P` identifying the top cohomology of the dual of
the Koszul resolution: through Koszul duality `Hom_A(K_r, P) ≅ ⋀^0 A^r ⊗ P = P`, followed by the
quotient map. -/
noncomputable def koszulDualTopMap {s : ℕ} (hs : s + 1 = r) (P : Type u) [AddCommGroup P]
    [Module A P] :
    ((sequenceKoszulComplex f (ModuleCat.of A A)).X (s + 1) →ₗ[A] P) →ₗ[A]
      P ⧸ (Ideal.span (Set.range f) • ⊤ : Submodule A P) :=
  (Submodule.quotEquivOfEq _ _ (koszulSubmodule_koszulForm f P)).toLinearMap ∘ₗ
    augmentationLinearMap (koszulForm f) P ∘ₗ
      (koszulDualEquiv (A := A) (r := r) (q := 0) (p := s + 1) (by omega) P).symm.toLinearMap ∘ₗ
        (homRid (s + 1) P).toLinearMap

/-- **The top cohomology of the dual of the Koszul resolution is `P / I P`** (Hartshorne III.7,
proof of Theorem 7.11), `I = (f₁, …, f_r)`: the map `koszulDualTopMap` is surjective and its
kernel is the image of `Hom_A(K_{r-1}, P) → Hom_A(K_r, P)`. No regularity is needed. -/
theorem exact_koszulDualTopMap {s : ℕ} (hs : s + 1 = r) (P : Type u) [AddCommGroup P]
    [Module A P] :
    Function.Exact
        (LinearMap.lcomp A P ((sequenceKoszulComplex f (ModuleCat.of A A)).d (s + 1) s).hom)
        (koszulDualTopMap f hs P) ∧
      Function.Surjective (koszulDualTopMap f hs P) := by
  obtain ⟨hex, hsurj⟩ := exact_lcomp_contraction_top (koszulForm f) P hs
  rw [sequenceKoszulComplex_d_hom]
  refine ⟨?_, ?_⟩
  · have := (Function.Exact.iff_of_ladder_linearEquiv
      (e₃ := Submodule.quotEquivOfEq _ _ (koszulSubmodule_koszulForm f P).symm)
      (lcomp_contraction_comp_homRid (koszulForm f) s P) (g₂₃ := augmentationLinearMap
        (koszulForm f) P ∘ₗ (koszulDualEquiv (A := A) (r := r) (q := 0) (p := s + 1) (by omega)
          P).symm.toLinearMap) (f₂₃ := koszulDualTopMap f hs P) (by ext; rfl)).1 hex
    exact this
  · simp only [koszulDualTopMap, LinearMap.coe_comp]
    exact (Submodule.quotEquivOfEq _ _ _).surjective.comp
      (hsurj.comp (homRid (s + 1) P).surjective)

/-! ### The top degree and the determinant transition law -/

variable (r) in
/-- The top exterior product `e₁ ∧ ⋯ ∧ e_r ∈ ⋀^r A^r`. -/
noncomputable def topForm : ⋀[A]^r (Fin r → A) :=
  exteriorPower.ιMulti_family A r (Pi.basisFun A (Fin r)) (topIndex r)

lemma topCoord_topForm : topCoord r (topForm (A := A) r : ExteriorAlgebra A (Fin r → A)) = 1 := by
  rw [topCoord_of_mem (topForm r).2, topForm, ← exteriorPower.basis_apply,
    Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_eq_same]

lemma eq_topCoord_smul_topForm (ω : ⋀[A]^r (Fin r → A)) :
    ω = topCoord r (ω : ExteriorAlgebra A (Fin r → A)) • topForm r := by
  rw [topCoord_of_mem ω.2]
  conv_lhs => rw [← ((Pi.basisFun A (Fin r)).exteriorPower r).sum_repr ω]
  rw [Fintype.sum_subsingleton _ (topIndex r), exteriorPower.basis_apply]
  rfl

/-- `⋀^r Q (e₁ ∧ ⋯ ∧ e_r) = det Q · e₁ ∧ ⋯ ∧ e_r` for an `r × r` matrix `Q`. -/
lemma exteriorPower_map_topForm (Q : Matrix (Fin r) (Fin r) A) :
    exteriorPower.map r (Matrix.toLin' Q) (topForm r) = Q.det • topForm r := by
  conv_lhs => rw [eq_topCoord_smul_topForm (exteriorPower.map r (Matrix.toLin' Q) (topForm r))]
  congr 1
  let b := Pi.basisFun A (Fin r)
  let g : (Fin r → A) [⋀^Fin r]→ₗ[A] A :=
    (topCoord r ∘ₗ (⋀[A]^r (Fin r → A)).subtype).compAlternatingMap (exteriorPower.ιMulti A r)
  have hg : ∀ v, g v = g b * b.det v := fun v => by
    conv_lhs => rw [g.eq_smul_basis_det b]
    rfl
  let v := b ∘ (Set.powersetCard.ofFinEmbEquiv.symm (topIndex r))
  have h1 : g v = 1 := topCoord_topForm
  have h2 : topCoord r (exteriorPower.map r (Matrix.toLin' Q) (topForm r) :
      ExteriorAlgebra A (Fin r → A)) = g (Matrix.toLin' Q ∘ v) := by
    rw [topForm, exteriorPower.ιMulti_family, exteriorPower.map_apply_ιMulti]
    rfl
  rw [h2, hg, Module.Basis.det_comp, LinearMap.det_toLin']
  have h3 := hg v
  rw [h1] at h3
  linear_combination (-Q.det) * h3

/-- Koszul duality in the top degree: `Hom(⋀^r A^r, P) ≅ ⋀^0 A^r ⊗ P = P` is evaluation at
`e₁ ∧ ⋯ ∧ e_r`. -/
lemma koszulDualEquiv_symm_top (P : Type u) [AddCommGroup P] [Module A P]
    (ψ : ⋀[A]^r (Fin r → A) →ₗ[A] P) :
    (koszulDualEquiv (A := A) (r := r) (q := 0) (p := r) (zero_add r) P).symm ψ =
      exteriorPower.ιMulti A 0 Fin.elim0 ⊗ₜ ψ (topForm r) := by
  apply (koszulDualEquiv (A := A) (r := r) (q := 0) (p := r) (zero_add r) P).injective
  rw [LinearEquiv.apply_symm_apply]
  refine LinearMap.ext fun ω => ?_
  rw [koszulDualEquiv_tmul, exteriorPower.ιMulti_apply_coe, ExteriorAlgebra.ιMulti_zero_apply,
    one_mul, ← map_smul, ← eq_topCoord_smul_topForm]

/-- The top map `Hom_A(K_r, P) → P / I P` is evaluation at `e₁ ∧ ⋯ ∧ e_r ⊗ 1` followed by the
quotient map. -/
lemma koszulDualTopMap_apply {s : ℕ} (f : Fin (s + 1) → A) (P : Type u) [AddCommGroup P]
    [Module A P] (ψ : (sequenceKoszulComplex f (ModuleCat.of A A)).X (s + 1) →ₗ[A] P) :
    koszulDualTopMap f rfl P ψ = Submodule.Quotient.mk (ψ (topForm (s + 1) ⊗ₜ 1)) := by
  change Submodule.quotEquivOfEq _ _ (koszulSubmodule_koszulForm f P)
    (augmentationLinearMap (koszulForm f) P
    ((koszulDualEquiv (A := A) (r := s + 1) (q := 0) (p := s + 1) (zero_add _) P).symm
      (homRid (s + 1) P ψ))) = _
  rw [koszulDualEquiv_symm_top]
  simp [homRid, augmentationLinearMap, degreeZeroEquiv, exteriorPower.zeroEquiv_ιMulti]
  rfl

/-- Changing generators by an invertible matrix does not change the ideal. -/
lemma span_range_vecMul {r : ℕ} (f : Fin r → A) (Q : Matrix (Fin r) (Fin r) A) [Invertible Q] :
    Ideal.span (Set.range (Matrix.vecMul f Q)) = Ideal.span (Set.range f) := by
  rw [← range_koszulForm, ← range_koszulForm, ← koszulForm_comp_toLin',
    LinearMap.range_comp_of_range_eq_top]
  exact LinearMap.range_eq_top.2 (Matrix.toLinearEquiv' Q inferInstance).surjective

/-- **The determinant transition law** (Hartshorne III.7, proof of Theorem 7.11). If the
generators `f₁, …, f_r` are replaced by `f Q` for an invertible matrix `Q`, then under the
change-of-basis map `K_•(f Q; A) → K_•(f; A)` the top identification
`Hom_A(K_r, P) → P / I P` is multiplied by `det Q`. -/
theorem koszulDualTopMap_changeOfBasis {s : ℕ} (f : Fin (s + 1) → A)
    (Q : Matrix (Fin (s + 1)) (Fin (s + 1)) A) [Invertible Q] (P : Type u) [AddCommGroup P]
    [Module A P] (ψ : (sequenceKoszulComplex f (ModuleCat.of A A)).X (s + 1) →ₗ[A] P) :
    koszulDualTopMap (Matrix.vecMul f Q) rfl P
        (ψ ∘ₗ ((sequenceKoszulChangeOfBasis f Q (ModuleCat.of A A)).f (s + 1)).hom) =
      Submodule.quotEquivOfEq _ _ (by rw [span_range_vecMul])
        (Q.det • koszulDualTopMap f rfl P ψ) := by
  rw [koszulDualTopMap_apply, koszulDualTopMap_apply, map_smul]
  change Submodule.Quotient.mk (ψ ((exteriorPower.map (s + 1) (Matrix.toLin' Q)).rTensor A
    (topForm (s + 1) ⊗ₜ 1))) = _
  rw [LinearMap.rTensor_tmul, exteriorPower_map_topForm, ← TensorProduct.smul_tmul']
  erw [ψ.map_smul]
  rw [Submodule.Quotient.mk_smul]
  rfl

end Duality

section Conormal

variable {V : Type u} [AddCommGroup V] [Module A V]

/-- The contraction by `φ` takes values in `φ(V) · ⋀ⁿ V`. -/
lemma contraction_mem_smul_top (φ : Module.Dual A V) (n : ℕ) (x : ⋀[A]^(n + 1) V) :
    contraction φ n x ∈ (LinearMap.range φ : Ideal A) • (⊤ : Submodule A (⋀[A]^n V)) := by
  have hx : x ∈ Submodule.span A (Set.range (exteriorPower.ιMulti A (n + 1) (M := V))) := by
    rw [exteriorPower.ιMulti_span]; trivial
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨v, rfl⟩ := hy
    rw [contraction_ιMulti]
    refine Submodule.sum_mem _ fun j _ => ?_
    rw [mul_smul]
    exact Submodule.smul_mem _ _
      (Submodule.smul_mem_smul (LinearMap.mem_range_self φ _) Submodule.mem_top)
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
  | smul a y _ hy => rw [map_smul]; exact Submodule.smul_mem _ a hy

/-- The contraction by `φ`, tensored with `M`, takes values in `φ(V) · (⋀ⁿ V ⊗ M)`. -/
lemma rTensor_contraction_mem_smul_top (φ : Module.Dual A V) (M : Type u) [AddCommGroup M]
    [Module A M] (n : ℕ) (x : ⋀[A]^(n + 1) V ⊗[A] M) :
    (contraction φ n).rTensor M x ∈
      (LinearMap.range φ : Ideal A) • (⊤ : Submodule A (⋀[A]^n V ⊗[A] M)) := by
  induction x using TensorProduct.induction_on with
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y hx hy => rw [map_add]; exact add_mem hx hy
  | tmul w m =>
    rw [LinearMap.rTensor_tmul]
    refine Submodule.smul_induction_on (contraction_mem_smul_top φ n w) (fun a ha y _ => ?_)
      (fun y z hy hz => ?_)
    · rw [← TensorProduct.smul_tmul']
      exact Submodule.smul_mem_smul ha Submodule.mem_top
    · rw [TensorProduct.add_tmul]; exact add_mem hy hz

/-- **The conormal module of a Koszul-regular sequence is free on the generators.** If `f` is
Koszul-regular on `A` and `∑ aⱼ fⱼ ∈ I²`, `I = (f₁, …, f_r)`, then every `aⱼ` lies in `I`. -/
theorem mem_of_sum_mul_mem_sq (hf : IsKoszulRegular f (ModuleCat.of A A)) (a : Fin r → A)
    (ha : ∑ j, a j * f j ∈ Ideal.span (Set.range f) ^ 2) (j : Fin r) :
    a j ∈ Ideal.span (Set.range f) := by
  set I := Ideal.span (Set.range f)
  rw [pow_two, ← Ideal.smul_eq_mul] at ha
  have ha' : ∑ j, a j * f j ∈ I • Submodule.span A (Set.range f) := ha
  obtain ⟨c, hcI, hc⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum I f _).1 ha'
  rw [Finsupp.sum_fintype _ _ (fun i => zero_smul A (f i))] at hc
  let b : Fin r → A := a - c
  have hb : koszulForm f b = 0 := by
    rw [koszulForm_apply]
    simp only [b, Pi.sub_apply, sub_mul, Finset.sum_sub_distrib, ← hc, smul_eq_mul, sub_self]
  let x : ⋀[A]^1 (Fin r → A) ⊗[A] A :=
    (exteriorPower.oneEquiv A (Fin r → A)).symm b ⊗ₜ[A] (1 : A)
  have hx0 : (contraction (koszulForm f) 0).rTensor A x = 0 := by
    apply (degreeZeroEquiv (V := Fin r → A) A).injective
    rw [degreeZeroEquiv_contraction_tmul, LinearEquiv.apply_symm_apply, hb, zero_smul,
      LinearEquiv.map_zero]
  have hx : ((sequenceKoszulComplex f (ModuleCat.of A A)).d 1 0).hom x = 0 := by
    rw [koszulComplex_d]; exact hx0
  have hex := hf 0
  rw [HomologicalComplex.exactAt_iff' _ 2 1 0 (by simp) (by simp)] at hex
  have hrange := (ShortComplex.moduleCat_exact_iff_range_eq_ker _).1 hex
  have hxr : x ∈ LinearMap.range ((sequenceKoszulComplex f (ModuleCat.of A A)).d 2 1).hom := by
    have h : x ∈ LinearMap.ker
        ((sequenceKoszulComplex f (ModuleCat.of A A)).sc' 2 1 0).g.hom := hx
    rw [← hrange] at h
    exact h
  obtain ⟨w, hw⟩ := hxr
  have hxI := rTensor_contraction_mem_smul_top (koszulForm f) A 1 w
  rw [range_koszulForm] at hxI
  have hw' : (contraction (koszulForm f) 1).rTensor A w = x := by
    rw [← hw, koszulComplex_d]; rfl
  rw [hw'] at hxI
  let ψ : ⋀[A]^1 (Fin r → A) ⊗[A] A →ₗ[A] A :=
    LinearMap.proj j ∘ₗ (exteriorPower.oneEquiv A (Fin r → A)).toLinearMap ∘ₗ
      (TensorProduct.rid A (⋀[A]^1 (Fin r → A))).toLinearMap
  have hψ : ψ x = b j := by
    simp [ψ, x]
  have hle : I • (⊤ : Submodule A (⋀[A]^1 (Fin r → A) ⊗[A] A)) ≤
      Submodule.comap ψ I := Submodule.smul_le.2 fun s hs m _ => by
    rw [Submodule.mem_comap, map_smul, smul_eq_mul]
    exact I.mul_mem_right _ hs
  have hbj : b j ∈ I := hψ ▸ hle hxI
  have : a j = b j + c j := by simp [b]
  rw [this]
  exact add_mem hbj (hcI j)

/-- **The conormal module of a Koszul-regular sequence.** If `f` is Koszul-regular on `A`, the
classes of `f₁, …, f_r` form a basis of `I/I²` over `A/I`, where `I = (f₁, …, f_r)`. -/
noncomputable def cotangentBasis (hf : IsKoszulRegular f (ModuleCat.of A A)) :
    Module.Basis (Fin r) (A ⧸ Ideal.span (Set.range f))
      (Ideal.Cotangent (Ideal.span (Set.range f))) :=
  Module.Basis.mk (v := fun j => Ideal.toCotangent (Ideal.span (Set.range f))
      ⟨f j, Ideal.subset_span ⟨j, rfl⟩⟩)
    (by
      rw [Fintype.linearIndependent_iff]
      intro g hg j
      choose a ha using fun j => Ideal.Quotient.mk_surjective (I := Ideal.span (Set.range f)) (g j)
      have hsmul : ∀ k, g k • Ideal.toCotangent (Ideal.span (Set.range f))
          ⟨f k, Ideal.subset_span ⟨k, rfl⟩⟩ = Ideal.toCotangent (Ideal.span (Set.range f))
            (a k • ⟨f k, Ideal.subset_span ⟨k, rfl⟩⟩) := by
        intro k
        rw [← ha k, map_smul, ← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
      simp only [hsmul, ← map_sum, Ideal.toCotangent_eq_zero] at hg
      have hsum : ∑ k, a k * f k ∈ Ideal.span (Set.range f) ^ 2 := by
        convert hg using 1
        simp [smul_eq_mul]
      rw [← ha j, Ideal.Quotient.eq_zero_iff_mem]
      exact mem_of_sum_mul_mem_sq f hf a hsum j)
    (by
      rintro x -
      obtain ⟨⟨y, hy⟩, rfl⟩ := Ideal.toCotangent_surjective (Ideal.span (Set.range f)) x
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 hy
      have hy' : (⟨y, hy⟩ : Ideal.span (Set.range f)) =
          ∑ k, c k • ⟨f k, Ideal.subset_span ⟨k, rfl⟩⟩ := by
        apply Subtype.ext
        simp [← hc]
      rw [hy', map_sum]
      refine Submodule.sum_mem _ fun k _ => ?_
      rw [map_smul, ← algebraMap_smul (A ⧸ Ideal.span (Set.range f))]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩))

lemma cotangentBasis_apply (hf : IsKoszulRegular f (ModuleCat.of A A)) (j : Fin r) :
    cotangentBasis f hf j =
      Ideal.toCotangent (Ideal.span (Set.range f)) ⟨f j, Ideal.subset_span ⟨j, rfl⟩⟩ :=
  Module.Basis.mk_apply _ _ _

end Conormal

section BaseChange

variable (hf : IsKoszulRegular f (ModuleCat.of A A)) {B : Type u} [CommRing B] [Algebra A B]
  (hker : Ideal.span (Set.range f) ≤ RingHom.ker (algebraMap A B))

/-- The coordinates of a section of `I` in the generators `f`, read in `B`. -/
noncomputable def idealCoordB : Ideal.span (Set.range f) →ₗ[A] (Fin r → B) :=
  (Ideal.Quotient.liftₐ (Ideal.span (Set.range f)) (Algebra.ofId A B)
      (fun _ ha => hker ha)).toLinearMap.compLeft (Fin r) ∘ₗ
    ((Finsupp.lcoeFun (R := A ⧸ Ideal.span (Set.range f)) (α := Fin r)
      (M := A ⧸ Ideal.span (Set.range f))).restrictScalars A) ∘ₗ
    ((cotangentBasis f hf).repr.toLinearMap.restrictScalars A) ∘ₗ
    (Ideal.toCotangent (Ideal.span (Set.range f)))

lemma idealCoordB_generator (j : Fin r) :
    idealCoordB f hf hker ⟨f j, Ideal.subset_span ⟨j, rfl⟩⟩ = Pi.single j 1 := by
  ext k
  simp only [idealCoordB, LinearMap.coe_comp, Function.comp_apply, LinearMap.compLeft_apply,
    LinearMap.coe_restrictScalars, LinearEquiv.coe_coe, ← cotangentBasis_apply f hf,
    Module.Basis.repr_self, Finsupp.lcoeFun_apply, Finsupp.single_eq_pi_single]
  by_cases h : k = j
  · subst h; simp
  · simp [h]

/-- **Base change of the ideal of a Koszul-regular sequence.** If `f` is Koszul-regular on `A`,
`I = (f₁, …, f_r)`, and `B` is an `A`-algebra in which `I` vanishes, then `B ⊗_A I` is free over
`B` on `1 ⊗ f₁, …, 1 ⊗ f_r`: indeed `B ⊗_A I = B ⊗_{A/I} I/I²`. -/
noncomputable def baseChangeIdealEquiv :
    B ⊗[A] Ideal.span (Set.range f) ≃ₗ[B] (Fin r → B) :=
  LinearEquiv.ofLinearMap (LinearMap.liftBaseChange B (idealCoordB f hf hker))
    (Fintype.linearCombination B (fun j => (1 : B) ⊗ₜ[A]
      (⟨f j, Ideal.subset_span ⟨j, rfl⟩⟩ : Ideal.span (Set.range f))))
    (by
      ext j : 1
      apply LinearMap.ext_ring
      rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.single_apply,
        Fintype.linearCombination_apply_single, one_smul, LinearMap.liftBaseChange_tmul,
        one_smul, idealCoordB_generator, LinearMap.id_comp, LinearMap.single_apply])
    (by
      refine TensorProduct.AlgebraTensorModule.ext fun b x => ?_
      obtain ⟨x, hx⟩ := x
      obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 hx
      have hx' : (⟨∑ k, c k • f k, hx⟩ : Ideal.span (Set.range f)) =
          ∑ k, c k • ⟨f k, Ideal.subset_span ⟨k, rfl⟩⟩ := by
        apply Subtype.ext
        simp
      rw [LinearMap.comp_apply, LinearMap.liftBaseChange_tmul, LinearMap.id_apply, hx', map_sum]
      simp only [map_smul, idealCoordB_generator, map_sum, LinearMap.map_smul_of_tower,
        Fintype.linearCombination_apply_single, TensorProduct.tmul_sum]
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [one_smul, TensorProduct.tmul_smul, smul_comm, TensorProduct.smul_tmul', smul_eq_mul,
        mul_one])

/-- The basis `1 ⊗ f₁, …, 1 ⊗ f_r` of `B ⊗_A I` (`baseChangeIdealEquiv`). -/
noncomputable def baseChangeIdealBasis :
    Module.Basis (Fin r) B (B ⊗[A] Ideal.span (Set.range f)) :=
  Module.Basis.ofEquivFun (baseChangeIdealEquiv f hf hker)

lemma baseChangeIdealBasis_apply (j : Fin r) :
    baseChangeIdealBasis f hf hker j =
      (1 : B) ⊗ₜ[A] (⟨f j, Ideal.subset_span ⟨j, rfl⟩⟩ : Ideal.span (Set.range f)) := by
  rw [baseChangeIdealBasis, Module.Basis.coe_ofEquivFun]
  change Fintype.linearCombination B _ _ = _
  rw [Fintype.linearCombination_apply_single, one_smul]

end BaseChange

end Koszul

open AlgebraicGeometry Limits Opposite Koszul

section Sections

variable {Y : Scheme.{u}}

attribute [local instance] HasFiniteBiproducts.of_hasFiniteProducts

/-- On an open `V` inside an open `W` over which `M|_W` is free of finite rank, the sections
`Γ(M, V)` form a free `Γ(Y, V)`-module. -/
lemma module_free_sections_of_iso_free {M : Y.Modules} {W : Y.Opens} {n : ℕ}
    (α : M.over W ≅ SheafOfModules.free (ULift.{u} (Fin n))) {V : Y.Opens} (hVW : V ≤ W) :
    Module.Free Γ(Y, V) Γ(M, V) := by
  let O : (Over W)ᵒᵖ := op (Over.mk (homOfLE hVW))
  let E := SheafOfModules.forget (Y.ringCatSheaf.over W) ⋙ PresheafOfModules.evaluation _ O
  have : E.Additive := by dsimp only [E]; infer_instance
  have : PreservesFiniteBiproducts E := inferInstance
  let un := SheafOfModules.unit (Y.ringCatSheaf.over W)
  let e : E.obj (M.over W) ≅ ModuleCat.of _ (Fin n → E.obj un) :=
    E.mapIso (α ≪≫ (biproduct.isoCoproduct (fun _ : ULift.{u} (Fin n) => un)).symm ≪≫
        biproduct.whiskerEquiv (f := fun _ : ULift.{u} (Fin n) => un)
          (g := fun _ : Fin n => un) Equiv.ulift (fun _ => Iso.refl _)) ≪≫
      E.mapBiproduct (fun _ : Fin n => un) ≪≫ ModuleCat.biproductIsoPi _
  have : Module.Free ((Y.ringCatSheaf.over W).obj.obj O) (E.obj un) :=
    Module.Free.self ((Y.ringCatSheaf.over W).obj.obj O)
  have : Module.Free ((Y.ringCatSheaf.over W).obj.obj O) (E.obj (M.over W)) :=
    Module.Free.of_equiv e.toLinearEquiv.symm
  exact this

variable {r : ℕ}

/-- A Koszul-regular sequence of sections over an affine open `U` stays Koszul-regular on every
basic open `D(g) ⊆ U`: `Γ(Y, D(g))` is a localization of `Γ(Y, U)`, hence flat. -/
lemma isKoszulRegular_basicOpen {U : Y.Opens} (hU : IsAffineOpen U) {f : Fin r → Γ(Y, U)}
    (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U))) (g : Γ(Y, U)) :
    IsKoszulRegular (fun j => algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g) (f j))
      (ModuleCat.of Γ(Y, Y.basicOpen g) Γ(Y, Y.basicOpen g)) := by
  have := hU.isLocalization_basicOpen g
  have : Module.Flat Γ(Y, U) Γ(Y, Y.basicOpen g) := IsLocalization.flat _ (Submonoid.powers g)
  exact IsKoszulRegular.baseChange f hf _

/-- **A Koszul-regular sequence is regular on a finite locally free module.** Let `f₁, …, f_r`
be sections over an affine open `U` of a scheme `Y` forming a Koszul-regular sequence in
`Γ(Y, U)`, and let `M` be a finite locally free `𝒪_Y`-module. Every point of `U` has a basic open
neighbourhood `D(g) ⊆ U` on which the restricted sequence is Koszul-regular on `Γ(M, D(g))`. -/
theorem isKoszulRegular_sections_of_isFiniteLocallyFree {U : Y.Opens} (hU : IsAffineOpen U)
    {f : Fin r → Γ(Y, U)} (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U)))
    {M : Y.Modules} (hM : Ringed.IsFiniteLocallyFree (R := Y.sheaf) M) {y : Y} (hy : y ∈ U) :
    ∃ g : Γ(Y, U), y ∈ Y.basicOpen g ∧
      IsKoszulRegular (fun j => algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g) (f j))
          (ModuleCat.of Γ(Y, Y.basicOpen g) Γ(Y, Y.basicOpen g)) ∧
      IsKoszulRegular (fun j => algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g) (f j))
          (ModuleCat.of Γ(Y, Y.basicOpen g) Γ(M, Y.basicOpen g)) := by
  obtain ⟨W, hyW, n, ⟨α⟩⟩ := hM y
  obtain ⟨g, hgW, hyg⟩ := hU.exists_basicOpen_le ⟨y, hyW⟩ hy
  have := module_free_sections_of_iso_free α hgW
  exact ⟨g, hyg, isKoszulRegular_basicOpen hU hf g,
    IsKoszulRegular.of_flat _ (isKoszulRegular_basicOpen hU hf g) _⟩

end Sections

section Immersion

variable {X Y : Scheme.{u}}

/-- **Koszul-regular closed immersions of codimension `r`.** A closed immersion `i : X ⟶ Y`
whose ideal sheaf `I` is locally generated by Koszul-regular sequences of length `r`: every point
of `Y` has an affine open neighbourhood `U` with a sequence `f₁, …, f_r ∈ Γ(Y, U)` that generates
`I(U)` and whose Koszul complex `K_•(f; Γ(Y, U))` is exact in positive degrees. -/
structure IsKoszulRegularImmersion (i : X ⟶ Y) (r : ℕ) : Prop where
  isClosedImmersion : IsClosedImmersion i
  exists_isKoszulRegular : ∀ y : Y, ∃ U : Y.affineOpens, y ∈ (U : Y.Opens) ∧
    ∃ f : Fin r → Γ(Y, U), i.ker.ideal U = Ideal.span (Set.range f) ∧
      IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U))

variable {i : X ⟶ Y} {r : ℕ}

/-- **The defining sequences of a Koszul-regular immersion are regular on a finite locally free
module.** For a codimension-`r` Koszul-regular closed immersion `i : X ⟶ Y` with ideal sheaf `I`
and a finite locally free `𝒪_Y`-module `M`, every point of `Y` has an affine open neighbourhood
`U` with a sequence `f₁, …, f_r` generating `I(U)` that is Koszul-regular both on `Γ(Y, U)` and on
`Γ(M, U)`. Compare Hartshorne III.7, proof of Theorem 7.11. -/
theorem IsKoszulRegularImmersion.exists_isKoszulRegular_sections
    (h : IsKoszulRegularImmersion i r) {M : Y.Modules}
    (hM : Ringed.IsFiniteLocallyFree (R := Y.sheaf) M) (y : Y) :
    ∃ U : Y.affineOpens, y ∈ (U : Y.Opens) ∧
      ∃ f : Fin r → Γ(Y, U), i.ker.ideal U = Ideal.span (Set.range f) ∧
        IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U)) ∧
        IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(M, U)) := by
  obtain ⟨U, hyU, f, hI, hf⟩ := h.exists_isKoszulRegular y
  obtain ⟨g, hyg, hfg, hMg⟩ := isKoszulRegular_sections_of_isFiniteLocallyFree U.2 hf hM hyU
  refine ⟨Y.affineBasicOpen g, hyg, fun j => algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g) (f j), ?_,
    hfg, hMg⟩
  rw [← i.ker.map_ideal_basicOpen U g, hI, Ideal.map_span, ← Set.range_comp]
  rfl

/-- **The local Koszul calculation for a Koszul-regular immersion** (Hartshorne III.7, proof of
Theorem 7.11). For a codimension-`r` Koszul-regular closed immersion `i : X ⟶ Y` with ideal sheaf
`I` and a finite locally free `𝒪_Y`-module `M`, every point of `Y` has an affine open
neighbourhood `U` with generators `f₁, …, f_r` of `I(U)` such that, writing `A = Γ(Y, U)` and
`P = Γ(M, U)`, the dual `Hom_A(K_•(f; A), P)` of the Koszul resolution of `A / I(U)` is exact in
degrees `0, …, r - 1` (injective in degree `0`), and its top cohomology is `P / I(U) P`. -/
theorem IsKoszulRegularImmersion.exists_koszulDual
    (h : IsKoszulRegularImmersion i r) {M : Y.Modules}
    (hM : Ringed.IsFiniteLocallyFree (R := Y.sheaf) M) (y : Y) :
    ∃ U : Y.affineOpens, y ∈ (U : Y.Opens) ∧
      ∃ f : Fin r → Γ(Y, U), i.ker.ideal U = Ideal.span (Set.range f) ∧
        IsKoszulRegular f (ModuleCat.of Γ(Y, U) Γ(Y, U)) ∧
        (0 < r → Function.Injective (LinearMap.lcomp Γ(Y, U) Γ(M, U)
          ((sequenceKoszulComplex f (ModuleCat.of Γ(Y, U) Γ(Y, U))).d (0 + 1) 0).hom)) ∧
        (∀ p, p + 2 ≤ r → Function.Exact
          (LinearMap.lcomp Γ(Y, U) Γ(M, U)
            ((sequenceKoszulComplex f (ModuleCat.of Γ(Y, U) Γ(Y, U))).d (p + 1) p).hom)
          (LinearMap.lcomp Γ(Y, U) Γ(M, U)
            ((sequenceKoszulComplex f (ModuleCat.of Γ(Y, U) Γ(Y, U))).d (p + 1 + 1) (p + 1)).hom)) ∧
        (∀ (s : ℕ) (hs : s + 1 = r), Function.Exact
            (LinearMap.lcomp Γ(Y, U) Γ(M, U)
              ((sequenceKoszulComplex f (ModuleCat.of Γ(Y, U) Γ(Y, U))).d (s + 1) s).hom)
            (koszulDualTopMap f hs Γ(M, U)) ∧
          Function.Surjective (koszulDualTopMap f hs Γ(M, U))) := by
  obtain ⟨U, hyU, f, hI, hf, hMf⟩ := h.exists_isKoszulRegular_sections hM y
  exact ⟨U, hyU, f, hI, hf, fun hr => injective_lcomp_sequenceKoszulComplex_d f _ hMf hr,
    fun p hp => exact_lcomp_sequenceKoszulComplex_d f _ hMf hp,
    fun s hs => exact_koszulDualTopMap f hs _⟩

end Immersion

end Hartshorne
