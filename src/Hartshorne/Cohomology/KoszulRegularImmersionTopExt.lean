/-!
# The top sheaf Ext of a Koszul-regular immersion, locally

Hartshorne, *Algebraic Geometry*, III.7, proof of Theorem 7.11 (pp. 245–246); Stacks Project,
Lemma 48.15.5 (tag 0BQZ).

Let `i : X ⟶ Y` be a closed immersion and `V₀ ⊆ Y` an affine open on which the ideal of `i` is
generated by `f₁, …, f_r ∈ A = Γ(Y, V₀)`, `r = s + 1`. For an `𝒪_Y`-module `M`, the top cohomology
of the dual `ℋom(𝒪_{V₀} ⊗_A K_•(f; A), M|_{V₀})` of the sheafified Koszul complex is identified with
`(i_* i^* M)|_{V₀}`:

* `Hartshorne.ClosedImmersionUnitKernel.unit_app_mem_smul_top`: for a quasi-coherent `G` and an
  affine open `V`, the kernel of the unit `G ⟶ i_* i^* G` on sections over `V` is
  `I(V) Γ(V, G)`, `I(V)` the kernel of `Γ(V, 𝒪_Y) → Γ(i⁻¹ V, 𝒪_X)`.
* `Hartshorne.Ringed.KoszulSheaf.topEval`: evaluation `ℋom(𝒪 ⊗_A K_r, G) ⟶ G` at the section
  `1 ⊗ e₁ ∧ ⋯ ∧ e_r ⊗ 1`; on sections over `W` it is `ψ ↦ ψ(e₁ ∧ ⋯ ∧ e_r ⊗ 1)` under
  `Hartshorne.Ringed.ScalarExtension.overHomEquiv`.
* `Hartshorne.KoszulImmersion.topHom`: evaluation followed by the unit `M ⟶ i_* i^* M`, restricted
  to `V₀`; it kills the image of the last differential (`d_comp_topHom`), and
  `Hartshorne.KoszulImmersion.topHomologyIso` is the induced isomorphism
  `h^r(ℋom(𝒪_{V₀} ⊗_A K_•(f; A), M|_{V₀})) ≅ (i_* i^* M)|_{V₀}` for quasi-coherent `M`.
* `Hartshorne.KoszulImmersion.localTopExtIso`: for `f` Koszul-regular, the composite
  `ℰxt^r_Y(i_* 𝒪_X, M)|_{V₀} ≅ (i_* i^* M)|_{V₀}` with the restriction isomorphism of `ℰxt` and the
  isomorphism `ℰxt^r ≅ h^r(ℋom(𝒪_{V₀} ⊗_A K_•(f; A), -))` of the Koszul resolution.
* `Hartshorne.KoszulImmersion.localTopExtIso_changeOfBasis` (the determinant transition law):
  replacing `f` by `f Q` for an invertible matrix `Q` multiplies `localTopExtIso` by `det Q`
  (`Hartshorne.Ringed.KoszulSheaf.scalarHom`). The comparison goes through the change-of-basis map
  `K_•(f Q; A) ⟶ K_•(f; A)` and the naturality of the resolution isomorphism in the resolution.

On a basic open `W = D(g) ⊆ V₀` the sections of `ℋom(𝒪 ⊗_A K_p, M)` are `Hom_A(K_p, M(W))`, the
evaluation is the top map `Hom_A(K_r, M(W)) → M(W) / (f) M(W)` of
`Hartshorne.Koszul.exact_koszulDualTopMap` composed with the quotient, and the unit on sections
over the affine open `W` is the quotient map `M(W) → M(W) / I(W) M(W) = Γ(i⁻¹ W, i^* M)`.
-/

set_option backward.isDefEq.respectTransparency false

namespace Hartshorne

namespace ClosedImmersionUnitKernel

open QuasicoherentAbelianAux PullbackQuasicoherent Scheme.Modules

variable {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (G : X.Modules) [G.IsQuasicoherent]
  (V : X.affineOpens)

/-- The `Γ(X, V)`-module `Γ(V, G)`, read on `Spec Γ(X, V)`. -/
private noncomputable abbrev sectionsModule : ModuleCat.{u} Γ(X, (V : X.Opens)) :=
  (modulesSpecToSheaf.obj (specRestriction G V)).presheaf.obj (op ⊤)

/-- `M̃ ≅ G|_V` for `M = Γ(V, G)`. -/
private noncomputable def sectionsTildeIso :
    (tilde.functor Γ(X, (V : X.Opens))).obj (sectionsModule G V) ≅ specRestriction G V :=
  @asIso _ _ _ _ (specRestriction G V).fromTildeΓ
    (isIso_fromTildeΓ_iff.mpr ((isQuasicoherent_iff_forall_essImage _).mp inferInstance V))

set_option maxHeartbeats 1000000 in
-- Unfolding the pullback isomorphisms on sections needs the larger budget (as in
-- `Hartshorne.closedImmersion_unit_app_surjective`, whose private computation this repeats).
/-- On the affine open `i⁻¹ V`, the pullback `i^* s` of a section `s` of `G` over `V` is
`1 ⊗ s ∈ Γ(i⁻¹ V) ⊗_{Γ(V)} Γ(V, G)`. -/
private theorem unit_toOpen'
    (s : Γ(G, (haveI := V.2.isOpenImmersion_fromSpec; V.2.fromSpec ''ᵁ ⊤)))
    (hT : haveI := V.2.isOpenImmersion_fromSpec
      haveI := (closedImmersionAffinePreimage i V).2.isOpenImmersion_fromSpec
      (closedImmersionAffinePreimage i V).2.fromSpec ''ᵁ ⊤ ≤ i ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤)) :
    haveI := V.2.isOpenImmersion_fromSpec
    (specRestrictionPullbackIso i G V (closedImmersionAffinePreimage i V) le_rfl
        (sectionsModule G V) (sectionsTildeIso G V)).inv.app ⊤
      (((Scheme.Modules.pullback i).obj G).presheaf.map (homOfLE hT).op
        (((pullbackPushforwardAdjunction i).unit.app G).app (V.2.fromSpec ''ᵁ ⊤) s)) =
      (tilde.toOpen ((ModuleCat.extendScalars (i.appLE V (closedImmersionAffinePreimage i V)
        le_rfl).hom).obj (sectionsModule G V)) ⊤).hom
        ((1 : Γ(Z, (closedImmersionAffinePreimage i V : Z.Opens))) ⊗ₜ[Γ(X, (V : X.Opens))]
          (show sectionsModule G V from s)) := by
  have : IsOpenImmersion V.2.fromSpec := V.2.isOpenImmersion_fromSpec
  have hT' : ⊤ ≤ Spec.map (i.appLE V (closedImmersionAffinePreimage i V) le_rfl) ⁻¹ᵁ
      (V.2.fromSpec ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤)) := by
    intro x _
    show (Spec.map _).base x ∈ V.2.fromSpec ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤)
    rw [Scheme.Hom.preimage_image_eq]
    trivial
  refine (specRestrictionPullbackIso_inv_unit _ _ _ _ _ _ _ _ _ hT hT').trans ?_
  set N := specRestriction G V
  have r1 : (sectionsTildeIso G V).inv.app (V.2.fromSpec ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤))
      (((restrictAdjunction V.2.fromSpec).unit.app G).app (V.2.fromSpec ''ᵁ ⊤) s) =
      (tilde.toOpen (sectionsModule G V) (V.2.fromSpec ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤))).hom s := by
    have h1 := ConcreteCategory.congr_hom
      (Scheme.Modules.toOpen_fromTildeΓ_app N (V.2.fromSpec ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤))) s
    have h2 : ∀ y, (sectionsTildeIso G V).inv.app (V.2.fromSpec ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤))
        ((sectionsTildeIso G V).hom.app (V.2.fromSpec ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤)) y) = y :=
      fun y => ConcreteCategory.congr_hom
        (congrArg (fun φ => Hom.app φ _) (sectionsTildeIso G V).hom_inv_id) y
    refine Eq.trans ?_ (h2 _)
    refine congrArg _ ?_
    exact h1.symm
  rw [r1]
  refine Eq.trans ?_ (Hartshorne.tildePullbackIso_hom_unit_apply _ _ _)
  refine congrArg _ ?_
  have r3 : (tilde.toOpen (sectionsModule G V)
      (V.2.fromSpec ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤))).hom s =
      ((tilde.functor _).obj (sectionsModule G V)).presheaf.map (homOfLE le_top).op
        ((tilde.toOpen (sectionsModule G V) ⊤).hom s) := rfl
  rw [r3]
  refine (congrArg _ (app_presheaf_map _ _ _)).trans ((presheaf_map_map _ _ _ (𝟙 _) _).trans ?_)
  exact (ConcreteCategory.congr_hom (CategoryTheory.Functor.map_id _ _) _).trans rfl

omit [G.IsQuasicoherent] in
/-- On sections over an affine open `V`, a function `k ∈ Γ(V)` acts on `Γ(V, G)` through its
restriction. -/
private theorem sectionsModule_smul (k : Γ(X, (V : X.Opens))) (y : sectionsModule G V)
    (hV : haveI := V.2.isOpenImmersion_fromSpec; V.2.fromSpec ''ᵁ ⊤ ≤ (V : X.Opens)) :
    haveI := V.2.isOpenImmersion_fromSpec
    (k • y : sectionsModule G V) =
      (show Γ(X, V.2.fromSpec ''ᵁ ⊤) from X.presheaf.map (homOfLE hV).op k) •
        (show Γ(G, V.2.fromSpec ''ᵁ ⊤) from y) := by
  have : IsOpenImmersion V.2.fromSpec := V.2.isOpenImmersion_fromSpec
  have e1 : (V.2.fromSpec.appIso ⊤).hom (X.presheaf.map (homOfLE hV).op k) =
      (Scheme.ΓSpecIso Γ(X, (V : X.Opens))).inv k := by
    refine (RelDiffLocal.fromSpec_appIso_hom_res V ⊤ hV k).trans ?_
    rw [show (⊤ : (Spec Γ(X, (V : X.Opens))).Opens).leTop = 𝟙 ⊤ from Subsingleton.elim _ _,
      op_id, CategoryTheory.Functor.map_id]
    rfl
  have e2 : (V.2.fromSpec.appIso ⊤).inv ((Scheme.ΓSpecIso Γ(X, (V : X.Opens))).inv k) =
      X.presheaf.map (homOfLE hV).op k := by
    rw [← e1]
    exact Iso.hom_inv_id_apply _ _
  change (show Γ(X, V.2.fromSpec ''ᵁ ⊤) from (V.2.fromSpec.appIso ⊤).inv
      ((Scheme.ΓSpecIso Γ(X, (V : X.Opens))).inv k)) •
      (show Γ(G, V.2.fromSpec ''ᵁ ⊤) from y) = _
  rw [e2]

set_option maxHeartbeats 1000000 in
set_option maxRecDepth 10000 in
-- Unfolding `specRestrictionPullbackIso` on sections, as in
-- `Hartshorne.closedImmersion_unit_app_surjective`.
/-- The kernel of the unit `G ⟶ i_* i^* G` on sections over `V`, written over the open
`V.fromSpec '' ⊤`. -/
private theorem unit_app_fromSpec_ker :
    haveI := V.2.isOpenImmersion_fromSpec
    ∀ s, ((pullbackPushforwardAdjunction i).unit.app G).app (V.2.fromSpec ''ᵁ ⊤) s = 0 →
      (show sectionsModule G V from s) ∈
        RingHom.ker (i.appLE V (closedImmersionAffinePreimage i V) le_rfl).hom •
          (⊤ : Submodule Γ(X, (V : X.Opens)) (sectionsModule G V)) := by
  have : IsOpenImmersion V.2.fromSpec := V.2.isOpenImmersion_fromSpec
  have : IsOpenImmersion (closedImmersionAffinePreimage i V).2.fromSpec :=
    (closedImmersionAffinePreimage i V).2.isOpenImmersion_fromSpec
  have hρ : Function.Surjective (i.appLE V (closedImmersionAffinePreimage i V) le_rfl) := by
    have h := i.app_surjective (V : X.Opens) V.2
    rwa [Scheme.Hom.app_eq_appLE] at h
  have hTV : V.2.fromSpec ''ᵁ ⊤ = (V : X.Opens) := by
    rw [Scheme.Hom.image_top_eq_opensRange, V.2.opensRange_fromSpec]
  have hWT : (closedImmersionAffinePreimage i V).2.fromSpec ''ᵁ ⊤ =
      i ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤) := by
    rw [Scheme.Hom.image_top_eq_opensRange,
      (closedImmersionAffinePreimage i V).2.opensRange_fromSpec, hTV]
  have hT := hWT.le
  have hK := unit_toOpen' i G V
  have htO := ConcreteCategory.bijective_of_isIso (tilde.toOpen ((ModuleCat.extendScalars
    (i.appLE V (closedImmersionAffinePreimage i V) le_rfl).hom).obj (sectionsModule G V)) ⊤)
  intro s hs
  have h1 : ((1 : Γ(Z, (closedImmersionAffinePreimage i V : Z.Opens))) ⊗ₜ[Γ(X, (V : X.Opens))]
      (show sectionsModule G V from s) : (ModuleCat.extendScalars
        (i.appLE V (closedImmersionAffinePreimage i V) le_rfl).hom).obj
          (sectionsModule G V)) = 0 := by
    refine htO.1 ((hK s hT).symm.trans ?_)
    rw [hs]
    exact (congrArg _ (map_zero _)).trans ((map_zero _).trans (map_zero _).symm)
  exact mem_ker_smul_top_of_one_tmul_eq_zero _ hρ _ _ h1

/-- **The kernel of the unit on affine sections.** For a closed immersion `i : Z ⟶ X`, a
quasi-coherent `𝒪_X`-module `G` and an affine open `V`, a section of `G` over `V` killed by the
unit `G ⟶ i_* i^* G` lies in `I(V) Γ(V, G)`, where `I(V)` is the kernel of
`Γ(V, 𝒪_X) → Γ(i⁻¹ V, 𝒪_Z)`. -/
theorem unit_app_mem_smul_top (s : Γ(G, (V : X.Opens)))
    (hs : ((pullbackPushforwardAdjunction i).unit.app G).app V s = 0) :
    s ∈ RingHom.ker (i.app V).hom • (⊤ : Submodule Γ(X, (V : X.Opens)) Γ(G, (V : X.Opens))) := by
  have : IsOpenImmersion V.2.fromSpec := V.2.isOpenImmersion_fromSpec
  have hTV : V.2.fromSpec ''ᵁ ⊤ = (V : X.Opens) := by
    rw [Scheme.Hom.image_top_eq_opensRange, V.2.opensRange_fromSpec]
  have hTW : i ⁻¹ᵁ (V.2.fromSpec ''ᵁ ⊤) ≤ (closedImmersionAffinePreimage i V : Z.Opens) :=
    fun x hx => by rw [hTV] at hx; exact hx
  have key : ∀ s : Γ(G, V.2.fromSpec ''ᵁ ⊤),
      ((pullbackPushforwardAdjunction i).unit.app G).app (V.2.fromSpec ''ᵁ ⊤) s = 0 →
        s ∈ RingHom.ker (i.app (V.2.fromSpec ''ᵁ ⊤)).hom •
          (⊤ : Submodule Γ(X, V.2.fromSpec ''ᵁ ⊤) Γ(G, V.2.fromSpec ''ᵁ ⊤)) := by
    intro s hs
    refine Submodule.smul_induction_on (p := fun x : sectionsModule G V =>
      (show Γ(G, V.2.fromSpec ''ᵁ ⊤) from x) ∈ RingHom.ker (i.app (V.2.fromSpec ''ᵁ ⊤)).hom •
          (⊤ : Submodule Γ(X, V.2.fromSpec ''ᵁ ⊤) Γ(G, V.2.fromSpec ''ᵁ ⊤)))
      (unit_app_fromSpec_ker i G V s hs) (fun k hk y _ => ?_) (fun x y hx hy => ?_)
    · have hk0 : i.app (V.2.fromSpec ''ᵁ ⊤) (X.presheaf.map (homOfLE hTV.le).op k) = 0 := by
        have hmor : X.presheaf.map (homOfLE hTV.le).op ≫ i.app (V.2.fromSpec ''ᵁ ⊤) =
            i.appLE V (closedImmersionAffinePreimage i V) le_rfl ≫
              Z.presheaf.map (homOfLE hTW).op := by
          rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
        refine (ConcreteCategory.congr_hom hmor k).trans ?_
        change Z.presheaf.map (homOfLE hTW).op
          (i.appLE V (closedImmersionAffinePreimage i V) le_rfl k) = 0
        rw [RingHom.mem_ker.mp hk, map_zero]
      change (show Γ(G, V.2.fromSpec ''ᵁ ⊤) from (k • y : sectionsModule G V)) ∈ _
      rw [sectionsModule_smul G V k y hTV.le]
      exact Submodule.smul_mem_smul hk0 Submodule.mem_top
    · exact add_mem hx hy
  rw [hTV] at key
  exact key s hs

end ClosedImmersionUnitKernel

namespace Ringed

namespace KoszulSheaf

open Koszul ScalarExtension

variable {X : TopCat.{u}} {R : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}
  {A : Type u} [CommRing A] (φ : A →+* R.obj.obj (op ⊤)) {s : ℕ} (f : Fin (s + 1) → A)

/-- The generator `e₁ ∧ ⋯ ∧ e_r ⊗ 1` of the top term `K_r = ⋀^r A^r ⊗ A`, `r = s + 1`. -/
noncomputable def topElt : (K f).X (s + 1) := topForm (s + 1) ⊗ₜ[A] (1 : A)

/-- The section `1 ⊗ (e₁ ∧ ⋯ ∧ e_r ⊗ 1)` of `𝒪_X ⊗_A K_r` over `W`. -/
noncomputable def topSection (W : Opens X) : ((complex φ f).X (s + 1)).val.obj (op W) :=
  (1 : R.obj.obj (op W)) ⊗ₜ[A, baseMap φ W] topElt f

/-- The sections `topSection` are compatible with restriction. -/
lemma topSection_restrict {V W : Opens X} (i : V ≤ W) :
    ((complex φ f).X (s + 1)).val.presheaf.map (homOfLE i).op (topSection φ f W) =
      topSection φ f V := by
  refine (presheaf_map_tmul φ _ (homOfLE i).op _ _).trans ?_
  rw [map_one]
  rfl

variable (G : SheafOfModules.{u} (ringCatSheafOf R))

/-- On sections over `W`, evaluation at `topSection`. -/
noncomputable def topEvalSections (W : Opens X) :
    (moduleSheafHom ((complex φ f).X (s + 1)) G).val.presheaf.obj (op W) →ₗ[R.obj.obj (op W)]
      G.val.presheaf.obj (op W) where
  toFun ψ := moduleSheafHomEval ψ (le_refl W) (topSection φ f W)
  map_add' _ _ := rfl
  map_smul' r ψ := by
    change moduleSheafHomEval (r • ψ) (le_refl W) _ = r • _
    rw [moduleSheafHomEval_smul]
    congr 1
    change (R.obj.map (𝟙 (op W))) r = r
    rw [CategoryTheory.Functor.map_id]
    rfl

/-- **Evaluation at the top generator**: the morphism `ℋom(𝒪_X ⊗_A K_r, G) ⟶ G` sending a local
morphism `ψ` over `W` to `ψ(1 ⊗ e₁ ∧ ⋯ ∧ e_r ⊗ 1)`. -/
noncomputable def topEval : moduleSheafHom ((complex φ f).X (s + 1)) G ⟶ G :=
  modulesHomMk (topEvalSections φ f G) fun W V i ψ => by
    change moduleSheafHomEval ψ ((le_refl V).trans i) (topSection φ f V) =
      G.val.presheaf.map (homOfLE i).op (moduleSheafHomEval ψ (le_refl W) (topSection φ f W))
    rw [← moduleSheafHomEval_natural ψ (le_refl W) i, topSection_restrict]

/-- On sections over `W`, `topEval` is evaluation at `e₁ ∧ ⋯ ∧ e_r ⊗ 1` under `overHomEquiv`. -/
lemma topEval_app (W : Opens X) (σ : ((complex φ f).X (s + 1)).over W ⟶ G.over W) :
    (topEval φ f G).val.app (op W) σ = overHomEquiv φ G W σ (topElt f) := by
  rw [overHomEquiv_apply]
  rfl

omit φ in
/-- The Koszul differential `K_r → K_{r-1}` takes values in `(f₁, …, f_r) K_{r-1}`. -/
lemma d_topElt_mem :
    ((K f).d (s + 1) s).hom (topElt f) ∈
      Ideal.span (Set.range f) • (⊤ : Submodule A ((K f).X s)) := by
  rw [sequenceKoszulComplex_d_hom, ← range_koszulForm]
  exact rTensor_contraction_mem_smul_top _ _ _ _

omit φ in
/-- The term `K_{r+1} = ⋀^{r+1} A^r ⊗ A` of the Koszul complex vanishes. -/
lemma isZero_K_succ : IsZero ((K f).X (s + 1 + 1)) := by
  have : IsEmpty (Set.powersetCard (Fin (s + 1)) (s + 1 + 1)) := ⟨fun t => by
    have h1 : (t : Finset (Fin (s + 1))).card = s + 1 + 1 := t.2
    have h2 := Finset.card_le_univ (t : Finset (Fin (s + 1)))
    rw [Fintype.card_fin] at h2
    omega⟩
  have : Subsingleton (⋀[A]^(s + 1 + 1) (Fin (s + 1) → A)) :=
    ((Pi.basisFun A (Fin (s + 1))).exteriorPower (s + 1 + 1)).repr.toEquiv.subsingleton
  exact ModuleCat.isZero_of_subsingleton
    (ModuleCat.of A (⋀[A]^(s + 1 + 1) (Fin (s + 1) → A) ⊗[A] A))

/-- The dual complex `ℋom(𝒪_X ⊗_A K_•(f; A), G)` has no differential out of the top degree. -/
lemma homComplex_d_top :
    ((moduleSheafHomComplex (complex φ f)).obj G).d (s + 1) (s + 1 + 1) = 0 := by
  rw [moduleSheafHomComplex_d]
  have h0 : (complex φ f).d (s + 1 + 1) (s + 1) = 0 := by
    change sheafMap φ ((K f).d (s + 1 + 1) (s + 1)) = 0
    rw [(isZero_K_succ f).eq_of_src ((K f).d (s + 1 + 1) (s + 1)) 0]
    exact sheafMap_zero φ
  rw [h0]
  apply SheafOfModules.hom_ext
  ext W σ
  apply (moduleSheafHomOverSectionsAddEquiv _ G W.unop).injective
  rw [moduleSheafHomPrecomp_app_app]
  refine Eq.trans ?_ (map_zero (moduleSheafHomOverSectionsAddEquiv _ G W.unop)).symm
  have hz : SheafOfModules.Hom.over (0 : (complex φ f).X (s + 1 + 1) ⟶ (complex φ f).X (s + 1))
      W.unop = 0 := by
    apply SheafOfModules.hom_ext
    ext B x
    rfl
  rw [hz, zero_comp]

/-- Multiplication by a global section `c` of `𝒪_X`, as an endomorphism of an `𝒪_X`-module. -/
noncomputable def scalarHom (c : R.obj.obj (op ⊤)) (G : SheafOfModules.{u} (ringCatSheafOf R)) :
    G ⟶ G :=
  modulesHomMk (fun W =>
    { toFun x := (R.obj.map (homOfLE (le_top : W ≤ ⊤)).op c) • x
      map_add' := smul_add _
      map_smul' a x := smul_comm _ a x }) fun W V i x => by
    change (R.obj.map (homOfLE (le_top : V ≤ ⊤)).op c) • G.val.presheaf.map (homOfLE i).op x =
      G.val.presheaf.map (homOfLE i).op ((R.obj.map (homOfLE (le_top : W ≤ ⊤)).op c) • x)
    refine Eq.trans ?_ (G.val.map_smul (homOfLE i).op _ x).symm
    congr 1
    change _ = (R.obj.map (homOfLE (le_top : W ≤ ⊤)).op ≫ R.obj.map (homOfLE i).op) c
    rw [← Functor.map_comp]
    rfl

/-- `scalarHom` on sections. -/
lemma scalarHom_app (c : R.obj.obj (op ⊤)) (G : SheafOfModules.{u} (ringCatSheafOf R))
    (W : Opens X) (x : G.val.obj (op W)) :
    ((scalarHom c G).val.app (op W)).hom x = (R.obj.map (homOfLE (le_top : W ≤ ⊤)).op c) • x :=
  rfl

/-- Multiplication by a global section commutes with morphisms of `𝒪_X`-modules. -/
@[reassoc]
lemma scalarHom_naturality (c : R.obj.obj (op ⊤)) {G G' : SheafOfModules.{u} (ringCatSheafOf R)}
    (g : G ⟶ G') : scalarHom c G ≫ g = g ≫ scalarHom c G' := by
  apply SheafOfModules.hom_ext
  ext W x
  exact (g.val.app W).hom.map_smul _ x

/-- The sheafification `𝒪_X ⊗_A c` of a chain map `c : K_•(f'; A) ⟶ K_•(f; A)`. -/
noncomputable def complexMap {r : ℕ} {f₁ f₂ : Fin r → A} (c : K f₁ ⟶ K f₂) :
    complex φ f₁ ⟶ complex φ f₂ where
  f p := sheafMap φ (c.f p)
  comm' p q _ := by
    change sheafMap φ (c.f p) ≫ sheafMap φ ((K f₂).d p q) =
      sheafMap φ ((K f₁).d p q) ≫ sheafMap φ (c.f q)
    rw [← sheafMap_comp, ← sheafMap_comp, c.comm]

/-- **The determinant transition law for the evaluation at the top generator.** Precomposing with
the change-of-basis map `𝒪 ⊗ K_r(f Q; A) ⟶ 𝒪 ⊗ K_r(f; A)` turns evaluation at
`e₁ ∧ ⋯ ∧ e_r ⊗ 1` for `f Q` into `det Q` times evaluation for `f`. -/
lemma topEval_changeOfBasis (Q : Matrix (Fin (s + 1)) (Fin (s + 1)) A) :
    (moduleSheafHomPrecomp
        ((complexMap φ (sequenceKoszulChangeOfBasis f Q (ModuleCat.of A A))).f (s + 1))).app G ≫
      topEval φ (Matrix.vecMul f Q) G = topEval φ f G ≫ scalarHom (φ Q.det) G := by
  apply SheafOfModules.hom_ext
  ext W σ
  change ((topEval φ (Matrix.vecMul f Q) G).val.app W).hom
    (SheafOfModules.Hom.over
      (sheafMap φ ((sequenceKoszulChangeOfBasis f Q (ModuleCat.of A A)).f (s + 1))) W.unop ≫ (σ : ((complex φ f).X (s + 1)).over W.unop ⟶ G.over W.unop)) =
    (R.obj.map (homOfLE (le_top : W.unop ≤ ⊤)).op (φ Q.det)) •
      ((topEval φ f G).val.app W).hom σ
  rw [topEval_app, topEval_app, overHomEquiv_comp]
  have h : ((sequenceKoszulChangeOfBasis f Q (ModuleCat.of A A)).f (s + 1)).hom
      (topElt (Matrix.vecMul f Q)) = Q.det • topElt f := by
    change (exteriorPower.map (s + 1) (Matrix.toLin' Q)).rTensor A (topForm (s + 1) ⊗ₜ 1) = _
    rw [LinearMap.rTensor_tmul, exteriorPower_map_topForm, ← TensorProduct.smul_tmul']
    rfl
  change (overHomEquiv φ G W.unop σ).hom
    (((sequenceKoszulChangeOfBasis f Q (ModuleCat.of A A)).f (s + 1)).hom
      (topElt (Matrix.vecMul f Q))) = _
  rw [h, map_smul]
  rfl

omit φ in
/-- In degree zero the change-of-basis map is the identity of `K_0 = A`. -/
lemma degreeZeroEquiv_changeOfBasis (Q : Matrix (Fin (s + 1)) (Fin (s + 1)) A)
    (k : (K (Matrix.vecMul f Q)).X 0) :
    degreeZeroEquiv (V := Fin (s + 1) → A) A
        (((sequenceKoszulChangeOfBasis f Q (ModuleCat.of A A)).f 0).hom k) =
      degreeZeroEquiv (V := Fin (s + 1) → A) A k := by
  have h : (degreeZeroEquiv (V := Fin (s + 1) → A) A).toLinearMap ∘ₗ
      (exteriorPower.map 0 (Matrix.toLin' Q)).rTensor A =
      (degreeZeroEquiv (V := Fin (s + 1) → A) A).toLinearMap :=
    TensorProduct.ext' fun x a => by
      rw [LinearMap.comp_apply, LinearMap.rTensor_tmul, LinearEquiv.coe_coe, degreeZeroEquiv_tmul,
        degreeZeroEquiv_tmul]
      exact congrArg (fun c => c • a)
        (LinearMap.congr_fun (exteriorPower.zeroEquiv_naturality (Matrix.toLin' Q)) x)
  exact LinearMap.congr_fun h k

end KoszulSheaf

end Ringed

/-- A linear map sends `I M` into `I N`. -/
lemma map_mem_ideal_smul_top {A : Type u} [CommRing A] {P Q : Type u} [AddCommGroup P]
    [Module A P] [AddCommGroup Q] [Module A Q] (g : P →ₗ[A] Q) (I : Ideal A) {x : P}
    (hx : x ∈ I • (⊤ : Submodule A P)) : g x ∈ I • (⊤ : Submodule A Q) := by
  refine Submodule.smul_induction_on hx (fun a ha n _ => ?_) (fun y z hy hz => ?_)
  · rw [map_smul]
    exact Submodule.smul_mem_smul ha Submodule.mem_top
  · rw [map_add]
    exact add_mem hy hz

/-- If `x ∈ (ψ(f)) P` for a ring map `ψ : A → S` and an `S`-module `P`, then `x ∈ (f) P` with `P`
viewed as an `A`-module. -/
lemma mem_span_smul_top_restrictScalars {A S : Type u} [CommRing A] [CommRing S] (ψ : A →+* S)
    (P : ModuleCat.{u} S) {ι : Type*} (f : ι → A) (x : (ModuleCat.restrictScalars ψ).obj P)
    (hx : (x : P) ∈ Ideal.span (Set.range fun j => ψ (f j)) • (⊤ : Submodule S P)) :
    x ∈ Ideal.span (Set.range f) • (⊤ : Submodule A ((ModuleCat.restrictScalars ψ).obj P)) := by
  have key : ∀ a ∈ Ideal.span (Set.range fun j => ψ (f j)), ∀ n : P,
      ((a • n : P) : (ModuleCat.restrictScalars ψ).obj P) ∈
        Ideal.span (Set.range f) • (⊤ : Submodule A ((ModuleCat.restrictScalars ψ).obj P)) := by
    intro a ha
    induction ha using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨j, rfl⟩ := ha
      intro n
      exact Submodule.smul_mem_smul (M := (ModuleCat.restrictScalars ψ).obj P) (r := f j) (n := n)
        (Ideal.subset_span ⟨j, rfl⟩) Submodule.mem_top
    | zero =>
      intro n
      rw [zero_smul]
      exact zero_mem _
    | add a b _ _ ha hb =>
      intro n
      rw [add_smul]
      exact add_mem (ha n) (hb n)
    | smul b a _ ha =>
      intro n
      rw [smul_eq_mul, mul_comm, mul_smul]
      exact ha (b • n)
  exact Submodule.smul_induction_on (p := fun x : P =>
    (x : (ModuleCat.restrictScalars ψ).obj P) ∈
      Ideal.span (Set.range f) • (⊤ : Submodule A ((ModuleCat.restrictScalars ψ).obj P))) hx
    (fun a ha n _ => key a ha n) (fun y z hy hz => add_mem hy hz)

namespace KoszulImmersion

open Koszul Ringed.KoszulSheaf Ringed.ScalarExtension

section Top

variable {Y : Scheme.{u}} {V₀ : Y.Opens} (hV₀ : IsAffineOpen V₀) {X : Scheme.{u}} (i : X ⟶ Y)
  {s : ℕ} (f : Fin (s + 1) → Γ(Y, V₀)) (M : Y.Modules)

omit hV₀ in
/-- The restriction `(i_* i^* M)|_{V₀}`. -/
noncomputable abbrev pullbackRestrict (V₀ : Y.Opens) :
    SheafOfModules.{u} (ringCatSheafOf (Ringed.restrictRingSheaf Y.sheaf V₀)) :=
  (Ringed.moduleRestrict V₀).obj
    ((Scheme.Modules.pushforward i).obj ((Scheme.Modules.pullback i).obj M))

omit hV₀ in
/-- The unit `M ⟶ i_* i^* M`, restricted to `V₀`. -/
noncomputable abbrev unitRestrict (V₀ : Y.Opens) :
    (Ringed.moduleRestrict V₀).obj M ⟶ pullbackRestrict i M V₀ :=
  (Ringed.moduleRestrict V₀).map ((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app M)

omit hV₀ in
/-- The dual `ℋom(𝒪_{V₀} ⊗_A K_•(f; A), M|_{V₀})` of the sheafified Koszul complex. -/
noncomputable abbrev dualComplex :
    CochainComplex (SheafOfModules.{u} (ringCatSheafOf (Ringed.restrictRingSheaf Y.sheaf V₀))) ℕ :=
  (Ringed.moduleSheafHomComplex (Ringed.KoszulSheaf.complex (restrictPhi V₀) f)).obj
    ((Ringed.moduleRestrict V₀).obj M)

omit hV₀ in
/-- **The local top-Ext map**: evaluation at `e₁ ∧ ⋯ ∧ e_r ⊗ 1`, followed by the unit
`M ⟶ i_* i^* M`, as a morphism `ℋom(𝒪_{V₀} ⊗_A K_r, M|_{V₀}) ⟶ (i_* i^* M)|_{V₀}`. -/
noncomputable def topHom : (dualComplex f M).X (s + 1) ⟶ pullbackRestrict i M V₀ :=
  Ringed.KoszulSheaf.topEval (restrictPhi V₀) f _ ≫ unitRestrict i M V₀

include hV₀ in
/-- The elements of `(f₁, …, f_r)` act by zero on the sections of `i_* (-)` over opens of `V₀`. -/
lemma app_baseMap_eq_zero [IsClosedImmersion i]
    (hI : i.ker.ideal ⟨V₀, hV₀⟩ = Ideal.span (Set.range f)) (W : Opens ((Opens.toTopCat Y).obj V₀))
    {a : Γ(Y, V₀)} (ha : a ∈ Ideal.span (Set.range f)) :
    (i.app (V₀.isOpenEmbedding.functor.obj W)).hom (baseMap (restrictPhi V₀) W a) = 0 := by
  have h1 : a ∈ RingHom.ker (i.app V₀).hom := by
    rw [← i.ker_apply ⟨V₀, hV₀⟩, hI]
    exact ha
  rw [RingHom.mem_ker] at h1
  rw [restrictPhi, baseMap_eq W]
  have h1' : (ConcreteCategory.hom (i.app V₀)) a = 0 := h1
  refine (ConcreteCategory.congr_hom (i.naturality (homOfLE (incl_le W)).op) a).trans ?_
  rw [ConcreteCategory.comp_apply, h1', map_zero]

include hV₀ in
/-- The restricted unit kills `(f₁, …, f_r) M(W)`. -/
lemma unitRestrict_app_eq_zero [IsClosedImmersion i]
    (hI : i.ker.ideal ⟨V₀, hV₀⟩ = Ideal.span (Set.range f)) (W : Opens ((Opens.toTopCat Y).obj V₀))
    {m : (ModuleCat.restrictScalars (baseMap (restrictPhi V₀) W)).obj
      (((Ringed.moduleRestrict V₀).obj M).val.obj (op W))}
    (hm : m ∈ Ideal.span (Set.range f) • (⊤ : Submodule Γ(Y, V₀)
      ((ModuleCat.restrictScalars (baseMap (restrictPhi V₀) W)).obj
        (((Ringed.moduleRestrict V₀).obj M).val.obj (op W))))) :
    ((unitRestrict i M V₀).val.app (op W)).hom m = 0 := by
  refine Submodule.smul_induction_on hm (fun a ha n _ => ?_) (fun x y hx hy => ?_)
  · change ((unitRestrict i M V₀).val.app (op W)).hom (baseMap (restrictPhi V₀) W a • n) = 0
    rw [map_smul]
    change @HSMul.hSMul ↑(X.ringCatSheaf.obj.obj (op (i ⁻¹ᵁ V₀.isOpenEmbedding.functor.obj W)))
      ↑(((Scheme.Modules.pullback i).obj M).val.obj (op (i ⁻¹ᵁ V₀.isOpenEmbedding.functor.obj W)))
      _ instHSMul ((i.app (V₀.isOpenEmbedding.functor.obj W)).hom (baseMap (restrictPhi V₀) W a))
      (((unitRestrict i M V₀).val.app (op W)).hom n) = 0
    rw [app_baseMap_eq_zero hV₀ i f hI W ha, zero_smul]
  · rw [map_add, hx, hy, add_zero]

include hV₀ in
/-- The local top-Ext map kills the image of the last differential of the dual complex. -/
lemma d_comp_topHom [IsClosedImmersion i]
    (hI : i.ker.ideal ⟨V₀, hV₀⟩ = Ideal.span (Set.range f)) :
    (dualComplex f M).d s (s + 1) ≫ topHom i f M = 0 := by
  apply SheafOfModules.hom_ext
  ext W σ
  change ((unitRestrict i M V₀).val.app W).hom ((Ringed.KoszulSheaf.topEval (restrictPhi V₀) f
    ((Ringed.moduleRestrict V₀).obj M)).val.app W
      (((dualComplex f M).d s (s + 1)).val.app W σ)) = 0
  rw [topEval_app, overHomEquiv_homComplex_d]
  exact unitRestrict_app_eq_zero hV₀ i f M hI W.unop
    (map_mem_ideal_smul_top (overHomEquiv (restrictPhi V₀) ((Ringed.moduleRestrict V₀).obj M)
      W.unop σ).hom _ (d_topElt_mem f))

section Basic

variable [IsClosedImmersion i] (hI : i.ker.ideal ⟨V₀, hV₀⟩ = Ideal.span (Set.range f))
  [M.IsQuasicoherent]

include hV₀ hI in
/-- Over a basic open `W` of `V₀`, a section of `ℋom(𝒪 ⊗_A K_r, M)` killed by the local top-Ext
map is a coboundary. -/
lemma topHom_exact_basicOpen (W : Opens ((Opens.toTopCat Y).obj V₀)) (g : Γ(Y, V₀))
    (hg : Y.basicOpen g = V₀.isOpenEmbedding.functor.obj W)
    (x : ((dualComplex f M).X (s + 1)).val.obj (op W))
    (hx : ((topHom i f M).val.app (op W)).hom x = 0) :
    ∃ y, (((dualComplex f M).d s (s + 1)).val.app (op W)).hom y = x := by
  obtain ⟨haff, hker⟩ := ker_app_of_eq_basicOpen hV₀ hI g _ hg (incl_le W)
  set G := (Ringed.moduleRestrict V₀).obj M
  set P := (ModuleCat.restrictScalars (baseMap (restrictPhi V₀) W)).obj (G.val.obj (op W))
  have h1 := ClosedImmersionUnitKernel.unit_app_mem_smul_top i M ⟨_, haff⟩
    (((Ringed.KoszulSheaf.topEval (restrictPhi V₀) f G).val.app (op W)).hom x) hx
  rw [hker, ← baseMap_eq W] at h1
  have h2 := mem_span_smul_top_restrictScalars (baseMap (restrictPhi V₀) W) (G.val.obj (op W)) f
    (((Ringed.KoszulSheaf.topEval (restrictPhi V₀) f G).val.app (op W)).hom x) h1
  rw [topEval_app] at h2
  have h3 : koszulDualTopMap f rfl P (overHomEquiv (restrictPhi V₀) G W x).hom = 0 := by
    rw [koszulDualTopMap_apply, Submodule.Quotient.mk_eq_zero]
    exact h2
  obtain ⟨y', hy'⟩ := (exact_koszulDualTopMap f rfl P).1 _ |>.1 h3
  let y : (K f).X s ⟶ P := ModuleCat.homEquiv.symm y'
  refine ⟨(overHomEquiv (restrictPhi V₀) G W).symm y, ?_⟩
  apply (overHomEquiv (restrictPhi V₀) G W).injective
  have h4 := overHomEquiv_homComplex_d (restrictPhi V₀) f G s W
    ((overHomEquiv (restrictPhi V₀) G W).symm y)
  rw [Equiv.apply_symm_apply] at h4
  refine h4.trans ?_
  ext z
  rw [← hy']
  rfl

include hV₀ hI in
/-- Over a basic open `W` of `V₀`, the local top-Ext map is surjective on sections. -/
lemma topHom_surjective_basicOpen (W : Opens ((Opens.toTopCat Y).obj V₀)) (g : Γ(Y, V₀))
    (hg : Y.basicOpen g = V₀.isOpenEmbedding.functor.obj W)
    (t : (pullbackRestrict i M V₀).val.obj (op W)) :
    ∃ x, ((topHom i f M).val.app (op W)).hom x = t := by
  obtain ⟨haff, -⟩ := ker_app_of_eq_basicOpen hV₀ hI g _ hg (incl_le W)
  set G := (Ringed.moduleRestrict V₀).obj M
  set P := (ModuleCat.restrictScalars (baseMap (restrictPhi V₀) W)).obj (G.val.obj (op W))
  obtain ⟨m, hm⟩ := closedImmersion_unit_app_surjective i M ⟨_, haff⟩ t
  obtain ⟨ψ, hψ⟩ := (exact_koszulDualTopMap f rfl P).2 (Submodule.Quotient.mk (m : P))
  rw [koszulDualTopMap_apply, Submodule.Quotient.eq] at hψ
  refine ⟨(overHomEquiv (restrictPhi V₀) G W).symm (ModuleCat.homEquiv.symm ψ), ?_⟩
  change ((unitRestrict i M V₀).val.app (op W)).hom
    (((Ringed.KoszulSheaf.topEval (restrictPhi V₀) f G).val.app (op W)).hom _) = t
  rw [topEval_app, Equiv.apply_symm_apply]
  have h5 := unitRestrict_app_eq_zero hV₀ i f M hI W hψ
  rw [map_sub, sub_eq_zero] at h5
  exact h5.trans hm

include hV₀ hI in
/-- `ℋom(𝒪 ⊗ K_{r-1}, M|_{V₀}) ⟶ ℋom(𝒪 ⊗ K_r, M|_{V₀}) ⟶ (i_* i^* M)|_{V₀}` is exact. -/
lemma topHom_exact :
    (ShortComplex.mk ((dualComplex f M).d s (s + 1)) (topHom i f M)
      (d_comp_topHom hV₀ i f M hI)).Exact :=
  sheafOfModules_exact_of_isBasis_sections _ (isBasis_basicOpen hV₀)
    fun W ⟨g, hg⟩ x hx => topHom_exact_basicOpen hV₀ i f M hI W g hg x hx

include hV₀ hI in
/-- The local top-Ext map is an epimorphism. -/
lemma epi_topHom : Epi (topHom i f M) := by
  rw [← ShortComplex.exact_iff_epi (ShortComplex.mk (topHom i f M)
    (0 : pullbackRestrict i M V₀ ⟶ pullbackRestrict i M V₀) (by simp)) rfl]
  exact sheafOfModules_exact_of_isBasis_sections _ (isBasis_basicOpen hV₀)
    fun W ⟨g, hg⟩ x _ => topHom_surjective_basicOpen hV₀ i f M hI W g hg x

/-- **The top cohomology of the dual Koszul complex** (Hartshorne III.7, proof of Theorem 7.11):
for a closed immersion `i`, an affine open `V₀` on which the ideal of `i` is generated by
`f₁, …, f_r`, and a quasi-coherent `M`, the local top-Ext map induces an isomorphism
`h^r(ℋom(𝒪_{V₀} ⊗_A K_•(f; A), M|_{V₀})) ≅ (i_* i^* M)|_{V₀}`. -/
noncomputable def topHomologyIso : (dualComplex f M).homology (s + 1) ≅ pullbackRestrict i M V₀ :=
  haveI := epi_topHom hV₀ i f M hI
  (dualComplex f M).isoHomologyι (s + 1) (s + 1 + 1) (by simp)
      (Ringed.KoszulSheaf.homComplex_d_top (restrictPhi V₀) f _) ≪≫
    IsColimit.coconePointUniqueUpToIso
      ((dualComplex f M).opcyclesIsCokernel s (s + 1) (by simp))
      ((topHom_exact hV₀ i f M hI).gIsCokernel)

/-- `topHomologyIso` is induced by the local top-Ext map on cocycles. -/
lemma homologyπ_comp_topHomologyIso_hom :
    (dualComplex f M).homologyπ (s + 1) ≫ (topHomologyIso hV₀ i f M hI).hom =
      (dualComplex f M).iCycles (s + 1) ≫ topHom i f M := by
  rw [topHomologyIso, Iso.trans_hom, HomologicalComplex.isoHomologyι_hom,
    HomologicalComplex.homology_π_ι_assoc]
  congr 1
  have := epi_topHom hV₀ i f M hI
  exact IsColimit.comp_coconePointUniqueUpToIso_hom
    ((dualComplex f M).opcyclesIsCokernel s (s + 1) (by simp))
    ((topHom_exact hV₀ i f M hI).gIsCokernel) WalkingParallelPair.one

omit hI [IsClosedImmersion i] [M.IsQuasicoherent] in
/-- **The determinant transition law for the local top-Ext map.** -/
lemma topHom_changeOfBasis (Q : Matrix (Fin (s + 1)) (Fin (s + 1)) Γ(Y, V₀)) :
    (Ringed.moduleSheafHomPrecomp ((complexMap (restrictPhi V₀)
        (sequenceKoszulChangeOfBasis f Q (ModuleCat.of _ _))).f (s + 1))).app _ ≫
      topHom i (Matrix.vecMul f Q) M =
    topHom i f M ≫ scalarHom (restrictPhi V₀ Q.det) (pullbackRestrict i M V₀) := by
  rw [topHom, topHom, ← Category.assoc, topEval_changeOfBasis, Category.assoc,
    scalarHom_naturality, Category.assoc]

/-- **The local top-Ext isomorphisms change by `det Q`** on cohomology: the map on `h^r` induced by
the change-of-basis map `K_•(f Q) ⟶ K_•(f)`, followed by the isomorphism for `f Q`, is the
isomorphism for `f` followed by multiplication by `det Q`. -/
lemma homologyMap_comp_topHomologyIso_hom (Q : Matrix (Fin (s + 1)) (Fin (s + 1)) Γ(Y, V₀))
    (hI' : i.ker.ideal ⟨V₀, hV₀⟩ = Ideal.span (Set.range (Matrix.vecMul f Q))) :
    HomologicalComplex.homologyMap ((Ringed.moduleSheafHomComplexMap (complexMap (restrictPhi V₀)
        (sequenceKoszulChangeOfBasis f Q (ModuleCat.of _ _)))).app
          ((Ringed.moduleRestrict V₀).obj M)) (s + 1) ≫
      (topHomologyIso hV₀ i (Matrix.vecMul f Q) M hI').hom =
    (topHomologyIso hV₀ i f M hI).hom ≫
      scalarHom (restrictPhi V₀ Q.det) (pullbackRestrict i M V₀) := by
  rw [← cancel_epi ((dualComplex f M).homologyπ (s + 1)),
    HomologicalComplex.homologyπ_naturality_assoc, homologyπ_comp_topHomologyIso_hom,
    reassoc_of% (homologyπ_comp_topHomologyIso_hom hV₀ i f M hI),
    HomologicalComplex.cyclesMap_i_assoc, Ringed.moduleSheafHomComplexMap_app_f,
    topHom_changeOfBasis]

omit [M.IsQuasicoherent] in
/-- The sheafified Koszul complex of a Koszul-regular sequence generating the ideal of `i` on
`V₀` resolves `(i_* 𝒪_X)|_{V₀}`. -/
lemma quasiIso_koszulAugmentation (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, V₀) Γ(Y, V₀))) :
    QuasiIso (augmentation (restrictPhi V₀) f (augHom i f) (d_comp_augHom hV₀ i f hI)) := by
  refine quasiIso_augmentation (restrictPhi V₀) f hf (augHom i f) (d_comp_augHom hV₀ i f hI)
    (isBasis_basicOpen hV₀) ?_ (fun W ⟨g, hg⟩ => augHom_exact hV₀ i f hI W g hg)
  rintro W ⟨g, hg⟩
  rw [restrictPhi, baseMap_eq W]
  exact flat_of_eq_basicOpen hV₀ g _ hg (incl_le W)

omit [M.IsQuasicoherent] in
/-- The sheafified change-of-basis map is compatible with the augmentations. -/
lemma complexMap_comp_augmentation (Q : Matrix (Fin (s + 1)) (Fin (s + 1)) Γ(Y, V₀))
    (hI' : i.ker.ideal ⟨V₀, hV₀⟩ = Ideal.span (Set.range (Matrix.vecMul f Q))) :
    complexMap (restrictPhi V₀) (sequenceKoszulChangeOfBasis f Q (ModuleCat.of _ _)) ≫
        augmentation (restrictPhi V₀) f (augHom i f) (d_comp_augHom hV₀ i f hI) =
      augmentation (restrictPhi V₀) (Matrix.vecMul f Q) (augHom i (Matrix.vecMul f Q))
        (d_comp_augHom hV₀ i _ hI') := by
  apply (ChainComplex.toSingle₀Equiv _ _).injective
  apply Subtype.ext
  rw [ChainComplex.toSingle₀Equiv_apply_coe, ChainComplex.toSingle₀Equiv_apply_coe,
    HomologicalComplex.comp_f, ChainComplex.toSingle₀Equiv_symm_apply_f_zero,
    ChainComplex.toSingle₀Equiv_symm_apply_f_zero]
  apply SheafOfModules.hom_ext
  refine (presheafMap_comp_homOfLinear _ _ _ (augLinear i f)).trans ?_
  congr 1
  ext k
  change (LinearMap.toSpanSingleton _ _ _ ∘ₗ
      (degreeZeroEquiv (V := Fin (s + 1) → Γ(Y, V₀)) Γ(Y, V₀)).toLinearMap)
        (((sequenceKoszulChangeOfBasis f Q (ModuleCat.of _ _)).f 0).hom k) =
    (LinearMap.toSpanSingleton _ _ _ ∘ₗ
      (degreeZeroEquiv (V := Fin (s + 1) → Γ(Y, V₀)) Γ(Y, V₀)).toLinearMap) k
  rw [LinearMap.comp_apply, LinearMap.comp_apply]
  exact congrArg _ (degreeZeroEquiv_changeOfBasis f Q k)

/-- **The local top-Ext isomorphism**: for a closed immersion `i`, an affine open `V₀` on which the
ideal of `i` is generated by a Koszul-regular sequence `f₁, …, f_r`, and a quasi-coherent `M`,
`ℰxt^r_Y(i_* 𝒪_X, M)|_{V₀} ≅ (i_* i^* M)|_{V₀}`, through the Koszul resolution. -/
noncomputable def localTopExtIso (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, V₀) Γ(Y, V₀))) :
    (Ringed.moduleRestrict V₀).obj ((Ringed.sheafExt (R := Y.sheaf)
      ((Scheme.Modules.pushforward i).obj (SheafOfModules.unit X.ringCatSheaf)) (s + 1)).obj M) ≅
      pullbackRestrict i M V₀ :=
  have := quasiIso_koszulAugmentation hV₀ i f hI hf
  Ringed.sheafExtRestrictIso V₀ _ M (s + 1) ≪≫
    (Ringed.sheafExtIsoHomologyOfLocallyFreeResolution _
      (augmentation (restrictPhi V₀) f (augHom i f) (d_comp_augHom hV₀ i f hI))
      (isFiniteLocallyFree_complex (restrictPhi V₀) f) (s + 1)).app _ ≪≫
    topHomologyIso hV₀ i f M hI

/-- The local top-Ext isomorphism as a composite. -/
lemma localTopExtIso_hom (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, V₀) Γ(Y, V₀))) :
    have := quasiIso_koszulAugmentation hV₀ i f hI hf
    (localTopExtIso hV₀ i f M hI hf).hom = (Ringed.sheafExtRestrictIso V₀ _ M (s + 1)).hom ≫
      (Ringed.sheafExtIsoHomologyOfLocallyFreeResolution _
        (augmentation (restrictPhi V₀) f (augHom i f) (d_comp_augHom hV₀ i f hI))
        (isFiniteLocallyFree_complex (restrictPhi V₀) f) (s + 1)).hom.app _ ≫
      (topHomologyIso hV₀ i f M hI).hom :=
  rfl

/-- **The determinant transition law** (Hartshorne III.7, proof of Theorem 7.11). Replacing the
generators `f` by `f Q` for an invertible matrix `Q` multiplies the local top-Ext isomorphism
`ℰxt^r_Y(i_* 𝒪_X, M)|_{V₀} ≅ (i_* i^* M)|_{V₀}` by `det Q`. -/
theorem localTopExtIso_changeOfBasis (Q : Matrix (Fin (s + 1)) (Fin (s + 1)) Γ(Y, V₀))
    (hf : IsKoszulRegular f (ModuleCat.of Γ(Y, V₀) Γ(Y, V₀)))
    (hI' : i.ker.ideal ⟨V₀, hV₀⟩ = Ideal.span (Set.range (Matrix.vecMul f Q)))
    (hf' : IsKoszulRegular (Matrix.vecMul f Q) (ModuleCat.of Γ(Y, V₀) Γ(Y, V₀))) :
    (localTopExtIso hV₀ i (Matrix.vecMul f Q) M hI' hf').hom =
      (localTopExtIso hV₀ i f M hI hf).hom ≫
        scalarHom (restrictPhi V₀ Q.det) (pullbackRestrict i M V₀) := by
  have := quasiIso_koszulAugmentation hV₀ i f hI hf
  have := quasiIso_koszulAugmentation hV₀ i _ hI' hf'
  have h := Ringed.sheafExtIsoHomologyOfLocallyFreeResolution_comp_homologyMap
    (augmentation (restrictPhi V₀) (Matrix.vecMul f Q) (augHom i (Matrix.vecMul f Q))
      (d_comp_augHom hV₀ i _ hI'))
    (augmentation (restrictPhi V₀) f (augHom i f) (d_comp_augHom hV₀ i f hI))
    (isFiniteLocallyFree_complex (restrictPhi V₀) _)
    (isFiniteLocallyFree_complex (restrictPhi V₀) f)
    (complexMap (restrictPhi V₀) (sequenceKoszulChangeOfBasis f Q (ModuleCat.of _ _)))
    (complexMap_comp_augmentation hV₀ i f hI Q hI') (s + 1) ((Ringed.moduleRestrict V₀).obj M)
  have h2 : (Functor.whiskerRight (Ringed.moduleSheafHomComplexMap (complexMap (restrictPhi V₀)
        (sequenceKoszulChangeOfBasis f Q (ModuleCat.of _ _))))
          (HomologicalComplex.homologyFunctor _ (ComplexShape.up ℕ) (s + 1))).app
            ((Ringed.moduleRestrict V₀).obj M) =
      HomologicalComplex.homologyMap ((Ringed.moduleSheafHomComplexMap (complexMap (restrictPhi V₀)
        (sequenceKoszulChangeOfBasis f Q (ModuleCat.of _ _)))).app
          ((Ringed.moduleRestrict V₀).obj M)) (s + 1) := rfl
  rw [localTopExtIso_hom, localTopExtIso_hom, ← h, h2, Category.assoc, Category.assoc,
    homologyMap_comp_topHomologyIso_hom hV₀ i f M hI Q hI']
  simp only [Category.assoc]

