import Hartshorne.Cohomology.KoszulRegularImmersion
import Hartshorne.Scheme.Differentials.NormalConormalSheaves
import Hartshorne.Scheme.PullbackQuasicoherent
import Hartshorne.Scheme.CoherentFreeLocus

/-!
# The conormal sheaf of a Koszul-regular immersion

Let `i : X ⟶ Y` be a Koszul-regular closed immersion of codimension `r` with ideal sheaf `I`.
On an affine open `U = Spec A` of `Y` on which `I(U)` is generated by a Koszul-regular sequence
`f₁, …, f_r`, put `B = Γ(X, i⁻¹ U) = A / I(U)`. The conormal sheaf `i^* I` is associated on
`i⁻¹ U` to `B ⊗_A I(U)`, which is free over `B` on `1 ⊗ f₁, …, 1 ⊗ f_r`. Hence the conormal sheaf
is locally free of rank `r`
(`Hartshorne.IsKoszulRegularImmersion.isLocallyFreeOfRank_pullback_idealSheaf`), with local
frame `i^* f₁, …, i^* f_r` on `i⁻¹ U` (`Hartshorne.KoszulConormal.pullbackIdealFrame`,
`Hartshorne.KoszulConormal.pullbackIdealFrame_freeSection_eq_unit`).
-/

universe u

open CategoryTheory Limits Opposite AlgebraicGeometry

open scoped TensorProduct

namespace Hartshorne

namespace KoszulConormal

variable {X Y : Scheme.{u}} (i : X ⟶ Y)

/-- A section of `𝒪_Y` killed by `i^♯` is a section of the ideal sheaf `I = ker (𝒪_Y ⟶ i_* 𝒪_X)`:
the sections functor preserves kernels. -/
theorem exists_closedImmersionIdealSheafι_app_eq {W : Y.Opens} (a : Γ(Y, W))
    (ha : i.app W a = 0) :
    ∃ s : Γ(closedImmersionIdealSheaf i, W), (closedImmersionIdealSheafι i).app W s = a := by
  have : (SheafOfModules.evaluation Y.ringCatSheaf (op W)).Additive := ⟨rfl⟩
  have hS := (ShortComplex.exact_kernel
    (structureSheafToPushforward i)).map_of_mono_of_preservesKernel
    (SheafOfModules.evaluation Y.ringCatSheaf (op W))
    (inferInstanceAs (Mono (closedImmersionIdealSheafι i))) inferInstance
  rw [ShortComplex.moduleCat_exact_iff] at hS
  exact hS a ha

variable (U : Y.affineOpens)

/-- The image of `Spec Γ(Y, U) ⟶ Y` is `U`. -/
theorem image_fromSpec_top :
    (haveI := U.2.isOpenImmersion_fromSpec; U.2.fromSpec ''ᵁ ⊤) = (U : Y.Opens) := by
  rw [Scheme.Hom.image_top_eq_opensRange, U.2.opensRange_fromSpec]

/-- The inclusion `I(U) → Γ(Y, U)` of the sections of the ideal sheaf over an affine open `U`. -/
noncomputable def idealSectionsToSections :
    idealSectionsModule i U →ₗ[Γ(Y, (U : Y.Opens))] Γ(Y, (U : Y.Opens)) where
  toFun y := Y.presheaf.map (homOfLE (image_fromSpec_top U).ge).op
    ((closedImmersionIdealSheafι i).app _ (show Γ(closedImmersionIdealSheaf i, _) from y))
  map_add' y y' := by
    erw [map_add, map_add]
  map_smul' k y := by
    have : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
    rw [idealSectionsModule_smul i U k y (image_fromSpec_top U).le]
    erw [Scheme.Modules.Hom.app_smul]
    change Y.presheaf.map (homOfLE (image_fromSpec_top U).ge).op
      (Y.presheaf.map (homOfLE (image_fromSpec_top U).le).op k * _) = k * _
    erw [map_mul]
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp,
      show homOfLE (image_fromSpec_top U).ge ≫ homOfLE (image_fromSpec_top U).le = 𝟙 _ from
        Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply]

theorem idealSectionsToSections_injective :
    Function.Injective (idealSectionsToSections i U) := by
  intro y y' h
  have : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  have hinj : Function.Injective (Y.presheaf.map (homOfLE (image_fromSpec_top U).ge).op) := by
    intro a b hab
    have := congrArg (Y.presheaf.map (homOfLE (image_fromSpec_top U).le).op) hab
    rwa [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
      ← op_comp,
      show homOfLE (image_fromSpec_top U).le ≫ homOfLE (image_fromSpec_top U).ge = 𝟙 _ from
        Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply,
      ConcreteCategory.id_apply] at this
  exact modules_app_injective (closedImmersionIdealSheafι i) _ (hinj h)

theorem range_idealSectionsToSections [QuasiCompact i] :
    LinearMap.range (idealSectionsToSections i U) = i.ker.ideal U := by
  have : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  rw [Scheme.Hom.ker_apply]
  set T := U.2.fromSpec ''ᵁ ⊤
  have hker : ∀ s : Γ(closedImmersionIdealSheaf i, T),
      i.app T ((closedImmersionIdealSheafι i).app T s) = 0 := fun s =>
    congrArg (fun φ => Scheme.Modules.Hom.app φ T s)
      (kernel.condition (structureSheafToPushforward i))
  ext a
  constructor
  · rintro ⟨y, rfl⟩
    change i.app U (Y.presheaf.map (homOfLE (image_fromSpec_top U).ge).op
      ((closedImmersionIdealSheafι i).app T y)) = 0
    erw [← ConcreteCategory.comp_apply, Scheme.Hom.naturality, ConcreteCategory.comp_apply, hker,
      map_zero]
  · intro ha
    have ha' : i.app T (Y.presheaf.map (homOfLE (image_fromSpec_top U).le).op a) = 0 := by
      erw [← ConcreteCategory.comp_apply, Scheme.Hom.naturality, ConcreteCategory.comp_apply]
      change X.presheaf.map _ (i.app U a) = 0
      rw [show i.app U a = 0 from ha, map_zero]
    obtain ⟨s, hs⟩ := exists_closedImmersionIdealSheafι_app_eq i _ ha'
    refine ⟨s, ?_⟩
    change Y.presheaf.map (homOfLE (image_fromSpec_top U).ge).op
      ((closedImmersionIdealSheafι i).app T s) = a
    rw [hs, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp,
      show homOfLE (image_fromSpec_top U).ge ≫ homOfLE (image_fromSpec_top U).le = 𝟙 _ from
        Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply]

/-- The sections `I(U)` of the ideal sheaf over an affine open `U`, as the ideal
`ker (Γ(Y, U) → Γ(X, i⁻¹ U))`. -/
noncomputable def idealSectionsEquiv [QuasiCompact i] :
    idealSectionsModule i U ≃ₗ[Γ(Y, (U : Y.Opens))] i.ker.ideal U :=
  LinearEquiv.ofInjective _ (idealSectionsToSections_injective i U) ≪≫ₗ
    LinearEquiv.ofEq _ _ (range_idealSectionsToSections i U)

theorem idealSectionsEquiv_apply [QuasiCompact i] (y : idealSectionsModule i U) :
    (idealSectionsEquiv i U y : Γ(Y, (U : Y.Opens))) = idealSectionsToSections i U y :=
  rfl

section Frame

variable [IsClosedImmersion i] {r : ℕ} {f : Fin r → Γ(Y, (U : Y.Opens))}
  (hI : i.ker.ideal U = Ideal.span (Set.range f))
  (hf : Koszul.IsKoszulRegular f (ModuleCat.of Γ(Y, (U : Y.Opens)) Γ(Y, (U : Y.Opens))))

/-- The ring `Γ(X, i⁻¹ U)` of sections over the preimage of `U`. -/
noncomputable abbrev preimageSections : CommRingCat.{u} :=
  Γ(X, (closedImmersionAffinePreimage i U : X.Opens))

/-- The ring map `Γ(Y, U) → Γ(X, i⁻¹ U)`. -/
noncomputable abbrev sectionsMap : Γ(Y, (U : Y.Opens)) ⟶ preimageSections i U :=
  i.appLE U (closedImmersionAffinePreimage i U) le_rfl

include hI in
theorem span_le_ker_sectionsMap :
    Ideal.span (Set.range f) ≤ RingHom.ker (sectionsMap i U).hom := by
  rw [← hI, Scheme.Hom.ker_apply, sectionsMap, ← Scheme.Hom.app_eq_appLE]

/-- For generators `f₁, …, f_r` of `I(U)` forming a Koszul-regular sequence, the
`Γ(X, i⁻¹ U)`-module `Γ(X, i⁻¹ U) ⊗_{Γ(Y, U)} I(U)` is free on `1 ⊗ f₁, …, 1 ⊗ f_r`. -/
noncomputable def extendScalarsIdealSectionsEquiv :
    letI := (sectionsMap i U).hom.toAlgebra
    (ModuleCat.extendScalars (sectionsMap i U).hom).obj (idealSectionsModule i U)
      ≃ₗ[preimageSections i U] (Fin r → preimageSections i U) :=
  letI := (sectionsMap i U).hom.toAlgebra
  (LinearEquiv.refl _ _ : (ModuleCat.extendScalars (sectionsMap i U).hom).obj
      (idealSectionsModule i U) ≃ₗ[preimageSections i U]
      preimageSections i U ⊗[Γ(Y, (U : Y.Opens))] idealSectionsModule i U) ≪≫ₗ
    LinearEquiv.baseChange _ _ _ _ (idealSectionsEquiv i U ≪≫ₗ LinearEquiv.ofEq _ _ hI) ≪≫ₗ
    Koszul.baseChangeIdealEquiv f hf (span_le_ker_sectionsMap i U hI)

/-- The element of `I(U)` corresponding to the generator `fⱼ`. -/
noncomputable def generatorSection (j : Fin r) : idealSectionsModule i U :=
  (idealSectionsEquiv i U).symm ⟨f j, hI ▸ Ideal.subset_span ⟨j, rfl⟩⟩

theorem idealSectionsToSections_generatorSection (j : Fin r) :
    idealSectionsToSections i U (generatorSection i U hI j) = f j := by
  rw [← idealSectionsEquiv_apply, generatorSection, LinearEquiv.apply_symm_apply]

/-- The basis `1 ⊗ f₁, …, 1 ⊗ f_r` of `Γ(X, i⁻¹ U) ⊗_{Γ(Y, U)} I(U)`. -/
noncomputable def extendScalarsIdealSectionsBasis :
    Module.Basis (Fin r) (preimageSections i U)
      ((ModuleCat.extendScalars (sectionsMap i U).hom).obj (idealSectionsModule i U)) :=
  Module.Basis.ofEquivFun (extendScalarsIdealSectionsEquiv i U hI hf)

theorem extendScalarsIdealSectionsBasis_apply (j : Fin r) :
    extendScalarsIdealSectionsBasis i U hI hf j =
      ((1 : preimageSections i U) ⊗ₜ[Γ(Y, (U : Y.Opens))] generatorSection i U hI j :
        (ModuleCat.extendScalars (sectionsMap i U).hom).obj (idealSectionsModule i U)) := by
  rw [extendScalarsIdealSectionsBasis, Module.Basis.coe_ofEquivFun]
  change (extendScalarsIdealSectionsEquiv i U hI hf).symm (Pi.single j 1) = _
  refine ((extendScalarsIdealSectionsEquiv i U hI hf).symm_apply_eq).mpr ?_
  let := (sectionsMap i U).hom.toAlgebra
  have h1 : (idealSectionsEquiv i U ≪≫ₗ LinearEquiv.ofEq _ _ hI) (generatorSection i U hI j) =
      ⟨f j, Ideal.subset_span ⟨j, rfl⟩⟩ := by
    apply Subtype.ext
    simp [generatorSection]
  change _ = Koszul.baseChangeIdealEquiv f hf (span_le_ker_sectionsMap i U hI)
    (LinearEquiv.baseChange _ _ _ _ (idealSectionsEquiv i U ≪≫ₗ LinearEquiv.ofEq _ _ hI)
      ((1 : preimageSections i U) ⊗ₜ[Γ(Y, (U : Y.Opens))] generatorSection i U hI j))
  rw [LinearEquiv.baseChange_tmul, h1]
  change _ = LinearMap.liftBaseChange _ (Koszul.idealCoordB f hf _) _
  rw [LinearMap.liftBaseChange_tmul, one_smul, Koszul.idealCoordB_generator]

/-- The isomorphism `Γ(X, i⁻¹ U) ⊗_{Γ(Y, U)} I(U)~ ≅ (i^* I)|_{Spec Γ(X, i⁻¹ U)}`. -/
noncomputable abbrev pullbackIdealTildeIso :=
  PullbackQuasicoherent.specRestrictionPullbackIso i (closedImmersionIdealSheaf i) U
    (closedImmersionAffinePreimage i U) le_rfl (idealSectionsModule i U) (idealSectionsTildeIso i U)

/-- **Local frame of the conormal sheaf.** The morphism `𝒪^r ⟶ (i^* I)|_{Spec Γ(X, i⁻¹ U)}`
sending the `j`-th basis section to the section `1 ⊗ fⱼ`, i.e. to the pullback of the generator
`fⱼ` of `I(U)` (`pullbackIdealFrame_freeSection`). It is an isomorphism. -/
noncomputable def pullbackIdealFrame :
    SheafOfModules.free (ULift.{u} (Fin r)) ⟶
      specRestriction ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i))
        (closedImmersionAffinePreimage i U) :=
  (SheafOfModules.freeHomEquiv _).symm
      (fun j => Scheme.Modules.tildeSection ((extendScalarsIdealSectionsBasis i U hI hf).reindex
        Equiv.ulift.symm j)) ≫
    (pullbackIdealTildeIso i U).hom

instance isIso_pullbackIdealFrame : IsIso (pullbackIdealFrame i U hI hf) := by
  have := Scheme.Modules.isIso_freeHomEquiv_symm_tildeSection
    ((extendScalarsIdealSectionsBasis i U hI hf).reindex Equiv.ulift.symm)
  exact IsIso.comp_isIso' this (Iso.isIso_hom (pullbackIdealTildeIso i U))

theorem pullbackIdealFrame_freeSection (j : Fin r) :
    ((SheafOfModules.sectionsMap (pullbackIdealFrame i U hI hf)
      (SheafOfModules.freeSection (ULift.up j))).val (op ⊤)) =
      (pullbackIdealTildeIso i U).hom.app ⊤ ((tilde.toOpen _ ⊤).hom
        ((1 : preimageSections i U) ⊗ₜ[Γ(Y, (U : Y.Opens))] generatorSection i U hI j :
          (ModuleCat.extendScalars (sectionsMap i U).hom).obj (idealSectionsModule i U))) := by
  rw [pullbackIdealFrame]
  erw [SheafOfModules.freeHomEquiv_symm_comp,
    SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection]
  rw [Module.Basis.reindex_apply,
    Equiv.symm_symm, Equiv.ulift_apply, extendScalarsIdealSectionsBasis_apply]
  rfl

set_option maxRecDepth 10000 in
/-- **The local frame of the conormal sheaf is given by the generators.** The `j`-th section of
the frame `pullbackIdealFrame` is the pullback `i^* fⱼ` of the generator `fⱼ ∈ I(U)`, i.e. the
image of `fⱼ` under the unit `I ⟶ i_* i^* I`, restricted to `i⁻¹ U`. -/
theorem pullbackIdealFrame_freeSection_eq_unit (j : Fin r)
    (hT : haveI := U.2.isOpenImmersion_fromSpec
      haveI := (closedImmersionAffinePreimage i U).2.isOpenImmersion_fromSpec
      (closedImmersionAffinePreimage i U).2.fromSpec ''ᵁ ⊤ ≤ i ⁻¹ᵁ (U.2.fromSpec ''ᵁ ⊤)) :
    haveI := U.2.isOpenImmersion_fromSpec
    ((SheafOfModules.sectionsMap (pullbackIdealFrame i U hI hf)
      (SheafOfModules.freeSection (ULift.up j))).val (op ⊤)) =
      ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i)).presheaf.map (homOfLE hT).op
        (((Scheme.Modules.pullbackPushforwardAdjunction i).unit.app
          (closedImmersionIdealSheaf i)).app (U.2.fromSpec ''ᵁ ⊤)
          (show Γ(closedImmersionIdealSheaf i, U.2.fromSpec ''ᵁ ⊤) from
            generatorSection i U hI j)) := by
  have : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  rw [pullbackIdealFrame_freeSection]
  have h := closedImmersion_unit_toOpen i U (generatorSection i U hI j) hT
  refine (congrArg (fun x => (pullbackIdealTildeIso i U).hom.app ⊤ x) h.symm).trans ?_
  exact ConcreteCategory.congr_hom
    (congrArg (fun φ => Scheme.Modules.Hom.app φ ⊤) (pullbackIdealTildeIso i U).inv_hom_id) _

/-- **Local frame of the conormal sheaf.** On the affine open `i⁻¹ U = Spec B`, the pullback
`i^* I` of the ideal sheaf is free of rank `r`, with frame given by the generators
`f₁, …, f_r` of `I(U)` (the inverse of `pullbackIdealFrame`). -/
noncomputable def specRestrictionPullbackIdealIso :
    specRestriction ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i))
        (closedImmersionAffinePreimage i U) ≅ SheafOfModules.free (ULift.{u} (Fin r)) :=
  (asIso (pullbackIdealFrame i U hI hf)).symm

/-- The conormal sheaf `i^* I` restricted to the affine open `i⁻¹ U` is free of rank `r`. -/
noncomputable def restrictPullbackIdealIso :
    ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i)).restrict
        (closedImmersionAffinePreimage i U : X.Opens).ι ≅
      SheafOfModules.free (ULift.{u} (Fin r)) :=
  let V := closedImmersionAffinePreimage i U
  haveI : IsOpenImmersion V.2.fromSpec := V.2.isOpenImmersion_fromSpec
  (Scheme.Modules.restrictFunctorCongr (f := V.2.isoSpec.hom ≫ V.2.fromSpec)
      (g := (V : X.Opens).ι) V.2.isoSpec_hom_fromSpec).symm.app _ ≪≫
    (Scheme.Modules.restrictFunctorComp V.2.isoSpec.hom V.2.fromSpec).app _ ≪≫
    (Scheme.Modules.restrictFunctor V.2.isoSpec.hom).mapIso
      (specRestrictionPullbackIdealIso i U hI hf) ≪≫
    Scheme.Modules.restrictFreeIso _ _

end Frame

end KoszulConormal

open KoszulConormal

variable {X Y : Scheme.{u}} {i : X ⟶ Y} {r : ℕ}

/-- **The conormal sheaf of a Koszul-regular immersion is locally free.** For a Koszul-regular
closed immersion `i : X ⟶ Y` of codimension `r` with ideal sheaf `I`, the pullback `i^* I` is
locally free of rank `r`. -/
theorem IsKoszulRegularImmersion.isLocallyFreeOfRank_pullback_idealSheaf
    (h : IsKoszulRegularImmersion i r) :
    ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i)).IsLocallyFreeOfRank r := by
  have := h.isClosedImmersion
  intro x
  obtain ⟨U, hxU, f, hI, hf⟩ := h.exists_isKoszulRegular (i.base x)
  exact ⟨closedImmersionAffinePreimage i U, hxU, ⟨restrictPullbackIdealIso i U hI hf⟩⟩

/-- **The conormal sheaf of a Koszul-regular immersion is locally free.** For a Koszul-regular
closed immersion `i : X ⟶ Y` of codimension `r`, the conormal sheaf `N^*_{X/Y}` (whose
pushforward is `I/I²`) is locally free of rank `r`. -/
theorem IsKoszulRegularImmersion.isLocallyFreeOfRank_immersionConormalSheaf
    (h : IsKoszulRegularImmersion i r) :
    haveI := h.isClosedImmersion
    (immersionConormalSheaf i).IsLocallyFreeOfRank r := by
  have := h.isClosedImmersion
  intro x
  obtain ⟨U, hxU, ⟨e⟩⟩ := h.isLocallyFreeOfRank_pullback_idealSheaf x
  exact ⟨U, hxU, ⟨(Scheme.Modules.restrictFunctor U.ι).mapIso (immersionConormalSheafIso i) ≪≫ e⟩⟩

end Hartshorne
