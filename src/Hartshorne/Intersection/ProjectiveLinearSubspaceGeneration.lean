import Hartshorne.Intersection.AffineChowVanishing
import Hartshorne.Intersection.ProjectiveHyperplaneChart

/-!
# Chow groups of projective space are generated by linear subspaces

Fulton, *Intersection Theory*, §1.9, for rational equivalence defined through divisors on
normalizations (Hartshorne, Appendix A.1).

Let `k` be an infinite field and `L_m = V(x_{m+1}, …, x_n) ⊆ ℙⁿ_k`. Every codimension-`(n - m)`
cycle on `ℙⁿ_k` is rationally equivalent to an integer multiple of `[L_m]`
(`mem_sup_zmultiples_linearSubspace`); in particular so is every integral subvariety of dimension
`m` (`exists_rationallyEquivalent_zsmul_linearSubspace`).

The proof is by induction on `n`. For `m = n` the only point of codimension zero is the generic
point `L_n`. For `m < n`, let `H = V(x_n) ≅ ℙ^{n-1}_k` (`hyperplaneEmbedding`), which contains
`L_m`, with complement `D₊(x_n) ≅ 𝔸ⁿ_k` (`hyperplaneComplementIso`). A cycle restricts to a cycle
of positive codimension on `𝔸ⁿ_k`, which is rationally equivalent to zero
(`mem_rationalEquivalenceSubgroup_of_isIso_spec_mvPolynomial`); by the localization sequence it
is then rationally equivalent to the pushforward of a cycle on `H`, to which the induction
hypothesis applies (`mem_sup_zmultiples_of_isClosedImmersion`).
-/

noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial Order TopologicalSpace

namespace Hartshorne

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

section General

variable {k : Type u} [Field k]

/-- **The inductive step.** Let `X` be a variety over `k` of dimension `n`, `ι : Y ⟶ X` a closed
immersion over `k` of a variety `Y` of dimension `n'`, and `U` a nonempty open containing every
point outside `ι(Y)`. Suppose every codimension-`(s + n - n')` cycle on `U` is rationally
equivalent to zero, and every codimension-`s` cycle on `Y` is rationally equivalent to a multiple
of a cycle `L_Y`. Then every codimension-`(s + n - n')` cycle on `X` is rationally equivalent to a
multiple of `ι_* L_Y`. -/
theorem mem_sup_zmultiples_of_isClosedImmersion {X Y : Scheme.{u}} (p : X ⟶ Spec (.of k))
    [IsIntegral X] (hp : FiniteType p) [IsSeparated p] {n : ℕ} (hn : topologicalKrullDim X = n)
    [IsIntegral Y] (ι : Y ⟶ X) [IsClosedImmersion ι] {n' : ℕ} (hn' : topologicalKrullDim Y = n')
    (U : X.Opens) [IsIntegral (U : Scheme)] (hU : ∀ x, x ∉ U → x ∈ Set.range ι) {s : ℕ}
    (hUvan : ∀ c : codimensionCycles U (s + n - n'), c ∈ rationalEquivalenceSubgroup (U.ι ≫ p)
      (finiteType_opens_ι_comp p hp U) (topologicalKrullDim_opens_eq p hp hn U) (s + n - n'))
    (LY : codimensionCycles Y s) (LX : codimensionCycles X (s + n - n'))
    (hL : rawCyclePushforward (ι ≫ p) p (finiteType_comp_of_isClosedImmersion p hp ι) hp ι rfl
      hn' hn s LY = LX)
    (hY : ∀ c : codimensionCycles Y s, c ∈ rationalEquivalenceSubgroup (ι ≫ p)
      (finiteType_comp_of_isClosedImmersion p hp ι) hn' s ⊔ AddSubgroup.zmultiples LY)
    (c : codimensionCycles X (s + n - n')) :
    c ∈ rationalEquivalenceSubgroup p hp hn (s + n - n') ⊔ AddSubgroup.zmultiples LX := by
  have hres := hUvan (codimensionCyclesRestrict U (s + n - n') c)
  obtain ⟨β, hβ, hcβ⟩ := exists_sub_mem_rationalEquivalenceSubgroup_of_restrict p hp hn U c
    ((QuotientAddGroup.eq_zero_iff _).mpr hres)
  obtain ⟨γ, hγ⟩ := exists_rawCyclePushforward_eq_of_restrict_eq_zero p hp hn ι hn' U hU s
    (c - β) hcβ
  obtain ⟨y, hy, z, hz, rfl⟩ := AddSubgroup.mem_sup.mp (hY γ)
  obtain ⟨a, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hz
  have hιy := map_rationalEquivalenceSubgroup_le_of_isClosedImmersion p hp hn ι hn' s
    (AddSubgroup.mem_map_of_mem _ hy)
  rw [map_add, map_zsmul, hL] at hγ
  have hc : c = (β + rawCyclePushforward (ι ≫ p) p (finiteType_comp_of_isClosedImmersion p hp ι)
      hp ι rfl hn' hn s y) + a • LX := by
    rw [add_assoc, hγ]
    abel
  rw [hc]
  exact add_mem (AddSubgroup.mem_sup_left (add_mem hβ hιy))
    (AddSubgroup.mem_sup_right (AddSubgroup.zsmul_mem_zmultiples LX a))

/-- Rational equivalence for equal structure morphisms. -/
theorem rationalEquivalenceSubgroup_eq_of_eq {X : Scheme.{u}} {p p' : X ⟶ Spec (.of k)}
    (h : p = p') [IsIntegral X] {hp : FiniteType p} {hp' : FiniteType p'} [IsSeparated p]
    [IsSeparated p'] {n : ℕ} {hn : topologicalKrullDim X = n} {r : ℕ} :
    rationalEquivalenceSubgroup p hp hn r = rationalEquivalenceSubgroup p' hp' hn r := by
  subst h
  rfl

end General

section ProjectiveSpace

variable {k : Type u} [Field k]

/-- The cycle `[L_m]` of the linear subspace `L_m ⊆ ℙⁿ_k`, in codimension `r = n - m`. -/
def linearSubspaceCycle (n m : ℕ) {r : ℕ} (h : n - m = r) (hm : m ≤ n) :
    codimensionCycles (Proj (homogeneousSubmodule (Fin (n + 1)) k)) r :=
  pointCodimensionCycle (linearSubspacePoint (k := k) (n := n) m)
    ((codim_closure_linearSubspacePoint hm).trans (by rw [h]))

/-- The statement is insensitive to how the codimension index is written. -/
theorem forall_mem_sup_zmultiples_linearSubspaceCycle_congr {n m r r' : ℕ} (h : n - m = r)
    (h' : n - m = r') (hm : m ≤ n)
    (H : ∀ c : codimensionCycles (Proj (homogeneousSubmodule (Fin (n + 1)) k)) r,
      c ∈ rationalEquivalenceSubgroup projectiveSpaceStructureMorphism
        finiteType_projectiveSpaceStructureMorphism topologicalKrullDim_projectiveSpace r ⊔
        AddSubgroup.zmultiples (linearSubspaceCycle (k := k) n m h hm))
    (c : codimensionCycles (Proj (homogeneousSubmodule (Fin (n + 1)) k)) r') :
    c ∈ rationalEquivalenceSubgroup projectiveSpaceStructureMorphism
      finiteType_projectiveSpaceStructureMorphism topologicalKrullDim_projectiveSpace r' ⊔
      AddSubgroup.zmultiples (linearSubspaceCycle (k := k) n m h' hm) := by
  obtain rfl : r = r' := h.symm.trans h'
  exact H c

/-- In codimension zero every cycle on `ℙⁿ_k` is a multiple of `[L_n] = [ℙⁿ_k]`. -/
theorem mem_sup_zmultiples_linearSubspaceCycle_self (n : ℕ)
    (c : codimensionCycles (Proj (homogeneousSubmodule (Fin (n + 1)) k)) (n - n)) :
    c ∈ rationalEquivalenceSubgroup projectiveSpaceStructureMorphism
      finiteType_projectiveSpaceStructureMorphism topologicalKrullDim_projectiveSpace (n - n) ⊔
      AddSubgroup.zmultiples (linearSubspaceCycle (k := k) n n rfl le_rfl) := by
  refine mem_of_forall_pointCodimensionCycle_mem _ (fun x hx => ?_) c
  have hx0 : codim (closure ({x} : Set (Proj (homogeneousSubmodule (Fin (n + 1)) k)))) = 0 := by
    rw [hx, Nat.sub_self, Nat.cast_zero]
  obtain rfl := eq_linearSubspacePoint_of_codim_eq_zero hx0
  exact AddSubgroup.mem_sup_right (AddSubgroup.mem_zmultiples _)

/-- **Chow groups of projective space are generated by linear subspaces** (Fulton, §1.9). For
`k` infinite and `m ≤ n`, every codimension-`(n - m)` cycle on `ℙⁿ_k` is rationally equivalent
to an integer multiple of `[L_m]`, `L_m = V(x_{m+1}, …, x_n)`. -/
theorem mem_sup_zmultiples_linearSubspace [Infinite k] (n : ℕ) : ∀ (m : ℕ) (hm : m ≤ n)
    (c : codimensionCycles (Proj (homogeneousSubmodule (Fin (n + 1)) k)) (n - m)),
    c ∈ rationalEquivalenceSubgroup projectiveSpaceStructureMorphism
      finiteType_projectiveSpaceStructureMorphism topologicalKrullDim_projectiveSpace (n - m) ⊔
      AddSubgroup.zmultiples (linearSubspaceCycle (k := k) n m rfl hm) := by
  induction n with
  | zero =>
    intro m hm c
    obtain rfl : m = 0 := Nat.le_zero.mp hm
    exact mem_sup_zmultiples_linearSubspaceCycle_self 0 c
  | succ N ih =>
    intro m hm c
    rcases Nat.lt_or_eq_of_le hm with hlt | rfl
    · have hmN : m ≤ N := Nat.lt_succ_iff.mp hlt
      have hidx : N - m + (N + 1) - N = N + 1 - m := by omega
      refine forall_mem_sup_zmultiples_linearSubspaceCycle_congr (n := N + 1) (m := m) hidx.symm rfl
        hm (fun c' => ?_) c
      have hpN := hyperplaneEmbedding_comp_structureMorphism (k := k) N
      have hY : ∀ c : codimensionCycles (Proj (homogeneousSubmodule (Fin (N + 1)) k)) (N - m),
          c ∈ rationalEquivalenceSubgroup (hyperplaneEmbedding N ≫ projectiveSpaceStructureMorphism)
            (finiteType_comp_of_isClosedImmersion projectiveSpaceStructureMorphism
              finiteType_projectiveSpaceStructureMorphism (hyperplaneEmbedding N))
            topologicalKrullDim_projectiveSpace (N - m) ⊔
            AddSubgroup.zmultiples (linearSubspaceCycle (k := k) N m rfl hmN) := by
        intro c
        rw [rationalEquivalenceSubgroup_eq_of_eq hpN]
        exact ih m hmN c
      refine mem_sup_zmultiples_of_isClosedImmersion (s := N - m) (n := N + 1) (n' := N)
        projectiveSpaceStructureMorphism
        finiteType_projectiveSpaceStructureMorphism topologicalKrullDim_projectiveSpace
        (hyperplaneEmbedding N) topologicalKrullDim_projectiveSpace (hyperplaneComplement N)
        (mem_range_hyperplaneEmbedding_of_notMem N) (fun c => ?_)
        (linearSubspaceCycle (k := k) N m rfl hmN) (linearSubspaceCycle (k := k) (N + 1) m
          hidx.symm hm) ?_ hY c'
      · exact mem_rationalEquivalenceSubgroup_of_isIso_spec_mvPolynomial _ _ _
          (hyperplaneComplementIso N).hom (by omega) c
      · have hpt := hyperplaneEmbedding_linearSubspacePoint (k := k) N hmN
        have hcod : codim (closure
            ({hyperplaneEmbedding N (linearSubspacePoint (k := k) (n := N) m)}
              : Set (Proj (homogeneousSubmodule (Fin (N + 1 + 1)) k)))) =
            ((N - m + (N + 1) - N : ℕ) : ℕ∞) := by
          rw [hpt, codim_closure_linearSubspacePoint hm, hidx]
        apply Subtype.ext
        rw [linearSubspaceCycle, coe_rawCyclePushforward_pointCodimensionCycle _ _ _ _ _ _ _ hcod,
          linearSubspaceCycle]
        congr 1
        revert hcod
        rw [hpt]
        intro hcod
        rfl
    · exact mem_sup_zmultiples_linearSubspaceCycle_self (N + 1) c

/-- **Integral subvarieties of projective space are rationally equivalent to multiples of linear
subspaces** (Fulton, §1.9). Let `k` be infinite (for instance algebraically closed) and
`m ≤ n`. Every integral subvariety `Y = closure {y}` of `ℙⁿ_k` of dimension `m` (codimension
`n - m`) is rationally equivalent to `a · [L_m]` for some integer `a`, where
`L_m = V(x_{m+1}, …, x_n)`. -/
theorem exists_rationallyEquivalent_zsmul_linearSubspace [Infinite k] {n m : ℕ} (hm : m ≤ n)
    {y : Proj (homogeneousSubmodule (Fin (n + 1)) k)}
    (hy : codim (closure ({y} : Set (Proj (homogeneousSubmodule (Fin (n + 1)) k)))) =
      (n - m : ℕ)) :
    ∃ a : ℤ, RationallyEquivalent projectiveSpaceStructureMorphism
      finiteType_projectiveSpaceStructureMorphism topologicalKrullDim_projectiveSpace
      (pointCodimensionCycle y hy)
      (a • pointCodimensionCycle (linearSubspacePoint (k := k) (n := n) m)
        (codim_closure_linearSubspacePoint hm)) := by
  obtain ⟨u, hu, v, hv, huv⟩ :=
    AddSubgroup.mem_sup.mp (mem_sup_zmultiples_linearSubspace n m hm (pointCodimensionCycle y hy))
  obtain ⟨a, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hv
  refine ⟨a, ?_⟩
  have h : pointCodimensionCycle y hy - a • pointCodimensionCycle
      (linearSubspacePoint (k := k) (n := n) m) (codim_closure_linearSubspacePoint hm) = u := by
    rw [← huv]
    exact add_sub_cancel_right u _
  rw [RationallyEquivalent, h]
  exact hu

end ProjectiveSpace

end Hartshorne
