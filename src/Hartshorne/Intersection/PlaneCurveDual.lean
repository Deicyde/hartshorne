/-!
# The tangent morphism and the dual plane curve

Hartshorne, *Algebraic Geometry*, Exercise I.7.3 (p. 54).

Let `Y = Z(F) ⊆ ℙ²` be a projective plane curve, `F` irreducible and homogeneous.  A point `a`
of the dual plane `(ℙ²)*` stands for the line `a₀x₀ + a₁x₁ + a₂x₂ = 0`.  For every regular
(nonsingular) point `P` of `Y` there is a unique line `T_P(Y)` whose local intersection
multiplicity with `Y` at `P` exceeds one; `P ↦ T_P(Y)` is a morphism from the regular locus of
`Y` to `(ℙ²)*`, and the dual curve `Y*` is the closure of its image.

## Method

* **Jacobian criterion.**  On a chart `xᵢ ≠ 0` meeting `Y`, the vanishing ideal of the affine
  piece is generated by the dehomogenization `f` of `F` (since `J(Y) = (F)` and `F ∤ xᵢ`), and
  the piece has dimension one.  So `P` is nonsingular iff `∇f` does not vanish at `P`, and by
  Euler's formula iff `∇F(P) ≠ 0`.  This also shows the regular locus is open, and it is
  nonempty since `F` does not divide a nonzero partial derivative of smaller degree.
* **Tangent line.**  For a line `L` through `P` with second point `A`, the multiplicity
  `(L · Y)_P` is the order of vanishing at `0` of `t ↦ F(P + tA)`, which exceeds one iff
  `∇F(P) · A = 0`, i.e. (with `∇F(P) · P = 0` by Euler) iff `L` is the line `∇F(P)`.  A line not
  through `P` has multiplicity `0`; if `L ⊆ Y` then the linear form of `L` divides `F` and the
  multiplicity is at least two.
* **Morphism.**  A map given by homogeneous polynomials of one degree without common zero pulls
  back a ratio of homogeneous polynomials of equal degree to such a ratio, so it is a morphism;
  apply this to the partial derivatives of `F`.

## Main definitions and results

* `Hartshorne.planeCurveRegularLocus`, `Hartshorne.isQuasiProjVariety_planeCurveRegularLocus`
* `Hartshorne.nonsingularAt_planeCurve_iff`: the Jacobian criterion for a plane curve.
* `Hartshorne.planeCurveTangentLine`, `Hartshorne.planeDualCurve`
* `Hartshorne.planeCurve_tangentLine_morphism`: Exercise I.7.3.
-/

namespace Hartshorne
open MvPolynomial TopologicalSpace

noncomputable section
universe u
variable {k : Type u} [Field k]

section PlaneCurve

variable [IsAlgClosed k] {F : MvPolynomial (Fin 3) k} {d : ℕ}

omit [IsAlgClosed k] in
theorem pos_of_isHomogeneous_irreducible (hF : F.IsHomogeneous d) (hFirr : Irreducible F) :
    0 < d := by
  rcases Nat.eq_zero_or_pos d with rfl | h
  · exfalso
    have hdeg0 : F.totalDegree = 0 :=
      (totalDegree_zero_iff_isHomogeneous (p := F)).2 hF
    have hC : F = C (coeff 0 F) := (totalDegree_eq_zero_iff_eq_C (p := F)).1 hdeg0
    have hc : coeff 0 F ≠ 0 := by
      intro h0
      apply hFirr.ne_zero
      rw [hC, h0, map_zero]
    apply hFirr.not_isUnit
    rw [hC]
    exact (isUnit_iff_ne_zero.2 hc).map C
  · exact h

omit [IsAlgClosed k] in
theorem span_singleton_isPrime_of_irreducible (hFirr : Irreducible F) :
    (Ideal.span ({F} : Set (MvPolynomial (Fin 3) k))).IsPrime :=
  (Ideal.span_singleton_prime hFirr.ne_zero).2
    (UniqueFactorizationMonoid.irreducible_iff_prime.1 hFirr)

omit [IsAlgClosed k] in
theorem isHomogeneousIdeal_span_singleton (hF : F.IsHomogeneous d) :
    IsHomogeneousIdeal (Ideal.span ({F} : Set (MvPolynomial (Fin 3) k))) :=
  Ideal.homogeneous_span _ _ fun f hf => by
    rw [Set.mem_singleton_iff.1 hf]
    exact isHomogeneousElem_iff.2 ⟨d, hF⟩

/-- A projective plane curve is nonempty. -/
theorem projZeroSet_singleton_nonempty (hF : F.IsHomogeneous d) (hFirr : Irreducible F) :
    (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k))).Nonempty := by
  classical
  set a : Fin 3 → k := ![1, 0, 0]
  have ha : a ≠ 0 := fun h => one_ne_zero (congrFun h 0)
  by_cases hLY : projZeroSet {projectivePlaneLineForm a} ⊆ projZeroSet {F}
  · have hv : (![0, 1, 0] : Fin 3 → k) ≠ 0 := fun h => one_ne_zero (congrFun h 1)
    refine ⟨Projectivization.mk k _ hv, hLY ?_⟩
    rw [mem_projZeroSet_singleton_mk_iff (isHomogeneous_projectivePlaneLineForm a),
      eval_projectivePlaneLineForm]
    simp [a, Fin.sum_univ_three]
  · obtain ⟨-, hsum⟩ :=
      finite_and_finsum_projectivePlaneLocalIntersectionMultiplicity hF hFirr ha hLY
    by_contra hne
    rw [Set.not_nonempty_iff_eq_empty] at hne
    rw [hne, Set.inter_empty, finsum_mem_empty] at hsum
    have := pos_of_isHomogeneous_irreducible hF hFirr
    have h0 : (d : ℕ∞) = 0 := hsum.symm
    exact absurd (by exact_mod_cast h0) this.ne'

theorem homogeneousVanishingIdeal_planeCurve (hF : F.IsHomogeneous d)
    (hFirr : Irreducible F) :
    homogeneousVanishingIdeal (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k))) =
      Ideal.span {F} := by
  have h := homogeneousVanishingIdeal_projZeroSet (isHomogeneousIdeal_span_singleton hF)
    (by rw [projZeroSet_span]; exact projZeroSet_singleton_nonempty hF hFirr)
  rw [projZeroSet_span, (span_singleton_isPrime_of_irreducible hFirr).radical] at h
  exact h

/-- A projective plane curve `Z(F)`, with `F` irreducible and homogeneous, is a projective
variety. -/
theorem isProjVariety_planeCurve (hF : F.IsHomogeneous d) (hFirr : Irreducible F) :
    IsProjVariety (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k))) := by
  have hAlg : IsProjAlgebraicSet (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k))) :=
    ⟨{F}, fun f hf => ⟨d, by rw [Set.mem_singleton_iff.1 hf]; exact hF⟩, rfl⟩
  refine ⟨(isIrreducible_iff_isPrime_homogeneousVanishingIdeal hAlg).2 ?_,
    isClosed_iff_isProjAlgebraicSet.2 hAlg⟩
  rw [homogeneousVanishingIdeal_planeCurve hF hFirr]
  exact span_singleton_isPrime_of_irreducible hFirr

theorem projDim_planeCurve (hF : F.IsHomogeneous d) (hFirr : Irreducible F) :
    projDim (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k))) = 1 := by
  have := (projective_codimension_one_iff_hypersurface (n := 2)
    (isProjVariety_planeCurve hF hFirr) (by norm_num)).2
    ⟨F, d, pos_of_isHomogeneous_irreducible hF hFirr, hF, hFirr, rfl⟩
  simpa using this


/-- On the chart `xᵢ ≠ 0` meeting the curve, the vanishing ideal of the affine piece is
generated by the dehomogenized equation. -/
theorem vanishingIdeal_chartMap_image_planeCurve (hF : F.IsHomogeneous d)
    (hFirr : Irreducible F) (i : Fin 3)
    (hne : (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩ standardChart i).Nonempty) :
    vanishingIdeal k (chartMap i '' (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩
        standardChart i)) = Ideal.span {dehomogenize i F} := by
  apply le_antisymm
  · intro g hg
    have hG : dehomogenize i (homogenize i g) = g := dehomogenize_homogenize i g
    rw [← hG] at hg ⊢
    rw [dehomogenize_mem_vanishingIdeal_iff (homogenize_isHomogeneous i g),
      homogeneousVanishingIdeal_planeCurve hF hFirr, Ideal.mem_span_singleton] at hg
    rcases (UniqueFactorizationMonoid.irreducible_iff_prime.1 hFirr).dvd_or_dvd hg with h | h
    · exfalso
      obtain ⟨P, hPY, hPc⟩ := hne
      obtain ⟨H, hH⟩ := h
      have hFP : eval P.rep F = 0 := hPY F rfl
      have := congrArg (eval P.rep) hH
      rw [eval_X, map_mul, hFP, zero_mul] at this
      exact rep_ne_zero_of_mem_standardChart hPc this
    · obtain ⟨H, hH⟩ := h
      rw [hH, map_mul]
      exact Ideal.mem_span_singleton.2 (dvd_mul_right _ _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    show dehomogenize i F ∈ vanishingIdeal k _
    rw [dehomogenize_mem_vanishingIdeal_iff hF, homogeneousVanishingIdeal_planeCurve hF hFirr]
    exact Ideal.mem_span_singleton.2 (dvd_mul_left F (X i))

theorem dim_chartMap_image_planeCurve (hF : F.IsHomogeneous d) (hFirr : Irreducible F)
    (i : Fin 3)
    (hne : (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩ standardChart i).Nonempty) :
    dim (chartMap i '' (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩
        standardChart i)) = ((1 : ℕ) : WithBot ℕ∞) := by
  rw [← projDim_eq_dim_chart (isProjVariety_planeCurve hF hFirr) i hne,
    projDim_planeCurve hF hFirr]
  rfl

omit [IsAlgClosed k] in
theorem natCard_ne_fin_three (i : Fin 3) : Nat.card {j : Fin 3 // j ≠ i} = 2 := by
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype_compl, Fintype.card_fin,
    Fintype.card_subtype_eq]

omit [IsAlgClosed k] in
theorem rank_single_row {τ : Type*} [Fintype τ] (A : Matrix (Fin 1) τ k) :
    A.rank = 1 ↔ ∃ j, A 0 j ≠ 0 := by
  rw [Matrix.rank_eq_finrank_span_row]
  have hr : Set.range A.row = {A 0} := by
    ext x
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨r, rfl⟩
      rw [Subsingleton.elim r 0]
      rfl
    · rintro rfl
      exact ⟨0, rfl⟩
  rw [hr]
  by_cases h : A 0 = 0
  · rw [h, Submodule.span_singleton_eq_bot.2 rfl, finrank_bot]
    simp
  · rw [finrank_span_singleton h]
    simp only [true_iff]
    by_contra hc
    push Not at hc
    exact h (funext hc)

/-- The Jacobian criterion on an affine piece of a plane curve. -/
theorem isAffineNonsingularAt_chart_planeCurve_iff (hF : F.IsHomogeneous d)
    (hFirr : Irreducible F) (i : Fin 3)
    (hne : (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩ standardChart i).Nonempty)
    (p : chartMap i '' (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩
        standardChart i)) :
    IsAffineNonsingularAt _ p ↔
      ∃ j : {j : Fin 3 // j ≠ i}, eval (p : {j : Fin 3 // j ≠ i} → k)
        (pderiv j (dehomogenize i F)) ≠ 0 := by
  have hvi : Ideal.span (Set.range (fun _ : Fin 1 => dehomogenize i F)) =
      vanishingIdeal k (chartMap i '' (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩
        standardChart i)) := by
    rw [vanishingIdeal_chartMap_image_planeCurve hF hFirr i hne, Set.range_const]
  rw [isAffineNonsingularAt_iff_of_dim_eq p (dim_chartMap_image_planeCurve hF hFirr i hne),
    ← jacobianMatrix_rank_eq_jacobianRank p _ hvi, natCard_ne_fin_three]
  rw [show ∀ n : ℕ, n + 1 = 2 ↔ n = 1 from fun n => by omega, rank_single_row]
  simp [jacobianMatrix]

omit [IsAlgClosed k] in
theorem pderiv_dehomogenize_X (i : Fin 3) (j : {j : Fin 3 // j ≠ i}) (l : Fin 3) :
    pderiv j (dehomogenize (k := k) i (X l)) = dehomogenize i (pderiv j.1 (X l)) := by
  by_cases hl : l = i
  · subst hl
    rw [dehomogenize_X_self, pderiv_one, pderiv_X_of_ne (Ne.symm j.2), map_zero]
  · rw [dehomogenize_X_of_ne hl]
    by_cases hjl : j.1 = l
    · have : j = ⟨l, hl⟩ := Subtype.ext hjl
      subst this
      rw [pderiv_X_self, pderiv_X_self, map_one]
    · have hne : (⟨l, hl⟩ : {j : Fin 3 // j ≠ i}) ≠ j :=
        fun h => hjl (congrArg Subtype.val h).symm
      rw [pderiv_X_of_ne hne, pderiv_X_of_ne (Ne.symm hjl), map_zero]

omit [IsAlgClosed k] in
theorem pderiv_dehomogenize (i : Fin 3) (j : {j : Fin 3 // j ≠ i}) (G : MvPolynomial (Fin 3) k) :
    pderiv j (dehomogenize i G) = dehomogenize i (pderiv j.1 G) := by
  induction G using MvPolynomial.induction_on with
  | C a => simp [dehomogenize]
  | add p q hp hq => simp [hp, hq]
  | mul_X p l hp =>
    rw [map_mul, Derivation.leibniz, Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul,
      smul_eq_mul, smul_eq_mul, map_mul, map_mul, hp, pderiv_dehomogenize_X]

omit [IsAlgClosed k] in
/-- Euler's formula: at a zero of `F` normalized by `vᵢ = 1`, the partial in slot `i` is
determined by the others. -/
theorem exists_pderiv_ne_iff_of_eval_eq_zero (hF : F.IsHomogeneous d) (i : Fin 3)
    {v : Fin 3 → k} (hvi : v i = 1) (hFv : eval v F = 0) :
    (∃ j : {j : Fin 3 // j ≠ i}, eval v (pderiv j.1 F) ≠ 0) ↔ ∃ l, eval v (pderiv l F) ≠ 0 := by
  constructor
  · rintro ⟨j, hj⟩
    exact ⟨j.1, hj⟩
  · rintro ⟨l, hl⟩
    by_cases hli : l = i
    · subst hli
      by_contra hc
      push Not at hc
      have he := congrArg (eval v) hF.sum_X_mul_pderiv
      rw [map_nsmul, hFv, smul_zero, map_sum, Finset.sum_eq_single l] at he
      · rw [map_mul, eval_X, hvi, one_mul] at he
        exact hl he
      · intro m _ hm
        rw [map_mul, hc ⟨m, hm⟩, mul_zero]
      · intro h
        exact absurd (Finset.mem_univ l) h
    · exact ⟨⟨l, hli⟩, hl⟩

/-- **The Jacobian criterion for a projective plane curve.**  A point `P` of `Y = Z(F)` is
nonsingular exactly when some partial derivative of `F` does not vanish at `P`. -/
theorem nonsingularAt_planeCurve_iff (hF : F.IsHomogeneous d) (hFirr : Irreducible F)
    (P : projZeroSet ({F} : Set (MvPolynomial (Fin 3) k))) :
    (Variety.ofProjective (isProjVariety_planeCurve hF hFirr)).NonsingularAt P ↔
      ∃ l, eval P.1.rep (pderiv l F) ≠ 0 := by
  have hY := isProjVariety_planeCurve hF hFirr
  obtain ⟨i, hi⟩ := exists_mem_standardChart P.1
  have hne : (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩ standardChart i).Nonempty :=
    ⟨P.1, P.2, hi⟩
  let hYq := hY.isQuasiProjVariety
  let hYi := isQuasiProjVariety_inter_standardChart k i hYq hne
  let P' : (Variety.ofQuasiProjective hYq).carrier := P
  let Q : (Variety.ofQuasiProjective hYi).carrier := ⟨P.1, P.2, hi⟩
  let e₁ : Variety.LocalRingAt (Variety.ofQuasiProjective hYq) P'
      ≃+* Variety.LocalRingAt (Variety.ofQuasiProjective hYi) Q :=
    RingEquiv.ofBijective ((inclHom hYq hYi Set.inter_subset_left).localRingHom Q)
      (bijective_localRingHom_inclHom hYq hYi Set.inter_subset_left
        (isOpen_inter_standardChart_in k i) Q)
  have step1 : (Variety.ofQuasiProjective hYq).NonsingularAt P' ↔
      (Variety.ofQuasiProjective hYi).NonsingularAt Q :=
    isRegularLocalRing_iff_of_ringEquiv e₁
  have step2 := Variety.nonsingularAt_iff_of_isIso (isIso_chartHom k i hYq hne) Q
  have hYaff := isAffineVariety_chartMap_image i hY hne
  have step3 := nonsingularAt_affine_iff hYaff (chartHom k i hYq hne Q)
  refine step1.trans (step2.trans (step3.trans ?_))
  rw [isAffineNonsingularAt_chart_planeCurve_iff hF hFirr i hne]
  have hp : ((affinePoint hYaff.isQuasiAffineVariety (chartHom k i hYq hne Q) :
      chartMap i '' (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∩ standardChart i)) :
      {j : Fin 3 // j ≠ i} → k) = chartMap i P.1 := rfl
  rw [hp]
  simp_rw [pderiv_dehomogenize, eval_dehomogenize]
  have hv : chartInvVec i (chartMap i P.1) = (P.1.rep i)⁻¹ • P.1.rep :=
    chartInvVec_div i (rep_ne_zero_of_mem_standardChart hi)
  have hFv : eval (chartInvVec i (chartMap i P.1)) F = 0 := by
    rw [hv, hF.eval_smul, show eval P.1.rep F = 0 from P.2 F rfl, mul_zero]
  rw [exists_pderiv_ne_iff_of_eval_eq_zero hF i (chartInvVec_self i _) hFv, hv]
  have hc : (P.1.rep i)⁻¹ ≠ 0 := inv_ne_zero (rep_ne_zero_of_mem_standardChart hi)
  refine exists_congr fun l => ?_
  rw [(hF.pderiv (i := l)).eval_smul, mul_ne_zero_iff]
  exact and_iff_right (pow_ne_zero _ hc)

/-- **The regular locus of a projective plane curve.**  The points `P` of `Y = Z(F)` at which
`Y` is nonsingular, i.e. at which the local ring `𝒪_{P,Y}` is a regular local ring. -/
def planeCurveRegularLocus (hF : F.IsHomogeneous d) (hFirr : Irreducible F) :
    Set (ProjectiveSpace k (Fin 3)) :=
  {P | ∃ h : P ∈ projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)),
    (Variety.ofProjective (isProjVariety_planeCurve hF hFirr)).NonsingularAt
      (⟨P, h⟩ : projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)))}

theorem mem_planeCurveRegularLocus_iff (hF : F.IsHomogeneous d) (hFirr : Irreducible F)
    (P : ProjectiveSpace k (Fin 3)) :
    P ∈ planeCurveRegularLocus hF hFirr ↔
      P ∈ projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∧ ∃ l, eval P.rep (pderiv l F) ≠ 0 := by
  constructor
  · rintro ⟨h, hP⟩
    exact ⟨h, (nonsingularAt_planeCurve_iff hF hFirr ⟨P, h⟩).1 hP⟩
  · rintro ⟨h, hP⟩
    exact ⟨h, (nonsingularAt_planeCurve_iff hF hFirr ⟨P, h⟩).2 hP⟩

/-- Some partial derivative of `F` does not vanish identically on `Z(F)`. -/
theorem exists_mem_planeCurve_pderiv_ne_zero (hF : F.IsHomogeneous d) (hFirr : Irreducible F) :
    ∃ P ∈ projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)), ∃ l, eval P.rep (pderiv l F) ≠ 0 := by
  obtain ⟨l, hl⟩ := exists_pderiv_ne_zero_of_irreducible hFirr
  by_contra hc
  push Not at hc
  have hmem : pderiv l F ∈
      homogeneousVanishingIdeal (projZeroSet ({F} : Set (MvPolynomial (Fin 3) k))) :=
    Ideal.subset_span ⟨⟨d - 1, hF.pderiv⟩, fun P hP => hc P hP l⟩
  rw [homogeneousVanishingIdeal_planeCurve hF hFirr, Ideal.mem_span_singleton] at hmem
  obtain ⟨H, hH⟩ := hmem
  have hH0 : H ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hH
    exact hl hH
  have h1 := (hF.pderiv (i := l)).totalDegree hl
  rw [hH, totalDegree_mul_of_isDomain hFirr.ne_zero hH0, hF.totalDegree hFirr.ne_zero] at h1
  have := pos_of_isHomogeneous_irreducible hF hFirr
  omega

/-- The regular locus of a projective plane curve is a nonempty open subset of the curve, hence a
quasi-projective variety. -/
theorem isQuasiProjVariety_planeCurveRegularLocus (hF : F.IsHomogeneous d)
    (hFirr : Irreducible F) : IsQuasiProjVariety (planeCurveRegularLocus hF hFirr) := by
  obtain ⟨P, hPY, hP⟩ := exists_mem_planeCurve_pderiv_ne_zero hF hFirr
  refine ⟨⟨P, (mem_planeCurveRegularLocus_iff hF hFirr P).2 ⟨hPY, hP⟩⟩,
    projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)),
    (projZeroSet (Set.range fun l => pderiv l F))ᶜ, isProjVariety_planeCurve hF hFirr, ?_, ?_⟩
  · rw [isOpen_compl_iff, isClosed_iff_isProjAlgebraicSet]
    refine ⟨_, ?_, rfl⟩
    rintro _ ⟨l, rfl⟩
    exact ⟨d - 1, hF.pderiv⟩
  · ext Q
    rw [mem_planeCurveRegularLocus_iff hF hFirr]
    simp only [Set.mem_inter_iff, Set.mem_compl_iff, mem_projZeroSet_iff, Set.mem_range,
      forall_exists_index, forall_apply_eq_imp_iff, HomogeneousVanish, not_forall]

end PlaneCurve

section Tangent

/-- A line through a point missing it meets a curve there with multiplicity zero. -/
theorem affineLocalIntersectionMultiplicity_eq_zero_of_eval_ne_zero {σ : Type*}
    {f : MvPolynomial σ k} (g : MvPolynomial σ k) {p : σ → k} (hf : eval p f ≠ 0) :
    affineLocalIntersectionMultiplicity f g p = 0 := by
  have hu : IsUnit (algebraMap (MvPolynomial σ k) (affineLocalRing p) f) :=
    IsLocalization.map_units (M := (affinePointIdeal p).primeCompl) (affineLocalRing p)
      ⟨f, fun h => hf (mem_affinePointIdeal_iff.1 h)⟩
  have htop : Ideal.span {algebraMap (MvPolynomial σ k) (affineLocalRing p) f,
      algebraMap (MvPolynomial σ k) (affineLocalRing p) g} = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert _ _)) hu
  rw [affineLocalIntersectionMultiplicity, htop]
  exact Module.length_eq_zero

/-- If `g` is a multiple of `f` and `f` vanishes at `p`, then `(f · g)_p ≥ 2`. -/
theorem two_le_affineLocalIntersectionMultiplicity_of_dvd {f g : MvPolynomial (Fin 2) k}
    {p : Fin 2 → k} (hf : eval p f = 0) (hfg : f ∣ g) :
    2 ≤ affineLocalIntersectionMultiplicity f g p := by
  have hspan : Ideal.span {algebraMap (MvPolynomial (Fin 2) k) (affineLocalRing p) f,
      algebraMap (MvPolynomial (Fin 2) k) (affineLocalRing p) g} =
      Ideal.span {algebraMap (MvPolynomial (Fin 2) k) (affineLocalRing p) f,
      algebraMap (MvPolynomial (Fin 2) k) (affineLocalRing p) 0} := by
    obtain ⟨h, rfl⟩ := hfg
    rw [map_zero, map_mul]
    apply le_antisymm
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      refine ⟨Ideal.subset_span (Set.mem_insert _ _), ?_⟩
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _))
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨Ideal.subset_span (Set.mem_insert _ _), Ideal.zero_mem _⟩
  have h2 := le_affineLocalIntersectionMultiplicity_of_mem_pow p (a := 1) (b := 2) (f := f)
    (g := 0) (by rw [pow_one]; exact mem_affinePointIdeal_iff.2 hf) (Ideal.zero_mem _)
  unfold affineLocalIntersectionMultiplicity at h2 ⊢
  rw [hspan]
  simpa using h2

/-- A linear form vanishing on the kernel of a nonzero linear form is a multiple of it. -/
theorem exists_eq_smul_of_forall_sum_mul_eq_zero {a b : Fin 3 → k} (hb : b ≠ 0)
    (h : ∀ x : Fin 3 → k, ∑ j, b j * x j = 0 → ∑ j, a j * x j = 0) : ∃ c : k, a = c • b := by
  classical
  obtain ⟨j, hj⟩ := Function.ne_iff.1 hb
  simp only [Pi.zero_apply] at hj
  refine ⟨a j / b j, funext fun l => ?_⟩
  have hx := h (b j • Pi.single l 1 - b l • Pi.single j 1) (by
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, mul_sub, Finset.sum_sub_distrib,
      Pi.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring)
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, mul_sub, Finset.sum_sub_distrib,
    Pi.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ,
    if_true] at hx
  rw [Pi.smul_apply, smul_eq_mul]
  field_simp
  linear_combination hx

/-- The derivative of the restriction of `G` to the line `t ↦ v + t w`. -/
theorem derivative_homogeneousLineRestrict (G : MvPolynomial (Fin 3) k) (v w : Fin 3 → k) :
    Polynomial.derivative (homogeneousLineRestrict G v w) =
      ∑ j, Polynomial.C (w j) * homogeneousLineRestrict (pderiv j G) v w := by
  induction G using MvPolynomial.induction_on with
  | C a => simp [homogeneousLineRestrict]
  | add p q hp hq =>
    simp only [homogeneousLineRestrict, map_add] at hp hq ⊢
    rw [hp, hq, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => by ring
  | mul_X p l hp =>
    have key : ∀ x, pderiv x (p * X l) = pderiv x p * X l + p * pderiv x (X l) := fun x => by
      rw [pderiv_mul]
    simp only [homogeneousLineRestrict] at hp ⊢
    generalize hφ : (aeval fun j => Polynomial.C (v j) + Polynomial.C (w j) * Polynomial.X :
      MvPolynomial (Fin 3) k →ₐ[k] Polynomial k) = φ at hp ⊢
    have hφX : φ (X l) = Polynomial.C (v l) + Polynomial.C (w l) * Polynomial.X := by
      rw [← hφ, aeval_X]
    rw [map_mul, Polynomial.derivative_mul, hp]
    simp only [key, map_add, map_mul, mul_add, Finset.sum_add_distrib, Finset.sum_mul]
    refine congrArg₂ (· + ·) (Finset.sum_congr rfl fun j _ => by ring) ?_
    rw [Fintype.sum_eq_single l (fun x hx => by
      rw [pderiv_X_of_ne (Ne.symm hx), map_zero, mul_zero, mul_zero]), pderiv_X_self, map_one,
      mul_one, hφX]
    simp only [Polynomial.derivative_add, Polynomial.derivative_C, Polynomial.derivative_mul,
      Polynomial.derivative_X, zero_add, zero_mul, mul_one]
    ring

theorem projectivePlaneLineForm_ne_zero {b : Fin 3 → k} (hb : b ≠ 0) :
    projectivePlaneLineForm b ≠ 0 := by
  classical
  intro h
  obtain ⟨j, hj⟩ := Function.ne_iff.1 hb
  have := congrArg (eval (Pi.single j 1)) h
  rw [eval_projectivePlaneLineForm, map_zero] at this
  simp [Pi.single_apply] at this
  exact hj this

theorem irreducible_projectivePlaneLineForm {b : Fin 3 → k} (hb : b ≠ 0) :
    Irreducible (projectivePlaneLineForm b) := by
  have hne := projectivePlaneLineForm_ne_zero hb
  refine irreducible_of_totalDegree_eq_one
    ((isHomogeneous_projectivePlaneLineForm b).totalDegree hne) fun x hx => ?_
  rcases eq_or_ne x 0 with rfl | hx0
  · exfalso
    apply hne
    ext m
    simpa using hx m
  · exact isUnit_iff_ne_zero.2 hx0

/-- A homogeneous polynomial vanishing on a line of `ℙ²` is divisible by its linear form. -/
theorem projectivePlaneLineForm_dvd_of_vanish [IsAlgClosed k] {b : Fin 3 → k} (hb : b ≠ 0)
    {G : MvPolynomial (Fin 3) k} {n : ℕ} (hG : G.IsHomogeneous n)
    (hne : (projZeroSet ({projectivePlaneLineForm b} : Set (MvPolynomial (Fin 3) k))).Nonempty)
    (hvan : ∀ Q ∈ projZeroSet ({projectivePlaneLineForm b} : Set (MvPolynomial (Fin 3) k)),
      eval Q.rep G = 0) :
    projectivePlaneLineForm b ∣ G := by
  have hprime := span_singleton_isPrime_of_irreducible (irreducible_projectivePlaneLineForm hb)
  have hJ := homogeneousVanishingIdeal_projZeroSet
    (isHomogeneousIdeal_span_singleton (isHomogeneous_projectivePlaneLineForm b))
    (by rw [projZeroSet_span]; exact hne)
  rw [projZeroSet_span, hprime.radical] at hJ
  have hmem : G ∈ homogeneousVanishingIdeal
      (projZeroSet ({projectivePlaneLineForm b} : Set (MvPolynomial (Fin 3) k))) :=
    Ideal.subset_span ⟨⟨n, hG⟩, hvan⟩
  rw [hJ] at hmem
  exact Ideal.mem_span_singleton.1 hmem

open scoped Classical in
/-- **The tangent line** `T_P(Y)` to `Y = Z(F)` at `P`, as a point of the dual plane: the line
`∑ⱼ (∂F/∂xⱼ)(P) xⱼ = 0`.  When all partial derivatives vanish at `P` (only possible at a
singular point) the value is a junk value. -/
def planeCurveTangentLine (F : MvPolynomial (Fin 3) k) (P : ProjectiveSpace k (Fin 3)) :
    ProjectiveSpace k (Fin 3) :=
  if h : (fun l => eval P.rep (pderiv l F)) = 0 then P else Projectivization.mk k _ h

theorem planeCurveTangentLine_of_ne {F : MvPolynomial (Fin 3) k} {P : ProjectiveSpace k (Fin 3)}
    (h : (fun l => eval P.rep (pderiv l F)) ≠ 0) :
    planeCurveTangentLine F P = Projectivization.mk k _ h := by
  rw [planeCurveTangentLine, dif_neg h]

/-- At a point of `Y = Z(F)` where the gradient of `F` is nonzero, the gradient line is the only
line whose local intersection multiplicity with `Y` at `P` exceeds one. -/
theorem one_lt_projectivePlaneLocalIntersectionMultiplicity_iff [IsAlgClosed k]
    {F : MvPolynomial (Fin 3) k} {d : ℕ} (hF : F.IsHomogeneous d)
    {P : ProjectiveSpace k (Fin 3)} (hPY : P ∈ projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)))
    (hgrad : (fun l => eval P.rep (pderiv l F)) ≠ 0) (L : ProjectiveSpace k (Fin 3)) :
    1 < projectivePlaneLocalIntersectionMultiplicity (projectivePlaneLineForm L.rep) F P ↔
      L = Projectivization.mk k _ hgrad := by
  set v := P.rep with hv_def
  set a : Fin 3 → k := fun l => eval v (pderiv l F) with ha_def
  set b := L.rep with hb_def
  have hb : b ≠ 0 := L.rep_nonzero
  have hv0 : v ≠ 0 := P.rep_nonzero
  have hFv : eval v F = 0 := hPY F rfl
  have heuler : ∑ j, a j * v j = 0 := by
    have he := congrArg (eval v) hF.sum_X_mul_pderiv
    rw [map_nsmul, hFv, smul_zero, map_sum] at he
    rw [← he]
    exact Finset.sum_congr rfl fun j _ => by rw [map_mul, eval_X, mul_comm]
  have hLa : L = Projectivization.mk k a hgrad ↔ ∃ c : k, c • a = b := by
    conv_lhs => rw [← Projectivization.mk_rep L]
    exact Projectivization.mk_eq_mk_iff' k b a hb hgrad
  have hcrit : L = Projectivization.mk k a hgrad ↔
      ∀ x : Fin 3 → k, ∑ j, b j * x j = 0 → ∑ j, a j * x j = 0 := by
    rw [hLa]
    constructor
    · rintro ⟨c, hc⟩ x hx
      have hc0 : c ≠ 0 := by
        rintro rfl
        rw [zero_smul] at hc
        exact hb hc.symm
      rw [← hc] at hx
      simp only [Pi.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum] at hx
      exact (mul_eq_zero.1 hx).resolve_left hc0
    · intro h
      obtain ⟨c, hc⟩ := exists_eq_smul_of_forall_sum_mul_eq_zero hb h
      have hc0 : c ≠ 0 := by
        rintro rfl
        rw [zero_smul] at hc
        exact hgrad hc
      exact ⟨c⁻¹, by rw [hc, smul_smul, inv_mul_cancel₀ hc0, one_smul]⟩
  by_cases hbv : ∑ j, b j * v j = 0
  · have hvL : eval v (projectivePlaneLineForm b) = 0 := by
      rw [eval_projectivePlaneLineForm]; exact hbv
    obtain ⟨A, hAL, hind, hspan⟩ := exists_projectivePlaneLine_basis hb hv0 hvL
    have hcritA : L = Projectivization.mk k a hgrad ↔ ∑ j, a j * A j = 0 := by
      rw [hcrit]
      constructor
      · intro h
        exact h A (by rw [← eval_projectivePlaneLineForm]; exact hAL)
      · intro h x hx
        obtain ⟨s, t, rfl⟩ := hspan x (by rw [eval_projectivePlaneLineForm]; exact hx)
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib]
        rw [show ∑ j, a j * (s * A j) = s * ∑ j, a j * A j by
            rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring,
          show ∑ j, a j * (t * v j) = t * ∑ j, a j * v j by
            rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring, h, heuler]
        ring
    have hderiv : (Polynomial.derivative (homogeneousLineRestrict F v A)).eval 0 =
        ∑ j, a j * A j := by
      rw [derivative_homogeneousLineRestrict, Polynomial.eval_finsetSum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Polynomial.eval_mul, Polynomial.eval_C, eval_homogeneousLineRestrict, zero_smul,
        add_zero, mul_comm]
    by_cases hh : homogeneousLineRestrict F v A = 0
    · have hdA : ∑ j, a j * A j = 0 := by
        rw [← hderiv, hh, Polynomial.derivative_zero, Polynomial.eval_zero]
      refine iff_of_true ?_ (hcritA.2 hdA)
      -- `F` vanishes on the whole line, so the line divides `F`.
      have hFA : eval A F = 0 := by
        by_contra hA
        exact (natDegree_homogeneousLineRestrict hF v A hA).1 hh
      have hvan : ∀ Q ∈ projZeroSet ({projectivePlaneLineForm b} :
          Set (MvPolynomial (Fin 3) k)), eval Q.rep F = 0 := by
        intro Q hQ
        have hQL : eval Q.rep (projectivePlaneLineForm b) = 0 := hQ _ rfl
        obtain ⟨s, t, hst⟩ := hspan Q.rep hQL
        rw [hst]
        rcases eq_or_ne t 0 with rfl | ht
        · rw [zero_smul, add_zero, hF.eval_smul, hFA, mul_zero]
        · have : s • A + t • v = t • (v + (s / t) • A) := by
            rw [smul_add, smul_smul, mul_div_cancel₀ s ht, add_comm]
          rw [this, hF.eval_smul, ← eval_homogeneousLineRestrict, hh, Polynomial.eval_zero,
            mul_zero]
      have hdvd := projectivePlaneLineForm_dvd_of_vanish hb hF
        ⟨P, fun f hf => by rw [Set.mem_singleton_iff.1 hf]; exact hvL⟩ hvan
      -- Pass to the chart.
      set c := projectivePlaneChartIndex P
      have hc := mem_standardChart_projectivePlaneChartIndex P
      set e := finSuccAboveEquiv c
      set p := chartMap c P
      set q := chartPointFin c p
      have he : ∀ f, eval q (renameEquiv k e.symm f) = eval p f := by
        intro f
        rw [renameEquiv_apply, eval_rename]
        have : q ∘ e.symm = p := by funext j; simp [q, e]
        rw [this]
      have hpv : chartInvVec c p = (P.rep c)⁻¹ • P.rep :=
        chartInvVec_div c (rep_ne_zero_of_mem_standardChart hc)
      unfold projectivePlaneLocalIntersectionMultiplicity
      rw [← affineLocalIntersectionMultiplicity_algEquiv (renameEquiv k e.symm) p q he]
      refine lt_of_lt_of_le (by norm_num) (two_le_affineLocalIntersectionMultiplicity_of_dvd ?_
        (map_dvd _ (map_dvd _ hdvd)))
      rw [he, eval_dehomogenize, hpv, (isHomogeneous_projectivePlaneLineForm b).eval_smul, hvL,
        mul_zero]
    · have hX : v + (0 : k) • A ≠ 0 := by rwa [zero_smul, add_zero]
      have hmk : Projectivization.mk k (v + (0 : k) • A) hX = P := by
        conv_rhs => rw [← Projectivization.mk_rep P]
        congr 1
        rw [zero_smul, add_zero]
      have hmult := projectivePlaneLocalIntersectionMultiplicity_eq_rootMultiplicity hF hb hvL hAL
        (fun x hx => by obtain ⟨s, t, hst⟩ := hspan x hx; exact ⟨t, s, by rw [hst, add_comm]⟩)
        hh 0 hX
      rw [hmk] at hmult
      rw [hmult, hcritA, show ∀ n : ℕ, (1 : ℕ∞) < n ↔ 1 < n from fun n => by norm_cast,
        Polynomial.one_lt_rootMultiplicity_iff_isRoot hh, Polynomial.IsRoot.def,
        Polynomial.IsRoot.def, hderiv, eval_homogeneousLineRestrict, zero_smul, add_zero]
      exact and_iff_right hFv
  · -- `P` is not on `L`.
    have hmult : projectivePlaneLocalIntersectionMultiplicity (projectivePlaneLineForm b) F P = 0 := by
      have hc := mem_standardChart_projectivePlaneChartIndex P
      have hpv : chartInvVec (projectivePlaneChartIndex P)
          (chartMap (projectivePlaneChartIndex P) P) =
          (P.rep (projectivePlaneChartIndex P))⁻¹ • P.rep :=
        chartInvVec_div _ (rep_ne_zero_of_mem_standardChart hc)
      apply affineLocalIntersectionMultiplicity_eq_zero_of_eval_ne_zero
      rw [eval_dehomogenize, hpv, (isHomogeneous_projectivePlaneLineForm b).eval_smul,
        eval_projectivePlaneLineForm, pow_one]
      exact mul_ne_zero (inv_ne_zero (rep_ne_zero_of_mem_standardChart hc)) hbv
    rw [hmult]
    refine iff_of_false (by norm_num) fun hL => hbv ?_
    obtain ⟨c, hc⟩ := hLa.1 hL
    rw [← hc]
    simp only [Pi.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum, heuler, mul_zero]

end Tangent

section Morphism

variable [IsAlgClosed k]

/-- A map from a quasi-projective variety `U ⊆ ℙ²` to `ℙ²` given by homogeneous polynomials of a
common degree with no common zero on `U` is a morphism of varieties. -/
theorem exists_varietyHom_of_homogeneous {U : Set (ProjectiveSpace k (Fin 3))}
    (hU : IsQuasiProjVariety U) {m : ℕ} (G : Fin 3 → MvPolynomial (Fin 3) k)
    (hG : ∀ j, (G j).IsHomogeneous m) (hne : ∀ P ∈ U, (fun j => eval P.rep (G j)) ≠ 0) :
    ∃ φ : VarietyHom (Variety.ofQuasiProjective hU)
        (Variety.ofProjective (isProjVariety_univ (k := k) (σ := Fin 3))),
      ∀ P : U, Subtype.val (φ P) = Projectivization.mk k (fun j => eval P.1.rep (G j))
          (hne P.1 P.2) := by
  let gv : U → (Fin 3 → k) := fun P j => eval P.1.rep (G j)
  let ψ : U → ProjectiveSpace k (Fin 3) := fun P => Projectivization.mk k (gv P) (hne P.1 P.2)
  have hscale : ∀ P : U, ∃ c : k, c ≠ 0 ∧ (ψ P).rep = c • gv P := fun P => by
    obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep k (gv P) (hne P.1 P.2)
    exact ⟨c, c.ne_zero, hc.symm⟩
  have heval : ∀ (P : U) (g : MvPolynomial (Fin 3) k),
      eval (gv P) g = eval P.1.rep (aeval G g) := fun P g => by
    rw [eval_aeval_mvPolynomial]
  have hcont : Continuous ψ := by
    rw [continuous_iff_isClosed]
    intro Z hZ
    obtain ⟨T, hT, rfl⟩ := isClosed_iff_isProjAlgebraicSet.1 hZ
    have hpre : ψ ⁻¹' projZeroSet T = Subtype.val ⁻¹' projZeroSet (aeval G '' T) := by
      ext P
      simp only [Set.mem_preimage, mem_projZeroSet_iff, Set.forall_mem_image]
      refine forall₂_congr fun g hg => ?_
      obtain ⟨n, hn⟩ := hT g hg
      rw [homogeneousVanish_iff_of_isHomogeneous hn, HomogeneousVanish, heval]
    rw [hpre]
    refine IsClosed.preimage continuous_subtype_val
      (isClosed_iff_isProjAlgebraicSet.2 ⟨_, ?_, rfl⟩)
    rintro _ ⟨g, hg, rfl⟩
    obtain ⟨n, hn⟩ := hT g hg
    exact ⟨m * n, hn.aeval G hG⟩
  refine ⟨⟨fun P => ⟨ψ P, Set.mem_univ _⟩, hcont.subtype_mk _, ?_⟩, fun P => rfl⟩
  intro V f hf
  have hf' : IsRegularProjVia (projOpenIota V) f := hf
  show IsRegularProjVia _ _
  intro x
  obtain ⟨W, hW, hxW, n, g, h, hg, hh, hne', he⟩ := hf' ⟨⟨ψ x.1, Set.mem_univ _⟩, x.2⟩
  let ι : (Opens.comap ⟨fun P : U => (⟨ψ P, Set.mem_univ _⟩ : (Set.univ :
      Set (ProjectiveSpace k (Fin 3)))), hcont.subtype_mk _⟩ V) → V :=
    fun y => ⟨⟨ψ y.1, Set.mem_univ _⟩, y.2⟩
  have hι : Continuous ι := by fun_prop
  refine ⟨ι ⁻¹' W, hW.preimage hι, hxW, m * n, aeval G g, aeval G h, hg.aeval G hG,
    hh.aeval G hG, fun y hy => ?_, fun y hy => ?_⟩
  · obtain ⟨c, hc, hcr⟩ := hscale y.1
    have := hne' (ι y) hy
    change eval (ψ y.1).rep h ≠ 0 at this
    rw [hcr, hh.eval_smul] at this
    change eval y.1.1.rep (aeval G h) ≠ 0
    rw [← heval]
    exact right_ne_zero_of_mul this
  · obtain ⟨c, hc, hcr⟩ := hscale y.1
    have := he (ι y) hy
    change f (ι y) = eval (ψ y.1).rep g / eval (ψ y.1).rep h at this
    change f (ι y) = eval y.1.1.rep (aeval G g) / eval y.1.1.rep (aeval G h)
    rw [this, hcr, hg.eval_smul, hh.eval_smul, ← heval, ← heval,
      mul_div_mul_left _ _ (pow_ne_zero n hc)]

end Morphism

section Dual

variable [IsAlgClosed k] {F : MvPolynomial (Fin 3) k} {d : ℕ}

/-- **The dual curve** `Y* ⊆ (ℙ²)*` of the projective plane curve `Y = Z(F)`: the closure of the
image of the regular locus of `Y` under the tangent-line map `P ↦ T_P(Y)`.  A point `a` of the
dual plane stands for the line `a₀x₀ + a₁x₁ + a₂x₂ = 0`. -/
def planeDualCurve (hF : F.IsHomogeneous d) (hFirr : Irreducible F) :
    Set (ProjectiveSpace k (Fin 3)) :=
  closure (planeCurveTangentLine F '' planeCurveRegularLocus hF hFirr)

theorem gradient_ne_zero_of_mem_planeCurveRegularLocus (hF : F.IsHomogeneous d)
    (hFirr : Irreducible F) {P : ProjectiveSpace k (Fin 3)}
    (hP : P ∈ planeCurveRegularLocus hF hFirr) :
    P ∈ projZeroSet ({F} : Set (MvPolynomial (Fin 3) k)) ∧
      (fun l => eval P.rep (pderiv l F)) ≠ 0 := by
  obtain ⟨hPY, l, hl⟩ := (mem_planeCurveRegularLocus_iff hF hFirr P).1 hP
  exact ⟨hPY, fun h => hl (congrFun h l)⟩

/-- **Hartshorne I, Exercise 7.3 (the dual curve).**  Let `Y = Z(F) ⊆ ℙ²` be a projective plane
curve, `F` irreducible and homogeneous; identify a point `a` of the dual plane `(ℙ²)*` with the
line `a₀x₀ + a₁x₁ + a₂x₂ = 0`.

* For every regular point `P` of `Y` there is a unique line whose local intersection
  multiplicity with `Y` at `P` is greater than one; it is the tangent line `T_P(Y)`.
* The assignment `P ↦ T_P(Y)` is a morphism from the regular locus of `Y` to `(ℙ²)*`, and the
  dual curve `Y*` is the closure of its image. -/
theorem planeCurve_tangentLine_morphism (hF : F.IsHomogeneous d) (hFirr : Irreducible F) :
    (∀ P ∈ planeCurveRegularLocus hF hFirr, ∃! L : ProjectiveSpace k (Fin 3),
      1 < projectivePlaneLocalIntersectionMultiplicity (projectivePlaneLineForm L.rep) F P) ∧
    (∀ P ∈ planeCurveRegularLocus hF hFirr, ∀ L : ProjectiveSpace k (Fin 3),
      1 < projectivePlaneLocalIntersectionMultiplicity (projectivePlaneLineForm L.rep) F P ↔
        L = planeCurveTangentLine F P) ∧
    ∃ φ : VarietyHom
        (Variety.ofQuasiProjective (isQuasiProjVariety_planeCurveRegularLocus hF hFirr))
        (Variety.ofProjective (isProjVariety_univ (k := k) (σ := Fin 3))),
      (∀ P : planeCurveRegularLocus hF hFirr, Subtype.val (φ P) = planeCurveTangentLine F P) ∧
        planeDualCurve hF hFirr = closure (Set.range fun P => Subtype.val (φ P)) := by
  have htan : ∀ P ∈ planeCurveRegularLocus hF hFirr, ∀ L : ProjectiveSpace k (Fin 3),
      1 < projectivePlaneLocalIntersectionMultiplicity (projectivePlaneLineForm L.rep) F P ↔
        L = planeCurveTangentLine F P := by
    intro P hP L
    obtain ⟨hPY, hgrad⟩ := gradient_ne_zero_of_mem_planeCurveRegularLocus hF hFirr hP
    rw [planeCurveTangentLine_of_ne hgrad]
    exact one_lt_projectivePlaneLocalIntersectionMultiplicity_iff hF hPY hgrad L
  refine ⟨fun P hP => ⟨planeCurveTangentLine F P, (htan P hP _).2 rfl,
    fun L hL => (htan P hP L).1 hL⟩, htan, ?_⟩
  obtain ⟨φ, hφ⟩ := exists_varietyHom_of_homogeneous
    (isQuasiProjVariety_planeCurveRegularLocus hF hFirr) (fun j => pderiv j F)
    (fun j => hF.pderiv (i := j))
    (fun P hP => (gradient_ne_zero_of_mem_planeCurveRegularLocus hF hFirr hP).2)
  have hφ' : ∀ P : planeCurveRegularLocus hF hFirr,
      Subtype.val (φ P) = planeCurveTangentLine F P := fun P => by
    rw [hφ, planeCurveTangentLine_of_ne]
  refine ⟨φ, hφ', ?_⟩
  rw [planeDualCurve]
  congr 1
  ext L
  constructor
  · rintro ⟨P, hP, rfl⟩
    exact ⟨⟨P, hP⟩, hφ' ⟨P, hP⟩⟩
  · rintro ⟨P, rfl⟩
    exact ⟨P.1, P.2, (hφ' P).symm⟩

end Dual

end
end Hartshorne
