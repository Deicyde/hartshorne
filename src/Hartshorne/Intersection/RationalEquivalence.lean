import Hartshorne.Scheme.WeilClassGroup

/-!
# Rational equivalence via divisors on normalizations

Hartshorne, *Algebraic Geometry*, Appendix A.1 (p. 426).

Let `X` be a variety: an integral scheme, separated and of finite type over a field `k`, of
dimension `n`. An integral subvariety `V` of `X` is recorded as an integral scheme `V` with a
closed immersion `i : V ⟶ X`; its codimension is that of the closed set `i(V)`. Let
`ν : Ṽ ⟶ V ⟶ X` be the composite of the normalization of `V` with `i`
(`subvarietyNormalizationMap`). It is finite, and `Ṽ` is a normal integral separated scheme of
finite type over `k`, so it satisfies Hartshorne's condition `(*)`
(`satisfiesConditionStar_absoluteNormalization`); hence Weil divisors and linear equivalence make
sense on `Ṽ`, and a Weil divisor on `Ṽ` is a codimension-one cycle (`weilDivisorToCodimOneCycles`).

If `V` has codimension `r - 1`, then `dim Ṽ = n + 1 - r`
(`topologicalKrullDim_absoluteNormalization_eq`), so the raw cycle pushforward along `ν` sends
codimension-one cycles of `Ṽ` to codimension-`r` cycles of `X`
(`subvarietyNormalizationPushforward`). The rational-equivalence subgroup of the codimension-`r`
cycles is generated by `ν_* D - ν_* D'` for all such `V` and all linearly equivalent Weil divisors
`D, D'` on `Ṽ` (`rationalEquivalenceSubgroup`), and two cycles are rationally equivalent when
their difference lies in it (`RationallyEquivalent`). The condition that `V` has codimension
`r - 1` is written `codim i(V) + 1 = r`, so that for `r = 0` there are no generators.
-/

namespace Hartshorne

open AlgebraicGeometry CategoryTheory Limits Order TopologicalSpace

universe u

/-- The codimension of the closure of a point is the coheight of the point. -/
theorem codim_closure_singleton_eq_coheight {X : Scheme.{u}} (x : X) :
    codim (closure ({x} : Set X)) = coheight x := by
  let e : IrreducibleCloseds X ≃o X := irreducibleSetEquivPoints
  have he : ((e.symm x : IrreducibleCloseds X) : Set X) = closure {x} :=
    coe_irreducibleEquivPoints_symm_apply x
  apply le_antisymm
  · calc codim (closure ({x} : Set X)) ≤ coheight (e.symm x) :=
          iInf₂_le (f := fun (W : IrreducibleCloseds X) (_ : (W : Set X) ⊆ closure {x}) ↦
            coheight W) _ he.le
      _ = coheight x := coheight_orderIso _ _
  · rw [← coheight_orderIso e.symm x]
    refine le_iInf₂ fun W hW ↦ coheight_anti ?_
    change (W : Set X) ⊆ (e.symm x : Set X)
    rw [he]
    exact hW

/-- A locally Noetherian normal scheme is regular in codimension one: a codimension-one local
ring is a one-dimensional Noetherian integrally closed local domain, hence regular. -/
theorem isRegularInCodimensionOne_of_isNormal {Y : Scheme.{u}} [IsLocallyNoetherian Y]
    [IsNormal Y] : Y.IsRegularInCodimensionOne := by
  intro y hy
  have hdim : ringKrullDim (Y.presheaf.stalk y) = 1 := by
    rw [ringKrullDim_stalk_eq_coheight, hy]
    rfl
  exact ((dvr_characterizations (Y.presheaf.stalk y) hdim).out 1 2).mp
    (IsNormal.isIntegrallyClosed_stalk y)

/-- A normal integral scheme, separated and of finite type over a field, satisfies Hartshorne's
condition `(*)`. -/
theorem satisfiesConditionStar_of_isNormal {k : Type u} [Field k] {Y : Scheme.{u}}
    (q : Y ⟶ Spec (.of k)) (hq : FiniteType q) [IsSeparated q] [IsIntegral Y] [IsNormal Y] :
    Y.SatisfiesConditionStar := by
  have := hq.1
  have := hq.2
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian q
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace q
  refine ⟨{}, inferInstance, ⟨?_⟩, isRegularInCodimensionOne_of_isNormal⟩
  rw [← terminal.comp_from q]
  infer_instance

/-- On a scheme satisfying `(*)`, a Weil divisor is a codimension-one cycle. -/
noncomputable def weilDivisorToCodimOneCycles {Y : Scheme.{u}} (hY : Y.SatisfiesConditionStar) :
    Y.WeilDivisor →+ codimensionCycles Y 1 :=
  let _ : IsNoetherian Y := hY.isNoetherian
  { toFun D := ⟨D.1, Scheme.WeilDivisor.support_finite D, fun x hx => by
      rw [codim_closure_singleton_eq_coheight]
      by_contra h
      exact hx (D.2 x fun h' => h (by exact_mod_cast h'))⟩
    map_zero' := rfl
    map_add' _ _ := rfl }

@[simp]
lemma coe_weilDivisorToCodimOneCycles {Y : Scheme.{u}} (hY : Y.SatisfiesConditionStar)
    (D : Y.WeilDivisor) :
    (weilDivisorToCodimOneCycles hY D : AlgebraicCycle Y ℤ) = D.1 :=
  rfl

/-- The normalization map `ν : Ṽ ⟶ V ⟶ X` of an integral subscheme `V` of `X` with closed
immersion `i`: the normalization morphism of `V` followed by `i`. -/
noncomputable def subvarietyNormalizationMap {X V : Scheme.{u}} [IsIntegral V] (i : V ⟶ X) :
    absoluteNormalization V ⟶ X :=
  absoluteNormalizationMap V ≫ i

section Variety

variable {k : Type u} [Field k] {X : Scheme.{u}}

/-- The normalization morphism of an integral closed subscheme of a scheme of finite type over a
field is finite. -/
theorem isFinite_absoluteNormalizationMap_of_isClosedImmersion (p : X ⟶ Spec (.of k))
    (hp : FiniteType p) {V : Scheme.{u}} [IsIntegral V] (i : V ⟶ X) [IsClosedImmersion i] :
    IsFinite (absoluteNormalizationMap V) := by
  have := hp.1
  have := hp.2
  exact isFinite_absoluteNormalizationMap_of_finiteType_field k V (i ≫ p)
    ⟨inferInstance, inferInstance⟩

/-- The normalization map of an integral closed subscheme of a scheme of finite type over a field
is finite. -/
theorem isFinite_subvarietyNormalizationMap (p : X ⟶ Spec (.of k)) (hp : FiniteType p)
    {V : Scheme.{u}} [IsIntegral V] (i : V ⟶ X) [IsClosedImmersion i] :
    IsFinite (subvarietyNormalizationMap i) := by
  have := isFinite_absoluteNormalizationMap_of_isClosedImmersion p hp i
  unfold subvarietyNormalizationMap
  infer_instance

/-- The normalization of an integral closed subscheme of a scheme of finite type over `k` is of
finite type over `k`. -/
theorem finiteType_subvarietyNormalizationMap_comp (p : X ⟶ Spec (.of k)) (hp : FiniteType p)
    {V : Scheme.{u}} [IsIntegral V] (i : V ⟶ X) [IsClosedImmersion i] :
    FiniteType (subvarietyNormalizationMap i ≫ p) := by
  have := isFinite_subvarietyNormalizationMap p hp i
  have := hp.1
  have := hp.2
  exact ⟨inferInstance, inferInstance⟩

/-- If `X` is separated and of finite type over `k`, the normalization `Ṽ` of an integral closed
subscheme `V` of `X` satisfies Hartshorne's condition `(*)`. -/
theorem satisfiesConditionStar_absoluteNormalization (p : X ⟶ Spec (.of k)) (hp : FiniteType p)
    [IsSeparated p] {V : Scheme.{u}} [IsIntegral V] (i : V ⟶ X) [IsClosedImmersion i] :
    (absoluteNormalization V).SatisfiesConditionStar := by
  have := isFinite_subvarietyNormalizationMap p hp i
  have := (absoluteNormalization_isNormal_and_isIntegral V).1
  exact satisfiesConditionStar_of_isNormal (subvarietyNormalizationMap i ≫ p)
    (finiteType_subvarietyNormalizationMap_comp p hp i)

/-- The dimension of the normalization of an integral closed subscheme `V` of an integral scheme
`X` of finite type over `k`, plus the codimension of `V` in `X`, is the dimension of `X`. -/
theorem topologicalKrullDim_absoluteNormalization_add_codim (p : X ⟶ Spec (.of k))
    [IsIntegral X] (hp : FiniteType p) {V : Scheme.{u}} [IsIntegral V] (i : V ⟶ X)
    [IsClosedImmersion i] :
    topologicalKrullDim (absoluteNormalization V) + (codim (Set.range i) : WithBot ℕ∞) =
      topologicalKrullDim X := by
  let ν := subvarietyNormalizationMap i
  have hfin : IsFinite ν := isFinite_subvarietyNormalizationMap p hp i
  have := isFinite_absoluteNormalizationMap_of_isClosedImmersion p hp i
  let ξ := genericPoint (absoluteNormalization V)
  -- The generic point of `Ṽ` is closed in its fibre, since the fibres of `ν` are discrete.
  have hmin : ∀ z, z ≤ ξ → ν z = ν ξ → z = ξ := fun z hz hzξ =>
    (ν.isDiscrete_preimage_singleton (ν ξ)).eq_of_specializes
      (show ξ ⤳ z from hz) rfl hzξ |>.symm
  have hheight : height ξ = height (ν ξ) :=
    FlatEquidimensional.height_eq_height_of_forall (ν ≫ p) p
      (finiteType_subvarietyNormalizationMap_comp p hp i) hp ν ξ hmin
  -- The image of the generic point of `Ṽ` is the generic point of `i(V)`.
  have hsurj : Function.Surjective (absoluteNormalizationMap V) := by
    have := absoluteNormalizationMap_isDominant V
    have := surjective_of_isDominant_of_isClosed_range _
      (absoluteNormalizationMap V).isClosedMap.isClosed_range
    exact (absoluteNormalizationMap V).surjective
  have hclosure : closure ({ν ξ} : Set X) = Set.range i := by
    apply le_antisymm
    · exact closure_minimal (Set.singleton_subset_iff.mpr ⟨_, rfl⟩)
        i.isClosedEmbedding.isClosed_range
    · rintro _ ⟨v, rfl⟩
      obtain ⟨w, rfl⟩ := hsurj v
      have hw : w ∈ closure ({ξ} : Set (absoluteNormalization V)) := by
        rw [(genericPoint_spec (absoluteNormalization V)).def]
        trivial
      have := image_closure_subset_closure_image ν.continuous ⟨w, hw, rfl⟩
      rwa [Set.image_singleton] at this
  have hdim : topologicalKrullDim (absoluteNormalization V) = (height ξ : WithBot ℕ∞) := by
    rw [← FlatEquidimensional.topologicalKrullDim_closure_singleton,
      (genericPoint_spec (absoluteNormalization V)).def]
    exact (IsHomeomorph.topologicalKrullDim_eq _
      (Homeomorph.Set.univ (absoluteNormalization V)).isHomeomorph).symm
  have hX := dimension_codimension_formula p hp (Set.range i)
    i.isClosedEmbedding.isClosed_range (Set.range_nonempty _)
  rw [← hclosure, FlatEquidimensional.topologicalKrullDim_closure_singleton, ← hheight] at hX
  rw [hdim, ← hclosure]
  exact hX

/-- If an integral closed subscheme `V` of an `n`-dimensional integral scheme `X` of finite type
over `k` has codimension `r - 1` (written `codim V + 1 = r`), then its normalization has dimension
`n + 1 - r`, and the codimension index `1 + n - (n + 1 - r)` of the raw pushforward of
codimension-one cycles along the normalization map is `r`. -/
theorem topologicalKrullDim_absoluteNormalization_eq (p : X ⟶ Spec (.of k)) [IsIntegral X]
    (hp : FiniteType p) {n : ℕ} (hn : topologicalKrullDim X = n) {V : Scheme.{u}} [IsIntegral V]
    (i : V ⟶ X) [IsClosedImmersion i] {r : ℕ} (hV : codim (Set.range i) + 1 = r) :
    topologicalKrullDim (absoluteNormalization V) = ((n + 1 - r : ℕ) : WithBot ℕ∞) ∧
      1 + n - (n + 1 - r) = r := by
  have h := topologicalKrullDim_absoluteNormalization_add_codim p hp i
  rw [hn] at h
  have hne : topologicalKrullDim (absoluteNormalization V) ≠ ⊥ := by
    intro hb
    rw [hb] at h
    simp at h
  obtain ⟨d, hd⟩ := WithBot.ne_bot_iff_exists.mp hne
  rw [← hd] at h ⊢
  have h' : d + codim (Set.range i) = n := by exact_mod_cast h
  obtain ⟨a, rfl⟩ := ENat.ne_top_iff_exists.mp
    (ne_top_of_le_ne_top (ENat.natCast_ne_top n) (le_self_add.trans_eq h'))
  obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.mp
    (ne_top_of_le_ne_top (ENat.natCast_ne_top n) (le_add_self.trans_eq h'))
  rw [← hb] at h' hV
  have h1 : a + b = n := by exact_mod_cast h'
  have h2 : b + 1 = r := by exact_mod_cast hV
  refine ⟨?_, by omega⟩
  have : a = n + 1 - r := by omega
  rw [this]
  rfl

/-- **Pushforward along the normalization of a subvariety.** Let `X` be an integral scheme of
finite type over `k` of dimension `n`, and `V` an integral closed subscheme of codimension `r - 1`
(written `codim V + 1 = r`), with normalization map `ν : Ṽ ⟶ V ⟶ X`. The raw cycle pushforward
`ν_*` along `ν` (with `dim Ṽ = n + 1 - r`) maps codimension-one cycles of `Ṽ` to codimension-`r`
cycles of `X`. -/
noncomputable def subvarietyNormalizationPushforward (p : X ⟶ Spec (.of k)) [IsIntegral X]
    (hp : FiniteType p) {n : ℕ} (hn : topologicalKrullDim X = n) {V : Scheme.{u}} [IsIntegral V]
    (i : V ⟶ X) [IsClosedImmersion i] {r : ℕ} (hV : codim (Set.range i) + 1 = r) :
    codimensionCycles (absoluteNormalization V) 1 →+ codimensionCycles X r :=
  (AddSubgroup.inclusion (le_of_eq (congrArg (codimensionCycles X)
      (topologicalKrullDim_absoluteNormalization_eq p hp hn i hV).2))).comp
    (rawCyclePushforward (subvarietyNormalizationMap i ≫ p) p
      (finiteType_subvarietyNormalizationMap_comp p hp i) hp (subvarietyNormalizationMap i) rfl
      (topologicalKrullDim_absoluteNormalization_eq p hp hn i hV).1 hn 1)

/-- The pushforward along the normalization of a subvariety is the raw cycle pushforward along
the normalization map. -/
lemma coe_subvarietyNormalizationPushforward (p : X ⟶ Spec (.of k)) [IsIntegral X]
    (hp : FiniteType p) {n : ℕ} (hn : topologicalKrullDim X = n) {V : Scheme.{u}} [IsIntegral V]
    (i : V ⟶ X) [IsClosedImmersion i] {r : ℕ} (hV : codim (Set.range i) + 1 = r)
    (c : codimensionCycles (absoluteNormalization V) 1) :
    (subvarietyNormalizationPushforward p hp hn i hV c : AlgebraicCycle X ℤ) =
      ∑ x ∈ c.2.1.toFinset,
        (c : AlgebraicCycle _ ℤ) x • rawCyclePushforwardGenerator (subvarietyNormalizationMap i) x :=
  coe_rawCyclePushforward (subvarietyNormalizationMap i ≫ p) p
    (finiteType_subvarietyNormalizationMap_comp p hp i) hp _ rfl
    (topologicalKrullDim_absoluteNormalization_eq p hp hn i hV).1 hn 1 c

/-- The generators of rational equivalence in codimension `r` on a variety `X` (integral,
separated and of finite type over `k`, of dimension `n`): the cycles `ν_* D - ν_* D'`, where `V`
ranges over the integral closed subschemes of `X` of codimension `r - 1`, `ν : Ṽ ⟶ V ⟶ X` is the
normalization map, and `D, D'` are linearly equivalent Weil divisors on `Ṽ`. -/
noncomputable def rationalEquivalenceGenerators (p : X ⟶ Spec (.of k)) [IsIntegral X] (hp : FiniteType p)
    [IsSeparated p] {n : ℕ} (hn : topologicalKrullDim X = n) (r : ℕ) :
    Set (codimensionCycles X r) :=
  {c | ∃ (V : Scheme.{u}) (_ : IsIntegral V) (i : V ⟶ X) (_ : IsClosedImmersion i)
      (hV : codim (Set.range i) + 1 = r) (D D' : (absoluteNormalization V).WeilDivisor),
      Scheme.WeilDivisor.LinearEquivalent (satisfiesConditionStar_absoluteNormalization p hp i)
        D D' ∧
      c = subvarietyNormalizationPushforward p hp hn i hV
          (weilDivisorToCodimOneCycles (satisfiesConditionStar_absoluteNormalization p hp i) D) -
        subvarietyNormalizationPushforward p hp hn i hV
          (weilDivisorToCodimOneCycles (satisfiesConditionStar_absoluteNormalization p hp i) D')}

/-- **Rational equivalence** (Hartshorne, Appendix A.1). Let `X` be a variety: an integral scheme,
separated and of finite type over a field `k`, of dimension `n`. The rational-equivalence subgroup
of the group of codimension-`r` cycles is the subgroup generated by `ν_* D - ν_* D'` for every
integral subvariety `V` of codimension `r - 1` with normalization map `ν : Ṽ ⟶ V ⟶ X` and all
linearly equivalent Weil divisors `D, D'` on `Ṽ`. -/
noncomputable def rationalEquivalenceSubgroup (p : X ⟶ Spec (.of k)) [IsIntegral X] (hp : FiniteType p)
    [IsSeparated p] {n : ℕ} (hn : topologicalKrullDim X = n) (r : ℕ) :
    AddSubgroup (codimensionCycles X r) :=
  AddSubgroup.closure (rationalEquivalenceGenerators p hp hn r)

/-- Two codimension-`r` cycles on a variety are **rationally equivalent** when their difference
lies in the rational-equivalence subgroup. -/
def RationallyEquivalent (p : X ⟶ Spec (.of k)) [IsIntegral X] (hp : FiniteType p)
    [IsSeparated p] {n : ℕ} (hn : topologicalKrullDim X = n) {r : ℕ}
    (c c' : codimensionCycles X r) : Prop :=
  c - c' ∈ rationalEquivalenceSubgroup p hp hn r

end Variety

end Hartshorne
