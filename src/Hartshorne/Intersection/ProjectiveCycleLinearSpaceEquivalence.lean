import Hartshorne.Intersection.ProjectiveCycleDegreeInvariance
import Hartshorne.Intersection.ProjectiveLinearSubspaceGeneration
import Hartshorne.Scheme.ProjectiveWeilDivisorDegree

/-!
# Projective cycles are rationally equivalent to degree times a linear space

Hartshorne, Appendix A, Exercise 6.3. Let `k` be algebraically closed and let `Y ⊆ ℙⁿ_k` be an
integral subvariety of dimension `m` and degree `d`. Then `Y` is rationally equivalent to `d`
times the linear subspace `L_m = V(x_{m+1}, …, x_n)`
(`rationallyEquivalent_projectiveDegree_smul_linearSubspaceCycle`); equivalently
`[Y] = d · [L_m]` in the Chow group `A^{n-m}(ℙⁿ_k)`
(`chowGroup_mk_pointCodimensionCycle_eq_projectiveDegree_smul`).

Hartshorne's hint projects `Y` from a general linear centre and degenerates it to `d` times its
image. This formalization takes a different route, following Fulton, *Intersection Theory*,
§1.9 and §§1.4, 2.5: `[Y]` is rationally equivalent to `a · [L_m]` for some integer `a` because
the Chow groups of `ℙⁿ_k` are generated by linear subspaces, and comparing degrees, which are
invariant under rational equivalence, gives `a = deg Y · 1 = d`.
-/

universe u

open AlgebraicGeometry CategoryTheory MvPolynomial Order

namespace Hartshorne

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type u} [Field k] [IsAlgClosed k] {n m : ℕ}

/-- **Hartshorne A, Exercise 6.3 (rational equivalence form).** Let `k` be algebraically closed,
`m ≤ n`, and let `Y = closure {y}` be an integral subvariety of `ℙⁿ_k` of dimension `m`
(codimension `n - m`) and degree `d`, the projective degree of `Y` read off from its Hilbert
polynomial. Then `[Y]` is rationally equivalent to `d · [L_m]`, where
`L_m = V(x_{m+1}, …, x_n)` is a linear subspace of dimension `m`. -/
theorem rationallyEquivalent_projectiveDegree_smul_linearSubspaceCycle (hm : m ≤ n)
    {y : Proj (homogeneousSubmodule (Fin (n + 1)) k)}
    (hy : codim (closure ({y} : Set (Proj (homogeneousSubmodule (Fin (n + 1)) k)))) =
      (n - m : ℕ))
    {d : ℤ} (hd : (d : ℚ) = projectiveDegree
      (projZeroSet (y.asHomogeneousIdeal : Set (MvPolynomial (Fin (n + 1)) k)))) :
    RationallyEquivalent projectiveSpaceStructureMorphism
      finiteType_projectiveSpaceStructureMorphism topologicalKrullDim_projectiveSpace
      (pointCodimensionCycle y hy) (d • linearSubspaceCycle (k := k) n m rfl hm) := by
  obtain rfl : d = projectiveSpectrumPointDegree y := by
    exact_mod_cast hd.trans (projectiveSpectrumPointDegree_cast y).symm
  exact rationallyEquivalent_degree_smul_linearSubspace_of_exists hm hy
    (fun _ hc ↦ cycleProjectiveDegree_eq_zero_of_mem_rationalEquivalenceSubgroup hc)
    (exists_rationallyEquivalent_zsmul_linearSubspace hm hy)

/-- **Hartshorne A, Exercise 6.3 (Chow class form).** Let `k` be algebraically closed, `m ≤ n`,
and let `Y = closure {y}` be an integral subvariety of `ℙⁿ_k` of dimension `m` and projective
degree `d`. Then `[Y] = d · [L_m]` in the Chow group `A^{n-m}(ℙⁿ_k)`, where
`L_m = V(x_{m+1}, …, x_n) ≅ ℙᵐ_k`. -/
theorem chowGroup_mk_pointCodimensionCycle_eq_projectiveDegree_smul (hm : m ≤ n)
    {y : Proj (homogeneousSubmodule (Fin (n + 1)) k)}
    (hy : codim (closure ({y} : Set (Proj (homogeneousSubmodule (Fin (n + 1)) k)))) =
      (n - m : ℕ))
    {d : ℤ} (hd : (d : ℚ) = projectiveDegree
      (projZeroSet (y.asHomogeneousIdeal : Set (MvPolynomial (Fin (n + 1)) k)))) :
    (QuotientAddGroup.mk (pointCodimensionCycle y hy) :
      chowGroup projectiveSpaceStructureMorphism finiteType_projectiveSpaceStructureMorphism
        topologicalKrullDim_projectiveSpace (n - m)) =
      d • (QuotientAddGroup.mk (linearSubspaceCycle (k := k) n m rfl hm) :
        chowGroup projectiveSpaceStructureMorphism finiteType_projectiveSpaceStructureMorphism
          topologicalKrullDim_projectiveSpace (n - m)) := by
  rw [← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq_iff_sub_mem]
  exact rationallyEquivalent_projectiveDegree_smul_linearSubspaceCycle hm hy hd

end Hartshorne
