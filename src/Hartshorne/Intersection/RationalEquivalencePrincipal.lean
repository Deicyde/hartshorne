import Hartshorne.Intersection.RationalEquivalence

/-!
# Rational equivalence is generated by pushed principal divisors

Hartshorne, *Algebraic Geometry*, Appendix A.1 (p. 426).

Let `X` be a variety: an integral scheme, separated and of finite type over a field `k`, of
dimension `n`. The rational-equivalence subgroup of the codimension-`r` cycles is generated by
`ν_* D - ν_* D'` for every integral subvariety `V` of codimension `r - 1`, with normalization map
`ν : Ṽ ⟶ V ⟶ X`, and all linearly equivalent Weil divisors `D, D'` on `Ṽ`. Since `D ∼ D'` means
`D - D' = div g` for a nonzero rational function `g` on `Ṽ`, and `ν_*` is additive, the same
subgroup is generated by the pushed principal divisors `ν_* (div g)`
(`rationalEquivalenceSubgroup_eq_closure_principalDivisor`).
-/

namespace Hartshorne

open AlgebraicGeometry CategoryTheory Order

universe u

variable {k : Type u} [Field k] {X : Scheme.{u}}

/-- **Rational equivalence is generated by pushed principal divisors** (Hartshorne, Appendix A.1).
Let `X` be a variety (an integral scheme, separated and of finite type over a field `k`) of
dimension `n`. The rational-equivalence subgroup of the codimension-`r` cycles is generated by the
cycles `ν_* (div g)`, where `V` ranges over the integral closed subschemes of `X` of codimension
`r - 1` (written `codim V + 1 = r`), `ν : Ṽ ⟶ V ⟶ X` is the normalization map, and `g` ranges over
the nonzero rational functions on `Ṽ`. -/
theorem rationalEquivalenceSubgroup_eq_closure_principalDivisor (p : X ⟶ Spec (.of k))
    [IsIntegral X] (hp : FiniteType p) [IsSeparated p] {n : ℕ} (hn : topologicalKrullDim X = n)
    (r : ℕ) :
    rationalEquivalenceSubgroup p hp hn r = AddSubgroup.closure
      {c | ∃ (V : Scheme.{u}) (_ : IsIntegral V) (i : V ⟶ X) (_ : IsClosedImmersion i)
        (hV : codim (Set.range i) + 1 = r) (g : (absoluteNormalization V).functionFieldˣ),
        c = subvarietyNormalizationPushforward p hp hn i hV
          (weilDivisorToCodimOneCycles (satisfiesConditionStar_absoluteNormalization p hp i)
            ((absoluteNormalization V).principalDivisor
              (satisfiesConditionStar_absoluteNormalization p hp i) g))} := by
  apply le_antisymm
  · rw [rationalEquivalenceSubgroup, AddSubgroup.closure_le]
    rintro c ⟨V, hVi, i, hi, hV, D, D', hDD', rfl⟩
    obtain ⟨g, hg⟩ := (Scheme.WeilDivisor.linearEquivalent_iff _ D D').1 hDD'
    apply AddSubgroup.subset_closure
    refine ⟨V, hVi, i, hi, hV, g, ?_⟩
    rw [← map_sub, ← map_sub, hg]
  · rw [AddSubgroup.closure_le]
    rintro c ⟨V, hVi, i, hi, hV, g, rfl⟩
    apply AddSubgroup.subset_closure
    refine ⟨V, hVi, i, hi, hV, (absoluteNormalization V).principalDivisor
      (satisfiesConditionStar_absoluteNormalization p hp i) g, 0, ?_,
      by rw [map_zero, map_zero, sub_zero]⟩
    exact (Scheme.WeilDivisor.linearEquivalent_iff _ _ _).2 ⟨g, sub_zero _⟩

end Hartshorne
