import Mathlib.FieldTheory.Finite.Extension
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure

/-!
# The finite-field extension tower

For a finite field `k`, we construct all finite extensions `𝔽_{q^r}` inside the single
algebraic closure `AlgebraicClosure k`.  The degree-`r` field is generated by the roots of
`X ^ (q ^ r) - X`.  Divisibility of degrees gives literal inclusions of intermediate fields,
and these fields form a directed family whose supremum is the whole algebraic closure.
-/

open Polynomial

namespace Hartshorne

universe u

noncomputable section

/-- The polynomial whose roots in an algebraic closure of `k` form `𝔽_{q^r}`. -/
def finiteFieldExtensionPolynomial (k : Type u) [Field k] [Finite k] (r : ℕ+) : k[X] :=
  X ^ (Nat.card k) ^ (r : ℕ) - X

/-- The canonical degree-`r` extension of a finite field `k`, realized inside the fixed
algebraic closure `AlgebraicClosure k`. -/
def finiteFieldExtension (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    IntermediateField k (AlgebraicClosure k) :=
  IntermediateField.adjoin k
    ((finiteFieldExtensionPolynomial k r).rootSet (AlgebraicClosure k))

private theorem finiteFieldExtensionPolynomial_splits
    (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    ((finiteFieldExtensionPolynomial k r).map
      (algebraMap k (AlgebraicClosure k))).Splits :=
  IsAlgClosed.splits _

noncomputable instance finiteFieldExtension_isSplittingField
    (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    IsSplittingField k (finiteFieldExtension k r) (finiteFieldExtensionPolynomial k r) :=
  IntermediateField.adjoin_rootSet_isSplittingField
    (finiteFieldExtensionPolynomial_splits k r)

noncomputable instance finiteFieldExtension_finiteDimensional
    (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    FiniteDimensional k (finiteFieldExtension k r) :=
  IsSplittingField.finiteDimensional _ (finiteFieldExtensionPolynomial k r)

noncomputable instance finiteFieldExtension_finite
    (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    Finite (finiteFieldExtension k r) :=
  Module.finite_of_finite k

/-- The extension `finiteFieldExtension k r` has degree `r` over `k`. -/
theorem finiteFieldExtension_finrank
    (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    Module.finrank k (finiteFieldExtension k r) = (r : ℕ) := by
  obtain ⟨p, hp⟩ := CharP.exists k
  let _ : CharP k p := hp
  let _ : Fact p.Prime := ⟨CharP.char_is_prime k p⟩
  let _ : NeZero (r : ℕ) := ⟨r.ne_zero⟩
  let _ : IsSplittingField k (FiniteField.Extension k p (r : ℕ))
      (finiteFieldExtensionPolynomial k r) := by
    change IsSplittingField k (FiniteField.Extension k p (r : ℕ))
      (X ^ Nat.card k ^ (r : ℕ) - X)
    infer_instance
  let e : finiteFieldExtension k r ≃ₐ[k] FiniteField.Extension k p (r : ℕ) :=
    (IsSplittingField.algEquiv _ (finiteFieldExtensionPolynomial k r)).trans
      (IsSplittingField.algEquiv _ (finiteFieldExtensionPolynomial k r)).symm
  exact e.toLinearEquiv.finrank_eq.trans (FiniteField.finrank_extension k p (r : ℕ))

/-- The extension `finiteFieldExtension k r` has exactly `(#k)^r` elements. -/
theorem finiteFieldExtension_natCard
    (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    Nat.card (finiteFieldExtension k r) = Nat.card k ^ (r : ℕ) := by
  obtain ⟨p, hp⟩ := CharP.exists k
  let _ : CharP k p := hp
  let _ : Fact p.Prime := ⟨CharP.char_is_prime k p⟩
  let _ : NeZero (r : ℕ) := ⟨r.ne_zero⟩
  let _ : IsSplittingField k (FiniteField.Extension k p (r : ℕ))
      (finiteFieldExtensionPolynomial k r) := by
    change IsSplittingField k (FiniteField.Extension k p (r : ℕ))
      (X ^ Nat.card k ^ (r : ℕ) - X)
    infer_instance
  let e : finiteFieldExtension k r ≃ₐ[k] FiniteField.Extension k p (r : ℕ) :=
    (IsSplittingField.algEquiv _ (finiteFieldExtensionPolynomial k r)).trans
      (IsSplittingField.algEquiv _ (finiteFieldExtensionPolynomial k r)).symm
  exact (Nat.card_congr e.toEquiv).trans (FiniteField.natCard_extension k p (r : ℕ))

private theorem finiteFieldExtensionPolynomial_ne_zero
    (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    finiteFieldExtensionPolynomial k r ≠ 0 := by
  let _ := Fintype.ofFinite k
  simpa [finiteFieldExtensionPolynomial, Nat.card_eq_fintype_card] using
    (FiniteField.X_pow_card_pow_sub_X_ne_zero k r.ne_zero Fintype.one_lt_card)

private theorem finiteFieldExtensionPolynomial_dvd
    (k : Type u) [Field k] [Finite k] {r s : ℕ+}
    (h : (r : ℕ) ∣ (s : ℕ)) :
    finiteFieldExtensionPolynomial k r ∣ finiteFieldExtensionPolynomial k s := by
  simpa [finiteFieldExtensionPolynomial] using
    (dvd_pow_pow_sub_self_of_dvd
      (R := k[X]) (r := X) (p := Nat.card k) h)

/-- If `r ∣ s`, the canonical copy of `𝔽_{q^r}` is contained in the canonical copy of
`𝔽_{q^s}` inside `AlgebraicClosure k`. -/
theorem finiteFieldExtension_mono_of_dvd
    (k : Type u) [Field k] [Finite k] {r s : ℕ+}
    (h : (r : ℕ) ∣ (s : ℕ)) :
    finiteFieldExtension k r ≤ finiteFieldExtension k s := by
  apply IntermediateField.adjoin.mono
  intro x hx
  rw [mem_rootSet_of_ne (finiteFieldExtensionPolynomial_ne_zero k s)]
  obtain ⟨g, hg⟩ := finiteFieldExtensionPolynomial_dvd k h
  simp [hg, aeval_eq_zero_of_mem_rootSet hx]

/-- The canonical inclusion `𝔽_{q^r} → 𝔽_{q^s}` when `r ∣ s`. -/
def finiteFieldExtensionHom
    (k : Type u) [Field k] [Finite k] {r s : ℕ+}
    (h : (r : ℕ) ∣ (s : ℕ)) :
    finiteFieldExtension k r →ₐ[k] finiteFieldExtension k s :=
  IntermediateField.inclusion (finiteFieldExtension_mono_of_dvd k h)

@[simp]
theorem finiteFieldExtensionHom_apply
    (k : Type u) [Field k] [Finite k] {r s : ℕ+}
    (h : (r : ℕ) ∣ (s : ℕ)) (x : finiteFieldExtension k r) :
    ((finiteFieldExtensionHom k h x : finiteFieldExtension k s) : AlgebraicClosure k) = x :=
  IntermediateField.coe_inclusion _ x

@[simp]
theorem finiteFieldExtensionHom_refl
    (k : Type u) [Field k] [Finite k] (r : ℕ+) :
    finiteFieldExtensionHom k (dvd_refl (r : ℕ)) =
      AlgHom.id k (finiteFieldExtension k r) := by
  ext x
  rfl

/-- Canonical inclusions in the finite-field tower compose coherently. -/
theorem finiteFieldExtensionHom_trans
    (k : Type u) [Field k] [Finite k] {r s t : ℕ+}
    (hrs : (r : ℕ) ∣ (s : ℕ)) (hst : (s : ℕ) ∣ (t : ℕ)) :
    finiteFieldExtensionHom k (dvd_trans hrs hst) =
      (finiteFieldExtensionHom k hst).comp (finiteFieldExtensionHom k hrs) := by
  let h₁ := finiteFieldExtension_mono_of_dvd k hrs
  let h₂ := finiteFieldExtension_mono_of_dvd k hst
  apply AlgHom.ext
  intro x
  exact (IntermediateField.inclusion_inclusion h₁ h₂ x).symm

/-- The canonical finite subfields form a directed family under inclusion. -/
theorem finiteFieldExtension_directed
    (k : Type u) [Field k] [Finite k] :
    Directed (· ≤ ·) (finiteFieldExtension k) := by
  intro r s
  refine ⟨r * s, ?_, ?_⟩
  · apply finiteFieldExtension_mono_of_dvd k
    simp
  · apply finiteFieldExtension_mono_of_dvd k
    simp

/-- The algebraic closure of a finite field is the filtered union of its canonical finite
subfields `𝔽_{q^r}`. -/
theorem iSup_finiteFieldExtension_eq_top
    (k : Type u) [Field k] [Finite k] :
    (⨆ r : ℕ+, finiteFieldExtension k r) = ⊤ := by
  apply top_unique
  intro x _
  have hx : IsIntegral k x := Algebra.IsIntegral.isIntegral x
  let r : ℕ+ := ⟨(minpoly k x).natDegree, minpoly.natDegree_pos hx⟩
  have hirr : Irreducible (minpoly k x) := minpoly.irreducible hx
  have hdvd : minpoly k x ∣ finiteFieldExtensionPolynomial k r := by
    exact (hirr.natDegree_dvd_iff_dvd_X_pow_card_pow_sub_X).mp (dvd_refl _)
  apply (le_iSup (finiteFieldExtension k) r)
  apply IntermediateField.subset_adjoin k
  rw [mem_rootSet_of_ne (finiteFieldExtensionPolynomial_ne_zero k r)]
  obtain ⟨g, hg⟩ := hdvd
  simp [hg, minpoly.aeval k x]

end

end Hartshorne
