import Hartshorne.Scheme.MorphismFromGeneratedLineBundle
import Hartshorne.Projective.Basic
import Mathlib.AlgebraicGeometry.Modules.Tilde

/-!
# Scheme-valued points of the projective line

Hartshorne, *Algebraic Geometry*, Appendix C.1 (pp. 449–450) counts the points of `ℙ¹` over a
finite field scheme-theoretically, as morphisms `Spec K ⟶ ℙ¹_k` over `Spec k`. This file
identifies these morphisms with the classical homogeneous-coordinate description.

For a field extension `k → K`:

* `Hartshorne.ProjectiveLinePoints.equivQuotient`: the `K`-valued points of `ℙ¹_k` over
  `Spec k` are in bijection with the one-dimensional quotients of `K²`, recorded as the
  subspaces `W ⊆ K²` with `dim (K² / W) = 1`. A morphism `φ` corresponds to the kernel of
  `(a₀, a₁) ↦ a₀ φ^* x₀ + a₁ φ^* x₁ ∈ Γ(Spec K, φ^* 𝒪(1))`.
* `Hartshorne.ProjectiveLinePoints.quotientEquivDualLine`: dualizing (taking the annihilator)
  turns a one-dimensional quotient of `V` into a line in `V^∨`.
* `Hartshorne.ProjectiveLinePoints.equivProjectiveSpace`: composing with the standard-basis
  identification `(K²)^∨ ≅ K²`, the points are the lines through the origin in `K²`, i.e.
  the classical projective line `ℙ¹(K)`. `equivProjectiveSpace_eq_mk` says the point is
  `[c₀ : c₁]` when `φ^* xᵢ = cᵢ t`.
* `Hartshorne.ProjectiveLinePoints.equivProjectiveSpace_map`: the identification is natural in
  `K`: for a `k`-embedding `ι : K → K'`, composing with `Spec K' ⟶ Spec K` corresponds to
  `[c₀ : c₁] ↦ [ι c₀ : ι c₁]`.

## Proof

This is Hartshorne II, Theorem 7.1 over the base `Spec k`, with `X = Spec K` and `n = 1`. On
`Spec K` (a single point), an invertible sheaf generated by global sections `s₀, s₁` has one
of the `sᵢ` as a global trivializing section, so `Γ(Spec K, L)` is a one-dimensional
`K`-vector space and the map `K² → Γ(Spec K, L)`, `a ↦ a₀ s₀ + a₁ s₁`, is surjective. Two
morphisms with the same kernel have isomorphic pulled-back data, so they agree by the
uniqueness in Theorem 7.1(b). Conversely a codimension-one subspace `W` is the kernel of a
functional `f : K² → K`, and the structure sheaf with the sections `f(e₀), f(e₁)` gives,
by Theorem 7.1(b), a morphism with kernel `W`. For naturality, on `Spec K` the morphism
lands in a chart `D₊(x_k)` and `φ^* x_l = φ^#(x_l / x_k) · φ^* x_k`; these ratios are
compatible with composition.
-/

noncomputable section

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry Module

namespace Hartshorne

/-- A family of global sections containing a global trivializing section generates the sheaf. -/
theorem isGeneratedBySections_of_isTrivializingSection {X : Scheme.{u}} {L : X.Modules}
    {ι : Type u} {s : ι → Γ(L, ⊤)} (i : ι) (hi : IsTrivializingSection L ⊤ (s i)) :
    L.IsGeneratedBySections s := by
  intro x
  refine top_unique fun z _ => ?_
  obtain ⟨b, rfl⟩ := hi.exists_smul_germ_eq (show x ∈ (⊤ : X.Opens) from trivial) z
  exact Submodule.smul_mem _ b (Submodule.subset_span ⟨i, rfl⟩)

namespace ProjectiveLinePoints

variable {K : Type u} [Field K]

/-! ### Modules on the spectrum of a field -/

/-- Sections of a module on `Spec K` form a `K`-module (Mathlib's `Γ(Spec K, 𝒪)`-compatible
structure, with `K` written as a type rather than as `CommRingCat.of K`). -/
instance instModuleSections {M : (Spec (CommRingCat.of K)).Modules}
    {U : (Spec (CommRingCat.of K)).Opens} : Module K Γ(M, U) :=
  letI f : ∀ (R : CommRingCat.{u}) (M : (Spec R).Modules) (U : (Spec R).Opens),
      Module R Γ(M, U) := fun _ _ _ => inferInstance
  f (CommRingCat.of K) M U

/-- An open subset of `Spec K` containing a point is everything. -/
theorem eq_top_of_mem {U : (Spec (CommRingCat.of K)).Opens} {x : Spec (CommRingCat.of K)}
    (hx : x ∈ U) : U = ⊤ :=
  eq_top_iff.mpr fun y _ => (Subsingleton.elim (α := PrimeSpectrum K) x y) ▸ hx

/-- The `K`-module structure on global sections over `Spec K` is scalar multiplication through
`K ≅ Γ(Spec K, 𝒪)`. -/
theorem smul_eq_ΓSpecIso_inv_smul {M : (Spec (CommRingCat.of K)).Modules} (a : K)
    (t : Γ(M, ⊤)) : a • t = (Scheme.ΓSpecIso (CommRingCat.of K)).inv a • t := by
  rw [show a • t = (Spec (CommRingCat.of K)).presheaf.map (⊤ : (Spec (CommRingCat.of K)).Opens).leTop.op
      ((Scheme.ΓSpecIso (CommRingCat.of K)).inv a) • t from rfl]
  rw [show (⊤ : (Spec (CommRingCat.of K)).Opens).leTop.op = 𝟙 _ from rfl,
    CategoryTheory.Functor.map_id]
  rfl

/-- The global-sections map of a morphism of modules on `Spec K`, as a `K`-linear map. -/
def appTopLinear {M N : (Spec (CommRingCat.of K)).Modules} (α : M ⟶ N) :
    Γ(M, ⊤) →ₗ[K] Γ(N, ⊤) where
  toFun := α.app ⊤
  map_add' x y := map_add (α.app ⊤).hom x y
  map_smul' a x := by
    rw [RingHom.id_apply]
    exact Scheme.Modules.Hom.app_smul α ((Spec (CommRingCat.of K)).presheaf.map
      (⊤ : (Spec (CommRingCat.of K)).Opens).leTop.op ((Scheme.ΓSpecIso (CommRingCat.of K)).inv a)) x

@[simp]
theorem appTopLinear_apply {M N : (Spec (CommRingCat.of K)).Modules} (α : M ⟶ N)
    (x : Γ(M, ⊤)) : appTopLinear α x = α.app ⊤ x :=
  rfl

/-- A global trivializing section `e` gives a `K`-linear bijection `K → Γ(L, ⊤)`. -/
theorem bijective_smul_of_isTrivializingSection {L : (Spec (CommRingCat.of K)).Modules}
    {e : Γ(L, ⊤)} (he : IsTrivializingSection L ⊤ e) :
    Function.Bijective (fun a : K => a • e) := by
  have h1 := he ⊤ le_rfl
  have h2 : (fun a : K => a • e) =
      (fun a : Γ(Spec (CommRingCat.of K), ⊤) =>
        a • L.presheaf.map (homOfLE (le_rfl : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ ⊤)).op e) ∘
      (fun a : K => (Scheme.ΓSpecIso (CommRingCat.of K)).inv a) := by
    funext a
    rw [Function.comp_apply, smul_eq_ΓSpecIso_inv_smul,
      show (homOfLE (le_rfl : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ ⊤)).op = 𝟙 _ from rfl,
      CategoryTheory.Functor.map_id]
    rfl
  rw [h2]
  exact h1.comp (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of K)).inv)

/-- A nonzero `K`-multiple of a global trivializing section is trivializing. -/
theorem _root_.Hartshorne.IsTrivializingSection.smul_of_ne_zero {L : (Spec (CommRingCat.of K)).Modules}
    {e : Γ(L, ⊤)} (he : IsTrivializingSection L ⊤ e) {c : K} (hc : c ≠ 0) :
    IsTrivializingSection L ⊤ (c • e) := by
  rw [smul_eq_ΓSpecIso_inv_smul]
  exact he.unit_smul ((Ne.isUnit hc).map (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom)

/-- On `Spec K`, global sections generating an invertible sheaf include a global trivializing
section. -/
theorem exists_isTrivializingSection_top {L : (Spec (CommRingCat.of K)).Modules}
    (hL : L.IsInvertible) {ι : Type u} {s : ι → Γ(L, ⊤)} (hs : L.IsGeneratedBySections s) :
    ∃ i, IsTrivializingSection L ⊤ (s i) := by
  let x : Spec (CommRingCat.of K) := (default : PrimeSpectrum K)
  obtain ⟨i, hi⟩ := exists_mem_nonvanishingLocus_of_isGeneratedBySections hL hs x
  have htop : nonvanishingLocusOpens hL (s i) = ⊤ := eq_top_of_mem (x := x) hi
  have key : ∀ U : (Spec (CommRingCat.of K)).Opens, U = ⊤ →
      IsTrivializingSection L U (L.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (s i)) →
        IsTrivializingSection L ⊤ (s i) := by
    rintro U rfl h
    rwa [show (homOfLE (le_top : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ ⊤)).op = 𝟙 _ from rfl,
      CategoryTheory.Functor.map_id] at h
  exact ⟨i, key _ htop (isTrivializingSection_nonvanishingLocusOpens hL (s i))⟩

/-! ### The kernel attached to a point -/

variable {Y : Scheme.{u}}

/-- For `φ : Spec K ⟶ ℙ¹_Y`, the `K`-linear map `K² → Γ(Spec K, φ^* 𝒪(1))`,
`(a₀, a₁) ↦ a₀ φ^* x₀ + a₁ φ^* x₁`. -/
def coordinateMap (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y) :
    (Fin 2 → K) →ₗ[K]
      Γ((Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf 1 Y 1), ⊤) :=
  Fintype.linearCombination K (fun i => pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y i))

/-- The subspace of `K²` attached to `φ : Spec K ⟶ ℙ¹_Y`: the linear relations
`a₀ φ^* x₀ + a₁ φ^* x₁ = 0` among the pulled-back coordinates. -/
def kernel (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y) :
    Submodule K (Fin 2 → K) :=
  LinearMap.ker (coordinateMap φ)

theorem mem_kernel_iff (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y)
    (a : Fin 2 → K) :
    a ∈ kernel φ ↔ a 0 • pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y 0) +
      a 1 • pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y 1) = 0 := by
  rw [kernel, LinearMap.mem_ker, coordinateMap, Fintype.linearCombination_apply, Fin.sum_univ_two]

theorem coordinateMap_single (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y)
    (i : Fin 2) (a : K) :
    coordinateMap φ (Pi.single i a) =
      a • pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y i) := by
  rw [coordinateMap, Fintype.linearCombination_apply_single]

theorem exists_isTrivializingSection_coordinate
    (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y) :
    ∃ i : Fin 2, IsTrivializingSection _ ⊤
      (pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y i)) := by
  obtain ⟨⟨i⟩, hi⟩ := exists_isTrivializingSection_top
    (isInvertible_pullback_projectiveSpaceTwistingSheaf φ)
    (isGeneratedBySections_pullback_projectiveSpaceCoordinate φ)
  exact ⟨i, hi⟩

theorem coordinateMap_surjective
    (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y) :
    Function.Surjective (coordinateMap φ) := by
  obtain ⟨i, hi⟩ := exists_isTrivializingSection_coordinate φ
  intro t
  obtain ⟨a, rfl⟩ := (bijective_smul_of_isTrivializingSection hi).2 t
  exact ⟨Pi.single i a, coordinateMap_single φ i a⟩

/-- The pulled-back coordinates span a one-dimensional quotient of `K²`. -/
theorem finrank_quotient_kernel (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y) :
    finrank K ((Fin 2 → K) ⧸ kernel φ) = 1 := by
  obtain ⟨i, hi⟩ := exists_isTrivializingSection_coordinate φ
  let f : K ≃ₗ[K] Γ((Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf 1 Y 1), ⊤) :=
    LinearEquiv.ofBijective (LinearMap.toSpanSingleton K _ _)
      (bijective_smul_of_isTrivializingSection hi)
  rw [kernel, ((coordinateMap φ).quotKerEquivOfSurjective (coordinateMap_surjective φ)).finrank_eq,
    ← f.finrank_eq, finrank_self]

/-! ### Points with the same kernel agree -/

/-- The global-sections map of an isomorphism of modules is injective. -/
theorem app_top_injective {X : Scheme.{u}} {M N : X.Modules} (e : M ≅ N) :
    Function.Injective (e.hom.app ⊤) := by
  refine Function.LeftInverse.injective (g := e.inv.app ⊤) fun x => ?_
  rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, e.hom_inv_id,
    Scheme.Modules.Hom.id_app]
  rfl

/-- Two `Y`-morphisms `Spec K ⟶ ℙ¹_Y` with the same kernel are equal. -/
theorem eq_of_kernel_eq {φ ψ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y}
    (hp : φ ≫ projectiveSpaceOverSchemeProjection 1 Y =
      ψ ≫ projectiveSpaceOverSchemeProjection 1 Y)
    (hk : kernel φ = kernel ψ) : φ = ψ := by
  obtain ⟨i, hi⟩ := exists_isTrivializingSection_coordinate φ
  obtain ⟨j, hj⟩ := exists_isTrivializingSection_coordinate ψ
  have hi' : IsTrivializingSection _ ⊤
      (pullbackGlobalSection ψ (projectiveSpaceCoordinate 1 Y i)) := by
    obtain ⟨c, hc⟩ := (bijective_smul_of_isTrivializingSection hj).2
      (pullbackGlobalSection ψ (projectiveSpaceCoordinate 1 Y i))
    change c • _ = _ at hc
    have hc0 : c ≠ 0 := by
      rintro rfl
      have hmem : Pi.single i 1 ∈ kernel φ := by
        rw [hk, kernel, LinearMap.mem_ker, coordinateMap_single, one_smul, ← hc, zero_smul]
      rw [kernel, LinearMap.mem_ker, coordinateMap_single] at hmem
      exact one_ne_zero ((bijective_smul_of_isTrivializingSection hi).1
        (hmem.trans (zero_smul K _).symm))
    rw [← hc]
    exact hj.smul_of_ne_zero hc0
  have σ : PUnit.{u + 1} ≃ ULift.{u} (Fin 1) := Equiv.ofUnique _ _
  obtain ⟨e, he⟩ : ∃ e : (Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf 1 Y 1) ≅
      (Scheme.Modules.pullback ψ).obj (projectiveSpaceTwistingSheaf 1 Y 1),
      Scheme.Modules.Hom.app e.hom ⊤ (pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y i)) =
        pullbackGlobalSection ψ (projectiveSpaceCoordinate 1 Y i) := by
    obtain ⟨e, he⟩ := Ringed.exists_iso_of_frames (R := (Spec (CommRingCat.of K)).sheaf)
      (fun _ : PUnit.{u + 1} => (⊤ : (Spec (CommRingCat.of K)).Opens))
      (le_iSup_of_le PUnit.unit le_rfl)
      (fun _ => pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y i))
      (fun _ => pullbackGlobalSection ψ (projectiveSpaceCoordinate 1 Y i))
      (fun _ => (isLocalFrame_of_isTrivializingSection hi).reindex σ)
      (fun _ => (isLocalFrame_of_isTrivializingSection hi').reindex σ)
      (fun _ _ => ⟨1, by rw [one_smul], by rw [one_smul]⟩)
    exact ⟨e, he PUnit.unit⟩
  have he' : ∀ l : Fin 2, Scheme.Modules.Hom.app e.hom ⊤
      (pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y l)) =
      pullbackGlobalSection ψ (projectiveSpaceCoordinate 1 Y l) := by
    intro l
    obtain ⟨a, ha⟩ := (bijective_smul_of_isTrivializingSection hi).2
      (pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y l))
    change a • _ = _ at ha
    have hmem : Pi.single l 1 - Pi.single i a ∈ kernel φ := by
      rw [kernel, LinearMap.mem_ker, map_sub, coordinateMap_single, coordinateMap_single,
        one_smul, ← ha, sub_self]
    rw [hk, kernel, LinearMap.mem_ker, map_sub, coordinateMap_single, coordinateMap_single,
      one_smul, sub_eq_zero] at hmem
    rw [← ha, hmem]
    change appTopLinear e.hom (a • _) = _
    rw [map_smul]
    exact congrArg (a • ·) he
  exact (existsUnique_morphism_of_isGeneratedBySections
    (ψ ≫ projectiveSpaceOverSchemeProjection 1 Y)
    (isInvertible_pullback_projectiveSpaceTwistingSheaf ψ)
    (fun l => pullbackGlobalSection ψ (projectiveSpaceCoordinate 1 Y l))
    (isGeneratedBySections_pullback_projectiveSpaceCoordinate ψ)).unique ⟨hp, e, he'⟩
      ⟨rfl, Iso.refl _, fun _ => rfl⟩

/-! ### Every codimension-one subspace is a kernel -/

/-- Every subspace `W ⊆ K²` with one-dimensional quotient is the kernel of a `Y`-morphism
`Spec K ⟶ ℙ¹_Y`, for any structure morphism `Spec K ⟶ Y`. -/
theorem exists_kernel_eq (p : Spec (CommRingCat.of K) ⟶ Y) (W : Submodule K (Fin 2 → K))
    (hW : finrank K ((Fin 2 → K) ⧸ W) = 1) :
    ∃ φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y,
      φ ≫ projectiveSpaceOverSchemeProjection 1 Y = p ∧ kernel φ = W := by
  let g : ((Fin 2 → K) ⧸ W) ≃ₗ[K] K := LinearEquiv.ofFinrankEq _ _ (by rw [hW, finrank_self])
  let f : (Fin 2 → K) →ₗ[K] K := g.toLinearMap ∘ₗ W.mkQ
  have hf : LinearMap.ker f = W := by
    rw [LinearEquiv.ker_comp, Submodule.ker_mkQ]
  let O : (Spec (CommRingCat.of K)).Modules := SheafOfModules.unit _
  let one : Γ(O, ⊤) := (1 : Γ(Spec (CommRingCat.of K), ⊤))
  have h1 : IsTrivializingSection O ⊤ one :=
    IsTrivializingSection.of_isLocalFrame
      (Ringed.structureModule_isLocalFrame (R := (Spec (CommRingCat.of K)).sheaf))
  have hO : O.IsInvertible :=
    (Scheme.Modules.isInvertible_iff_ringed O).mpr Ringed.structureModule_isInvertible
  let t : Fin 2 → Γ(O, ⊤) := fun l => f (Pi.single l 1) • one
  have hft : ∃ l, f (Pi.single l 1) ≠ 0 := by
    by_contra h
    push Not at h
    have hf0 : f = 0 := by
      ext l
      simpa using h l
    have hWtop : W = ⊤ := by rw [← hf, hf0, LinearMap.ker_zero]
    rw [hWtop, finrank_zero_of_subsingleton] at hW
    exact zero_ne_one hW
  obtain ⟨l₀, hl₀⟩ := hft
  have hgen : O.IsGeneratedBySections (fun l : ULift.{u} (Fin (1 + 1)) => t l.down) :=
    isGeneratedBySections_of_isTrivializingSection (s := fun l : ULift.{u} (Fin (1 + 1)) => t l.down)
      ⟨l₀⟩ (h1.smul_of_ne_zero hl₀)
  obtain ⟨φ, ⟨hφ, e, he⟩, -⟩ := existsUnique_morphism_of_isGeneratedBySections p hO t hgen
  refine ⟨φ, hφ, ?_⟩
  have hlin : appTopLinear e.hom ∘ₗ coordinateMap φ =
      LinearMap.toSpanSingleton K _ one ∘ₗ f := by
    ext l
    simp only [LinearMap.comp_apply, LinearMap.single_apply, coordinateMap_single, one_smul,
      appTopLinear_apply, he,
      LinearMap.toSpanSingleton_apply, t]
  ext v
  rw [kernel, LinearMap.mem_ker, ← hf, LinearMap.mem_ker,
    ← map_eq_zero_iff (appTopLinear e.hom) (app_top_injective e), ← LinearMap.comp_apply, hlin,
    LinearMap.comp_apply, LinearMap.toSpanSingleton_apply, ← zero_smul K one,
    (bijective_smul_of_isTrivializingSection h1).1.eq_iff]

/-! ### The equivalences -/

end ProjectiveLinePoints

namespace ProjectiveLinePoints

section Equivalences

variable (k K : Type u) [Field k] [Field K] [Algebra k K]

/-- The `K`-valued points of `ℙ¹_k` over `Spec k`: morphisms `Spec K ⟶ ℙ¹_k` whose composite
with the structure morphism `ℙ¹_k ⟶ Spec k` is `Spec K ⟶ Spec k`. -/
abbrev Point : Type u :=
  {φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 (Spec (CommRingCat.of k)) //
    φ ≫ projectiveSpaceOverSchemeProjection 1 (Spec (CommRingCat.of k)) =
      Spec.map (CommRingCat.ofHom (algebraMap k K))}

/-- **`K`-points of `ℙ¹_k` are one-dimensional quotients of `K²`.** For a field extension
`k → K`, a morphism `φ : Spec K ⟶ ℙ¹_k` over `Spec k` corresponds to the quotient
`K² ↠ Γ(Spec K, φ^* 𝒪(1))`, `(a₀, a₁) ↦ a₀ φ^* x₀ + a₁ φ^* x₁`, recorded by its kernel; this
is a bijection onto the subspaces of `K²` with one-dimensional quotient. -/
def equivQuotient :
    Point k K ≃ {W : Submodule K (Fin 2 → K) // finrank K ((Fin 2 → K) ⧸ W) = 1} :=
  Equiv.ofBijective (fun φ => ⟨kernel φ.1, finrank_quotient_kernel φ.1⟩)
    ⟨fun φ ψ h => Subtype.ext (eq_of_kernel_eq (φ.2.trans ψ.2.symm) (congrArg Subtype.val h)),
      fun W => by
        obtain ⟨φ, hφ, hW⟩ := exists_kernel_eq _ W.1 W.2
        exact ⟨⟨φ, hφ⟩, Subtype.ext hW⟩⟩

@[simp]
theorem equivQuotient_apply_coe {k K : Type u} [Field k] [Field K] [Algebra k K]
    (φ : Point k K) :
    (equivQuotient k K φ : Submodule K (Fin 2 → K)) = kernel φ.1 :=
  rfl

/-- **Dualizing a one-dimensional quotient gives a line in the dual.** For a finite-dimensional
`K`-vector space `V`, `W ↦ (V / W)^∨ = W^⊥ ⊆ V^∨` is a bijection from subspaces with
one-dimensional quotient to lines in `V^∨`. -/
def quotientEquivDualLine (V : Type*) [AddCommGroup V] [Module K V] [FiniteDimensional K V] :
    {W : Submodule K V // finrank K (V ⧸ W) = 1} ≃
      {ℓ : Submodule K (Module.Dual K V) // finrank K ℓ = 1} where
  toFun W := ⟨W.1.dualAnnihilator, by rw [← (Subspace.quotEquivAnnihilator W.1).finrank_eq, W.2]⟩
  invFun ℓ := ⟨ℓ.1.dualCoannihilator, by
    rw [(Subspace.quotEquivAnnihilator ℓ.1.dualCoannihilator).finrank_eq,
      Subspace.dualCoannihilator_dualAnnihilator_eq, ℓ.2]⟩
  left_inv W := Subtype.ext Subspace.dualAnnihilator_dualCoannihilator_eq
  right_inv ℓ := Subtype.ext Subspace.dualCoannihilator_dualAnnihilator_eq

/-- A linear isomorphism `V ≃ V'` carries lines in `V` to lines in `V'`. -/
def linesCongr {V V' : Type*} [AddCommGroup V] [Module K V] [AddCommGroup V'] [Module K V']
    (e : V ≃ₗ[K] V') :
    {ℓ : Submodule K V // finrank K ℓ = 1} ≃ {ℓ : Submodule K V' // finrank K ℓ = 1} where
  toFun ℓ := ⟨ℓ.1.map e.toLinearMap, by rw [LinearEquiv.finrank_map_eq, ℓ.2]⟩
  invFun ℓ := ⟨ℓ.1.map e.symm.toLinearMap, by rw [LinearEquiv.finrank_map_eq, ℓ.2]⟩
  left_inv ℓ := Subtype.ext (by simp [← Submodule.map_comp])
  right_inv ℓ := Subtype.ext (by simp [← Submodule.map_comp])

/-- **`K`-points of `ℙ¹_k` are the lines through the origin in `K²`.** Composing
`equivQuotient` with dualization and the standard-basis identification `(K²)^∨ ≅ K²` gives a
bijection between morphisms `Spec K ⟶ ℙ¹_k` over `Spec k` and the classical projective line
`ℙ¹(K)` of lines through the origin in `K²`. -/
def equivProjectiveSpace : Point k K ≃ ProjectiveSpace K (Fin 2) :=
  (equivQuotient k K).trans <| (quotientEquivDualLine K (Fin 2 → K)).trans <|
    (linesCongr K (Pi.basisFun K (Fin 2)).toDualEquiv.symm).trans
      (Projectivization.equivSubmodule K (Fin 2 → K)).symm

/-- **The point in homogeneous coordinates.** If the pulled-back coordinates of
`φ : Spec K ⟶ ℙ¹_k` are `φ^* xᵢ = cᵢ t` for a global section `t` of `φ^* 𝒪(1)` and
`c = (c₀, c₁) ≠ 0`, then `φ` corresponds to the point `[c₀ : c₁]` of `ℙ¹(K)`. -/
theorem equivProjectiveSpace_eq_mk {k K : Type u} [Field k] [Field K] [Algebra k K]
    (φ : Point k K)
    (t : Γ((Scheme.Modules.pullback φ.1).obj
      (projectiveSpaceTwistingSheaf 1 (Spec (CommRingCat.of k)) 1), ⊤))
    (c : Fin 2 → K) (hc : c ≠ 0)
    (h : ∀ i, pullbackGlobalSection φ.1 (projectiveSpaceCoordinate 1 _ i) = c i • t) :
    equivProjectiveSpace k K φ = Projectivization.mk K c hc := by
  obtain ⟨i, hi⟩ := exists_isTrivializingSection_coordinate φ.1
  have ht : t ≠ 0 := by
    rintro rfl
    refine one_ne_zero ((bijective_smul_of_isTrivializingSection hi).1 (a₁ := 1) (a₂ := 0) ?_)
    change (1 : K) • _ = (0 : K) • _
    rw [h, smul_zero, smul_zero, smul_zero]
  set f : Module.Dual K (Fin 2 → K) := (Pi.basisFun K (Fin 2)).toDual c with hf
  have hfa : ∀ a : Fin 2 → K, f a = a 0 * c 0 + a 1 * c 1 := by
    intro a
    conv_lhs => rw [← (Pi.basisFun K (Fin 2)).sum_repr a]
    simp only [hf, Fin.sum_univ_two, map_add, map_smul, Basis.toDual_apply_left,
      Pi.basisFun_repr, smul_eq_mul]
  have hker : kernel φ.1 = (K ∙ f).dualCoannihilator := by
    ext a
    rw [← SetLike.mem_coe (p := (K ∙ f).dualCoannihilator), Submodule.coe_dualCoannihilator_span]
    simp only [Set.mem_singleton_iff, forall_eq, Set.mem_ofPred_eq]
    rw [mem_kernel_iff, h, h, smul_smul, smul_smul, ← add_smul, smul_eq_zero, or_iff_left ht, hfa]
  apply (Projectivization.equivSubmodule K (Fin 2 → K)).injective
  rw [equivProjectiveSpace, Equiv.trans_apply, Equiv.trans_apply, Equiv.trans_apply,
    Equiv.apply_symm_apply]
  apply Subtype.ext
  change Submodule.map (Pi.basisFun K (Fin 2)).toDualEquiv.symm.toLinearMap
    (kernel φ.1).dualAnnihilator = (Projectivization.mk K c hc).submodule
  rw [Projectivization.submodule_mk, hker, Subspace.dualCoannihilator_dualAnnihilator_eq]
  refine (Submodule.map_symm_eq_iff _).mpr ?_
  rw [Submodule.map_span, Set.image_singleton]
  rfl

end Equivalences

/-! ### Naturality in the field -/

section Naturality

variable {K : Type u} [Field K]

/-- For `T : Spec K ⟶ ℙ¹_ℤ` landing in the chart `D₊(x_k)`, the coordinate ratio
`T^#(x_l / x_k) ∈ K`. -/
def chartCoordinate (T : Spec (CommRingCat.of K) ⟶ projInt.{u} 1) (k l : Fin 2)
    (h : ⊤ ≤ T ⁻¹ᵁ chartInt 1 k) : K :=
  (Scheme.ΓSpecIso (CommRingCat.of K)).hom (T.appLE (chartInt 1 k) ⊤ h (ratioInt 1 k l))

theorem chartCoordinate_congr {T₁ T₂ : Spec (CommRingCat.of K) ⟶ projInt.{u} 1} (hT : T₁ = T₂)
    (k l : Fin 2) (h₁ : ⊤ ≤ T₁ ⁻¹ᵁ chartInt 1 k) (h₂ : ⊤ ≤ T₂ ⁻¹ᵁ chartInt 1 k) :
    chartCoordinate T₁ k l h₁ = chartCoordinate T₂ k l h₂ := by
  subst hT
  rfl

/-- Chart coordinates are compatible with field homomorphisms. -/
theorem chartCoordinate_comp {K' : Type u} [Field K'] (ι : K →+* K')
    (T : Spec (CommRingCat.of K) ⟶ projInt.{u} 1) (k l : Fin 2) (h : ⊤ ≤ T ⁻¹ᵁ chartInt 1 k)
    (h' : ⊤ ≤ (Spec.map (CommRingCat.ofHom ι) ≫ T) ⁻¹ᵁ chartInt 1 k) :
    chartCoordinate (Spec.map (CommRingCat.ofHom ι) ≫ T) k l h' = ι (chartCoordinate T k l h) := by
  have key : (Spec.map (CommRingCat.ofHom ι) ≫ T).appLE (chartInt 1 k) ⊤ h' ≫
      (Scheme.ΓSpecIso (CommRingCat.of K')).hom =
      T.appLE (chartInt 1 k) ⊤ h ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫
        CommRingCat.ofHom ι := by
    rw [← Scheme.ΓSpecIso_naturality, ← Category.assoc]
    congr 1
  exact ConcreteCategory.congr_hom key (ratioInt 1 k l)

variable {Y : Scheme.{u}}

/-- On `Spec K`, every point lies in one chart preimage, which is then everything. -/
theorem exists_top_le_chartPreimage
    (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y) :
    ∃ k, ⊤ ≤ chartPreimage φ k := by
  obtain ⟨k, hk⟩ := exists_mem_chartPreimage φ ((default : PrimeSpectrum K) :
    Spec (CommRingCat.of K))
  exact ⟨k, (eq_top_of_mem hk).ge⟩

/-- On the chart preimage, `φ^* x_l = T^#(x_l / x_k) · φ^* x_k`, written over `K`. -/
theorem pullbackGlobalSection_eq_chartCoordinate_smul
    (φ : Spec (CommRingCat.of K) ⟶ projectiveSpaceOverScheme 1 Y) (k l : Fin 2)
    (h : ⊤ ≤ chartPreimage φ k) :
    pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y l) =
      chartCoordinate (toIntMap φ) k l h •
        pullbackGlobalSection φ (projectiveSpaceCoordinate 1 Y k) := by
  have h1 := congrArg ((pullbackTwist φ).presheaf.map (homOfLE h).op)
    (restrict_pullbackGlobalSection_eq_smul φ k l)
  rw [Scheme.Modules.map_map_homOfLE, Scheme.Modules.map_smul, Scheme.Modules.map_map_homOfLE,
    show (homOfLE (h.trans le_top : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ ⊤)).op = 𝟙 _ from rfl,
    CategoryTheory.Functor.map_id] at h1
  rw [smul_eq_ΓSpecIso_inv_smul, chartCoordinate, ← ConcreteCategory.comp_apply, Iso.hom_inv_id]
  exact h1

/-- Base change of homogeneous coordinates along a field homomorphism `ι : K → K'`,
`(c₀, c₁) ↦ (ι c₀, ι c₁)`, as an `ι`-semilinear map `K² → K'²`. -/
def coordinateBaseChange {K' : Type u} [Field K'] (ι : K →+* K') :
    (Fin 2 → K) →ₛₗ[ι] (Fin 2 → K') where
  toFun c i := ι (c i)
  map_add' _ _ := funext fun _ => map_add ι _ _
  map_smul' _ _ := funext fun _ => map_mul ι _ _

theorem coordinateBaseChange_injective {K' : Type u} [Field K'] (ι : K →+* K') :
    Function.Injective (coordinateBaseChange ι) :=
  fun _ _ h => funext fun i => ι.injective (congrFun h i)

end Naturality

namespace Point

variable {k K K' : Type u} [Field k] [Field K] [Field K'] [Algebra k K] [Algebra k K']

/-- A `k`-embedding `K → K'` sends `K`-points to `K'`-points, by composing with
`Spec K' ⟶ Spec K`. -/
def map (ι : K →ₐ[k] K') (φ : Point k K) : Point k K' :=
  ⟨Spec.map (CommRingCat.ofHom (ι : K →+* K')) ≫ φ.1, by
    rw [Category.assoc, φ.2, ← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]⟩

end Point

/-- **Naturality in `K`.** For a `k`-embedding `ι : K → K'`, the identification of
`K`-points of `ℙ¹_k` with `ℙ¹(K)` is compatible with `ι`: the point `Spec K' ⟶ Spec K ⟶ ℙ¹_k`
corresponds to the image of `[c₀ : c₁]` under `[c₀ : c₁] ↦ [ι c₀ : ι c₁]`. -/
theorem equivProjectiveSpace_map {k K K' : Type u} [Field k] [Field K] [Field K'] [Algebra k K]
    [Algebra k K'] (ι : K →ₐ[k] K') (φ : Point k K) :
    equivProjectiveSpace k K' (Point.map ι φ) =
      Projectivization.map (coordinateBaseChange (ι : K →+* K'))
        (coordinateBaseChange_injective _) (equivProjectiveSpace k K φ) := by
  obtain ⟨j, hj⟩ := exists_isTrivializingSection_coordinate φ.1
  obtain ⟨k₀, h⟩ := exists_top_le_chartPreimage φ.1
  set c : Fin 2 → K := fun l => chartCoordinate (toIntMap φ.1) k₀ l h with hc_def
  have hcs : ∀ l, pullbackGlobalSection φ.1 (projectiveSpaceCoordinate 1 _ l) =
      c l • pullbackGlobalSection φ.1 (projectiveSpaceCoordinate 1 _ k₀) :=
    fun l => pullbackGlobalSection_eq_chartCoordinate_smul φ.1 k₀ l h
  have hc : c ≠ 0 := by
    intro hc0
    refine one_ne_zero ((bijective_smul_of_isTrivializingSection hj).1 (a₁ := 1) (a₂ := 0) ?_)
    change (1 : K) • _ = (0 : K) • _
    rw [hcs j, hc0, Pi.zero_apply, zero_smul, smul_zero, zero_smul]
  rw [equivProjectiveSpace_eq_mk φ _ c hc hcs, Projectivization.map_mk]
  have h' : ⊤ ≤ chartPreimage (Point.map ι φ).1 k₀ := fun x _ => h (Set.mem_univ
    ((Spec.map (CommRingCat.ofHom (ι : K →+* K'))).base x))
  refine equivProjectiveSpace_eq_mk _
    (pullbackGlobalSection (Point.map ι φ).1 (projectiveSpaceCoordinate 1 _ k₀)) _ _ fun l => ?_
  rw [pullbackGlobalSection_eq_chartCoordinate_smul _ k₀ l h']
  congr 1
  refine (chartCoordinate_congr (Category.assoc _ _ _) k₀ l h' ?_).trans
    (chartCoordinate_comp (ι : K →+* K') _ k₀ l h _)
  exact h'

end ProjectiveLinePoints

end Hartshorne
