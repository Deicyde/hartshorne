/-!
# Vector bundles on curves are successive extensions of line bundles

Hartshorne, *Algebraic Geometry*, V, Exercise 2.3(a) (pp. 383–384).

Let `C` be a nonsingular projective curve over an algebraically closed field `k` and `E` a
locally free sheaf of rank `r` on `C`. Then there is a filtration

`0 = E_0 ⊆ E_1 ⊆ ⋯ ⊆ E_r = E`

by locally free subsheaves (`E_i` of rank `i`) such that every quotient `E_i / E_{i-1}` is
invertible (`exists_lineBundleFiltration`). Regularity of `C` is not needed: the statement holds
for every integral projective `k`-scheme of dimension one
(`exists_lineBundleFiltration_of_projective`).

The filtration is a sequence `Fil : ℕ → Subobject E` with `Fil 0 = ⊥`, `Fil r = ⊤`, monotone,
with `Fil i` locally free of rank `i` for `i ≤ r`, and with the cokernel of `Fil i ⟶ Fil (i+1)`
invertible for `i < r`.

## Proof

Induction on `r`; a sheaf of rank `0` is zero. For `r ≥ 1` it suffices to find a short exact
sequence `0 → A → E → E' → 0` with `A` invertible and `E'` locally free of rank `r - 1`: given a
filtration `(E'_j)` of `E'`, the preimages `E_{j+1} = p⁻¹(E'_j)` together with `E_0 = 0` form a
filtration of `E`. Indeed `0 → A → p⁻¹(E'_j) → E'_j → 0` is exact
(`shortExact_pullback_subobject`), so `p⁻¹(E'_j)` is locally free of rank `j + 1` (an extension
of locally free sheaves, `isLocallyFreeOfRank_of_shortExact`), and pulling back along an
epimorphism does not change successive quotients (`isIso_cokernelMap_ofLE_pullback_subobject`).

For `r = 1` take `A = E`, `E' = 0`. For `r ≥ 2` choose a very ample invertible sheaf `L` (the
pullback of `𝒪(1)` along a closed embedding into projective space). By Serre's theorem
(II, Theorem 5.17) `E ⊗ L^m` is generated by finitely many global sections for some `m`; since
`dim C = 1 < r`, II, Exercise 8.2 gives `0 → 𝒪_C → E ⊗ L^m → E'' → 0` with `E''` locally free of
rank `r - 1`. Tensoring with the inverse `M^∨` of `M = L^m` is an exact autoequivalence
(`Ringed.invertibleTensorEquivalence`), which turns this into
`0 → M^∨ → E → M^∨ ⊗ E'' → 0`, with `M^∨` invertible and `M^∨ ⊗ E''` locally free of rank `r - 1`.
-/

universe u

open CategoryTheory Limits AlgebraicGeometry
open scoped ZeroObject

namespace Hartshorne

/-! ### Pulling back subobjects along an epimorphism -/

section Abelian

variable {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞]

/-- For subobjects `S ≤ T` of `E'` and `p : E ⟶ E'`, the square formed by the inclusions
`p⁻¹ S ⟶ p⁻¹ T`, `S ⟶ T` and the projections `p⁻¹ S ⟶ S`, `p⁻¹ T ⟶ T` is a pullback. -/
theorem isPullback_ofLE_pullback_subobject {E E' : 𝒞} (p : E ⟶ E') {S T : Subobject E'}
    (h : S ≤ T) :
    IsPullback (Subobject.ofLE _ _ ((Subobject.pullback p).monotone h))
      (Subobject.pullbackπ p S) (Subobject.pullbackπ p T) (Subobject.ofLE S T h) := by
  refine IsPullback.flip (IsPullback.of_bot ?_ ?_ (Subobject.isPullback p T))
  · rw [Subobject.ofLE_arrow, Subobject.ofLE_arrow]
    exact Subobject.isPullback p S
  · rw [← cancel_mono T.arrow]
    simp only [Category.assoc, Subobject.ofLE_arrow, (Subobject.isPullback p S).w,
      (Subobject.isPullback p T).w, Subobject.ofLE_arrow_assoc]

/-- **Pulling back along an epimorphism preserves successive quotients.** For an epimorphism
`p : E ⟶ E'` and subobjects `S ≤ T` of `E'`, the induced map `p⁻¹ T / p⁻¹ S ⟶ T / S` is an
isomorphism. -/
theorem isIso_cokernelMap_ofLE_pullback_subobject {E E' : 𝒞} (p : E ⟶ E') [Epi p]
    {S T : Subobject E'} (h : S ≤ T) :
    IsIso (cokernel.map _ _ _ _ (isPullback_ofLE_pullback_subobject p h).w) := by
  have sq := isPullback_ofLE_pullback_subobject p h
  have : Mono (cokernel.map _ _ _ _ sq.w) := Abelian.mono_cokernel_map_of_isPullback sq
  have : Epi (Subobject.pullbackπ p T) :=
    MorphismProperty.of_isPullback (P := MorphismProperty.epimorphisms 𝒞)
      (Subobject.isPullback p T).flip (MorphismProperty.epimorphisms.infer_property p)
  have : Epi (cokernel.π (Subobject.ofLE _ _ ((Subobject.pullback p).monotone h)) ≫
      cokernel.map _ _ _ _ sq.w) := by
    rw [cokernel.π_desc]
    exact epi_comp _ _
  have : Epi (cokernel.map _ _ _ _ sq.w) := epi_of_epi (cokernel.π _) _
  exact isIso_of_mono_of_epi _

/-- For a short exact sequence `0 → A → E → E' → 0` and a subobject `P` of `E'`, the sequence
`0 → A → p⁻¹ P → P → 0` is short exact. -/
theorem shortExact_pullback_subobject {S : ShortComplex 𝒞} (hS : S.ShortExact)
    (P : Subobject S.X₃) :
    (ShortComplex.mk ((Subobject.isPullback S.g P).lift 0 S.f (by simp))
      (Subobject.pullbackπ S.g P) (by simp)).ShortExact := by
  have hsq := Subobject.isPullback S.g P
  have : Mono S.f := hS.mono_f
  have : Epi S.g := hS.epi_g
  have hepi : Epi (Subobject.pullbackπ S.g P) :=
    MorphismProperty.of_isPullback (P := MorphismProperty.epimorphisms 𝒞) hsq.flip
      (MorphismProperty.epimorphisms.infer_property S.g)
  have hmono : Mono (hsq.lift 0 S.f (by simp)) := by
    have : Mono (hsq.lift 0 S.f (by simp) ≫ ((Subobject.pullback S.g).obj P).arrow) := by
      rw [hsq.lift_snd]
      infer_instance
    exact mono_of_mono _ ((Subobject.pullback S.g).obj P).arrow
  refine ShortComplex.ShortExact.mk' ?_ hmono hepi
  rw [ShortComplex.exact_iff_exact_up_to_refinements]
  intro A x₂ hx₂
  obtain ⟨A', π, hπ, x₁, hx₁⟩ := hS.exact.exact_up_to_refinements
    (x₂ ≫ ((Subobject.pullback S.g).obj P).arrow) (by
      dsimp at hx₂
      rw [Category.assoc, ← hsq.w, ← Category.assoc, hx₂, zero_comp])
  refine ⟨A', π, hπ, x₁, ?_⟩
  dsimp
  rw [← cancel_mono ((Subobject.pullback S.g).obj P).arrow]
  simp only [Category.assoc, IsPullback.lift_snd]
  exact hx₁

end Abelian

/-! ### Filtrations by locally free subsheaves with invertible quotients -/

section Filtration

variable {X : Scheme.{u}}

private theorem isLocallyFreeOfRank_of_iso' {M N : X.Modules} (e : M ≅ N) {r : ℕ}
    (h : M.IsLocallyFreeOfRank r) : N.IsLocallyFreeOfRank r := by
  intro x
  obtain ⟨U, hx, ⟨e'⟩⟩ := h x
  exact ⟨U, hx, ⟨(Scheme.Modules.restrictFunctor U.ι).mapIso e.symm ≪≫ e'⟩⟩

private theorem isCoherent_of_isLocallyFreeOfRank' [IsLocallyNoetherian X] {E : X.Modules} {r : ℕ}
    (hE : E.IsLocallyFreeOfRank r) : IsCoherent E := by
  have hfl : Ringed.IsFiniteLocallyFree (R := X.sheaf) E := fun x => by
    obtain ⟨U, hxU, h⟩ := (Scheme.Modules.isLocallyFreeOfRank_iff_ringed E r).mp hE x
    exact ⟨U, hxU, r, h⟩
  exact ((coherent_affine_local_tfae E).out 1 0).mp
    (Ringed.IsFiniteLocallyFree.isFinitePresentation hfl)

private theorem isLocallyFreeOfRank_zero_of_isZero' {E : X.Modules} (hE : IsZero E) :
    E.IsLocallyFreeOfRank 0 :=
  (Scheme.Modules.isLocallyFreeOfRank_iff_ringed E 0).mpr
    (Ringed.isLocallyFreeOfRank_zero_of_isZero (R := X.sheaf) hE)

private theorem isCoherent_subobject' [IsLocallyNoetherian X] {E : X.Modules} (hE : IsCoherent E)
    (P : Subobject E) [(P : X.Modules).IsQuasicoherent] : IsCoherent (P : X.Modules) := by
  have : E.IsQuasicoherent := hE.isQuasicoherent
  have : (cokernel P.arrow).IsQuasicoherent := isQuasicoherent_cokernel P.arrow
  exact isCoherent_of_iso (IsLimit.conePointUniqueUpToIso (kernelIsKernel _)
      (Abelian.monoIsKernelOfCokernel _ (cokernelIsCokernel P.arrow)))
    (isCoherent_kernel_of_isQuasicoherent (cokernel.π P.arrow) hE)

/-- `E` has a filtration of length `r` by locally free subsheaves with invertible quotients. -/
private def LineFiltration (E : X.Modules) (r : ℕ) : Prop :=
  ∃ Fil : ℕ → Subobject E, Fil 0 = ⊥ ∧ Fil r = ⊤ ∧ Monotone Fil ∧
    (∀ i ≤ r, (Fil i : X.Modules).IsLocallyFreeOfRank i) ∧
    ∀ i (h : Fil i ≤ Fil (i + 1)), i < r → (cokernel (Subobject.ofLE _ _ h)).IsInvertible

private theorem isZero_bot_subobject (E : X.Modules) : IsZero ((⊥ : Subobject E) : X.Modules) :=
  IsZero.of_iso (isZero_zero _) Subobject.botCoeIsoZero

private theorem lineFiltration_zero {E : X.Modules} (hE : E.IsLocallyFreeOfRank 0) :
    LineFiltration E 0 := by
  have hz : IsZero E := Ringed.isZero_of_isLocallyFreeOfRank_zero (R := X.sheaf)
    ((Scheme.Modules.isLocallyFreeOfRank_iff_ringed E 0).mp hE)
  refine ⟨fun _ => ⊥, rfl, ?_, monotone_const, fun i hi => ?_, fun i _ hi => absurd hi (by omega)⟩
  · rw [Subobject.top_eq_id]
    exact (Subobject.mk_eq_bot_iff_zero.mpr (hz.eq_of_src _ _)).symm
  · obtain rfl : i = 0 := by omega
    exact isLocallyFreeOfRank_zero_of_isZero' (isZero_bot_subobject E)

/-- The inductive step: an extension of a sheaf with such a filtration by an invertible sheaf has
such a filtration, one step longer. -/
private theorem lineFiltration_of_shortExact [IsReduced X] [IsLocallyNoetherian X]
    {S : ShortComplex X.Modules} (hS : S.ShortExact) (hA : S.X₁.IsInvertible)
    (hE : IsCoherent S.X₂) {r : ℕ} (h : LineFiltration S.X₃ r) :
    LineFiltration S.X₂ (r + 1) := by
  obtain ⟨F, hF0, hFr, hFm, hFl, hFq⟩ := h
  have : Epi S.g := hS.epi_g
  let G : ℕ → Subobject S.X₂ := fun i => Nat.casesOn i ⊥ fun j => (Subobject.pullback S.g).obj (F j)
  have hGl : ∀ j ≤ r, (G (j + 1) : X.Modules).IsLocallyFreeOfRank (j + 1) := by
    intro j hj
    have hT := shortExact_pullback_subobject hS (F j)
    have : S.X₁.IsQuasicoherent := (isCoherent_of_isLocallyFreeOfRank' hA).isQuasicoherent
    have : (F j : X.Modules).IsQuasicoherent :=
      (isCoherent_of_isLocallyFreeOfRank' (hFl j hj)).isQuasicoherent
    have : ((Subobject.pullback S.g).obj (F j) : X.Modules).IsQuasicoherent :=
      isQuasicoherent_of_shortExact hT
    have hcoh := isCoherent_subobject' hE ((Subobject.pullback S.g).obj (F j))
    have h := isLocallyFreeOfRank_of_shortExact hT hA (hFl j hj) hcoh
    rw [Nat.add_comm 1 j] at h
    exact h
  refine ⟨G, rfl, ?_, ?_, ?_, ?_⟩
  · change (Subobject.pullback S.g).obj (F r) = ⊤
    rw [hFr, Subobject.pullback_top]
  · refine monotone_nat_of_le_succ fun i => ?_
    cases i with
    | zero => exact bot_le
    | succ j => exact (Subobject.pullback S.g).monotone (hFm (Nat.le_succ j))
  · intro i hi
    cases i with
    | zero => exact isLocallyFreeOfRank_zero_of_isZero' (isZero_bot_subobject _)
    | succ j => exact hGl j (by omega)
  · intro i hle hi
    cases i with
    | zero =>
      have hz : Subobject.ofLE (G 0) (G 1) hle = 0 := (isZero_bot_subobject _).eq_of_src _ _
      exact isLocallyFreeOfRank_of_iso'
        ((asIso (cokernel.π (0 : Subobject.underlying.obj (G 0) ⟶ Subobject.underlying.obj (G 1))))
          ≪≫ (cokernelIsoOfEq hz).symm)
        (hGl 0 (Nat.zero_le r))
    | succ j =>
      have hj : F j ≤ F (j + 1) := hFm (Nat.le_succ j)
      have := isIso_cokernelMap_ofLE_pullback_subobject S.g hj
      exact isLocallyFreeOfRank_of_iso'
        (asIso (cokernel.map _ _ _ _ (isPullback_ofLE_pullback_subobject S.g hj).w)).symm
        (hFq j hj (by omega))

/-- **Vector bundles on curves are successive extensions of line bundles** (general form of
Hartshorne V, Exercise 2.3(a), which there is stated for a nonsingular curve). Let `C` be an
integral projective scheme of dimension one over an algebraically closed field `k` and `E` a
locally free sheaf of rank `r` on `C`. There is a filtration `0 = E_0 ⊆ E_1 ⊆ ⋯ ⊆ E_r = E` by
subsheaves with `E_i` locally free of rank `i`, such that every quotient `E_{i+1} / E_i` is
invertible. -/
theorem exists_lineBundleFiltration_of_projective {k : Type u} [Field k] [IsAlgClosed k]
    {C : Scheme.{u}} (q : C ⟶ Spec (.of k)) [IsIntegral C] (hq : Projective q)
    (hdim : topologicalKrullDim C = 1) {E : C.Modules} {r : ℕ}
    (hE : E.IsLocallyFreeOfRank r) :
    ∃ Fil : ℕ → Subobject E, Fil 0 = ⊥ ∧ Fil r = ⊤ ∧ Monotone Fil ∧
      (∀ i ≤ r, (Fil i : C.Modules).IsLocallyFreeOfRank i) ∧
      ∀ i (h : Fil i ≤ Fil (i + 1)), i < r → (cokernel (Subobject.ofLE _ _ h)).IsInvertible := by
  have : IsProper q := hq.isProper
  have hft : FiniteType q := ⟨inferInstance, inferInstance⟩
  have : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  -- a very ample invertible sheaf
  obtain ⟨n, i, hi, hcomp⟩ := id hq
  let L : C.Modules :=
    (Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf n (Spec (.of k)) 1)
  have hLinv : L.IsInvertible :=
    Scheme.Modules.IsInvertible.pullback _ (isInvertible_projectiveSpaceTwistingSheaf n _ 1)
  have hL : IsVeryAmpleRelative q L :=
    ⟨hLinv, n, C, 𝟙 C, i, inferInstance, hi, by rw [Category.id_comp, hcomp],
      ⟨eqToIso (by rw [Category.id_comp])⟩⟩
  suffices H : ∀ (r : ℕ) (E : C.Modules), E.IsLocallyFreeOfRank r → LineFiltration E r from
    H r E hE
  intro r
  induction r with
  | zero => exact fun E hE => lineFiltration_zero hE
  | succ r ih =>
    intro E hE
    have hEc := isCoherent_of_isLocallyFreeOfRank' hE
    rcases Nat.eq_zero_or_pos r with rfl | hr
    · -- rank one: the sequence `0 → E → E → 0 → 0`
      let T := ShortComplex.mk (𝟙 E) (0 : E ⟶ 0) (by simp)
      have hT : T.ShortExact :=
        ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_epi T rfl).mpr inferInstance)
          inferInstance ((isZero_zero _).epi _)
      exact lineFiltration_of_shortExact hT hE hEc
        (ih _ (isLocallyFreeOfRank_zero_of_isZero' (isZero_zero _)))
    · -- rank at least two: twist, split off `𝒪_C`, and twist back
      obtain ⟨m, hm⟩ := exists_isGeneratedBySections_tensorPowerTwist_of_projective hq hL E hEc
      obtain ⟨ι, hι, t, ht⟩ := hm m le_rfl
      obtain ⟨N, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
      let M : C.Modules := moduleSheafTensorPower m L
      have hM : M.IsInvertible := isInvertible_moduleSheafTensorPower hLinv m
      have hMr : Ringed.IsInvertible (R := C.sheaf) M :=
        (Scheme.Modules.isInvertible_iff_ringed _).mp hM
      let F := tensorPowerTwist E L m
      let v : Fin (N + 1) → Γ(F, ⊤) := Fin.cons 0 (t ∘ e.symm)
      have hv : F.IsGeneratedBySections (fun j : ULift.{u} (Fin (N + 1)) => v j.down) := by
        intro x
        refine eq_top_iff.mpr ((ht x).symm.le.trans (Submodule.span_mono ?_))
        rintro _ ⟨j, rfl⟩
        exact ⟨⟨(e j).succ⟩, by simp only [v, Fin.cons_succ, Function.comp_apply,
          Equiv.symm_apply_apply]; rfl⟩
      have hFr : F.IsLocallyFreeOfRank (r + 1) :=
        isLocallyFreeOfRank_of_iso' (Ringed.moduleSheafTensorComm M E)
          ((Scheme.Modules.isLocallyFreeOfRank_iff_ringed _ _).mpr
            (Ringed.isLocallyFreeOfRank_moduleSheafTensor_of_isInvertible hMr
              ((Scheme.Modules.isLocallyFreeOfRank_iff_ringed _ _).mp hE)))
      obtain ⟨s, -, -, E'', p, w, hS, hE''⟩ :=
        exists_nonvanishing_section_shortExact q hft (n := 1) (by simpa using hdim) hFr
          (by omega) v hv
      -- tensor with the inverse of `M`
      let eqv : C.Modules ≌ C.Modules := Ringed.invertibleTensorEquivalence hMr
      have : eqv.inverse.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_full _
      have hS' := hS.map_of_exact eqv.inverse
      let S' := (ShortComplex.mk (NowhereVanishingSection.sectionHom F s) p w).map eqv.inverse
      let φ : eqv.inverse.obj F ≅ E :=
        eqv.inverse.mapIso (Ringed.moduleSheafTensorComm E M) ≪≫ eqv.unitIso.symm.app E
      let S'' := ShortComplex.mk (S'.f ≫ φ.hom) (φ.inv ≫ S'.g)
        ((Category.assoc _ _ _).trans
          ((congrArg (S'.f ≫ ·) (Iso.hom_inv_id_assoc φ S'.g)).trans S'.zero))
      have hS'' : S''.ShortExact :=
        ShortComplex.shortExact_of_iso (S₁ := S') (S₂ := S'')
          (ShortComplex.isoMk (Iso.refl _) φ (Iso.refl _) (by simp [S''])
            (by simp only [S'', Category.comp_id, Iso.refl_hom]
                exact Iso.hom_inv_id_assoc φ _)) hS'
      have hdual := Ringed.isInvertible_moduleSheafDual hMr
      have h₁ : S''.X₁.IsInvertible :=
        (Scheme.Modules.isInvertible_iff_ringed _).mpr
          (Ringed.isLocallyFreeOfRank_moduleSheafTensor_of_isInvertible hdual
            ((Scheme.Modules.isInvertible_iff_ringed _).mp (isInvertible_structureModuleOf C)))
      have h₃ : S''.X₃.IsLocallyFreeOfRank r :=
        (Scheme.Modules.isLocallyFreeOfRank_iff_ringed _ _).mpr
          (Ringed.isLocallyFreeOfRank_moduleSheafTensor_of_isInvertible hdual
            ((Scheme.Modules.isLocallyFreeOfRank_iff_ringed _ _).mp (by simpa using hE'')))
      exact lineFiltration_of_shortExact hS'' h₁ hEc (ih _ h₃)

/-- **Hartshorne V, Exercise 2.3(a)**, for `C` projective. Let `C` be a nonsingular projective
curve over an algebraically closed field `k` and `E` a locally free sheaf of rank `r` on `C`.
There is a filtration `0 = E_0 ⊆ E_1 ⊆ ⋯ ⊆ E_r = E` by locally free subsheaves (`E_i` of rank
`i`) such that every quotient `E_{i+1} / E_i` is invertible. -/
theorem exists_lineBundleFiltration {k : Type u} [Field k] [IsAlgClosed k] {C : Scheme.{u}}
    [C.Over (Spec (.of k))] [IsIntegral C] (hC : C.IsNonsingularCurve k)
    (hproj : Projective (C ↘ Spec (.of k))) {E : C.Modules} {r : ℕ}
    (hE : E.IsLocallyFreeOfRank r) :
    ∃ Fil : ℕ → Subobject E, Fil 0 = ⊥ ∧ Fil r = ⊤ ∧ Monotone Fil ∧
      (∀ i ≤ r, (Fil i : C.Modules).IsLocallyFreeOfRank i) ∧
      ∀ i (h : Fil i ≤ Fil (i + 1)), i < r → (cokernel (Subobject.ofLE _ _ h)).IsInvertible :=
  exists_lineBundleFiltration_of_projective (C ↘ Spec (.of k)) hproj
    hC.topologicalKrullDim_eq_one hE

end Filtration

end Hartshorne
