import Hartshorne.Scheme.ReesAlgebraBlowup
import Hartshorne.Scheme.RelativeSpec
import Hartshorne.Scheme.RelativeProjTwistingSheaf
import Hartshorne.Scheme.EffectiveCartierIdealSheaf
import Hartshorne.Scheme.Differentials.RelativeDifferentialsBaseChange

/-!
# The exceptional ideal of a blowing-up

Hartshorne, *Algebraic Geometry*, II, Proposition 7.13(a) (p. 164); see also Stacks Project,
tag 01OF.

Let `I` be a quasi-coherent sheaf of ideals on `X`, `𝒮 = ⨁_{d ≥ 0} Iᵈ` its sheaf of Rees algebras
and `π : X̃ = Proj_X 𝒮 ⟶ X`. Over an affine open `U ⊆ X` with `A = Γ(U, 𝒪_X)` and `I = Γ(U, I)`,
`X̃` is `Proj A[It]`, covered by the charts `D₊(a t) = Spec A[It]_(a t)` with `a ∈ I`. On such a
chart the ideal generated by `I` is generated by `a`, which is a non-zero-divisor: for `b ∈ I`,
`b = a · (b t)/(a t)`. So the inverse image ideal `I_E = π⁻¹I · 𝒪_{X̃}` is locally generated by one
non-zero-divisor; it is the ideal sheaf of an effective Cartier divisor `E`, and `I_E ≅ 𝒪(-E)` by
Proposition 6.18. On the chart, the shifted Rees module `S(1)_(a t)` maps isomorphically onto the
ideal `I · S_(a t)` by `y / (a t)ⁿ ↦ (y / t) / (a t)ⁿ`; this is the local form of `I_E ≅ 𝒪(1)`.

## Main results

* `Hartshorne.reesAway_map_ideal_eq_span`, `Hartshorne.reesAway_algebraMap_mem_nonZeroDivisors`:
  on `A[It]_(a t)`, `I` generates the ideal `(a)` and `a` is a non-zero-divisor.
* `Hartshorne.reesTwistAwayToAway`, `reesTwistAwayToAway_injective`,
  `range_reesTwistAwayToAway`, `reesTwistAwayToAway_mk`: the injective map
  `S(1)_(a t) → S_(a t)`, `y / s ↦ (y / t) / s`, with image `I · S_(a t)`.
* `Hartshorne.twistDivX`, `twistDivXHom`, `mono_twistDivXHom`: on `Proj A[It]`, pointwise
  division by `t`, `S(1)_(x) → S_(x)`, `m / s ↦ (m / t) / s`, a monomorphism `𝒪(1) ⟶ 𝒪`.
* `Hartshorne.imageIdealSheafIso`: a monomorphism `F ⟶ 𝒪_X` from a quasi-coherent `F` identifies
  `F` with the ideal sheaf of its image (the argument of Proposition 6.18);
  `projTwistingSheafIsoImageIdealSheaf` is the case of `𝒪(1) ⟶ 𝒪` on `Proj A[It]`.
* `Hartshorne.DirectedModuleGluing.Data.liftIso`: a module with isomorphisms to the pieces of a
  directed descent datum, compatible with the transition isomorphisms, is isomorphic to the glued
  module (`CompatibleFamilies.lift`, `liftHom`, `restrict_liftHom_ψ`).
* `Hartshorne.ReesAlgebraSheaf.isLocallyPrincipalNonZeroDivisor_inverseImageIdeal`: `π⁻¹J · 𝒪`
  is locally generated by one non-zero-divisor, for any ideal sheaf data `J`.
* `Hartshorne.QuasicoherentIdealSubsheaf.exceptionalIdeal`, `exceptionalDivisor`,
  `exceptionalIdealSheaf`, `exceptionalIdealSheafIsoDivisorSheaf`,
  `isInvertible_exceptionalIdealSheaf`: for the blowing-up of a coherent `I` on a Noetherian `X`,
  the exceptional ideal, its effective Cartier divisor `E`, `I_E ≅ 𝒪(-E)`, and invertibility.
* `Hartshorne.isoOfIdealSheafDataOfHomEq`, `idealSheafDataOfHom_restrictToUnit`,
  `idealSheafDataOfHom_closedImmersionIdealSheafι`: monomorphisms into `𝒪_X` with the same image
  ideal have isomorphic sources; image ideals pull back along open immersions; the image ideal of
  the ideal sheaf of `K` is `K`.
* `Hartshorne.homRangeIdeal_twistDivXHom_chart`, `ReesAlgebraSheaf.idealSheafDataOfHom_pieceDivX`:
  the image of `𝒪(1) ⟶ 𝒪` on `Proj A[It]` is the inverse image ideal of `I`.
* `Hartshorne.twistRestrictHom_comp_twistDivXHom`: division by `t` commutes with the transition
  maps of the twisting sheaves.
* `Hartshorne.QuasicoherentIdealSubsheaf.exceptionalIdealSheafIsoTwistingSheaf`,
  `twistingSheafIsoDivisorSheaf`: `I_E ≅ 𝒪(1)` and `𝒪(1) ≅ 𝒪(-E)`.
-/

noncomputable section

open CategoryTheory Polynomial AlgebraicGeometry HomogeneousLocalization

universe u

namespace Hartshorne

section Algebra

variable {A : Type u} [CommRing A] (I : Ideal A) {a : A} (ha : a ∈ I)

/-- The degree-one element `a t` of the Rees algebra `A[It]`, for `a ∈ I`. -/
def reesDegOne : reesAlgebra I :=
  ⟨monomial 1 a, reesAlgebra.monomial_mem.2 (by rwa [pow_one])⟩

theorem reesDegOne_mem : reesDegOne I ha ∈ reesGrading I 1 :=
  fun m hm => by simp [reesDegOne, coeff_monomial, Ne.symm hm]

/-- The structure map `A → A[It]_(a t)` into the degree-zero localization at `a t`. -/
def reesAwayMap : A →+* Away (reesGrading I) (reesDegOne I ha) :=
  (fromZeroRingHom (reesGrading I) _).comp
    { toFun r := ⟨algebraMap A (reesAlgebra I) r, algebraMap_mem_reesGrading_zero I r⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' _ _ := Subtype.ext (map_mul _ _ _)
      map_zero' := Subtype.ext (map_zero _)
      map_add' _ _ := Subtype.ext (map_add _ _ _) }

theorem val_reesAwayMap (r : A) :
    (reesAwayMap I ha r).val = Localization.mk (algebraMap A (reesAlgebra I) r) 1 :=
  rfl

/-- **On the chart `D₊(a t)`, the ideal generated by `I` is generated by `a`**: for `b ∈ I`,
`b = a · (b t)/(a t)` in `A[It]_(a t)`. -/
theorem reesAway_map_ideal_eq_span :
    I.map (reesAwayMap I ha) = Ideal.span {reesAwayMap I ha a} := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.2 fun b hb => ?_)
    ((Ideal.span_singleton_le_iff_mem _).2 (Ideal.mem_map_of_mem _ ha))
  rw [Ideal.mem_comap, Ideal.mem_span_singleton']
  refine ⟨HomogeneousLocalization.mk ⟨1, ⟨reesDegOne I hb, reesDegOne_mem I hb⟩,
    ⟨reesDegOne I ha, reesDegOne_mem I ha⟩, ⟨1, pow_one _⟩⟩, ?_⟩
  apply HomogeneousLocalization.val_injective
  rw [val_mul, val_mk, val_reesAwayMap, val_reesAwayMap, Localization.mk_mul,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, Subtype.ext ?_⟩
  simp only [OneMemClass.coe_one, one_mul, mul_one]
  change (monomial 1 b : A[X]) * C a = monomial 1 a * C b
  rw [mul_comm, C_mul_monomial, mul_comm (monomial 1 a), C_mul_monomial, mul_comm]

/-- **On the chart `D₊(a t)`, `a` is a non-zero-divisor** of `A[It]_(a t)`. -/
theorem reesAway_algebraMap_mem_nonZeroDivisors :
    reesAwayMap I ha a ∈ nonZeroDivisors (Away (reesGrading I) (reesDegOne I ha)) := by
  rw [mem_nonZeroDivisors_iff_right]
  intro z hz
  obtain ⟨⟨n, ⟨x, hx⟩, ⟨s, hs⟩, hsmem⟩, rfl⟩ := mk_surjective z
  have hz' := congrArg HomogeneousLocalization.val hz
  rw [val_mul, val_mk, val_reesAwayMap, Localization.mk_mul, val_zero, ← Localization.mk_zero 1,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists] at hz'
  obtain ⟨⟨c, k, rfl⟩, hc⟩ := hz'
  apply HomogeneousLocalization.val_injective
  rw [val_mk, val_zero, ← Localization.mk_zero 1, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  refine ⟨⟨reesDegOne I ha ^ (k + 1), k + 1, rfl⟩, ?_⟩
  simp only [OneMemClass.coe_one, mul_one, mul_zero] at hc ⊢
  have hc' := congrArg (fun p : reesAlgebra I => X * (p : A[X])) hc
  simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, ZeroMemClass.coe_zero, mul_zero] at hc'
  apply Subtype.ext
  simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, ZeroMemClass.coe_zero]
  rw [← hc']
  change (monomial 1 a : A[X]) ^ (k + 1) * (1 * (x : A[X])) =
    X * ((monomial 1 a) ^ k * (1 * ((x : A[X]) * C a)))
  rw [pow_succ, ← C_mul_X_pow_eq_monomial, pow_one]
  ring

/-! #### The shifted Rees module on a chart -/

/-- The map `S(1)_(a t) → S_(a t)` for `S = A[It]`: the inverse of multiplication by `a t`,
`S_(a t) ≅ S(1)_(a t)`, followed by multiplication by `a`. It sends `y / (a t)ⁿ` (`y ∈ S_{n+1}`)
to `(y / t) / (a t)ⁿ` (`reesTwistAwayToAway_mk`). -/
def reesTwistAwayToAway :
    HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1)
        (Submonoid.powers (reesDegOne I ha)) →ₗ[Away (reesGrading I) (reesDegOne I ha)]
      Away (reesGrading I) (reesDegOne I ha) :=
  LinearMap.mulRight _ (reesAwayMap I ha a) ∘ₗ
    (ProjTwistingSheaf.twistAwayEquiv (reesDegOne_mem I ha) 1).symm.toLinearMap

theorem reesTwistAwayToAway_apply
    (y : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1)
      (Submonoid.powers (reesDegOne I ha))) :
    reesTwistAwayToAway I ha y =
      (ProjTwistingSheaf.twistAwayEquiv (reesDegOne_mem I ha) 1).symm y * reesAwayMap I ha a :=
  rfl

/-- The local generator `a t` of `S(1)_(a t)` goes to `a`: the degree-one copy of `I` goes to
`I`. -/
theorem reesTwistAwayToAway_twistGenerator :
    reesTwistAwayToAway I ha (ProjTwistingSheaf.twistGenerator (reesDegOne_mem I ha) 1) =
      reesAwayMap I ha a := by
  rw [reesTwistAwayToAway_apply, ← one_smul (Away (reesGrading I) (reesDegOne I ha))
    (ProjTwistingSheaf.twistGenerator (reesDegOne_mem I ha) 1),
    ← ProjTwistingSheaf.twistAwayEquiv_apply, LinearEquiv.symm_apply_apply, one_mul]

theorem reesTwistAwayToAway_injective : Function.Injective (reesTwistAwayToAway I ha) := by
  refine (injective_iff_map_eq_zero _).2 fun y hy => ?_
  rw [reesTwistAwayToAway_apply] at hy
  have := (mem_nonZeroDivisors_iff_right.1 (reesAway_algebraMap_mem_nonZeroDivisors I ha)) _ hy
  simpa using this

/-- **The shifted Rees module on a chart is the ideal generated by `I`** (Stacks 01OF): the
image of `S(1)_(a t) → S_(a t)` is `I · S_(a t)`. -/
theorem range_reesTwistAwayToAway :
    LinearMap.range (reesTwistAwayToAway I ha) = I.map (reesAwayMap I ha) := by
  rw [reesAway_map_ideal_eq_span]
  ext z
  rw [LinearMap.mem_range, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨_, rfl⟩
  · rintro ⟨c, rfl⟩
    exact ⟨ProjTwistingSheaf.twistAwayEquiv (reesDegOne_mem I ha) 1 c, by
      rw [reesTwistAwayToAway_apply, LinearEquiv.symm_apply_apply]⟩

/-- Division by `t` on the elements of `A[It]` without constant term:
`p ↦ (p - p(0)) / t`, which maps `I^{n+1} t^{n+1}` into `I^{n+1} tⁿ ⊆ Iⁿ tⁿ`. -/
def reesShift (y : reesAlgebra I) : reesAlgebra I :=
  ⟨divX (y : A[X]), fun k => by
    rw [coeff_divX]
    exact Ideal.pow_le_pow_right (Nat.le_succ k) ((mem_reesAlgebra_iff I _).1 y.2 (k + 1))⟩

theorem reesShift_mem {n : ℕ} {y : reesAlgebra I} (hy : y ∈ reesGrading I (n + 1)) :
    reesShift I y ∈ reesGrading I n := fun m hm => by
  change (divX (y : A[X])).coeff m = 0
  rw [coeff_divX]
  exact hy (m + 1) (by omega)

theorem reesShift_mul_reesDegOne {n : ℕ} {y : reesAlgebra I} (hy : y ∈ reesGrading I (n + 1)) :
    reesShift I y * reesDegOne I ha = y * algebraMap A (reesAlgebra I) a := by
  apply Subtype.ext
  change divX (y : A[X]) * monomial 1 a = (y : A[X]) * C a
  have h0 : (y : A[X]).coeff 0 = 0 := hy 0 (by omega)
  conv_rhs => rw [← divX_mul_X_add (y : A[X]), h0]
  rw [C_0, add_zero, ← C_mul_X_pow_eq_monomial, pow_one]
  ring

/-- **The canonical description of `S(1)_(a t) → S_(a t)`**: `y / s ↦ (y / t) / s` for
`y ∈ S(1)_n = S_{n+1}` and `s ∈ S_n` a power of `a t`. -/
theorem reesTwistAwayToAway_mk (n : ℕ) (y : reesAlgebra I)
    (hy : y ∈ gradedTwist (reesGrading I) 1 n) (s : reesAlgebra I) (hs : s ∈ reesGrading I n)
    (hsx : s ∈ Submonoid.powers (reesDegOne I ha)) :
    reesTwistAwayToAway I ha (HomogeneousLocalizedModule.mk n y hy s hs hsx) =
      HomogeneousLocalization.mk ⟨n, ⟨reesShift I y, reesShift_mem I
        ((mem_gradedTwist_of_eq (k := n + 1) (by push_cast; ring)).1 hy)⟩, ⟨s, hs⟩, hsx⟩ := by
  have hy' : y ∈ reesGrading I (n + 1) :=
    (mem_gradedTwist_of_eq (k := n + 1) (by push_cast; ring)).1 hy
  have key : HomogeneousLocalizedModule.mk n y hy s hs hsx =
      ProjTwistingSheaf.twistAwayEquiv (reesDegOne_mem I ha) 1
        (HomogeneousLocalization.mk ⟨n + 1, ⟨y, hy'⟩,
          ⟨s * reesDegOne I ha, SetLike.GradedMul.mul_mem hs (reesDegOne_mem I ha)⟩,
          mul_mem hsx (Submonoid.mem_powers _)⟩) := by
    rw [ProjTwistingSheaf.twistAwayEquiv_apply]
    ext
    rw [HomogeneousLocalizedModule.val_mk, HomogeneousLocalizedModule.val_smul,
      ProjTwistingSheaf.twistGenerator_val, HomogeneousLocalization.val_mk,
      LocalizedModule.mk_smul_mk, LocalizedModule.mk_eq]
    refine ⟨1, ?_⟩
    simp only [one_smul, Submonoid.mk_smul, Submonoid.mk_mul_mk, smul_eq_mul]
    have h1 : (-1 : ℤ).toNat = 0 := rfl
    have h2 : (1 : ℤ).toNat = 1 := rfl
    rw [h1, h2, pow_zero, pow_one]
    ring
  rw [key, reesTwistAwayToAway_apply, LinearEquiv.symm_apply_apply]
  apply HomogeneousLocalization.val_injective
  rw [val_mul, val_mk, val_reesAwayMap, val_mk, Localization.mk_mul, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul, mul_one]
  rw [← reesShift_mul_reesDegOne I ha hy']
  ring

/-! #### Division by `t` on the degree-zero localizations of `S(1)` -/

theorem reesShift_mul_of_mem_one {f : reesAlgebra I} (hf : f ∈ reesGrading I 1) {n : ℕ}
    {y : reesAlgebra I} (hy : y ∈ reesGrading I (n + 1)) :
    reesShift I y * f = y * algebraMap A (reesAlgebra I) ((f : A[X]).coeff 1) := by
  have hc : (f : A[X]).coeff 1 ∈ I := by
    simpa using (mem_reesAlgebra_iff I _).1 f.2 1
  have hfe : f = reesDegOne I hc := Subtype.ext (mem_reesGrading_iff.1 hf)
  exact (congrArg (reesShift I y * ·) hfe).trans (reesShift_mul_reesDegOne I hc hy)

theorem reesShift_add (y z : reesAlgebra I) : reesShift I (y + z) = reesShift I y + reesShift I z :=
  Subtype.ext divX_add

theorem reesShift_mul_of_coeff_zero (c y : reesAlgebra I) (hy : (y : A[X]).coeff 0 = 0) :
    reesShift I (c * y) = c * reesShift I y := by
  apply Subtype.ext
  change divX ((c : A[X]) * (y : A[X])) = (c : A[X]) * divX (y : A[X])
  have h1 := X_mul_divX_add ((c : A[X]) * (y : A[X]))
  have h2 := X_mul_divX_add (y : A[X])
  rw [mul_coeff_zero, hy, mul_zero, C_0, add_zero] at h1
  rw [hy, C_0, add_zero] at h2
  have h3 : X * (divX ((c : A[X]) * (y : A[X])) - (c : A[X]) * divX (y : A[X])) = 0 := by
    linear_combination h1 - (c : A[X]) * h2
  exact sub_eq_zero.1 ((monic_X.mul_right_eq_zero_iff).1 h3)

variable (T : Submonoid (reesAlgebra I))

/-- Representations `m / s` of elements of `S(1)_T`: `m ∈ S(1)_n`, `s ∈ S_n ∩ T`. -/
private abbrev TwistData :=
  (n : ℕ) × {m : reesAlgebra I // m ∈ gradedTwist (reesGrading I) 1 n} ×
    {s : reesAlgebra I // s ∈ reesGrading I n ∧ s ∈ T}

private noncomputable def TwistData.toHLM (d : TwistData I T) :
    HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1) T :=
  HomogeneousLocalizedModule.mk d.1 d.2.1.1 d.2.1.2 d.2.2.1 d.2.2.2.1 d.2.2.2.2

theorem mem_reesGrading_succ_of_mem_twist {n : ℕ} {m : reesAlgebra I}
    (hm : m ∈ gradedTwist (reesGrading I) 1 n) : m ∈ reesGrading I (n + 1) :=
  (mem_gradedTwist_of_eq (k := n + 1) (by push_cast; ring)).1 hm

private noncomputable def TwistData.divX (d : TwistData I T) :
    HomogeneousLocalization (reesGrading I) T :=
  HomogeneousLocalization.mk ⟨d.1, ⟨reesShift I d.2.1.1,
    reesShift_mem I (mem_reesGrading_succ_of_mem_twist I d.2.1.2)⟩, ⟨d.2.2.1, d.2.2.2.1⟩,
    d.2.2.2.2⟩

private theorem TwistData.divX_congr (hT : ∃ f ∈ reesGrading I 1, f ∈ T) (d d' : TwistData I T)
    (h : d.toHLM = d'.toHLM) : d.divX = d'.divX := by
  obtain ⟨f, hf1, hfT⟩ := hT
  obtain ⟨n, ⟨m, hm⟩, ⟨s, hs, hsx⟩⟩ := d
  obtain ⟨n', ⟨m', hm'⟩, ⟨s', hs', hsx'⟩⟩ := d'
  have he' := congrArg HomogeneousLocalizedModule.val h
  simp only [TwistData.toHLM, HomogeneousLocalizedModule.val_mk, LocalizedModule.mk_eq] at he'
  obtain ⟨⟨c, hc⟩, hc'⟩ := he'
  simp only [Submonoid.mk_smul, smul_eq_mul] at hc'
  apply HomogeneousLocalization.val_injective
  simp only [TwistData.divX]
  rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  refine ⟨⟨c * f, mul_mem hc hfT⟩, ?_⟩
  have k1 := reesShift_mul_of_mem_one I hf1 (mem_reesGrading_succ_of_mem_twist I hm)
  have k2 := reesShift_mul_of_mem_one I hf1 (mem_reesGrading_succ_of_mem_twist I hm')
  simp only
  linear_combination (c * s') * k1 - (c * s) * k2 +
    algebraMap A (reesAlgebra I) ((f : A[X]).coeff 1) * hc'

/-- A chosen representation of an element of `S(1)_T`. -/
private noncomputable def twistRep
    (y : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1) T) :
    {d : TwistData I T // y = d.toHLM} :=
  Classical.choice <| by
    obtain ⟨n, m, hm, s, hs, hsx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective y
    exact ⟨⟨⟨n, ⟨m, hm⟩, ⟨s, hs, hsx⟩⟩, rfl⟩⟩

/-- **Division by `t`**, `S(1)_T → S_T`, `m / s ↦ (m / t) / s` (`val_twistDivX_mk`), when `T`
contains an element of degree one. -/
noncomputable def twistDivX
    (y : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1) T) :
    HomogeneousLocalization (reesGrading I) T :=
  (twistRep I T y).1.divX

theorem twistDivX_mk (hT : ∃ f ∈ reesGrading I 1, f ∈ T) (n : ℕ) (m : reesAlgebra I)
    (hm : m ∈ gradedTwist (reesGrading I) 1 n) (s : reesAlgebra I) (hs : s ∈ reesGrading I n)
    (hsx : s ∈ T) :
    twistDivX I T (HomogeneousLocalizedModule.mk n m hm s hs hsx) =
      HomogeneousLocalization.mk ⟨n, ⟨reesShift I m,
        reesShift_mem I (mem_reesGrading_succ_of_mem_twist I hm)⟩, ⟨s, hs⟩, hsx⟩ :=
  TwistData.divX_congr I T hT _ ⟨n, ⟨m, hm⟩, ⟨s, hs, hsx⟩⟩ (twistRep I T _).2.symm

theorem coeff_zero_of_mem_twist {n : ℕ} {m : reesAlgebra I}
    (hm : m ∈ gradedTwist (reesGrading I) 1 n) : (m : A[X]).coeff 0 = 0 :=
  mem_reesGrading_succ_of_mem_twist I hm 0 (by omega)

theorem twistDivX_add (hT : ∃ f ∈ reesGrading I 1, f ∈ T)
    (y z : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1) T) :
    twistDivX I T (y + z) = twistDivX I T y + twistDivX I T z := by
  obtain ⟨n, m, hm, s, hs, hsx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective y
  obtain ⟨n', m', hm', s', hs', hsx', rfl⟩ := HomogeneousLocalizedModule.mk_surjective z
  have hmem : s' • m + s • m' ∈ gradedTwist (reesGrading I) 1 ((n + n' : ℕ) : ℤ) := by
    refine add_mem ?_ ?_
    · have := smul_mem_graded_nat (reesGrading I) (gradedTwist (reesGrading I) 1) hs' hm
      rwa [show ((n' : ℕ) : ℤ) + n = ((n + n' : ℕ) : ℤ) by push_cast; ring] at this
    · have := smul_mem_graded_nat (reesGrading I) (gradedTwist (reesGrading I) 1) hs hm'
      rwa [show ((n : ℕ) : ℤ) + n' = ((n + n' : ℕ) : ℤ) by push_cast; ring] at this
  have e : HomogeneousLocalizedModule.mk n m hm s hs hsx +
      HomogeneousLocalizedModule.mk n' m' hm' s' hs' hsx' =
      HomogeneousLocalizedModule.mk (n + n') (s' • m + s • m') hmem (s * s')
        (SetLike.GradedMul.mul_mem hs hs') (mul_mem hsx hsx') := by
    ext
    simp only [HomogeneousLocalizedModule.val_add, HomogeneousLocalizedModule.val_mk]
    rw [LocalizedModule.mk_add_mk]
    rfl
  rw [e, twistDivX_mk I T hT, twistDivX_mk I T hT, twistDivX_mk I T hT]
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_add, HomogeneousLocalization.val_mk,
    HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk, Localization.add_mk]
  congr 1
  simp only [smul_eq_mul]
  rw [reesShift_add, reesShift_mul_of_coeff_zero I _ _ (coeff_zero_of_mem_twist I hm),
    reesShift_mul_of_coeff_zero I _ _ (coeff_zero_of_mem_twist I hm')]
  ring

theorem twistDivX_smul (hT : ∃ f ∈ reesGrading I 1, f ∈ T)
    (c : HomogeneousLocalization (reesGrading I) T)
    (y : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1) T) :
    twistDivX I T (c • y) = c * twistDivX I T y := by
  obtain ⟨n, m, hm, s, hs, hsx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective y
  obtain ⟨⟨i, ⟨a, ha⟩, ⟨b, hb⟩, hbx⟩, rfl⟩ := HomogeneousLocalization.mk_surjective c
  have hmem : a • m ∈ gradedTwist (reesGrading I) 1 ((i + n : ℕ) : ℤ) := by
    have := smul_mem_graded_nat (reesGrading I) (gradedTwist (reesGrading I) 1) ha hm
    rwa [show ((i : ℕ) : ℤ) + n = ((i + n : ℕ) : ℤ) by push_cast; ring] at this
  have e : HomogeneousLocalization.mk ⟨i, ⟨a, ha⟩, ⟨b, hb⟩, hbx⟩ •
      HomogeneousLocalizedModule.mk n m hm s hs hsx =
      HomogeneousLocalizedModule.mk (i + n) (a • m) hmem (b * s)
        (SetLike.GradedMul.mul_mem hb hs) (mul_mem hbx hsx) := by
    ext
    rw [HomogeneousLocalizedModule.val_smul, HomogeneousLocalizedModule.val_mk,
      HomogeneousLocalizedModule.val_mk, HomogeneousLocalization.val_mk]
    exact LocalizedModule.mk_smul_mk _ _ _ _
  rw [e, twistDivX_mk I T hT, twistDivX_mk I T hT]
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_mk,
    HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk, Localization.mk_mul]
  congr 1
  simp only [smul_eq_mul]
  exact reesShift_mul_of_coeff_zero I _ _ (coeff_zero_of_mem_twist I hm)

theorem twistDivX_eq_zero (hT : ∃ f ∈ reesGrading I 1, f ∈ T)
    (y : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1) T)
    (hy : twistDivX I T y = 0) : y = 0 := by
  obtain ⟨n, m, hm, s, hs, hsx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective y
  rw [twistDivX_mk I T hT] at hy
  have hy' := congrArg HomogeneousLocalization.val hy
  rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_zero, ← Localization.mk_zero 1,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists] at hy'
  obtain ⟨⟨c, hc⟩, hc'⟩ := hy'
  simp only [OneMemClass.coe_one, one_mul, mul_zero] at hc'
  ext
  rw [HomogeneousLocalizedModule.val_mk, HomogeneousLocalizedModule.val_zero,
    ← LocalizedModule.zero_mk ⟨s, hsx⟩, LocalizedModule.mk_eq]
  refine ⟨⟨c, hc⟩, ?_⟩
  simp only [Submonoid.mk_smul, smul_eq_mul, smul_zero]
  have h2 := X_mul_divX_add (m : A[X])
  rw [coeff_zero_of_mem_twist I hm, C_0, add_zero] at h2
  apply Subtype.ext
  have h3 := congrArg (fun p : reesAlgebra I => X * (p : A[X])) hc'
  simp only [Subalgebra.coe_mul, ZeroMemClass.coe_zero, mul_zero] at h3
  change (c : A[X]) * ((s : A[X]) * m) = 0
  rw [← h2]
  change X * ((c : A[X]) * divX (m : A[X])) = 0 at h3
  linear_combination (s : A[X]) * h3

end Algebra

/-! ### Morphisms into a module glued along a locally directed cover -/

namespace CompatibleFamilies

variable {T : TopCat.{u}} (S : Sheaf (Opens.grothendieckTopology T) RingCat.{u})
  {ι B : Type u} (P : ι → SheafOfModules.{u} S) (src tgt : B → ι)
  (α : ∀ b, P (src b) ⟶ P (tgt b))

/-- A morphism into the sheaf of compatible families, from compatible morphisms into the
components. -/
noncomputable def lift {G : SheafOfModules.{u} S} (φ : ∀ i, G ⟶ P i)
    (hφ : ∀ b, φ (src b) ≫ α b = φ (tgt b)) : G ⟶ sheaf S P src tgt α where
  val :=
    { app V := ModuleCat.ofHom (X := G.val.obj V) (Y := (sheaf S P src tgt α).val.obj V)
        { toFun t := ⟨fun i => (φ i).val.app V t, fun b => by
            change ((φ (src b)).val ≫ (α b).val).app V t = _
            rw [← SheafOfModules.comp_val, hφ b]⟩
          map_add' _ _ := Subtype.ext <| funext fun i => map_add _ _ _
          map_smul' _ _ := Subtype.ext <| funext fun i => map_smul _ _ _ }
      naturality f := by
        ext t
        exact Subtype.ext <| funext fun i => PresheafOfModules.naturality_apply (φ i).val f t }

@[reassoc (attr := simp)]
theorem lift_π {G : SheafOfModules.{u} S} (φ : ∀ i, G ⟶ P i)
    (hφ : ∀ b, φ (src b) ≫ α b = φ (tgt b)) (i : ι) :
    lift S P src tgt α φ hφ ≫ π S P src tgt α i = φ i :=
  SheafOfModules.hom_ext <| PresheafOfModules.hom_ext fun _ => by ext; rfl

end CompatibleFamilies

namespace DirectedModuleGluing.Data

open Scheme.Modules

variable {Y : Scheme.{u}} {𝒰 : Scheme.OpenCover.{u} Y} [Category.{u} 𝒰.I₀]
  [Quiver.IsThin 𝒰.I₀] [𝒰.LocallyDirected] (D : Data 𝒰) (G : Y.Modules)
  (e : ∀ k, G.restrict (𝒰.f k) ≅ D.M k)

/-- Isomorphisms `G|_{𝒰.X k} ≅ M k` compatible with the transition isomorphisms, in the form of
`Data.ψ_compat`. -/
def CompatibleIsos : Prop :=
  ∀ {i j : 𝒰.I₀} (f : i ⟶ j),
    (restrictFunctorCongr (𝒰.trans_map f)).inv.app G ≫
      (restrictFunctorComp (𝒰.trans f) (𝒰.f j)).hom.app G ≫
      (restrictFunctor (𝒰.trans f)).map (e j).hom ≫ (D.θ f).hom = (e i).hom

/-- The adjoint `G ⟶ (𝒰.f k)_* M k` of `e k`. -/
noncomputable def liftComponent (k : 𝒰.I₀) : G ⟶ D.P k :=
  (restrictAdjunction (𝒰.f k)).homEquiv _ _ (e k).hom

omit [Quiver.IsThin 𝒰.I₀] in
theorem liftComponent_app (k : 𝒰.I₀) (W : Y.Opens) (t : Γ(G, W)) :
    (D.liftComponent G e k).app W t = (e k).hom.app (𝒰.f k ⁻¹ᵁ W)
      (G.presheaf.map (homOfLE ((𝒰.f k).image_preimage_le W)).op t) := by
  simp [liftComponent, Adjunction.homEquiv_unit]
  rfl

omit [Quiver.IsThin 𝒰.I₀] in
theorem liftComponent_compat (he : D.CompatibleIsos G e) (b : Arr (𝒰 := 𝒰)) :
    D.liftComponent G e b.2.1 ≫ D.α b = D.liftComponent G e b.1 := by
  obtain ⟨i, j, f⟩ := b
  apply Scheme.Modules.hom_ext
  intro W
  ext t
  change (D.α ⟨i, j, f⟩).app W ((D.liftComponent G e j).app W t) =
    (D.liftComponent G e i).app W t
  rw [liftComponent_app, liftComponent_app, ← he f]
  erw [D.α_apply ⟨i, j, f⟩ W]
  simp only [Hom.comp_app, restrictFunctorCongr_inv_app_app, restrictFunctorComp_hom_app_app]
  change (D.θ f).hom.app (𝒰.f i ⁻¹ᵁ W) ((D.M j).presheaf.map _
      ((e j).hom.app (𝒰.f j ⁻¹ᵁ W) (G.presheaf.map _ t))) =
    (D.θ f).hom.app (𝒰.f i ⁻¹ᵁ W) ((e j).hom.app (𝒰.trans f ''ᵁ (𝒰.f i ⁻¹ᵁ W))
      (G.presheaf.map _ (G.presheaf.map _ (G.presheaf.map _ t))))
  congr 1
  erw [← modules_app_res]
  congr 1
  change G.presheaf.map _ (G.presheaf.map _ t) =
    G.presheaf.map _ (G.presheaf.map _ (G.presheaf.map _ t))
  rw [pmap_comp_apply, pmap_comp_apply, pmap_comp_apply]
  exact congrArg (fun k => G.presheaf.map k t) (Subsingleton.elim _ _)

/-- The morphism `G ⟶ glue` into the glued module, from compatible isomorphisms
`G|_{𝒰.X k} ≅ M k`; its components are the adjoints of the given isomorphisms. -/
noncomputable def liftHom (he : D.CompatibleIsos G e) : G ⟶ D.glue :=
  CompatibleFamilies.lift Y.ringCatSheaf D.P (fun b : Arr (𝒰 := 𝒰) => b.2.1) (fun b => b.1) D.α
    (D.liftComponent G e) (D.liftComponent_compat G e he)

theorem restrict_liftHom_ψ (he : D.CompatibleIsos G e) (k : 𝒰.I₀) :
    (restrictFunctor (𝒰.f k)).map (D.liftHom G e he) ≫ (D.ψ k).hom = (e k).hom := by
  change _ ≫ (restrictFunctor (𝒰.f k)).map (D.πk k) ≫
    (restrictAdjunction (𝒰.f k)).counit.app (D.M k) = _
  rw [← Category.assoc, ← Functor.map_comp]
  change (restrictFunctor (𝒰.f k)).map (D.liftComponent G e k) ≫ _ = _
  exact ((restrictAdjunction (𝒰.f k)).homEquiv_counit (g := D.liftComponent G e k)).symm.trans
    (Equiv.symm_apply_apply _ _)

instance isIso_liftHom (he : D.CompatibleIsos G e) : IsIso (D.liftHom G e he) := by
  refine Scheme.Modules.isIso_of_isIso_restrictFunctor_map _ fun x => ?_
  refine ⟨_, 𝒰.f (𝒰.idx x), inferInstance, ?_, ?_⟩
  · exact (𝒰.covers x)
  · have h : (restrictFunctor (𝒰.f (𝒰.idx x))).map (D.liftHom G e he) =
        (e _).hom ≫ (D.ψ _).inv := by
      rw [← restrict_liftHom_ψ D G e he, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [h]
    infer_instance

/-- **A module with compatible identifications with the pieces is the glued module.** -/
noncomputable def liftIso (he : D.CompatibleIsos G e) : G ≅ D.glue :=
  asIso (D.liftHom G e he)

end DirectedModuleGluing.Data

/-! ### A monomorphism into `𝒪_X` is isomorphic to the ideal sheaf of its image -/

section MonoToUnit

open CategoryTheory.Limits

variable {X : Scheme.{u}} {F : X.Modules} [F.IsQuasicoherent]
  (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf)

private theorem comp_structureSheafToPushforward_eq_zero :
    φ ≫ structureSheafToPushforward (idealSheafDataOfHom φ).subschemeι = 0 := by
  refine Scheme.Modules.hom_ext _ _ fun V => ?_
  ext s
  change Scheme.Modules.Hom.app (structureSheafToPushforward (idealSheafDataOfHom φ).subschemeι)
    V (φ.app V s) = 0
  refine Scheme.Modules.section_eq_zero_of_locally _ fun x hx => ?_
  obtain ⟨W, hW, hxW, hWV⟩ := exists_isAffineOpen_mem_and_subset hx
  refine ⟨W, hWV, hxW, ?_⟩
  erw [← modules_app_res (structureSheafToPushforward (idealSheafDataOfHom φ).subschemeι) hWV,
    ← modules_app_res φ hWV]
  have hmem : φ.app W (F.presheaf.map (homOfLE hWV).op s) ∈
      RingHom.ker ((idealSheafDataOfHom φ).subschemeι.app W).hom := by
    rw [ker_subschemeι_app_idealSheafDataOfHom φ ⟨W, hW⟩]
    exact ⟨_, rfl⟩
  exact hmem

/-- The comparison of `F` with the ideal sheaf of the image of `φ : F ⟶ 𝒪_X`. -/
noncomputable def toImageIdealSheaf :
    F ⟶ closedImmersionIdealSheaf (idealSheafDataOfHom φ).subschemeι :=
  kernel.lift _ φ (comp_structureSheafToPushforward_eq_zero φ)

@[reassoc (attr := simp)]
theorem toImageIdealSheaf_ι :
    toImageIdealSheaf φ ≫ closedImmersionIdealSheafι (idealSheafDataOfHom φ).subschemeι = φ :=
  kernel.lift_ι _ _ _

private theorem toImageIdealSheaf_app_surjective (W : X.affineOpens) :
    Function.Surjective ((toImageIdealSheaf φ).app W) := by
  intro t
  have ht : Scheme.Modules.Hom.app (structureSheafToPushforward (idealSheafDataOfHom φ).subschemeι)
      W ((closedImmersionIdealSheafι (idealSheafDataOfHom φ).subschemeι).app W t) = 0 :=
    congrArg (fun ψ => Scheme.Modules.Hom.app ψ W t)
      (kernel.condition (structureSheafToPushforward (idealSheafDataOfHom φ).subschemeι))
  have hmem : (closedImmersionIdealSheafι (idealSheafDataOfHom φ).subschemeι).app W t ∈
      RingHom.ker ((idealSheafDataOfHom φ).subschemeι.app W).hom := ht
  rw [ker_subschemeι_app_idealSheafDataOfHom] at hmem
  obtain ⟨s, hs⟩ := hmem
  refine ⟨s, modules_app_injective
    (closedImmersionIdealSheafι (idealSheafDataOfHom φ).subschemeι) (W : X.Opens) ?_⟩
  change (toImageIdealSheaf φ ≫ closedImmersionIdealSheafι _).app W s = _
  rw [toImageIdealSheaf_ι]
  exact hs

instance [Mono φ] : Mono (toImageIdealSheaf φ) := mono_of_mono_fac (toImageIdealSheaf_ι φ)

instance : Epi (toImageIdealSheaf φ) := by
  refine Preadditive.epi_of_cokernel_zero (Scheme.Modules.hom_ext _ _ fun V => ?_)
  ext u
  change (cokernel.π (toImageIdealSheaf φ)).app V u = 0
  refine Scheme.Modules.section_eq_zero_of_locally _ fun x hx => ?_
  obtain ⟨W, hW, hxW, hWV⟩ := exists_isAffineOpen_mem_and_subset hx
  refine ⟨W, hWV, hxW, ?_⟩
  rw [← modules_app_res (cokernel.π (toImageIdealSheaf φ)) hWV u]
  obtain ⟨s, hs⟩ := toImageIdealSheaf_app_surjective φ ⟨W, hW⟩
    ((closedImmersionIdealSheaf (idealSheafDataOfHom φ).subschemeι).presheaf.map
      (homOfLE hWV).op u)
  erw [← hs]
  change (toImageIdealSheaf φ ≫ cokernel.π (toImageIdealSheaf φ)).app W s = 0
  rw [cokernel.condition]
  rfl

/-- **A monomorphism `φ : F ⟶ 𝒪_X` from a quasi-coherent module identifies `F` with the ideal
sheaf of its image**, compatibly with the inclusions into `𝒪_X` (`toImageIdealSheaf_ι`); the
argument of Hartshorne II, Proposition 6.18, for an arbitrary such `φ`. -/
noncomputable def imageIdealSheafIso [Mono φ] :
    F ≅ closedImmersionIdealSheaf (idealSheafDataOfHom φ).subschemeι :=
  haveI : IsIso (toImageIdealSheaf φ) := isIso_of_mono_of_epi _
  asIso (toImageIdealSheaf φ)

end MonoToUnit

/-! ### The map `𝒪(1) ⟶ 𝒪` on `Proj A[It]` -/

section ProjMap

open TopologicalSpace Opposite ProjGradedModuleSheaf

variable {A : Type u} [CommRing A] (I : Ideal A)

theorem adjoin_reesGrading_one_eq_top :
    Algebra.adjoin (reesGrading I 0) (reesGrading I 1 : Set (reesAlgebra I)) = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  have hx : x ∈ Subring.closure
      ((reesGrading I 0 : Set (reesAlgebra I)) ∪ reesGrading I 1) := by
    rw [closure_reesGrading_zero_union_one]; exact Subring.mem_top x
  refine Subring.closure_le (t := (Algebra.adjoin (reesGrading I 0)
    (reesGrading I 1 : Set (reesAlgebra I))).toSubring) |>.2 ?_ hx
  rintro y (hy | hy)
  · exact Subalgebra.algebraMap_mem _ (⟨y, hy⟩ : reesGrading I 0)
  · exact Algebra.subset_adjoin hy

theorem exists_reesGrading_one_mem_primeCompl (x : ProjectiveSpectrum (reesGrading I)) :
    ∃ f ∈ reesGrading I 1, f ∈ x.asHomogeneousIdeal.toIdeal.primeCompl :=
  ProjTwistingSheaf.exists_mem_one_notMem (adjoin_reesGrading_one_eq_top I) x

/-- Division by `t` on the sections of `𝒪(1) = S(1)~` over `U`, pointwise. -/
noncomputable def twistDivXSections (U : Opens (ProjectiveSpectrum.top (reesGrading I))) :
    (sheafInType (reesGrading I) (gradedTwist (reesGrading I) 1)).1.obj (op U) →+
      (ProjectiveSpectrum.Proj.structureSheaf (reesGrading I)).1.obj (op U) :=
  AddMonoidHom.mk' (fun s => ⟨fun x => twistDivX I _ (s.1 x), fun x => by
    obtain ⟨V, hxV, i, n, m, hm, t, ht, t_nin, w⟩ := s.2 x
    refine ⟨V, hxV, i, n, ⟨reesShift I m, reesShift_mem I (mem_reesGrading_succ_of_mem_twist I hm)⟩,
      ⟨t, ht⟩, t_nin, fun y => ?_⟩
    exact (congrArg (twistDivX I _) (w y)).trans
      (twistDivX_mk I _ (exists_reesGrading_one_mem_primeCompl I _) _ _ _ _ _ _)⟩)
    fun s t => Subtype.ext <| funext fun x =>
      twistDivX_add I _ (exists_reesGrading_one_mem_primeCompl I x.1) (s.1 x) (t.1 x)

set_option backward.isDefEq.respectTransparency false in
/-- **The map `𝒪(1) ⟶ 𝒪` on `Proj A[It]`**: pointwise division by `t`,
`S(1)_(x) → S_(x)`, `m / s ↦ (m / t) / s`. -/
noncomputable def twistDivXHom :
    projTwistingSheaf (reesGrading I) 1 ⟶
      SheafOfModules.unit (Proj (reesGrading I)).ringCatSheaf :=
  ⟨PresheafOfModules.homMk
    { app := fun U => AddCommGrpCat.ofHom (twistDivXSections I U.unop)
      naturality := fun _ _ _ => rfl }
    fun _ r s => Subtype.ext <| funext fun x =>
      twistDivX_smul I _ (exists_reesGrading_one_mem_primeCompl I x.1) (r.1 x) (s.1 x)⟩

theorem twistDivXSections_injective (U : Opens (ProjectiveSpectrum.top (reesGrading I))) :
    Function.Injective (twistDivXSections I U) := by
  refine (injective_iff_map_eq_zero _).2 fun s hs => Subtype.ext <| funext fun x => ?_
  exact twistDivX_eq_zero I _ (exists_reesGrading_one_mem_primeCompl I x.1) _
    (congrFun (congrArg Subtype.val hs) x)

instance mono_twistDivXHom : Mono (twistDivXHom I) := by
  refine ⟨fun g h e => Scheme.Modules.hom_ext _ _ fun V => ?_⟩
  ext s
  apply twistDivXSections_injective I V
  exact congrArg (fun ψ => Scheme.Modules.Hom.app ψ V s) e

instance isQuasicoherent_projTwistingSheaf_reesGrading :
    (projTwistingSheaf (reesGrading I) 1).IsQuasicoherent :=
  ProjGradedModuleSheaf.isQuasicoherent _ _

/-- **`𝒪(1)` on `Proj A[It]` is the ideal sheaf of the image of division by `t`**: the explicit
isomorphism `𝒪(1) ≅ ker (𝒪 ⟶ i_* 𝒪_Z)`, `Z` the closed subscheme cut out by the image of
`twistDivXHom`. -/
noncomputable def projTwistingSheafIsoImageIdealSheaf :
    projTwistingSheaf (reesGrading I) 1 ≅
      closedImmersionIdealSheaf (idealSheafDataOfHom (twistDivXHom I)).subschemeι :=
  imageIdealSheafIso (twistDivXHom I)

end ProjMap

section Scheme

variable {X : Scheme.{u}}

set_option backward.isDefEq.respectTransparency false in
private theorem appLE_specMap_fromSpec {R : CommRingCat.{u}} {V : X.Opens} (hV : IsAffineOpen V)
    (φ : Γ(X, V) ⟶ R) (h : (⊤ : (Spec R).Opens) ≤ (Spec.map φ ≫ hV.fromSpec) ⁻¹ᵁ V) :
    (Spec.map φ ≫ hV.fromSpec).appLE V ⊤ h = φ ≫ (Scheme.ΓSpecIso R).inv := by
  rw [← cancel_mono (Scheme.ΓSpecIso R).hom, Scheme.Hom.comp_appLE_assoc,
    IsAffineOpen.fromSpec_app_self, Category.assoc, Scheme.Hom.map_appLE_assoc,
    SpecMap_appLE_top_ΓSpecIso, Iso.inv_hom_id_assoc, Category.assoc, Iso.inv_hom_id,
    Category.comp_id]

/-- The pull-back of an ideal sheaf `J` along `Spec R ⟶ Spec Γ(U, 𝒪_X) ≅ U ⊆ X` has global ideal
`φ(J(U)) R`. -/
private theorem ideal_top_comap_specMap_fromSpec (J : X.IdealSheafData) {R : CommRingCat.{u}}
    (U : X.affineOpens) (φ : Γ(X, U) ⟶ R) :
    (J.comap (Spec.map φ ≫ U.2.fromSpec)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      (J.ideal U).map (φ ≫ (Scheme.ΓSpecIso R).inv).hom := by
  have h : (⊤ : (Spec R).Opens) ≤ (Spec.map φ ≫ U.2.fromSpec) ⁻¹ᵁ U := by
    intro x _
    exact U.2.fromSpec_preimage_self.ge (Set.mem_univ ((Spec.map φ).base x))
  rw [← inverseImageIdeal, inverseImageIdeal_ideal _ J U ⟨⊤, isAffineOpen_top _⟩ h]
  exact congrArg (fun g => Ideal.map (CommRingCat.Hom.hom g) (J.ideal U))
    (appLE_specMap_fromSpec U.2 φ h)

/-- For an open immersion `h : Y ⟶ Z` of an affine scheme, the ideal of `K` over the image of `h`
is the transport of the global ideal of `K.comap h`. -/
private theorem ideal_image_top_of_isOpenImmersion {Y Z : Scheme.{u}} [IsAffine Y]
    (K : Z.IdealSheafData)
    (h : Y ⟶ Z) [IsOpenImmersion h] :
    K.ideal ⟨h ''ᵁ ⊤, (isAffineOpen_top Y).image_of_isOpenImmersion h⟩ =
      ((K.comap h).ideal ⟨⊤, isAffineOpen_top _⟩).map (h.appIso ⊤).inv.hom := by
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion, Ideal.map_comap_of_surjective]
  exact fun y => ⟨(h.appIso ⊤).hom y, by simp⟩

end Scheme

namespace QuasiCoherentGradedAlgebra

variable {X : Scheme.{u}} (S : QuasiCoherentGradedAlgebra X)

/-- The chart `Spec S(U)_(f) ≅ D₊(f) ⊆ Proj S(U) ⊆ Proj_X S` over an affine open `U ⊆ X`, for
`f ∈ S(U)₁`. -/
def chartι (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)} (f_deg : f ∈ S.grading U 1) :
    Spec (.of (Away (S.grading U) f)) ⟶ S.relProj :=
  Proj.awayι (S.grading U) f f_deg one_pos ≫ S.projι U

instance (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)} (f_deg : f ∈ S.grading U 1) :
    IsOpenImmersion (S.chartι U f_deg) := by
  unfold chartι; infer_instance

/-- The structure map `Γ(U, 𝒪_X) → S(U)_(f)` of the chart. -/
def chartMap (U : X.AffineZariskiSite) (f : S.obj.obj (.op U)) :
    Γ(X, U.1) ⟶ CommRingCat.of (Away (S.grading U) f) :=
  S.toZero U ≫ CommRingCat.ofHom (fromZeroRingHom (S.grading U) _)

/-- On the chart `D₊(f)`, the projection to `X` is `Spec S(U)_(f) ⟶ Spec Γ(U, 𝒪_X) ≅ U ⊆ X`. -/
theorem chartι_relProjToBase (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)}
    (f_deg : f ∈ S.grading U 1) :
    S.chartι U f_deg ≫ S.relProjToBase = Spec.map (S.chartMap U f) ≫ U.2.fromSpec := by
  rw [chartι, Category.assoc, projι_relProjToBase, projToOpen_ι, Proj.awayι_toSpecZero_assoc,
    ← Spec.map_comp_assoc]
  rfl

/-- The identification `S(U)_(f) ≅ Γ(D₊(f), 𝒪)` of the ring of the chart with the sections of
`Proj_X S` over its image. -/
def chartSectionsIso (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)}
    (f_deg : f ∈ S.grading U 1) :
    CommRingCat.of (Away (S.grading U) f) ≅ Γ(S.relProj, S.chartι U f_deg ''ᵁ ⊤) :=
  (Scheme.ΓSpecIso _).symm ≪≫ ((S.chartι U f_deg).appIso ⊤).symm

/-- The inverse image `π⁻¹J · 𝒪` of an ideal sheaf `J` under `π : Proj_X S ⟶ X`, over the
chart `D₊(f)`: it is generated by the image of `J(U)` in `S(U)_(f)`. -/
theorem inverseImageIdeal_ideal_chart (J : X.IdealSheafData) (U : X.AffineZariskiSite)
    {f : S.obj.obj (.op U)} (f_deg : f ∈ S.grading U 1) :
    (inverseImageIdeal S.relProjToBase J).ideal
        ⟨S.chartι U f_deg ''ᵁ ⊤, (isAffineOpen_top _).image_of_isOpenImmersion _⟩ =
      ((J.ideal ⟨U.1, U.2⟩).map (S.chartMap U f).hom).map (S.chartSectionsIso U f_deg).hom.hom := by
  rw [ideal_image_top_of_isOpenImmersion, inverseImageIdeal,
    ← Scheme.IdealSheafData.comap_comp, S.chartι_relProjToBase U f_deg,
    ideal_top_comap_specMap_fromSpec J ⟨U.1, U.2⟩, Ideal.map_map, Ideal.map_map]
  rfl

theorem exists_chartι_eq (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)}
    (f_deg : f ∈ S.grading U 1) (y : Proj (S.grading U)) (hy : f ∉ y.asHomogeneousIdeal) :
    ∃ z, (S.chartι U f_deg).base z = (S.projι U).base y := by
  have hy' : y ∈ (Proj.awayι (S.grading U) f f_deg one_pos).opensRange := by
    rw [Proj.opensRange_awayι]; exact hy
  obtain ⟨z, rfl⟩ := hy'
  exact ⟨z, rfl⟩

end QuasiCoherentGradedAlgebra

namespace ReesAlgebraSheaf

variable {X : Scheme.{u}} (J : X.IdealSheafData)

/-- The degree-one section `a t` of `⨁_d Jᵈ` over an affine open `U`, for `a ∈ J(U)`. -/
def chartElt (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U) :
    (reesAlgebraSheaf J).obj.obj (.op U) :=
  reesDegOne (idealOn J U) ha

theorem chartElt_mem (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U) :
    chartElt J U ha ∈ (reesAlgebraSheaf J).grading U 1 :=
  reesDegOne_mem _ ha

theorem chartMap_apply (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U)
    (r : Γ(X, U.1)) :
    (reesAlgebraSheaf J).chartMap U (chartElt J U ha) r = reesAwayMap _ ha r :=
  rfl

theorem map_chartMap (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U) :
    (J.ideal ⟨U.1, U.2⟩).map ((reesAlgebraSheaf J).chartMap U (chartElt J U ha)).hom =
      Ideal.span {(reesAlgebraSheaf J).chartMap U (chartElt J U ha) a} :=
  reesAway_map_ideal_eq_span _ ha

theorem chartMap_mem_nonZeroDivisors (U : X.AffineZariskiSite) {a : Γ(X, U.1)}
    (ha : a ∈ idealOn J U) :
    (reesAlgebraSheaf J).chartMap U (chartElt J U ha) a ∈
      nonZeroDivisors (Away ((reesAlgebraSheaf J).grading U) (chartElt J U ha)) :=
  reesAway_algebraMap_mem_nonZeroDivisors _ ha

/-- **The inverse image ideal on a chart**: over `D₊(a t)`, `π⁻¹J · 𝒪` is generated by `a`. -/
theorem inverseImageIdeal_ideal_chart (U : X.AffineZariskiSite) {a : Γ(X, U.1)}
    (ha : a ∈ idealOn J U) :
    (inverseImageIdeal (reesAlgebraSheaf J).relProjToBase J).ideal
        ⟨(reesAlgebraSheaf J).chartι U (chartElt_mem J U ha) ''ᵁ ⊤,
          (isAffineOpen_top _).image_of_isOpenImmersion _⟩ =
      Ideal.span {((reesAlgebraSheaf J).chartSectionsIso U (chartElt_mem J U ha)).hom
        ((reesAlgebraSheaf J).chartMap U (chartElt J U ha) a)} := by
  rw [QuasiCoherentGradedAlgebra.inverseImageIdeal_ideal_chart, map_chartMap, Ideal.map_span,
    Set.image_singleton]

theorem chartSectionsIso_mem_nonZeroDivisors (U : X.AffineZariskiSite) {a : Γ(X, U.1)}
    (ha : a ∈ idealOn J U) :
    ((reesAlgebraSheaf J).chartSectionsIso U (chartElt_mem J U ha)).hom
        ((reesAlgebraSheaf J).chartMap U (chartElt J U ha) a) ∈
      nonZeroDivisors Γ((reesAlgebraSheaf J).relProj,
        (reesAlgebraSheaf J).chartι U (chartElt_mem J U ha) ''ᵁ ⊤) := by
  let E := ((reesAlgebraSheaf J).chartSectionsIso U (chartElt_mem J U ha)).commRingCatIsoToRingEquiv
  rw [← MulEquivClass.map_nonZeroDivisors E]
  exact Submonoid.mem_map_of_mem E (chartMap_mem_nonZeroDivisors J U ha)

/-- **Hartshorne II, Proposition 7.13(a), invertibility.** On `π : Proj_X (⨁_d Jᵈ) ⟶ X`, the
inverse image ideal sheaf `π⁻¹J · 𝒪` is locally generated by one non-zero-divisor. -/
theorem isLocallyPrincipalNonZeroDivisor_inverseImageIdeal :
    (inverseImageIdeal (reesAlgebraSheaf J).relProjToBase J).IsLocallyPrincipalNonZeroDivisor := by
  intro x
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
    (show (reesAlgebraSheaf J).relProjToBase.base x ∈ (⊤ : X.Opens) from trivial)
  let U' : X.AffineZariskiSite := ⟨U, hU⟩
  have hx : x ∈ (reesAlgebraSheaf J).relProjToBase ⁻¹ᵁ U'.1 := hxU
  rw [QuasiCoherentGradedAlgebra.relProjToBase_preimage] at hx
  obtain ⟨y, rfl⟩ := hx
  obtain ⟨f, f_deg, hfy⟩ := ProjTwistingSheaf.exists_mem_one_notMem
    ((reesAlgebraSheaf J).adjoin_eq_top_of_generatedInDegreeOne (generatedInDegreeOne J) U') y
  obtain ⟨a, ha, hfa⟩ := (mem_grading_iff J U' 1 f).1 f_deg
  rw [pow_one] at ha
  obtain rfl : f = chartElt J U' ha := Subtype.ext hfa
  obtain ⟨z, hz⟩ := (reesAlgebraSheaf J).exists_chartι_eq U' (chartElt_mem J U' ha) y hfy
  exact ⟨⟨(reesAlgebraSheaf J).chartι U' (chartElt_mem J U' ha) ''ᵁ ⊤,
    (isAffineOpen_top _).image_of_isOpenImmersion _⟩, ⟨z, trivial, hz⟩, _,
    chartSectionsIso_mem_nonZeroDivisors J U' ha, inverseImageIdeal_ideal_chart J U' ha⟩

end ReesAlgebraSheaf

/-! ### The exceptional divisor of a blowing-up -/

namespace QuasicoherentIdealSubsheaf

open Scheme.CartierDivisor

variable {X : Scheme.{u}} [IsNoetherian X] (I : QuasicoherentIdealSubsheaf X)
  (hI : IsCoherent I.toModules)

/-- **The exceptional ideal** `I_E = π⁻¹I · 𝒪_{X̃}` of the blowing-up `π : X̃ ⟶ X` of `I`, as ideal
sheaf data on `X̃`. -/
def exceptionalIdeal : (I.blowup hI).IdealSheafData :=
  inverseImageIdeal (I.blowupProjection hI) (quasicoherentIdealSubsheafEquiv I)

/-- The exceptional ideal is the inverse image ideal subsheaf `π⁻¹I · 𝒪_{X̃} ⊆ 𝒪_{X̃}`. -/
theorem quasicoherentIdealSubsheafEquiv_inverseImage :
    quasicoherentIdealSubsheafEquiv (I.inverseImage (I.blowupProjection hI)) =
      I.exceptionalIdeal hI :=
  quasicoherentIdealSubsheafEquiv.apply_symm_apply _

/-- **Hartshorne II, Proposition 7.13(a), invertibility.** The exceptional ideal `π⁻¹I · 𝒪_{X̃}`
is locally generated by one non-zero-divisor. -/
theorem isLocallyPrincipalNonZeroDivisor_exceptionalIdeal :
    (I.exceptionalIdeal hI).IsLocallyPrincipalNonZeroDivisor :=
  ReesAlgebraSheaf.isLocallyPrincipalNonZeroDivisor_inverseImageIdeal _

/-- **The exceptional divisor** `E` of the blowing-up: the effective Cartier divisor whose ideal
sheaf is the exceptional ideal `π⁻¹I · 𝒪_{X̃}`. -/
def exceptionalDivisor : (I.blowup hI).CartierDivisor :=
  ((I.blowup hI).effectiveCartierDivisorEquiv.symm
    ⟨I.exceptionalIdeal hI, I.isLocallyPrincipalNonZeroDivisor_exceptionalIdeal hI⟩).1

theorem exceptionalDivisor_isEffective : (I.exceptionalDivisor hI).IsEffective :=
  ((I.blowup hI).effectiveCartierDivisorEquiv.symm
    ⟨I.exceptionalIdeal hI, I.isLocallyPrincipalNonZeroDivisor_exceptionalIdeal hI⟩).2

/-- The ideal sheaf of the exceptional divisor `E` is the exceptional ideal. -/
theorem idealSheafData_exceptionalDivisor :
    idealSheafData (I.exceptionalDivisor_isEffective hI) = I.exceptionalIdeal hI :=
  congrArg Subtype.val ((I.blowup hI).effectiveCartierDivisorEquiv.apply_symm_apply
    ⟨I.exceptionalIdeal hI, I.isLocallyPrincipalNonZeroDivisor_exceptionalIdeal hI⟩)

/-- The exceptional ideal `I_E = π⁻¹I · 𝒪_{X̃}` as an `𝒪_{X̃}`-module: the ideal sheaf of the
closed subscheme it cuts out. -/
def exceptionalIdealSheaf : (I.blowup hI).Modules :=
  closedImmersionIdealSheaf (I.exceptionalIdeal hI).subschemeι

/-- **Hartshorne II, Proposition 7.13(a), `I_E ≅ 𝒪(-E)`.** The exceptional ideal sheaf is
isomorphic to `𝒪_{X̃}(-E)` for the exceptional divisor `E`, by Proposition 6.18. -/
def exceptionalIdealSheafIsoDivisorSheaf :
    I.exceptionalIdealSheaf hI ≅ (-(I.exceptionalDivisor hI)).sheaf :=
  eqToIso (congrArg (fun K : (I.blowup hI).IdealSheafData => closedImmersionIdealSheaf K.subschemeι)
      (I.idealSheafData_exceptionalDivisor hI).symm) ≪≫
    (idealSheafIso (I.exceptionalDivisor_isEffective hI)).symm

/-- **The exceptional ideal sheaf is invertible.** -/
theorem isInvertible_exceptionalIdealSheaf : (I.exceptionalIdealSheaf hI).IsInvertible := by
  intro x
  obtain ⟨U, hxU, ⟨e⟩⟩ := (-(I.exceptionalDivisor hI)).isInvertible_sheaf x
  exact ⟨U, hxU, ⟨(Scheme.Modules.restrictFunctor U.ι).mapIso
    (I.exceptionalIdealSheafIsoDivisorSheaf hI) ≪≫ e⟩⟩

end QuasicoherentIdealSubsheaf

/-! ### Identifying the exceptional ideal sheaf with `𝒪(1)` -/

section ImageIdeal

open CategoryTheory.Limits

variable {X : Scheme.{u}}

attribute [local instance] isQuasicoherent_closedImmersionIdealSheaf

/-- Over an affine open, the sections of the ideal sheaf of the closed subscheme cut out by `K`
are exactly `K(W)`. -/
theorem homRangeIdeal_closedImmersionIdealSheafι (K : X.IdealSheafData) (W : X.affineOpens) :
    homRangeIdeal (closedImmersionIdealSheafι K.subschemeι) W = K.ideal W := by
  ext r
  rw [mem_homRangeIdeal, ← K.ker_subschemeι_app W, RingHom.mem_ker]
  let S := ShortComplex.mk (C := SheafOfModules.{u} X.ringCatSheaf)
    (closedImmersionIdealSheafι K.subschemeι)
    (structureSheafToPushforward K.subschemeι) (kernel.condition _)
  have hS : S.Exact := ShortComplex.exact_of_f_is_kernel S (kernelIsKernel _)
  have : Mono S.f := (inferInstance : Mono (closedImmersionIdealSheafι _))
  constructor
  · rintro ⟨a, rfl⟩
    exact congrArg (fun ψ => Scheme.Modules.Hom.app ψ W a)
      (kernel.condition (structureSheafToPushforward K.subschemeι))
  · intro hr
    exact modules_sections_exact hS r hr

theorem idealSheafDataOfHom_closedImmersionIdealSheafι (K : X.IdealSheafData) :
    idealSheafDataOfHom (closedImmersionIdealSheafι K.subschemeι) = K :=
  Scheme.IdealSheafData.ext (funext fun W => homRangeIdeal_closedImmersionIdealSheafι K W)

variable {Y : Scheme.{u}} {F : X.Modules} (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf)
  (j : Y ⟶ X) [IsOpenImmersion j]

/-- The restriction of `φ : F ⟶ 𝒪_X` along an open immersion `j : Y ⟶ X`, as a morphism
`F|_Y ⟶ 𝒪_Y`. -/
def restrictToUnit : F.restrict j ⟶ SheafOfModules.unit Y.ringCatSheaf :=
  (Scheme.Modules.restrictFunctor j).map φ ≫ (Scheme.Modules.restrictUnitIso j).hom

instance [Mono φ] : Mono (restrictToUnit φ j) := by
  refine ⟨fun g h e => Scheme.Modules.hom_ext _ _ fun V => ?_⟩
  ext s
  refine modules_app_injective φ (j ''ᵁ V) ?_
  refine (ConcreteCategory.bijective_of_isIso (j.appIso V).hom).1 ?_
  exact congrArg (fun ψ => Scheme.Modules.Hom.app ψ V s) e

theorem restrictToUnit_app (W : Y.Opens) (a : Γ(F.restrict j, W)) :
    (restrictToUnit φ j).app W a = (j.appIso W).hom (φ.app (j ''ᵁ W) a) :=
  rfl

instance [F.IsQuasicoherent] : (F.restrict j).IsQuasicoherent :=
  Scheme.Modules.isQuasicoherent_restrictFunctor j F

theorem idealSheafDataOfHom_restrictToUnit [F.IsQuasicoherent] :
    idealSheafDataOfHom (restrictToUnit φ j) = (idealSheafDataOfHom φ).comap j := by
  refine Scheme.IdealSheafData.ext (funext fun W => Ideal.ext fun r => ?_)
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion, Ideal.mem_comap,
    idealSheafDataOfHom_ideal, idealSheafDataOfHom_ideal, mem_homRangeIdeal, mem_homRangeIdeal]
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨a, (ConcreteCategory.congr_hom (j.appIso W).hom_inv_id _).symm⟩
  · rintro ⟨a, ha⟩
    refine ⟨a, ?_⟩
    change (j.appIso W).hom (φ.app (j ''ᵁ W) a) = r
    exact (congrArg (j.appIso W).hom ha).trans
      (ConcreteCategory.congr_hom (j.appIso W).inv_hom_id r)

variable [F.IsQuasicoherent] [Mono φ]

omit [Mono φ] in
set_option backward.isDefEq.respectTransparency false in
private theorem comp_structureSheafToPushforward_eq_zero_of_eq (K : X.IdealSheafData)
    (h : idealSheafDataOfHom φ = K) : φ ≫ structureSheafToPushforward K.subschemeι = 0 := by
  subst h
  have e : φ ≫ structureSheafToPushforward (idealSheafDataOfHom φ).subschemeι =
      toImageIdealSheaf φ ≫ closedImmersionIdealSheafι (idealSheafDataOfHom φ).subschemeι ≫
        structureSheafToPushforward (idealSheafDataOfHom φ).subschemeι := by
    rw [← Category.assoc, toImageIdealSheaf_ι]
  rw [e, closedImmersionIdealSheafι, kernel.condition, Limits.comp_zero]

/-- The comparison of `F` with the ideal sheaf of `K`, for `K` the image ideal of `φ`. -/
def toIdealSheafOfEq (K : X.IdealSheafData) (h : idealSheafDataOfHom φ = K) :
    F ⟶ closedImmersionIdealSheaf K.subschemeι :=
  kernel.lift _ φ (comp_structureSheafToPushforward_eq_zero_of_eq φ K h)

omit [Mono φ] in
theorem toIdealSheafOfEq_ι (K : X.IdealSheafData) (h : idealSheafDataOfHom φ = K) :
    toIdealSheafOfEq φ K h ≫ closedImmersionIdealSheafι K.subschemeι = φ :=
  kernel.lift_ι _ _ _

instance isIso_toIdealSheafOfEq (K : X.IdealSheafData) (h : idealSheafDataOfHom φ = K) :
    IsIso (toIdealSheafOfEq φ K h) := by
  subst h
  exact (imageIdealSheafIso φ).isIso_hom

variable {G : X.Modules} [G.IsQuasicoherent]
  (ψ : G ⟶ SheafOfModules.unit X.ringCatSheaf) [Mono ψ]

/-- Two monomorphisms into `𝒪_X` from quasi-coherent modules with the same image ideals have
isomorphic sources, compatibly with the inclusions. -/
def isoOfIdealSheafDataOfHomEq (h : idealSheafDataOfHom φ = idealSheafDataOfHom ψ) : F ≅ G :=
  asIso (toIdealSheafOfEq φ _ h) ≪≫ (asIso (toIdealSheafOfEq ψ _ rfl)).symm

set_option backward.isDefEq.respectTransparency false in
theorem isoOfIdealSheafDataOfHomEq_hom_comp (h : idealSheafDataOfHom φ = idealSheafDataOfHom ψ) :
    (isoOfIdealSheafDataOfHomEq φ ψ h).hom ≫ ψ = φ := by
  have h1 : inv (toIdealSheafOfEq ψ _ rfl) ≫ ψ =
      closedImmersionIdealSheafι (idealSheafDataOfHom ψ).subschemeι := by
    rw [IsIso.inv_comp_eq, toIdealSheafOfEq_ι]
  simp only [isoOfIdealSheafDataOfHomEq, Iso.trans_hom, Iso.symm_hom, asIso_hom, asIso_inv]
  rw [Category.assoc, h1, toIdealSheafOfEq_ι]

end ImageIdeal

section Coherence

variable {X Y W : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ W) [IsOpenImmersion f] [IsOpenImmersion g]

private theorem restrictUnitIso_comp' :
    (Scheme.Modules.restrictFunctorComp f g).hom.app _ ≫
        (Scheme.Modules.restrictFunctor f).map (Scheme.Modules.restrictUnitIso g).hom ≫
          (Scheme.Modules.restrictUnitIso f).hom =
      (Scheme.Modules.restrictUnitIso (f ≫ g)).hom := by
  refine Scheme.Modules.hom_ext _ _ fun U => ?_
  ext x
  exact (congr(ConcreteCategory.hom ($(Scheme.Hom.comp_appIso f g U)).hom x)).symm

set_option backward.isDefEq.respectTransparency false in
private theorem restrictFunctorCongr_inv_restrictUnitIso {f f' : X ⟶ Y} [IsOpenImmersion f]
    [IsOpenImmersion f'] (h : f = f') :
    (Scheme.Modules.restrictFunctorCongr h).inv.app _ ≫ (Scheme.Modules.restrictUnitIso f).hom =
      (Scheme.Modules.restrictUnitIso f').hom := by
  subst h
  refine Scheme.Modules.hom_ext _ _ fun U => ?_
  ext x
  simp only [Scheme.Modules.Hom.comp_app, Scheme.Modules.restrictFunctorCongr_inv_app_app,
    eqToHom_refl, op_id, CategoryTheory.Functor.map_id, ConcreteCategory.comp_apply]
  rfl

end Coherence

/-! ### Division by `t` and the transition maps -/

theorem reesShift_reesMap {R R' : Type u} [CommRing R] [CommRing R'] {I : Ideal R}
    {I' : Ideal R'} (φ : R →+* R') (h : I.map φ ≤ I') (y : reesAlgebra I) :
    reesShift I' (reesMap φ h y) = reesMap φ h (reesShift I y) := by
  apply Subtype.ext
  ext n
  change (divX ((y : R[X]).map φ)).coeff n = ((divX (y : R[X])).map φ).coeff n
  rw [coeff_divX, coeff_map, coeff_map, coeff_divX]

section Transition

open HomogeneousIdeal Graded Scheme.Modules

variable {R R' : Type u} [CommRing R] [CommRing R'] {I : Ideal R} {I' : Ideal R'}
  (ψ : reesGrading I →+*ᵍ reesGrading I') (hψ : ∀ y, reesShift I' (ψ y) = ψ (reesShift I y))

include hψ in
set_option backward.isDefEq.respectTransparency false in
theorem twistDivX_twistFiber {P : Submonoid (reesAlgebra I)} {Q : Submonoid (reesAlgebra I')}
    (h : P ≤ Q.comap ψ) (hP : ∃ f ∈ reesGrading I 1, f ∈ P) (hQ : ∃ f ∈ reesGrading I' 1, f ∈ Q)
    (z : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1) P) :
    twistDivX I' Q (ProjTwistMap.twistFiber ψ 1 h z) =
      HomogeneousLocalization.map ψ h (twistDivX I P z) := by
  obtain ⟨n, m, hm, s, hs, hsx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective z
  rw [ProjTwistMap.twistFiber_mk, twistDivX_mk I' Q hQ, twistDivX_mk I P hP,
    HomogeneousLocalization.map_mk]
  apply HomogeneousLocalization.val_injective
  simp only [HomogeneousLocalization.val_mk, hψ]

variable (hf : (reesGrading I')₊ ≤ (reesGrading I)₊.map ψ) [IsOpenImmersion (Proj.map ψ hf)]

include hψ in
set_option backward.isDefEq.respectTransparency false in
/-- Division by `t` commutes with the transition maps of the twisting sheaves. -/
theorem twistRestrictHom_comp_twistDivXHom :
    ProjTwistMap.twistRestrictHom ψ hf 1 ≫ twistDivXHom I' =
      (restrictFunctor (Proj.map ψ hf)).map (twistDivXHom I) ≫
        (restrictUnitIso (Proj.map ψ hf)).hom := by
  refine Scheme.Modules.hom_ext _ _ fun W => ?_
  ext s
  refine Subtype.ext (funext fun y => ?_)
  have e := twistDivX_twistFiber ψ hψ (ProjTwistMap.primeCompl_le_comap ψ hf y.1)
    (exists_reesGrading_one_mem_primeCompl I _) (exists_reesGrading_one_mem_primeCompl I' y.1)
    (s.1 ⟨_, y.1, y.2, rfl⟩)
  refine e.trans ?_
  change _ = ((((Proj.map ψ hf).appIso W).hom (twistDivXSections I _ s)) :
    (ProjectiveSpectrum.Proj.structureSheaf (reesGrading I')).1.obj (Opposite.op W)).1 y
  rw [Scheme.Hom.appIso_hom]
  rfl

end Transition

/-! ### The image of division by `t` on the charts -/

section ChartPart

set_option backward.isDefEq.respectTransparency.types false

section ChartSurj

open ProjGradedModuleSheaf Opposite TopologicalSpace

variable {A' σ : Type u} [CommRing A'] [SetLike σ A'] [AddSubgroupClass σ A']
  (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {M σM : Type u} [AddCommGroup M] [Module A' M] [SetLike σM M] [AddSubgroupClass σM M]
  (ℳ : ℤ → σM) [SetLike.GradedSMul 𝒜 ℳ] [DirectSum.Decomposition ℳ]
  {f : A'} {d : ℕ} (f_deg : f ∈ 𝒜 d) (hd : 0 < d)

set_option backward.isDefEq.respectTransparency.types false in
private theorem toChartΓ_surjective' : Function.Surjective (toChartΓ 𝒜 ℳ f_deg hd) := by
  intro t
  obtain ⟨m, rfl⟩ :=
    (ConcreteCategory.bijective_of_isIso (awayModuleIsoChartSections 𝒜 ℳ f_deg hd).hom).2 t
  refine ⟨m, ?_⟩
  change _ = (modulesSpecToSheaf.map (fromTildeChart 𝒜 ℳ f_deg hd)).1.app (op ⊤)
    (tilde.toOpen (awayModule 𝒜 ℳ f) ⊤ m)
  rw [fromTildeChart_app_toOpen]
  have : (homOfLE le_top : (⊤ : (Spec (.of (Away 𝒜 f))).Opens) ⟶ ⊤) = 𝟙 _ :=
    Subsingleton.elim _ _
  rw [this, op_id, CategoryTheory.Functor.map_id]
  rfl

private theorem exists_eq_mapOfLE_of_chart
    (s : Γ(projGradedModuleSheaf 𝒜 ℳ, (Proj.awayι 𝒜 f f_deg hd) ''ᵁ ⊤)) :
    ∃ m : HomogeneousLocalizedModule 𝒜 ℳ (Submonoid.powers f), ∀ x,
      (show (sheafInType 𝒜 ℳ).1.obj (op ((Proj.awayι 𝒜 f f_deg hd) ''ᵁ ⊤)) from s).1 x =
      HomogeneousLocalizedModule.mapOfLE 𝒜 ℳ (powers_le_of_mem 𝒜 f_deg hd x.2) m := by
  obtain ⟨m, hm⟩ := toChartΓ_surjective' 𝒜 ℳ f_deg hd s
  refine ⟨m, fun x => ?_⟩
  exact (congrArg (fun t => chartEval t x.1 x.2) hm).symm

end ChartSurj

section ChartImage

open ProjGradedModuleSheaf Opposite TopologicalSpace

variable {A : Type u} [CommRing A] (I : Ideal A) {a : A} (ha : a ∈ I)

theorem twistDivX_mapOfLE {T : Submonoid (reesAlgebra I)}
    (h : Submonoid.powers (reesDegOne I ha) ≤ T) (hT : ∃ f ∈ reesGrading I 1, f ∈ T)
    (y : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1)
      (Submonoid.powers (reesDegOne I ha))) :
    twistDivX I T (HomogeneousLocalizedModule.mapOfLE _ _ h y) =
      HomogeneousLocalization.mapId _ h (reesTwistAwayToAway I ha y) := by
  obtain ⟨n, m, hm, t, ht, htx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective y
  rw [HomogeneousLocalizedModule.mapOfLE_mk, twistDivX_mk I _ hT, reesTwistAwayToAway_mk,
    HomogeneousLocalization.map_mk]
  rfl

theorem twistDivXHom_app_eq_of_values
    (s : Γ(projTwistingSheaf (reesGrading I) 1,
      Proj.awayι (reesGrading I) (reesDegOne I ha) (reesDegOne_mem I ha) one_pos ''ᵁ ⊤))
    (y : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1)
      (Submonoid.powers (reesDegOne I ha)))
    (hs : ∀ x, (show (sheafInType (reesGrading I) (gradedTwist (reesGrading I) 1)).1.obj
      (op (Proj.awayι (reesGrading I) (reesDegOne I ha) (reesDegOne_mem I ha) one_pos ''ᵁ ⊤))
        from s).1 x = HomogeneousLocalizedModule.mapOfLE _ _
      (powers_le_of_mem (reesGrading I) (reesDegOne_mem I ha) one_pos x.2) y) :
    (twistDivXHom I).app _ s = ((Proj.awayι (reesGrading I) (reesDegOne I ha)
        (reesDegOne_mem I ha) one_pos).appIso ⊤).inv
        ((Scheme.ΓSpecIso _).inv (reesTwistAwayToAway I ha y)) := by
  rw [awayι_appIso_inv_top]
  refine Subtype.ext (funext fun x => ?_)
  change twistDivX I _ ((show (sheafInType (reesGrading I) (gradedTwist (reesGrading I) 1)).1.obj
      (op (Proj.awayι (reesGrading I) (reesDegOne I ha) (reesDegOne_mem I ha) one_pos ''ᵁ ⊤))
        from s).1 x) = HomogeneousLocalization.mapId _ _ (reesTwistAwayToAway I ha y)
  rw [hs x]
  exact twistDivX_mapOfLE I ha _ (exists_reesGrading_one_mem_primeCompl I _) y

set_option maxHeartbeats 800000 in
/-- **The image of division by `t` on a chart**: over `D₊(a t)`, the image of `𝒪(1) ⟶ 𝒪` is the
ideal generated by `I`. -/
theorem homRangeIdeal_twistDivXHom_chart :
    homRangeIdeal (twistDivXHom I)
        (Proj.awayι (reesGrading I) (reesDegOne I ha) (reesDegOne_mem I ha) one_pos ''ᵁ ⊤) =
      ((I.map (reesAwayMap I ha)).map (Scheme.ΓSpecIso
        (CommRingCat.of (Away (reesGrading I) (reesDegOne I ha)))).inv.hom).map
        ((Proj.awayι (reesGrading I) (reesDegOne I ha) (reesDegOne_mem I ha) one_pos).appIso
          ⊤).inv.hom := by
  have hs1 : Function.Surjective (Scheme.ΓSpecIso
      (CommRingCat.of (Away (reesGrading I) (reesDegOne I ha)))).inv.hom :=
    (ConcreteCategory.bijective_of_isIso _).2
  have hs2 : Function.Surjective ((Proj.awayι (reesGrading I) (reesDegOne I ha)
      (reesDegOne_mem I ha) one_pos).appIso ⊤).inv.hom :=
    (ConcreteCategory.bijective_of_isIso _).2
  ext r
  rw [mem_homRangeIdeal, Ideal.mem_map_iff_of_surjective _ hs2]
  simp only [Ideal.mem_map_iff_of_surjective _ hs1, ← range_reesTwistAwayToAway I ha,
    LinearMap.mem_range]
  constructor
  · rintro ⟨s, rfl⟩
    obtain ⟨y, hy⟩ := exists_eq_mapOfLE_of_chart (reesGrading I) (gradedTwist (reesGrading I) 1)
      (reesDegOne_mem I ha) one_pos s
    exact ⟨_, ⟨_, ⟨y, rfl⟩, rfl⟩, (twistDivXHom_app_eq_of_values I ha s y hy).symm⟩
  · rintro ⟨_, ⟨_, ⟨y, rfl⟩, rfl⟩, rfl⟩
    exact ⟨toChartSection (reesGrading I) (gradedTwist (reesGrading I) 1) (reesDegOne_mem I ha)
      one_pos y, twistDivXHom_app_eq_of_values I ha _ y fun x => rfl⟩

end ChartImage

namespace ReesAlgebraSheaf

open Scheme.Modules

variable {X : Scheme.{u}} (J : X.IdealSheafData)

theorem awayι_projToOpen_ι (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U) :
    Proj.awayι _ (chartElt J U ha) (chartElt_mem J U ha) one_pos ≫
        (reesAlgebraSheaf J).projToOpen U ≫ U.1.ι =
      Spec.map ((reesAlgebraSheaf J).chartMap U (chartElt J U ha)) ≫ U.2.fromSpec := by
  rw [QuasiCoherentGradedAlgebra.projToOpen_ι, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp_assoc]
  rfl

/-- Division by `t` on the piece `Proj S(U)`. -/
def pieceDivX (U : X.AffineZariskiSite) :
    (reesAlgebraSheaf J).twistingSheaf 1 U ⟶
      SheafOfModules.unit (Proj ((reesAlgebraSheaf J).grading U)).ringCatSheaf :=
  twistDivXHom (idealOn J U)

instance (U : X.AffineZariskiSite) : Mono (pieceDivX J U) := mono_twistDivXHom _

instance (U : X.AffineZariskiSite) : ((reesAlgebraSheaf J).twistingSheaf 1 U).IsQuasicoherent :=
  ProjGradedModuleSheaf.isQuasicoherent _ _

set_option maxHeartbeats 400000 in
theorem homRangeIdeal_pieceDivX_chart (U : X.AffineZariskiSite) {a : Γ(X, U.1)}
    (ha : a ∈ idealOn J U) :
    homRangeIdeal (pieceDivX J U)
        (Proj.awayι _ (chartElt J U ha) (chartElt_mem J U ha) one_pos ''ᵁ ⊤) =
      (((J.ideal ⟨U.1, U.2⟩).map ((reesAlgebraSheaf J).chartMap U (chartElt J U ha)).hom).map
        (Scheme.ΓSpecIso _).inv.hom).map
        ((Proj.awayι _ (chartElt J U ha) (chartElt_mem J U ha) one_pos).appIso ⊤).inv.hom :=
  homRangeIdeal_twistDivXHom_chart (idealOn J U) ha

set_option maxHeartbeats 400000 in
theorem ideal_pieceDivX_chart (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U) :
    (idealSheafDataOfHom (pieceDivX J U)).ideal
        ⟨Proj.awayι _ (chartElt J U ha) (chartElt_mem J U ha) one_pos ''ᵁ ⊤,
          (isAffineOpen_top _).image_of_isOpenImmersion _⟩ =
      (inverseImageIdeal ((reesAlgebraSheaf J).projToOpen U ≫ U.1.ι) J).ideal
        ⟨Proj.awayι _ (chartElt J U ha) (chartElt_mem J U ha) one_pos ''ᵁ ⊤,
          (isAffineOpen_top _).image_of_isOpenImmersion _⟩ := by
  refine (homRangeIdeal_pieceDivX_chart J U ha).trans ?_
  rw [ideal_image_top_of_isOpenImmersion, inverseImageIdeal,
      ← Scheme.IdealSheafData.comap_comp, awayι_projToOpen_ι J U ha,
      ideal_top_comap_specMap_fromSpec J ⟨U.1, U.2⟩, CommRingCat.hom_comp, ← Ideal.map_map]

set_option maxHeartbeats 400000 in
theorem idealSheafDataOfHom_pieceDivX (U : X.AffineZariskiSite) :
    idealSheafDataOfHom (pieceDivX J U) =
      inverseImageIdeal ((reesAlgebraSheaf J).projToOpen U ≫ U.1.ι) J := by
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top (ι := {a // a ∈ idealOn J U})
    (fun a => ⟨Proj.awayι _ (chartElt J U a.2) (chartElt_mem J U a.2) one_pos ''ᵁ ⊤,
      (isAffineOpen_top _).image_of_isOpenImmersion _⟩) ?_ fun a => ?_
  · refine eq_top_iff.2 fun y _ => ?_
    obtain ⟨f, f_deg, hfy⟩ := ProjTwistingSheaf.exists_mem_one_notMem
      ((reesAlgebraSheaf J).adjoin_eq_top_of_generatedInDegreeOne (generatedInDegreeOne J) U) y
    obtain ⟨a, ha, hfa⟩ := (mem_grading_iff J U 1 f).1 f_deg
    rw [pow_one] at ha
    obtain rfl : f = chartElt J U ha := Subtype.ext hfa
    refine TopologicalSpace.Opens.mem_iSup.2 ⟨⟨a, ha⟩, ?_⟩
    change y ∈ Proj.awayι _ _ _ _ ''ᵁ ⊤
    rw [Scheme.Hom.image_top_eq_opensRange, Proj.opensRange_awayι]
    exact hfy
  · exact ideal_pieceDivX_chart J U a.2

end ReesAlgebraSheaf

