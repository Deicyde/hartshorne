import Hartshorne.Scheme.ReesAlgebraBlowup
import Hartshorne.Scheme.RelativeSpec
import Hartshorne.Scheme.RelativeProjTwistingSheaf
import Hartshorne.Scheme.EffectiveCartierIdealSheaf

/-!
# The exceptional ideal of a blowing-up

Hartshorne, *Algebraic Geometry*, II, Proposition 7.13(a) (p. 164); see also Stacks Project,
tag 01OF.

Let `I` be a quasi-coherent sheaf of ideals on `X`, `𝒮 = ⨁_{d ≥ 0} Iᵈ` its sheaf of Rees algebras
and `π : X̃ = Proj_X 𝒮 ⟶ X`. Over an affine open `U ⊆ X` with `A = Γ(U, 𝒪_X)` and `I = Γ(U, I)`,
`X̃` is `Proj A[It]`, covered by the charts `D₊(a t) = Spec A[It]_(a t)` with `a ∈ I`. On such a
chart the ideal generated by `I` is generated by `a`, which is a non-zero-divisor: for `b ∈ I`,
`b = a · (b t)/(a t)`. So the inverse image ideal `I_E = π⁻¹I · 𝒪_{X̃}` is locally generated by one
non-zero-divisor; it is the ideal sheaf of an effective Cartier divisor `E`, and `I_E ≅ 𝒪(-E)` by
Proposition 6.18. On the chart, the shifted Rees module `S(1)_(a t)` maps isomorphically onto the
ideal `I · S_(a t)` by `y / (a t)ⁿ ↦ (y / t) / (a t)ⁿ`; this is the local form of `I_E ≅ 𝒪(1)`.

## Main results

* `Hartshorne.reesAway_map_ideal_eq_span`, `Hartshorne.reesAway_algebraMap_mem_nonZeroDivisors`:
  on `A[It]_(a t)`, `I` generates the ideal `(a)` and `a` is a non-zero-divisor.
* `Hartshorne.reesTwistAwayToAway`, `reesTwistAwayToAway_injective`,
  `range_reesTwistAwayToAway`, `reesTwistAwayToAway_mk`: the injective map
  `S(1)_(a t) → S_(a t)`, `y / s ↦ (y / t) / s`, with image `I · S_(a t)`.
* `Hartshorne.ReesAlgebraSheaf.isLocallyPrincipalNonZeroDivisor_inverseImageIdeal`: `π⁻¹J · 𝒪`
  is locally generated by one non-zero-divisor, for any ideal sheaf data `J`.
* `Hartshorne.QuasicoherentIdealSubsheaf.exceptionalIdeal`, `exceptionalDivisor`,
  `exceptionalIdealSheaf`, `exceptionalIdealSheafIsoDivisorSheaf`,
  `isInvertible_exceptionalIdealSheaf`: for the blowing-up of a coherent `I` on a Noetherian `X`,
  the exceptional ideal, its effective Cartier divisor `E`, `I_E ≅ 𝒪(-E)`, and invertibility.
-/

noncomputable section

open CategoryTheory Polynomial AlgebraicGeometry HomogeneousLocalization

universe u

namespace Hartshorne

section Algebra

variable {A : Type u} [CommRing A] (I : Ideal A) {a : A} (ha : a ∈ I)

/-- The degree-one element `a t` of the Rees algebra `A[It]`, for `a ∈ I`. -/
def reesDegOne : reesAlgebra I :=
  ⟨monomial 1 a, reesAlgebra.monomial_mem.2 (by rwa [pow_one])⟩

theorem reesDegOne_mem : reesDegOne I ha ∈ reesGrading I 1 :=
  fun m hm => by simp [reesDegOne, coeff_monomial, Ne.symm hm]

/-- The structure map `A → A[It]_(a t)` into the degree-zero localization at `a t`. -/
def reesAwayMap : A →+* Away (reesGrading I) (reesDegOne I ha) :=
  (fromZeroRingHom (reesGrading I) _).comp
    { toFun r := ⟨algebraMap A (reesAlgebra I) r, algebraMap_mem_reesGrading_zero I r⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' _ _ := Subtype.ext (map_mul _ _ _)
      map_zero' := Subtype.ext (map_zero _)
      map_add' _ _ := Subtype.ext (map_add _ _ _) }

theorem val_reesAwayMap (r : A) :
    (reesAwayMap I ha r).val = Localization.mk (algebraMap A (reesAlgebra I) r) 1 :=
  rfl

/-- **On the chart `D₊(a t)`, the ideal generated by `I` is generated by `a`**: for `b ∈ I`,
`b = a · (b t)/(a t)` in `A[It]_(a t)`. -/
theorem reesAway_map_ideal_eq_span :
    I.map (reesAwayMap I ha) = Ideal.span {reesAwayMap I ha a} := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.2 fun b hb => ?_)
    ((Ideal.span_singleton_le_iff_mem _).2 (Ideal.mem_map_of_mem _ ha))
  rw [Ideal.mem_comap, Ideal.mem_span_singleton']
  refine ⟨HomogeneousLocalization.mk ⟨1, ⟨reesDegOne I hb, reesDegOne_mem I hb⟩,
    ⟨reesDegOne I ha, reesDegOne_mem I ha⟩, ⟨1, pow_one _⟩⟩, ?_⟩
  apply HomogeneousLocalization.val_injective
  rw [val_mul, val_mk, val_reesAwayMap, val_reesAwayMap, Localization.mk_mul,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, Subtype.ext ?_⟩
  simp only [OneMemClass.coe_one, one_mul, mul_one]
  change (monomial 1 b : A[X]) * C a = monomial 1 a * C b
  rw [mul_comm, C_mul_monomial, mul_comm (monomial 1 a), C_mul_monomial, mul_comm]

/-- **On the chart `D₊(a t)`, `a` is a non-zero-divisor** of `A[It]_(a t)`. -/
theorem reesAway_algebraMap_mem_nonZeroDivisors :
    reesAwayMap I ha a ∈ nonZeroDivisors (Away (reesGrading I) (reesDegOne I ha)) := by
  rw [mem_nonZeroDivisors_iff_right]
  intro z hz
  obtain ⟨⟨n, ⟨x, hx⟩, ⟨s, hs⟩, hsmem⟩, rfl⟩ := mk_surjective z
  have hz' := congrArg HomogeneousLocalization.val hz
  rw [val_mul, val_mk, val_reesAwayMap, Localization.mk_mul, val_zero, ← Localization.mk_zero 1,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists] at hz'
  obtain ⟨⟨c, k, rfl⟩, hc⟩ := hz'
  apply HomogeneousLocalization.val_injective
  rw [val_mk, val_zero, ← Localization.mk_zero 1, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  refine ⟨⟨reesDegOne I ha ^ (k + 1), k + 1, rfl⟩, ?_⟩
  simp only [OneMemClass.coe_one, mul_one, mul_zero] at hc ⊢
  have hc' := congrArg (fun p : reesAlgebra I => X * (p : A[X])) hc
  simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, ZeroMemClass.coe_zero, mul_zero] at hc'
  apply Subtype.ext
  simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, ZeroMemClass.coe_zero]
  rw [← hc']
  change (monomial 1 a : A[X]) ^ (k + 1) * (1 * (x : A[X])) =
    X * ((monomial 1 a) ^ k * (1 * ((x : A[X]) * C a)))
  rw [pow_succ, ← C_mul_X_pow_eq_monomial, pow_one]
  ring

/-! #### The shifted Rees module on a chart -/

/-- The map `S(1)_(a t) → S_(a t)` for `S = A[It]`: the inverse of multiplication by `a t`,
`S_(a t) ≅ S(1)_(a t)`, followed by multiplication by `a`. It sends `y / (a t)ⁿ` (`y ∈ S_{n+1}`)
to `(y / t) / (a t)ⁿ` (`reesTwistAwayToAway_mk`). -/
def reesTwistAwayToAway :
    HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1)
        (Submonoid.powers (reesDegOne I ha)) →ₗ[Away (reesGrading I) (reesDegOne I ha)]
      Away (reesGrading I) (reesDegOne I ha) :=
  LinearMap.mulRight _ (reesAwayMap I ha a) ∘ₗ
    (ProjTwistingSheaf.twistAwayEquiv (reesDegOne_mem I ha) 1).symm.toLinearMap

theorem reesTwistAwayToAway_apply
    (y : HomogeneousLocalizedModule (reesGrading I) (gradedTwist (reesGrading I) 1)
      (Submonoid.powers (reesDegOne I ha))) :
    reesTwistAwayToAway I ha y =
      (ProjTwistingSheaf.twistAwayEquiv (reesDegOne_mem I ha) 1).symm y * reesAwayMap I ha a :=
  rfl

/-- The local generator `a t` of `S(1)_(a t)` goes to `a`: the degree-one copy of `I` goes to `I`. -/
theorem reesTwistAwayToAway_twistGenerator :
    reesTwistAwayToAway I ha (ProjTwistingSheaf.twistGenerator (reesDegOne_mem I ha) 1) =
      reesAwayMap I ha a := by
  rw [reesTwistAwayToAway_apply, ← one_smul (Away (reesGrading I) (reesDegOne I ha))
    (ProjTwistingSheaf.twistGenerator (reesDegOne_mem I ha) 1),
    ← ProjTwistingSheaf.twistAwayEquiv_apply, LinearEquiv.symm_apply_apply, one_mul]

theorem reesTwistAwayToAway_injective : Function.Injective (reesTwistAwayToAway I ha) := by
  refine (injective_iff_map_eq_zero _).2 fun y hy => ?_
  rw [reesTwistAwayToAway_apply] at hy
  have := (mem_nonZeroDivisors_iff_right.1 (reesAway_algebraMap_mem_nonZeroDivisors I ha)) _ hy
  simpa using this

/-- **The shifted Rees module on a chart is the ideal generated by `I`** (Stacks 01OF): the
image of `S(1)_(a t) → S_(a t)` is `I · S_(a t)`. -/
theorem range_reesTwistAwayToAway :
    LinearMap.range (reesTwistAwayToAway I ha) = I.map (reesAwayMap I ha) := by
  rw [reesAway_map_ideal_eq_span]
  ext z
  rw [LinearMap.mem_range, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨_, rfl⟩
  · rintro ⟨c, rfl⟩
    exact ⟨ProjTwistingSheaf.twistAwayEquiv (reesDegOne_mem I ha) 1 c, by
      rw [reesTwistAwayToAway_apply, LinearEquiv.symm_apply_apply]⟩

/-- Division by `t` on the elements of `A[It]` without constant term:
`p ↦ (p - p(0)) / t`, which maps `I^{n+1} t^{n+1}` into `I^{n+1} tⁿ ⊆ Iⁿ tⁿ`. -/
def reesShift (y : reesAlgebra I) : reesAlgebra I :=
  ⟨divX (y : A[X]), fun k => by
    rw [coeff_divX]
    exact Ideal.pow_le_pow_right (Nat.le_succ k) ((mem_reesAlgebra_iff I _).1 y.2 (k + 1))⟩

theorem reesShift_mem {n : ℕ} {y : reesAlgebra I} (hy : y ∈ reesGrading I (n + 1)) :
    reesShift I y ∈ reesGrading I n := fun m hm => by
  change (divX (y : A[X])).coeff m = 0
  rw [coeff_divX]
  exact hy (m + 1) (by omega)

theorem reesShift_mul_reesDegOne {n : ℕ} {y : reesAlgebra I} (hy : y ∈ reesGrading I (n + 1)) :
    reesShift I y * reesDegOne I ha = y * algebraMap A (reesAlgebra I) a := by
  apply Subtype.ext
  change divX (y : A[X]) * monomial 1 a = (y : A[X]) * C a
  have h0 : (y : A[X]).coeff 0 = 0 := hy 0 (by omega)
  conv_rhs => rw [← divX_mul_X_add (y : A[X]), h0]
  rw [C_0, add_zero, ← C_mul_X_pow_eq_monomial, pow_one]
  ring

/-- **The canonical description of `S(1)_(a t) → S_(a t)`**: `y / s ↦ (y / t) / s` for
`y ∈ S(1)_n = S_{n+1}` and `s ∈ S_n` a power of `a t`. -/
theorem reesTwistAwayToAway_mk (n : ℕ) (y : reesAlgebra I)
    (hy : y ∈ gradedTwist (reesGrading I) 1 n) (s : reesAlgebra I) (hs : s ∈ reesGrading I n)
    (hsx : s ∈ Submonoid.powers (reesDegOne I ha)) :
    reesTwistAwayToAway I ha (HomogeneousLocalizedModule.mk n y hy s hs hsx) =
      HomogeneousLocalization.mk ⟨n, ⟨reesShift I y, reesShift_mem I
        ((mem_gradedTwist_of_eq (k := n + 1) (by push_cast; ring)).1 hy)⟩, ⟨s, hs⟩, hsx⟩ := by
  have hy' : y ∈ reesGrading I (n + 1) :=
    (mem_gradedTwist_of_eq (k := n + 1) (by push_cast; ring)).1 hy
  have key : HomogeneousLocalizedModule.mk n y hy s hs hsx =
      ProjTwistingSheaf.twistAwayEquiv (reesDegOne_mem I ha) 1
        (HomogeneousLocalization.mk ⟨n + 1, ⟨y, hy'⟩,
          ⟨s * reesDegOne I ha, SetLike.GradedMul.mul_mem hs (reesDegOne_mem I ha)⟩,
          mul_mem hsx (Submonoid.mem_powers _)⟩) := by
    rw [ProjTwistingSheaf.twistAwayEquiv_apply]
    ext
    rw [HomogeneousLocalizedModule.val_mk, HomogeneousLocalizedModule.val_smul,
      ProjTwistingSheaf.twistGenerator_val, HomogeneousLocalization.val_mk,
      LocalizedModule.mk_smul_mk, LocalizedModule.mk_eq]
    refine ⟨1, ?_⟩
    simp only [one_smul, Submonoid.mk_smul, Submonoid.mk_mul_mk, smul_eq_mul]
    have h1 : (-1 : ℤ).toNat = 0 := rfl
    have h2 : (1 : ℤ).toNat = 1 := rfl
    rw [h1, h2, pow_zero, pow_one]
    ring
  rw [key, reesTwistAwayToAway_apply, LinearEquiv.symm_apply_apply]
  apply HomogeneousLocalization.val_injective
  rw [val_mul, val_mk, val_reesAwayMap, val_mk, Localization.mk_mul, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul, mul_one]
  rw [← reesShift_mul_reesDegOne I ha hy']
  ring

end Algebra

section Scheme

variable {X : Scheme.{u}}

set_option backward.isDefEq.respectTransparency false in
theorem appLE_specMap_fromSpec {R : CommRingCat.{u}} {V : X.Opens} (hV : IsAffineOpen V)
    (φ : Γ(X, V) ⟶ R) (h : (⊤ : (Spec R).Opens) ≤ (Spec.map φ ≫ hV.fromSpec) ⁻¹ᵁ V) :
    (Spec.map φ ≫ hV.fromSpec).appLE V ⊤ h = φ ≫ (Scheme.ΓSpecIso R).inv := by
  rw [← cancel_mono (Scheme.ΓSpecIso R).hom, Scheme.Hom.comp_appLE_assoc,
    IsAffineOpen.fromSpec_app_self, Category.assoc, Scheme.Hom.map_appLE_assoc,
    SpecMap_appLE_top_ΓSpecIso, Iso.inv_hom_id_assoc, Category.assoc, Iso.inv_hom_id,
    Category.comp_id]

/-- The pull-back of an ideal sheaf `J` along `Spec R ⟶ Spec Γ(U, 𝒪_X) ≅ U ⊆ X` has global ideal
`φ(J(U)) R`. -/
theorem ideal_top_comap_specMap_fromSpec (J : X.IdealSheafData) {R : CommRingCat.{u}}
    (U : X.affineOpens) (φ : Γ(X, U) ⟶ R) :
    (J.comap (Spec.map φ ≫ U.2.fromSpec)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      (J.ideal U).map (φ ≫ (Scheme.ΓSpecIso R).inv).hom := by
  have h : (⊤ : (Spec R).Opens) ≤ (Spec.map φ ≫ U.2.fromSpec) ⁻¹ᵁ U := by
    intro x _
    exact U.2.fromSpec_preimage_self.ge (Set.mem_univ ((Spec.map φ).base x))
  rw [← inverseImageIdeal, inverseImageIdeal_ideal _ J U ⟨⊤, isAffineOpen_top _⟩ h]
  exact congrArg (fun g => Ideal.map (CommRingCat.Hom.hom g) (J.ideal U))
    (appLE_specMap_fromSpec U.2 φ h)

/-- For an open immersion `h : Y ⟶ Z` of an affine scheme, the ideal of `K` over the image of `h`
is the transport of the global ideal of `K.comap h`. -/
theorem ideal_image_top_of_isOpenImmersion {Y Z : Scheme.{u}} [IsAffine Y] (K : Z.IdealSheafData)
    (h : Y ⟶ Z) [IsOpenImmersion h] :
    K.ideal ⟨h ''ᵁ ⊤, (isAffineOpen_top Y).image_of_isOpenImmersion h⟩ =
      ((K.comap h).ideal ⟨⊤, isAffineOpen_top _⟩).map (h.appIso ⊤).inv.hom := by
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion, Ideal.map_comap_of_surjective]
  exact fun y => ⟨(h.appIso ⊤).hom y, by simp⟩

end Scheme

namespace QuasiCoherentGradedAlgebra

variable {X : Scheme.{u}} (S : QuasiCoherentGradedAlgebra X)

/-- The chart `Spec S(U)_(f) ≅ D₊(f) ⊆ Proj S(U) ⊆ Proj_X S` over an affine open `U ⊆ X`, for
`f ∈ S(U)₁`. -/
def chartι (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)} (f_deg : f ∈ S.grading U 1) :
    Spec (.of (Away (S.grading U) f)) ⟶ S.relProj :=
  Proj.awayι (S.grading U) f f_deg one_pos ≫ S.projι U

instance (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)} (f_deg : f ∈ S.grading U 1) :
    IsOpenImmersion (S.chartι U f_deg) := by
  unfold chartι; infer_instance

/-- The structure map `Γ(U, 𝒪_X) → S(U)_(f)` of the chart. -/
def chartMap (U : X.AffineZariskiSite) (f : S.obj.obj (.op U)) :
    Γ(X, U.1) ⟶ CommRingCat.of (Away (S.grading U) f) :=
  S.toZero U ≫ CommRingCat.ofHom (fromZeroRingHom (S.grading U) _)

/-- On the chart `D₊(f)`, the projection to `X` is `Spec S(U)_(f) ⟶ Spec Γ(U, 𝒪_X) ≅ U ⊆ X`. -/
theorem chartι_relProjToBase (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)}
    (f_deg : f ∈ S.grading U 1) :
    S.chartι U f_deg ≫ S.relProjToBase = Spec.map (S.chartMap U f) ≫ U.2.fromSpec := by
  rw [chartι, Category.assoc, projι_relProjToBase, projToOpen_ι, Proj.awayι_toSpecZero_assoc,
    ← Spec.map_comp_assoc]
  rfl

/-- The identification `S(U)_(f) ≅ Γ(D₊(f), 𝒪)` of the ring of the chart with the sections of
`Proj_X S` over its image. -/
def chartSectionsIso (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)}
    (f_deg : f ∈ S.grading U 1) :
    CommRingCat.of (Away (S.grading U) f) ≅ Γ(S.relProj, S.chartι U f_deg ''ᵁ ⊤) :=
  (Scheme.ΓSpecIso _).symm ≪≫ ((S.chartι U f_deg).appIso ⊤).symm

/-- The inverse image `π⁻¹J · 𝒪` of an ideal sheaf `J` under `π : Proj_X S ⟶ X`, over the
chart `D₊(f)`: it is generated by the image of `J(U)` in `S(U)_(f)`. -/
theorem inverseImageIdeal_ideal_chart (J : X.IdealSheafData) (U : X.AffineZariskiSite)
    {f : S.obj.obj (.op U)} (f_deg : f ∈ S.grading U 1) :
    (inverseImageIdeal S.relProjToBase J).ideal
        ⟨S.chartι U f_deg ''ᵁ ⊤, (isAffineOpen_top _).image_of_isOpenImmersion _⟩ =
      ((J.ideal ⟨U.1, U.2⟩).map (S.chartMap U f).hom).map (S.chartSectionsIso U f_deg).hom.hom := by
  rw [ideal_image_top_of_isOpenImmersion, inverseImageIdeal,
    ← Scheme.IdealSheafData.comap_comp, S.chartι_relProjToBase U f_deg,
    ideal_top_comap_specMap_fromSpec J ⟨U.1, U.2⟩, Ideal.map_map, Ideal.map_map]
  rfl

theorem exists_chartι_eq (U : X.AffineZariskiSite) {f : S.obj.obj (.op U)}
    (f_deg : f ∈ S.grading U 1) (y : Proj (S.grading U)) (hy : f ∉ y.asHomogeneousIdeal) :
    ∃ z, (S.chartι U f_deg).base z = (S.projι U).base y := by
  have hy' : y ∈ (Proj.awayι (S.grading U) f f_deg one_pos).opensRange := by
    rw [Proj.opensRange_awayι]; exact hy
  obtain ⟨z, rfl⟩ := hy'
  exact ⟨z, rfl⟩

end QuasiCoherentGradedAlgebra

namespace ReesAlgebraSheaf

variable {X : Scheme.{u}} (J : X.IdealSheafData)

/-- The degree-one section `a t` of `⨁_d Jᵈ` over an affine open `U`, for `a ∈ J(U)`. -/
def chartElt (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U) :
    (reesAlgebraSheaf J).obj.obj (.op U) :=
  reesDegOne (idealOn J U) ha

theorem chartElt_mem (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U) :
    chartElt J U ha ∈ (reesAlgebraSheaf J).grading U 1 :=
  reesDegOne_mem _ ha

theorem chartMap_apply (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U)
    (r : Γ(X, U.1)) :
    (reesAlgebraSheaf J).chartMap U (chartElt J U ha) r = reesAwayMap _ ha r :=
  rfl

theorem map_chartMap (U : X.AffineZariskiSite) {a : Γ(X, U.1)} (ha : a ∈ idealOn J U) :
    (J.ideal ⟨U.1, U.2⟩).map ((reesAlgebraSheaf J).chartMap U (chartElt J U ha)).hom =
      Ideal.span {(reesAlgebraSheaf J).chartMap U (chartElt J U ha) a} :=
  reesAway_map_ideal_eq_span _ ha

theorem chartMap_mem_nonZeroDivisors (U : X.AffineZariskiSite) {a : Γ(X, U.1)}
    (ha : a ∈ idealOn J U) :
    (reesAlgebraSheaf J).chartMap U (chartElt J U ha) a ∈
      nonZeroDivisors (Away ((reesAlgebraSheaf J).grading U) (chartElt J U ha)) :=
  reesAway_algebraMap_mem_nonZeroDivisors _ ha

/-- **The inverse image ideal on a chart**: over `D₊(a t)`, `π⁻¹J · 𝒪` is generated by `a`. -/
theorem inverseImageIdeal_ideal_chart (U : X.AffineZariskiSite) {a : Γ(X, U.1)}
    (ha : a ∈ idealOn J U) :
    (inverseImageIdeal (reesAlgebraSheaf J).relProjToBase J).ideal
        ⟨(reesAlgebraSheaf J).chartι U (chartElt_mem J U ha) ''ᵁ ⊤,
          (isAffineOpen_top _).image_of_isOpenImmersion _⟩ =
      Ideal.span {((reesAlgebraSheaf J).chartSectionsIso U (chartElt_mem J U ha)).hom
        ((reesAlgebraSheaf J).chartMap U (chartElt J U ha) a)} := by
  rw [QuasiCoherentGradedAlgebra.inverseImageIdeal_ideal_chart, map_chartMap, Ideal.map_span,
    Set.image_singleton]

theorem chartSectionsIso_mem_nonZeroDivisors (U : X.AffineZariskiSite) {a : Γ(X, U.1)}
    (ha : a ∈ idealOn J U) :
    ((reesAlgebraSheaf J).chartSectionsIso U (chartElt_mem J U ha)).hom
        ((reesAlgebraSheaf J).chartMap U (chartElt J U ha) a) ∈
      nonZeroDivisors Γ((reesAlgebraSheaf J).relProj,
        (reesAlgebraSheaf J).chartι U (chartElt_mem J U ha) ''ᵁ ⊤) := by
  let E := ((reesAlgebraSheaf J).chartSectionsIso U (chartElt_mem J U ha)).commRingCatIsoToRingEquiv
  rw [← MulEquivClass.map_nonZeroDivisors E]
  exact Submonoid.mem_map_of_mem E (chartMap_mem_nonZeroDivisors J U ha)

/-- **Hartshorne II, Proposition 7.13(a), invertibility.** On `π : Proj_X (⨁_d Jᵈ) ⟶ X`, the
inverse image ideal sheaf `π⁻¹J · 𝒪` is locally generated by one non-zero-divisor. -/
theorem isLocallyPrincipalNonZeroDivisor_inverseImageIdeal :
    (inverseImageIdeal (reesAlgebraSheaf J).relProjToBase J).IsLocallyPrincipalNonZeroDivisor := by
  intro x
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
    (show (reesAlgebraSheaf J).relProjToBase.base x ∈ (⊤ : X.Opens) from trivial)
  let U' : X.AffineZariskiSite := ⟨U, hU⟩
  have hx : x ∈ (reesAlgebraSheaf J).relProjToBase ⁻¹ᵁ U'.1 := hxU
  rw [QuasiCoherentGradedAlgebra.relProjToBase_preimage] at hx
  obtain ⟨y, rfl⟩ := hx
  obtain ⟨f, f_deg, hfy⟩ := ProjTwistingSheaf.exists_mem_one_notMem
    ((reesAlgebraSheaf J).adjoin_eq_top_of_generatedInDegreeOne (generatedInDegreeOne J) U') y
  obtain ⟨a, ha, hfa⟩ := (mem_grading_iff J U' 1 f).1 f_deg
  rw [pow_one] at ha
  obtain rfl : f = chartElt J U' ha := Subtype.ext hfa
  obtain ⟨z, hz⟩ := (reesAlgebraSheaf J).exists_chartι_eq U' (chartElt_mem J U' ha) y hfy
  exact ⟨⟨(reesAlgebraSheaf J).chartι U' (chartElt_mem J U' ha) ''ᵁ ⊤,
    (isAffineOpen_top _).image_of_isOpenImmersion _⟩, ⟨z, trivial, hz⟩, _,
    chartSectionsIso_mem_nonZeroDivisors J U' ha, inverseImageIdeal_ideal_chart J U' ha⟩

end ReesAlgebraSheaf

/-! ### The exceptional divisor of a blowing-up -/

namespace QuasicoherentIdealSubsheaf

open Scheme.CartierDivisor

variable {X : Scheme.{u}} [IsNoetherian X] (I : QuasicoherentIdealSubsheaf X)
  (hI : IsCoherent I.toModules)

/-- **The exceptional ideal** `I_E = π⁻¹I · 𝒪_{X̃}` of the blowing-up `π : X̃ ⟶ X` of `I`, as ideal
sheaf data on `X̃`. -/
def exceptionalIdeal : (I.blowup hI).IdealSheafData :=
  inverseImageIdeal (I.blowupProjection hI) (quasicoherentIdealSubsheafEquiv I)

/-- The exceptional ideal is the inverse image ideal subsheaf `π⁻¹I · 𝒪_{X̃} ⊆ 𝒪_{X̃}`. -/
theorem quasicoherentIdealSubsheafEquiv_inverseImage :
    quasicoherentIdealSubsheafEquiv (I.inverseImage (I.blowupProjection hI)) =
      I.exceptionalIdeal hI :=
  quasicoherentIdealSubsheafEquiv.apply_symm_apply _

/-- **Hartshorne II, Proposition 7.13(a), invertibility.** The exceptional ideal `π⁻¹I · 𝒪_{X̃}`
is locally generated by one non-zero-divisor. -/
theorem isLocallyPrincipalNonZeroDivisor_exceptionalIdeal :
    (I.exceptionalIdeal hI).IsLocallyPrincipalNonZeroDivisor :=
  ReesAlgebraSheaf.isLocallyPrincipalNonZeroDivisor_inverseImageIdeal _

/-- **The exceptional divisor** `E` of the blowing-up: the effective Cartier divisor whose ideal
sheaf is the exceptional ideal `π⁻¹I · 𝒪_{X̃}`. -/
def exceptionalDivisor : (I.blowup hI).CartierDivisor :=
  ((I.blowup hI).effectiveCartierDivisorEquiv.symm
    ⟨I.exceptionalIdeal hI, I.isLocallyPrincipalNonZeroDivisor_exceptionalIdeal hI⟩).1

theorem exceptionalDivisor_isEffective : (I.exceptionalDivisor hI).IsEffective :=
  ((I.blowup hI).effectiveCartierDivisorEquiv.symm
    ⟨I.exceptionalIdeal hI, I.isLocallyPrincipalNonZeroDivisor_exceptionalIdeal hI⟩).2

/-- The ideal sheaf of the exceptional divisor `E` is the exceptional ideal. -/
theorem idealSheafData_exceptionalDivisor :
    idealSheafData (I.exceptionalDivisor_isEffective hI) = I.exceptionalIdeal hI :=
  congrArg Subtype.val ((I.blowup hI).effectiveCartierDivisorEquiv.apply_symm_apply
    ⟨I.exceptionalIdeal hI, I.isLocallyPrincipalNonZeroDivisor_exceptionalIdeal hI⟩)

/-- The exceptional ideal `I_E = π⁻¹I · 𝒪_{X̃}` as an `𝒪_{X̃}`-module: the ideal sheaf of the
closed subscheme it cuts out. -/
def exceptionalIdealSheaf : (I.blowup hI).Modules :=
  closedImmersionIdealSheaf (I.exceptionalIdeal hI).subschemeι

/-- **Hartshorne II, Proposition 7.13(a), `I_E ≅ 𝒪(-E)`.** The exceptional ideal sheaf is
isomorphic to `𝒪_{X̃}(-E)` for the exceptional divisor `E`, by Proposition 6.18. -/
def exceptionalIdealSheafIsoDivisorSheaf :
    I.exceptionalIdealSheaf hI ≅ (-(I.exceptionalDivisor hI)).sheaf :=
  eqToIso (congrArg (fun K : (I.blowup hI).IdealSheafData => closedImmersionIdealSheaf K.subschemeι)
      (I.idealSheafData_exceptionalDivisor hI).symm) ≪≫
    (idealSheafIso (I.exceptionalDivisor_isEffective hI)).symm

/-- **The exceptional ideal sheaf is invertible.** -/
theorem isInvertible_exceptionalIdealSheaf : (I.exceptionalIdealSheaf hI).IsInvertible := by
  intro x
  obtain ⟨U, hxU, ⟨e⟩⟩ := (-(I.exceptionalDivisor hI)).isInvertible_sheaf x
  exact ⟨U, hxU, ⟨(Scheme.Modules.restrictFunctor U.ι).mapIso
    (I.exceptionalIdealSheafIsoDivisorSheaf hI) ≪≫ e⟩⟩

end QuasicoherentIdealSubsheaf

end Hartshorne
