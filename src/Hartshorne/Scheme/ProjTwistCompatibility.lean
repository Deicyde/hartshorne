import Hartshorne.Scheme.ProjTwistingSheaf
import Hartshorne.Scheme.AffineTildeTensor
import Hartshorne.RingedSpace.ModuleSheafMonoidal
import Hartshorne.Intersection.GradedModuleTwist

/-!
# Twists and graded shifts on `Proj`

Hartshorne, *Algebraic Geometry*, Proposition II.5.12(b) (p. 117), with two project additions.

Let `S` be an `ℕ`-graded ring generated by `S_1` as an `S_0`-algebra, `X = Proj S`, `M` a
`ℤ`-graded `S`-module and `n ∈ ℤ`. The twist `M(n)` is `M` regraded by `M(n)_d = M_{d+n}`
(`gradedModuleTwist`, from `Hartshorne.Intersection.GradedModuleTwist`).

* `ProjTwist.twistIso ℳ hgen n : M~ ⊗ 𝒪_X(n) ≅ M(n)~` (Hartshorne II.5.12(b)). On sections it
  sends `s ⊗ t` to the pointwise pairing `M_(x) × S(n)_(x) → M(n)_(x)`,
  `(m / s, a / t) ↦ a m / (t s)` (`twistPair`). It is an isomorphism on stalks: at `x`, choose
  `f ∈ S_1` outside `x`; then `S(n)_(x)` is generated by `f^n`, and pairing with `f^n` is a
  bijection `M_(x) → M(n)_(x)`.
* `ProjTwist.twistIso_hom_naturality`: naturality in `M` for degree-preserving linear maps, which
  act on the sheaves through `projGradedModuleSheafMap`.
* `twistMulIso 𝒜 hgen n m : 𝒪_X(n) ⊗ 𝒪_X(m) ≅ 𝒪_X(n + m)`, the case `M = S(n)`.

Project additions (Hartshorne states only the isomorphisms):

* associativity: `twistIso_assoc` (for `M~ ⊗ 𝒪_X(n) ⊗ 𝒪_X(m)`) and `twistMulIso_assoc`;
* compatibility with the chart trivializations by multiplication by `f^n` on `D₊(f)`,
  `f ∈ S_1`: `twistMulIso_hom_twistGenSection` (the local generators `f^n ⊗ f^m` go to
  `f^(n + m)`) and `twistPair_twistAwayEquiv` (on `S(n)_(f)`, `a f^n · b f^m = a b f^(n + m)`).

The associativity proofs use `tensor₃_hom_ext`: morphisms out of `(F ⊗ G) ⊗ H` are determined by
their values on the sections `(f ⊗ g) ⊗ h`, because every section of `F ⊗ G` is locally a finite
sum of sections `f ⊗ g` (`exists_isBilinearSum_res`).
-/

universe u

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace Hartshorne

open AlgebraicGeometry CategoryTheory MonoidalCategory HomogeneousLocalization TopologicalSpace
  Opposite
open scoped TensorProduct

section Algebra

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {M σM : Type u} [AddCommGroup M] [Module A M] [SetLike σM M] [AddSubgroupClass σM M]
  {ℳ : ℤ → σM} [SetLike.GradedSMul 𝒜 ℳ]

/-- The twist `M(n)` (`M(n)_d = M_{d+n}`) of a `ℤ`-graded module over an `ℕ`-graded ring is
again graded. -/
instance gradedModuleTwist.natGradedSMul (n : ℤ) :
    SetLike.GradedSMul 𝒜 (gradedModuleTwist ℳ n) where
  smul_mem := by
    intro i d a m ha hm
    have := smul_mem_graded_nat 𝒜 ℳ ha hm
    change a • m ∈ ℳ (((i : ℤ) + d) + n)
    convert this using 2
    ring

omit [GradedRing 𝒜] in
/-- `S(n)_j • M_i ⊆ M_{n + j + i}`. -/
theorem smul_mem_twist {n : ℤ} {j i : ℤ} {a : A} {m : M} (ha : a ∈ gradedTwist 𝒜 n j)
    (hm : m ∈ ℳ i) : a • m ∈ ℳ (n + j + i) := by
  by_cases h : n + j < 0
  · rw [eq_zero_of_mem_gradedTwist ha h, zero_smul]
    exact zero_mem _
  · have := smul_mem_graded_nat 𝒜 ℳ (mem_of_mem_gradedTwist ha) hm
    convert this using 2
    omega

variable (T : Submonoid A) (n : ℤ)

/-- The pairing `M_(T) × S(n)_(T) → M(n)_(T)`, `(m / s, a / t) ↦ a m / (t s)`. -/
def twistPairFun (y : HomogeneousLocalizedModule 𝒜 ℳ T)
    (z : HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) T) :
    HomogeneousLocalizedModule 𝒜 (gradedModuleTwist ℳ n) T :=
  ⟨(show Localization T from z.val) • y.val, by
    obtain ⟨i, m, hm, s, hs, hsT, rfl⟩ := HomogeneousLocalizedModule.mk_surjective y
    obtain ⟨j, a, ha, t, ht, htT, rfl⟩ := HomogeneousLocalizedModule.mk_surjective z
    refine ⟨j + i, a • m, t * s, ?_, SetLike.GradedMul.mul_mem ht hs, mul_mem htT hsT, ?_⟩
    · have := smul_mem_twist ha hm
      change a • m ∈ ℳ (((j + i : ℕ) : ℤ) + n)
      convert this using 2
      push_cast; ring
    · exact LocalizedModule.mk_smul_mk a m ⟨t, htT⟩ ⟨s, hsT⟩⟩

theorem val_twistPairFun (y : HomogeneousLocalizedModule 𝒜 ℳ T)
    (z : HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) T) :
    (twistPairFun T n y z).val = (show Localization T from z.val) • y.val := rfl

/-- The pairing `M_(T) × S(n)_(T) → M(n)_(T)`, as an `S_(T)`-bilinear map. -/
def twistPair :
    HomogeneousLocalizedModule 𝒜 ℳ T →ₗ[HomogeneousLocalization 𝒜 T]
      HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) T →ₗ[HomogeneousLocalization 𝒜 T]
        HomogeneousLocalizedModule 𝒜 (gradedModuleTwist ℳ n) T :=
  LinearMap.mk₂ _ (twistPairFun T n)
    (fun y y' z => HomogeneousLocalizedModule.ext <| by
      simp only [val_twistPairFun, HomogeneousLocalizedModule.val_add, smul_add])
    (fun c y z => HomogeneousLocalizedModule.ext <| by
      simp only [val_twistPairFun, HomogeneousLocalizedModule.val_smul]
      exact smul_comm _ _ _)
    (fun y z z' => HomogeneousLocalizedModule.ext <| by
      simp only [val_twistPairFun, HomogeneousLocalizedModule.val_add]
      exact add_smul _ _ _)
    (fun c y z => HomogeneousLocalizedModule.ext <| by
      simp only [val_twistPairFun, HomogeneousLocalizedModule.val_smul]
      exact mul_smul _ _ _)

theorem val_twistPair (y : HomogeneousLocalizedModule 𝒜 ℳ T)
    (z : HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) T) :
    (twistPair T n y z).val = (show Localization T from z.val) • y.val := rfl

variable {T} {f : A} (f_deg : f ∈ 𝒜 1) (hfT : f ∈ T)

/-- The degree-`n` element `f^n` of `S(n)_(T)` for `f ∈ S_1 ∩ T`. -/
def twistGen : HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) T :=
  HomogeneousLocalizedModule.mk (-n).toNat (f ^ n.toNat)
    ((mem_gradedTwist_of_eq (k := n.toNat) (by omega)).2
      (ProjTwistingSheaf.pow_mem_of_mem_one f_deg _))
    (f ^ (-n).toNat) (ProjTwistingSheaf.pow_mem_of_mem_one f_deg _) (pow_mem hfT _)

theorem twistGen_val :
    (twistGen n f_deg hfT).val = LocalizedModule.mk (f ^ n.toNat) ⟨f ^ (-n).toNat, pow_mem hfT _⟩ :=
  rfl

/-- `S(n)_(T)` is generated by `f^n` as an `S_(T)`-module. -/
theorem exists_smul_twistGen (z : HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) T) :
    ∃ c : HomogeneousLocalization 𝒜 T, z = c • twistGen n f_deg hfT := by
  obtain ⟨j, a, ha, t, ht, htT, rfl⟩ := HomogeneousLocalizedModule.mk_surjective z
  by_cases h : n + j < 0
  · refine ⟨0, ?_⟩
    rw [zero_smul]
    ext
    rw [HomogeneousLocalizedModule.val_zero, HomogeneousLocalizedModule.val_mk,
      eq_zero_of_mem_gradedTwist ha h, LocalizedModule.zero_mk]
  have hnum : f ^ (-n).toNat * a ∈ 𝒜 (n.toNat + j) := by
    have := SetLike.GradedMul.mul_mem (ProjTwistingSheaf.pow_mem_of_mem_one f_deg (-n).toNat)
      (mem_of_mem_gradedTwist ha)
    convert this using 2
    omega
  have hden : f ^ n.toNat * t ∈ 𝒜 (n.toNat + j) :=
    SetLike.GradedMul.mul_mem (ProjTwistingSheaf.pow_mem_of_mem_one f_deg _) ht
  refine ⟨HomogeneousLocalization.mk ⟨n.toNat + j, ⟨_, hnum⟩, ⟨_, hden⟩,
    mul_mem (pow_mem hfT _) htT⟩, ?_⟩
  ext
  rw [HomogeneousLocalizedModule.val_smul, twistGen_val,
    HomogeneousLocalization.val_mk, LocalizedModule.mk_smul_mk,
    HomogeneousLocalizedModule.val_mk, LocalizedModule.mk_eq]
  refine ⟨1, ?_⟩
  simp only [one_smul, Submonoid.mk_smul, Submonoid.mk_mul_mk, smul_eq_mul]
  ring

/-- Pairing with `f^n` is injective. -/
theorem twistPair_twistGen_eq_zero {y : HomogeneousLocalizedModule 𝒜 ℳ T}
    (hy : twistPair T n y (twistGen n f_deg hfT) = 0) : y = 0 := by
  have h := congrArg HomogeneousLocalizedModule.val hy
  rw [val_twistPair, HomogeneousLocalizedModule.val_zero] at h
  have hinv : (Localization.mk (f ^ (-n).toNat) ⟨f ^ n.toNat, pow_mem hfT _⟩ *
      (show Localization T from (twistGen n f_deg hfT).val) : Localization T) = 1 := by
    rw [twistGen_val]
    change Localization.mk _ _ * Localization.mk _ _ = _
    rw [Localization.mk_mul, mul_comm (f ^ (-n).toNat), ← Localization.mk_one]
    exact Localization.mk_eq_mk_iff.2 (Localization.r_iff_exists.2 ⟨1, by simp [mul_comm]⟩)
  ext
  rw [HomogeneousLocalizedModule.val_zero, ← one_smul (Localization T) y.val, ← hinv, mul_smul,
    h, smul_zero]

/-- Every element of `M(n)_(T)` is the pairing of an element of `M_(T)` with `f^n`. -/
theorem exists_twistPair_twistGen (w : HomogeneousLocalizedModule 𝒜 (gradedModuleTwist ℳ n) T) :
    ∃ y : HomogeneousLocalizedModule 𝒜 ℳ T, twistPair T n y (twistGen n f_deg hfT) = w := by
  obtain ⟨k, m, hm, g, hg, hgT, rfl⟩ := HomogeneousLocalizedModule.mk_surjective w
  have hm' : f ^ (-n).toNat • m ∈ ℳ ((n.toNat + k : ℕ) : ℤ) := by
    have := smul_mem_graded_nat 𝒜 ℳ (ProjTwistingSheaf.pow_mem_of_mem_one f_deg (-n).toNat) hm
    convert this using 2
    push_cast; omega
  refine ⟨HomogeneousLocalizedModule.mk (n.toNat + k) _ hm' (f ^ n.toNat * g)
    (SetLike.GradedMul.mul_mem (ProjTwistingSheaf.pow_mem_of_mem_one f_deg _) hg)
    (mul_mem (pow_mem hfT _) hgT), ?_⟩
  ext
  rw [val_twistPair, twistGen_val, HomogeneousLocalizedModule.val_mk,
    HomogeneousLocalizedModule.val_mk]
  change Localization.mk _ _ • _ = _
  rw [LocalizedModule.mk_smul_mk, LocalizedModule.mk_eq]
  refine ⟨1, ?_⟩
  simp only [one_smul, Submonoid.mk_smul, Submonoid.mk_mul_mk, smul_smul]
  congr 1
  ring

/-- `f^m · f^n = f^(n + m)` in `T⁻¹ S`. -/
theorem twistGen_mul (m : ℤ) :
    (show Localization T from (twistGen m f_deg hfT).val) • (twistGen n f_deg hfT).val =
      (twistGen (n + m) f_deg hfT).val := by
  rw [twistGen_val, twistGen_val, twistGen_val]
  change Localization.mk _ _ • _ = _
  rw [LocalizedModule.mk_smul_mk, LocalizedModule.mk_eq]
  refine ⟨1, ?_⟩
  simp only [one_smul, Submonoid.mk_smul, Submonoid.mk_mul_mk, smul_eq_mul, ← pow_add]
  congr 1
  omega

/-- **The pairing is compatible with the trivializations `S_(f) ≅ S(n)_(f)`** given by
multiplication by `f^n`: the pairing of `a f^n` and `b f^m` is `a b f^(n + m)`. -/
theorem twistPair_twistAwayEquiv (m : ℤ) (a b : HomogeneousLocalization.Away 𝒜 f) :
    (twistPair (Submonoid.powers f) m (ProjTwistingSheaf.twistAwayEquiv f_deg n a)
        (ProjTwistingSheaf.twistAwayEquiv f_deg m b)).val =
      (ProjTwistingSheaf.twistAwayEquiv f_deg (n + m) (a * b)).val := by
  rw [val_twistPair, ProjTwistingSheaf.twistAwayEquiv_apply,
    ProjTwistingSheaf.twistAwayEquiv_apply, ProjTwistingSheaf.twistAwayEquiv_apply,
    HomogeneousLocalizedModule.val_smul, HomogeneousLocalizedModule.val_smul,
    HomogeneousLocalizedModule.val_smul, HomogeneousLocalization.val_mul]
  have h := twistGen_mul n f_deg (Submonoid.mem_powers f) m
  change (b.val * (twistGen m f_deg (Submonoid.mem_powers f)).val : Localization _) •
      (a.val • (twistGen n f_deg (Submonoid.mem_powers f)).val) =
    (a.val * b.val) • (twistGen (n + m) f_deg (Submonoid.mem_powers f)).val
  rw [← h, smul_smul, smul_smul]
  congr 1
  ring

end Algebra

section GradedMap

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {M σM : Type u} [AddCommGroup M] [Module A M] [SetLike σM M] [AddSubgroupClass σM M]
  {ℳ : ℤ → σM} [SetLike.GradedSMul 𝒜 ℳ]
  {N σN : Type u} [AddCommGroup N] [Module A N] [SetLike σN N] [AddSubgroupClass σN N]
  {𝒩 : ℤ → σN} [SetLike.GradedSMul 𝒜 𝒩]
  (g : M →ₗ[A] N) (hg : ∀ (i : ℤ) (m : M), m ∈ ℳ i → g m ∈ 𝒩 i) (T : Submonoid A)

/-- The map `M_(T) → N_(T)`, `m / s ↦ g m / s`, induced by a graded linear map `g`. -/
def gradedLocMap :
    HomogeneousLocalizedModule 𝒜 ℳ T →ₗ[HomogeneousLocalization 𝒜 T]
      HomogeneousLocalizedModule 𝒜 𝒩 T where
  toFun y := ⟨IsLocalizedModule.map T (LocalizedModule.mkLinearMap T M)
      (LocalizedModule.mkLinearMap T N) g y.val, by
    obtain ⟨i, m, hm, s, hs, hsT, rfl⟩ := HomogeneousLocalizedModule.mk_surjective y
    exact ⟨i, g m, s, hg _ m hm, hs, hsT, IsLocalizedModule.map_LocalizedModules _ _ _ _⟩⟩
  map_add' y z := HomogeneousLocalizedModule.ext (map_add _ y.val z.val)
  map_smul' c y := HomogeneousLocalizedModule.ext <| by
    change IsLocalizedModule.map T (LocalizedModule.mkLinearMap T M)
      (LocalizedModule.mkLinearMap T N) g (c.val • y.val) =
      c.val • IsLocalizedModule.map T (LocalizedModule.mkLinearMap T M)
        (LocalizedModule.mkLinearMap T N) g y.val
    generalize c.val = r
    generalize y.val = v
    induction r using Localization.induction_on with
    | H p =>
      induction v using LocalizedModule.induction_on with
      | h m t =>
        rw [LocalizedModule.mk_smul_mk, IsLocalizedModule.map_LocalizedModules,
          IsLocalizedModule.map_LocalizedModules, LocalizedModule.mk_smul_mk, map_smul]

theorem val_gradedLocMap (y : HomogeneousLocalizedModule 𝒜 ℳ T) :
    (gradedLocMap g hg T y).val = IsLocalizedModule.map T (LocalizedModule.mkLinearMap T M)
      (LocalizedModule.mkLinearMap T N) g y.val := rfl

theorem gradedLocMap_twistPair (n : ℤ) (y : HomogeneousLocalizedModule 𝒜 ℳ T)
    (z : HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) T) :
    gradedLocMap (ℳ := gradedModuleTwist ℳ n) (𝒩 := gradedModuleTwist 𝒩 n) g
        (fun i m hm => hg (i + n) m hm) T (twistPair T n y z) =
      twistPair T n (gradedLocMap g hg T y) z := by
  ext
  change IsLocalizedModule.map T (LocalizedModule.mkLinearMap T M)
      (LocalizedModule.mkLinearMap T N) g ((show Localization T from z.val) • y.val) =
    (show Localization T from z.val) • IsLocalizedModule.map T (LocalizedModule.mkLinearMap T M)
      (LocalizedModule.mkLinearMap T N) g y.val
  generalize (show Localization T from z.val) = r
  generalize y.val = v
  induction r using Localization.induction_on with
  | H p =>
    induction v using LocalizedModule.induction_on with
    | h m t =>
      rw [LocalizedModule.mk_smul_mk, IsLocalizedModule.map_LocalizedModules,
        IsLocalizedModule.map_LocalizedModules, LocalizedModule.mk_smul_mk, map_smul]

end GradedMap

section TensorExt

open Ringed ModuleSheafTensor

variable {X : TopCat.{u}} {R : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}
  (F G : SheafOfModules.{u} (ringCatSheafOf R))

/-- A section of `moduleSheafTensor F G` which is a finite sum of sections `f ⊗ g`. -/
def IsBilinearSum {V : Opens X} (v : (moduleSheafTensor F G).val.obj (op V)) : Prop :=
  ∃ l : List (F.val.obj (op V) × G.val.obj (op V)),
    v = (l.map fun p => (moduleSheafTensorBilinear F G).app (op V) p.1 p.2).sum

variable {F G}

theorem IsBilinearSum.restrict {U V : Opens X} (i : V ⟶ U)
    {v : (moduleSheafTensor F G).val.obj (op U)}
    (hv : IsBilinearSum F G v) : IsBilinearSum F G (ModuleSheafTensor.res _ i v) := by
  obtain ⟨l, rfl⟩ := hv
  refine ⟨l.map fun p => (ModuleSheafTensor.res _ i p.1, ModuleSheafTensor.res _ i p.2), ?_⟩
  rw [map_list_sum, List.map_map, List.map_map]
  congr 1
  refine List.map_congr_left fun p _ => ?_
  exact (moduleSheafTensorBilinear F G).naturality i.op p.1 p.2

theorem exists_isBilinearSum_stalk (x : X)
    (w : moduleStalk F.val x ⊗[ringSheafStalk R x] moduleStalk G.val x) :
    ∃ (V : Opens X) (hxV : x ∈ V) (v : (moduleSheafTensor F G).val.obj (op V)),
      IsBilinearSum F G v ∧ moduleSheafTensorStalkIso F G x (sectionGerm _ x V hxV v) = w := by
  induction w using TensorProduct.induction_on with
  | zero => exact ⟨⊤, trivial, 0, ⟨[], rfl⟩, by rw [map_zero, map_zero]⟩
  | tmul a b =>
    obtain ⟨U, hU, f, rfl⟩ := exists_sectionGerm F.val x a
    obtain ⟨V, hV, g, rfl⟩ := exists_sectionGerm G.val x b
    have hW : x ∈ U ⊓ V := ⟨hU, hV⟩
    refine ⟨U ⊓ V, hW, (moduleSheafTensorBilinear F G).app (op (U ⊓ V))
      (res _ (homOfLE inf_le_left) f) (res _ (homOfLE inf_le_right) g),
      ⟨[(res _ (homOfLE inf_le_left) f, res _ (homOfLE inf_le_right) g)], by simp⟩, ?_⟩
    rw [← sectionGerm_res F.val x (homOfLE inf_le_left) hW f,
      ← sectionGerm_res G.val x (homOfLE inf_le_right) hW g]
    exact moduleSheafTensorStalkIso_germ F G x _ hW _ _
  | add w w' hw hw' =>
    obtain ⟨V, hV, v, hv, hve⟩ := hw
    obtain ⟨V', hV', v', hv', hve'⟩ := hw'
    have hW : x ∈ V ⊓ V' := ⟨hV, hV'⟩
    refine ⟨V ⊓ V', hW, res _ (homOfLE inf_le_left) v + res _ (homOfLE inf_le_right) v', ?_, ?_⟩
    · obtain ⟨l, hl⟩ := hv.restrict (homOfLE inf_le_left : V ⊓ V' ⟶ V)
      obtain ⟨l', hl'⟩ := hv'.restrict (homOfLE inf_le_right : V ⊓ V' ⟶ V')
      exact ⟨l ++ l', by rw [List.map_append, List.sum_append, ← hl, ← hl']⟩
    · rw [map_add, sectionGerm_res, sectionGerm_res, map_add, hve, hve']

theorem exists_isBilinearSum_res {U : Opens X} (t : (moduleSheafTensor F G).val.obj (op U))
    {x : X} (hx : x ∈ U) :
    ∃ (W : Opens X) (_ : x ∈ W) (i : W ⟶ U), IsBilinearSum F G (res _ i t) := by
  obtain ⟨V, hV, v, hv, hve⟩ := exists_isBilinearSum_stalk x
    (moduleSheafTensorStalkIso F G x (sectionGerm _ x U hx t))
  have hg := (moduleSheafTensorStalkIso F G x).injective hve
  obtain ⟨W, hxW, iV, iU, e⟩ := TopCat.Presheaf.germ_eq (moduleSheafTensor F G).val.presheaf x hV hx v t hg
  refine ⟨W, hxW, iU, ?_⟩
  have : res _ iU t = res _ iV v := e.symm
  rw [this]
  exact hv.restrict iV

theorem tmulSection_res {U V : Opens X} (i : V ⟶ U) (f : F.val.obj (op U)) (g : G.val.obj (op U)) :
    res _ i (tmulSection F G f g) = tmulSection F G (res _ i f) (res _ i g) :=
  ((congrArg ((tensorπ F G).app (op V)).hom
    (PresheafOfModules.Monoidal.tensorObj_map_tmul (M₁ := F.val) (M₂ := G.val) i.op f g)).symm.trans
    (PresheafOfModules.naturality_apply (tensorπ F G) i.op (f ⊗ₜ g))).symm

theorem tmulSection_list_sum_left {H : SheafOfModules.{u} (ringCatSheafOf R)}
    {V : (Opens X)ᵒᵖ} (l : List ((F ⊗ G).val.obj V)) (k : H.val.obj V) :
    tmulSection (F ⊗ G) H l.sum k = (l.map fun t => tmulSection (F ⊗ G) H t k).sum := by
  induction l with
  | nil => exact tmulSection_zero_left k
  | cons a l ih => rw [List.sum_cons, tmulSection_add_left, ih, List.map_cons, List.sum_cons]

/-- Morphisms out of `(F ⊗ G) ⊗ H` are determined by their values on the sections
`(f ⊗ g) ⊗ h`. -/
theorem tensor₃_hom_ext {H K : SheafOfModules.{u} (ringCatSheafOf R)}
    {φ ψ : (F ⊗ G) ⊗ H ⟶ K}
    (h : ∀ (U : (Opens X)ᵒᵖ) (f : F.val.obj U) (g : G.val.obj U) (k : H.val.obj U),
      φ.val.app U (tmulSection (F ⊗ G) H (tmulSection F G f g) k) =
        ψ.val.app U (tmulSection (F ⊗ G) H (tmulSection F G f g) k)) : φ = ψ := by
  apply tensor_hom_ext
  intro U t k
  let ι := {x : X // x ∈ U.unop}
  have hloc : ∀ x : ι, ∃ (W : Opens X) (_ : x.1 ∈ W) (i : W ⟶ U.unop),
      IsBilinearSum F G (res _ i ((moduleSheafTensorIsoTensor F G).inv.val.app U t)) :=
    fun x => exists_isBilinearSum_res _ x.2
  choose W hxW iW hW using hloc
  let K' : TopCat.Sheaf AddCommGrpCat.{u} X := ⟨K.val.presheaf, K.isSheaf⟩
  have hcover : U.unop ≤ iSup W := fun x hx => Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxW ⟨x, hx⟩⟩
  apply K'.eq_of_locally_eq' W U.unop iW hcover
  intro x
  obtain ⟨l, hl⟩ := hW x
  have ht : res _ (iW x) t = (l.map fun p => tmulSection F G p.1 p.2).sum := by
    have e1 : res _ (iW x) t = (moduleSheafTensorIsoTensor F G).hom.val.app _
        (res _ (iW x) ((moduleSheafTensorIsoTensor F G).inv.val.app U t)) := by
      change (F ⊗ G).val.map (iW x).op t = (moduleSheafTensorIsoTensor F G).hom.val.app _
        ((moduleSheafTensor F G).val.map (iW x).op
          ((moduleSheafTensorIsoTensor F G).inv.val.app U t))
      rw [PresheafOfModules.naturality_apply]
      congr 1
      exact (congrArg (fun φ : F ⊗ G ⟶ F ⊗ G => (φ.val.app U).hom t)
        (moduleSheafTensorIsoTensor F G).inv_hom_id).symm
    rw [e1, hl, map_list_sum, List.map_map]
    exact congrArg List.sum (List.map_congr_left fun (p : F.val.obj _ × G.val.obj _) _ =>
      moduleSheafTensorIsoTensor_hom_bilinear F G p.1 p.2)
  change K.val.map (iW x).op (φ.val.app U _) = K.val.map (iW x).op (ψ.val.app U _)
  rw [← PresheafOfModules.naturality_apply, ← PresheafOfModules.naturality_apply]
  change φ.val.app _ (res _ (iW x) (tmulSection (F ⊗ G) H t k)) =
    ψ.val.app _ (res _ (iW x) (tmulSection (F ⊗ G) H t k))
  rw [tmulSection_res, ht, tmulSection_list_sum_left, map_list_sum, map_list_sum]
  simp only [List.map_map]
  exact congrArg List.sum (List.map_congr_left fun (p : F.val.obj _ × G.val.obj _) _ =>
    h (op (W x)) p.1 p.2 _)

end TensorExt

section Sheaf

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {M σM : Type u} [AddCommGroup M] [Module A M] [SetLike σM M] [AddSubgroupClass σM M]
  {ℳ : ℤ → σM} [SetLike.GradedSMul 𝒜 ℳ]

namespace ProjTwist

open ProjGradedModuleSheaf

theorem isLocallyFraction_twistPair (n : ℤ) {U : Opens (ProjectiveSpectrum.top 𝒜)}
    (s : (sheafInType 𝒜 ℳ).1.obj (op U))
    (t : (sheafInType 𝒜 (gradedTwist 𝒜 n)).1.obj (op U)) :
    (isLocallyFraction 𝒜 (gradedModuleTwist ℳ n)).pred
      (fun x : U => twistPair _ n (s.1 x) (t.1 x)) := fun x => by
  obtain ⟨Va, ma, ia, na, ra, hra, sa, hsa, hwa, wa⟩ := s.2 x
  obtain ⟨Vb, mb, ib, nb, rb, hrb, sb, hsb, hwb, wb⟩ := t.2 x
  refine ⟨Va ⊓ Vb, ⟨ma, mb⟩, Opens.infLELeft _ _ ≫ ia, nb + na, rb • ra, ?_, sb * sa,
    SetLike.GradedMul.mul_mem hsb hsa, fun y =>
      y.1.asHomogeneousIdeal.toIdeal.primeCompl.mul_mem (hwb ⟨y.1, y.2.2⟩) (hwa ⟨y.1, y.2.1⟩),
    fun y => ?_⟩
  · have := smul_mem_twist hrb hra
    change rb • ra ∈ ℳ (((nb + na : ℕ) : ℤ) + n)
    convert this using 2
    push_cast; ring
  · ext
    rw [val_twistPair]
    have ea := congrArg HomogeneousLocalizedModule.val (wa ⟨y.1, y.2.1⟩)
    have eb := congrArg HomogeneousLocalizedModule.val (wb ⟨y.1, y.2.2⟩)
    refine (congrArg₂ (fun (a : Localization _) b => a • b) eb ea).trans ?_
    exact LocalizedModule.mk_smul_mk _ _ _ _

variable (𝒜 ℳ) in
/-- The bilinear morphism `M~ × 𝒪_X(n) → M(n)~`, pointwise the pairing
`M_(x) × S(n)_(x) → M(n)_(x)`. -/
def twistBilinear (n : ℤ) :
    ModuleSheafBilinear (projGradedModuleSheaf 𝒜 ℳ) (projTwistingSheaf 𝒜 n)
      (projGradedModuleSheaf 𝒜 (gradedModuleTwist ℳ n)) where
  app U := LinearMap.mk₂ _
    (fun s t => (⟨fun x => twistPair _ n ((s : (sheafInType 𝒜 ℳ).1.obj U).1 x)
        ((t : (sheafInType 𝒜 (gradedTwist 𝒜 n)).1.obj U).1 x),
      isLocallyFraction_twistPair n s t⟩ : (sheafInType 𝒜 (gradedModuleTwist ℳ n)).1.obj U))
    (fun _ _ _ => section_ext fun _ => LinearMap.map_add₂ _ _ _ _)
    (fun _ _ _ => section_ext fun _ => LinearMap.map_smul₂ _ _ _ _)
    (fun _ _ _ => section_ext fun _ => map_add _ _ _)
    (fun _ _ _ => section_ext fun _ => map_smul _ _ _)
  naturality _ _ _ := rfl

theorem twistBilinear_apply (n : ℤ) {U : (Opens (ProjectiveSpectrum.top 𝒜))ᵒᵖ}
    (s : (projGradedModuleSheaf 𝒜 ℳ).val.obj U) (t : (projTwistingSheaf 𝒜 n).val.obj U)
    (x : U.unop) :
    (((twistBilinear 𝒜 ℳ n).app U s t : (projGradedModuleSheaf 𝒜 (gradedModuleTwist ℳ n)).val.obj U) :
      (sheafInType 𝒜 (gradedModuleTwist ℳ n)).1.obj U).1 x =
      twistPair (𝒜 := 𝒜) _ n ((s : (sheafInType 𝒜 ℳ).1.obj U).1 x)
        ((t : (sheafInType 𝒜 (gradedTwist 𝒜 n)).1.obj U).1 x) := rfl

variable (𝒜 ℳ) in
/-- The morphism `M~ ⊗ 𝒪_X(n) ⟶ M(n)~` out of the tensor product of module sheaves
(sheafification of the sectionwise tensor product), induced by `twistBilinear`. -/
def twistTensorHom (n : ℤ) :
    moduleSheafTensor (projGradedModuleSheaf 𝒜 ℳ) (projTwistingSheaf 𝒜 n) ⟶
      projGradedModuleSheaf 𝒜 (gradedModuleTwist ℳ n) :=
  (moduleSheafTensorHomEquiv _ _ _).symm (twistBilinear 𝒜 ℳ n)

theorem twistTensorHom_bilinear (n : ℤ) (U : (Opens (ProjectiveSpectrum.top 𝒜))ᵒᵖ)
    (s : (projGradedModuleSheaf 𝒜 ℳ).val.obj U) (t : (projTwistingSheaf 𝒜 n).val.obj U) :
    (twistTensorHom 𝒜 ℳ n).val.app U
        ((moduleSheafTensorBilinear (projGradedModuleSheaf 𝒜 ℳ) (projTwistingSheaf 𝒜 n)).app U s t) =
      (twistBilinear 𝒜 ℳ n).app U s t := by
  have h := moduleSheafTensorHomEquiv_apply (twistTensorHom 𝒜 ℳ n)
  rw [twistTensorHom, Equiv.apply_symm_apply] at h
  exact (congrArg (fun β : ModuleSheafBilinear _ _ _ => β.app U s t) h).symm

open ModuleSheafTensor Ringed in
/-- On stalks, the twist morphism followed by `M(n)~_x ≅ M(n)_(x)` is the pairing of the values
at `x`. -/
theorem twistTensorHom_stalk_tmul (n : ℤ) (x : Proj 𝒜)
    (a : moduleStalk (projGradedModuleSheaf 𝒜 ℳ).val x)
    (b : moduleStalk (projTwistingSheaf 𝒜 n).val x) :
    stalkLinearEquiv 𝒜 (gradedModuleTwist ℳ n) x (stalkAddMap (twistTensorHom 𝒜 ℳ n).val x
      ((moduleSheafTensorStalkIso (projGradedModuleSheaf 𝒜 ℳ) (projTwistingSheaf 𝒜 n) x).symm
        (a ⊗ₜ b))) =
      twistPair _ n (stalkLinearEquiv 𝒜 ℳ x a) (stalkLinearEquiv 𝒜 (gradedTwist 𝒜 n) x b) := by
  obtain ⟨U, hU, s, rfl⟩ := exists_sectionGerm _ x a
  obtain ⟨V, hV, t, rfl⟩ := exists_sectionGerm _ x b
  have hW : x ∈ U ⊓ V := ⟨hU, hV⟩
  rw [← sectionGerm_res _ x (homOfLE inf_le_left : U ⊓ V ⟶ U) hW s,
    ← sectionGerm_res _ x (homOfLE inf_le_right : U ⊓ V ⟶ V) hW t]
  set s' := res _ (homOfLE inf_le_left : U ⊓ V ⟶ U) s
  set t' := res _ (homOfLE inf_le_right : U ⊓ V ⟶ V) t
  have e1 := moduleSheafTensorStalkIso_germ (projGradedModuleSheaf 𝒜 ℳ) (projTwistingSheaf 𝒜 n)
    x (U ⊓ V) hW s' t'
  rw [← LinearEquiv.eq_symm_apply] at e1
  erw [← e1]
  change stalkLinearEquiv 𝒜 (gradedModuleTwist ℳ n) x
    (stalkAddMap (twistTensorHom 𝒜 ℳ n).val x (sectionGerm _ x (U ⊓ V) hW _)) = _
  rw [stalkAddMap_germ, twistTensorHom_bilinear]
  erw [stalkLinearEquiv_germ, stalkLinearEquiv_germ, stalkLinearEquiv_germ]
  rfl

open ModuleSheafTensor Ringed in
/-- If `S` is generated by `S_1`, the twist morphism is bijective on every stalk. -/
theorem twistTensorHom_stalk_bijective (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℤ)
    (x : Proj 𝒜) : Function.Bijective (stalkAddMap (twistTensorHom 𝒜 ℳ n).val x) := by
  obtain ⟨f, f_deg, hfx⟩ := ProjTwistingSheaf.exists_mem_one_notMem hgen x
  have hfT : f ∈ x.asHomogeneousIdeal.toIdeal.primeCompl := hfx
  set e := moduleSheafTensorStalkIso (projGradedModuleSheaf 𝒜 ℳ) (projTwistingSheaf 𝒜 n) x
  set EF := stalkLinearEquiv 𝒜 ℳ x
  set EG := stalkLinearEquiv 𝒜 (gradedTwist 𝒜 n) x
  set EH := stalkLinearEquiv 𝒜 (gradedModuleTwist ℳ n) x
  set σ := stalkAddMap (twistTensorHom 𝒜 ℳ n).val x
  let Φ : _ →+ _ := EH.toAddMonoidHom.comp (σ.comp e.symm.toAddMonoidHom)
  have hΦ : ∀ a b, Φ (a ⊗ₜ b) = twistPair _ n (EF a) (EG b) :=
    fun a b => twistTensorHom_stalk_tmul n x a b
  set b0 : moduleStalk (projTwistingSheaf 𝒜 n).val x := EG.symm (twistGen n f_deg hfT)
  have hform : ∀ w : moduleStalk (projGradedModuleSheaf 𝒜 ℳ).val x ⊗[ringSheafStalk (Proj 𝒜).sheaf x]
      moduleStalk (projTwistingSheaf 𝒜 n).val x, ∃ a, w = a ⊗ₜ b0 := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨0, (TensorProduct.zero_tmul _ _).symm⟩
    | tmul a b =>
      obtain ⟨c, hc⟩ := exists_smul_twistGen n f_deg hfT (EG b)
      refine ⟨(show ringSheafStalk (Proj 𝒜).sheaf x from stalkRingHomInv 𝒜 x c) • a, ?_⟩
      rw [TensorProduct.smul_tmul]
      congr 1
      have hb : b = EG.symm (c • twistGen n f_deg hfT) := by
        rw [← hc, LinearEquiv.symm_apply_apply]
      rw [hb, LinearEquiv.map_smulₛₗ]
      rfl
    | add w w' hw hw' =>
      obtain ⟨a, rfl⟩ := hw
      obtain ⟨a', rfl⟩ := hw'
      exact ⟨a + a', (TensorProduct.add_tmul _ _ _).symm⟩
  have hΦ0 : ∀ a, Φ (a ⊗ₜ b0) = twistPair _ n (EF a) (twistGen n f_deg hfT) := by
    intro a
    rw [hΦ, LinearEquiv.apply_symm_apply]
  have hbij : Function.Bijective Φ := by
    refine ⟨(injective_iff_map_eq_zero Φ).2 fun w hw => ?_, fun y => ?_⟩
    · obtain ⟨a, rfl⟩ := hform w
      rw [hΦ0] at hw
      have := twistPair_twistGen_eq_zero n f_deg hfT hw
      rw [EF.map_eq_zero_iff] at this
      rw [this]
      exact TensorProduct.zero_tmul _ _
    · obtain ⟨m, hm⟩ := exists_twistPair_twistGen n f_deg hfT y
      exact ⟨EF.symm m ⊗ₜ b0, by rw [hΦ0, LinearEquiv.apply_symm_apply, hm]⟩
  have h : (σ : _ → _) = EH.symm ∘ Φ ∘ e := by
    funext w
    change σ w = EH.symm (EH (σ (e.symm (e w))))
    rw [EH.symm_apply_apply, e.symm_apply_apply]
  rw [h]
  exact EH.symm.bijective.comp (hbij.comp e.bijective)

/-- If `S` is generated by `S_1`, the twist morphism is an isomorphism. -/
theorem isIso_twistTensorHom (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℤ) :
    IsIso (twistTensorHom 𝒜 ℳ n) := by
  have : IsIso ((SheafOfModules.toSheaf.{u} (Proj 𝒜).ringCatSheaf).map
      (twistTensorHom 𝒜 ℳ n)) := by
    apply (TopCat.Presheaf.isIso_iff_stalkFunctor_map_iso _).2
    intro x
    rw [ConcreteCategory.isIso_iff_bijective]
    exact twistTensorHom_stalk_bijective hgen n x
  have hr : (SheafOfModules.toSheaf.{u} (Proj 𝒜).ringCatSheaf).ReflectsIsomorphisms :=
    inferInstance
  exact hr.reflects (twistTensorHom 𝒜 ℳ n)

open Ringed in
theorem moduleSheafTensorIsoTensor_inv_tmulSection {X : TopCat.{u}}
    {R : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}
    (F G : SheafOfModules.{u} (ringCatSheafOf R)) {U : (Opens X)ᵒᵖ} (f : F.val.obj U)
    (g : G.val.obj U) :
    (moduleSheafTensorIsoTensor F G).inv.val.app U (tmulSection F G f g) =
      (moduleSheafTensorBilinear F G).app U f g := by
  rw [← moduleSheafTensorIsoTensor_hom_bilinear]
  exact congrArg (fun φ : moduleSheafTensor F G ⟶ moduleSheafTensor F G =>
    (φ.val.app U).hom ((moduleSheafTensorBilinear F G).app U f g))
    (moduleSheafTensorIsoTensor F G).hom_inv_id

variable (ℳ) in
open Ringed in
/-- **Hartshorne II.5.12(b).** If `S` is generated by `S_1` as an `S_0`-algebra, then for a graded
`S`-module `M` and `n ∈ ℤ`, `M~ ⊗ 𝒪_X(n) ≅ M(n)~` on `X = Proj S`; on sections it sends
`s ⊗ t` to the pointwise pairing of `s` and `t`. -/
def twistIso (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℤ) :
    projGradedModuleSheaf 𝒜 ℳ ⊗ projTwistingSheaf 𝒜 n ≅
      projGradedModuleSheaf 𝒜 (gradedModuleTwist ℳ n) :=
  (moduleSheafTensorIsoTensor _ _).symm ≪≫
    @asIso _ _ _ _ (twistTensorHom 𝒜 ℳ n) (isIso_twistTensorHom hgen n)

open Ringed in
theorem twistIso_hom_tmulSection (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℤ)
    {U : (Opens (ProjectiveSpectrum.top 𝒜))ᵒᵖ}
    (s : (projGradedModuleSheaf 𝒜 ℳ).val.obj U) (t : (projTwistingSheaf 𝒜 n).val.obj U) :
    (twistIso ℳ hgen n).hom.val.app U (tmulSection _ _ s t) = (twistBilinear 𝒜 ℳ n).app U s t := by
  change (twistTensorHom 𝒜 ℳ n).val.app U
    ((moduleSheafTensorIsoTensor _ _).inv.val.app U (tmulSection _ _ s t)) = _
  exact (congrArg ((twistTensorHom 𝒜 ℳ n).val.app U).hom
    (moduleSheafTensorIsoTensor_inv_tmulSection _ _ s t)).trans (twistTensorHom_bilinear n U s t)

end ProjTwist

end Sheaf

section SheafMap

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {M σM : Type u} [AddCommGroup M] [Module A M] [SetLike σM M] [AddSubgroupClass σM M]
  {ℳ : ℤ → σM} [SetLike.GradedSMul 𝒜 ℳ]
  {N σN : Type u} [AddCommGroup N] [Module A N] [SetLike σN N] [AddSubgroupClass σN N]
  {𝒩 : ℤ → σN} [SetLike.GradedSMul 𝒜 𝒩]
  (g : M →ₗ[A] N) (hg : ∀ (i : ℤ) (m : M), m ∈ ℳ i → g m ∈ 𝒩 i)

open ProjGradedModuleSheaf

/-- The map on sections of `M~ ⟶ N~` induced by a graded linear map. -/
def gradedSheafSections (U : Opens (ProjectiveSpectrum.top 𝒜)) :
    (sheafInType 𝒜 ℳ).1.obj (op U) →+ (sheafInType 𝒜 𝒩).1.obj (op U) where
  toFun s := ⟨fun x => gradedLocMap g hg _ (s.1 x), by
    intro x
    obtain ⟨V, hxV, i, k, m, hm, t, ht, t_nin, w⟩ := s.2 x
    refine ⟨V, hxV, i, k, g m, hg _ m hm, t, ht, t_nin, fun y => ?_⟩
    exact (congrArg (gradedLocMap g hg _) (w y)).trans
      (HomogeneousLocalizedModule.ext (IsLocalizedModule.map_LocalizedModules _ _ _ _))⟩
  map_zero' := Subtype.ext <| funext fun _ => map_zero (gradedLocMap g hg _)
  map_add' _ _ := Subtype.ext <| funext fun _ => map_add (gradedLocMap g hg _) _ _

/-- The morphism of underlying abelian presheaves. -/
def gradedSheafPresheafHom :
    (projGradedModuleSheaf 𝒜 ℳ).val.presheaf ⟶ (projGradedModuleSheaf 𝒜 𝒩).val.presheaf where
  app U := AddCommGrpCat.ofHom (gradedSheafSections g hg U.unop)
  naturality _ _ _ := rfl

/-- The morphism `M~ ⟶ N~` of `𝒪_{Proj S}`-modules induced by a degree-preserving linear map
`g : M → N` of graded modules; pointwise it is `m / s ↦ g m / s`. -/
def projGradedModuleSheafMap : projGradedModuleSheaf 𝒜 ℳ ⟶ projGradedModuleSheaf 𝒜 𝒩 :=
  ⟨PresheafOfModules.homMk (gradedSheafPresheafHom g hg) fun _ _ _ =>
    Subtype.ext <| funext fun _ => map_smul (gradedLocMap g hg _) _ _⟩

theorem projGradedModuleSheafMap_app_apply {U : (Opens (ProjectiveSpectrum.top 𝒜))ᵒᵖ}
    (s : (projGradedModuleSheaf 𝒜 ℳ).val.obj U) (x : U.unop) :
    (((projGradedModuleSheafMap g hg).val.app U s : (projGradedModuleSheaf 𝒜 𝒩).val.obj U) :
      (sheafInType 𝒜 𝒩).1.obj U).1 x = gradedLocMap g hg _ ((s : (sheafInType 𝒜 ℳ).1.obj U).1 x) :=
  rfl

open Ringed ProjTwist in
/-- **Naturality** of `M~ ⊗ 𝒪_X(n) ≅ M(n)~` in the graded module `M`. -/
theorem twistIso_hom_naturality (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℤ) :
    (projGradedModuleSheafMap g hg ▷ projTwistingSheaf 𝒜 n) ≫ (twistIso 𝒩 hgen n).hom =
      (twistIso ℳ hgen n).hom ≫
        projGradedModuleSheafMap (ℳ := gradedModuleTwist ℳ n) (𝒩 := gradedModuleTwist 𝒩 n) g
          (fun i m hm => hg (i + n) m hm) := by
  apply tensor_hom_ext
  intro U s t
  change (twistIso 𝒩 hgen n).hom.val.app U
      ((projGradedModuleSheafMap g hg ▷ projTwistingSheaf 𝒜 n).val.app U (tmulSection _ _ s t)) =
    (projGradedModuleSheafMap g _).val.app U ((twistIso ℳ hgen n).hom.val.app U
      (tmulSection _ _ s t))
  rw [scheme_whiskerRight_tmulSection, twistIso_hom_tmulSection, twistIso_hom_tmulSection]
  refine section_ext fun x => ?_
  rw [projGradedModuleSheafMap_app_apply, twistBilinear_apply, twistBilinear_apply,
    projGradedModuleSheafMap_app_apply, gradedLocMap_twistPair]

end SheafMap

section Regrade

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {M σM σM' : Type u} [AddCommGroup M] [Module A M] [SetLike σM M] [AddSubgroupClass σM M]
  [SetLike σM' M] [AddSubgroupClass σM' M]
  {ℳ : ℤ → σM} [SetLike.GradedSMul 𝒜 ℳ] {ℳ' : ℤ → σM'} [SetLike.GradedSMul 𝒜 ℳ']

open ProjGradedModuleSheaf

theorem gradedLocMap_id_val {h : ∀ (i : ℤ) (m : M), m ∈ ℳ i → LinearMap.id m ∈ ℳ' i}
    (T : Submonoid A) (y : HomogeneousLocalizedModule 𝒜 ℳ T) :
    (gradedLocMap (ℳ := ℳ) (𝒩 := ℳ') LinearMap.id h T y).val = y.val := by
  rw [val_gradedLocMap, IsLocalizedModule.map_id]
  rfl

variable (ℳ ℳ') in
/-- Two gradings of the same module with the same homogeneous components give isomorphic
sheaves; the isomorphism is the identity on the underlying fractions. -/
def regradeIso (h : ∀ (i : ℤ) (m : M), m ∈ ℳ i ↔ m ∈ ℳ' i) :
    projGradedModuleSheaf 𝒜 ℳ ≅ projGradedModuleSheaf 𝒜 ℳ' where
  hom := projGradedModuleSheafMap LinearMap.id fun i m hm => (h i m).1 hm
  inv := projGradedModuleSheafMap LinearMap.id fun i m hm => (h i m).2 hm
  hom_inv_id := SheafOfModules.hom_ext <| PresheafOfModules.hom_ext fun U => by
    ext s x
    have e1 := gradedLocMap_id_val (𝒜 := 𝒜) (ℳ := ℳ) (ℳ' := ℳ') (h := fun i m hm => (h i m).1 hm) _
      ((s : (sheafInType 𝒜 ℳ).1.obj U).1 x)
    have e2 := gradedLocMap_id_val (𝒜 := 𝒜) (ℳ := ℳ') (ℳ' := ℳ) (h := fun i m hm => (h i m).2 hm) _
      (gradedLocMap (𝒜 := 𝒜) (ℳ := ℳ) (𝒩 := ℳ') LinearMap.id (fun i m hm => (h i m).1 hm) _
        ((s : (sheafInType 𝒜 ℳ).1.obj U).1 x))
    exact e2.trans e1
  inv_hom_id := SheafOfModules.hom_ext <| PresheafOfModules.hom_ext fun U => by
    ext s x
    have e1 := gradedLocMap_id_val (𝒜 := 𝒜) (ℳ := ℳ') (ℳ' := ℳ) (h := fun i m hm => (h i m).2 hm) _
      ((s : (sheafInType 𝒜 ℳ').1.obj U).1 x)
    have e2 := gradedLocMap_id_val (𝒜 := 𝒜) (ℳ := ℳ) (ℳ' := ℳ') (h := fun i m hm => (h i m).1 hm) _
      (gradedLocMap (𝒜 := 𝒜) (ℳ := ℳ') (𝒩 := ℳ) LinearMap.id (fun i m hm => (h i m).2 hm) _
        ((s : (sheafInType 𝒜 ℳ').1.obj U).1 x))
    exact e2.trans e1

theorem regradeIso_hom_app_val (h : ∀ (i : ℤ) (m : M), m ∈ ℳ i ↔ m ∈ ℳ' i)
    {U : (Opens (ProjectiveSpectrum.top 𝒜))ᵒᵖ} (s : (projGradedModuleSheaf 𝒜 ℳ).val.obj U)
    (x : U.unop) :
    ((((regradeIso ℳ ℳ' h).hom.val.app U s : (projGradedModuleSheaf 𝒜 ℳ').val.obj U) :
      (sheafInType 𝒜 ℳ').1.obj U).1 x).val = ((s : (sheafInType 𝒜 ℳ).1.obj U).1 x).val :=
  gradedLocMap_id_val _ _

end Regrade

section TwistMul

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]

omit [GradedRing 𝒜] in
theorem mem_gradedModuleTwist_gradedTwist (n m d : ℤ) (a : A) :
    a ∈ gradedModuleTwist (gradedTwist 𝒜 n) m d ↔ a ∈ gradedTwist 𝒜 (n + m) d := by
  change (a ∈ 𝒜 (n + (d + m)).toNat ∧ (n + (d + m) < 0 → a = 0)) ↔
    (a ∈ 𝒜 (n + m + d).toNat ∧ (n + m + d < 0 → a = 0))
  rw [show n + (d + m) = n + m + d by ring]

variable (𝒜) in
/-- **Hartshorne II.5.12(b), second statement.** If `S` is generated by `S_1` as an
`S_0`-algebra, `𝒪_X(n) ⊗ 𝒪_X(m) ≅ 𝒪_X(n + m)` on `X = Proj S`. -/
def twistMulIso (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n m : ℤ) :
    projTwistingSheaf 𝒜 n ⊗ projTwistingSheaf 𝒜 m ≅ projTwistingSheaf 𝒜 (n + m) :=
  ProjTwist.twistIso (gradedTwist 𝒜 n) hgen m ≪≫
    regradeIso _ _ (mem_gradedModuleTwist_gradedTwist n m)

end TwistMul

section Assoc

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {M σM : Type u} [AddCommGroup M] [Module A M] [SetLike σM M] [AddSubgroupClass σM M]
  {ℳ : ℤ → σM} [SetLike.GradedSMul 𝒜 ℳ]

open ProjGradedModuleSheaf ProjTwist Ringed

omit [AddCommGroup M] [AddSubgroupClass σM M] in
theorem mem_gradedModuleTwist_twist (n m d : ℤ) (x : M) :
    x ∈ gradedModuleTwist (gradedModuleTwist ℳ n) m d ↔ x ∈ gradedModuleTwist ℳ (n + m) d := by
  change x ∈ ℳ (d + m + n) ↔ x ∈ ℳ (d + (n + m))
  rw [show d + m + n = d + (n + m) by ring]

theorem twistMulIso_hom_tmulSection (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n m : ℤ)
    {U : (Opens (ProjectiveSpectrum.top 𝒜))ᵒᵖ}
    (t : (projTwistingSheaf 𝒜 n).val.obj U) (k : (projTwistingSheaf 𝒜 m).val.obj U) (x : U.unop) :
    ((((twistMulIso 𝒜 hgen n m).hom.val.app U (tmulSection _ _ t k) :
        (projTwistingSheaf 𝒜 (n + m)).val.obj U) :
      (sheafInType 𝒜 (gradedTwist 𝒜 (n + m))).1.obj U).1 x).val =
      (show Localization _ from ((k : (sheafInType 𝒜 (gradedTwist 𝒜 m)).1.obj U).1 x).val) •
        ((t : (sheafInType 𝒜 (gradedTwist 𝒜 n)).1.obj U).1 x).val := by
  change ((((regradeIso _ _ (mem_gradedModuleTwist_gradedTwist (𝒜 := 𝒜) n m)).hom.val.app U
    ((twistIso (gradedTwist 𝒜 n) hgen m).hom.val.app U (tmulSection _ _ t k)) :
      (projTwistingSheaf 𝒜 (n + m)).val.obj U) :
    (sheafInType 𝒜 (gradedTwist 𝒜 (n + m))).1.obj U).1 x).val = _
  rw [twistIso_hom_tmulSection, regradeIso_hom_app_val, twistBilinear_apply, val_twistPair]

/-- **Associativity of the twist isomorphisms** (a project addition to Hartshorne II.5.12(b)):
the two isomorphisms `(M~ ⊗ 𝒪_X(n)) ⊗ 𝒪_X(m) ≅ M(n + m)~`, one through `M(n)~ ⊗ 𝒪_X(m)` and
the other through the associator and `M~ ⊗ 𝒪_X(n + m)`, agree. -/
theorem twistIso_assoc (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n m : ℤ) :
    ((twistIso ℳ hgen n).hom ▷ projTwistingSheaf 𝒜 m) ≫
        (twistIso (gradedModuleTwist ℳ n) hgen m).hom ≫
          (regradeIso _ _ (mem_gradedModuleTwist_twist (ℳ := ℳ) n m)).hom =
      (α_ _ _ _).hom ≫ (projGradedModuleSheaf 𝒜 ℳ ◁ (twistMulIso 𝒜 hgen n m).hom) ≫
        (twistIso ℳ hgen (n + m)).hom := by
  apply tensor₃_hom_ext
  intro U s t k
  change (regradeIso _ _ (mem_gradedModuleTwist_twist (ℳ := ℳ) n m)).hom.val.app U
      ((twistIso (gradedModuleTwist ℳ n) hgen m).hom.val.app U
        (((twistIso ℳ hgen n).hom ▷ projTwistingSheaf 𝒜 m).val.app U
          (tmulSection _ _ (tmulSection _ _ s t) k))) =
    (twistIso ℳ hgen (n + m)).hom.val.app U
      ((projGradedModuleSheaf 𝒜 ℳ ◁ (twistMulIso 𝒜 hgen n m).hom).val.app U
        ((α_ (projGradedModuleSheaf 𝒜 ℳ) (projTwistingSheaf 𝒜 n) (projTwistingSheaf 𝒜 m)).hom.val.app
          U (tmulSection _ _ (tmulSection _ _ s t) k)))
  rw [scheme_whiskerRight_tmulSection, twistIso_hom_tmulSection, twistIso_hom_tmulSection,
    scheme_associator_hom_tmulSection, scheme_whiskerLeft_tmulSection, twistIso_hom_tmulSection]
  ext x
  rw [regradeIso_hom_app_val, twistBilinear_apply, val_twistPair, twistBilinear_apply,
    val_twistPair, twistBilinear_apply, val_twistPair]
  change _ = (show Localization _ from ((((twistMulIso 𝒜 hgen n m).hom.val.app U
    (tmulSection _ _ t k) : (projTwistingSheaf 𝒜 (n + m)).val.obj U) :
      (sheafInType 𝒜 (gradedTwist 𝒜 (n + m))).1.obj U).1 x).val) • _
  rw [twistMulIso_hom_tmulSection]
  exact (mul_smul _ _ _).symm

theorem eqToHom_projTwistingSheaf_val {a b : ℤ} (h : a = b)
    {U : (Opens (ProjectiveSpectrum.top 𝒜))ᵒᵖ} (s : (projTwistingSheaf 𝒜 a).val.obj U)
    (x : U.unop) :
    ((((eqToHom (congrArg (projTwistingSheaf 𝒜) h)).val.app U s :
        (projTwistingSheaf 𝒜 b).val.obj U) :
      (sheafInType 𝒜 (gradedTwist 𝒜 b)).1.obj U).1 x).val =
      ((s : (sheafInType 𝒜 (gradedTwist 𝒜 a)).1.obj U).1 x).val := by
  subst h
  rfl

/-- **Associativity of `𝒪_X(n) ⊗ 𝒪_X(m) ≅ 𝒪_X(n + m)`** (a project addition): the two
isomorphisms `(𝒪_X(n) ⊗ 𝒪_X(m)) ⊗ 𝒪_X(l) ≅ 𝒪_X(n + m + l)` agree, after identifying
`𝒪_X(n + (m + l)) = 𝒪_X(n + m + l)`. -/
theorem twistMulIso_assoc (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n m l : ℤ) :
    ((twistMulIso 𝒜 hgen n m).hom ▷ projTwistingSheaf 𝒜 l) ≫ (twistMulIso 𝒜 hgen (n + m) l).hom =
      (α_ _ _ _).hom ≫ (projTwistingSheaf 𝒜 n ◁ (twistMulIso 𝒜 hgen m l).hom) ≫
        (twistMulIso 𝒜 hgen n (m + l)).hom ≫ eqToHom (by rw [add_assoc]) := by
  apply tensor₃_hom_ext
  intro U s t k
  change (twistMulIso 𝒜 hgen (n + m) l).hom.val.app U
      (((twistMulIso 𝒜 hgen n m).hom ▷ projTwistingSheaf 𝒜 l).val.app U
        (tmulSection _ _ (tmulSection _ _ s t) k)) =
    (eqToHom (congrArg (projTwistingSheaf 𝒜) (add_assoc n m l).symm)).val.app U
      ((twistMulIso 𝒜 hgen n (m + l)).hom.val.app U
        ((projTwistingSheaf 𝒜 n ◁ (twistMulIso 𝒜 hgen m l).hom).val.app U
          ((α_ (projTwistingSheaf 𝒜 n) (projTwistingSheaf 𝒜 m) (projTwistingSheaf 𝒜 l)).hom.val.app
            U (tmulSection _ _ (tmulSection _ _ s t) k))))
  rw [scheme_whiskerRight_tmulSection, scheme_associator_hom_tmulSection,
    scheme_whiskerLeft_tmulSection]
  refine section_ext (ℳ := gradedTwist 𝒜 (n + m + l)) fun x => HomogeneousLocalizedModule.ext ?_
  rw [eqToHom_projTwistingSheaf_val (add_assoc n m l).symm, twistMulIso_hom_tmulSection, twistMulIso_hom_tmulSection,
    twistMulIso_hom_tmulSection, twistMulIso_hom_tmulSection]
  exact (smul_assoc _ _ _).symm

end Assoc

section Chart

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]

open ProjGradedModuleSheaf ProjTwist Ringed

variable {f : A} (f_deg : f ∈ 𝒜 1)

/-- The section `f^n` of `𝒪_X(n)` over `D₊(f)`, for `f ∈ S_1`: the local generator through which
multiplication by `f^n` trivializes `𝒪_X(n)` on `D₊(f)`. -/
def twistGenSection (n : ℤ) :
    (projTwistingSheaf 𝒜 n).val.obj (op (ProjectiveSpectrum.basicOpen 𝒜 f)) :=
  (⟨fun x => twistGen n f_deg (show f ∈ x.1.asHomogeneousIdeal.toIdeal.primeCompl from x.2),
    fun x => ⟨ProjectiveSpectrum.basicOpen 𝒜 f, x.2, 𝟙 _, (-n).toNat, f ^ n.toNat,
      (mem_gradedTwist_of_eq (k := n.toNat) (by omega)).2
        (ProjTwistingSheaf.pow_mem_of_mem_one f_deg _),
      f ^ (-n).toNat, ProjTwistingSheaf.pow_mem_of_mem_one f_deg _,
      fun y => pow_mem (show f ∈ y.1.asHomogeneousIdeal.toIdeal.primeCompl from y.2) _,
      fun _ => rfl⟩⟩ :
    (sheafInType 𝒜 (gradedTwist 𝒜 n)).1.obj (op (ProjectiveSpectrum.basicOpen 𝒜 f)))

/-- **Compatibility with the chart trivializations** (a project addition to Hartshorne
II.5.12(b)): over `D₊(f)`, `f ∈ S_1`, the isomorphism `𝒪_X(n) ⊗ 𝒪_X(m) ≅ 𝒪_X(n + m)` sends the
product of the local generators `f^n ⊗ f^m` to the local generator `f^(n + m)`. -/
theorem twistMulIso_hom_twistGenSection (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤)
    (n m : ℤ) :
    (twistMulIso 𝒜 hgen n m).hom.val.app (op (ProjectiveSpectrum.basicOpen 𝒜 f))
        (tmulSection _ _ (twistGenSection f_deg n) (twistGenSection f_deg m)) =
      twistGenSection f_deg (n + m) := by
  refine section_ext (ℳ := gradedTwist 𝒜 (n + m)) fun x => HomogeneousLocalizedModule.ext ?_
  rw [twistMulIso_hom_tmulSection]
  exact twistGen_mul n f_deg x.2 m

end Chart

end Hartshorne
