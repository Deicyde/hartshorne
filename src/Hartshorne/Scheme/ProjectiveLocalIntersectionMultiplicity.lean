/-!
# The local multiplicity of a hypersurface section of a closed subscheme of projective space

Let `ℙⁿ_k = Proj S`, `S = k[x₀, ..., xₙ]`, let `ι : X ⟶ ℙⁿ_k` be a closed immersion of a scheme
satisfying Hartshorne's condition `(*)`, and let `V` be a prime divisor of `ℙⁿ_k` with homogeneous
equation `f`, not containing `X`. For a codimension-one point `x` of `X` let `𝔓` be the homogeneous
prime of `ι x` and `𝔭` that of the image of the generic point. This file proves that the
coefficient `ord_x(f / g)` of the divisor `V · X` of Hartshorne, Exercise II.6.2(a), equals the
length of `(S / (𝔭 + (f)))_𝔓` over `S_𝔓`, the local intersection multiplicity of Theorem I.7.7.

The proof has an algebraic and a geometric half.

* The stalk of `X` at `x` is `S_(𝔓) / 𝔭_(𝔓)`: the stalk map of `ι` is surjective, and an element
  `a / b` of the homogeneous localization dies in the stalk exactly when it dies in the function
  field, i.e. when its germ at the image of the generic point is a non-unit, i.e. when `a ∈ 𝔭`.
* If `R = S_(𝔓) / 𝔭_(𝔓)` is a discrete valuation ring with uniformizer `π`, then `T = S_𝔓 / 𝔭 S_𝔓`
  is one too, with uniformizer the image of `π`: the maximal ideal of `T` is generated by
  homogeneous `h ∈ 𝔓`, and `h = (h / x_i^e) x_i^e` with `x_i ∉ 𝔓`. Writing `f / g = u π^m` in `R`
  then gives `ord_R(f / g) = m = ord_T(f) = length (S / (𝔭 + (f)))_𝔓`.

## Main results

* `Hartshorne.ringOrd_homogeneousLocalization_quotient_eq_length`: the algebraic comparison.
* `Hartshorne.stalkMap_stalkIso_inv_eq_zero_iff`: the kernel of the stalk map of `ι`.
* `Hartshorne.projectiveIntersectionDivisor_apply_eq_length`: the coefficient of `V · X` at `x`
  is the local length.
-/

open AlgebraicGeometry CategoryTheory MvPolynomial HomogeneousLocalization IsLocalRing

attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable section

namespace Hartshorne

universe u
variable {k : Type u} [Field k] {n : ℕ}

local notation "𝒜" => homogeneousSubmodule (Fin (n + 1)) k
local notation "S" => MvPolynomial (Fin (n + 1)) k

/-- The ideal of `S_(P)` of fractions whose numerator lies in `𝔭`. -/
def homogeneousLocalizationIdeal (P 𝔭 : Ideal S) [P.IsPrime] : Ideal (AtPrime 𝒜 P) :=
  (𝔭.map (algebraMap S (Localization.AtPrime P))).comap
    (algebraMap (AtPrime 𝒜 P) (Localization.AtPrime P))


/-- In a local ring, the image of a non-unit in a local quotient is a non-unit. -/
theorem quotient_mk_mem_maximalIdeal {A : Type*} [CommRing A] [IsLocalRing A] {I : Ideal A}
    [IsLocalRing (A ⧸ I)] {a : A} (ha : a ∈ maximalIdeal A) :
    Ideal.Quotient.mk I a ∈ maximalIdeal (A ⧸ I) := by
  intro hu
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (hu.unit⁻¹ : (A ⧸ I)ˣ).1
  have h1 : Ideal.Quotient.mk I (a * b) = 1 := by rw [map_mul, hb]; exact hu.mul_val_inv
  have hI : I ≤ maximalIdeal A := IsLocalRing.le_maximalIdeal fun h ↦ by
    have := Ideal.Quotient.subsingleton_iff.mpr h
    exact (not_subsingleton (A ⧸ I)) this
  have : a * b - 1 ∈ I := Ideal.Quotient.eq.mp (by rw [h1, map_one])
  have h2 := sub_mem (Ideal.mul_mem_right b _ ha) (hI this)
  rw [sub_sub_cancel] at h2
  exact (maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h2)

/-- The length of the localization of `R ⧸ I` is the length of `R_p ⧸ I R_p`. -/
theorem length_localizedModule_quotient {R : Type*} [CommRing R] (p : Submonoid R)
    (I : Ideal R) :
    Module.length (Localization p) (LocalizedModule p (R ⧸ I)) =
      Module.length (Localization p) (Localization p ⧸ I.map (algebraMap R (Localization p))) := by
  have := IsLocalization.linearMap_compatibleSMul p
  let e := (IsLocalizedModule.linearEquiv p
    (I.toLocalizedQuotient' (Localization p) p (Algebra.linearMap R (Localization p)))
    (LocalizedModule.mkLinearMap p (R ⧸ I))).restrictScalars (Localization p)
  have hI : I.localized' (Localization p) p (Algebra.linearMap R (Localization p)) =
      I.map (algebraMap R (Localization p)) := by
    rw [Ideal.map, Ideal.span, Submodule.localized'_eq_span, Algebra.coe_linearMap]
  rw [← e.length_eq, hI]

/-- **Degree-zero and full localization.** Let `𝔭 ⊆ 𝔓` be homogeneous primes of
`S = k[x₀, ..., xₙ]` with some `xᵢ ∉ 𝔓`, and suppose `R = S_(𝔓) / 𝔭_(𝔓)` is a discrete valuation
ring. For homogeneous `f, g` of the same degree with `g ∉ 𝔓` and `f ∉ 𝔭`, the order of `f / g` in
`R` is the length of `(S / (𝔭 + (f)))_𝔓` over `S_𝔓`. -/
theorem ringOrd_homogeneousLocalization_quotient_eq_length (P 𝔭 : Ideal S) [P.IsPrime]
    [h𝔭 : 𝔭.IsPrime] (h𝔭P : 𝔭 ≤ P)
    (hPh : P.IsHomogeneous 𝒜) {i : Fin (n + 1)} (hi : (X i : S) ∉ P)
    [IsDomain (AtPrime 𝒜 P ⧸ homogeneousLocalizationIdeal P 𝔭)]
    [IsDiscreteValuationRing (AtPrime 𝒜 P ⧸ homogeneousLocalizationIdeal P 𝔭)]
    {f g : S} {d : ℕ} (hf : f ∈ 𝒜 d) (hg : g ∈ 𝒜 d) (hgP : g ∈ P.primeCompl) (hf𝔭 : f ∉ 𝔭) :
    Ring.ord (AtPrime 𝒜 P ⧸ homogeneousLocalizationIdeal P 𝔭)
        (Ideal.Quotient.mk _ (HomogeneousLocalization.mk ⟨d, ⟨f, hf⟩, ⟨g, hg⟩, hgP⟩)) =
      Module.length (Localization.AtPrime P)
        (LocalizedModule P.primeCompl (S ⧸ (𝔭 ⊔ Ideal.span {f}))) := by
  classical
  set L := Localization.AtPrime P
  set A := AtPrime 𝒜 P
  set K := homogeneousLocalizationIdeal P 𝔭
  set R := A ⧸ K
  set 𝔭L : Ideal L := 𝔭.map (algebraMap S L)
  have hdisj : Disjoint (P.primeCompl : Set S) 𝔭 :=
    Set.disjoint_left.mpr fun a ha ha' ↦ ha (h𝔭P ha')
  have h𝔭Lp : 𝔭L.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint P.primeCompl L 𝔭 h𝔭 hdisj
  set T := L ⧸ 𝔭L
  let : CommRing T := Ideal.Quotient.commRing 𝔭L
  have : IsLocalRing T := IsLocalRing.of_surjective' (Ideal.Quotient.mk 𝔭L)
    Ideal.Quotient.mk_surjective
  let ψ : R →+* T := Ideal.quotientMap 𝔭L (algebraMap A L) le_rfl
  have hψ : Function.Injective ψ := Ideal.quotientMap_injective
  have hRmk : ∀ α : A, ψ (Ideal.Quotient.mk K α) =
      Ideal.Quotient.mk 𝔭L (algebraMap A L α) := fun α ↦ Ideal.quotientMap_mk
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hπmax := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ
  -- `ψ π` lies in the maximal ideal of `T`
  have hψπ : ψ π ∈ maximalIdeal T := by
    obtain ⟨α, rfl⟩ := Ideal.Quotient.mk_surjective π
    have hα : α ∈ maximalIdeal A := fun hu ↦ hπ.not_isUnit (hu.map _)
    have hα' : algebraMap A L α ∈ maximalIdeal L := fun hu ↦
      hα ((isUnit_iff_isUnit_val _ _ α).mp hu)
    rw [hRmk]
    exact quotient_mk_mem_maximalIdeal hα'
  -- every homogeneous element of `P` maps into `(ψ π)`
  have hhomP : ∀ (j : ℕ) (c : S), c ∈ 𝒜 j → c ∈ P →
      Ideal.Quotient.mk 𝔭L (algebraMap S L c) ∈ Ideal.span {ψ π} := by
    intro j c hc hcP
    have hXj : (X i ^ j : S) ∈ P.primeCompl := fun h ↦ hi (‹P.IsPrime›.mem_of_pow_mem j h)
    have hXjd : (X i ^ j : S) ∈ 𝒜 j := by
      rw [mem_homogeneousSubmodule]
      simpa using MvPolynomial.isHomogeneous_X_pow i j
    let α : A := HomogeneousLocalization.mk ⟨j, ⟨c, hc⟩, ⟨X i ^ j, hXjd⟩, hXj⟩
    have hαval : algebraMap A L α * algebraMap S L (X i ^ j) = algebraMap S L c := by
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.val_mk,
        Localization.mk_eq_mk']
      exact IsLocalization.mk'_spec L c ⟨X i ^ j, hXj⟩
    have hα : α ∈ maximalIdeal A := by
      intro hu
      rw [← isUnit_iff_isUnit_val, HomogeneousLocalization.val_mk, Localization.mk_eq_mk',
        IsLocalization.AtPrime.isUnit_mk'_iff] at hu
      exact hu hcP
    have hαR : Ideal.Quotient.mk K α ∈ Ideal.span {π} := by
      rw [← hπmax]
      exact quotient_mk_mem_maximalIdeal hα
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hαR
    rw [← hαval, map_mul, ← hRmk, ← hr, map_mul]
    exact Ideal.mem_span_singleton.mpr ⟨ψ r * Ideal.Quotient.mk 𝔭L (algebraMap S L (X i ^ j)),
      by rw [mul_comm (ψ r), mul_assoc]⟩
  have hmaxT : maximalIdeal T = Ideal.span {ψ π} := by
    refine le_antisymm (fun t ht ↦ ?_) ((Ideal.span_singleton_le_iff_mem _).mpr hψπ)
    obtain ⟨l, rfl⟩ := Ideal.Quotient.mk_surjective t
    have hl : l ∈ maximalIdeal L := fun hu ↦ ht (hu.map _)
    rw [← Localization.AtPrime.map_eq_maximalIdeal] at hl
    have hle : P.map (algebraMap S L) ≤ (Ideal.span {ψ π}).comap (Ideal.Quotient.mk 𝔭L) := by
      rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, Ideal.mem_comap, ← DirectSum.sum_support_decompose 𝒜 c, map_sum,
        map_sum]
      exact Ideal.sum_mem _ fun j _ ↦ hhomP j _ (DirectSum.decompose 𝒜 c j).2 (hPh j hc)
    exact hle hl
  -- `T` is a discrete valuation ring with uniformizer `ψ π`
  have hπ0 : ψ π ≠ 0 := (map_ne_zero_iff ψ hψ).mpr hπ.ne_zero
  have hnf : ¬IsField T := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq]
    intro h
    apply hπ0
    rw [← Submodule.mem_bot T, ← h]
    exact hψπ
  have : IsDomain T := Ideal.Quotient.isDomain 𝔭L
  have hprin : (maximalIdeal T).IsPrincipal := ⟨⟨ψ π, hmaxT⟩⟩
  have : IsDiscreteValuationRing T := ((IsDiscreteValuationRing.TFAE T hnf).out 0 4).mpr hprin
  have hπT : Irreducible (ψ π) := (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmaxT
  -- the element `f / g`
  set a : R := Ideal.Quotient.mk K (HomogeneousLocalization.mk ⟨d, ⟨f, hf⟩, ⟨g, hg⟩, hgP⟩)
  have hfg : algebraMap A L (HomogeneousLocalization.mk ⟨d, ⟨f, hf⟩, ⟨g, hg⟩, hgP⟩) *
      algebraMap S L g = algebraMap S L f := by
    rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.val_mk,
      Localization.mk_eq_mk']
    exact IsLocalization.mk'_spec L f ⟨g, hgP⟩
  have hψa : ψ a * Ideal.Quotient.mk 𝔭L (algebraMap S L g) =
      Ideal.Quotient.mk 𝔭L (algebraMap S L f) := by
    rw [hRmk, ← map_mul, hfg]
  have hgu : IsUnit (Ideal.Quotient.mk 𝔭L (algebraMap S L g)) :=
    (IsLocalization.map_units L ⟨g, hgP⟩).map _
  have ha0 : a ≠ 0 := by
    intro h0
    apply hf𝔭
    have h1 : ψ a = 0 := by rw [h0, map_zero]
    rw [h1, zero_mul, eq_comm, Ideal.Quotient.eq_zero_iff_mem] at hψa
    have := IsLocalization.under_map_of_isPrime_disjoint P.primeCompl L h𝔭 hdisj
    rw [← this]
    exact hψa
  obtain ⟨m, u, hau⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hπ
  have hordR : Ring.ord R a = m := by
    rw [hau, Ring.ord_mul_of_isUnit_left u.isUnit,
      Ring.ord_pow (mem_nonZeroDivisors_of_ne_zero hπ.ne_zero), Ring.ord_of_irreducible hπ]
    simp
  have hordT : Ring.ord T (ψ a) = m := by
    rw [hau, map_mul, map_pow, Ring.ord_mul_of_isUnit_left (u.isUnit.map ψ),
      Ring.ord_pow (mem_nonZeroDivisors_of_ne_zero hπ0), Ring.ord_of_irreducible hπT]
    simp
  have hlen := Module.length_eq_of_surjective (R := T)
    (M := T ⧸ Ideal.span {Ideal.Quotient.mk 𝔭L (algebraMap S L f)})
    (Ideal.Quotient.mk_surjective : Function.Surjective (algebraMap L T))
  rw [hordR, ← hordT, ← Ring.ord_mul_of_isUnit_right hgu, hψa, Ring.ord, ← hlen,
    length_localizedModule_quotient]
  have hspan : Ideal.span {Ideal.Quotient.mk 𝔭L (algebraMap S L f)} =
      (Ideal.span {algebraMap S L f}).map (Ideal.Quotient.mkₐ L 𝔭L) := by
    rw [Ideal.map_span, Set.image_singleton]
    rfl
  have hsup : 𝔭L ⊔ Ideal.span {algebraMap S L f} =
      (𝔭 ⊔ Ideal.span {f}).map (algebraMap S L) := by
    rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton]
  rw [hspan, ← hsup]
  exact (DoubleQuot.quotQuotEquivQuotSupₐ L 𝔭L (Ideal.span {algebraMap S L f})).toLinearEquiv.length_eq

/-- A fraction `a / b` lies in `𝔭_(𝔓)` exactly when `a ∈ 𝔭`. -/
theorem mk_mem_homogeneousLocalizationIdeal_iff (P 𝔭 : Ideal S) [P.IsPrime] [h𝔭 : 𝔭.IsPrime]
    (h𝔭P : 𝔭 ≤ P) {e : ℕ} {a b : S} (ha : a ∈ 𝒜 e) (hb : b ∈ 𝒜 e) (hbP : b ∈ P.primeCompl) :
    HomogeneousLocalization.mk ⟨e, ⟨a, ha⟩, ⟨b, hb⟩, hbP⟩ ∈ homogeneousLocalizationIdeal P 𝔭 ↔
      a ∈ 𝔭 := by
  have hdisj : Disjoint (P.primeCompl : Set S) 𝔭 :=
    Set.disjoint_left.mpr fun a ha ha' ↦ ha (h𝔭P ha')
  have hval : algebraMap (AtPrime 𝒜 P) (Localization.AtPrime P)
      (HomogeneousLocalization.mk ⟨e, ⟨a, ha⟩, ⟨b, hb⟩, hbP⟩) =
      IsLocalization.mk' (Localization.AtPrime P) a ⟨b, hbP⟩ := by
    rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.val_mk,
      Localization.mk_eq_mk']
  rw [homogeneousLocalizationIdeal, Ideal.mem_comap, hval,
    IsLocalization.mk'_mem_map_algebraMap_iff]
  constructor
  · rintro ⟨s, hs, hsa⟩
    exact (h𝔭.mem_or_mem hsa).resolve_left fun h ↦ hs (h𝔭P h)
  · exact fun h ↦ ⟨1, P.primeCompl.one_mem, by rw [one_mul]; exact h⟩

/-- The homogeneous ideal of the image of a point under a morphism to `Proj` is prime. -/
instance isPrime_asHomogeneousIdeal_base {X : Scheme.{u}} (ι : X ⟶ Proj 𝒜) (x : X) :
    (ι.base x).asHomogeneousIdeal.toIdeal.IsPrime :=
  (ι.base x).isPrime

/-- Along a closed immersion `ι : X ⟶ ℙⁿ_k` of an integral scheme, the kernel of the stalk map at
`x`, read in the homogeneous localization `S_(𝔓)` at the prime `𝔓` of `ι x`, consists of the
fractions with numerator in the prime `𝔭` of the image of the generic point. -/
theorem stalkMap_stalkIso_inv_eq_zero_iff {X : Scheme.{u}} [IsIntegral X] (ι : X ⟶ Proj 𝒜)
    (x : X) (α : AtPrime 𝒜 (ι.base x).asHomogeneousIdeal.toIdeal) :
    ι.stalkMap x ((Proj.stalkIso 𝒜 (ι.base x)).inv α) = 0 ↔
      α ∈ homogeneousLocalizationIdeal (ι.base x).asHomogeneousIdeal.toIdeal
        (ι.base (genericPoint X)).asHomogeneousIdeal.toIdeal := by
  have h𝔭P : (ι.base (genericPoint X)).asHomogeneousIdeal.toIdeal ≤
      (ι.base x).asHomogeneousIdeal.toIdeal :=
    (projectiveSpace_specializes_iff_le _ _).mp ((genericPoint_specializes x).map ι.continuous)
  obtain ⟨⟨e, ⟨a, ha⟩, ⟨b, hb⟩, hbx⟩, rfl⟩ := HomogeneousLocalization.mk_surjective α
  have ha' : a.IsHomogeneous e := (mem_homogeneousSubmodule e a).mp ha
  have hb' : b.IsHomogeneous e := (mem_homogeneousSubmodule e b).mp hb
  have hbη : ι.base (genericPoint X) ∈ Proj.basicOpen 𝒜 b := fun h ↦ hbx (h𝔭P h)
  have : (ι.base (genericPoint X)).asHomogeneousIdeal.toIdeal.IsPrime :=
    (ι.base (genericPoint X)).isPrime
  rw [mk_mem_homogeneousLocalizationIdeal_iff _ _ h𝔭P ha hb hbx]
  have hbx' : ι.base x ∈ Proj.basicOpen 𝒜 b := hbx
  have h1 := germ_hypersurfaceChartEquation a b ha' hb' (ι.base x) hbx'
  have h2 := germ_hypersurfaceChartEquation a b ha' hb' (ι.base (genericPoint X)) hbη
  rw [← h1, Scheme.Hom.germ_stalkMap_apply,
    map_eq_zero_iff _ (germ_injective_of_isIntegral X x hbx'),
    ← map_eq_zero_iff _ (germ_injective_of_isIntegral X (genericPoint X) hbη),
    ← Scheme.Hom.germ_stalkMap_apply, h2]
  -- a local homomorphism into the function field kills exactly the non-units
  have hloc : ∀ y, ι.stalkMap (genericPoint X) y = 0 ↔ ¬IsUnit y := by
    intro y
    rw [← isUnit_map_iff (ι.stalkMap (genericPoint X)).hom y, isUnit_iff_ne_zero, not_not]
  have hiso : ∀ y, IsUnit ((Proj.stalkIso 𝒜 (ι.base (genericPoint X))).inv y) ↔ IsUnit y :=
    fun y ↦ ⟨fun h ↦ by simpa using h.map (Proj.stalkIso 𝒜 (ι.base (genericPoint X))).hom.hom,
      fun h ↦ h.map _⟩
  rw [hloc, hiso, ← isUnit_iff_isUnit_val, HomogeneousLocalization.val_mk,
    Localization.mk_eq_mk', IsLocalization.AtPrime.isUnit_mk'_iff, Ideal.mem_primeCompl_iff,
    not_not]

/-- On a scheme satisfying `(*)`, the order at a codimension-one point of a nonzero element of
the stalk is the length of its quotient. -/
theorem ord_algebraMap_stalk_eq_of_ringOrd {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] {x : X} (hx : Order.coheight x = 1) {b : X.presheaf.stalk x}
    (hb : b ≠ 0) {m : ℕ} (hm : Ring.ord (X.presheaf.stalk x) b = m) :
    X.ord (algebraMap (X.presheaf.stalk x) X.functionField b) x = m := by
  have : Ring.KrullDimLE 1 (X.presheaf.stalk x) := krullDimLE_of_coheight_le hx.le
  have hb' : algebraMap (X.presheaf.stalk x) X.functionField b ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective (X.presheaf.stalk x) X.functionField)).mpr hb
  rw [Scheme.ord_eq_iff hx hb', Scheme.ordHom, Ring.ordFrac_eq_ord _ hb,
    Ring.ordMonoidWithZeroHom_eq_coe _ (mem_nonZeroDivisors_of_ne_zero hb) hm]

/-- **Local multiplicity of `V · X`.** Let `ι : X ⟶ ℙⁿ_k` be a closed immersion of a scheme
satisfying `(*)`, let `V` be a prime divisor of `ℙⁿ_k` with homogeneous equation `f` not
containing `X`, and let `x` be a codimension-one point of `X`. Write `𝔓` for the homogeneous prime
of `ι x` and `𝔭` for that of the image of the generic point. Then the coefficient of `V · X` at
`x` is the length of `(S / (𝔭 + (f)))_𝔓` over `S_𝔓`. -/
theorem projectiveIntersectionDivisor_apply_eq_length {X : Scheme.{u}} (ι : X ⟶ Proj 𝒜)
    [IsClosedImmersion ι] (hX : X.SatisfiesConditionStar) (V : (Proj 𝒜).PrimeDivisor)
    (hXV : ¬Set.range ι ⊆ closure ({V.1} : Set (Proj 𝒜))) (x : X)
    (hx : Order.coheight x = 1) :
    let _ : IsIntegral X := hX.isIntegral
    ∃ m : ℕ, (projectiveIntersectionDivisor ι hX V).1 x = m ∧
      Module.length (Localization.AtPrime (ι.base x).asHomogeneousIdeal.toIdeal)
        (LocalizedModule (ι.base x).asHomogeneousIdeal.toIdeal.primeCompl
          (S ⧸ ((ι.base (genericPoint X)).asHomogeneousIdeal.toIdeal ⊔
            Ideal.span {projectivePrimeDivisorEquation V}))) = m := by
  let _ : IsIntegral X := hX.isIntegral
  let _ : IsNoetherian X := hX.isNoetherian
  set P := (ι.base x).asHomogeneousIdeal.toIdeal
  set 𝔭 := (ι.base (genericPoint X)).asHomogeneousIdeal.toIdeal
  set f := projectivePrimeDivisorEquation V
  set d := projectivePrimeDivisorEquationDegree V
  have hf : f.IsHomogeneous d := projectivePrimeDivisorEquation_isHomogeneous V
  have h𝔭P : 𝔭 ≤ P :=
    (projectiveSpace_specializes_iff_le _ _).mp ((genericPoint_specializes x).map ι.continuous)
  have hf𝔭 : f ∉ 𝔭 := by
    intro h
    apply hXV
    rintro _ ⟨z, rfl⟩
    rw [mem_closure_projectivePrimeDivisor_iff]
    exact (projectiveSpace_specializes_iff_le _ _).mp
      ((genericPoint_specializes z).map ι.continuous) h
  obtain ⟨i, hi⟩ := exists_X_notMem_projectiveSpace (ι.base x)
  set g : S := MvPolynomial.X i ^ d
  have hg : g.IsHomogeneous d := MvPolynomial.isHomogeneous_X_pow i d
  have hgP : g ∈ P.primeCompl := fun h ↦ hi ((ι.base x).isPrime.mem_of_pow_mem d h)
  have hgx : ι.base x ∈ Proj.basicOpen 𝒜 g := hgP
  -- the stalk of `X` at `x` is `S_(𝔓) / 𝔭_(𝔓)`
  let K := homogeneousLocalizationIdeal P 𝔭
  let φ : AtPrime 𝒜 P →+* X.presheaf.stalk x :=
    (ι.stalkMap x).hom.comp (Proj.stalkIso 𝒜 (ι.base x)).inv.hom
  have hsurj : Function.Surjective φ :=
    (ι.stalkMap_surjective x).comp
      ((ConcreteCategory.bijective_of_isIso (Proj.stalkIso 𝒜 (ι.base x)).inv).2)
  have hker : RingHom.ker φ = K := Ideal.ext fun α ↦ stalkMap_stalkIso_inv_eq_zero_iff ι x α
  let e : AtPrime 𝒜 P ⧸ K ≃+* X.presheaf.stalk x :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  have : IsDomain (AtPrime 𝒜 P ⧸ K) := Function.Injective.isDomain e.toRingHom e.injective
  have hdvr := Scheme.codimensionOneStalk_isDiscreteValuationRing hX hx
  have : IsDiscreteValuationRing (AtPrime 𝒜 P ⧸ K) :=
    IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e.symm
  have hPh : P.IsHomogeneous 𝒜 := (ι.base x).asHomogeneousIdeal.isHomogeneous
  have : 𝔭.IsPrime := (ι.base (genericPoint X)).isPrime
  have hlen := ringOrd_homogeneousLocalization_quotient_eq_length P 𝔭 h𝔭P hPh hi ((mem_homogeneousSubmodule d f).mpr hf)
    ((mem_homogeneousSubmodule d g).mpr hg) hgP hf𝔭
  set α : AtPrime 𝒜 P := HomogeneousLocalization.mk
    ⟨d, ⟨f, (mem_homogeneousSubmodule d f).mpr hf⟩, ⟨g, (mem_homogeneousSubmodule d g).mpr hg⟩,
      hgP⟩
  -- the germ of the standard local equation
  have hgerm : X.presheaf.germ (ι ⁻¹ᵁ Proj.basicOpen 𝒜 g) x hgx
      (ι.app _ (hypersurfaceChartEquation f g hf hg)) = e (Ideal.Quotient.mk K α) := by
    rw [← Scheme.Hom.germ_stalkMap_apply, germ_hypersurfaceChartEquation]
    rfl
  have hα : α ∉ K := by
    rw [mk_mem_homogeneousLocalizationIdeal_iff P 𝔭 h𝔭P]
    exact hf𝔭
  have hb0 : e (Ideal.Quotient.mk K α) ≠ 0 := by
    rw [map_ne_zero_iff _ e.injective]
    exact fun h ↦ hα (Ideal.Quotient.eq_zero_iff_mem.mp h)
  have hfin : Ring.ord (X.presheaf.stalk x) (e (Ideal.Quotient.mk K α)) ≠ ⊤ :=
    Ring.ord_ne_top (mem_nonZeroDivisors_of_ne_zero hb0)
  refine ⟨(Ring.ord (X.presheaf.stalk x) (e (Ideal.Quotient.mk K α))).toNat, ?_, ?_⟩
  · rw [projectiveIntersectionDivisor_apply_eq_ord ι hX V hXV x _ _ hgx
      (isProjectiveHypersurfaceLocalEquation_chartEquation V g hg), hgerm]
    exact ord_algebraMap_stalk_eq_of_ringOrd hx hb0 (ENat.natCast_toNat hfin).symm
  · rw [← hlen, ← ring_ord_ringEquiv e, ENat.natCast_toNat hfin]

end Hartshorne
