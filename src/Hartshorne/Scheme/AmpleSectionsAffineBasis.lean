/-!
# Sections of powers of an ample sheaf with affine nonvanishing loci

Hartshorne, *Algebraic Geometry*, II, proof of Theorem 7.6 (pp. 154–155).

Let `X` be of finite type over a Noetherian ring `A` and `L` an ample invertible sheaf on `X`.
Then every point of `X` lies in an affine nonvanishing locus `X_s` of a global section `s` of
some positive tensor power `L^n`, and `X` is covered by finitely many such affine loci `X_{s_i}`
with all `s_i` of the same degree `n`
(`AlgebraicGeometry.Scheme.Modules.IsAmple.exists_isAffineOpen_nonvanishingLocus_of_finiteType`).

Following Hartshorne, for a point `P` take an affine open `U ∋ P` on which `L` is trivial, and let
`I_Z` be the ideal sheaf of functions vanishing on `Z = X − U`, which is coherent
(`Hartshorne.isCoherent_vanishingIdealSheaf`). For `n ≫ 0` the sheaf `I_Z ⊗ L^n` is generated by
global sections, so some global section of `I_Z ⊗ L^n` maps to a section `s ∈ Γ(X, L^n)` not
vanishing at `P` and vanishing along `Z`; then `P ∈ X_s ⊆ U`, and `X_s = U_f` is affine, where
`s|_U = f e^{⊗ n}` for a trivializing section `e` of `L` on `U`. The degree can be chosen
uniformly: `X` is covered by finitely many such `U`, and all `n` beyond the finitely many
thresholds work at once.

We also record that tensor powers of an invertible sheaf are invertible, with the tensor powers
of a trivializing section as trivializing sections
(`Hartshorne.isInvertible_moduleSheafTensorPower`,
`Hartshorne.IsTrivializingSection.moduleSheafTensorPower`).
-/

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry

namespace Hartshorne

/-! ### Tensor powers of a rank-one free module -/

/-- If `a ↦ a • b` is bijective, so is `a ↦ a • (b ⊗ ⋯ ⊗ b)` onto the `n`-th tensor power. -/
theorem tprod_const_smul_bijective {A M : Type u} [CommRing A] [AddCommGroup M] [Module A M]
    {b : M} (hb : Function.Bijective (fun a : A => a • b)) (n : ℕ) :
    Function.Bijective (fun a : A => a • PiTensorProduct.tprod A (fun _ : Fin n => b)) := by
  let e₁ : A ≃ₗ[A] M := LinearEquiv.ofBijective (LinearMap.toSpanSingleton A M b) hb
  let F : PiTensorProduct A (fun _ : Fin n => A) ≃ₗ[A] PiTensorProduct A (fun _ : Fin n => M) :=
    PiTensorProduct.congr fun _ => e₁
  let G : A ≃ₗ[A] PiTensorProduct A (fun _ : Fin n => A) :=
    (PiTensorProduct.constantBaseRingEquiv (Fin n) A).toLinearEquiv.symm
  have he₁ : e₁ 1 = b := by
    exact one_smul A b
  have key : (fun a : A => a • PiTensorProduct.tprod A (fun _ : Fin n => b)) = F ∘ G := by
    funext a
    have hG : G a = a • PiTensorProduct.tprod A (fun _ : Fin n => (1 : A)) := by
      exact Algebra.algebraMap_eq_smul_one (A := PiTensorProduct A (fun _ : Fin n => A)) a
    rw [Function.comp_apply, hG, map_smul]
    simp only [F, PiTensorProduct.congr_tprod, he₁]
  rw [key]
  exact F.bijective.comp G.bijective

namespace Ringed

variable {X : TopCat.{u}} {R : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}

open SheafAlgebraOperations ModuleSheafTensor SheafTensorOperations

/-- **Tensor powers of a rank-one frame.** If `e` is a frame of `E` over `U`, then
`e ⊗ ⋯ ⊗ e` is a frame of `T^n E` over `U`. -/
theorem IsLocalFrame.moduleSheafTensorPower {E : SheafOfModules.{u} (ringCatSheafOf R)}
    {U : Opens X} {e : E.val.presheaf.obj (op U)}
    (he : IsLocalFrame E U (fun _ : ULift.{u} (Fin 1) => e)) (n : ℕ) :
    IsLocalFrame (moduleSheafTensorPower n E) U (fun _ : ULift.{u} (Fin 1) =>
      (moduleSheafTensorPowerMultilinear n E).app (op U) (fun _ => e)) := by
  refine @isLocalFrame_sheafify X R (moduleSheafTensorPowerPresheaf n E) U (ULift.{u} (Fin 1)) _
    (fun _ => PiTensorProduct.tprod _ (fun _ : Fin n => e)) fun V h => ?_
  have hb : Function.Bijective (fun a : (R.obj ⋙ forget₂ CommRingCat RingCat).obj (op V) =>
      a • (E.val.map (homOfLE h).op e : E.val.obj (op V))) := by
    have hl := he V h
    have hk : ∀ a : R.obj.obj (op V), localFrameMap E (fun _ : ULift.{u} (Fin 1) => e) h
        (fun _ => a) = a • (E.val.map (homOfLE h).op e : E.val.obj (op V)) := by
      intro a
      rw [localFrameMap_apply, Fintype.sum_unique]
      rfl
    refine ⟨fun a₁ a₂ h' => ?_, fun y => ?_⟩
    · exact congrFun (hl.1 ((hk a₁).trans (h'.trans (hk a₂).symm))) default
    · obtain ⟨a, ha⟩ := hl.2 y
      have ha' : (fun _ : ULift.{u} (Fin 1) => a default) = a :=
        funext fun i => congrArg a (Subsingleton.elim _ _)
      exact ⟨a default, (hk (a default)).symm.trans (ha' ▸ ha)⟩
  have hb' := (tprod_const_smul_bijective hb n).comp
    (Equiv.funUnique (ULift.{u} (Fin 1)) ((R.obj ⋙ forget₂ CommRingCat RingCat).obj (op V))).bijective
  have hfam : presheafRestrictFamily (P := moduleSheafTensorPowerPresheaf n E)
      (fun _ : ULift.{u} (Fin 1) => PiTensorProduct.tprod _ (fun _ : Fin n => e)) h =
      fun _ => PiTensorProduct.tprod ((R.obj ⋙ forget₂ CommRingCat RingCat).obj (op V))
        (fun _ : Fin n => (E.val.map (homOfLE h).op e : E.val.obj (op V))) := by
    funext w
    exact tensorPowerMap_tprod n _ (E.val.restrictₛₗ (homOfLE h).op) (fun _ => e)
  unfold presheafFrameMap
  rw [hfam]
  have key : ∀ a : ULift.{u} (Fin 1) → (R.obj ⋙ forget₂ CommRingCat RingCat).obj (op V),
      Fintype.linearCombination ((R.obj ⋙ forget₂ CommRingCat RingCat).obj (op V))
        (fun _ : ULift.{u} (Fin 1) =>
          PiTensorProduct.tprod ((R.obj ⋙ forget₂ CommRingCat RingCat).obj (op V))
            (fun _ : Fin n => (E.val.map (homOfLE h).op e : E.val.obj (op V)))) a =
      a default • PiTensorProduct.tprod ((R.obj ⋙ forget₂ CommRingCat RingCat).obj (op V))
        (fun _ : Fin n => (E.val.map (homOfLE h).op e : E.val.obj (op V))) := by
    intro a
    rw [Fintype.linearCombination_apply, Fintype.sum_unique]
    rfl
  refine ⟨fun a₁ a₂ h' => hb'.1 ((key a₁).symm.trans (h'.trans (key a₂))), fun y => ?_⟩
  obtain ⟨a, ha⟩ := hb'.2 y
  exact ⟨a, (key a).trans ha⟩

end Ringed

/-! ### Tensor powers of invertible sheaves -/

variable {X : Scheme.{u}}

/-- A trivializing section is a rank-one frame. -/
theorem isLocalFrame_of_isTrivializingSection {L : X.Modules} {U : X.Opens} {e : Γ(L, U)}
    (he : IsTrivializingSection L U e) :
    Ringed.IsLocalFrame (R := X.sheaf) L U (fun _ : ULift.{u} (Fin 1) => e) := by
  intro V h
  have key : ⇑(Ringed.localFrameMap (R := X.sheaf) L (fun _ : ULift.{u} (Fin 1) => e) h) =
      (fun a : Γ(X, V) => a • L.presheaf.map (homOfLE h).op e) ∘
        ⇑(Equiv.funUnique (ULift.{u} (Fin 1)) Γ(X, V)) := by
    funext a
    refine (Ringed.localFrameMap_apply (R := X.sheaf) L _ h a).trans ?_
    erw [Fintype.sum_unique]
    rfl
  rw [key]
  exact (he V h).comp (Equiv.funUnique (ULift.{u} (Fin 1)) Γ(X, V)).bijective

/-- The `n`-th tensor power of a trivializing section of `L` trivializes `L^{⊗ n}`. -/
theorem IsTrivializingSection.moduleSheafTensorPower {L : X.Modules} {U : X.Opens}
    {e : Γ(L, U)} (he : IsTrivializingSection L U e) (n : ℕ) :
    IsTrivializingSection (moduleSheafTensorPower n L) U
      ((moduleSheafTensorPowerMultilinear n L).app (op U) (fun _ => e)) :=
  IsTrivializingSection.of_isLocalFrame
    (Ringed.IsLocalFrame.moduleSheafTensorPower (isLocalFrame_of_isTrivializingSection he) n)

/-- **Tensor powers of an invertible sheaf are invertible.** -/
theorem isInvertible_moduleSheafTensorPower {L : X.Modules} (hL : L.IsInvertible) (n : ℕ) :
    Scheme.Modules.IsInvertible (moduleSheafTensorPower n L) := by
  refine (Scheme.Modules.isInvertible_iff_ringed _).mpr
    (Ringed.isLocallyFreeOfRank_of_isLocalFrame fun x => ?_)
  obtain ⟨U, e, hx, he⟩ := exists_isTrivializingSection hL x
  exact ⟨U, _, hx,
    Ringed.IsLocalFrame.moduleSheafTensorPower (isLocalFrame_of_isTrivializingSection he) n⟩

/-! ### Affine nonvanishing loci -/

/-- Let `M` be invertible, trivialized on an affine open `U` by `e`, and suppose `I_Z ⊗ M` is
generated by global sections, where `Z = X − U`. Then every point of `U` lies in an affine
nonvanishing locus `X_s` of a global section `s` of `M`. -/
theorem exists_isAffineOpen_nonvanishingLocus_of_isGloballyGenerated {M : X.Modules} (hM : M.IsInvertible)
    {U : X.Opens} (hU : IsAffineOpen U) {e : Γ(M, U)} (he : IsTrivializingSection M U e)
    (hgen : Scheme.Modules.IsGloballyGenerated
      (moduleSheafTensor (vanishingIdealSheaf (U : Set X)ᶜ) M))
    {x : X} (hx : x ∈ U) :
    ∃ s : Γ(M, ⊤), x ∈ nonvanishingLocus M s ∧ IsAffineOpen (nonvanishingLocusOpens hM s) := by
  obtain ⟨ι, σ, hσ⟩ := hgen
  obtain ⟨i, hi⟩ :=
    exists_mem_nonvanishingLocus_vanishingIdealMul disjoint_compl_right he hx hσ
  refine ⟨_, hi, ?_⟩
  set s := (vanishingIdealMul (U : Set X)ᶜ M).app ⊤ (σ i)
  obtain ⟨g, hg⟩ := he.exists_eq_smul s
  have hsub : nonvanishingLocus M s ⊆ U := fun y hy => by
    by_contra hyU
    exact not_mem_nonvanishingLocus_vanishingIdealMul (σ i) hyU hy
  have heq : nonvanishingLocusOpens hM s = X.basicOpen g := by
    have h := he.nonvanishingLocus_inter_eq hg
    rw [Set.inter_eq_left.mpr hsub] at h
    exact Opens.ext h
  rw [heq]
  exact hU.basicOpen g

end Hartshorne

namespace AlgebraicGeometry.Scheme.Modules

open Hartshorne

variable {X : Scheme.{u}}

/-- For an ample sheaf on a Noetherian scheme, there is `N` such that for every `n ≥ N` every
point lies in an affine nonvanishing locus of a global section of `L^{⊗ n}`. -/
theorem IsAmple.exists_isAffineOpen_nonvanishingLocus [IsNoetherian X] {L : X.Modules}
    (hL : L.IsAmple) :
    ∃ N : ℕ, ∀ n ≥ N, ∀ x : X, ∃ s : Γ(moduleSheafTensorPower n L, ⊤),
      x ∈ nonvanishingLocus _ s ∧
        IsAffineOpen (nonvanishingLocusOpens (isInvertible_moduleSheafTensorPower hL.1 n) s) := by
  choose U e hxU hU he using exists_isAffineOpen_isTrivializingSection hL.1
  choose n₀ hn₀ using fun y => hL.2 _ (isCoherent_vanishingIdealSheaf ((U y : Set X)ᶜ))
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun y => (U y : Set X))
    (fun y => (U y).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hxU y⟩)
  refine ⟨t.sup n₀, fun n hn x => ?_⟩
  obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
  exact exists_isAffineOpen_nonvanishingLocus_of_isGloballyGenerated
    (isInvertible_moduleSheafTensorPower hL.1 n)
    (hU y) ((he y).moduleSheafTensorPower n) (hn₀ y n ((Finset.le_sup hy).trans hn)) hxy

/-- **Ample sections form an affine basis** (Hartshorne II, proof of Theorem 7.6, pp. 154–155).
Let `X` be of finite type over a Noetherian ring `A` and `L` an ample invertible sheaf on `X`.
Then every point of `X` lies in an affine nonvanishing locus `X_s` of a global section `s` of a
positive tensor power `L^{⊗ n}`, and `X` is covered by finitely many affine nonvanishing loci
`X_{s_i}` of global sections `s_i` of one and the same positive tensor power `L^{⊗ n}`. -/
theorem IsAmple.exists_isAffineOpen_nonvanishingLocus_of_finiteType {A : CommRingCat.{u}}
    [IsNoetherianRing A] (f : X ⟶ Spec A) (hf : FiniteType f) {L : X.Modules}
    (hL : haveI := finiteType_isNoetherian f hf; L.IsAmple) :
    (∀ x : X, ∃ n > 0, ∃ s : Γ(moduleSheafTensorPower n L, ⊤), x ∈ nonvanishingLocus _ s ∧
      IsAffineOpen (nonvanishingLocusOpens (isInvertible_moduleSheafTensorPower hL.1 n) s)) ∧
    ∃ n > 0, ∃ S : Finset Γ(moduleSheafTensorPower n L, ⊤),
      (∀ s ∈ S, IsAffineOpen (nonvanishingLocusOpens (isInvertible_moduleSheafTensorPower hL.1 n) s)) ∧
      ∀ x : X, ∃ s ∈ S, x ∈ nonvanishingLocus _ s := by
  have := finiteType_isNoetherian f hf
  obtain ⟨N, hN⟩ := hL.exists_isAffineOpen_nonvanishingLocus
  refine ⟨fun x => ⟨N + 1, Nat.succ_pos _, hN _ (Nat.le_succ _) x⟩, N + 1, Nat.succ_pos _, ?_⟩
  choose s hs hsaff using hN (N + 1) (Nat.le_succ _)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => nonvanishingLocus _ (s x))
    (fun x => isOpen_nonvanishingLocus (isInvertible_moduleSheafTensorPower hL.1 _) (s x))
    (fun x _ => Set.mem_iUnion.mpr ⟨x, hs x⟩)
  classical
  refine ⟨t.image s, fun s' hs' => ?_, fun x => ?_⟩
  · obtain ⟨y, -, rfl⟩ := Finset.mem_image.mp hs'
    exact hsaff y
  · obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    exact ⟨s y, Finset.mem_image_of_mem s hy, hxy⟩

end AlgebraicGeometry.Scheme.Modules
