/-!
# An ample twist makes relative Proj projective

Hartshorne, *Algebraic Geometry*, II, Proposition 7.10(b) (pp. 161–162).
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry

namespace Hartshorne

/-! ### Twisting a very ample sheaf by a sheaf with a morphism to projective space -/

/-- Very ampleness relative to `Y` is invariant under isomorphism of sheaves. -/
theorem IsVeryAmpleRelative.of_iso {X Y : Scheme.{u}} {p : X ⟶ Y} {L L' : X.Modules}
    (hL : IsVeryAmpleRelative p L) (α : L ≅ L') : IsVeryAmpleRelative p L' := by
  obtain ⟨hinv, r, Z, o, c, ho, hc, hp, ⟨e⟩⟩ := hL
  refine ⟨(Scheme.Modules.isInvertible_iff_ringed _).mpr
    (Ringed.IsInvertible.of_iso ((Scheme.Modules.isInvertible_iff_ringed _).mp hinv) α),
    r, Z, o, c, ho, hc, hp, ⟨e ≪≫ α⟩⟩

/-- Let `L` be very ample relative to `Y` on a `Y`-scheme `X` quasi-compact over `Y`, and let `M`
be an invertible sheaf with a `Y`-morphism `j : X ⟶ ℙˢ_Y` such that `j^* 𝒪(1) ≅ M`. Then `L ⊗ M`
is very ample relative to `Y`: if `i` is the immersion for `L`, then the Segre embedding composed
with `(i, j)` is an immersion pulling `𝒪(1)` back to `L ⊗ M`. This supplements Hartshorne II,
Exercise 5.12(a), where `j` is also an immersion. -/
theorem isVeryAmpleRelative_moduleSheafTensor_of_hom {X Y : Scheme.{u}} {p : X ⟶ Y}
    [QuasiCompact p] {L M : X.Modules} (hL : IsVeryAmpleRelative p L) (hM : M.IsInvertible)
    {s : ℕ} (j : X ⟶ projectiveSpaceOverScheme s Y)
    (hj : j ≫ projectiveSpaceOverSchemeProjection s Y = p)
    (eM : (Scheme.Modules.pullback j).obj (projectiveSpaceTwistingSheaf s Y 1) ≅ M) :
    IsVeryAmpleRelative p (moduleSheafTensor L M) := by
  obtain ⟨hLinv, r, Z, o, c, ho, hc, hp, ⟨eL⟩⟩ := hL
  have hij : (o ≫ c) ≫ projectiveSpaceOverSchemeProjection r Y =
      j ≫ projectiveSpaceOverSchemeProjection s Y := hp.trans hj.symm
  let φ : X ⟶ relativeSegreSource r s Y := pullback.lift (o ≫ c) j hij
  let ι : X ⟶ projectiveSpaceOverScheme (r * s + r + s) Y := φ ≫ relativeSegre r s Y
  have hιp : ι ≫ projectiveSpaceOverSchemeProjection (r * s + r + s) Y = p := by
    simp only [ι, φ, Category.assoc, relativeSegre_projection, relativeSegreSourceProjection,
      pullback.lift_fst_assoc, hp]
  have : IsImmersion (φ ≫ pullback.fst _ _) := by
    rw [pullback.lift_fst]
    infer_instance
  have : IsImmersion φ := IsImmersion.of_comp φ (pullback.fst _ _)
  have : QuasiCompact (ι ≫ projectiveSpaceOverSchemeProjection (r * s + r + s) Y) := by
    rw [hιp]
    infer_instance
  have := projectiveSpaceOverSchemeProjection_isProper (r * s + r + s) Y
  have : QuasiCompact ι := QuasiCompact.of_comp ι (projectiveSpaceOverSchemeProjection _ Y)
  obtain ⟨e⟩ := nonempty_relativeSegre_pullback_iso r s Y
  have i1 := ringed_isInvertible_projectiveSpaceTwistingSheaf r Y
  have i2 := ringed_isInvertible_projectiveSpaceTwistingSheaf s Y
  have hinv : Scheme.Modules.IsInvertible (X := X) (moduleSheafTensor L M) :=
    (Scheme.Modules.isInvertible_iff_ringed _).mpr (Ringed.isInvertible_moduleSheafTensor
      ((Scheme.Modules.isInvertible_iff_ringed _).mp hLinv)
      ((Scheme.Modules.isInvertible_iff_ringed _).mp hM))
  refine ⟨hinv, r * s + r + s, ι.image, ι.toImage, ι.imageι, inferInstance, inferInstance,
    by rw [Scheme.Hom.toImage_imageι, hιp], ⟨?_⟩⟩
  exact (Scheme.Modules.pullbackCongr (Scheme.Hom.toImage_imageι ι)).app _ ≪≫
    ((Scheme.Modules.pullbackComp φ (relativeSegre r s Y)).app _).symm ≪≫
    (Scheme.Modules.pullback φ).mapIso e ≪≫
    pullbackTensorIso φ (isInvertible_pullback _ i1) (isInvertible_pullback _ i2) ≪≫
    Ringed.moduleSheafTensorIsoOfIso
      ((Scheme.Modules.pullbackComp _ _).app _ ≪≫
        (Scheme.Modules.pullbackCongr (pullback.lift_fst _ _ _)).app _ ≪≫ eL)
      ((Scheme.Modules.pullbackComp _ _).app _ ≪≫
        (Scheme.Modules.pullbackCongr (pullback.lift_snd _ _ _)).app _ ≪≫ eM)

/-- On a Noetherian scheme `X` with an ample invertible sheaf `L`, for every sufficiently large
`r` the power `L^r` is generated by finitely many global sections, so it defines an `X`-morphism
`g : X ⟶ ℙˢ_X` with `g^* 𝒪(1) ≅ L^r` (Hartshorne II, Theorem 7.1). -/
theorem IsAmple.exists_hom_projectiveSpace_tensorPower {X : Scheme.{u}} [IsNoetherian X]
    {L : X.Modules} (hL : L.IsAmple) :
    ∃ N₀ : ℕ, ∀ r ≥ N₀, ∃ (s : ℕ) (g : X ⟶ projectiveSpaceOverScheme s X),
      g ≫ projectiveSpaceOverSchemeProjection s X = 𝟙 X ∧
      Nonempty ((Scheme.Modules.pullback g).obj (projectiveSpaceTwistingSheaf s X 1) ≅
        moduleSheafTensorPower r L) := by
  classical
  obtain ⟨N₀, hN⟩ := hL.exists_isAffineOpen_nonvanishingLocus
  refine ⟨N₀, fun r hr => ?_⟩
  have hLr : Scheme.Modules.IsInvertible (moduleSheafTensorPower r L) := isInvertible_moduleSheafTensorPower hL.1 r
  choose w hw using hN r hr
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover
    (fun x => nonvanishingLocus (moduleSheafTensorPower r L) (w x))
    (fun x => isOpen_nonvanishingLocus hLr (w x)) (fun x _ => Set.mem_iUnion.mpr ⟨x, (hw x).1⟩)
  let J := Option T
  let N' := Fintype.card T
  let ε : J ≃ Fin (N' + 1) := Fintype.equivFinOfCardEq (by simp [J, N'])
  let t : Fin (N' + 1) → Γ(moduleSheafTensorPower r L, ⊤) := fun k =>
    Option.elim (ε.symm k) 0 (fun y => w y.1)
  have hgen : Scheme.Modules.IsGeneratedBySections (moduleSheafTensorPower r L : X.Modules)
      (fun k : ULift.{u} (Fin (N' + 1)) => t k.down) :=
    isGeneratedBySections_of_forall_isTrivializingSection _ fun x => by
      obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (hT (Set.mem_univ x))
      refine ⟨⟨ε (some ⟨y, hy⟩)⟩, nonvanishingLocusOpens hLr (w y), hxy, ?_⟩
      have ht : t (ε (some ⟨y, hy⟩)) = w y := by simp [t]
      simp only [ht]
      exact isTrivializingSection_nonvanishingLocusOpens hLr (w y)
  obtain ⟨g, ⟨hg, e, -⟩, -⟩ := existsUnique_morphism_of_isGeneratedBySections (𝟙 X) hLr t hgen
  exact ⟨N', g, hg, ⟨e⟩⟩

end Hartshorne
