import Hartshorne.Scheme.RelativeProjAmpleTwistEmbedding

/-!
# An ample twist makes relative Proj projective

Hartshorne, *Algebraic Geometry*, II, Proposition 7.10(b) (pp. 161–162).
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

namespace Hartshorne

namespace RelativeProjData

variable {X : Scheme.{u}} [IsNoetherian X] (D : RelativeProjData X)

/-- **Hartshorne II, Proposition 7.10(b).** Let `X` be a Noetherian scheme and `S` a
quasi-coherent sheaf of graded `𝒪_X`-algebras with `S₀ = 𝒪_X`, `S₁` coherent and `S` locally
generated by `S₁`, and let `π : Proj_X S ⟶ X` be the projection. If `X` admits an ample invertible
sheaf `L`, then `π` is projective, and for all sufficiently large `n` the invertible sheaf
`𝒪(1) ⊗ π^* L^n` is very ample relative to `X`. -/
theorem projective_projection_and_isVeryAmpleRelative_of_isAmple {L : X.Modules}
    (hL : L.IsAmple) :
    Projective D.projection ∧ ∃ n₀ : ℕ, ∀ n ≥ n₀,
      IsVeryAmpleRelative D.projection
        (moduleSheafTensor (D.algebra.relTwistingSheaf 1)
          ((Scheme.Modules.pullback D.projection).obj (moduleSheafTensorPower n L))) := by
  obtain ⟨m, N, φ, himm, hφ, ⟨e⟩⟩ := D.exists_isImmersion_twist hL
  have hπ : IsProper D.projection := D.isProper_projection
  have := projectiveSpaceOverSchemeProjection_isProper N X
  have : IsProper (φ ≫ projectiveSpaceOverSchemeProjection N X) := by
    rw [hφ]
    exact hπ
  have : IsProper φ := IsProper.of_comp φ (projectiveSpaceOverSchemeProjection N X)
  have hcl : IsClosedImmersion φ :=
    IsClosedImmersion.of_isPreimmersion φ φ.isClosedMap.isClosed_range
  refine ⟨⟨N, φ, hcl, hφ⟩, ?_⟩
  obtain ⟨N₀, hN₀⟩ := IsAmple.exists_hom_projectiveSpace_tensorPower hL
  refine ⟨m + N₀, fun n hn => ?_⟩
  obtain ⟨r, rfl⟩ : ∃ r, n = m + r := ⟨n - m, by omega⟩
  obtain ⟨s, gr, hgr, ⟨egr⟩⟩ := hN₀ r (by omega)
  have hO := D.algebra.isInvertible_relTwistingSheaf 1 D.generated
  have hR : ∀ k, Ringed.IsInvertible (R := X.sheaf) (moduleSheafTensorPower k L) := fun k =>
    (Scheme.Modules.isInvertible_iff_ringed _).mp (isInvertible_moduleSheafTensorPower hL.1 k)
  have hm : IsVeryAmpleRelative D.projection
      (moduleSheafTensor (D.algebra.relTwistingSheaf 1)
        ((Scheme.Modules.pullback D.projection).obj (moduleSheafTensorPower m L))) :=
    ⟨(Scheme.Modules.isInvertible_iff_ringed _).mpr (Ringed.IsInvertible.of_iso
        ((Scheme.Modules.isInvertible_iff_ringed _).mp
          (isInvertible_pullback_projectiveSpaceTwistingSheaf φ)) e),
      N, D.relativeProj, 𝟙 _, φ, inferInstance, hcl, by rw [Category.id_comp, hφ],
      ⟨(Scheme.Modules.pullbackCongr (Category.id_comp φ)).app _ ≪≫ e⟩⟩
  have hr : Scheme.Modules.IsInvertible
      ((Scheme.Modules.pullback D.projection).obj (moduleSheafTensorPower r L)) :=
    Scheme.Modules.IsInvertible.pullback _ (isInvertible_moduleSheafTensorPower hL.1 r)
  have h := isVeryAmpleRelative_moduleSheafTensor_of_hom hm hr (D.projection ≫ gr)
    (by rw [Category.assoc, hgr, Category.comp_id])
    (((Scheme.Modules.pullbackComp _ _).app _).symm ≪≫
      (Scheme.Modules.pullback D.projection).mapIso egr)
  exact h.of_iso (Ringed.moduleSheafTensorAssoc _ _ _ ≪≫
    Ringed.moduleSheafTensorIsoOfIso (Iso.refl _)
      ((pullbackTensorIso D.projection (hR m) (hR r)).symm ≪≫
        (Scheme.Modules.pullback D.projection).mapIso
          (Ringed.moduleSheafTensorPowerAddIso L m r).symm))

end RelativeProjData

end Hartshorne
