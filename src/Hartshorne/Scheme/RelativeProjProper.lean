import Hartshorne.Scheme.RelativeProj
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Proper

/-!
# Relative Proj is proper

Hartshorne, *Algebraic Geometry*, II.7, Proposition 7.10(a) (see also Stacks Project, tag 01W7).

For a Noetherian scheme `X` and a quasi-coherent graded `𝒪_X`-algebra `S` with `S₀ = 𝒪_X`,
`S₁` coherent and `S` generated by `S₁`, the projection `Proj_X S ⟶ X` is proper.

Properness is local on the target, so it suffices to check it over every affine open `U ⊆ X`.
There the projection is `Proj S(U) ⟶ Spec S(U)₀ ≅ Spec Γ(U, 𝒪_X) ≅ U`. Since `S(U)` is generated
by `S(U)₀ ∪ S(U)₁` and `S(U)₁` is finitely generated over `Γ(U, 𝒪_X)`, hence over `S(U)₀`, the
ring `S(U)` is a finitely generated `S(U)₀`-algebra, and Mathlib's properness of
`Proj.toSpecZero` applies.
-/

noncomputable section

open CategoryTheory AlgebraicGeometry

universe u

namespace Hartshorne

namespace QuasiCoherentGradedAlgebra

variable {X : Scheme.{u}} (S : QuasiCoherentGradedAlgebra X)

/-- If `S₁` is coherent and `S` is generated by `S₁`, then each `S(U)` is a finitely generated
`S(U)₀`-algebra. -/
theorem finiteType_of_degreeOne (hS₁ : S.DegreeOneCoherent) (hgen : S.GeneratedInDegreeOne)
    (U : X.AffineZariskiSite) : Algebra.FiniteType (S.grading U 0) (S.obj.obj (.op U)) := by
  classical
  obtain ⟨k, m, -, hspan⟩ := hS₁ U
  refine ⟨⟨Finset.univ.image m, eq_top_iff.mpr fun x _ ↦ ?_⟩⟩
  have hle : Subring.closure ((S.grading U 0 : Set (S.obj.obj (.op U))) ∪ S.grading U 1) ≤
      (Algebra.adjoin (S.grading U 0)
        (Finset.univ.image m : Set (S.obj.obj (.op U)))).toSubring := by
    rw [Subring.closure_le]
    rintro x (hx | hx)
    · exact Subalgebra.algebraMap_mem _ (⟨x, hx⟩ : S.grading U 0)
    · obtain ⟨c, rfl⟩ := hspan x hx
      refine Subalgebra.sum_mem _ fun i _ ↦ Subalgebra.mul_mem _ ?_ ?_
      · exact Subalgebra.algebraMap_mem _ (S.toZero U (c i))
      · exact Algebra.subset_adjoin (by simp)
  exact Subalgebra.mem_toSubring.mp (hle (hgen U ▸ Subring.mem_top x))

end QuasiCoherentGradedAlgebra

namespace RelativeProjData

variable {X : Scheme.{u}} [IsNoetherian X] (D : RelativeProjData X)

/-- **Hartshorne II, Proposition 7.10(a).** The projection `Proj_X S ⟶ X` is proper. -/
theorem isProper_projection : IsProper D.projection := by
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsProper)
    (fun U : X.AffineZariskiSite ↦ U.1) (iSup_affineOpens_eq_top X) fun U ↦ ?_
  have hU : D.algebra.projToOpen U = Proj.toSpecZero (D.algebra.grading U) ≫
      Spec.map (D.algebra.toZero U) ≫ U.2.isoSpec.inv := by
    rw [← cancel_mono U.1.ι, D.algebra.projToOpen_ι, Category.assoc, Category.assoc,
      IsAffineOpen.isoSpec_inv_ι]
  have := D.algebra.finiteType_of_degreeOne D.degreeOne_coherent D.generated U
  have : IsIso (D.algebra.toZero U) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr (D.degreeZero U)
  have : IsProper (D.algebra.projToOpen U) := by
    rw [hU]
    infer_instance
  rw [← D.restrictIso_hom_projToOpen U]
  infer_instance

end RelativeProjData

end Hartshorne
