/-!
# The tautological quotient of a projective bundle

Hartshorne, *Algebraic Geometry*, II, Propositions 7.11(b) and 7.12 (p. 162), and Exercise 7.8
(p. 170).

Let `X` be a Noetherian scheme, `E` a locally free `𝒪_X`-module of finite rank and
`π : P(E) = Proj_X S(E) ⟶ X` the projective bundle. The degree-one part of the natural maps
`S^l(E) ⟶ π_* 𝒪(l)` is a map `E ≅ S^1(E) ⟶ π_* 𝒪(1)`, which over an affine open `U` sends
`s ∈ Γ(U, E) = Γ(U, S(E))_1` to the section `s / 1` of `𝒪(1)` on `π⁻¹(U) = Proj Γ(U, S(E))`.
Its adjoint is the natural map `π^* E ⟶ 𝒪(1)`, and it is surjective: on `Proj Γ(U, S(E))` the
sections `s / 1` generate `𝒪(1)`, because `Γ(U, S(E))` is generated by `Γ(U, S(E))_1` as a
`Γ(U, 𝒪_X)`-algebra.

Pulling the tautological quotient back along a morphism `φ : Y ⟶ P(E)` over `g : Y ⟶ X` gives an
invertible quotient `g^* E ≅ φ^* π^* E ⟶ φ^* 𝒪(1)` of `g^* E`. Every invertible quotient of
`g^* E` arises in this way from a unique `φ`, up to isomorphism of the invertible sheaf
(Proposition 7.12); for `Y = X` this classifies the sections of `π` (Exercise 7.8).

## Proof of Proposition 7.12

The question is local on `X`. Over an open `U` on which `E` has a frame `e_0, …, e_n`, the frame
gives `ψ : π⁻¹(U) ≅ ℙⁿ_U`, and `ψ^* 𝒪(1) ≅ 𝒪(1)|_{π⁻¹(U)}` by an isomorphism carrying the
coordinates `ψ^* x_i` to the images of `π^* e_i` under the tautological quotient (the frame
chart). Hence a morphism `Y ⟶ π⁻¹(U)` over `g` is the same as a morphism `Y ⟶ ℙⁿ_U` over `g`,
and by Theorem 7.1(b) such morphisms correspond to invertible sheaves `L` generated by sections
`s_0, …, s_n`; for a quotient `q : g^* E ⟶ L` these are `s_i = q(g^* e_i)`. (Over an open on which
`E` has the empty frame, `g^* E` has no invertible quotient on a nonempty scheme.) Uniqueness is
then local on `Y`, and the local morphisms glue over an open cover of `Y`, agreeing on overlaps
by uniqueness. That the glued morphism represents `q` is local on `Y` as well: two quotients of
the same module which are locally equivalent are equivalent, because the isomorphism of the
targets is determined (an epimorphism is the cokernel of its kernel).

## Main definitions and results

* `Hartshorne.QuasiCoherentGradedAlgebra.pullbackTwistQuotient`,
  `Hartshorne.QuasiCoherentGradedAlgebra.epi_pullbackTwistQuotient`: for a relative `Proj` of a
  quasi-coherent graded algebra `S` generated in degree one, the adjoint `π^* F ⟶ 𝒪(1)` of a map
  `F ⟶ π_* 𝒪(1)` given by degree-one sections, and its surjectivity when every element of degree
  one comes from `F`. These are stated for any module `M` with identifications
  `M|_{Proj S(U)} ≅ 𝒪_{Proj S(U)}(1)`, which keeps the kernel away from the construction of `𝒪(1)`.
* `AlgebraicGeometry.Scheme.Modules.projectiveBundleTautologicalQuotient`: `π^* E ⟶ 𝒪(1)`.
* `AlgebraicGeometry.Scheme.Modules.epi_projectiveBundleTautologicalQuotient`: it is surjective.
* `AlgebraicGeometry.Scheme.Modules.InvertibleQuotient`: invertible quotients of a module, with
  the equivalence given by isomorphisms of the invertible sheaves intertwining the quotient maps.
* `AlgebraicGeometry.Scheme.Modules.projectiveBundleInvertibleQuotientOfHom`: the invertible
  quotient of `g^* E` attached to a morphism `Y ⟶ P(E)` over `X`.
* `AlgebraicGeometry.Scheme.Modules.projectiveBundle_exists_hom_of_invertibleQuotient`,
  `AlgebraicGeometry.Scheme.Modules.projectiveBundle_hom_eq_of_equiv`,
  `AlgebraicGeometry.Scheme.Modules.projectiveBundleHomEquiv`: Proposition 7.12, the bijection
  between morphisms `Y ⟶ P(E)` over `X` and equivalence classes of invertible quotients of
  `g^* E`.
* `AlgebraicGeometry.Scheme.Modules.projectiveBundleSectionEquiv`: Exercise 7.8, sections of `π`
  and invertible quotients of `E`.
* `AlgebraicGeometry.Scheme.Modules.exists_frameChart_iso`: the frame chart.
-/

universe u

open CategoryTheory Opposite TopologicalSpace Limits

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace Hartshorne

open AlgebraicGeometry

/-! ### Generic lemmas on sections -/

section Generic

variable {Z W : Scheme.{u}}

/-- The adjoint `f^* M ⟶ N` of `ψ : M ⟶ f_* N` sends `f^* s` to `ψ s`. -/
theorem pullbackPushforwardAdjunction_homEquiv_symm_app_pullbackSection (f : Z ⟶ W)
    {M : W.Modules} {N : Z.Modules} (ψ : M ⟶ (Scheme.Modules.pushforward f).obj N) {V : W.Opens}
    (s : Γ(M, V)) :
    (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _).symm ψ).app (f ⁻¹ᵁ V)
        (pullbackSection f s) = ψ.app V s := by
  have h : (Scheme.Modules.pullbackPushforwardAdjunction f).unit.app M ≫
      (Scheme.Modules.pushforward f).map
        (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _).symm ψ) = ψ :=
    ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv_unit _ _ _).symm.trans
      (Equiv.apply_symm_apply _ _)
  exact ConcreteCategory.congr_hom (congrArg (fun φ => Scheme.Modules.Hom.app φ V) h) s

/-- A morphism of modules sends the compatible family of restrictions of a global section `t` to
that of its image. -/
theorem sectionsMap_sectionsOfTop {F G : Z.Modules} (g : F ⟶ G) (t : Γ(F, ⊤)) :
    SheafOfModules.sectionsMap g (Scheme.Modules.GloballyGenerated.sectionsOfTop F t) =
      Scheme.Modules.GloballyGenerated.sectionsOfTop G (g.app ⊤ t) := by
  ext W
  exact hom_app_map g (le_top : W.unop ≤ ⊤) t

/-- A morphism of `𝒪_Z`-modules is an epimorphism if its restrictions along a jointly
surjective family of open immersions are. -/
theorem epi_of_epi_restrictFunctor_map {F G : Z.Modules} (φ : F ⟶ G)
    {ι : Type*} {V : ι → Scheme.{u}} (f : ∀ i, V i ⟶ Z) [∀ i, IsOpenImmersion (f i)]
    (hcov : ∀ z : Z, ∃ i, z ∈ Set.range (f i))
    (h : ∀ i, Epi ((Scheme.Modules.restrictFunctor (f i)).map φ)) : Epi φ := by
  have h1 : Epi ((SheafOfModules.toSheaf Z.ringCatSheaf).map φ) := by
    refine (TopCat.Sheaf.isLocallySurjective_iff_epi _).1
      ((TopCat.Presheaf.isLocallySurjective_iff _).2 fun W t z hz => ?_)
    obtain ⟨i, y, rfl⟩ := hcov z
    obtain ⟨V', hV', hyV', s, hs⟩ := modules_exists_local_lift
      ((Scheme.Modules.restrictFunctor (f i)).map φ)
      (show Γ(G.restrict (f i), f i ⁻¹ᵁ W) from
        G.presheaf.map (homOfLE ((f i).image_preimage_le W)).op t)
      (show y ∈ f i ⁻¹ᵁ W from hz)
    refine ⟨f i ''ᵁ V', ((f i).image_mono hV').trans ((f i).image_preimage_le W),
      ⟨s, hs.trans ?_⟩, ⟨y, hyV', rfl⟩⟩
    change G.presheaf.map _ (G.presheaf.map _ t) = G.presheaf.map _ t
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  exact (SheafOfModules.toSheaf Z.ringCatSheaf).epi_of_epi_map h1

end Generic

/-! ### Generic lemmas on pullbacks of modules -/

section PullbackGeneric

variable {Z W : Scheme.{u}}

/-- Two morphisms out of a pullback `f^* M` agree if they agree on the pulled-back sections
`f^* s`. -/
theorem pullback_hom_ext_pullbackSection (f : Z ⟶ W) {M : W.Modules} {N : Z.Modules}
    {h₁ h₂ : (Scheme.Modules.pullback f).obj M ⟶ N}
    (h : ∀ (V : W.Opens) (s : Γ(M, V)), h₁.app (f ⁻¹ᵁ V) (pullbackSection f s) =
      h₂.app (f ⁻¹ᵁ V) (pullbackSection f s)) : h₁ = h₂ := by
  apply ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv _ _).injective
  rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit]
  ext V s
  exact h V s

/-- Two morphisms out of a module with a frame over `Z` agree if they agree on the frame. -/
theorem hom_ext_of_isLocalFrame_top {A G : Z.Modules} {ι : Type u} [Fintype ι]
    {e : ι → Γ(A, ⊤)} (he : Ringed.IsLocalFrame (R := Z.sheaf) A ⊤ e) {h₁ h₂ : A ⟶ G}
    (h : ∀ i, h₁.app ⊤ (e i) = h₂.app ⊤ (e i)) : h₁ = h₂ := by
  ext V x
  obtain ⟨a, rfl⟩ := (he V le_top).2 x
  rw [Ringed.localFrameMap_apply, map_sum, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Scheme.Modules.Hom.app_smul, Scheme.Modules.Hom.app_smul]
  erw [hom_app_map, hom_app_map, h i]

/-- The images of a frame over `Z` under an epimorphism `A ⟶ L` generate `L`. -/
theorem isGeneratedBySections_of_epi_of_isLocalFrame_top {A L : Z.Modules} {ι : Type u}
    [Fintype ι] {e : ι → Γ(A, ⊤)} (he : Ringed.IsLocalFrame (R := Z.sheaf) A ⊤ e)
    (q : A ⟶ L) [Epi q] : L.IsGeneratedBySections (fun i => q.app ⊤ (e i)) := by
  intro x
  rw [eq_top_iff]
  rintro y -
  obtain ⟨W, hxW, t, rfl⟩ := L.presheaf.exists_germ_eq y
  obtain ⟨V, hVW, hxV, s, hs⟩ := modules_exists_local_lift q t hxW
  rw [← TopCat.Presheaf.germ_res_apply L.presheaf (homOfLE hVW) x hxV t]
  change L.presheaf.germ V x hxV (L.presheaf.map (homOfLE hVW).op t) ∈ _
  rw [← hs]
  obtain ⟨a, rfl⟩ := (he V le_top).2 s
  rw [Ringed.localFrameMap_apply, map_sum, map_sum]
  refine Submodule.sum_mem _ fun i _ => ?_
  rw [Scheme.Modules.Hom.app_smul, schemeModules_germ_smul]
  refine Submodule.smul_mem _ _ ?_
  erw [hom_app_map, TopCat.Presheaf.germ_res_apply]
  exact Submodule.subset_span ⟨i, rfl⟩

/-- A scheme carrying an invertible sheaf generated by the empty family of sections is empty. -/
theorem isEmpty_of_isInvertible_of_isGeneratedBySections {L : Z.Modules}
    (hL : L.IsInvertible) {ι : Type u} [IsEmpty ι] {s : ι → Γ(L, ⊤)}
    (hs : L.IsGeneratedBySections s) : IsEmpty Z := by
  refine ⟨fun z => ?_⟩
  obtain ⟨U, e, hzU, he⟩ := exists_isTrivializingSection hL z
  have h1 := hs z
  rw [Set.range_eq_empty, Submodule.span_empty] at h1
  have h2 : L.presheaf.germ U z hzU e = 0 := by
    have : L.presheaf.germ U z hzU e ∈
        (⊤ : Submodule (Z.presheaf.stalk z) (L.presheaf.stalk z)) := Submodule.mem_top
    rw [← h1] at this
    exact (Submodule.mem_bot _).1 this
  exact one_ne_zero (he.eq_zero_of_smul_germ_eq_zero hzU 1 (by rw [h2, smul_zero]))

/-- A morphism of modules vanishes if its pullbacks to the members of an open cover vanish. -/
theorem eq_zero_of_pullback_map_eq_zero {A B : Z.Modules} (h : A ⟶ B) {ι : Type u}
    (V : ι → Z.Opens) (hV : ∀ z, ∃ i, z ∈ V i)
    (hh : ∀ i, (Scheme.Modules.pullback (V i).ι).map h = 0) : h = 0 := by
  ext W x
  change h.app W x = 0
  refine DirectedModuleGluing.mod_ext B (fun i => (V i).ι ''ᵁ ((V i).ι ⁻¹ᵁ W))
    (fun i => Scheme.Hom.image_preimage_le _ _) (fun z hz => ?_) _ _ fun i => ?_
  · obtain ⟨i, hi⟩ := hV z
    exact Opens.mem_iSup.2 ⟨i, ⟨⟨z, hi⟩, hz, rfl⟩⟩
  · rw [map_zero]
    have key := Scheme.Modules.restrictFunctorIsoPullback_hom_restrict_unit (V i).ι B W
      (h.app W x)
    rw [← Scheme.Modules.pullback_map_unit, hh i] at key
    apply (ConcreteCategory.bijective_of_isIso
      (((Scheme.Modules.restrictFunctorIsoPullback (V i).ι).hom.app B).app
        ((V i).ι ⁻¹ᵁ W))).1
    rw [key, map_zero]
    rfl

/-- **Equivalence of quotients is local.** If two epimorphisms `q : F ⟶ L`, `q' : F ⟶ L'` become
equivalent (by an isomorphism of the targets intertwining them) after pulling back to the members
of an open cover, then they are equivalent. -/
theorem exists_iso_comp_eq_of_pullback {F L L' : Z.Modules} (q : F ⟶ L) (q' : F ⟶ L')
    [Epi q] [Epi q'] {ι : Type u} (V : ι → Z.Opens) (hV : ∀ z, ∃ i, z ∈ V i)
    (h : ∀ i, ∃ e : (Scheme.Modules.pullback (V i).ι).obj L ≅
        (Scheme.Modules.pullback (V i).ι).obj L',
      (Scheme.Modules.pullback (V i).ι).map q ≫ e.hom =
        (Scheme.Modules.pullback (V i).ι).map q') :
    ∃ e : L ≅ L', q ≫ e.hom = q' := by
  have key : ∀ {L₁ L₂ : Z.Modules} (q₁ : F ⟶ L₁) (q₂ : F ⟶ L₂) [Epi q₁],
      (∀ i, ∃ e : (Scheme.Modules.pullback (V i).ι).obj L₁ ⟶
          (Scheme.Modules.pullback (V i).ι).obj L₂,
        (Scheme.Modules.pullback (V i).ι).map q₁ ≫ e =
          (Scheme.Modules.pullback (V i).ι).map q₂) →
      kernel.ι q₁ ≫ q₂ = 0 := by
    intro L₁ L₂ q₁ q₂ _ h
    refine eq_zero_of_pullback_map_eq_zero _ V hV fun i => ?_
    obtain ⟨e, he⟩ := h i
    rw [Functor.map_comp, ← he, ← Category.assoc, ← Functor.map_comp, kernel.condition,
      Functor.map_zero, zero_comp]
  choose e he using h
  let d := Abelian.epiDesc q q' (key q q' fun i => ⟨(e i).hom, he i⟩)
  let d' := Abelian.epiDesc q' q (key q' q fun i => ⟨(e i).inv, by
    rw [← he i, Category.assoc, Iso.hom_inv_id, Category.comp_id]⟩)
  have hd : q ≫ d = q' := Abelian.comp_epiDesc _ _ _
  have hd' : q' ≫ d' = q := Abelian.comp_epiDesc _ _ _
  refine ⟨⟨d, d', ?_, ?_⟩, hd⟩
  · rw [← cancel_epi q, ← Category.assoc, hd, hd', Category.comp_id]
  · rw [← cancel_epi q', ← Category.assoc, hd', hd, Category.comp_id]

/-- For `f ≫ h = g`, the identification `g^* E ≅ f^* h^* E`. -/
def pullbackObjIsoOfComp {Y X : Scheme.{u}} (f : Y ⟶ Z) (h : Z ⟶ X) {g : Y ⟶ X}
    (hg : f ≫ h = g) (E : X.Modules) :
    (Scheme.Modules.pullback g).obj E ≅
      (Scheme.Modules.pullback f).obj ((Scheme.Modules.pullback h).obj E) :=
  (Scheme.Modules.pullbackCongr hg.symm).app E ≪≫
    ((Scheme.Modules.pullbackComp f h).app E).symm

/-- For `g = f ≫ h`, the identification `g^* E ≅ f^* h^* E` sends `g^* s` to `f^* h^* s`. -/
theorem pullbackObjIsoOfComp_hom_pullbackSection {Y X : Scheme.{u}} (f : Y ⟶ Z) (h : Z ⟶ X)
    (E : X.Modules) (V : X.Opens) (s : Γ(E, V)) :
    (pullbackObjIsoOfComp f h rfl E).hom.app ((f ≫ h) ⁻¹ᵁ V) (pullbackSection (f ≫ h) s) =
      pullbackSection f (pullbackSection h s) := by
  simp only [pullbackObjIsoOfComp, Scheme.Modules.pullbackCongr, Iso.trans_hom, Iso.app_hom,
    Iso.symm_hom, Iso.app_inv, eqToIso_refl, Iso.refl_hom, NatTrans.id_app, Category.id_comp]
  exact Scheme.Modules.pullbackComp_inv_unit f h E V s

/-- Compatibility of `pullbackObjIsoOfComp` with composition: pulling back
`g^* E ≅ f^* h^* E ⟶ f^* N` along `k` gives `(k ≫ g)^* E ≅ (k ≫ f)^* h^* E ⟶ (k ≫ f)^* N`. -/
theorem pullbackObjIsoOfComp_hom_comp {Y X V : Scheme.{u}} (k : V ⟶ Y) (f : Y ⟶ Z)
    (h : Z ⟶ X) {g : Y ⟶ X} (hf : f ≫ h = g) {g' : V ⟶ X} (hk : k ≫ g = g')
    (h' : (k ≫ f) ≫ h = g') {E : X.Modules} {N : Z.Modules}
    (m : (Scheme.Modules.pullback h).obj E ⟶ N) :
    (pullbackObjIsoOfComp k g hk E).hom ≫ (Scheme.Modules.pullback k).map
        ((pullbackObjIsoOfComp f h hf E).hom ≫ (Scheme.Modules.pullback f).map m) ≫
        (Scheme.Modules.pullbackComp k f).hom.app N =
      (pullbackObjIsoOfComp (k ≫ f) h h' E).hom ≫ (Scheme.Modules.pullback (k ≫ f)).map m := by
  subst hk hf
  refine pullback_hom_ext_pullbackSection _ fun T s => ?_
  have h1 := pullbackObjIsoOfComp_hom_pullbackSection k (f ≫ h) E T s
  have h3 : ((pullbackObjIsoOfComp f h rfl E).hom ≫ (Scheme.Modules.pullback f).map m).app
      ((f ≫ h) ⁻¹ᵁ T) (pullbackSection (f ≫ h) s) =
      pullbackSection f (m.app (h ⁻¹ᵁ T) (pullbackSection h s)) := by
    rw [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply,
      pullbackObjIsoOfComp_hom_pullbackSection]
    exact Scheme.Modules.pullback_map_unit f m (h ⁻¹ᵁ T) _
  have h2 := Scheme.Modules.pullback_map_unit k
    ((pullbackObjIsoOfComp f h rfl E).hom ≫ (Scheme.Modules.pullback f).map m)
    ((f ≫ h) ⁻¹ᵁ T) (pullbackSection (f ≫ h) s)
  have h4 := Scheme.Modules.pullbackComp_hom_unit k f N (h ⁻¹ᵁ T)
    (m.app (h ⁻¹ᵁ T) (pullbackSection h s))
  have h5 : (pullbackObjIsoOfComp (k ≫ f) h h' E).hom.app ((k ≫ f ≫ h) ⁻¹ᵁ T)
      (pullbackSection (k ≫ f ≫ h) s) = pullbackSection (k ≫ f) (pullbackSection h s) :=
    pullbackObjIsoOfComp_hom_pullbackSection (k ≫ f) h E T s
  have h6 := Scheme.Modules.pullback_map_unit (k ≫ f) m (h ⁻¹ᵁ T) (pullbackSection h s)
  simp only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply]
  rw [h5]
  erw [h1]
  rw [pullbackSection_eq_unit k]
  erw [h2]
  rw [← pullbackSection_eq_unit, h3, pullbackSection_eq_unit, pullbackSection_eq_unit]
  erw [h4]
  exact h6.symm

end PullbackGeneric

/-! ### The quotient `π^* F ⟶ 𝒪(1)` of a relative `Proj` -/

namespace QuasiCoherentGradedAlgebra

variable {X : Scheme.{u}} {S : QuasiCoherentGradedAlgebra X} (M : S.relProj.Modules)
  (α : ∀ U, M.restrict (S.projι U) ≅ S.twistingSheaf ((1 : ℕ) : ℤ) U) {F : X.Modules}
  (τ : S.GradedSectionsMap 1 F) (hα : TwistCompatible M α)

/-- The adjoint `π^* F ⟶ M` of the map `F ⟶ π_* M` which on the affine piece `Proj S(U)` sends
`s ∈ Γ(U, F)` to the section `τ(s) / 1` (`M` identified with `𝒪(1)` on the pieces by `α`). -/
def pullbackTwistQuotient : (Scheme.Modules.pullback S.relProjToBase).obj F ⟶ M :=
  ((Scheme.Modules.pullbackPushforwardAdjunction S.relProjToBase).homEquiv _ _).symm
    (pushforwardTwistHom M α τ hα)

/-- On the affine piece `Proj S(U)`, the quotient sends `π^* s` to the degree-one section
`τ(s) / 1`. -/
theorem pullbackTwistQuotient_piece (U : X.AffineZariskiSite) (s : Γ(F, U.1)) :
    (α U).hom.app ⊤ ((pullbackTwistQuotient M α τ hα).app _
        (((Scheme.Modules.pullback S.relProjToBase).obj F).presheaf.map
          (homOfLE (S.projι_image_top_le ⟨U, le_rfl⟩)).op
          (pullbackSection S.relProjToBase s))) =
      ProjTwistingSheaf.degreeOneSection (τ.toFun U s) := by
  rw [hom_app_map, pullbackTwistQuotient,
    pullbackPushforwardAdjunction_homEquiv_symm_app_pullbackSection]
  have h := pushforwardTwistHom_app_restrict M α τ hα U le_rfl s
  have h' : F.presheaf.map (homOfLE (le_refl U.1)).op s = s := by
    have : (homOfLE (le_refl U.1)).op = 𝟙 (op U.1) := rfl
    rw [this, CategoryTheory.Functor.map_id]
    rfl
  rw [h'] at h
  exact h

/-- **The quotient `π^* F ⟶ 𝒪(1)` is surjective** if `S` is generated in degree one and, over
every affine open `U`, every element of `S(U)_1` is `τ(s)` for some `s ∈ Γ(U, F)`: on
`Proj S(U)` its image contains the degree-one sections, which generate `𝒪(1)`. -/
theorem epi_pullbackTwistQuotient (hS : S.GeneratedInDegreeOne)
    (hτ : ∀ U, Function.Surjective (τ.toFun U)) : Epi (pullbackTwistQuotient M α τ hα) := by
  refine epi_of_epi_restrictFunctor_map _ S.projι (fun z => ?_) fun U => ?_
  · obtain ⟨U, hU, hzU⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
      (show S.relProjToBase z ∈ (⊤ : X.Opens) from trivial)
    refine ⟨⟨U, hU⟩, ?_⟩
    have hz : z ∈ S.relProjToBase ⁻¹ᵁ U := hzU.1
    rw [S.relProjToBase_preimage ⟨U, hU⟩] at hz
    exact hz
  · let g := (Scheme.Modules.restrictFunctor (S.projι U)).map
      (pullbackTwistQuotient M α τ hα) ≫ (α U).hom
    choose σ hσ using fun a => hτ U a
    let t : S.grading U 1 → Γ(((Scheme.Modules.pullback S.relProjToBase).obj F).restrict
        (S.projι U), ⊤) := fun a =>
      ((Scheme.Modules.pullback S.relProjToBase).obj F).presheaf.map
        (homOfLE (S.projι_image_top_le ⟨U, le_rfl⟩)).op (pullbackSection S.relProjToBase (σ a))
    have ht : ∀ a, g.app ⊤ (t a) = ProjTwistingSheaf.degreeOneSection a := by
      intro a
      refine (pullbackTwistQuotient_piece M α τ hα U (σ a)).trans ?_
      rw [hσ a]
    have hp := (ProjTwistingSheaf.isGeneratedBySections_degreeOneSection (𝒜 := S.grading U)
      (adjoin_eq_top_of_generatedInDegreeOne S hS U)).epi
    have hg : Epi g := by
      have hfac : (SheafOfModules.freeHomEquiv _).symm
          (fun a => Scheme.Modules.GloballyGenerated.sectionsOfTop _ (t a)) ≫ g =
          (SheafOfModules.freeHomEquiv (S.twistingSheaf ((1 : ℕ) : ℤ) U)).symm
            (fun a : S.grading U 1 => Scheme.Modules.GloballyGenerated.sectionsOfTop _
              (ProjTwistingSheaf.degreeOneSection (𝒜 := S.grading U) a)) := by
        rw [SheafOfModules.freeHomEquiv_symm_comp]
        congr 1
        funext a
        rw [sectionsMap_sectionsOfTop, ht]
      exact epi_of_epi_fac hfac
    have hτ' : (Scheme.Modules.restrictFunctor (S.projι U)).map
        (pullbackTwistQuotient M α τ hα) = g ≫ (α U).inv := by
      simp only [g, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [hτ']
    exact epi_comp _ _

end QuasiCoherentGradedAlgebra

end Hartshorne

namespace AlgebraicGeometry.Scheme.Modules

open Hartshorne Hartshorne.QuasiCoherentGradedAlgebra

variable {X : Scheme.{u}} {E : X.Modules} (hE : E.IsLocallyFree)
  (hfin : ∀ x, E.rankAt x < Cardinal.aleph0) [IsNoetherian X]

/-! ### The degree-one sections and the quotient `π^* E ⟶ M` -/

open Hartshorne.SheafAlgebraOperations Hartshorne.ModuleSheafAlgebra
  Hartshorne.SheafTensorOperations

omit [IsNoetherian X] in
/-- The inverse of `S^1(E) ≅ E` sends a section `s` to the class of `s` in `S^1(E)`. -/
theorem symmetricPowerOneIso_inv_app (V : X.Opens) (s : Γ(E, V)) :
    E.symmetricPowerOneIso.inv.app V s =
      (moduleSheafSymmetricPowerUnit (R := X.sheaf) 1 E).app (op V)
        (symmetricPowerTprod _ (E.val.obj (op V)) 1 (fun _ => s)) := by
  let A := PresheafOfModules.sheafificationAdjunction (𝟙 (siteRingCatSheaf X.sheaf).obj)
  let G := SheafOfModules.forget (siteRingCatSheaf X.sheaf) ⋙
    PresheafOfModules.restrictScalars (𝟙 (siteRingCatSheaf X.sheaf).obj)
  have h1 : A.unit.app (G.obj E) = G.map (inv (A.counit.app E)) := by
    rw [← cancel_mono (G.map (A.counit.app E)), ← G.map_comp, IsIso.inv_hom_id, G.map_id]
    exact A.right_triangle_components E
  have h2 := congrArg (fun f => (PresheafOfModules.Hom.app f (op V)).hom s)
    ((A.unit.naturality (symmetricPowerPresheafOneIso (R := X.sheaf) E).inv).symm)
  simp only [Functor.comp_map] at h2
  have h3 : (symmetricPowerPresheafOneIso (R := X.sheaf) E).inv.app (op V) s =
      symmetricPowerTprod _ (E.val.obj (op V)) 1 (fun _ => s) := by
    change (symmetricPowerOneEquiv _ (E.val.obj (op V))).symm s = _
    rw [LinearEquiv.symm_apply_eq, symmetricPowerOneEquiv_tprod]
  rw [← h3]
  refine Eq.trans ?_ h2
  rw [h1]
  rfl

omit [IsNoetherian X] in
/-- The degree-one sections map sends the class of `s ∈ Γ(U, E)` in `S^1(E)` to `s ∈ Γ(U, S(E))`. -/
theorem symmetricPowerGradedSectionsMap_one_inv (U : X.AffineZariskiSite) (s : Γ(E, U.1)) :
    ((symmetricPowerGradedSectionsMap hE hfin 1).toFun U
        (E.symmetricPowerOneIso.inv.app U.1 s) : (symmetricGradedAlgebra hE hfin).obj.obj (op U)) =
      E.symDegreeOne U.1 s := by
  change ((moduleSheafSymmetricAlgebraι (R := X.sheaf) 1 E).val.app (op U.1)
    (E.symmetricPowerOneIso.inv.app U.1 s) : _) = E.symUnitRingHom U.1 (SymmetricAlgebra.ι _ _ s)
  rw [symmetricPowerOneIso_inv_app]
  exact moduleSheafSymmetricAlgebraι_one_apply E (op U.1) s

section Represent

variable (M : (projectiveBundle hE hfin).Modules)
  (α : ∀ V, M.restrict ((symmetricGradedAlgebra hE hfin).projι V) ≅
    (symmetricGradedAlgebra hE hfin).twistingSheaf ((1 : ℕ) : ℤ) V)
  (hα : TwistCompatible M α)

/-- The quotient `π^* E ≅ π^* S^1(E) ⟶ M`. -/
def tautQuotientOf : (Scheme.Modules.pullback (projectiveBundleProj hE hfin)).obj E ⟶ M :=
  (Scheme.Modules.pullback (projectiveBundleProj hE hfin)).map E.symmetricPowerOneIso.inv ≫
    pullbackTwistQuotient M α (symmetricPowerGradedSectionsMap hE hfin 1) hα

/-- The quotient `π^* E ⟶ M` is surjective. -/
instance epi_tautQuotientOf : Epi (tautQuotientOf hE hfin M α hα) := by
  have := epi_pullbackTwistQuotient M α (symmetricPowerGradedSectionsMap hE hfin 1) hα
    (symmetricRelativeProjData hE hfin).generated
    (fun U => (symmetricPowerGradedSectionsMap_bijective hE hfin 1 U).2)
  unfold tautQuotientOf
  infer_instance

/-- On the affine piece `Proj Γ(V, S(E))`, the quotient `π^* E ⟶ M` sends `π^* s` to the
degree-one section `s / 1`. -/
theorem tautQuotientOf_piece (V : X.AffineZariskiSite) (s : Γ(E, V.1)) :
    (α V).hom.app ⊤ ((tautQuotientOf hE hfin M α hα).app _
        (((Scheme.Modules.pullback (projectiveBundleProj hE hfin)).obj E).presheaf.map
          (homOfLE ((symmetricGradedAlgebra hE hfin).projι_image_top_le ⟨V, le_rfl⟩)).op
          (pullbackSection (projectiveBundleProj hE hfin) s))) =
      ProjTwistingSheaf.degreeOneSection ((symmetricPowerGradedSectionsMap hE hfin 1).toFun V
        (E.symmetricPowerOneIso.inv.app V.1 s)) := by
  have h := pullbackTwistQuotient_piece M α (symmetricPowerGradedSectionsMap hE hfin 1) hα V
    (E.symmetricPowerOneIso.inv.app V.1 s)
  have hm : ((Scheme.Modules.pullback (projectiveBundleProj hE hfin)).map
      E.symmetricPowerOneIso.inv).app ((symmetricGradedAlgebra hE hfin).relProjToBase ⁻¹ᵁ V.1)
        (((Scheme.Modules.pullbackPushforwardAdjunction (projectiveBundleProj hE hfin)).unit.app
          E).app V.1 s) =
      ((Scheme.Modules.pullbackPushforwardAdjunction (projectiveBundleProj hE hfin)).unit.app
          (E.symmetricPower 1)).app V.1 (E.symmetricPowerOneIso.inv.app V.1 s) :=
    Scheme.Modules.pullback_map_unit _ _ _ _
  rw [tautQuotientOf, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply, hom_app_map,
    pullbackSection_eq_unit, hm]
  exact h

end Represent

/-- The isomorphisms `𝒪(1)|_{Proj Γ(V, S(E))} ≅ 𝒪_{Proj Γ(V, S(E))}(1)` of the affine pieces. -/
abbrev twistOneRestrictIso (V : X.AffineZariskiSite) :
    (projectiveBundleTwistingSheaf hE hfin 1).restrict ((symmetricGradedAlgebra hE hfin).projι V) ≅
      (symmetricGradedAlgebra hE hfin).twistingSheaf ((1 : ℕ) : ℤ) V :=
  (symmetricGradedAlgebra hE hfin).relTwistingSheafRestrictIso ((1 : ℕ) : ℤ) V

/-- The identifications of `𝒪(1)` with the twisting sheaves of the affine pieces are compatible
with the transition maps. -/
theorem twistCompatible_one : TwistCompatible (S := (symmetricRelativeProjData hE hfin).algebra)
    (projectiveBundleTwistingSheaf hE hfin 1) (twistOneRestrictIso hE hfin) :=
  twistCompatible_relTwistingSheaf _ 1


/-! ### The tautological quotient of `P(E)` -/

/-- **The tautological quotient `π^* E ⟶ 𝒪_{P(E)}(1)`** (Hartshorne II, Proposition 7.11(b)):
`π^* E ≅ π^* S^1(E)` followed by the adjoint of the natural map `S^1(E) ⟶ π_* 𝒪(1)`. Over an
affine open `U ⊆ X` it sends `π^* s`, `s ∈ Γ(U, E) = Γ(U, S(E))_1`, to the section `s / 1` of
`𝒪(1)` on `π⁻¹(U) = Proj Γ(U, S(E))`. -/
def projectiveBundleTautologicalQuotient :
    (Scheme.Modules.pullback (projectiveBundleProj hE hfin)).obj E ⟶
      projectiveBundleTwistingSheaf hE hfin 1 :=
  tautQuotientOf hE hfin (projectiveBundleTwistingSheaf hE hfin 1) (twistOneRestrictIso hE hfin)
    (twistCompatible_one hE hfin)

/-- **The tautological quotient is surjective** (Hartshorne II, Proposition 7.11(b)). On the affine
piece `Proj Γ(U, S(E))`, its image contains the degree-one sections `s / 1`, `s ∈ Γ(U, E)`, which
generate `𝒪(1)` since `Γ(U, S(E))` is generated by `Γ(U, S(E))_1` as a `Γ(U, 𝒪_X)`-algebra. -/
instance epi_projectiveBundleTautologicalQuotient :
    Epi (projectiveBundleTautologicalQuotient hE hfin) :=
  epi_tautQuotientOf hE hfin _ _ _

/-! ### Invertible quotients and the quotient attached to a morphism to `P(E)` -/

/-- An *invertible quotient* of an `𝒪_Y`-module `F`: an invertible sheaf `L` on `Y` with a
surjection `F ⟶ L`. -/
structure InvertibleQuotient {Y : Scheme.{u}} (F : Y.Modules) where
  /-- The invertible sheaf. -/
  sheaf : Y.Modules
  isInvertible : sheaf.IsInvertible
  /-- The quotient map. -/
  quotient : F ⟶ sheaf
  epi : Epi quotient

/-- Two invertible quotients `F ⟶ L` and `F ⟶ L'` are *equivalent* if some isomorphism
`L ≅ L'` intertwines the quotient maps. -/
def InvertibleQuotient.Equiv {Y : Scheme.{u}} {F : Y.Modules} (a b : InvertibleQuotient F) :
    Prop :=
  ∃ e : a.sheaf ≅ b.sheaf, a.quotient ≫ e.hom = b.quotient

/-- Equivalence of invertible quotients is an equivalence relation. -/
instance InvertibleQuotient.setoid {Y : Scheme.{u}} (F : Y.Modules) :
    Setoid (InvertibleQuotient F) where
  r := InvertibleQuotient.Equiv
  iseqv :=
    { refl a := ⟨Iso.refl _, Category.comp_id _⟩
      symm := fun ⟨e, he⟩ => ⟨e.symm, by rw [← he, Category.assoc, Iso.symm_hom, Iso.hom_inv_id,
        Category.comp_id]⟩
      trans := fun ⟨e, he⟩ ⟨e', he'⟩ => ⟨e ≪≫ e', by rw [Iso.trans_hom, ← Category.assoc, he,
        he']⟩ }

variable {Y : Scheme.{u}} {g : Y ⟶ X}

/-- For a morphism `φ : Y ⟶ P(E)` with `π ∘ φ = g`, the identification `g^* E ≅ φ^* π^* E`. -/
def projectiveBundlePullbackIso (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) :
    (Scheme.Modules.pullback g).obj E ≅ (Scheme.Modules.pullback φ).obj
      ((Scheme.Modules.pullback (projectiveBundleProj hE hfin)).obj E) :=
  (Scheme.Modules.pullbackCongr hφ.symm).app E ≪≫
    ((Scheme.Modules.pullbackComp φ (projectiveBundleProj hE hfin)).app E).symm

/-- **The quotient attached to a morphism to `P(E)`**: for `φ : Y ⟶ P(E)` over `X` (with
`π ∘ φ = g`), the pullback `g^* E ≅ φ^* π^* E ⟶ φ^* 𝒪(1)` of the tautological quotient. -/
def projectiveBundlePullbackQuotient (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) :
    (Scheme.Modules.pullback g).obj E ⟶
      (Scheme.Modules.pullback φ).obj (projectiveBundleTwistingSheaf hE hfin 1) :=
  (projectiveBundlePullbackIso hE hfin φ hφ).hom ≫
    (Scheme.Modules.pullback φ).map (projectiveBundleTautologicalQuotient hE hfin)

/-- The quotient attached to a morphism to `P(E)` is surjective. -/
instance epi_projectiveBundlePullbackQuotient (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) :
    Epi (projectiveBundlePullbackQuotient hE hfin φ hφ) := by
  unfold projectiveBundlePullbackQuotient
  infer_instance

/-- **A morphism `Y ⟶ P(E)` over `X` gives an invertible quotient of `g^* E`** (Hartshorne II,
Proposition 7.12, from morphisms to quotients): `φ^* 𝒪(1)`, which is invertible, with the
surjection `g^* E ≅ φ^* π^* E ⟶ φ^* 𝒪(1)` pulled back from the tautological quotient. -/
def projectiveBundleInvertibleQuotientOfHom (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) :
    InvertibleQuotient ((Scheme.Modules.pullback g).obj E) where
  sheaf := (Scheme.Modules.pullback φ).obj (projectiveBundleTwistingSheaf hE hfin 1)
  isInvertible := IsInvertible.pullback φ
    (isInvertible_relTwistingSheaf _ 1 (symmetricRelativeProjData hE hfin).generated)
  quotient := projectiveBundlePullbackQuotient hE hfin φ hφ
  epi := inferInstance


/-- The section `f^* T` of `f^* N` over all of `Y`, for a section `T` of `N` over an open whose
preimage is all of `Y`. -/
def pullbackSectionTop {Y Z : Scheme.{u}} (f : Y ⟶ Z) {N : Z.Modules} {W : Z.Opens}
    (hW : ⊤ ≤ f ⁻¹ᵁ W) (T : Γ(N, W)) : Γ((Scheme.Modules.pullback f).obj N, ⊤) :=
  ((Scheme.Modules.pullback f).obj N).presheaf.map (homOfLE hW).op (pullbackSection f T)

/-- For an open `V`, the identification `M|_V ≅ ι_V^* M` sends the restriction of a section `T`
over `V` to `ι_V^* T`. -/
theorem restrictFunctorIsoPullback_hom_app_top {Z : Scheme.{u}} (V : Z.Opens) (N : Z.Modules)
    (hV : V.ι ''ᵁ ⊤ ≤ V) (T : Γ(N, V)) :
    ((Scheme.Modules.restrictFunctorIsoPullback V.ι).app N).hom.app ⊤
        ((N.restrictAppIso V.ι ⊤).inv (N.presheaf.map (homOfLE hV).op T)) =
      pullbackSectionTop V.ι (Scheme.Opens.ι_preimage_self V).ge T := by
  have key := Scheme.Modules.restrictFunctorIsoPullback_hom_restrict_unit V.ι N V T
  have hx : (N.restrictAppIso V.ι ⊤).inv (N.presheaf.map (homOfLE hV).op T) =
      (N.restrict V.ι).presheaf.map (homOfLE (Scheme.Opens.ι_preimage_self V).ge).op
        ((N.restrictAppIso V.ι _).inv
          (N.presheaf.map (homOfLE (V.ι.image_preimage_le V)).op T)) := by
    rw [Scheme.Modules.restrictAppIso_inv_map_apply, DirectedModuleGluing.pmap_map]
  rw [hx, Iso.app_hom, hom_app_map]
  erw [key]
  rfl

section FrameChart

attribute [local instance] MvPolynomial.gradedAlgebra

variable (M : (projectiveBundle hE hfin).Modules)
  {α : ∀ V, M.restrict ((symmetricGradedAlgebra hE hfin).projι V) ≅
    (symmetricGradedAlgebra hE hfin).twistingSheaf ((1 : ℕ) : ℤ) V}
  (hα : TwistCompatible M α)
  {U : X.Opens} {n : ℕ} {e : ULift.{u} (Fin (n + 1)) → Γ(E, U)}
  (he : Ringed.IsLocalFrame (R := X.sheaf) E U e)
  (ψ : (projectiveBundleProj hE hfin ⁻¹ᵁ U).toScheme ≅ projectiveSpaceOverScheme n U)
  (hψ : ∀ (V : X.Opens) (hV : IsAffineOpen V) (hVU : V ≤ U),
        ((projectiveBundleProj hE hfin ⁻¹ᵁ U).ι ⁻¹ᵁ projectiveBundleProj hE hfin ⁻¹ᵁ V).ι ≫
            ψ.hom =
          (Scheme.Opens.isoOfLE (Scheme.Hom.preimage_mono (projectiveBundleProj hE hfin)
              hVU)).hom ≫
            (projectiveBundleFrameIso hE hfin hV (he.restrictLE hVU)).hom ≫
              projectiveSpaceOverSchemeMap n (X.homOfLE hVU))

include he hψ in
/-- **The frame chart.** Let `e_0, …, e_n` be a frame of `E` over `U` and `ψ : π⁻¹(U) ≅ ℙⁿ_U` the
corresponding isomorphism. Then `ψ^* 𝒪_{ℙⁿ_U}(1) ≅ M|_{π⁻¹(U)}` by an isomorphism carrying each
coordinate `ψ^* x_i` to the image of `π^* e_i` under the quotient `π^* E ⟶ M`. -/
theorem exists_frameChart_iso :
    ∃ b : (Scheme.Modules.pullback ψ.hom).obj (projectiveSpaceTwistingSheaf n U 1) ≅
        (Scheme.Modules.pullback (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι).obj M,
      ∀ i, b.hom.app ⊤ (pullbackGlobalSection ψ.hom (projectiveSpaceCoordinate n U i)) =
        pullbackSectionTop (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι
          (Scheme.Opens.ι_preimage_self _).ge
          ((tautQuotientOf hE hfin M α hα).app _
            (pullbackSection (projectiveBundleProj hE hfin) (e ⟨i⟩))) := by
  let T : Fin (n + 1) → Γ(M, projectiveBundleProj hE hfin ⁻¹ᵁ U) := fun i =>
    (tautQuotientOf hE hfin M α hα).app _ (pullbackSection (projectiveBundleProj hE hfin) (e ⟨i⟩))
  have hPeq :
      (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι ''ᵁ ⊤ = projectiveBundleProj hE hfin ⁻¹ᵁ U := by
    rw [Scheme.Hom.image_top_eq_opensRange, Scheme.Opens.opensRange_ι]
  let s : Fin (n + 1) → Γ(M.restrict (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι, ⊤) := fun i =>
    (M.restrictAppIso (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι ⊤).inv
      (M.presheaf.map (homOfLE hPeq.le).op (T i))
  have hpiece : ∀ (V : X.Opens) (hV : IsAffineOpen V) (_ : V ≤ U),
      (symmetricGradedAlgebra hE hfin).projι (site hV) ''ᵁ ⊤ ≤
        (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι ''ᵁ ⊤ := fun V hV hVU =>
    ((symmetricGradedAlgebra hE hfin).projι_image_top_eq _).le.trans
      ((Scheme.Hom.preimage_mono _ hVU).trans hPeq.ge)
  have hs : ∀ i (V : X.Opens) (hV : IsAffineOpen V) (hVU : V ≤ U),
      M.presheaf.map (homOfLE (hpiece V hV hVU)).op
        ((M.restrictAppIso (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι ⊤).hom (s i)) =
        pieceSection hE hfin (e := e) M α hV hVU i := by
    intro i V hV hVU
    simp only [s, Iso.inv_hom_id_apply]
    rw [Scheme.Modules.map_map_homOfLE]
    apply (ConcreteCategory.bijective_of_isIso ((α (site hV)).hom.app ⊤)).1
    have hinv : ∀ x, (α (site hV)).hom.app ⊤ ((α (site hV)).inv.app ⊤ x) = x := fun x => by
      rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, Iso.inv_hom_id,
        Scheme.Modules.Hom.id_app]
      rfl
    rw [pieceSection]
    refine Eq.trans ?_ (hinv _).symm
    have hr : ((Scheme.Modules.pullback (projectiveBundleProj hE hfin)).obj E).presheaf.map
        (homOfLE ((hpiece V hV hVU).trans hPeq.le)).op
          (pullbackSection (projectiveBundleProj hE hfin) (e ⟨i⟩)) =
        ((Scheme.Modules.pullback (projectiveBundleProj hE hfin)).obj E).presheaf.map
          (homOfLE ((symmetricGradedAlgebra hE hfin).projι_image_top_le ⟨site hV, le_rfl⟩)).op
          (pullbackSection (projectiveBundleProj hE hfin)
            (E.presheaf.map (homOfLE hVU).op (e ⟨i⟩))) := by
      rw [pullbackSection_restrict]
      exact (Scheme.Modules.presheaf_map_map _ _ _ _ _).symm
    simp only [T]
    rw [← hom_app_map, hr, tautQuotientOf_piece]
    congr 1
    refine Subtype.ext ?_
    rw [symmetricPowerGradedSectionsMap_one_inv]
    exact (frameIntHom_X hE hfin hV (fun k => E.presheaf.map (homOfLE hVU).op (e k)) i).symm
  let W : ULift.{u} (Fin (n + 1)) → (projectiveBundleProj hE hfin ⁻¹ᵁ U).toScheme.Opens :=
    fun k => chartPreimage ψ.hom k.down
  have hW : ⊤ ≤ iSup W := by
    intro x _
    obtain ⟨k, hk⟩ := exists_mem_chartPreimage ψ.hom x
    exact Opens.mem_iSup.2 ⟨⟨k⟩, hk⟩
  have σ : PUnit.{u + 1} ≃ ULift.{u} (Fin 1) := Equiv.ofUnique _ _
  obtain ⟨φ₀, hφ⟩ := Ringed.exists_iso_of_frames
    (R := (projectiveBundleProj hE hfin ⁻¹ᵁ U).toScheme.sheaf) W hW
    (fun k => (pullbackTwist ψ.hom).presheaf.map (homOfLE le_top).op
      (pullbackGlobalSection ψ.hom (projectiveSpaceCoordinate n U k.down)))
    (fun k => (M.restrict (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι).presheaf.map
      (homOfLE le_top).op (s k.down))
    (fun k => (isLocalFrame_of_isTrivializingSection
      (isTrivializingSection_chartPreimage ψ.hom k.down)).reindex σ)
    (fun k => (isLocalFrame_of_isTrivializingSection
      (global_trivializing hE hfin he ψ hψ M α k.down (s k.down) (hs k.down))).reindex σ)
    (fun i j => ⟨_, restrict_inf_smul _ _ _
      (restrict_pullbackGlobalSection_eq_smul ψ.hom i.down j.down),
      restrict_inf_smul _ _ _ (global_transition hE hfin he ψ hψ M α s hs i.down j.down)⟩)
  let φ : pullbackTwist ψ.hom ≅ M.restrict (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι := φ₀
  have hφs : ∀ i, φ.hom.app ⊤
      (pullbackGlobalSection ψ.hom (projectiveSpaceCoordinate n U i)) = s i := by
    intro i
    refine TopCat.Presheaf.IsSheaf.section_ext (M.restrict _).isSheaf fun x _ => ?_
    obtain ⟨k, hk⟩ := exists_mem_chartPreimage ψ.hom x
    refine ⟨chartPreimage ψ.hom k, le_top, hk, ?_⟩
    rw [← hom_app_map, restrict_pullbackGlobalSection_eq_smul ψ.hom k i,
      Scheme.Modules.Hom.app_smul, global_transition hE hfin he ψ hψ M α s hs k i]
    congr 1
    exact hφ ⟨k⟩
  refine ⟨φ ≪≫ (Scheme.Modules.restrictFunctorIsoPullback _).app M, fun i => ?_⟩
  rw [Iso.trans_hom, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply]
  refine (congrArg _ (hφs i)).trans ?_
  exact restrictFunctorIsoPullback_hom_app_top _ M hPeq.le (T i)

end FrameChart


section Represent2

variable (M : (projectiveBundle hE hfin).Modules)
  (α : ∀ V, M.restrict ((symmetricGradedAlgebra hE hfin).projι V) ≅
    (symmetricGradedAlgebra hE hfin).twistingSheaf ((1 : ℕ) : ℤ) V)
  (hα : TwistCompatible M α)


/-- The quotient `g^* E ≅ φ^* π^* E ⟶ φ^* M` attached to `φ : Y ⟶ P(E)` over `X`. -/
abbrev quotientOfHom (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) :
    (Scheme.Modules.pullback g).obj E ⟶ (Scheme.Modules.pullback φ).obj M :=
  (pullbackObjIsoOfComp φ (projectiveBundleProj hE hfin) hφ E).hom ≫
    (Scheme.Modules.pullback φ).map (tautQuotientOf hE hfin M α hα)

/-- `φ : Y ⟶ P(E)` over `g` *represents* the quotient `q : g^* E ⟶ L` if some isomorphism
`φ^* M ≅ L` carries the quotient attached to `φ` to `q`. -/
def Represents (φ : Y ⟶ projectiveBundle hE hfin) (hφ : φ ≫ projectiveBundleProj hE hfin = g)
    {L : Y.Modules} (q : (Scheme.Modules.pullback g).obj E ⟶ L) : Prop :=
  ∃ d : (Scheme.Modules.pullback φ).obj M ≅ L, quotientOfHom hE hfin M α hα φ hφ ≫ d.hom = q

end Represent2

section RepresentLemmas

variable {M : (projectiveBundle hE hfin).Modules}
  {α : ∀ V, M.restrict ((symmetricGradedAlgebra hE hfin).projι V) ≅
    (symmetricGradedAlgebra hE hfin).twistingSheaf ((1 : ℕ) : ℤ) V}
  {hα : TwistCompatible M α}

/-- Representing is invariant under equality of morphisms. -/
theorem Represents.of_eq {φ φ' : Y ⟶ projectiveBundle hE hfin}
    {hφ : φ ≫ projectiveBundleProj hE hfin = g} (hφ' : φ' ≫ projectiveBundleProj hE hfin = g)
    (h : φ = φ') {L : Y.Modules} {q : (Scheme.Modules.pullback g).obj E ⟶ L}
    (hr : Represents hE hfin M α hα φ hφ q) : Represents hE hfin M α hα φ' hφ' q := by
  subst h
  exact hr

/-- Representing is invariant under isomorphisms of the target of the quotient. -/
theorem Represents.comp_iso {φ : Y ⟶ projectiveBundle hE hfin}
    {hφ : φ ≫ projectiveBundleProj hE hfin = g} {L L' : Y.Modules}
    {q : (Scheme.Modules.pullback g).obj E ⟶ L} (hr : Represents hE hfin M α hα φ hφ q)
    (d : L ≅ L') : Represents hE hfin M α hα φ hφ (q ≫ d.hom) := by
  obtain ⟨d₀, hd₀⟩ := hr
  exact ⟨d₀ ≪≫ d, by rw [Iso.trans_hom, ← Category.assoc, hd₀]⟩

/-- A morphism represents its own quotient. -/
theorem Represents.refl (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) :
    Represents hE hfin M α hα φ hφ (quotientOfHom hE hfin M α hα φ hφ) :=
  ⟨Iso.refl _, Category.comp_id _⟩

/-- **Pulling back a represented quotient.** If `φ` represents `q`, then `k ≫ φ` represents the
pullback `k^* q`. -/
theorem Represents.pullback {φ : Y ⟶ projectiveBundle hE hfin}
    {hφ : φ ≫ projectiveBundleProj hE hfin = g} {L : Y.Modules}
    {q : (Scheme.Modules.pullback g).obj E ⟶ L} (hr : Represents hE hfin M α hα φ hφ q)
    {W : Scheme.{u}} (k : W ⟶ Y) {g' : W ⟶ X} (hk : k ≫ g = g')
    (h' : (k ≫ φ) ≫ projectiveBundleProj hE hfin = g') :
    Represents hE hfin M α hα (k ≫ φ) h'
      ((pullbackObjIsoOfComp k g hk E).hom ≫ (Scheme.Modules.pullback k).map q) := by
  obtain ⟨d, hd⟩ := hr
  refine ⟨((Scheme.Modules.pullbackComp k φ).app M).symm ≪≫
    (Scheme.Modules.pullback k).mapIso d, ?_⟩
  have hc := pullbackObjIsoOfComp_hom_comp k φ (projectiveBundleProj hE hfin) hφ hk h'
    (tautQuotientOf hE hfin M α hα)
  simp only [quotientOfHom] at hd ⊢
  rw [← hc, ← hd]
  simp only [Iso.trans_hom, Iso.symm_hom, Iso.app_inv, Functor.mapIso_hom, Category.assoc,
    Functor.map_comp, Iso.hom_inv_id_app_assoc]

/-- **Representing is local.** If `V_i ≫ φ` represents the pullback of `q` to each member `V_i`
of an open cover of `Y`, then `φ` represents `q`. -/
theorem Represents.of_cover {φ : Y ⟶ projectiveBundle hE hfin}
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) {L : Y.Modules}
    (q : (Scheme.Modules.pullback g).obj E ⟶ L) [Epi q] {ι : Type u} (V : ι → Y.Opens)
    (hV : ∀ y, ∃ i, y ∈ V i)
    (h : ∀ i, Represents hE hfin M α hα ((V i).ι ≫ φ)
      (by rw [Category.assoc, hφ])
      ((pullbackObjIsoOfComp (V i).ι g rfl E).hom ≫ (Scheme.Modules.pullback (V i).ι).map q)) :
    Represents hE hfin M α hα φ hφ q := by
  refine exists_iso_comp_eq_of_pullback _ q V hV fun i => ?_
  obtain ⟨d₁, hd₁⟩ := (Represents.refl hE hfin φ hφ).pullback hE hfin (V i).ι rfl
    (by rw [Category.assoc, hφ])
  obtain ⟨d₂, hd₂⟩ := h i
  refine ⟨d₁.symm ≪≫ d₂, ?_⟩
  rw [← cancel_epi (pullbackObjIsoOfComp (V i).ι g rfl E).hom, ← hd₂, ← reassoc_of% hd₁]
  simp

end RepresentLemmas


section PullbackSectionTop

/-- Under `l^* ι^* N ≅ (l ≫ ι)^* N`, the section `l^* ι^* T` goes to `(l ≫ ι)^* T`. -/
theorem pullbackComp_hom_pullbackGlobalSection_pullbackSectionTop {Y Z P : Scheme.{u}}
    (l : Y ⟶ Z) (ι : Z ⟶ P) {N : P.Modules} {W : P.Opens} (hW : ⊤ ≤ ι ⁻¹ᵁ W) (T : Γ(N, W))
    (hW' : ⊤ ≤ (l ≫ ι) ⁻¹ᵁ W) :
    ((Scheme.Modules.pullbackComp l ι).hom.app N).app ⊤
        (pullbackGlobalSection l (pullbackSectionTop ι hW T)) =
      pullbackSectionTop (l ≫ ι) hW' T := by
  have e1 : pullbackGlobalSection l (pullbackSectionTop ι hW T) =
      ((Scheme.Modules.pullback l).obj ((Scheme.Modules.pullback ι).obj N)).presheaf.map
        (homOfLE (show ⊤ ≤ l ⁻¹ᵁ ι ⁻¹ᵁ W from hW')).op
        (pullbackSection l (pullbackSection ι T)) := by
    rw [pullbackGlobalSection, pullbackSectionTop, pullbackSection_restrict]
    exact Scheme.Modules.presheaf_map_map _ _ _ _ _
  have e2 := hom_app_map ((Scheme.Modules.pullbackComp l ι).hom.app N)
    (show ⊤ ≤ (l ≫ ι) ⁻¹ᵁ W from hW') (pullbackSection l (pullbackSection ι T))
  rw [e1]
  erw [e2]
  rw [pullbackSectionTop, pullbackSection_eq_unit, pullbackSection_eq_unit,
    pullbackSection_eq_unit]
  erw [Scheme.Modules.pullbackComp_hom_unit]

/-- The quotient attached to `φ` sends `g^* s` to `φ^* τ(π^* s)`, `τ : π^* E ⟶ M`. -/
theorem quotientOfHom_app_pullbackSectionTop {Y : Scheme.{u}} {g : Y ⟶ X}
    (M : (projectiveBundle hE hfin).Modules)
    (α : ∀ V, M.restrict ((symmetricGradedAlgebra hE hfin).projι V) ≅
      (symmetricGradedAlgebra hE hfin).twistingSheaf ((1 : ℕ) : ℤ) V)
    (hα : TwistCompatible M α) (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) {U : X.Opens} (hgU : ⊤ ≤ g ⁻¹ᵁ U)
    (s : Γ(E, U)) :
    (quotientOfHom hE hfin M α hα φ hφ).app ⊤ (pullbackSectionTop g hgU s) =
      pullbackSectionTop φ (by subst hφ; exact hgU)
        ((tautQuotientOf hE hfin M α hα).app _
          (pullbackSection (projectiveBundleProj hE hfin) s)) := by
  subst hφ
  have e1 : (pullbackObjIsoOfComp φ (projectiveBundleProj hE hfin) rfl E).hom.app ⊤
      (pullbackSectionTop (φ ≫ projectiveBundleProj hE hfin) hgU s) =
      ((Scheme.Modules.pullback φ).obj ((Scheme.Modules.pullback
        (projectiveBundleProj hE hfin)).obj E)).presheaf.map
        (homOfLE (show ⊤ ≤ φ ⁻¹ᵁ projectiveBundleProj hE hfin ⁻¹ᵁ U from hgU)).op
        (pullbackSection φ (pullbackSection (projectiveBundleProj hE hfin) s)) := by
    rw [pullbackSectionTop, hom_app_map, pullbackObjIsoOfComp_hom_pullbackSection]
    rfl
  have e2 : ((Scheme.Modules.pullback φ).map (tautQuotientOf hE hfin M α hα)).app ⊤
      (((Scheme.Modules.pullback φ).obj ((Scheme.Modules.pullback
        (projectiveBundleProj hE hfin)).obj E)).presheaf.map
        (homOfLE (show ⊤ ≤ φ ⁻¹ᵁ projectiveBundleProj hE hfin ⁻¹ᵁ U from hgU)).op
        (pullbackSection φ (pullbackSection (projectiveBundleProj hE hfin) s))) =
      pullbackSectionTop φ (show ⊤ ≤ φ ⁻¹ᵁ projectiveBundleProj hE hfin ⁻¹ᵁ U from hgU)
        ((tautQuotientOf hE hfin M α hα).app _
          (pullbackSection (projectiveBundleProj hE hfin) s)) := by
    rw [hom_app_map, pullbackSectionTop, pullbackSection_eq_unit, pullbackSection_eq_unit,
      Scheme.Modules.pullback_map_unit]
    rfl
  dsimp only [quotientOfHom]
  rw [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply, e1, e2]

end PullbackSectionTop

section Local

variable {M : (projectiveBundle hE hfin).Modules}
  {α : ∀ V, M.restrict ((symmetricGradedAlgebra hE hfin).projι V) ≅
    (symmetricGradedAlgebra hE hfin).twistingSheaf ((1 : ℕ) : ℤ) V}
  (hα : TwistCompatible M α)
  {U : X.Opens} {n : ℕ} {e : ULift.{u} (Fin (n + 1)) → Γ(E, U)}
  (he : Ringed.IsLocalFrame (R := X.sheaf) E U e)
  (ψ : (projectiveBundleProj hE hfin ⁻¹ᵁ U).toScheme ≅ projectiveSpaceOverScheme n U)
  (hψ₁ : ψ.hom ≫ projectiveSpaceOverSchemeProjection n U = projectiveBundleProj hE hfin ∣_ U)
  (b : (Scheme.Modules.pullback ψ.hom).obj (projectiveSpaceTwistingSheaf n U 1) ≅
    (Scheme.Modules.pullback (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι).obj M)
  (hb : ∀ i, b.hom.app ⊤ (pullbackGlobalSection ψ.hom (projectiveSpaceCoordinate n U i)) =
    pullbackSectionTop (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι
      (Scheme.Opens.ι_preimage_self _).ge
      ((tautQuotientOf hE hfin M α hα).app _
        (pullbackSection (projectiveBundleProj hE hfin) (e ⟨i⟩))))

include hb in
/-- For `χ : Y ⟶ ℙⁿ_U` and `φ : Y ⟶ π⁻¹(U) ≅ ℙⁿ_U ⊆ P(E)` the corresponding morphism, the
isomorphism `χ^* 𝒪(1) ≅ φ^* M` carries `χ^* x_i` to `φ^* τ(π^* e_i)`. -/
theorem exists_iso_pullback_chart (χ : Y ⟶ projectiveSpaceOverScheme n U)
    (φ : Y ⟶ projectiveBundle hE hfin)
    (hχ : (χ ≫ ψ.inv) ≫ (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι = φ) :
    ∃ c : (Scheme.Modules.pullback χ).obj (projectiveSpaceTwistingSheaf n U 1) ≅
        (Scheme.Modules.pullback φ).obj M,
      ∀ i, c.hom.app ⊤ (pullbackGlobalSection χ (projectiveSpaceCoordinate n U i)) =
        pullbackSectionTop φ (by
          subst hχ
          rw [Scheme.Hom.comp_preimage, Scheme.Opens.ι_preimage_self, Scheme.Hom.preimage_top])
          ((tautQuotientOf hE hfin M α hα).app _
            (pullbackSection (projectiveBundleProj hE hfin) (e ⟨i⟩))) := by
  subst hχ
  obtain ⟨c₁, hc₁⟩ := exists_iso_of_comp_all (χ ≫ ψ.inv) ψ.hom (ψ := χ) (by simp) b
  refine ⟨c₁ ≪≫ (Scheme.Modules.pullbackComp _ _).app M, fun i => ?_⟩
  rw [Iso.trans_hom, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply, hc₁, hb,
    Iso.app_hom]
  exact pullbackComp_hom_pullbackGlobalSection_pullbackSectionTop _ _ _ _ _

variable (hM : M.IsInvertible) (hgU : ⊤ ≤ g ⁻¹ᵁ U)

omit [IsNoetherian X] in
include hgU in
/-- A morphism whose preimage of `U` is everything factors set-theoretically through `U`. -/
theorem range_subset_of_le_preimage : Set.range g ⊆ Set.range U.ι := by
  rintro _ ⟨y, rfl⟩
  rw [Scheme.Opens.range_ι]
  exact hgU (show y ∈ (⊤ : Y.Opens) from trivial)

include hb hψ₁ hM hgU he in
/-- **Local uniqueness.** Over an open `U` on which `E` has a frame, two morphisms `Y ⟶ P(E)`
over `g : Y ⟶ U ⊆ X` representing the same quotient coincide. -/
theorem eq_of_represents_local {φ φ' : Y ⟶ projectiveBundle hE hfin}
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) (hφ' : φ' ≫ projectiveBundleProj hE hfin = g)
    {L : Y.Modules} {q : (Scheme.Modules.pullback g).obj E ⟶ L}
    (h₁ : Represents hE hfin M α hα φ hφ q) (h₂ : Represents hE hfin M α hα φ' hφ' q) :
    φ = φ' := by
  have hr : ∀ {φ₀ : Y ⟶ projectiveBundle hE hfin}, φ₀ ≫ projectiveBundleProj hE hfin = g →
      Set.range φ₀ ⊆ Set.range (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι := by
    rintro φ₀ rfl _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hgU (show y ∈ (⊤ : Y.Opens) from trivial)
  let gU := IsOpenImmersion.lift U.ι g (range_subset_of_le_preimage hgU)
  have hgU' : gU ≫ U.ι = g := IsOpenImmersion.lift_fac _ _ _
  let l := IsOpenImmersion.lift (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι φ (hr hφ)
  let l' := IsOpenImmersion.lift (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι φ' (hr hφ')
  have hl : l ≫ (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι = φ := IsOpenImmersion.lift_fac _ _ _
  have hl' : l' ≫ (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι = φ' := IsOpenImmersion.lift_fac _ _ _
  have hproj : ∀ (l₀ : Y ⟶ (projectiveBundleProj hE hfin ⁻¹ᵁ U).toScheme),
      l₀ ≫ (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι ≫ projectiveBundleProj hE hfin = g →
      (l₀ ≫ ψ.hom) ≫ projectiveSpaceOverSchemeProjection n U = gU := by
    intro l₀ h₀
    rw [← cancel_mono U.ι, Category.assoc, Category.assoc, reassoc_of% hψ₁, morphismRestrict_ι, h₀,
      hgU']
  -- the frame of `g^* E` over `Y` and the sections it gives
  have hfr := (Ringed.IsLocalFrame.pullback (φ := g.toRingCatSheafHom) he).restrictLE hgU
  let s : Fin (n + 1) → Γ((Scheme.Modules.pullback φ).obj M, ⊤) := fun i =>
    (quotientOfHom hE hfin M α hα φ hφ).app ⊤ (pullbackSectionTop g hgU (e ⟨i⟩))
  have hgen : ((Scheme.Modules.pullback φ).obj M).IsGeneratedBySections
      (fun i : ULift.{u} (Fin (n + 1)) => s i.down) :=
    isGeneratedBySections_of_epi_of_isLocalFrame_top hfr _
  obtain ⟨χ₀, -, huniq⟩ := existsUnique_morphism_of_isGeneratedBySections gU
    (IsInvertible.pullback φ hM) s hgen
  have key : ∀ (l₀ : Y ⟶ (projectiveBundleProj hE hfin ⁻¹ᵁ U).toScheme)
      (φ₀ : Y ⟶ projectiveBundle hE hfin) (hl₀ : l₀ ≫ (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι = φ₀)
      (hφ₀ : φ₀ ≫ projectiveBundleProj hE hfin = g) (d : (Scheme.Modules.pullback φ₀).obj M ≅
        (Scheme.Modules.pullback φ).obj M)
      (hd : ∀ i, d.hom.app ⊤ ((quotientOfHom hE hfin M α hα φ₀ hφ₀).app ⊤
        (pullbackSectionTop g hgU (e ⟨i⟩))) = s i),
      l₀ ≫ ψ.hom = χ₀ := by
    intro l₀ φ₀ hl₀ hφ₀ d hd
    refine huniq _ ⟨hproj l₀ (by rw [reassoc_of% hl₀, hφ₀]), ?_⟩
    obtain ⟨c, hc⟩ := exists_iso_pullback_chart hE hfin hα ψ b hb (l₀ ≫ ψ.hom) φ₀
      (by simp [hl₀])
    refine ⟨c ≪≫ d, fun i => ?_⟩
    rw [Iso.trans_hom, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply, hc, ← hd i,
      quotientOfHom_app_pullbackSectionTop]
  obtain ⟨d, hd⟩ := h₁
  obtain ⟨d', hd'⟩ := h₂
  have e₁ := key l φ hl hφ (Iso.refl _) (fun i => rfl)
  have h1 : quotientOfHom hE hfin M α hα φ' hφ' ≫ d'.hom ≫ d.inv =
      quotientOfHom hE hfin M α hα φ hφ := by
    rw [← Category.assoc, hd', ← hd, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have e₂ := key l' φ' hl' hφ' (d' ≪≫ d.symm) (fun i => by
    have := congrArg (fun f => Scheme.Modules.Hom.app f ⊤ (pullbackSectionTop g hgU (e ⟨i⟩))) h1
    simp only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply] at this
    simpa only [Iso.trans_hom, Iso.symm_hom, Scheme.Modules.Hom.comp_app,
      ConcreteCategory.comp_apply, s] using this)
  rw [← hl, ← hl']
  congr 1
  rw [← cancel_mono ψ.hom, e₁, e₂]

include hb hψ₁ he hgU in
/-- **Local existence.** Over an open `U` on which `E` has a frame, every invertible quotient of
`g^* E`, for `g : Y ⟶ U ⊆ X`, is represented by a morphism `Y ⟶ P(E)` over `g`. -/
theorem exists_represents_local {L : Y.Modules} (hL : L.IsInvertible)
    (q : (Scheme.Modules.pullback g).obj E ⟶ L) [Epi q] :
    ∃ (φ : Y ⟶ projectiveBundle hE hfin) (hφ : φ ≫ projectiveBundleProj hE hfin = g),
      Represents hE hfin M α hα φ hφ q := by
  let gU := IsOpenImmersion.lift U.ι g (range_subset_of_le_preimage hgU)
  have hgU' : gU ≫ U.ι = g := IsOpenImmersion.lift_fac _ _ _
  have hfr := (Ringed.IsLocalFrame.pullback (φ := g.toRingCatSheafHom) he).restrictLE hgU
  let s : Fin (n + 1) → Γ(L, ⊤) := fun i => q.app ⊤ (pullbackSectionTop g hgU (e ⟨i⟩))
  have hgen : L.IsGeneratedBySections (fun i : ULift.{u} (Fin (n + 1)) => s i.down) :=
    isGeneratedBySections_of_epi_of_isLocalFrame_top hfr q
  obtain ⟨χ, ⟨hχ, c₀, hc₀⟩, -⟩ := existsUnique_morphism_of_isGeneratedBySections gU hL s hgen
  let φ := (χ ≫ ψ.inv) ≫ (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι
  have hφ : φ ≫ projectiveBundleProj hE hfin = g := by
    have : ψ.inv ≫ (projectiveBundleProj hE hfin ⁻¹ᵁ U).ι ≫ projectiveBundleProj hE hfin =
        projectiveSpaceOverSchemeProjection n U ≫ U.ι := by
      rw [← morphismRestrict_ι, ← hψ₁]
      simp
    rw [← hgU', ← hχ]
    simp only [φ, Category.assoc, this]
  obtain ⟨c, hc⟩ := exists_iso_pullback_chart hE hfin hα ψ b hb χ φ rfl
  refine ⟨φ, hφ, c.symm ≪≫ c₀, hom_ext_of_isLocalFrame_top hfr fun i => ?_⟩
  change _ = s i.down
  rw [← hc₀ i.down, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply, Iso.trans_hom,
    Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply]
  congr 1
  rw [Iso.symm_hom]
  apply (ConcreteCategory.bijective_of_isIso (c.hom.app ⊤)).1
  rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, Iso.inv_hom_id,
    Scheme.Modules.Hom.id_app, hc]
  exact quotientOfHom_app_pullbackSectionTop hE hfin M α hα φ hφ hgU (e i)

end Local


section Global

variable {M : (projectiveBundle hE hfin).Modules}
  {α : ∀ V, M.restrict ((symmetricGradedAlgebra hE hfin).projι V) ≅
    (symmetricGradedAlgebra hE hfin).twistingSheaf ((1 : ℕ) : ℤ) V}
  (hα : TwistCompatible M α) (hM : M.IsInvertible)

omit [IsNoetherian X] in
include hE hfin in
/-- `E` has frames of finite rank near every point. -/
theorem exists_isLocalFrame_fin (x : X) : ∃ (U : X.Opens) (r : ℕ)
    (e : ULift.{u} (Fin r) → Γ(E, U)), x ∈ U ∧ Ringed.IsLocalFrame (R := X.sheaf) E U e := by
  classical
  obtain ⟨U, hxU, r, ⟨β⟩⟩ := (isFiniteLocallyFree_iff E).mpr ⟨hE, hfin⟩ x
  exact ⟨U, r, _, hxU, Ringed.isLocalFrame_of_over_iso β⟩

omit [IsNoetherian X] in
/-- Over an open on which `E` has the empty frame, `g^* E` has no invertible quotient unless
`Y` is empty. -/
theorem isEmpty_of_isLocalFrame_zero {U : X.Opens} {e : ULift.{u} (Fin 0) → Γ(E, U)}
    (he : Ringed.IsLocalFrame (R := X.sheaf) E U e) (hgU : ⊤ ≤ g ⁻¹ᵁ U) {L : Y.Modules}
    (hL : L.IsInvertible) (q : (Scheme.Modules.pullback g).obj E ⟶ L) [Epi q] : IsEmpty Y :=
  isEmpty_of_isInvertible_of_isGeneratedBySections hL
    (isGeneratedBySections_of_epi_of_isLocalFrame_top
      ((Ringed.IsLocalFrame.pullback (φ := g.toRingCatSheafHom) he).restrictLE hgU) q)

include hM in
/-- **Uniqueness** (Hartshorne II, Proposition 7.12): two morphisms `Y ⟶ P(E)` over `g` which
represent the same quotient of `g^* E` coincide. -/
theorem eq_of_represents {φ φ' : Y ⟶ projectiveBundle hE hfin}
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) (hφ' : φ' ≫ projectiveBundleProj hE hfin = g)
    {L : Y.Modules} {q : (Scheme.Modules.pullback g).obj E ⟶ L}
    (h₁ : Represents hE hfin M α hα φ hφ q) (h₂ : Represents hE hfin M α hα φ' hφ' q) :
    φ = φ' := by
  refine hom_ext_of_forall _ _ fun y => ?_
  obtain ⟨U, r, e, hyU, he⟩ := exists_isLocalFrame_fin hE hfin (g y)
  refine ⟨g ⁻¹ᵁ U, hyU, ?_⟩
  have hgV : ⊤ ≤ ((g ⁻¹ᵁ U).ι ≫ g) ⁻¹ᵁ U := (Scheme.Opens.ι_preimage_self _).ge
  have r₁ := h₁.pullback hE hfin (g ⁻¹ᵁ U).ι rfl (by rw [Category.assoc, hφ])
  have r₂ := h₂.pullback hE hfin (g ⁻¹ᵁ U).ι rfl (by rw [Category.assoc, hφ'])
  cases r with
  | zero =>
    have := isEmpty_of_isLocalFrame_zero he hgV (hM.pullback ((g ⁻¹ᵁ U).ι ≫ φ))
      (quotientOfHom hE hfin M α hα ((g ⁻¹ᵁ U).ι ≫ φ) (by rw [Category.assoc, hφ]))
    exact isInitialOfIsEmpty.hom_ext _ _
  | succ n =>
    obtain ⟨ψ, hψ₁, hψ⟩ := exists_projectiveBundleIso_of_frame hE hfin he
    obtain ⟨b, hb⟩ := exists_frameChart_iso hE hfin M hα he ψ hψ
    exact eq_of_represents_local hE hfin hα he ψ hψ₁ b hb hM hgV _ _ r₁ r₂

/-- Existence over an open on which `E` has a frame, for a nonempty `Y`. -/
theorem exists_represents_of_isLocalFrame {U : X.Opens} {r : ℕ}
    {e : ULift.{u} (Fin r) → Γ(E, U)} (he : Ringed.IsLocalFrame (R := X.sheaf) E U e)
    [Nonempty Y] (hgU : ⊤ ≤ g ⁻¹ᵁ U) {L : Y.Modules} (hL : L.IsInvertible)
    (q : (Scheme.Modules.pullback g).obj E ⟶ L) [Epi q] :
    ∃ (φ : Y ⟶ projectiveBundle hE hfin) (hφ : φ ≫ projectiveBundleProj hE hfin = g),
      Represents hE hfin M α hα φ hφ q := by
  cases r with
  | zero =>
    have := isEmpty_of_isLocalFrame_zero he hgU hL q
    exact (IsEmpty.false (Classical.arbitrary Y)).elim
  | succ n =>
    obtain ⟨ψ, hψ₁, hψ⟩ := exists_projectiveBundleIso_of_frame hE hfin he
    obtain ⟨b, hb⟩ := exists_frameChart_iso hE hfin M hα he ψ hψ
    exact exists_represents_local hE hfin hα he ψ hψ₁ b hb hgU hL q

omit [IsNoetherian X] in
/-- Compatibility of `pullbackObjIsoOfComp` with equality of morphisms. -/
theorem pullbackObjIsoOfComp_hom_congr {W : Scheme.{u}} {m m' : W ⟶ Y} (hm : m = m')
    {g' : W ⟶ X} (h : m ≫ g = g') (h' : m' ≫ g = g') {L : Y.Modules}
    (q : (Scheme.Modules.pullback g).obj E ⟶ L) :
    (pullbackObjIsoOfComp m g h E).hom ≫ (Scheme.Modules.pullback m).map q ≫
        (Scheme.Modules.pullbackCongr hm).hom.app L =
      (pullbackObjIsoOfComp m' g h' E).hom ≫ (Scheme.Modules.pullback m').map q := by
  subst hm
  simp [Scheme.Modules.pullbackCongr]

include hM in
/-- **Existence** (Hartshorne II, Proposition 7.12): every invertible quotient `g^* E ⟶ L` is
represented by a morphism `Y ⟶ P(E)` over `g`. -/
theorem exists_represents {L : Y.Modules} (hL : L.IsInvertible)
    (q : (Scheme.Modules.pullback g).obj E ⟶ L) [Epi q] :
    ∃ (φ : Y ⟶ projectiveBundle hE hfin) (hφ : φ ≫ projectiveBundleProj hE hfin = g),
      Represents hE hfin M α hα φ hφ q := by
  choose U r e hyU he using fun y : Y => exists_isLocalFrame_fin hE hfin (g y)
  let V : Y → Y.Opens := fun y => g ⁻¹ᵁ U y
  have hloc : ∀ y, ∃ (φ : (V y).toScheme ⟶ projectiveBundle hE hfin)
      (hφ : φ ≫ projectiveBundleProj hE hfin = (V y).ι ≫ g),
      Represents hE hfin M α hα φ hφ
        ((pullbackObjIsoOfComp (V y).ι g rfl E).hom ≫ (Scheme.Modules.pullback (V y).ι).map q) :=
    fun y => by
      have : Nonempty (V y).toScheme := ⟨⟨y, hyU y⟩⟩
      exact exists_represents_of_isLocalFrame hE hfin hα (he y)
        (Scheme.Opens.ι_preimage_self (V y)).ge (hL.pullback _) _
  choose φ hφ hrep using hloc
  let 𝒰 : Y.OpenCover :=
    { I₀ := Y
      X y := V y
      f y := (V y).ι
      mem₀ := by
        rw [presieve₀_mem_precoverage_iff]
        refine ⟨fun y => ⟨y, by rw [Scheme.Opens.range_ι]; exact hyU y⟩, inferInstance⟩ }
  have hcompat : ∀ y z, pullback.fst (𝒰.f y) (𝒰.f z) ≫ φ y = pullback.snd _ _ ≫ φ z := by
    intro y z
    have hc : pullback.fst (𝒰.f y) (𝒰.f z) ≫ (V y).ι = pullback.snd (𝒰.f y) (𝒰.f z) ≫ (V z).ι :=
      pullback.condition
    have hk₂ : pullback.snd (𝒰.f y) (𝒰.f z) ≫ (V z).ι ≫ g =
        pullback.fst (𝒰.f y) (𝒰.f z) ≫ (V y).ι ≫ g := by
      rw [← Category.assoc, ← hc, Category.assoc]
    have r₁ := (hrep y).pullback hE hfin (pullback.fst (𝒰.f y) (𝒰.f z))
      (g' := pullback.fst (𝒰.f y) (𝒰.f z) ≫ (V y).ι ≫ g) rfl
      ((Category.assoc _ _ _).trans (congrArg _ (hφ y)))
    have r₂ := (hrep z).pullback hE hfin (pullback.snd (𝒰.f y) (𝒰.f z))
      (g' := pullback.fst (𝒰.f y) (𝒰.f z) ≫ (V y).ι ≫ g)
      hk₂ ((Category.assoc _ _ _).trans ((congrArg _ (hφ z)).trans hk₂))
    have r₁' := r₁.comp_iso hE hfin
      ((Scheme.Modules.pullbackComp (pullback.fst (𝒰.f y) (𝒰.f z)) (V y).ι).app L ≪≫
        (Scheme.Modules.pullbackCongr hc).app L)
    have r₂' := r₂.comp_iso hE hfin
      ((Scheme.Modules.pullbackComp (pullback.snd (𝒰.f y) (𝒰.f z)) (V z).ι).app L)
    have h₀ : (pullback.snd (𝒰.f y) (𝒰.f z) ≫ (V z).ι) ≫ g =
        pullback.fst (𝒰.f y) (𝒰.f z) ≫ (V y).ι ≫ g := by
      rw [Category.assoc, hk₂]
    have eq₁ := pullbackObjIsoOfComp_hom_comp (pullback.fst (𝒰.f y) (𝒰.f z)) (V y).ι g rfl rfl
      ((Category.assoc _ _ _).trans rfl) q
    have eq₂ := pullbackObjIsoOfComp_hom_comp (pullback.snd (𝒰.f y) (𝒰.f z)) (V z).ι g rfl hk₂
      h₀ q
    have eq₃ := pullbackObjIsoOfComp_hom_congr hc ((Category.assoc _ _ _).trans rfl) h₀ q
    have r₁'' : Represents hE hfin M α hα (pullback.fst (𝒰.f y) (𝒰.f z) ≫ φ y)
        ((Category.assoc _ _ _).trans (congrArg _ (hφ y)))
        ((pullbackObjIsoOfComp (pullback.snd (𝒰.f y) (𝒰.f z) ≫ (V z).ι) g h₀ E).hom ≫
          (Scheme.Modules.pullback (pullback.snd (𝒰.f y) (𝒰.f z) ≫ (V z).ι)).map q) := by
      rw [← eq₃, ← reassoc_of% eq₁]
      simpa only [Iso.trans_hom, Iso.app_hom, Category.assoc] using r₁'
    have r₂'' : Represents hE hfin M α hα (pullback.snd (𝒰.f y) (𝒰.f z) ≫ φ z)
        ((Category.assoc _ _ _).trans ((congrArg _ (hφ z)).trans hk₂))
        ((pullbackObjIsoOfComp (pullback.snd (𝒰.f y) (𝒰.f z) ≫ (V z).ι) g h₀ E).hom ≫
          (Scheme.Modules.pullback (pullback.snd (𝒰.f y) (𝒰.f z) ≫ (V z).ι)).map q) := by
      rw [← eq₂]
      simpa only [Iso.app_hom, Category.assoc] using r₂'
    exact eq_of_represents hE hfin hα hM _ _ r₁'' r₂''
  refine ⟨𝒰.glueMorphisms φ hcompat, ?_, ?_⟩
  · refine 𝒰.hom_ext _ _ fun y => ?_
    rw [← Category.assoc, 𝒰.ι_glueMorphisms φ hcompat y]
    exact hφ y
  · exact Represents.of_cover hE hfin _ q V (fun y => ⟨y, hyU y⟩) fun y =>
      (hrep y).of_eq hE hfin _ (𝒰.ι_glueMorphisms φ hcompat y).symm

end Global



/-! ### Proposition 7.12 and Exercise 7.8 -/

section Main

/-- The invertible quotient attached to `φ` is equivalent to `a` exactly when `φ` represents `a`. -/
theorem projectiveBundleInvertibleQuotientOfHom_equiv_iff (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) (a : InvertibleQuotient ((pullback g).obj E)) :
    InvertibleQuotient.Equiv (projectiveBundleInvertibleQuotientOfHom hE hfin φ hφ) a ↔
      Represents hE hfin (projectiveBundleTwistingSheaf hE hfin 1) (twistOneRestrictIso hE hfin)
        (twistCompatible_one hE hfin) φ hφ a.quotient :=
  Iff.rfl

/-- `𝒪_{P(E)}(1)` is invertible. -/
theorem isInvertible_projectiveBundleTwistingSheaf_one :
    (projectiveBundleTwistingSheaf hE hfin 1).IsInvertible :=
  isInvertible_relTwistingSheaf _ 1 (symmetricRelativeProjData hE hfin).generated

/-- **Quotients give morphisms** (Hartshorne II, Proposition 7.12): for `g : Y ⟶ X`, every
invertible quotient `g^* E ⟶ L` is, up to isomorphism of `L`, the pullback
`g^* E ≅ φ^* π^* E ⟶ φ^* 𝒪(1)` of the tautological quotient along a morphism `φ : Y ⟶ P(E)` with
`π ∘ φ = g`. -/
theorem projectiveBundle_exists_hom_of_invertibleQuotient
    (a : InvertibleQuotient ((Scheme.Modules.pullback g).obj E)) :
    ∃ (φ : Y ⟶ projectiveBundle hE hfin) (hφ : φ ≫ projectiveBundleProj hE hfin = g),
      InvertibleQuotient.Equiv (projectiveBundleInvertibleQuotientOfHom hE hfin φ hφ) a := by
  have := a.epi
  obtain ⟨φ, hφ, h⟩ := exists_represents hE hfin (twistCompatible_one hE hfin)
    (isInvertible_projectiveBundleTwistingSheaf_one hE hfin) a.isInvertible a.quotient
  exact ⟨φ, hφ, (projectiveBundleInvertibleQuotientOfHom_equiv_iff hE hfin φ hφ a).2 h⟩

/-- **The morphism is unique** (Hartshorne II, Proposition 7.12): two morphisms `Y ⟶ P(E)` over
`X` whose invertible quotients of `g^* E` are equivalent coincide. -/
theorem projectiveBundle_hom_eq_of_equiv {φ φ' : Y ⟶ projectiveBundle hE hfin}
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) (hφ' : φ' ≫ projectiveBundleProj hE hfin = g)
    (h : InvertibleQuotient.Equiv (projectiveBundleInvertibleQuotientOfHom hE hfin φ hφ)
      (projectiveBundleInvertibleQuotientOfHom hE hfin φ' hφ')) : φ = φ' :=
  eq_of_represents hE hfin (twistCompatible_one hE hfin)
    (isInvertible_projectiveBundleTwistingSheaf_one hE hfin) hφ hφ'
    ((projectiveBundleInvertibleQuotientOfHom_equiv_iff hE hfin φ hφ _).1 h)
    (Represents.refl hE hfin φ' hφ')

variable (g) in
/-- **The functor of points of `P(E)`** (Hartshorne II, Proposition 7.12): for `g : Y ⟶ X`,
morphisms `φ : Y ⟶ P(E)` over `X` correspond bijectively to invertible quotients `g^* E ⟶ L`
modulo isomorphisms of `L` intertwining the quotient maps. The quotient attached to `φ` is the
pullback `g^* E ≅ φ^* π^* E ⟶ φ^* 𝒪(1)` of the tautological quotient. -/
def projectiveBundleHomEquiv :
    {φ : Y ⟶ projectiveBundle hE hfin // φ ≫ projectiveBundleProj hE hfin = g} ≃
      Quotient (InvertibleQuotient.setoid ((Scheme.Modules.pullback g).obj E)) :=
  Equiv.ofBijective (fun φ => ⟦projectiveBundleInvertibleQuotientOfHom hE hfin φ.1 φ.2⟧)
    ⟨fun φ φ' h => Subtype.ext (projectiveBundle_hom_eq_of_equiv hE hfin φ.2 φ'.2
      (Quotient.exact h)),
    fun a => Quotient.inductionOn a fun a => by
      obtain ⟨φ, hφ, h⟩ := projectiveBundle_exists_hom_of_invertibleQuotient hE hfin a
      exact ⟨⟨φ, hφ⟩, Quotient.sound h⟩⟩

/-- The bijection sends `φ` to the class of its invertible quotient. -/
theorem projectiveBundleHomEquiv_apply (φ : Y ⟶ projectiveBundle hE hfin)
    (hφ : φ ≫ projectiveBundleProj hE hfin = g) :
    projectiveBundleHomEquiv hE hfin g ⟨φ, hφ⟩ =
      ⟦projectiveBundleInvertibleQuotientOfHom hE hfin φ hφ⟧ :=
  rfl

end Main

/-- An invertible quotient of `F'` gives one of `F` along an isomorphism `F ≅ F'`. -/
def InvertibleQuotient.ofIso {Z : Scheme.{u}} {F F' : Z.Modules} (e : F ≅ F')
    (a : InvertibleQuotient F') : InvertibleQuotient F where
  sheaf := a.sheaf
  isInvertible := a.isInvertible
  quotient := e.hom ≫ a.quotient
  epi := by have := a.epi; exact epi_comp _ _

/-- Invertible quotients of isomorphic modules correspond, compatibly with equivalence. -/
def InvertibleQuotient.quotientEquivOfIso {Z : Scheme.{u}} {F F' : Z.Modules} (e : F ≅ F') :
    Quotient (InvertibleQuotient.setoid F') ≃ Quotient (InvertibleQuotient.setoid F) :=
  Quotient.congr
    { toFun := InvertibleQuotient.ofIso e
      invFun := InvertibleQuotient.ofIso e.symm
      left_inv := fun a => by
        cases a
        simp [InvertibleQuotient.ofIso]
      right_inv := fun a => by
        cases a
        simp [InvertibleQuotient.ofIso] }
    fun a b => ⟨fun ⟨d, hd⟩ => ⟨d, by
        change (e.hom ≫ a.quotient) ≫ d.hom = e.hom ≫ b.quotient
        rw [Category.assoc, hd]⟩,
      fun ⟨d, hd⟩ => ⟨d, by
        have hd' : (e.hom ≫ a.quotient) ≫ d.hom = e.hom ≫ b.quotient := hd
        rw [Category.assoc, cancel_epi] at hd'
        exact hd'⟩⟩

/-- **Sections of a projective bundle** (Hartshorne II, Exercise 7.8, the case `Y = X` of
Proposition 7.12): sections of `π : P(E) ⟶ X` correspond bijectively to invertible quotients
`E ⟶ L` modulo isomorphisms of `L` intertwining the quotient maps. -/
def projectiveBundleSectionEquiv :
    {s : X ⟶ projectiveBundle hE hfin // s ≫ projectiveBundleProj hE hfin = 𝟙 X} ≃
      Quotient (InvertibleQuotient.setoid E) :=
  (projectiveBundleHomEquiv hE hfin (𝟙 X)).trans
    (InvertibleQuotient.quotientEquivOfIso ((Scheme.Modules.pullbackId X).app E).symm)

end AlgebraicGeometry.Scheme.Modules
