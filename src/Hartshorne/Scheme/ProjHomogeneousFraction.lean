import Hartshorne.Scheme.AffineLineClassGroup
import Hartshorne.Scheme.ProjGradedModuleSheafChart

/-!
# Divisors of homogeneous fractions on Proj of a graded domain

Let `S` be a graded integral domain with `X = Proj S` integral. For homogeneous `g, h ∈ S_d` with
`h ≠ 0`, the rational function `g / h` on `X` is the element `g / h` of the homogeneous
localization `S_((0))`, the stalk of `X` at its generic point
(`Hartshorne.projHomogeneousFraction`).

For `f ∈ S_1` nonzero, pulling back along the chart `Spec S_(f) ≅ D₊(f) ⊆ X` sends `g / h` to
the dehomogenized fraction `(g / f^d) / (h / f^d)` of `Frac S_(f)`
(`Hartshorne.genericFunctionFieldMap_projChartι_projHomogeneousFraction`). Consequently, when `X`
satisfies `(*)`, the order of `g / h` along a prime divisor `Y` meeting `D₊(f)` is
`v_𝔭(g / f^d) - v_𝔭(h / f^d)`, for `𝔭 ⊂ S_(f)` the height-one prime of `Y ∩ D₊(f)`
(`Hartshorne.ord_projHomogeneousFraction`).

These are project bridges used for Proposition II.6.4 and Example II.6.6.1 of Hartshorne.
-/

universe u

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace Hartshorne

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace HomogeneousLocalization Order

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- The coordinate ring `S_(f)` of the chart `D₊(f)` of `Proj S`. -/
def projChart (f : A) : CommRingCat.{u} := CommRingCat.of (Away 𝒜 f)

/-- If `S` is generated by `S_1` (so that `S_+ ⊆ (S_1)`), every point of `Proj S` lies in a chart
`D₊(f)` with `f ∈ S_1`, `f ≠ 0`. -/
theorem exists_mem_basicOpen_of_irrelevant_le_span
    (hgen : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span ((𝒜 1 : σ) : Set A))
    (x : Proj 𝒜) : ∃ f ∈ 𝒜 1, f ≠ 0 ∧ x ∈ Proj.basicOpen 𝒜 f := by
  by_contra hcon
  push Not at hcon
  refine x.not_irrelevant_le (hgen.trans ((Ideal.span_le).mpr fun a ha ↦ ?_))
  by_cases ha0 : a = 0
  · rw [ha0]
    exact zero_mem _
  · exact not_not.mp (hcon a ha ha0)

section Domain

variable [IsDomain A]

/-- For a graded domain `S` and `f ≠ 0`, the degree-zero part `S_(f)` of `S_f` is a domain. -/
theorem isDomain_projChart {f : A} (hf0 : f ≠ 0) : IsDomain (projChart 𝒜 f) := by
  have : IsDomain (Localization.Away f) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hf0)
  exact Function.Injective.isDomain (algebraMap (Away 𝒜 f) (Localization.Away f))
    (HomogeneousLocalization.val_injective _)

private instance proj_isPrime (x : Proj 𝒜) : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime

/-- The point `(0)` of `Proj S`, for a graded domain `S` whose `Proj` is nonempty. -/
def projBotPoint (x : Proj 𝒜) : Proj 𝒜 :=
  ⟨⊥, Ideal.isPrime_bot, fun h ↦ x.not_irrelevant_le (h.trans bot_le)⟩

/-- If `Proj S` is irreducible, its generic point is the prime `(0)` of the graded domain `S`. -/
theorem genericPoint_proj_asIdeal_eq_bot [IrreducibleSpace (Proj 𝒜)] :
    (genericPoint (Proj 𝒜)).asHomogeneousIdeal.toIdeal = ⊥ := by
  obtain ⟨x⟩ : Nonempty (Proj 𝒜) := inferInstance
  have hgen : IsGenericPoint (projBotPoint 𝒜 x) Set.univ := by
    refine isGenericPoint_iff_specializes.mpr fun y ↦ ⟨fun _ ↦ trivial, fun _ ↦ ?_⟩
    rw [specializes_iff_mem_closure]
    exact (ProjectiveSpectrum.le_iff_mem_closure 𝒜 _ y).mp
      (bot_le : (⊥ : HomogeneousIdeal 𝒜) ≤ y.asHomogeneousIdeal)
  rw [(genericPoint_spec (Proj 𝒜)).eq hgen]
  rfl

theorem notMem_genericPoint_proj [IrreducibleSpace (Proj 𝒜)] {h : A} (h0 : h ≠ 0) :
    h ∈ (genericPoint (Proj 𝒜)).asHomogeneousIdeal.toIdeal.primeCompl := by
  intro hm
  rw [genericPoint_proj_asIdeal_eq_bot] at hm
  exact h0 ((Submodule.mem_bot _).mp hm)

theorem genericPoint_mem_proj_basicOpen [IrreducibleSpace (Proj 𝒜)] {h : A} (h0 : h ≠ 0) :
    genericPoint (Proj 𝒜) ∈ Proj.basicOpen 𝒜 h :=
  notMem_genericPoint_proj 𝒜 h0

/-- **The rational function `g / h`.** For homogeneous `g, h ∈ S_d` with `h ≠ 0`, the element
`g / h` of the stalk `S_((0))` of `Proj S` at its generic point. -/
def projHomogeneousFraction [IsIntegral (Proj 𝒜)] {g h : A} {d : ℕ} (hg : g ∈ 𝒜 d)
    (hh : h ∈ 𝒜 d) (h0 : h ≠ 0) : (Proj 𝒜).functionField :=
  (Proj.stalkIso 𝒜 (genericPoint (Proj 𝒜))).inv
    (HomogeneousLocalization.mk ⟨d, ⟨g, hg⟩, ⟨h, hh⟩, notMem_genericPoint_proj 𝒜 h0⟩)

theorem projHomogeneousFraction_eq_of_mul_eq [IsIntegral (Proj 𝒜)] {g h g' h' : A} {d d' : ℕ}
    (hg : g ∈ 𝒜 d) (hh : h ∈ 𝒜 d) (h0 : h ≠ 0) (hg' : g' ∈ 𝒜 d') (hh' : h' ∈ 𝒜 d')
    (h0' : h' ≠ 0) (H : g * h' = g' * h) :
    projHomogeneousFraction 𝒜 hg hh h0 = projHomogeneousFraction 𝒜 hg' hh' h0' := by
  rw [projHomogeneousFraction, projHomogeneousFraction]
  congr 1
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  exact ⟨1, by simp only [OneMemClass.coe_one, one_mul]; linear_combination H⟩

theorem projHomogeneousFraction_mul [IsIntegral (Proj 𝒜)] {g h g' h' : A} {d d' : ℕ}
    (hg : g ∈ 𝒜 d) (hh : h ∈ 𝒜 d) (h0 : h ≠ 0) (hg' : g' ∈ 𝒜 d') (hh' : h' ∈ 𝒜 d')
    (h0' : h' ≠ 0) :
    projHomogeneousFraction 𝒜 hg hh h0 * projHomogeneousFraction 𝒜 hg' hh' h0' =
      projHomogeneousFraction 𝒜 (SetLike.mul_mem_graded hg hg')
        (SetLike.mul_mem_graded hh hh') (mul_ne_zero h0 h0') := by
  rw [projHomogeneousFraction, projHomogeneousFraction, projHomogeneousFraction, ← map_mul]
  rfl

theorem projHomogeneousFraction_self [IsIntegral (Proj 𝒜)] {h : A} {d : ℕ} (hh : h ∈ 𝒜 d)
    (h0 : h ≠ 0) : projHomogeneousFraction 𝒜 hh hh h0 = 1 := by
  rw [projHomogeneousFraction, ← map_one (Proj.stalkIso 𝒜 (genericPoint (Proj 𝒜))).inv.hom]
  congr 1
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_one]
  exact Localization.mk_self ⟨h, notMem_genericPoint_proj 𝒜 h0⟩

theorem projHomogeneousFraction_ne_zero [IsIntegral (Proj 𝒜)] {g h : A} {d : ℕ} (hg : g ∈ 𝒜 d)
    (hh : h ∈ 𝒜 d) (h0 : h ≠ 0) (g0 : g ≠ 0) : projHomogeneousFraction 𝒜 hg hh h0 ≠ 0 := by
  have hmul := projHomogeneousFraction_mul 𝒜 hg hh h0 hh hg g0
  rw [projHomogeneousFraction_eq_of_mul_eq 𝒜 (SetLike.mul_mem_graded hg hh)
    (SetLike.mul_mem_graded hh hg) (mul_ne_zero h0 g0) hh hh h0 (by ring),
    projHomogeneousFraction_self] at hmul
  exact left_ne_zero_of_mul_eq_one hmul

/-- The germ at the generic point of the section `g / h` of `D₊(h)` is `g / h`. -/
theorem germ_awayToSection_mk [IsIntegral (Proj 𝒜)] {g h : A} {d : ℕ} (hg : g ∈ 𝒜 d)
    (hh : h ∈ 𝒜 d) (h0 : h ≠ 0) :
    (Proj 𝒜).presheaf.germ _ _ (genericPoint_mem_proj_basicOpen 𝒜 h0)
        (Proj.awayToSection 𝒜 h (HomogeneousLocalization.mk ⟨d, ⟨g, hg⟩, ⟨h, hh⟩, ⟨1, pow_one h⟩⟩)) =
      projHomogeneousFraction 𝒜 hg hh h0 :=
  congr($(ProjectiveSpectrum.Proj.awayToSection_germ 𝒜 h (genericPoint (Proj 𝒜))
    (genericPoint_mem_proj_basicOpen 𝒜 h0))
    (HomogeneousLocalization.mk ⟨d, ⟨g, hg⟩, ⟨h, hh⟩, ⟨1, pow_one h⟩⟩))

end Domain

section Chart

variable {f : A} {m : ℕ} (f_deg : f ∈ 𝒜 m) (hm : 0 < m)

/-- The chart `Spec S_(f) ≅ D₊(f) ⊆ Proj S`, as an open immersion. -/
abbrev projChartι : Spec (projChart 𝒜 f) ⟶ Proj 𝒜 := Proj.awayι 𝒜 f f_deg hm

instance projChartι_isOpenImmersion : IsOpenImmersion (projChartι 𝒜 f_deg hm) :=
  inferInstanceAs (IsOpenImmersion (Proj.awayι 𝒜 f f_deg hm))

theorem projChartι_base_mem (y : Spec (projChart 𝒜 f)) :
    (projChartι 𝒜 f_deg hm).base y ∈ Proj.basicOpen 𝒜 f := by
  rw [← Proj.opensRange_awayι 𝒜 f f_deg hm]
  exact ⟨y, rfl⟩

/-- The chart `Spec S_(f) → Proj S` sends the generic point to the generic point. -/
theorem projChartι_genericPoint [IrreducibleSpace (Proj 𝒜)]
    [IrreducibleSpace (Spec (projChart 𝒜 f))] :
    (projChartι 𝒜 f_deg hm).base (genericPoint _) = genericPoint (Proj 𝒜) :=
  genericPoint_eq_of_isOpenImmersion _

variable [IsIntegral (Proj 𝒜)] [IsDomain (projChart 𝒜 f)]

set_option backward.isDefEq.respectTransparency false in
/-- Pulling back along the chart `Spec S_(f) → Proj S` sends the germ of the section `r` of
`D₊(f)` to `r ∈ Frac S_(f)`. -/
theorem genericFunctionFieldMap_projChartι_germ (r : Away 𝒜 f)
    (hη : genericPoint (Proj 𝒜) ∈ Proj.basicOpen 𝒜 f) :
    (projChartι 𝒜 f_deg hm).genericFunctionFieldMap (projChartι_genericPoint 𝒜 f_deg hm)
      ((Proj 𝒜).presheaf.germ _ _ hη (Proj.awayToSection 𝒜 f r)) =
      algebraMap (projChart 𝒜 f) (Spec (projChart 𝒜 f)).functionField r := by
  set ι := projChartι 𝒜 f_deg hm
  set η' := genericPoint (Spec (projChart 𝒜 f))
  have hx : ι.base η' ∈ Proj.basicOpen 𝒜 f := projChartι_base_mem 𝒜 f_deg hm η'
  have : Nonempty (Proj.basicOpen 𝒜 f) := ⟨⟨_, hη⟩⟩
  have e1 := Scheme.algebraMap_germ_eq_germToFunctionField (X := Proj 𝒜) hx
    (Proj.awayToSection 𝒜 f r)
  change _ = (Proj 𝒜).presheaf.germ _ _ hη _ at e1
  rw [← e1, Scheme.Hom.genericFunctionFieldMap_algebraMap, Scheme.Hom.germ_stalkMap_apply]
  have key : (Spec (projChart 𝒜 f)).presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ _ ≤ ⊤)).op
      ((Scheme.ΓSpecIso _).inv r) = ι.app (Proj.basicOpen 𝒜 f) (Proj.awayToSection 𝒜 f r) := by
    have h0 := congrArg ((Proj.awayι 𝒜 f f_deg hm).appIso ⊤).hom
      (ProjGradedModuleSheaf.awayι_appIso_inv_top 𝒜 f_deg hm r)
    rw [Iso.inv_hom_id_apply, Scheme.Hom.appIso_hom', ← ConcreteCategory.comp_apply,
      Scheme.Hom.map_appLE] at h0
    erw [h0]
    have hcomp : (Proj.awayι 𝒜 f f_deg hm).appLE (Proj.basicOpen 𝒜 f) ⊤
          (fun y _ ↦ projChartι_base_mem 𝒜 f_deg hm y) ≫
        (Spec (CommRingCat.of (Away 𝒜 f))).presheaf.map
          (homOfLE (le_top : (Proj.awayι 𝒜 f f_deg hm) ⁻¹ᵁ Proj.basicOpen 𝒜 f ≤ ⊤)).op =
        (Proj.awayι 𝒜 f f_deg hm).app (Proj.basicOpen 𝒜 f) := by
      rw [Scheme.Hom.appLE_map, Scheme.Hom.appLE_eq_app]
    exact ConcreteCategory.congr_hom hcomp _
  rw [← key, TopCat.Presheaf.germ_res_apply]
  erw [Scheme.ΓSpecIso_inv, StructureSheaf.algebraMap_germ_apply]
  exact spec_algebraMap_stalk_toStalk _ _

end Chart

section Dehomogenization

variable {f : A} (hf : f ∈ 𝒜 1)

include hf in
theorem pow_mem_graded_one (d : ℕ) : f ^ d ∈ 𝒜 d := by
  simpa using SetLike.pow_mem_graded d hf

/-- The dehomogenization `a / f^d ∈ S_(f)` of a homogeneous `a ∈ S_d`, for `f ∈ S_1`. -/
def projDehom {a : A} {d : ℕ} (ha : a ∈ 𝒜 d) : Away 𝒜 f :=
  HomogeneousLocalization.mk ⟨d, ⟨a, ha⟩, ⟨f ^ d, pow_mem_graded_one 𝒜 hf d⟩, ⟨d, rfl⟩⟩

theorem projDehom_ne_zero [IsDomain A] (hf0 : f ≠ 0) {a : A} {d : ℕ} (ha : a ∈ 𝒜 d)
    (ha0 : a ≠ 0) : projDehom 𝒜 hf ha ≠ 0 := by
  intro hz
  have := congrArg HomogeneousLocalization.val hz
  rw [projDehom, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_zero,
    Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at this
  obtain ⟨⟨c, n, rfl⟩, hc⟩ := this
  exact ha0 ((mul_eq_zero.mp hc).resolve_left (pow_ne_zero n hf0))

/-- The germ at the generic point of `a / f^d`, viewed as a section over `D₊(f)`, is the element
`a / f^d` of `S_((0))`. -/
theorem germ_awayToSection_projDehom [IsDomain A] [IsIntegral (Proj 𝒜)] (hf0 : f ≠ 0) {a : A}
    {d : ℕ} (ha : a ∈ 𝒜 d) :
    (Proj 𝒜).presheaf.germ _ _ (genericPoint_mem_proj_basicOpen 𝒜 hf0)
        (Proj.awayToSection 𝒜 f (projDehom 𝒜 hf ha)) =
      (Proj.stalkIso 𝒜 (genericPoint (Proj 𝒜))).inv
        (HomogeneousLocalization.mk ⟨d, ⟨a, ha⟩, ⟨f ^ d, pow_mem_graded_one 𝒜 hf d⟩,
          notMem_genericPoint_proj 𝒜 (pow_ne_zero d hf0)⟩) :=
  congr($(ProjectiveSpectrum.Proj.awayToSection_germ 𝒜 f (genericPoint (Proj 𝒜))
    (genericPoint_mem_proj_basicOpen 𝒜 hf0)) (projDehom 𝒜 hf ha))

/-- `g / h` times `h / f^d` is `g / f^d` in the function field. -/
theorem projHomogeneousFraction_mul_germ [IsDomain A] [IsIntegral (Proj 𝒜)] (hf0 : f ≠ 0)
    {g h : A} {d : ℕ} (hg : g ∈ 𝒜 d) (hh : h ∈ 𝒜 d) (h0 : h ≠ 0) :
    projHomogeneousFraction 𝒜 hg hh h0 *
        (Proj 𝒜).presheaf.germ _ _ (genericPoint_mem_proj_basicOpen 𝒜 hf0)
          (Proj.awayToSection 𝒜 f (projDehom 𝒜 hf hh)) =
      (Proj 𝒜).presheaf.germ _ _ (genericPoint_mem_proj_basicOpen 𝒜 hf0)
        (Proj.awayToSection 𝒜 f (projDehom 𝒜 hf hg)) := by
  rw [germ_awayToSection_projDehom 𝒜 hf hf0, germ_awayToSection_projDehom 𝒜 hf hf0,
    projHomogeneousFraction,
    ← map_mul]
  congr 1
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_mk,
    HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk, Localization.mk_mul,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul]; ring⟩

end Dehomogenization

section Order

variable [IsDomain A] [IsIntegral (Proj 𝒜)] {f : A} (hf : f ∈ 𝒜 1) (hf0 : f ≠ 0)

/-- The chart identifies function fields: pulling back along `Spec S_(f) ≅ D₊(f)` is an
isomorphism `K(Proj S) ≅ K(Spec S_(f)) = Frac S_(f)`. -/
theorem genericFunctionFieldMap_projChartι_bijective :
    let _ : IsDomain (projChart 𝒜 f) := isDomain_projChart 𝒜 hf0
    Function.Bijective ((projChartι 𝒜 hf Nat.one_pos).genericFunctionFieldMap
      (projChartι_genericPoint 𝒜 hf Nat.one_pos)) := by
  intro _
  exact ⟨((projChartι 𝒜 hf Nat.one_pos).genericFunctionFieldMap _).hom.injective,
    Scheme.Hom.genericFunctionFieldMap_surjective_of_isOpenImmersion _ _⟩

/-- **Homogeneous fractions on a chart.** For `f ∈ S_1` nonzero, pulling the rational function
`g / h` back along the chart `Spec S_(f) ≅ D₊(f)` gives the dehomogenized fraction
`(g / f^d) / (h / f^d)` of `Frac S_(f)`. -/
theorem genericFunctionFieldMap_projChartι_projHomogeneousFraction {g h : A} {d : ℕ}
    (hg : g ∈ 𝒜 d) (hh : h ∈ 𝒜 d) (h0 : h ≠ 0) :
    let _ : IsDomain (projChart 𝒜 f) := isDomain_projChart 𝒜 hf0
    (projChartι 𝒜 hf Nat.one_pos).genericFunctionFieldMap
        (projChartι_genericPoint 𝒜 hf Nat.one_pos) (projHomogeneousFraction 𝒜 hg hh h0) =
      algebraMap (projChart 𝒜 f) (Spec (projChart 𝒜 f)).functionField (projDehom 𝒜 hf hg) /
        algebraMap (projChart 𝒜 f) (Spec (projChart 𝒜 f)).functionField (projDehom 𝒜 hf hh) := by
  intro _
  have hb : algebraMap (projChart 𝒜 f) (Spec (projChart 𝒜 f)).functionField
      (projDehom 𝒜 hf hh) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero (projDehom_ne_zero 𝒜 hf hf0 hh h0))
  have key := congrArg ((projChartι 𝒜 hf Nat.one_pos).genericFunctionFieldMap
    (projChartι_genericPoint 𝒜 hf Nat.one_pos)) (projHomogeneousFraction_mul_germ 𝒜 hf hf0 hg hh h0)
  rw [map_mul, genericFunctionFieldMap_projChartι_germ, genericFunctionFieldMap_projChartι_germ]
    at key
  exact eq_div_of_mul_eq hb key

omit [IsDomain A] [IsIntegral (Proj 𝒜)] in
/-- The chart ring `S_(f)` of a locally Noetherian `Proj S` is Noetherian. -/
theorem isNoetherianRing_projChart [IsLocallyNoetherian (Proj 𝒜)] {m : ℕ} (f_deg : f ∈ 𝒜 m)
    (hm : 0 < m) : IsNoetherianRing (projChart 𝒜 f) :=
  isLocallyNoetherian_Spec.mp (isLocallyNoetherian_of_isOpenImmersion (projChartι 𝒜 f_deg hm))

/-- **Order of a homogeneous fraction along a prime divisor, on a chart.** Let `Proj S` satisfy
`(*)`, let `f ∈ S_1` be nonzero and let `Y` be a prime divisor of `Proj S` meeting `D₊(f)`, the
image of the point `𝔭` of `Spec S_(f)`. For nonzero homogeneous `g, h ∈ S_d`,
`v_Y(g / h) = v_𝔭(g / f^d) - v_𝔭(h / f^d)`. -/
theorem ord_projHomogeneousFraction [IsNoetherian (Proj 𝒜)]
    (hX : (Proj 𝒜).SatisfiesConditionStar) {g h : A} {d : ℕ} (hg : g ∈ 𝒜 d) (hh : h ∈ 𝒜 d)
    (g0 : g ≠ 0) (h0 : h ≠ 0) {y : Spec (projChart 𝒜 f)}
    (hy : coheight ((projChartι 𝒜 hf Nat.one_pos).base y) = 1) :
    let _ : IsDomain (projChart 𝒜 f) := isDomain_projChart 𝒜 hf0
    let _ : IsNoetherianRing (projChart 𝒜 f) := isNoetherianRing_projChart 𝒜 hf Nat.one_pos
    (Proj 𝒜).ord (projHomogeneousFraction 𝒜 hg hh h0) ((projChartι 𝒜 hf Nat.one_pos).base y) =
      (Spec (projChart 𝒜 f)).ord
          (algebraMap (projChart 𝒜 f) (Spec (projChart 𝒜 f)).functionField (projDehom 𝒜 hf hg)) y -
        (Spec (projChart 𝒜 f)).ord
          (algebraMap (projChart 𝒜 f) (Spec (projChart 𝒜 f)).functionField
            (projDehom 𝒜 hf hh)) y := by
  intro _ _
  have hchart : (Spec (projChart 𝒜 f)).SatisfiesConditionStar :=
    ⟨inferInstance, inferInstance, inferInstance,
      hX.isRegularInCodimensionOne.of_isOpenImmersion (projChartι 𝒜 hf Nat.one_pos)⟩
  have hy' : coheight y = 1 := by rwa [coheight_eq_of_isOpenImmersion] at hy
  have ha : algebraMap (projChart 𝒜 f) (Spec (projChart 𝒜 f)).functionField
      (projDehom 𝒜 hf hg) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero (projDehom_ne_zero 𝒜 hf hf0 hg g0))
  have hb : algebraMap (projChart 𝒜 f) (Spec (projChart 𝒜 f)).functionField
      (projDehom 𝒜 hf hh) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero (projDehom_ne_zero 𝒜 hf hf0 hh h0))
  rw [← Scheme.ord_genericFunctionFieldMap hchart hX (projChartι 𝒜 hf Nat.one_pos)
    (projChartι_genericPoint 𝒜 hf Nat.one_pos) hy' hy
    ((projChartι 𝒜 hf Nat.one_pos).map_maximalIdeal_stalkMap_of_isOpenImmersion y),
    genericFunctionFieldMap_projChartι_projHomogeneousFraction 𝒜 hf hf0 hg hh h0,
