import Hartshorne.Scheme.SerreGlobalGeneration

/-!
# Morphisms to projective space from generated invertible sheaves

Hartshorne, *Algebraic Geometry*, II, Theorem 7.1 (pp. 150–151).

Let `Y` be a scheme and `X` a `Y`-scheme. (Hartshorne takes `Y = Spec A`.)

* (a) For a morphism `φ : X ⟶ ℙⁿ_Y`, the sheaf `φ^* 𝒪(1)` is invertible and is generated by
  the global sections `φ^* xᵢ`, `i = 0, …, n`.
* (b) Conversely, if `L` is invertible and is generated by global sections `s₀, …, sₙ`, there is
  a unique `Y`-morphism `φ : X ⟶ ℙⁿ_Y` with an isomorphism `φ^* 𝒪(1) ≅ L` carrying each
  `φ^* xᵢ` to `sᵢ`.

The coordinate section `xᵢ` of `𝒪(1)` on `ℙⁿ_Y = ℙⁿ_ℤ ×_ℤ Y` is the pullback of the degree-one
element `xᵢ` of `ℤ[x₀, …, xₙ]`, a global section of `𝒪(1)` on `ℙⁿ_ℤ`.

## Proof

On the preimage `Vₖ` of the chart `D₊(xₖ)`, the section `φ^* xₖ` trivializes `φ^* 𝒪(1)` and
`φ^* xₗ = φ^#(xₗ/xₖ) · φ^* xₖ`. This gives (a), and it shows that a morphism `φ` as in (b) has
`Vₖ = X_{sₖ}` (the nonvanishing locus of `sₖ`) and `φ^#(xₗ/xₖ) = sₗ/sₖ` there; a morphism into
`ℙⁿ` is determined by these data, which gives uniqueness. For existence, as in the book, the ring
map `xₗ/xₖ ↦ sₗ/sₖ` defines morphisms `X_{sₖ} ⟶ D₊(xₖ)` which glue, and the isomorphism
`φ^* 𝒪(1) ≅ L` is glued from the local isomorphisms `φ^* xₖ ↦ sₖ`.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry
  HomogeneousLocalization MvPolynomial

namespace Hartshorne

attribute [local instance] MvPolynomial.gradedAlgebra

/-! ### Coordinate sections -/

section Coordinates

variable (n : ℕ)

/-- The coordinate `xᵢ`, a global section of `𝒪(1)` on `ℙⁿ_ℤ = Proj ℤ[x₀, …, xₙ]`. -/
def projectiveSpaceIntCoordinate (i : Fin (n + 1)) :
    Γ(projectiveSpaceIntTwistingSheaf.{u} n 1, ⊤) :=
  ProjTwistingSheaf.degreeOneSection ⟨MvPolynomial.X i, X_mem_homogeneousSubmodule_one _ i⟩

/-- The projection `ℙⁿ_Y = ℙⁿ_ℤ ×_ℤ Y ⟶ ℙⁿ_ℤ`. -/
abbrev projectiveSpaceToInt (Y : Scheme.{u}) :
    projectiveSpaceOverScheme n Y ⟶ projectiveSpaceScheme (ULift.{u} ℤ) n :=
  pullback.fst (projectiveSpaceOverIntegersMap n) (schemeToSpecZ Y)

/-- The pullback `φ^* e ∈ Γ(X, φ^* N)` of a global section `e` of an `𝒪_Y`-module `N`. -/
def pullbackGlobalSection {X Y : Scheme.{u}} (φ : X ⟶ Y) {N : Y.Modules} (e : Γ(N, ⊤)) :
    Γ((Scheme.Modules.pullback φ).obj N, ⊤) :=
  ((Scheme.Modules.pullback φ).obj N).presheaf.map
    (homOfLE (Scheme.Hom.preimage_top φ).ge).op (pullbackSection φ e)

/-- Restricting `φ^* e` to `φ⁻¹ W` is `φ^*` of the restriction of `e` to `W`. -/
theorem pullbackGlobalSection_restrict {X Y : Scheme.{u}} (φ : X ⟶ Y) {N : Y.Modules}
    (e : Γ(N, ⊤)) (W : Y.Opens) :
    ((Scheme.Modules.pullback φ).obj N).presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ W ≤ ⊤)).op
        (pullbackGlobalSection φ e) =
      pullbackSection φ (N.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op e) := by
  rw [pullbackSection_restrict, pullbackGlobalSection, Scheme.Modules.map_map_homOfLE]

/-- The coordinate `xᵢ`, a global section of `𝒪(1)` on `ℙⁿ_Y`: the pullback of the coordinate
`xᵢ` on `ℙⁿ_ℤ`. -/
def projectiveSpaceCoordinate (Y : Scheme.{u}) (i : Fin (n + 1)) :
    Γ(projectiveSpaceTwistingSheaf n Y 1, ⊤) :=
  pullbackGlobalSection (projectiveSpaceToInt n Y) (projectiveSpaceIntCoordinate n i)

end Coordinates

/-! ### The pulled-back twisting sheaf on the preimages of the charts -/

section Charts

variable {n : ℕ} {S Y : Scheme.{u}} (φ : S ⟶ projectiveSpaceOverScheme n Y)

/-- `ℙⁿ_ℤ`, as `Proj ℤ[x₀, …, xₙ]`. -/
abbrev projInt (n : ℕ) : Scheme.{u} := Proj (GeneratedProj.intGrading.{u} n)

/-- `𝒪(1)` on `ℙⁿ_ℤ`. -/
abbrev twistInt (n : ℕ) : (projInt.{u} n).Modules :=
  projTwistingSheaf (GeneratedProj.intGrading.{u} n) 1

/-- The coordinate chart `D₊(xₖ)` of `ℙⁿ_ℤ`. -/
abbrev chartInt (n : ℕ) (k : Fin (n + 1)) : (projInt.{u} n).Opens :=
  Proj.basicOpen (GeneratedProj.intGrading.{u} n) (MvPolynomial.X k)

/-- The global section `xₖ` of `𝒪(1)` on `ℙⁿ_ℤ`. -/
abbrev coordInt (n : ℕ) (k : Fin (n + 1)) : Γ(twistInt.{u} n, ⊤) :=
  ProjTwistingSheaf.degreeOneSection ⟨MvPolynomial.X k, X_mem_homogeneousSubmodule_one _ k⟩

/-- The ratio `xₗ/xₖ` as a section over `D₊(xₖ)`. -/
abbrev ratioInt (n : ℕ) (k l : Fin (n + 1)) : Γ(projInt.{u} n, chartInt n k) :=
  Proj.awayToSection _ (MvPolynomial.X k) (chartRatio (ULift.{u} ℤ) k l)

/-- The projection `ℙⁿ_Y ⟶ ℙⁿ_ℤ`, with target written as `Proj`. -/
abbrev toProjInt (n : ℕ) (Y : Scheme.{u}) : projectiveSpaceOverScheme n Y ⟶ projInt.{u} n :=
  pullback.fst (projectiveSpaceOverIntegersMap n) (schemeToSpecZ Y)

/-- The morphism `S ⟶ ℙⁿ_ℤ` underlying `φ : S ⟶ ℙⁿ_Y`. -/
abbrev toIntMap : S ⟶ projInt.{u} n :=
  φ ≫ toProjInt n Y

/-- The preimage `Vₖ = φ⁻¹(D₊(xₖ))` of the `k`-th standard chart. -/
abbrev chartPreimage (k : Fin (n + 1)) : S.Opens :=
  toIntMap φ ⁻¹ᵁ chartInt n k

/-- The pulled-back twisting sheaf `φ^* 𝒪(1)`. -/
abbrev pullbackTwist : S.Modules :=
  (Scheme.Modules.pullback φ).obj ((Scheme.Modules.pullback (toProjInt n Y)).obj (twistInt n))

theorem pullbackTwist_eq :
    pullbackTwist φ = (Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf n Y 1) := rfl

/-- The section `φ^* (pr^* e)` over `φ⁻¹(pr⁻¹ W)`, for a section `e` of `𝒪(1)` on `ℙⁿ_ℤ`. -/
abbrev chartSection {W : (projInt.{u} n).Opens} (e : Γ(twistInt.{u} n, W)) :
    Γ(pullbackTwist φ, toIntMap φ ⁻¹ᵁ W) :=
  pullbackSection φ (pullbackSection (toProjInt n Y) e)

theorem chartSection_restrict {W W' : (projInt.{u} n).Opens} (i : W' ≤ W)
    (e : Γ(twistInt.{u} n, W)) :
    (pullbackTwist φ).presheaf.map (homOfLE ((Opens.map (toIntMap φ).base).monotone i)).op
        (chartSection φ e) =
      chartSection φ ((twistInt.{u} n).presheaf.map (homOfLE i).op e) := by
  simp only [chartSection]
  rw [pullbackSection_restrict (toProjInt n Y), pullbackSection_restrict φ]
  rfl

theorem chartSection_smul {W : (projInt.{u} n).Opens} (r : Γ(projInt.{u} n, W))
    (e : Γ(twistInt.{u} n, W)) :
    chartSection φ (r • e) = (toIntMap φ).app W r • chartSection φ e := by
  simp only [chartSection]
  rw [pullbackSection_smul (toProjInt n Y), pullbackSection_smul φ]
  rfl

/-- The global section `φ^* xᵢ` restricted to `φ⁻¹(pr⁻¹ W)` is `chartSection` of `xᵢ|_W`. -/
theorem pullbackGlobalSection_coordinate_restrict (W : (projInt.{u} n).Opens)
    (i : Fin (n + 1)) :
    (pullbackTwist φ).presheaf.map (homOfLE (le_top : toIntMap φ ⁻¹ᵁ W ≤ ⊤)).op
        (pullbackGlobalSection φ (projectiveSpaceCoordinate n Y i)) =
      chartSection φ ((twistInt.{u} n).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op
        (coordInt n i)) := by
  change ((Scheme.Modules.pullback φ).obj _).presheaf.map
      (homOfLE (le_top : φ ⁻¹ᵁ (toProjInt n Y ⁻¹ᵁ W) ≤ ⊤)).op
      (pullbackGlobalSection φ (pullbackGlobalSection (toProjInt n Y) (coordInt n i))) = _
  rw [pullbackGlobalSection_restrict, pullbackGlobalSection_restrict]

/-- On `Vₖ = φ⁻¹(D₊(xₖ))`, the section `φ^* xₖ` trivializes `φ^* 𝒪(1)`. -/
theorem isTrivializingSection_chartPreimage (k : Fin (n + 1)) :
    IsTrivializingSection (pullbackTwist φ) (chartPreimage φ k)
      ((pullbackTwist φ).presheaf.map (homOfLE le_top).op
        (pullbackGlobalSection φ (projectiveSpaceCoordinate n Y k))) := by
  rw [pullbackGlobalSection_coordinate_restrict]
  exact IsTrivializingSection.pullback φ (IsTrivializingSection.pullback (toProjInt n Y)
    (IsTrivializingSection.of_isLocalFrame (ι := PUnit.{u + 1})
      (ProjTwistingSheaf.isLocalFrame_degreeOneSection (X_mem_homogeneousSubmodule_one _ k))))

/-- On `Vₖ = φ⁻¹(D₊(xₖ))`, `φ^* xₗ = φ^#(xₗ/xₖ) · φ^* xₖ`. -/
theorem restrict_pullbackGlobalSection_eq_smul (k l : Fin (n + 1)) :
    (pullbackTwist φ).presheaf.map (homOfLE le_top).op
        (pullbackGlobalSection φ (projectiveSpaceCoordinate n Y l)) =
      (toIntMap φ).app (chartInt n k) (ratioInt n k l) •
        (pullbackTwist φ).presheaf.map (homOfLE (le_top : chartPreimage φ k ≤ ⊤)).op
          (pullbackGlobalSection φ (projectiveSpaceCoordinate n Y k)) := by
  rw [pullbackGlobalSection_coordinate_restrict, pullbackGlobalSection_coordinate_restrict,
    ← chartSection_smul]
  congr 1
  exact ProjTwistingSheaf.restrict_degreeOneSection_eq_smul
    (X_mem_homogeneousSubmodule_one _ k) (X_mem_homogeneousSubmodule_one _ l)

/-- The preimages of the standard charts cover `S`. -/
theorem exists_mem_chartPreimage (x : S) : ∃ k, x ∈ chartPreimage φ k := by
  have hx : toIntMap φ x ∈ ⨆ j, chartInt.{u} n j := by
    rw [iSup_proj_basicOpen_X_eq_top]
    trivial
  obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  exact ⟨k, hk⟩

end Charts

/-! ### Sections of an invertible sheaf on their nonvanishing loci -/

section Nonvanishing

variable {X : Scheme.{u}}

/-- A morphism of `𝒪_X`-modules commutes with restriction of sections. -/
theorem hom_app_map {M N : X.Modules} (α : M ⟶ N) {U V : X.Opens} (h : V ≤ U) (t : Γ(M, U)) :
    α.app V (M.presheaf.map (homOfLE h).op t) = N.presheaf.map (homOfLE h).op (α.app U t) :=
  ConcreteCategory.congr_hom (α.mapPresheaf.naturality (homOfLE h).op) t

/-- A unit multiple of a trivializing section is trivializing. -/
theorem IsTrivializingSection.unit_smul {L : X.Modules} {U : X.Opens} {e : Γ(L, U)}
    (he : IsTrivializingSection L U e) {g : Γ(X, U)} (hg : IsUnit g) :
    IsTrivializingSection L U (g • e) := by
  intro V h
  have hgV : IsUnit (X.presheaf.map (homOfLE h).op g) := hg.map _
  have key : (fun a : Γ(X, V) => a • L.presheaf.map (homOfLE h).op (g • e)) =
      (fun a : Γ(X, V) => a • L.presheaf.map (homOfLE h).op e) ∘
        (fun a => a * X.presheaf.map (homOfLE h).op g) := by
    funext a
    simp only [Function.comp_apply, Scheme.Modules.map_smul, mul_smul]
  rw [key]
  refine (he V h).comp ⟨fun a b hab => hgV.mul_left_injective hab, fun b => ?_⟩
  exact ⟨b * ↑hgV.unit⁻¹, by simp [mul_assoc]⟩

/-- Being a trivializing section is a local property. -/
theorem IsTrivializingSection.of_local {L : X.Modules} {U : X.Opens} {e : Γ(L, U)}
    (h : ∀ x ∈ U, ∃ (W : X.Opens) (hW : W ≤ U), x ∈ W ∧
      IsTrivializingSection L W (L.presheaf.map (homOfLE hW).op e)) :
    IsTrivializingSection L U e := by
  choose W hWU hxW hW using h
  have hinj : ∀ (V : X.Opens) (hV : V ≤ U),
      Function.Injective (fun a : Γ(X, V) => a • L.presheaf.map (homOfLE hV).op e) := by
    intro V hV a b hab
    refine TopCat.Presheaf.section_ext X.sheaf V a b fun x hx => ?_
    have hVW : V ⊓ W x (hV hx) ≤ W x (hV hx) := inf_le_right
    have h1 := congrArg (L.presheaf.map (homOfLE (inf_le_left : V ⊓ W x (hV hx) ≤ V)).op) hab
    simp only [Scheme.Modules.map_smul, Scheme.Modules.map_map_homOfLE] at h1
    have h2 := (hW x (hV hx) _ hVW).1 (a₁ := X.presheaf.map
      (homOfLE (inf_le_left : V ⊓ W x (hV hx) ≤ V)).op a) (a₂ := X.presheaf.map
      (homOfLE (inf_le_left : V ⊓ W x (hV hx) ≤ V)).op b) (by
        simp only [Scheme.Modules.map_map_homOfLE]
        exact h1)
    have h3 := congrArg (X.presheaf.germ (V ⊓ W x (hV hx)) x ⟨hx, hxW x (hV hx)⟩) h2
    have e1 := TopCat.Presheaf.germ_res_apply X.presheaf
      (homOfLE (inf_le_left : V ⊓ W x (hV hx) ≤ V)) x ⟨hx, hxW x (hV hx)⟩ a
    have e2 := TopCat.Presheaf.germ_res_apply X.presheaf
      (homOfLE (inf_le_left : V ⊓ W x (hV hx) ≤ V)) x ⟨hx, hxW x (hV hx)⟩ b
    exact e1.symm.trans (h3.trans e2)
  intro V hV
  refine ⟨hinj V hV, fun t => ?_⟩
  -- local preimages
  have hloc : ∀ y : V, ∃ a : Γ(X, V ⊓ W y.1 (hV y.2)),
      a • L.presheaf.map (homOfLE ((inf_le_left : V ⊓ W y.1 (hV y.2) ≤ V).trans hV)).op e =
        L.presheaf.map (homOfLE (inf_le_left : V ⊓ W y.1 (hV y.2) ≤ V)).op t := by
    intro y
    obtain ⟨a, ha⟩ := (hW y.1 (hV y.2) _ (inf_le_right : V ⊓ W y.1 (hV y.2) ≤ _)).2
      (L.presheaf.map (homOfLE inf_le_left).op t)
    refine ⟨a, ?_⟩
    rw [← ha]
    simp only [Scheme.Modules.map_map_homOfLE]
  choose a ha using hloc
  obtain ⟨b, hb, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf
    (fun y : V => V ⊓ W y.1 (hV y.2)) V (fun y => homOfLE inf_le_left)
    (fun y hy => TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨y, hy⟩, hy, hxW y (hV hy)⟩) a (by
      intro y z
      apply hinj _ ((inf_le_left.trans inf_le_left).trans hV)
      change X.presheaf.map (homOfLE inf_le_left).op (a y) • L.presheaf.map (homOfLE _).op e =
        X.presheaf.map (homOfLE inf_le_right).op (a z) • L.presheaf.map (homOfLE _).op e
      let I := (V ⊓ W y.1 (hV y.2)) ⊓ (V ⊓ W z.1 (hV z.2))
      have hIU : I ≤ U := (inf_le_left.trans inf_le_left).trans hV
      have hIV : I ≤ V := inf_le_left.trans inf_le_left
      have hy : X.presheaf.map (homOfLE (inf_le_left : I ≤ _)).op (a y) •
          L.presheaf.map (homOfLE hIU).op e = L.presheaf.map (homOfLE hIV).op t := by
        rw [← Scheme.Modules.map_map_homOfLE L ((inf_le_left : V ⊓ W y.1 (hV y.2) ≤ V).trans hV)
            (inf_le_left : I ≤ _), ← Scheme.Modules.map_smul, ha, Scheme.Modules.map_map_homOfLE]
      have hz : X.presheaf.map (homOfLE (inf_le_right : I ≤ _)).op (a z) •
          L.presheaf.map (homOfLE hIU).op e = L.presheaf.map (homOfLE hIV).op t := by
        rw [← Scheme.Modules.map_map_homOfLE L ((inf_le_left : V ⊓ W z.1 (hV z.2) ≤ V).trans hV)
            (inf_le_right : I ≤ _), ← Scheme.Modules.map_smul, ha, Scheme.Modules.map_map_homOfLE]
      exact hy.trans hz.symm)
  refine ⟨b, TopCat.Presheaf.IsSheaf.section_ext L.isSheaf fun y hy => ?_⟩
  refine ⟨V ⊓ W y (hV hy), inf_le_left, ⟨hy, hxW y (hV hy)⟩, ?_⟩
  have hby := hb ⟨y, hy⟩
  change X.presheaf.map (homOfLE inf_le_left).op b = a ⟨y, hy⟩ at hby
  change L.presheaf.map (homOfLE inf_le_left).op
    ((show Γ(X, V) from b) • L.presheaf.map (homOfLE hV).op e) = _
  rw [Scheme.Modules.map_smul, Scheme.Modules.map_map_homOfLE, hby]
  exact ha ⟨y, hy⟩

/-- **On its nonvanishing locus, a section of an invertible sheaf trivializes it.** -/
theorem isTrivializingSection_nonvanishingLocusOpens {L : X.Modules} (hL : L.IsInvertible)
    (s : Γ(L, ⊤)) :
    IsTrivializingSection L (nonvanishingLocusOpens hL s)
      (L.presheaf.map (homOfLE le_top).op s) := by
  refine IsTrivializingSection.of_local fun x hx => ?_
  obtain ⟨U, e, hxU, he⟩ := exists_isTrivializingSection hL x
  obtain ⟨g, hg⟩ := he.exists_eq_smul s
  have hxg : x ∈ X.basicOpen g := (he.mem_nonvanishingLocus_iff hg hxU).mp hx
  have hle : X.basicOpen g ≤ nonvanishingLocusOpens hL s :=
    he.basicOpen_le_nonvanishingLocus hg
  refine ⟨X.basicOpen g, hle, hxg, ?_⟩
  have h1 : L.presheaf.map (homOfLE hle).op (L.presheaf.map (homOfLE le_top).op s) =
      X.presheaf.map (homOfLE (X.basicOpen_le g)).op g •
        L.presheaf.map (homOfLE (X.basicOpen_le g)).op e := by
    rw [Scheme.Modules.map_map_homOfLE, ← Scheme.Modules.map_map_homOfLE L le_top
      (X.basicOpen_le g), hg, Scheme.Modules.map_smul]
  rw [h1]
  exact (he.restrict (X.basicOpen_le g)).unit_smul (X.toRingedSpace.isUnit_res_basicOpen g)

/-- The germ of a section at a point of its nonvanishing locus... -/
theorem exists_mem_nonvanishingLocus_of_isGeneratedBySections {L : X.Modules}
    (hL : L.IsInvertible) {ι : Type u} {s : ι → Γ(L, ⊤)} (hs : L.IsGeneratedBySections s)
    (x : X) : ∃ i, x ∈ nonvanishingLocus L (s i) := by
  obtain ⟨U, e, hxU, he⟩ := exists_isTrivializingSection hL x
  by_contra hall
  push Not at hall
  apply he.germ_not_mem hxU
  have hle : Submodule.span (X.presheaf.stalk x)
      (Set.range fun i => L.presheaf.germ ⊤ x trivial (s i)) ≤
      (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) •
        (⊤ : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x)) := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    by_contra h
    exact hall i h
  exact hle ((hs x).symm ▸ Submodule.mem_top)

end Nonvanishing

/-! ### Part (b): the ratios `sₗ/sₖ` on `X_{sₖ}` -/

section Ratios

variable {n : ℕ} {X : Scheme.{u}} {L : X.Modules} (hL : L.IsInvertible)
  (s : Fin (n + 1) → Γ(L, ⊤))

/-- The nonvanishing locus `X_{sₖ}`. -/
abbrev locus (k : Fin (n + 1)) : X.Opens := nonvanishingLocusOpens hL (s k)

theorem isTrivializingSection_locus (k : Fin (n + 1)) :
    IsTrivializingSection L (locus hL s k) (L.presheaf.map (homOfLE le_top).op (s k)) :=
  isTrivializingSection_nonvanishingLocusOpens hL (s k)

/-- The ratio `sₗ/sₖ`, a function on `X_{sₖ}`: the unique `g` with `sₗ = g sₖ` there. -/
def sectionRatio (k l : Fin (n + 1)) : Γ(X, locus hL s k) :=
  ((isTrivializingSection_locus hL s k).exists_eq_smul (s l)).choose

theorem sectionRatio_spec (k l : Fin (n + 1)) :
    L.presheaf.map (homOfLE (le_top : locus hL s k ≤ ⊤)).op (s l) =
      sectionRatio hL s k l • L.presheaf.map (homOfLE (le_top : locus hL s k ≤ ⊤)).op (s k) :=
  ((isTrivializingSection_locus hL s k).exists_eq_smul (s l)).choose_spec

/-- On an open `V ⊆ X_{sₖ}`, `sₗ = (sₗ/sₖ) sₖ`. -/
theorem restrict_eq_sectionRatio_smul (k l : Fin (n + 1)) {V : X.Opens} (h : V ≤ locus hL s k) :
    L.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (s l) =
      X.presheaf.map (homOfLE h).op (sectionRatio hL s k l) •
        L.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (s k) := by
  rw [← Scheme.Modules.map_map_homOfLE L le_top h, sectionRatio_spec, Scheme.Modules.map_smul,
    Scheme.Modules.map_map_homOfLE]

/-- On an open `V ⊆ X_{sₖ}`, coefficients with respect to `sₖ` are unique. -/
theorem eq_of_smul_eq (k : Fin (n + 1)) {V : X.Opens} (h : V ≤ locus hL s k) {a b : Γ(X, V)}
    (hab : a • L.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (s k) =
      b • L.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (s k)) : a = b := by
  refine (isTrivializingSection_locus hL s k V h).1 ?_
  simp only [Scheme.Modules.map_map_homOfLE]
  exact hab

theorem sectionRatio_self (k : Fin (n + 1)) : sectionRatio hL s k k = 1 := by
  have h := restrict_eq_sectionRatio_smul hL s k k (le_refl (locus hL s k))
  refine eq_of_smul_eq hL s k le_rfl ?_
  rw [one_smul]
  conv_rhs => rw [h]
  simp only [homOfLE_refl, op_id, CategoryTheory.Functor.map_id]
  rfl

/-- The cocycle identity `sₘ/sₖ = (sₗ/sₖ)(sₘ/sₗ)` on `X_{sₖ} ∩ X_{sₗ}`. -/
theorem sectionRatio_cocycle (k l m : Fin (n + 1)) {V : X.Opens} (h₁ : V ≤ locus hL s k)
    (h₂ : V ≤ locus hL s l) :
    X.presheaf.map (homOfLE h₁).op (sectionRatio hL s k m) =
      X.presheaf.map (homOfLE h₁).op (sectionRatio hL s k l) *
        X.presheaf.map (homOfLE h₂).op (sectionRatio hL s l m) := by
  refine eq_of_smul_eq hL s k h₁ ?_
  rw [← restrict_eq_sectionRatio_smul, mul_comm, mul_smul, ← restrict_eq_sectionRatio_smul,
    ← restrict_eq_sectionRatio_smul]

theorem isUnit_sectionRatio (k l : Fin (n + 1)) {V : X.Opens} (h₁ : V ≤ locus hL s k)
    (h₂ : V ≤ locus hL s l) : IsUnit (X.presheaf.map (homOfLE h₁).op (sectionRatio hL s k l)) := by
  have h := sectionRatio_cocycle hL s k l k h₁ h₂
  rw [sectionRatio_self, map_one] at h
  exact IsUnit.of_mul_eq_one _ h.symm

/-- `D(sₗ/sₖ) = X_{sₖ} ∩ X_{sₗ}`. -/
theorem basicOpen_sectionRatio (k l : Fin (n + 1)) :
    X.basicOpen (sectionRatio hL s k l) = locus hL s k ⊓ locus hL s l := by
  ext x
  have h := (isTrivializingSection_locus hL s k).nonvanishingLocus_inter_eq
    (sectionRatio_spec hL s k l)
  have hx := congrArg (x ∈ ·) h
  simp only [Set.mem_inter_iff, eq_iff_iff] at hx
  change x ∈ (X.basicOpen (sectionRatio hL s k l) : Set X) ↔ _
  rw [← hx]
  exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩

end Ratios

/-! ### Part (b): construction of the morphism -/

section Construction

variable {n : ℕ} {X : Scheme.{u}} {L : X.Modules} (hL : L.IsInvertible)
  (s : Fin (n + 1) → Γ(L, ⊤))

/-- The ring map `ℤ[x₀, …, xₙ] → Γ(X_{sₖ}, 𝒪)`, `xₗ ↦ sₗ/sₖ`. -/
def chartRingMap (k : Fin (n + 1)) :
    MvPolynomial (Fin (n + 1)) (ULift.{u} ℤ) →+* Γ(X, locus hL s k) :=
  eval₂Hom ((Int.castRingHom _).comp ULift.ringEquiv.toRingHom) fun l => sectionRatio hL s k l

theorem chartRingMap_X (k l : Fin (n + 1)) :
    chartRingMap hL s k (MvPolynomial.X l) = sectionRatio hL s k l := by
  simp [chartRingMap]

theorem chartRingMap_X_self (k : Fin (n + 1)) : chartRingMap hL s k (MvPolynomial.X k) = 1 := by
  rw [chartRingMap_X, sectionRatio_self]

theorem isUnit_chartRingMap_X_self (k : Fin (n + 1)) :
    IsUnit (chartRingMap hL s k (MvPolynomial.X k)) := by
  rw [chartRingMap_X_self]
  exact isUnit_one

/-- **The chart morphism** `X_{sₖ} ⟶ D₊(xₖ) ⊆ ℙⁿ_ℤ` given by `xₗ/xₖ ↦ sₗ/sₖ`. -/
def chartMorphism (k : Fin (n + 1)) : (locus hL s k).toScheme ⟶ projInt.{u} n :=
  (locus hL s k).toSpecΓ ≫
    projChartMap (chartRingMap hL s k) (X_mem_homogeneousSubmodule_one _ k) Nat.one_pos
      (isUnit_chartRingMap_X_self hL s k)

theorem chartMorphism_compat (k l : Fin (n + 1)) :
    X.homOfLE (inf_le_left : locus hL s k ⊓ locus hL s l ≤ _) ≫ chartMorphism hL s k =
      X.homOfLE (inf_le_right : locus hL s k ⊓ locus hL s l ≤ _) ≫ chartMorphism hL s l := by
  set ρ := X.presheaf.map (homOfLE (inf_le_left : locus hL s k ⊓ locus hL s l ≤ _)).op with hρ
  set ρ' := X.presheaf.map (homOfLE (inf_le_right : locus hL s k ⊓ locus hL s l ≤ _)).op
    with hρ'
  have hunit_c : IsUnit ((ρ.hom.comp (chartRingMap hL s k)) (MvPolynomial.X k)) := by
    simp [chartRingMap_X_self]
  have hunit_c' : IsUnit ((ρ'.hom.comp (chartRingMap hL s l)) (MvPolynomial.X l)) := by
    simp [chartRingMap_X_self]
  have hunit_x : IsUnit ((ρ.hom.comp (chartRingMap hL s k)) (MvPolynomial.X l)) := by
    rw [RingHom.comp_apply, chartRingMap_X]
    exact isUnit_sectionRatio hL s k l inf_le_left inf_le_right
  simp only [chartMorphism]
  rw [← Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_assoc,
    ← Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_assoc, SpecMap_projChartMap _ _ _ _ _ hunit_c,
    SpecMap_projChartMap _ _ _ _ _ hunit_c']
  congr 1
  rw [projChartMap_eq _ _ _ hunit_c (X_mem_homogeneousSubmodule_one _ _) Nat.one_pos hunit_x]
  symm
  apply projChartMap_eq_of_scale _ _ (ρ' (chartRingMap hL s l (MvPolynomial.X k)))
  intro d a ha
  have hgen : ∀ j, (ρ'.hom.comp (chartRingMap hL s l)) (MvPolynomial.X j) =
      ρ' (chartRingMap hL s l (MvPolynomial.X k)) *
        (ρ.hom.comp (chartRingMap hL s k)) (MvPolynomial.X j) := by
    intro j
    rw [RingHom.comp_apply, RingHom.comp_apply, chartRingMap_X, chartRingMap_X, chartRingMap_X]
    exact sectionRatio_cocycle hL s l k j inf_le_right inf_le_left
  have hcoef : (ρ'.hom.comp (chartRingMap hL s l)).comp C =
      (ρ.hom.comp (chartRingMap hL s k)).comp C := ulift_int_ringHom_ext _ _
  have hhom : a.IsHomogeneous d := (mem_homogeneousSubmodule d a).1 ha
  have e1 : (ρ'.hom.comp (chartRingMap hL s l)) a =
      eval₂ ((ρ.hom.comp (chartRingMap hL s k)).comp C)
        (fun j => ρ' (chartRingMap hL s l (MvPolynomial.X k)) *
          (ρ.hom.comp (chartRingMap hL s k)) (MvPolynomial.X j)) a := by
    conv_lhs => rw [← eval₂_eta a]
    rw [eval₂_comp_left, hcoef]
    congr 1
    funext j
    exact hgen j
  have e2 : (ρ.hom.comp (chartRingMap hL s k)) a =
      eval₂ ((ρ.hom.comp (chartRingMap hL s k)).comp C)
        (fun j => (ρ.hom.comp (chartRingMap hL s k)) (MvPolynomial.X j)) a := by
    conv_lhs => rw [← eval₂_eta a]
    rw [eval₂_comp_left]
    rfl
  rw [e1, e2, isHomogeneous_eval₂_mul_left hhom]

theorem locus_isOpenCover (hs : L.IsGeneratedBySections (fun i : ULift.{u} (Fin (n + 1)) => s i.down)) :
    TopologicalSpace.IsOpenCover (locus hL s) := by
  refine TopologicalSpace.IsOpenCover.mk (eq_top_iff.mpr fun x _ => ?_)
  obtain ⟨⟨i⟩, hi⟩ := exists_mem_nonvanishingLocus_of_isGeneratedBySections hL hs x
  exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩

variable (hs : L.IsGeneratedBySections (fun i : ULift.{u} (Fin (n + 1)) => s i.down))

/-- **The morphism `X ⟶ ℙⁿ_ℤ` determined by generating sections**, glued from the chart
morphisms `X_{sₖ} ⟶ D₊(xₖ)`. -/
def morphismToProjInt : X ⟶ projInt.{u} n :=
  glueOpens (locus hL s) (locus_isOpenCover hL s hs) (chartMorphism hL s)
    (chartMorphism_compat hL s)

@[reassoc (attr := simp)]
theorem ι_morphismToProjInt (k : Fin (n + 1)) :
    (locus hL s k).ι ≫ morphismToProjInt hL s hs = chartMorphism hL s k :=
  ι_glueOpens _ _ _ _ k

theorem morphismToProjInt_preimage (m : Fin (n + 1)) :
    morphismToProjInt hL s hs ⁻¹ᵁ chartInt n m = locus hL s m := by
  apply opens_eq_of_cover _ (locus_isOpenCover hL s hs)
  intro k
  rw [← Scheme.Hom.comp_preimage, ι_morphismToProjInt, chartMorphism, Scheme.Hom.comp_preimage,
    projChartMap_preimage_basicOpen _ _ _ _ (X_mem_homogeneousSubmodule_one _ _) Nat.one_pos,
    Scheme.Opens.toSpecΓ_preimage_basicOpen, chartRingMap_X, basicOpen_sectionRatio,
    Scheme.Hom.preimage_inf, Scheme.Opens.ι_preimage_self, top_inf_eq]

/-- On `X_{sₖ}`, the morphism pulls `xₗ/xₖ` back to `sₗ/sₖ`. -/
theorem morphismToProjInt_appLE (k l : Fin (n + 1)) :
    (morphismToProjInt hL s hs).appLE (chartInt n k) (locus hL s k)
        (morphismToProjInt_preimage hL s hs k).ge (ratioInt n k l) = sectionRatio hL s k l := by
  have h1 := ι_comp_eq_toSpecΓ_SpecMap (morphismToProjInt hL s hs) (locus hL s k)
    (X_mem_homogeneousSubmodule_one _ k) Nat.one_pos (morphismToProjInt_preimage hL s hs k).ge
  rw [ι_morphismToProjInt, chartMorphism, projChartMap] at h1
  simp only [← Category.assoc] at h1
  rw [cancel_mono] at h1
  have h2 := congrArg (fun φ => φ.hom (chartRatio (ULift.{u} ℤ) k l))
    (toSpecΓ_SpecMap_injective _ h1)
  simp only [CommRingCat.hom_ofHom] at h2
  rw [awayLift_chartRatio _ _ _ (chartRingMap_X_self hL s k), chartRingMap_X] at h2
  exact h2.symm

end Construction

/-! ### Part (a) -/

section PartA

variable {n : ℕ} {X Y : Scheme.{u}}

/-- **Hartshorne II, Theorem 7.1(a), invertibility.** For a morphism `φ : X ⟶ ℙⁿ_Y`, the sheaf
`φ^* 𝒪(1)` is invertible. -/
theorem isInvertible_pullback_projectiveSpaceTwistingSheaf (φ : X ⟶ projectiveSpaceOverScheme n Y) :
    ((Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf n Y 1)).IsInvertible :=
  Scheme.Modules.IsInvertible.pullback _ (isInvertible_projectiveSpaceTwistingSheaf n Y 1)

/-- **Hartshorne II, Theorem 7.1(a), generation.** For a morphism `φ : X ⟶ ℙⁿ_Y`, the sheaf
`φ^* 𝒪(1)` is generated by the global sections `φ^* xᵢ`, `i = 0, …, n`. -/
theorem isGeneratedBySections_pullback_projectiveSpaceCoordinate
    (φ : X ⟶ projectiveSpaceOverScheme n Y) :
    ((Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf n Y 1)).IsGeneratedBySections
      (fun i : ULift.{u} (Fin (n + 1)) =>
        pullbackGlobalSection φ (projectiveSpaceCoordinate n Y i.down)) := by
  intro x
  obtain ⟨k, hk⟩ := exists_mem_chartPreimage φ x
  have he := isTrivializingSection_chartPreimage φ k
  refine top_unique fun z _ => ?_
  obtain ⟨b, rfl⟩ := he.exists_smul_germ_eq hk z
  rw [TopCat.Presheaf.germ_res_apply]
  exact Submodule.smul_mem _ b (Submodule.subset_span ⟨⟨k⟩, rfl⟩)

end PartA

end Hartshorne
