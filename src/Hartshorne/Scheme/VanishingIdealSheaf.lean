/-!
# The ideal sheaf of functions vanishing on a subset

Let `X` be a scheme and `Z ⊆ X` a subset. The functions vanishing on `Z` form a sub-`𝒪_X`-module
`I_Z ⊆ 𝒪_X` (`vanishingIdealSheaf Z`): a section `f ∈ 𝒪_X(V)` lies in `I_Z(V)` when no point of
`Z` lies in the basic open `D(f)`, i.e. when the germ of `f` lies in the maximal ideal at every
point of `Z ∩ V`. For closed `Z` this is the ideal sheaf of the reduced induced structure on `Z`,
which Hartshorne uses in the proof of Theorem II.7.6.

* `isCoherent_vanishingIdealSheaf`: on a locally Noetherian scheme, `I_Z` is coherent. On an
  affine open `U`, restriction `I_Z(U) → I_Z(D(g))` is localization away from `g`
  (`isIso_fromTildeΓ_restrict_of_isLocalized` turns this into the canonical isomorphism
  `I_Z(U)~ ≅ I_Z|_U`), and `I_Z(U)` is an ideal of the Noetherian ring `𝒪_X(U)`.
* `vanishingIdealMul M`: the multiplication morphism `I_Z ⊗ M ⟶ M`, `a ⊗ m ↦ a m`.
* `not_mem_nonvanishingLocus_vanishingIdealMul`: the image in `M` of a global section of
  `I_Z ⊗ M` lies in `𝔪_z M_z` at every point `z ∈ Z`.
* `exists_mem_nonvanishingLocus_vanishingIdealMul`: if `I_Z ⊗ M` is generated by global
  sections `σ i` and `M` is trivialized near a point `x` by a section over an open disjoint from
  `Z`, then some `σ i` maps to a section of `M` not vanishing at `x`.
-/

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry

namespace Hartshorne

variable {X : Scheme.{u}}

/-! ### The vanishing ideal sheaf -/

section VanishingIdeal

variable (Z : Set X)

/-- A section `f ∈ 𝒪_X(V)` *vanishes on `Z`* if no point of `Z` lies in the basic open `D(f)`,
i.e. if the germ of `f` lies in the maximal ideal at every point of `Z ∩ V`. -/
def VanishesOn {V : X.Opens} (f : Γ(X, V)) : Prop :=
  ∀ z ∈ Z, z ∉ X.basicOpen f

namespace VanishesOn

variable {Z}

theorem zero (V : X.Opens) : VanishesOn Z (0 : Γ(X, V)) := by
  intro z _ hz
  rw [Scheme.basicOpen_zero] at hz
  exact hz

theorem add {V : X.Opens} {f g : Γ(X, V)} (hf : VanishesOn Z f) (hg : VanishesOn Z g) :
    VanishesOn Z (f + g) := by
  intro z hz h
  rcases Opens.mem_sup.mp (Scheme.basicOpen_add_le X f g h) with h' | h'
  · exact hf z hz h'
  · exact hg z hz h'

theorem mul_left {V : X.Opens} (r : Γ(X, V)) {f : Γ(X, V)} (hf : VanishesOn Z f) :
    VanishesOn Z (r * f) := by
  intro z hz h
  rw [Scheme.basicOpen_mul] at h
  exact hf z hz h.2

theorem mul_right {V : X.Opens} {r : Γ(X, V)} (hr : VanishesOn Z r) (f : Γ(X, V)) :
    VanishesOn Z (r * f) := by
  intro z hz h
  rw [Scheme.basicOpen_mul] at h
  exact hr z hz h.1

theorem res {V W : X.Opens} {f : Γ(X, V)} (hf : VanishesOn Z f) (i : op V ⟶ op W) :
    VanishesOn Z (X.presheaf.map i f) := by
  intro z hz h
  rw [Scheme.basicOpen_res] at h
  exact hf z hz h.2

theorem of_locally {U : X.Opens} {f : Γ(X, U)}
    (h : ∀ x ∈ U, ∃ (V : X.Opens) (hVU : V ≤ U), x ∈ V ∧
      VanishesOn Z (X.presheaf.map (homOfLE hVU).op f)) : VanishesOn Z f := by
  intro z hz hzf
  obtain ⟨V, hVU, hzV, hV⟩ := h z (X.basicOpen_le _ hzf)
  apply hV z hz
  rw [Scheme.basicOpen_res]
  exact ⟨hzV, hzf⟩

theorem germ_mem_maximalIdeal {V : X.Opens} {f : Γ(X, V)} (hf : VanishesOn Z f) {z : X}
    (hz : z ∈ Z) (hzV : z ∈ V) :
    X.presheaf.germ V z hzV f ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z) := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  exact hf z hz ((X.mem_basicOpen _ z hzV).mpr hu)

end VanishesOn

/-- The submodules `I_Z(V) ⊆ 𝒪_X(V)` of sections vanishing on `Z`. -/
def vanishingIdealSubmodule : (SheafOfModules.unit X.ringCatSheaf).val.Submodule where
  obj V :=
    { carrier := {f | VanishesOn Z (V := V.unop) f}
      zero_mem' := VanishesOn.zero V.unop
      add_mem' := fun hf hg => VanishesOn.add (V := V.unop) hf hg
      smul_mem' := fun r _ hf => VanishesOn.mul_left (V := V.unop) r hf }
  map {V W} i := fun _ hf => VanishesOn.res (V := V.unop) (W := W.unop) hf i

theorem isSheaf_vanishingIdealSubmodule :
    Presheaf.IsSheaf (Opens.grothendieckTopology X)
      (vanishingIdealSubmodule Z).toPresheafOfModules.presheaf :=
  Scheme.isSheaf_submodule_of_local _ fun U _ h => VanishesOn.of_locally (U := U) h

/-- **The ideal sheaf of functions vanishing on `Z`**: the sub-`𝒪_X`-module `I_Z ⊆ 𝒪_X` whose
sections over `V` are the `f ∈ 𝒪_X(V)` with `f_z ∈ 𝔪_z` for every `z ∈ Z ∩ V`. -/
noncomputable def vanishingIdealSheaf : X.Modules :=
  ⟨(vanishingIdealSubmodule Z).toPresheafOfModules, isSheaf_vanishingIdealSubmodule Z⟩

variable {Z}

/-- The underlying function of a section of `I_Z`. -/
def VanishingIdeal.val {V : X.Opens} (a : Γ(vanishingIdealSheaf Z, V)) : Γ(X, V) :=
  a.1

theorem VanishingIdeal.vanishesOn {V : X.Opens} (a : Γ(vanishingIdealSheaf Z, V)) :
    VanishesOn Z (VanishingIdeal.val a) :=
  a.2

end VanishingIdeal

/-! ### Quasi-coherence from localization on an affine open -/

section Localizing

/-- Restricting along `Spec Γ(X, U) ⟶ X` and back is restriction of sections. -/
private theorem fromSpec_ring_compat {U : X.Opens} (hU : IsAffineOpen U)
    (V : (Spec Γ(X, U)).Opens) (h : hU.fromSpec ''ᵁ V ≤ U) :
    (Scheme.ΓSpecIso Γ(X, U)).inv ≫ (Spec Γ(X, U)).presheaf.map V.leTop.op ≫
        (hU.fromSpec.appIso V).inv = X.presheaf.map (homOfLE h).op := by
  rw [← Category.assoc, Iso.comp_inv_eq, Scheme.Hom.appIso_hom, ← Category.assoc,
    Scheme.Hom.naturality, hU.fromSpec_app_self]
  simp only [Category.assoc, ← Functor.map_comp]
  rfl

/-- The `Γ(X, U)`-module structure on the sections of `F|_U` on `Spec Γ(X, U)`. -/
private theorem fromSpec_smul {U : X.Opens} (hU : IsAffineOpen U) (F : X.Modules)
    (V : (Spec Γ(X, U)).Opens) (h : hU.fromSpec ''ᵁ V ≤ U) (a : Γ(X, U))
    (x : Γ(F.restrict hU.fromSpec, V)) :
    a • x = (show Γ(F.restrict hU.fromSpec, V) from
      X.presheaf.map (homOfLE h).op a • (show Γ(F, hU.fromSpec ''ᵁ V) from x)) := by
  rw [Scheme.Modules.smul_Spec_def]
  rw [← fromSpec_ring_compat hU V h]
  rfl

private theorem modules_map_map' (F : X.Modules) {U V W : X.Opens} (i : V ⟶ U) (j : W ⟶ V)
    (k : W ⟶ U) (s : Γ(F, U)) :
    F.presheaf.map j.op (F.presheaf.map i.op s) = F.presheaf.map k.op s := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

private theorem modules_map_id' (F : X.Modules) {U : X.Opens} (i : U ⟶ U) (s : Γ(F, U)) :
    F.presheaf.map i.op s = s := by
  rw [Subsingleton.elim i (𝟙 U), op_id, CategoryTheory.Functor.map_id]
  rfl

private theorem ring_map_map' {U V W : X.Opens} (i : V ⟶ U) (j : W ⟶ V) (k : W ⟶ U)
    (a : Γ(X, U)) : X.presheaf.map j.op (X.presheaf.map i.op a) = X.presheaf.map k.op a := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- **Quasi-coherence on an affine open from localization.** Let `U` be an affine open and `F`
an `𝒪_X`-module such that for every `g ∈ 𝒪_X(U)` the restriction `F(U) → F(D(g))` is a
localization away from `g`: a section vanishing on `D(g)` is killed by a power of `g`, and every
section over `D(g)` becomes, after multiplication by a power of `g`, the restriction of a section
over `U`. Then the canonical map `F(U)~ → F|_U` on `Spec 𝒪_X(U)` is an isomorphism. -/
theorem isIso_fromTildeΓ_restrict_of_isLocalized (F : X.Modules) {U : X.Opens}
    (hU : IsAffineOpen U)
    (h₁ : ∀ (g : Γ(X, U)) (s : Γ(F, U)),
      F.presheaf.map (homOfLE (X.basicOpen_le g)).op s = 0 → ∃ n : ℕ, g ^ n • s = 0)
    (h₂ : ∀ (g : Γ(X, U)) (t : Γ(F, X.basicOpen g)), ∃ (n : ℕ) (s : Γ(F, U)),
      F.presheaf.map (homOfLE (X.basicOpen_le g)).op s =
        (X.presheaf.map (homOfLE (X.basicOpen_le g)).op g) ^ n • t) :
    IsIso (F.restrict hU.fromSpec).fromTildeΓ := by
  have h1 : hU.fromSpec ''ᵁ ⊤ = U :=
    hU.fromSpec.image_top_eq_opensRange.trans hU.opensRange_fromSpec
  rw [isIso_fromTildeΓ_iff_isLocalizing]
  intro g
  let D : (Spec Γ(X, U)).Opens := PrimeSpectrum.basicOpen g
  have h2 : hU.fromSpec ''ᵁ D = X.basicOpen g := hU.fromSpec_image_basicOpen g
  have hDU : hU.fromSpec ''ᵁ D ≤ U := h2.le.trans (X.basicOpen_le g)
  have hDT : hU.fromSpec ''ᵁ D ≤ hU.fromSpec ''ᵁ ⊤ := Scheme.Hom.image_mono _ le_top
  -- the unit `g|_{D(g)}`
  have hu : IsUnit (X.presheaf.map (homOfLE hDU).op g) := by
    rw [← ring_map_map' (homOfLE (X.basicOpen_le g)) (eqToHom h2) (homOfLE hDU)]
    exact (X.toRingedSpace.isUnit_res_basicOpen g).map (X.presheaf.map (eqToHom h2).op).hom
  constructor
  · rintro ⟨_, n, rfl⟩
    rw [Module.End.isUnit_iff]
    have hb : Function.Bijective (fun y : Γ(F, hU.fromSpec ''ᵁ D) =>
        (X.presheaf.map (homOfLE hDU).op g) ^ n • y) := by
      have := MulAction.bijective (hu.unit ^ n) (β := Γ(F, hU.fromSpec ''ᵁ D))
      convert this using 2 with y
      simp [Units.smul_def]
    have key : ∀ y, algebraMap Γ(X, U) (Module.End Γ(X, U)
        ((modulesSpecToSheaf.obj (F.restrict hU.fromSpec)).obj.obj (op D))) (g ^ n) y =
        (show Γ(F.restrict hU.fromSpec, D) from (X.presheaf.map (homOfLE hDU).op g) ^ n •
          (show Γ(F, hU.fromSpec ''ᵁ D) from y)) := by
      intro y
      rw [Module.algebraMap_end_apply]
      refine (fromSpec_smul hU F D hDU (g ^ n) y).trans ?_
      rw [map_pow]
    refine ⟨fun y₁ y₂ h => hb.1 ((key y₁).symm.trans (h.trans (key y₂))), fun y => ?_⟩
    obtain ⟨y', hy'⟩ := hb.2 y
    exact ⟨y', (key y').trans hy'⟩
  · intro y
    let y' : Γ(F, hU.fromSpec ''ᵁ D) := y
    obtain ⟨n, s, hs⟩ := h₂ g (F.presheaf.map (eqToHom h2.symm).op y')
    refine ⟨⟨(F.presheaf.map (eqToHom h1).op s : Γ(F, hU.fromSpec ''ᵁ ⊤)),
      ⟨g ^ n, n, rfl⟩⟩, ?_⟩
    have hy : F.presheaf.map (eqToHom h2).op (F.presheaf.map (eqToHom h2.symm).op y') = y' := by
      rw [modules_map_map' F (eqToHom h2.symm) (eqToHom h2) (𝟙 _), modules_map_id']
    have key : F.presheaf.map (homOfLE hDT).op (F.presheaf.map (eqToHom h1).op s) =
        X.presheaf.map (homOfLE hDU).op (g ^ n) • y' := by
      rw [modules_map_map' F (eqToHom h1) (homOfLE hDT) (homOfLE hDU),
        ← modules_map_map' F (homOfLE (X.basicOpen_le g)) (eqToHom h2) (homOfLE hDU), hs,
        Scheme.Modules.map_smul, hy]
      simp only [map_pow]
      rw [ring_map_map' (homOfLE (X.basicOpen_le g)) (eqToHom h2) (homOfLE hDU)]
    exact (fromSpec_smul hU F D hDU (g ^ n) y).trans key.symm
  · intro x₁ x₂ hx
    let w : Γ(F, hU.fromSpec ''ᵁ ⊤) := x₁ - x₂
    let s : Γ(F, U) := F.presheaf.map (eqToHom h1.symm).op w
    have hw : F.presheaf.map (homOfLE hDT).op w = 0 := by
      have : ((modulesSpecToSheaf.obj (F.restrict hU.fromSpec)).obj.map D.leTop.op).hom
          (x₁ - x₂) = 0 := by
        rw [map_sub, hx, sub_self]
      exact this
    have hs : F.presheaf.map (homOfLE (X.basicOpen_le g)).op s = 0 := by
      have h3 := congrArg (F.presheaf.map (eqToHom h2.symm).op) hw
      rw [map_zero, modules_map_map' F (homOfLE hDT) (eqToHom h2.symm)
        (homOfLE (X.basicOpen_le g) ≫ eqToHom h1.symm)] at h3
      rw [modules_map_map' F (eqToHom h1.symm) (homOfLE (X.basicOpen_le g))
        (homOfLE (X.basicOpen_le g) ≫ eqToHom h1.symm)]
      exact h3
    obtain ⟨n, hn⟩ := h₁ g s hs
    refine ⟨⟨g ^ n, n, rfl⟩, ?_⟩
    change g ^ n • x₁ = g ^ n • x₂
    rw [← sub_eq_zero, ← smul_sub]
    have hws : w = F.presheaf.map (eqToHom h1).op s := by
      rw [modules_map_map' F (eqToHom h1.symm) (eqToHom h1) (𝟙 _), modules_map_id']
    refine (fromSpec_smul hU F ⊤ h1.le (g ^ n) (x₁ - x₂)).trans ?_
    change X.presheaf.map (homOfLE h1.le).op (g ^ n) • w = 0
    rw [hws, show (homOfLE h1.le : hU.fromSpec ''ᵁ ⊤ ⟶ U) = eqToHom h1 from Subsingleton.elim _ _,
      ← Scheme.Modules.map_smul, hn, map_zero]

end Localizing

/-! ### Coherence -/

section Coherence

variable (Z : Set X)

/-- On an affine open `U`, a section of `I_Z` vanishing on `D(g)` is killed by a power of `g`. -/
private theorem vanishingIdeal_h₁ {U : X.Opens} (hU : IsAffineOpen U) (g : Γ(X, U))
    (s : Γ(vanishingIdealSheaf Z, U))
    (hs : (vanishingIdealSheaf Z).presheaf.map (homOfLE (X.basicOpen_le g)).op s = 0) :
    ∃ n : ℕ, g ^ n • s = 0 := by
  have := hU.isLocalization_basicOpen g
  have hs' : algebraMap Γ(X, U) Γ(X, X.basicOpen g) (VanishingIdeal.val s) = 0 :=
    congrArg Subtype.val hs
  obtain ⟨⟨_, n, rfl⟩, hn⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers g) _ _).mp hs'
  exact ⟨n, Subtype.ext hn⟩

/-- On an affine open `U`, after multiplication by a power of `g`, a section of `I_Z` over
`D(g)` extends to `U`. -/
private theorem vanishingIdeal_h₂ {U : X.Opens} (hU : IsAffineOpen U) (g : Γ(X, U))
    (t : Γ(vanishingIdealSheaf Z, X.basicOpen g)) :
    ∃ (n : ℕ) (s : Γ(vanishingIdealSheaf Z, U)),
      (vanishingIdealSheaf Z).presheaf.map (homOfLE (X.basicOpen_le g)).op s =
        (X.presheaf.map (homOfLE (X.basicOpen_le g)).op g) ^ n • t := by
  have := hU.isLocalization_basicOpen g
  obtain ⟨⟨a, ⟨_, m, rfl⟩⟩, ha⟩ :=
    IsLocalization.surj (Submonoid.powers g) (VanishingIdeal.val t)
  simp only at ha
  have hmem : VanishesOn Z (g * a) := by
    intro z hz hza
    rw [Scheme.basicOpen_mul] at hza
    apply VanishingIdeal.vanishesOn t z hz
    have hres : z ∈ X.basicOpen (algebraMap Γ(X, U) Γ(X, X.basicOpen g) a) := by
      change z ∈ X.basicOpen (X.presheaf.map (homOfLE (X.basicOpen_le g)).op a)
      rw [Scheme.basicOpen_res]
      exact ⟨hza.1, hza.2⟩
    rw [← ha, Scheme.basicOpen_mul] at hres
    exact hres.1
  refine ⟨m + 1, ⟨g * a, hmem⟩, Subtype.ext ?_⟩
  change X.presheaf.map (homOfLE (X.basicOpen_le g)).op (g * a) =
    (X.presheaf.map (homOfLE (X.basicOpen_le g)).op g) ^ (m + 1) * VanishingIdeal.val t
  have ha' : VanishingIdeal.val t * X.presheaf.map (homOfLE (X.basicOpen_le g)).op g ^ m =
      X.presheaf.map (homOfLE (X.basicOpen_le g)).op a := by
    rw [← map_pow]
    exact ha
  rw [map_mul, ← ha', pow_succ]
  ring

/-- **Coherence of the vanishing ideal sheaf.** On a locally Noetherian scheme, the ideal sheaf
of functions vanishing on a subset `Z` is coherent. -/
theorem isCoherent_vanishingIdealSheaf [IsLocallyNoetherian X] :
    IsCoherent (vanishingIdealSheaf Z) := by
  apply ((coherent_affine_local_tfae (vanishingIdealSheaf Z)).out 0 3).mpr
  intro U
  have := QuasicoherentAbelianAux.isNoetherianRing_affineOpen U
  have : IsNoetherian (X.ringCatSheaf.obj.obj (op (U : X.Opens)))
      ((SheafOfModules.unit X.ringCatSheaf).val.obj (op (U : X.Opens))) :=
    inferInstanceAs (IsNoetherian Γ(X, (U : X.Opens)) Γ(X, (U : X.Opens)))
  have hfin : Module.Finite (X.ringCatSheaf.obj.obj (op (U : X.Opens)))
      ((vanishingIdealSubmodule Z).obj (op (U : X.Opens))) := inferInstance
  constructor
  · exact hfin
  · exact isIso_fromTildeΓ_restrict_of_isLocalized _ U.2 (vanishingIdeal_h₁ Z U.2)
      (vanishingIdeal_h₂ Z U.2)

end Coherence

/-! ### Stalks of morphisms of module sheaves -/

section StalkMap

private theorem modules_germ_smul (F : X.Modules) {U : X.Opens} (x : X) (hx : x ∈ U)
    (r : Γ(X, U)) (m : Γ(F, U)) :
    F.presheaf.germ U x hx (r • m) = X.presheaf.germ U x hx r • F.presheaf.germ U x hx m :=
  let M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat) := F.val
  PresheafOfModules.germ_smul M x U hx r m

/-- The `𝒪_{X,x}`-linear map on stalks induced by a morphism of `𝒪_X`-modules. -/
noncomputable def stalkLinearMap {F G : X.Modules} (φ : F ⟶ G) (x : X) :
    F.presheaf.stalk x →ₗ[X.presheaf.stalk x] G.presheaf.stalk x where
  toFun := ((TopCat.Presheaf.stalkFunctor Ab x).map φ.mapPresheaf).hom
  map_add' := map_add _
  map_smul' r t := by
    obtain ⟨U, hU, s, rfl⟩ := F.presheaf.exists_germ_eq t
    obtain ⟨W, hWU, hW, c, rfl⟩ := X.presheaf.exists_le_germ_eq r hU
    rw [← TopCat.Presheaf.germ_res_apply F.presheaf (homOfLE hWU) x hW s, ← modules_germ_smul]
    simp only [RingHom.id_apply]
    rw [TopCat.Presheaf.stalkFunctor_map_germ_apply, TopCat.Presheaf.stalkFunctor_map_germ_apply,
      Scheme.Modules.mapPresheaf_app, Scheme.Modules.Hom.app_smul, modules_germ_smul]

theorem stalkLinearMap_germ {F G : X.Modules} (φ : F ⟶ G) {x : X} {U : X.Opens} (hx : x ∈ U)
    (s : Γ(F, U)) :
    stalkLinearMap φ x (F.presheaf.germ U x hx s) = G.presheaf.germ U x hx (φ.app U s) :=
  TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx φ.mapPresheaf s

end StalkMap

/-! ### Multiplication `I_Z ⊗ M ⟶ M` -/

section Multiplication

variable (Z : Set X) (M : X.Modules)

/-- The bilinear map `I_Z × M → M`, `(a, m) ↦ a m`. -/
noncomputable def vanishingIdealMulBilinear :
    ModuleSheafBilinear (R := X.sheaf) (vanishingIdealSheaf Z) M M where
  app V := LinearMap.mk₂ _
    (fun a m => (@id ((X.sheaf.obj ⋙ forget₂ CommRingCat RingCat).obj V) a.1) • m)
    (fun a a' m => add_smul _ _ _)
    (fun c a m => mul_smul _ _ _)
    (fun a m m' => smul_add _ _ _)
    (fun c a m => by
      rw [smul_smul, smul_smul, mul_comm])
  naturality {V W} i a m := PresheafOfModules.map_smul M.val i _ m

/-- The `𝒪_X`-module `I_Z ⊗ M`. -/
noncomputable abbrev vanishingIdealTwist : X.Modules :=
  moduleSheafTensor (vanishingIdealSheaf Z) M

/-- The multiplication morphism `I_Z ⊗ M ⟶ M`, `a ⊗ m ↦ a m`. -/
noncomputable def vanishingIdealMul : vanishingIdealTwist Z M ⟶ M :=
  (moduleSheafTensorHomEquiv (vanishingIdealSheaf Z) M M).symm (vanishingIdealMulBilinear Z M)

variable {Z M}

theorem vanishingIdealMul_bilinear {V : X.Opens} (a : Γ(vanishingIdealSheaf Z, V))
    (m : Γ(M, V)) :
    (vanishingIdealMul Z M).app V
        ((moduleSheafTensorBilinear (vanishingIdealSheaf Z) M).app (op V) a m) =
      VanishingIdeal.val a • m := by
  have h := moduleSheafTensorHomEquiv_apply (vanishingIdealMul Z M)
  rw [vanishingIdealMul, Equiv.apply_symm_apply] at h
  exact (congrArg (fun β => β.app (op V) a m) h).symm

/-- At a point `z ∈ Z`, the image in `M` of a global section of `I_Z ⊗ M` lies in `𝔪_z M_z`. -/
theorem not_mem_nonvanishingLocus_vanishingIdealMul
    (s : Γ(vanishingIdealTwist Z M, ⊤)) {z : X} (hz : z ∈ Z) :
    z ∉ nonvanishingLocus M ((vanishingIdealMul Z M).app ⊤ s) := by
  intro h
  apply h
  have key := stalkLinearMap_germ (vanishingIdealMul Z M) (U := ⊤) (x := z) trivial s
  refine key ▸ ?_
  let e : (vanishingIdealTwist Z M).presheaf.stalk z ≃ₗ[X.presheaf.stalk z]
      TensorProduct (X.presheaf.stalk z) ((vanishingIdealSheaf Z).presheaf.stalk z)
        (M.presheaf.stalk z) :=
    moduleSheafTensorStalkIso (R := X.sheaf) (vanishingIdealSheaf Z) M z
  have hgerm : ∀ (W : X.Opens) (hW : z ∈ W) (a : Γ(vanishingIdealSheaf Z, W)) (m : Γ(M, W)),
      e ((vanishingIdealTwist Z M).presheaf.germ W z hW
        ((moduleSheafTensorBilinear (vanishingIdealSheaf Z) M).app (op W) a m)) =
      (vanishingIdealSheaf Z).presheaf.germ W z hW a ⊗ₜ M.presheaf.germ W z hW m :=
    fun W hW a m => moduleSheafTensorStalkIso_germ (R := X.sheaf) _ _ z W hW a m
  rw [← e.symm_apply_apply ((vanishingIdealTwist Z M).presheaf.germ ⊤ z trivial s)]
  generalize e ((vanishingIdealTwist Z M).presheaf.germ ⊤ z trivial s) = y
  induction y using TensorProduct.induction_on with
  | zero =>
    rw [map_zero, map_zero]
    exact zero_mem _
  | tmul a b =>
    obtain ⟨U, hU, α, rfl⟩ := (vanishingIdealSheaf Z).presheaf.exists_germ_eq a
    obtain ⟨V, hV, β, rfl⟩ := M.presheaf.exists_germ_eq b
    have hUV : z ∈ U ⊓ V := ⟨hU, hV⟩
    rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE inf_le_left : U ⊓ V ⟶ U) z hUV α,
      ← TopCat.Presheaf.germ_res_apply _ (homOfLE inf_le_right : U ⊓ V ⟶ V) z hUV β]
    set α' := (vanishingIdealSheaf Z).presheaf.map (homOfLE inf_le_left : U ⊓ V ⟶ U).op α
    set β' := M.presheaf.map (homOfLE inf_le_right : U ⊓ V ⟶ V).op β
    have H : stalkLinearMap (vanishingIdealMul Z M) z
        (e.symm ((vanishingIdealSheaf Z).presheaf.germ (U ⊓ V) z hUV α' ⊗ₜ
          M.presheaf.germ (U ⊓ V) z hUV β')) =
        X.presheaf.germ (U ⊓ V) z hUV (VanishingIdeal.val α') •
          M.presheaf.germ (U ⊓ V) z hUV β' := by
      rw [← hgerm, e.symm_apply_apply]
      exact (stalkLinearMap_germ _ hUV _).trans
        ((congrArg _ (vanishingIdealMul_bilinear α' β')).trans (modules_germ_smul M z hUV _ _))
    rw [H]
    exact Submodule.smul_mem_smul ((VanishingIdeal.vanishesOn _).germ_mem_maximalIdeal hz hUV)
      Submodule.mem_top
  | add y₁ y₂ h₁ h₂ =>
    rw [map_add, map_add]
    exact add_mem h₁ h₂

/-- The germ of a trivializing section of `L` does not lie in `𝔪_x L_x`. -/
theorem IsTrivializingSection.germ_not_mem {L : X.Modules} {U : X.Opens} {e : Γ(L, U)}
    (he : IsTrivializingSection L U e) {x : X} (hx : x ∈ U) :
    L.presheaf.germ U x hx e ∉ (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) •
      (⊤ : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x)) := by
  intro hmem
  have htop : (⊤ : Submodule (X.presheaf.stalk x) (L.presheaf.stalk x)) =
      Submodule.span (X.presheaf.stalk x) {L.presheaf.germ U x hx e} := by
    refine (Submodule.eq_top_iff'.mpr fun w => ?_).symm
    obtain ⟨b, rfl⟩ := he.exists_smul_germ_eq hx w
    exact Submodule.smul_mem _ b (Submodule.mem_span_singleton_self _)
  rw [htop, Submodule.mem_smul_span_singleton] at hmem
  obtain ⟨c, hc, hce⟩ := hmem
  have hsub : (c - 1) • L.presheaf.germ U x hx e = 0 := by
    rw [sub_smul, hce, one_smul, sub_self]
  have hc1 := sub_eq_zero.mp (he.eq_zero_of_smul_germ_eq_zero hx _ hsub)
  rw [hc1] at hc
  exact (IsLocalRing.mem_maximalIdeal _).mp hc isUnit_one

/-- If `I_Z ⊗ M` is generated by the global sections `σ i` and `M` is trivialized by a section
over an open `U` disjoint from `Z`, then at every point of `U` some `σ i` maps to a section of `M`
that does not vanish there. -/
theorem exists_mem_nonvanishingLocus_vanishingIdealMul {U : X.Opens}
    (hZU : Disjoint (U : Set X) Z) {e : Γ(M, U)} (he : IsTrivializingSection M U e) {x : X}
    (hx : x ∈ U) {ι : Type u} {σ : ι → Γ(vanishingIdealTwist Z M, ⊤)}
    (hσ : Scheme.Modules.IsGeneratedBySections (vanishingIdealTwist Z M) σ) :
    ∃ i, x ∈ nonvanishingLocus M ((vanishingIdealMul Z M).app ⊤ (σ i)) := by
  by_contra hall
  rw [not_exists] at hall
  have hone : VanishesOn Z (1 : Γ(X, U)) := by
    intro z hz hz1
    rw [Scheme.basicOpen_one] at hz1
    exact Set.disjoint_left.mp hZU hz1 hz
  let one : Γ(vanishingIdealSheaf Z, U) := ⟨(show Γ(X, U) from 1), hone⟩
  let τ := (moduleSheafTensorBilinear (vanishingIdealSheaf Z) M).app (op U) one e
  have hτ : (vanishingIdealMul Z M).app U τ = e := by
    rw [vanishingIdealMul_bilinear]
    show (1 : Γ(X, U)) • e = e
    exact one_smul _ _
  have hmem : (vanishingIdealTwist Z M).presheaf.germ U x hx τ ∈
      Submodule.span (X.presheaf.stalk x) (Set.range fun i =>
        (vanishingIdealTwist Z M).presheaf.germ ⊤ x trivial (σ i)) := by
    exact (Submodule.eq_top_iff'.mp (hσ x)) _
  have h2 := Submodule.mem_map_of_mem (f := stalkLinearMap (vanishingIdealMul Z M) x) hmem
  rw [Submodule.map_span] at h2
  have key := stalkLinearMap_germ (vanishingIdealMul Z M) hx τ
  rw [hτ] at key
  have h3 := key ▸ h2
  have hle : Submodule.span (X.presheaf.stalk x)
      (stalkLinearMap (vanishingIdealMul Z M) x '' Set.range fun i =>
        (vanishingIdealTwist Z M).presheaf.germ ⊤ x trivial (σ i)) ≤
      (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) •
        (⊤ : Submodule (X.presheaf.stalk x) (M.presheaf.stalk x)) := by
    rw [Submodule.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    have key' := stalkLinearMap_germ (vanishingIdealMul Z M) (U := ⊤) (x := x) trivial (σ i)
    by_contra hi
    have hi' : M.presheaf.germ ⊤ x trivial ((vanishingIdealMul Z M).app ⊤ (σ i)) ∉
        (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) •
          (⊤ : Submodule (X.presheaf.stalk x) (M.presheaf.stalk x)) := key' ▸ hi
    exact hall i hi'
  exact he.germ_not_mem hx (hle h3)

end Multiplication

end Hartshorne
