import Hartshorne.Projective.GradedTwist
import Hartshorne.Scheme.ProjGradedModuleSheafCoherent
import Hartshorne.Scheme.LocallyFreeInvertible
import Hartshorne.Scheme.ProjHomogeneousFraction

/-!
# The twisting sheaves `𝒪_X(n)` on `X = Proj S`

Hartshorne, *Algebraic Geometry*, II.5, the definition of `𝒪_X(n)` and Proposition 5.12(a)
(p. 117).

Let `S` be an `ℕ`-graded ring and `X = Proj S`. For `n ∈ ℤ`, the twisting sheaf is
`𝒪_X(n) = S(n)~`, the sheaf of the twisted graded module `S(n)`, `S(n)_d = S_{n+d}`.

For `f ∈ S_1` the degree-zero localization `S(n)_(f)` is a free `S_(f)`-module of rank one with
basis the degree-`n` element `f^n` (that is, `f^n / 1` for `n ≥ 0` and `1 / f^{-n}` for `n < 0`):
multiplication by `f^n`, `S_(f) → S(n)_(f)`, is an isomorphism. Through the chart isomorphism
`𝒪_X(n)|_{D₊(f)} ≅ S(n)_(f)~` this trivializes `𝒪_X(n)` on `D₊(f)`. If `S` is generated by `S_1`
as an `S_0`-algebra, the `D₊(f)` with `f ∈ S_1` cover `X`, so `𝒪_X(n)` is invertible.

## Main definitions and results

* `Hartshorne.projTwistingSheaf 𝒜 n`: the twisting sheaf `𝒪_X(n) = S(n)~`.
* `Hartshorne.ProjTwistingSheaf.twistGenerator`: the degree-`n` element `f^n` of `S(n)_(f)`.
* `Hartshorne.ProjTwistingSheaf.twistAwayEquiv`: multiplication by `f^n`, `S_(f) ≅ S(n)_(f)`.
* `Hartshorne.ProjTwistingSheaf.chartTrivialization`: `𝒪_X(n)|_{D₊(f)} ≅ 𝒪_{D₊(f)}` for
  `f ∈ S_1`, induced by multiplication by `f^n`.
* `Hartshorne.ProjTwistingSheaf.isInvertible`: if `S` is generated by `S_1` as an
  `S_0`-algebra, every `𝒪_X(n)` is invertible.
-/

universe u

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace Hartshorne

open AlgebraicGeometry CategoryTheory HomogeneousLocalization

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- **Hartshorne's twisting sheaf** `𝒪_X(n) = S(n)~` on `X = Proj S`, for `n ∈ ℤ`, where
`S(n)_d = S_{n+d}`. -/
def projTwistingSheaf (n : ℤ) : (Proj 𝒜).Modules :=
  projGradedModuleSheaf 𝒜 (gradedTwist 𝒜 n)

namespace ProjTwistingSheaf

variable {𝒜}

@[deprecated pow_mem_graded_one (since := "2026-11-09")]
theorem pow_mem_of_mem_one {f : A} (f_deg : f ∈ 𝒜 1) (k : ℕ) : f ^ k ∈ 𝒜 k :=
  pow_mem_graded_one 𝒜 f_deg k

theorem pow_mem_powers (f : A) (k : ℕ) : f ^ k ∈ Submonoid.powers f :=
  ⟨k, rfl⟩

variable {f : A} (f_deg : f ∈ 𝒜 1) (n : ℤ)

/-- The degree-`n` element `f^n` of `S(n)_(f)` for `f ∈ S_1`: the fraction `f^{n⁺} / f^{n⁻}`
with `n⁺ = max n 0` and `n⁻ = max (-n) 0`, which is `f^n / 1` for `n ≥ 0` and `1 / f^{-n}` for
`n < 0`. -/
def twistGenerator :
    HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) (Submonoid.powers f) :=
  HomogeneousLocalizedModule.mk (-n).toNat (f ^ n.toNat)
    ((mem_gradedTwist_of_eq (k := n.toNat) (by omega)).2 (pow_mem_graded_one _ f_deg _))
    (f ^ (-n).toNat) (pow_mem_graded_one _ f_deg _) (pow_mem_powers f _)

theorem twistGenerator_val :
    (twistGenerator f_deg n).val =
      LocalizedModule.mk (f ^ n.toNat) ⟨f ^ (-n).toNat, pow_mem_powers f _⟩ :=
  rfl

/-- Multiplication by `f^n` as an `S_(f)`-linear map `S_(f) → S(n)_(f)`. -/
def twistAwayMap :
    Away 𝒜 f →ₗ[Away 𝒜 f] HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) (Submonoid.powers f) :=
  LinearMap.toSpanSingleton (Away 𝒜 f) _ (twistGenerator f_deg n)

theorem twistAwayMap_apply (c : Away 𝒜 f) :
    twistAwayMap f_deg n c = c • twistGenerator f_deg n :=
  rfl

theorem twistAwayMap_injective : Function.Injective (twistAwayMap f_deg n) := by
  refine (injective_iff_map_eq_zero _).2 fun c hc => ?_
  obtain ⟨⟨i, ⟨a, ha⟩, ⟨b, hb⟩, hbx⟩, rfl⟩ := HomogeneousLocalization.mk_surjective c
  have hc' := congrArg HomogeneousLocalizedModule.val hc
  rw [twistAwayMap_apply, HomogeneousLocalizedModule.val_smul, twistGenerator_val,
    HomogeneousLocalization.val_mk, LocalizedModule.mk_smul_mk,
    HomogeneousLocalizedModule.val_zero, ← LocalizedModule.zero_mk 1,
    LocalizedModule.mk_eq] at hc'
  obtain ⟨⟨u, hu⟩, hu'⟩ := hc'
  simp only [one_smul, smul_zero, Submonoid.mk_smul, smul_eq_mul] at hu'
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_zero, ← Localization.mk_zero 1,
    Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨⟨u * f ^ n.toNat, mul_mem hu (pow_mem_powers f _)⟩, ?_⟩
  simp only [OneMemClass.coe_one, mul_zero]
  rw [← hu']
  ring

theorem twistAwayMap_surjective : Function.Surjective (twistAwayMap f_deg n) := by
  intro y
  obtain ⟨j, m, hm, s, hs, hsx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective y
  by_cases h : n + j < 0
  · refine ⟨0, ?_⟩
    rw [map_zero]
    ext
    rw [HomogeneousLocalizedModule.val_zero, HomogeneousLocalizedModule.val_mk,
      eq_zero_of_mem_gradedTwist hm h, LocalizedModule.zero_mk]
  have hnum : f ^ (-n).toNat * m ∈ 𝒜 (n.toNat + j) := by
    have := SetLike.GradedMul.mul_mem (pow_mem_graded_one _ f_deg (-n).toNat)
      (mem_of_mem_gradedTwist hm)
    convert this using 2
    omega
  have hden : f ^ n.toNat * s ∈ 𝒜 (n.toNat + j) :=
    SetLike.GradedMul.mul_mem (pow_mem_graded_one _ f_deg _) hs
  refine ⟨HomogeneousLocalization.mk ⟨n.toNat + j, ⟨_, hnum⟩, ⟨_, hden⟩,
    mul_mem (pow_mem_powers f _) hsx⟩, ?_⟩
  ext
  rw [twistAwayMap_apply, HomogeneousLocalizedModule.val_smul, twistGenerator_val,
    HomogeneousLocalization.val_mk, LocalizedModule.mk_smul_mk,
    HomogeneousLocalizedModule.val_mk, LocalizedModule.mk_eq]
  refine ⟨1, ?_⟩
  simp only [one_smul, Submonoid.mk_smul, Submonoid.mk_mul_mk, smul_eq_mul]
  ring

/-- **Multiplication by `f^n` trivializes the twist on `D₊(f)`** (proof of Hartshorne
II.5.12(a)): for `f ∈ S_1`, `c ↦ c · f^n` is an isomorphism of `S_(f)`-modules
`S_(f) ≅ S(n)_(f)`. -/
def twistAwayEquiv :
    Away 𝒜 f ≃ₗ[Away 𝒜 f] HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 n) (Submonoid.powers f) :=
  LinearEquiv.ofBijective (twistAwayMap f_deg n)
    ⟨twistAwayMap_injective f_deg n, twistAwayMap_surjective f_deg n⟩

theorem twistAwayEquiv_apply (c : Away 𝒜 f) :
    twistAwayEquiv f_deg n c = c • twistGenerator f_deg n :=
  rfl

/-- **The local trivialization in the proof of Hartshorne II.5.12(a).** For `f ∈ S_1`, under
the chart `Spec S_(f) ≅ D₊(f)`, the twisting sheaf `𝒪_X(n)` restricted to `D₊(f)` is isomorphic
to the structure sheaf: the chart isomorphism `𝒪_X(n)|_{D₊(f)} ≅ S(n)_(f)~` followed by the inverse of
multiplication by `f^n`, `S(n)_(f) ≅ S_(f)`. -/
def chartTrivialization :
    (Scheme.Modules.restrictFunctor (Proj.awayι 𝒜 f f_deg one_pos)).obj
        (projTwistingSheaf 𝒜 n) ≅ SheafOfModules.unit _ :=
  ProjGradedModuleSheaf.chartIso 𝒜 (gradedTwist 𝒜 n) f_deg one_pos ≪≫
    (tilde.functor (CommRingCat.of (Away 𝒜 f))).mapIso
      (twistAwayEquiv f_deg n).symm.toModuleIso ≪≫ tildeSelf

/-- The chart trivialization in the form of a free module of rank one. -/
def chartFreeIso :
    (Scheme.Modules.restrictFunctor (Proj.awayι 𝒜 f f_deg one_pos)).obj
        (projTwistingSheaf 𝒜 n) ≅ SheafOfModules.free (ULift.{u} (Fin 1)) :=
  ProjGradedModuleSheaf.chartIso 𝒜 (gradedTwist 𝒜 n) f_deg one_pos ≪≫
    (tilde.functor (CommRingCat.of (Away 𝒜 f))).mapIso
      ((twistAwayEquiv f_deg n).symm.trans
        (Finsupp.uniqueLinearEquiv (Away 𝒜 f) (Away 𝒜 f)
          (default : ULift.{u} (Fin 1))).symm).toModuleIso ≪≫
    tildeFinsupp (ULift.{u} (Fin 1))

variable (𝒜) in
/-- If `S` is generated by `S_1` as an `S_0`-algebra, every element of the irrelevant ideal is in
the ideal generated by `S_1`. -/
theorem irrelevant_le_span_one (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) :
    (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (𝒜 1 : Set A) := by
  intro x hx
  convert_to x - GradedRing.projZeroRingHom 𝒜 x ∈ _
  · rw [GradedRing.projZeroRingHom_apply, ← GradedRing.proj_apply,
      (HomogeneousIdeal.mem_irrelevant_iff _ _).mp hx, sub_zero]
  clear hx
  have hx : x ∈ Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) := hgen ▸ Algebra.mem_top
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    rw [GradedRing.projZeroRingHom_apply, DirectSum.decompose_of_mem_ne 𝒜 hx one_ne_zero,
      sub_zero]
    exact Ideal.subset_span hx
  | algebraMap r =>
    have hr : algebraMap (𝒜 0) A r ∈ 𝒜 0 := r.2
    rw [GradedRing.projZeroRingHom_apply, DirectSum.decompose_of_mem_same 𝒜 hr, sub_self]
    exact zero_mem _
  | add x y _ _ hx hy =>
    rw [map_add, add_sub_add_comm]
    exact add_mem hx hy
  | mul x y _ _ hx hy =>
    convert add_mem (Ideal.mul_mem_left _ x hy)
      (Ideal.mul_mem_right (GradedRing.projZeroRingHom 𝒜 y) _ hx) using 1
    rw [map_mul]
    ring

/-- **The `D₊(f)`, `f ∈ S_1`, cover `Proj S`** when `S` is generated by `S_1` as an
`S_0`-algebra: every point of `Proj S` lies outside some `f ∈ S_1`. -/
theorem exists_mem_one_notMem (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (x : Proj 𝒜) :
    ∃ f : A, f ∈ 𝒜 1 ∧ f ∉ x.asHomogeneousIdeal := by
  by_contra! H
  refine x.not_irrelevant_le fun z hz => ?_
  have h1 : Ideal.span (𝒜 1 : Set A) ≤ x.asHomogeneousIdeal.toIdeal :=
    Ideal.span_le.2 fun f hf => H f hf
  exact h1 (irrelevant_le_span_one 𝒜 hgen hz)

variable (𝒜) in
/-- Equivalently, **the open sets `D₊(f)`, `f ∈ S_1`, cover `Proj S`** when `S` is generated by
`S_1` as an `S_0`-algebra. -/
theorem iSup_basicOpen_one_eq_top (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) :
    ⨆ f : 𝒜 1, Proj.basicOpen 𝒜 (f : A) = ⊤ :=
  Proj.iSup_basicOpen_eq_top 𝒜 _ (by simpa using irrelevant_le_span_one 𝒜 hgen)

/-- `𝒪_X(n)` restricted to the open subscheme `D₊(f)` is free of rank one, for `f ∈ S_1`. -/
def restrictBasicOpenIso :
    (projTwistingSheaf 𝒜 n).restrict (Proj.basicOpen 𝒜 f).ι ≅
      SheafOfModules.free (ULift.{u} (Fin 1)) :=
  let F := projTwistingSheaf 𝒜 n
  let φ := (Proj.basicOpenIsoSpec 𝒜 f f_deg one_pos).hom
  ((Scheme.Modules.restrictFunctorCongr
      (ProjGradedModuleSheaf.basicOpenIsoSpec_hom_awayι f_deg one_pos)).app F).symm ≪≫
    (Scheme.Modules.restrictFunctorComp φ (Proj.awayι 𝒜 f f_deg one_pos)).app F ≪≫
    (Scheme.Modules.restrictFunctor φ).mapIso (chartFreeIso f_deg n) ≪≫
    Scheme.Modules.restrictFreeIso φ _

/-- **Hartshorne II.5.12(a).** If the graded ring `S` is generated by `S_1` as an `S_0`-algebra,
then every twisting sheaf `𝒪_X(n)` on `X = Proj S` is invertible. -/
theorem isInvertible (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℤ) :
    (projTwistingSheaf 𝒜 n).IsInvertible := by
  intro x
  obtain ⟨f, f_deg, hfx⟩ := exists_mem_one_notMem hgen x
  exact ⟨Proj.basicOpen 𝒜 f, hfx, ⟨restrictBasicOpenIso f_deg n⟩⟩

end ProjTwistingSheaf

end Hartshorne
