import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor

/-!
# The partial Proj morphism of a graded map

Hartshorne, *Algebraic Geometry*, II, Exercise 2.14(b) (pp. 80–81).

Let `φ : S →+*ᵍ T` be a degree-preserving homomorphism of `ℕ`-graded rings and
let `U = {𝔭 ∈ Proj T | 𝔭 ⊉ φ(S₊)}`. Then `U` is open, and `φ` determines a
morphism `U ⟶ Proj S` sending `𝔭` to `φ⁻¹(𝔭)`.

The open `U` is the union of the basic opens `D₊(φ(s))` for homogeneous `s` of
positive degree. On such a chart the morphism is the composite
`D₊(φ(s)) ≅ Spec T_(φ(s)) ⟶ Spec S_(s) ⟶ Proj S` induced by the map of
degree-zero localizations, and these chart morphisms glue.

The sense in which the morphism is natural is recorded by:

* compatibility with every standard chart: on `D₊(φ(s))` it is the morphism
  `D₊(φ(s)) ≅ Spec T_(φ(s)) ⟶ Spec S_(s) ⟶ Proj S` of the degree-zero
  localizations (`homOfLE_projPartialMap`, `awayι_comp_projPartialMap`);
* the action `𝔭 ↦ φ⁻¹(𝔭)` on points (`projPartialMap_apply`), hence the
  preimage of `D₊(s)` is `U ∩ D₊(φ(s))`;
* the everywhere-defined case: if `T₊` lies in the ideal generated by
  `φ(S₊)`, then `U = Proj T` and the morphism is the restriction of Mathlib's
  `Proj.map` (`projPartialDomain_eq_top`, `projPartialMap_eq_map`).
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits
open HomogeneousIdeal HomogeneousLocalization TopologicalSpace
open AlgebraicGeometry

universe u

namespace Hartshorne

variable {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)

/-- The natural domain `U = {𝔭 ∈ Proj T | 𝔭 ⊉ φ(S₊)}` of the partial Proj
morphism, as an open subset of `Proj T`. -/
def projPartialDomain : (Proj ℬ).Opens :=
  ⟨(ProjectiveSpectrum.zeroLocus ℬ ((f : A → B) '' (𝒜₊ : Set A)))ᶜ,
    (ProjectiveSpectrum.isClosed_zeroLocus _ _).isOpen_compl⟩

theorem mem_projPartialDomain_iff (x : Proj ℬ) :
    x ∈ projPartialDomain f ↔
      ¬ (f : A → B) '' (𝒜₊ : Set A) ⊆ (x.asHomogeneousIdeal : Set B) :=
  not_congr (ProjectiveSpectrum.mem_zeroLocus _ _ _)

/-- **Hartshorne II, Exercise 2.14(b), openness.** The set of relevant homogeneous
primes of `T` not containing `φ(S₊)` is open. -/
theorem isOpen_projPartialDomain :
    IsOpen {x : ProjectiveSpectrum ℬ |
      ¬ (f : A → B) '' (𝒜₊ : Set A) ⊆ (x.asHomogeneousIdeal : Set B)} :=
  (projPartialDomain f).isOpen

/-- Positive-degree homogeneous elements, the index type of the chart cover. -/
abbrev ProjPartialIndex (𝒜 : ℕ → σ) := Σ' (i : ℕ) (r : A), 0 < i ∧ r ∈ 𝒜 i

theorem basicOpen_le_projPartialDomain {i : ℕ} {r : A} (hi : 0 < i) (hr : r ∈ 𝒜 i) :
    Proj.basicOpen ℬ (f r) ≤ projPartialDomain f := by
  intro x hx
  rw [Proj.mem_basicOpen] at hx
  rw [mem_projPartialDomain_iff]
  intro h
  exact hx (h ⟨r, mem_irrelevant_of_mem 𝒜 hi hr, rfl⟩)

theorem projPartialDomain_eq_iSup :
    projPartialDomain f = ⨆ r : ProjPartialIndex 𝒜, Proj.basicOpen ℬ (f r.2.1) := by
  classical
  apply le_antisymm
  · intro x hx
    rw [mem_projPartialDomain_iff] at hx
    obtain ⟨_, ⟨a, ha, rfl⟩, hfa⟩ := Set.not_subset.mp hx
    by_contra hcon
    apply hfa
    rw [← DirectSum.sum_support_decompose 𝒜 a, map_sum]
    refine Ideal.sum_mem _ fun i _ => ?_
    by_cases hi0 : i = 0
    · subst hi0
      have h0 : (DirectSum.decompose 𝒜 a 0 : A) = 0 := (mem_irrelevant_iff 𝒜 a).mp ha
      rw [h0, map_zero]
      exact zero_mem _
    · by_contra hmem
      exact hcon (Opens.mem_iSup.mpr
        ⟨⟨i, _, Nat.pos_of_ne_zero hi0, SetLike.coe_mem _⟩, (Proj.mem_basicOpen _ _ _).mpr hmem⟩)
  · exact iSup_le fun r => basicOpen_le_projPartialDomain f r.2.2.1 r.2.2.2

/-- The cover of `U` by the charts `U ∩ D₊(φ(s))`. -/
def projPartialCover : (projPartialDomain f).toScheme.OpenCover :=
  Scheme.openCoverOfIsOpenCover _
    (fun r : ProjPartialIndex 𝒜 => (projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r.2.1)) (by
      change ⨆ r : ProjPartialIndex 𝒜, _ = ⊤
      rw [← Scheme.Hom.preimage_iSup, ← projPartialDomain_eq_iSup,
        Scheme.Opens.ι_preimage_self])

/-- The chart morphism `U ∩ D₊(φ(r)) ⟶ Spec T_(φ(r)) ⟶ Spec S_(r) ⟶ Proj S`. -/
def projPartialChart {i : ℕ} (r : A) (hr : r ∈ 𝒜 i) (hi : 0 < i) :
    ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r)).toScheme ⟶ Proj 𝒜 :=
  (projPartialDomain f).ι.resLE (Proj.basicOpen ℬ (f r)) _ le_rfl ≫
    Proj.basicOpenToSpec ℬ (f r) ≫ Spec.map (CommRingCat.ofHom (Away.map f r)) ≫
      Proj.awayι 𝒜 r hr hi

theorem awayMap_comp_awayMap {i j : ℕ} {r s x : A} (hr : r ∈ 𝒜 i) (hs : s ∈ 𝒜 j)
    (hx : x = r * s) :
    (awayMap ℬ (f.map_mem hs) (by rw [hx, map_mul] : f x = f r * f s)).comp (Away.map f r) =
      (Away.map f x).comp (awayMap 𝒜 hs hx) := by
  ext z
  obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 hr z
  simp only [RingHom.comp_apply, Away.map_mk, awayMap_mk, Away.val_mk, map_mul, map_pow]
  rfl

theorem preimage_basicOpen_mul_le {r s x : A} (hx : x = r * s) :
    (projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f x) ≤
      (projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r) :=
  fun _ hy => Proj.basicOpen_mono ℬ _ _ ⟨f s, by rw [hx, map_mul]⟩ hy

/-- The chart morphisms are compatible with shrinking `D₊(φ(r))` to
`D₊(φ(rs))`. -/
theorem homOfLE_projPartialChart {i j : ℕ} {r s x : A} (hr : r ∈ 𝒜 i) (hi : 0 < i)
    (hs : s ∈ 𝒜 j) (hx : x = r * s) :
    (projPartialDomain f).toScheme.homOfLE (preimage_basicOpen_mul_le f hx) ≫
        projPartialChart f r hr hi =
      projPartialChart f x (hx ▸ SetLike.mul_mem_graded hr hs)
        (hi.trans_le (Nat.le_add_right i j)) := by
  have hfx : f x = f r * f s := by rw [hx, map_mul]
  simp only [projPartialChart, Scheme.Hom.map_resLE_assoc]
  rw [← Scheme.Hom.resLE_map_assoc _ _ (Proj.basicOpen_mono ℬ _ _ ⟨f s, hfx⟩)]
  congr 1
  rw [← Proj.basicOpenToSpec_SpecMap_awayMap_assoc ℬ (f.map_mem hs) hfx]
  congr 1
  rw [← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp, awayMap_comp_awayMap f hr hs hx,
    CommRingCat.ofHom_comp, Spec.map_comp_assoc, Proj.SpecMap_awayMap_awayι 𝒜 hr hi hs hx]
  exact le_rfl

theorem preimage_basicOpen_inf (a b : A) :
    (projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f a) ⊓
        (projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f b) =
      (projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f (a * b)) := by
  rw [map_mul, Proj.basicOpen_mul]
  rfl

theorem projPartialChart_pullback_condition (x y : ProjPartialIndex 𝒜) :
    pullback.fst ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f x.2.1)).ι
          ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f y.2.1)).ι ≫
        projPartialChart f x.2.1 x.2.2.2 x.2.2.1 =
      pullback.snd ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f x.2.1)).ι
          ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f y.2.1)).ι ≫
        projPartialChart f y.2.1 y.2.2.2 y.2.2.1 := by
  have h := isPullback_opens_inf ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f x.2.1))
    ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f y.2.1))
  rw [← cancel_epi h.isoPullback.hom, h.isoPullback_hom_fst_assoc, h.isoPullback_hom_snd_assoc]
  have k1 : (projPartialDomain f).toScheme.homOfLE inf_le_left =
      (projPartialDomain f).toScheme.homOfLE (preimage_basicOpen_inf f x.2.1 y.2.1).le ≫
        (projPartialDomain f).toScheme.homOfLE (preimage_basicOpen_mul_le f rfl) := by
    simp
  have k2 : (projPartialDomain f).toScheme.homOfLE inf_le_right =
      (projPartialDomain f).toScheme.homOfLE (preimage_basicOpen_inf f x.2.1 y.2.1).le ≫
        (projPartialDomain f).toScheme.homOfLE (preimage_basicOpen_mul_le f (mul_comm _ _)) := by
    simp
  rw [k1, k2, Category.assoc, Category.assoc,
    homOfLE_projPartialChart f x.2.2.2 x.2.2.1 y.2.2.2 rfl,
    homOfLE_projPartialChart f y.2.2.2 y.2.2.1 x.2.2.2 (mul_comm _ _)]
  rfl

/-- **Hartshorne II, Exercise 2.14(b).** The morphism `U ⟶ Proj S` induced by a
degree-preserving homomorphism `φ : S →+*ᵍ T`, defined on the natural domain
`U = {𝔭 | 𝔭 ⊉ φ(S₊)}` by gluing the chart morphisms. -/
def projPartialMap : (projPartialDomain f).toScheme ⟶ Proj 𝒜 :=
  (projPartialCover f).glueMorphisms (fun r => projPartialChart f r.2.1 r.2.2.2 r.2.2.1)
    (fun x y => projPartialChart_pullback_condition f x y)

/-- On the chart `U ∩ D₊(φ(r))`, the partial morphism is the chart morphism. -/
@[reassoc]
theorem projPartialCover_f_projPartialMap {i : ℕ} (r : A) (hr : r ∈ 𝒜 i) (hi : 0 < i) :
    ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r)).ι ≫ projPartialMap f =
      projPartialChart f r hr hi :=
  (projPartialCover f).ι_glueMorphisms _ _ ⟨i, r, hi, hr⟩

section Points

set_option backward.isDefEq.respectTransparency.types false in
/-- On points, Mathlib's chart morphism `D₊(g) ⟶ Spec T_(g)` agrees with the
locally ringed space morphism of the Proj construction. -/
theorem basicOpenToSpec_toLRSHom (g : B) :
    Scheme.forgetToLocallyRingedSpace.map (Proj.basicOpenToSpec ℬ g) =
      ProjectiveSpectrum.Proj.toSpec ℬ g := by
  refine Eq.trans ?_ (ΓSpec.locallyRingedSpaceAdjunction.homEquiv_apply _ _ _).symm
  dsimp [Proj.basicOpenToSpec, Scheme.Opens.toSpecΓ]
  simp only [Category.assoc, ← Spec.map_comp]
  rfl

theorem basicOpenToSpec_apply (g : B) (z : (Proj.basicOpen ℬ g).toScheme) :
    Proj.basicOpenToSpec ℬ g z = (ProjectiveSpectrum.Proj.toSpec ℬ g).base z := by
  rw [← basicOpenToSpec_toLRSHom]
  rfl

/-- The point of `Spec T_(g)` attached to `𝔭 ∈ D₊(g)` contains `a / gⁿ` exactly
when `a ∈ 𝔭`. -/
theorem away_mk_mem_basicOpenToSpec_iff {g : B} {m : ℕ} (hg : g ∈ ℬ m)
    (z : (Proj.basicOpen ℬ g).toScheme) (n : ℕ) (a : B) (ha : a ∈ ℬ (n • m)) :
    Away.mk ℬ hg n a ha ∈ (Proj.basicOpenToSpec ℬ g z).asIdeal ↔
      a ∈ z.1.asHomogeneousIdeal := by
  rw [basicOpenToSpec_apply]
  exact ProjectiveSpectrum.Proj.mk_mem_toSpec_base_apply ℬ z _

theorem awayι_basicOpenToSpec_apply {r : A} {i : ℕ} (hr : r ∈ 𝒜 i) (hi : 0 < i)
    (z : (Proj.basicOpen 𝒜 r).toScheme) :
    Proj.awayι 𝒜 r hr hi (Proj.basicOpenToSpec 𝒜 r z) = z.1 := by
  rw [← Proj.basicOpenIsoSpec_hom 𝒜 r hr hi, Proj.awayι, ← Scheme.Hom.comp_apply,
    Iso.hom_inv_id_assoc]
  rfl

/-- The point `φ⁻¹(𝔭)` of `Proj S`, for `𝔭 ∈ U`. -/
def projPartialComapPoint (x : Proj ℬ) (hx : x ∈ projPartialDomain f) : Proj 𝒜 where
  asHomogeneousIdeal := x.asHomogeneousIdeal.comap f
  isPrime := x.isPrime.comap f
  not_irrelevant_le h := (mem_projPartialDomain_iff f x).mp hx (by
    rintro _ ⟨a, ha, rfl⟩
    exact h ha)

theorem projPartialChart_apply {i : ℕ} (r : A) (hr : r ∈ 𝒜 i) (hi : 0 < i)
    (y : ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r)).toScheme) :
    projPartialChart f r hr hi y =
      projPartialComapPoint f ((projPartialDomain f).ι y.1) y.1.2 := by
  let z := (projPartialDomain f).ι.resLE (Proj.basicOpen ℬ (f r)) _ le_rfl y
  have hz : z.1 = (projPartialDomain f).ι y.1 := by
    change ((projPartialDomain f).ι.resLE (Proj.basicOpen ℬ (f r)) _ le_rfl ≫
      (Proj.basicOpen ℬ (f r)).ι) y = _
    rw [Scheme.Hom.resLE_comp_ι]
    rfl
  have hp : projPartialComapPoint f ((projPartialDomain f).ι y.1) y.1.2 ∈
      Proj.basicOpen 𝒜 r := by
    have h2 : (projPartialDomain f).ι y.1 ∈ Proj.basicOpen ℬ (f r) := by
      rw [← hz]
      exact z.2
    rw [Proj.mem_basicOpen] at h2 ⊢
    exact h2
  have key : Spec.map (CommRingCat.ofHom (Away.map f r)) (Proj.basicOpenToSpec ℬ (f r) z) =
      Proj.basicOpenToSpec 𝒜 r ⟨_, hp⟩ := by
    refine PrimeSpectrum.ext (Ideal.ext fun w => ?_)
    obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 hr w
    rw [Spec.map_apply]
    change Away.map f r (Away.mk 𝒜 hr n a ha) ∈ (Proj.basicOpenToSpec ℬ (f r) z).asIdeal ↔ _
    rw [Away.map_mk, away_mk_mem_basicOpenToSpec_iff,
      away_mk_mem_basicOpenToSpec_iff hr ⟨_, hp⟩ n a ha, hz]
    rfl
  simp only [projPartialChart, Scheme.Hom.comp_apply]
  change Proj.awayι 𝒜 r hr hi (Spec.map (CommRingCat.ofHom (Away.map f r))
    (Proj.basicOpenToSpec ℬ (f r) z)) = _
  rw [key]
  exact awayι_basicOpenToSpec_apply hr hi _

/-- **Hartshorne II, Exercise 2.14(b), action on points.** The partial morphism
sends `𝔭 ∈ U` to `φ⁻¹(𝔭)`. -/
theorem projPartialMap_apply (x : (projPartialDomain f).toScheme) :
    projPartialMap f x = projPartialComapPoint f ((projPartialDomain f).ι x) x.2 := by
  obtain ⟨⟨i, r, hi, hr⟩, y, rfl⟩ := (projPartialCover f).exists_eq x
  rw [← Scheme.Hom.comp_apply]
  erw [projPartialCover_f_projPartialMap f r hr hi]
  exact projPartialChart_apply f r hr hi y

theorem projPartialMap_apply_asHomogeneousIdeal (x : (projPartialDomain f).toScheme) :
    (projPartialMap f x).asHomogeneousIdeal =
      ((projPartialDomain f).ι x).asHomogeneousIdeal.comap f := by
  rw [projPartialMap_apply]
  rfl

/-- The preimage of a basic open `D₊(s)` under the partial morphism is
`U ∩ D₊(φ(s))`. -/
theorem projPartialMap_preimage_basicOpen (a : A) :
    projPartialMap f ⁻¹ᵁ Proj.basicOpen 𝒜 a =
      (projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f a) := by
  ext x
  change projPartialMap f x ∈ Proj.basicOpen 𝒜 a ↔
    (projPartialDomain f).ι x ∈ Proj.basicOpen ℬ (f a)
  rw [Proj.mem_basicOpen, Proj.mem_basicOpen, projPartialMap_apply]
  rfl

end Points

section Charts

/-- **Compatibility with the standard charts.** On `D₊(φ(r)) ⊆ U` the partial
morphism is `D₊(φ(r)) ≅ Spec T_(φ(r)) ⟶ Spec S_(r) ⟶ Proj S`, induced by the
map of degree-zero localizations. -/
theorem homOfLE_projPartialMap {i : ℕ} {r : A} (hr : r ∈ 𝒜 i) (hi : 0 < i) :
    (Proj ℬ).homOfLE (basicOpen_le_projPartialDomain f hi hr) ≫ projPartialMap f =
      (Proj.basicOpenIsoSpec ℬ (f r) (f.map_mem hr) hi).hom ≫
        Spec.map (CommRingCat.ofHom (Away.map f r)) ≫ Proj.awayι 𝒜 r hr hi := by
  set j := (Proj ℬ).homOfLE (basicOpen_le_projPartialDomain f hi hr)
  have hle : (⊤ : (Proj.basicOpen ℬ (f r)).toScheme.Opens) ≤
      j ⁻¹ᵁ ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r)) := by
    intro x _
    change (j ≫ (projPartialDomain f).ι) x ∈ Proj.basicOpen ℬ (f r)
    rw [Scheme.homOfLE_ι]
    exact x.2
  have hj : j = (Proj.basicOpen ℬ (f r)).toScheme.topIso.inv ≫
      j.resLE _ ⊤ hle ≫ ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r)).ι := by
    rw [Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.toIso_inv_ι, Category.id_comp]
  have hid : (Proj.basicOpen ℬ (f r)).toScheme.topIso.inv ≫
      (j ≫ (projPartialDomain f).ι).resLE (Proj.basicOpen ℬ (f r)) ⊤ (by
        intro x _
        change (j ≫ (projPartialDomain f).ι) x ∈ Proj.basicOpen ℬ (f r)
        rw [Scheme.homOfLE_ι]
        exact x.2) = 𝟙 _ := by
    rw [← cancel_mono (Proj.basicOpen ℬ (f r)).ι, Category.assoc,
      Scheme.Hom.resLE_comp_ι]
    simp [j]
  rw [hj, Category.assoc, Category.assoc, projPartialCover_f_projPartialMap f r hr hi,
    projPartialChart, Scheme.Hom.resLE_comp_resLE_assoc, ← Category.assoc, hid,
    Category.id_comp, Proj.basicOpenIsoSpec_hom]

/-- The chart compatibility in the form of Mathlib's `Proj.awayι_comp_map`. -/
theorem awayι_comp_projPartialMap {i : ℕ} {r : A} (hr : r ∈ 𝒜 i) (hi : 0 < i) :
    (Proj.basicOpenIsoSpec ℬ (f r) (f.map_mem hr) hi).inv ≫
        (Proj ℬ).homOfLE (basicOpen_le_projPartialDomain f hi hr) ≫ projPartialMap f =
      Spec.map (CommRingCat.ofHom (Away.map f r)) ≫ Proj.awayι 𝒜 r hr hi := by
  rw [homOfLE_projPartialMap, Iso.inv_hom_id_assoc]

end Charts

section EverywhereDefined

variable {f}

/-- If `T₊ ≤ φ(S₊)T`, the natural domain is all of `Proj T`. -/
theorem projPartialDomain_eq_top (hf : ℬ₊ ≤ 𝒜₊.map f) : projPartialDomain f = ⊤ := by
  refine eq_top_iff.mpr fun x _ => ?_
  rw [mem_projPartialDomain_iff]
  intro h
  exact x.not_irrelevant_le (hf.trans (map_le_of_le_comap _ fun a ha => h ⟨a, ha, rfl⟩))

/-- **The everywhere-defined case.** If `T₊ ≤ φ(S₊)T`, the partial morphism is the
restriction of Mathlib's `Proj.map`. -/
theorem projPartialMap_eq_map (hf : ℬ₊ ≤ 𝒜₊.map f) :
    projPartialMap f = (projPartialDomain f).ι ≫ Proj.map f hf := by
  refine (projPartialCover f).hom_ext _ _ fun r => ?_
  obtain ⟨i, r, hi, hr⟩ := r
  have hmap : (Proj.basicOpen ℬ (f r)).ι ≫ Proj.map f hf =
      Proj.basicOpenToSpec ℬ (f r) ≫ Spec.map (CommRingCat.ofHom (Away.map f r)) ≫
        Proj.awayι 𝒜 r hr hi := by
    have h := Proj.awayι_comp_map f hf hi r hr
    rw [Proj.awayι, Category.assoc, Iso.inv_comp_eq, Proj.basicOpenIsoSpec_hom] at h
    exact h
  change ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r)).ι ≫ projPartialMap f =
    ((projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r)).ι ≫ (projPartialDomain f).ι ≫
      Proj.map f hf
  rw [projPartialCover_f_projPartialMap f r hr hi, ← Category.assoc,
    ← Scheme.Hom.resLE_comp_ι _ (le_rfl :
      (projPartialDomain f).ι ⁻¹ᵁ Proj.basicOpen ℬ (f r) ≤ _), Category.assoc, hmap]
  rfl

end EverywhereDefined

end Hartshorne
