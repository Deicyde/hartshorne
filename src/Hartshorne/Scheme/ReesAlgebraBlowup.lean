import Mathlib.RingTheory.ReesAlgebra
import Hartshorne.Scheme.RelativeProj
import Hartshorne.Scheme.ModuleIdealSheafData
import Hartshorne.Scheme.CoherentAffineLocalCriterion

/-!
# The sheaf of Rees algebras and the blowing-up

Hartshorne, *Algebraic Geometry*, II.7, p. 163 (see also Stacks Project, tag 01OF).

Let `X` be a Noetherian scheme and `I` a coherent sheaf of ideals on `X`. The sheaf of graded
`𝒪_X`-algebras `𝒮 = ⨁_{d ≥ 0} Iᵈ` (with `I⁰ = 𝒪_X`) is quasi-coherent and satisfies the
hypotheses of relative `Proj`; the *blowing-up* of `X` with respect to `I` is `X̃ = Proj_X 𝒮`
with its projection `π : X̃ ⟶ X`. For a morphism `f : Y ⟶ X`, the *inverse image ideal sheaf*
`f⁻¹I · 𝒪_Y` is the image of `f^*I → 𝒪_Y`; it is a sheaf of ideals of `𝒪_Y`, in general different
from the module `f^*I`.

## Encoding

Quasi-coherent graded algebras are recorded on affine opens (`QuasiCoherentGradedAlgebra`). Over
an affine open `U`, `Γ(U, ⨁_d Iᵈ)` is Mathlib's Rees algebra `reesAlgebra Γ(U, I)`, the
subalgebra `⨁_d Γ(U, I)ᵈ tᵈ` of `Γ(U, 𝒪_X)[t]`, graded by the degree in `t` (`reesGrading`).
Restriction to a basic open `D(r) ⊆ U` acts on coefficients, and it is the localization at `r`
because `Γ(D(r), I) = Γ(U, I)_r` and localization commutes with ideal powers
(`reesMap_isLocalizationAway`).

## Main definitions and results

* `reesAlgebraSheaf`: the quasi-coherent graded algebra `⨁_d Jᵈ` of ideal sheaf data `J`.
* `QuasicoherentIdealSubsheaf.reesAlgebra`: the same for a quasi-coherent ideal subsheaf `I`;
  `mem_reesAlgebra_grading_iff`: its degree-`d` sections over `U` are the `a tᵈ`, `a ∈ Γ(U, I)ᵈ`.
* `ReesAlgebraSheaf.degreeZeroIsStructureSheaf`, `degreeOneCoherent`, `generatedInDegreeOne`:
  `𝒮₀ = 𝒪_X`, `𝒮₁ = I` is coherent, and `𝒮` is generated by `𝒮₁`.
* `QuasicoherentIdealSubsheaf.blowupData`, `blowup`, `blowupProjection`: for a coherent `I` on a
  Noetherian `X`, the relative `Proj` data of `⨁_d Iᵈ`, the blowing-up `Proj_X (⨁_d Iᵈ)`, and its
  projection to `X`.
* `inverseImageIdeal`, `QuasicoherentIdealSubsheaf.inverseImage`: the inverse image ideal sheaf
  `f⁻¹I · 𝒪_Y`, the image of `f^*I → 𝒪_Y`: on affine opens `V ⊆ X`, `U ⊆ f⁻¹V` its sections are
  `f^♯(Γ(V, I)) · Γ(U, 𝒪_Y)` (`inverseImageIdeal_ideal`), and it is the smallest quasi-coherent
  ideal sheaf containing these (`inverseImageIdeal_le_iff`).
-/

noncomputable section

open CategoryTheory Polynomial AlgebraicGeometry

universe u

namespace Hartshorne

section Algebra

variable {R S : Type*} [CommRing R] [CommRing S] (I : Ideal R)

/-- The degree-`n` part `Iⁿ tⁿ` of the Rees algebra `R[It] = ⨁ₙ Iⁿ tⁿ ⊆ R[t]`: the elements of
the Rees algebra which are monomials of degree `n`. -/
def reesGrading (n : ℕ) : AddSubgroup (reesAlgebra I) where
  carrier := {p | ∀ m, m ≠ n → (p : R[X]).coeff m = 0}
  add_mem' {p q} hp hq m hm := by
    simp [Subalgebra.coe_add, coeff_add, hp m hm, hq m hm]
  zero_mem' m _ := by simp
  neg_mem' {p} hp m hm := by
    simp [hp m hm]

variable {I} in
theorem mem_reesGrading {n : ℕ} {p : reesAlgebra I} :
    p ∈ reesGrading I n ↔ ∀ m, m ≠ n → (p : R[X]).coeff m = 0 :=
  Iff.rfl

variable {I} in
theorem mem_reesGrading_iff {n : ℕ} {p : reesAlgebra I} :
    p ∈ reesGrading I n ↔ (p : R[X]) = monomial n ((p : R[X]).coeff n) := by
  rw [mem_reesGrading]
  constructor
  · intro h
    ext m
    rw [coeff_monomial]
    split_ifs with hm
    · rw [hm]
    · exact h m (Ne.symm hm)
  · intro h m hm
    rw [h, coeff_monomial, if_neg (Ne.symm hm)]

/-- The degree-`n` component `p ↦ pₙ tⁿ` of an element of the Rees algebra. -/
def reesComponent (n : ℕ) : reesAlgebra I →+ reesGrading I n where
  toFun p := ⟨⟨monomial n ((p : R[X]).coeff n),
      reesAlgebra.monomial_mem.2 ((mem_reesAlgebra_iff I _).1 p.2 n)⟩,
    fun m hm => by simp [coeff_monomial, Ne.symm hm]⟩
  map_zero' := by ext; simp
  map_add' p q := by ext; simp

theorem coe_reesComponent (n : ℕ) (p : reesAlgebra I) :
    ((reesComponent I n p : reesAlgebra I) : R[X]) = monomial n ((p : R[X]).coeff n) :=
  rfl

/-- The decomposition of an element of the Rees algebra into its homogeneous components. -/
def reesDecompose (p : reesAlgebra I) : DirectSum ℕ fun n => reesGrading I n :=
  DFinsupp.mk (p : R[X]).support fun n => reesComponent I n.1 p

theorem reesDecompose_apply (p : reesAlgebra I) (n : ℕ) :
    reesDecompose I p n = reesComponent I n p := by
  rw [reesDecompose, DFinsupp.mk_apply]
  split_ifs with h
  · rfl
  · ext
    rw [coe_reesComponent, notMem_support_iff.1 h, map_zero]
    rfl

theorem reesDecompose_support_subset [∀ (i : ℕ) (x : reesGrading I i), Decidable (x ≠ 0)]
    (p : reesAlgebra I) : (reesDecompose I p).support ⊆ (p : R[X]).support :=
  DFinsupp.support_mk_subset

/-- The decomposition of the Rees algebra into its homogeneous components, as an additive map. -/
def reesDecomposeHom : reesAlgebra I →+ DirectSum ℕ fun n => reesGrading I n where
  toFun := reesDecompose I
  map_zero' := DFinsupp.ext fun n => by rw [reesDecompose_apply, map_zero]; rfl
  map_add' p q := DFinsupp.ext fun n => by
    rw [reesDecompose_apply, map_add, DFinsupp.add_apply, reesDecompose_apply,
      reesDecompose_apply]

instance reesGrading_gradedMonoid : SetLike.GradedMonoid (reesGrading I) where
  one_mem m hm := by
    change (1 : R[X]).coeff m = 0
    rw [coeff_one, if_neg hm]
  mul_mem {i j p q} hp hq := by
    rw [mem_reesGrading_iff] at hp hq
    rw [mem_reesGrading]
    intro m hm
    change ((p : R[X]) * q).coeff m = 0
    rw [hp, hq, monomial_mul_monomial, coeff_monomial, if_neg (Ne.symm hm)]

open DirectSum in
/-- The Rees algebra `R[It] = ⨁ₙ Iⁿ tⁿ` is graded by the degree in `t`. -/
instance reesGrading_gradedRing : GradedRing (reesGrading I) where
  __ := reesGrading_gradedMonoid I
  __ := Decomposition.ofAddHom (reesGrading I) (reesDecomposeHom I)
    (by
      classical
      refine AddMonoidHom.ext fun p => Subtype.ext ?_
      change ((DirectSum.coeAddMonoidHom (reesGrading I) (reesDecompose I p) : reesAlgebra I) :
        R[X]) = p
      rw [coeAddMonoidHom_eq_dfinsuppSum,
        DFinsupp.sum_of_support_subset (reesDecompose_support_subset I p) (fun _ _ => rfl)]
      conv_rhs => rw [(p : R[X]).as_sum_support]
      rw [AddSubmonoidClass.coe_finsetSum]
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [reesDecompose_apply, coe_reesComponent])
    (by
      apply DirectSum.addHom_ext
      intro i y
      refine DFinsupp.ext fun n => ?_
      rw [AddMonoidHom.comp_apply, DirectSum.coeAddMonoidHom_of, AddMonoidHom.id_apply]
      change reesDecompose I y n = _
      rw [reesDecompose_apply]
      by_cases h : n = i
      · subst h
        rw [DirectSum.of_eq_same]
        ext
        rw [coe_reesComponent, ← mem_reesGrading_iff.1 y.2]
      · rw [DirectSum.of_eq_of_ne _ _ _ h]
        ext
        rw [coe_reesComponent, y.2 n h, map_zero]
        rfl)

theorem coe_algebraMap_reesAlgebra (r : R) :
    ((algebraMap R (reesAlgebra I) r : reesAlgebra I) : R[X]) = C r :=
  rfl

theorem algebraMap_mem_reesGrading_zero (r : R) :
    algebraMap R (reesAlgebra I) r ∈ reesGrading I 0 :=
  fun m hm => by rw [coe_algebraMap_reesAlgebra, coeff_C, if_neg hm]

/-- The degree-zero part of the Rees algebra is `R`: the map `r ↦ r t⁰` is bijective onto it. -/
theorem bijective_reesGrading_zero :
    Function.Bijective fun r : R =>
      (⟨algebraMap R (reesAlgebra I) r, algebraMap_mem_reesGrading_zero I r⟩ :
        reesGrading I 0) := by
  refine ⟨fun r s h => ?_, fun x => ⟨(x : R[X]).coeff 0, ?_⟩⟩
  · have := congrArg (fun x : reesGrading I 0 => ((x : reesAlgebra I) : R[X])) h
    exact C_injective this
  · ext : 2
    change C _ = _
    rw [← monomial_zero_left, ← mem_reesGrading_iff.1 x.2]

/-- If `I` is generated by `g₁, …, g_k`, the degree-one part `I t` of the Rees algebra is
generated over `R` by `g₁ t, …, g_k t`. -/
theorem exists_reesGrading_one_generators (hI : I.FG) :
    ∃ (k : ℕ) (m : Fin k → reesAlgebra I), (∀ i, m i ∈ reesGrading I 1) ∧
      ∀ x ∈ reesGrading I 1, ∃ c : Fin k → R,
        x = ∑ i, algebraMap R (reesAlgebra I) (c i) * m i := by
  obtain ⟨k, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.1 hI
  have hgI : ∀ i, g i ∈ I := fun i => hg ▸ Submodule.subset_span (Set.mem_range_self i)
  refine ⟨k, fun i => ⟨monomial 1 (g i), reesAlgebra.monomial_mem.2 (by rw [pow_one]; exact hgI i)⟩,
    fun i m hm => by simp [coeff_monomial, Ne.symm hm], fun x hx => ?_⟩
  have hx1 : (x : R[X]).coeff 1 ∈ Submodule.span R (Set.range g) := by
    rw [hg]
    simpa using (mem_reesAlgebra_iff I _).1 x.2 1
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 hx1
  refine ⟨c, Subtype.ext ?_⟩
  rw [AddSubmonoidClass.coe_finsetSum, mem_reesGrading_iff.1 hx, ← hc, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  change monomial 1 (c i • g i) = C (c i) * monomial 1 (g i)
  rw [C_mul_monomial, smul_eq_mul]

/-- The Rees algebra is generated by its homogeneous elements of degrees zero and one. -/
theorem closure_reesGrading_zero_union_one :
    Subring.closure ((reesGrading I 0 : Set (reesAlgebra I)) ∪ reesGrading I 1) = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  let T : Set (reesAlgebra I) := (reesGrading I 0 : Set (reesAlgebra I)) ∪ reesGrading I 1
  have hx : (x : R[X]) ∈ (Subring.closure T).map (reesAlgebra I).val.toRingHom := by
    rw [RingHom.map_closure]
    have hadj : (x : R[X]) ∈ Algebra.adjoin R
        (Submodule.map (monomial 1 : R →ₗ[R] R[X]) I : Set R[X]) := by
      rw [adjoin_monomial_eq_reesAlgebra]
      exact x.2
    rw [← Subalgebra.mem_toSubring, Algebra.adjoin_eq_ring_closure] at hadj
    refine Subring.closure_mono ?_ hadj
    rintro _ (⟨r, rfl⟩ | ⟨a, ha, rfl⟩)
    · exact ⟨algebraMap R (reesAlgebra I) r, Or.inl (algebraMap_mem_reesGrading_zero I r), rfl⟩
    · refine ⟨⟨monomial 1 a, reesAlgebra.monomial_mem.2 (by rwa [pow_one])⟩, Or.inr ?_, rfl⟩
      intro m hm
      change (monomial 1 a).coeff m = 0
      rw [coeff_monomial, if_neg (Ne.symm hm)]
  obtain ⟨y, hy, hyx⟩ := hx
  obtain rfl : y = x := Subtype.ext hyx
  exact hy

variable {I}

theorem reesMap_mem (φ : R →+* S) {J : Ideal S} (h : I.map φ ≤ J) (p : reesAlgebra I) :
    (p : R[X]).map φ ∈ reesAlgebra J := fun n => by
  rw [coeff_map]
  exact Ideal.pow_right_mono h n
    (Ideal.map_pow φ I n ▸ Ideal.mem_map_of_mem φ ((mem_reesAlgebra_iff I _).1 p.2 n))

/-- The map of Rees algebras `R[It] → S[Jt]` induced by a ring map `φ : R → S` with
`φ(I) ⊆ J`, acting on coefficients. -/
def reesMap (φ : R →+* S) {J : Ideal S} (h : I.map φ ≤ J) : reesAlgebra I →+* reesAlgebra J :=
  ((mapRingHom φ).comp (reesAlgebra I).val.toRingHom).codRestrict (reesAlgebra J)
    (reesMap_mem φ h)

theorem coe_reesMap (φ : R →+* S) {J : Ideal S} (h : I.map φ ≤ J) (p : reesAlgebra I) :
    (reesMap φ h p : S[X]) = (p : R[X]).map φ :=
  rfl

theorem reesMap_eq_id (φ : R →+* R) (hφ : φ = RingHom.id R) (h : I.map φ ≤ I) :
    reesMap φ h = RingHom.id _ := by
  subst hφ
  ext p : 2
  simp [coe_reesMap]

theorem reesMap_comp_reesMap {T : Type*} [CommRing T] {J : Ideal S} {K : Ideal T}
    (φ : R →+* S) (ψ : S →+* T) (χ : R →+* T) (hχ : χ = ψ.comp φ) (h₁ : I.map φ ≤ J)
    (h₂ : J.map ψ ≤ K) (h₃ : I.map χ ≤ K) :
    (reesMap ψ h₂).comp (reesMap φ h₁) = reesMap χ h₃ := by
  subst hχ
  ext p : 2
  simp [coe_reesMap, Polynomial.map_map]

theorem reesMap_mem_reesGrading (φ : R →+* S) {J : Ideal S} (h : I.map φ ≤ J) {n : ℕ}
    {p : reesAlgebra I} (hp : p ∈ reesGrading I n) : reesMap φ h p ∈ reesGrading J n :=
  fun m hm => by rw [coe_reesMap, coeff_map, hp m hm, map_zero]

/-- The Rees algebra is compatible with localization: if `S = R[1/r]` and `J = I S`, then
`S[Jt] = R[It][1/r]`. -/
theorem reesMap_isLocalizationAway (φ : R →+* S) {J : Ideal S} (hJ : I.map φ = J) (r : R)
    (hφ : letI := φ.toAlgebra; IsLocalization.Away r S) :
    letI := (reesMap φ hJ.le).toAlgebra
    IsLocalization.Away (algebraMap R (reesAlgebra I) r) (reesAlgebra J) := by
  let := φ.toAlgebra
  let := (reesMap φ hJ.le).toAlgebra
  have hu : IsUnit (φ r) := IsLocalization.Away.algebraMap_isUnit (S := S) r
  have hC : ∀ a : R, (algebraMap (reesAlgebra I) (reesAlgebra J) (algebraMap R _ a) : S[X]) =
      C (φ a) := fun a => by
    change ((algebraMap R (reesAlgebra I) a : R[X])).map φ = _
    simp
  refine (isLocalization_iff _ _).2 ⟨?_, ?_, ?_⟩
  · rintro ⟨_, k, rfl⟩
    rw [map_pow]
    refine IsUnit.pow k (IsUnit.of_mul_eq_one
      (⟨C (hu.unit⁻¹ : Sˣ).1, (reesAlgebra J).algebraMap_mem _⟩ : reesAlgebra J) (Subtype.ext ?_))
    change (algebraMap (reesAlgebra I) (reesAlgebra J) (algebraMap R _ r) : S[X]) * _ = 1
    rw [hC, ← C_mul, IsUnit.mul_val_inv, C_1]
  · intro z
    -- Every element of `S[Jt]` has the form `p / rᵏ` with `p ∈ R[It]`.
    let P : S[X] → Prop := fun q => ∃ p ∈ reesAlgebra I, ∃ k : ℕ, q * C (φ r ^ k) = p.map φ
    have hP : P (z : S[X]) := by
      rw [(z : S[X]).as_sum_support]
      refine Finset.sum_induction _ P ?_ ⟨0, zero_mem _, 0, by simp⟩ ?_
      · rintro q₁ q₂ ⟨p₁, hp₁, k₁, h₁⟩ ⟨p₂, hp₂, k₂, h₂⟩
        refine ⟨p₁ * C (r ^ k₂) + p₂ * C (r ^ k₁),
          add_mem (mul_mem hp₁ ((reesAlgebra I).algebraMap_mem _))
            (mul_mem hp₂ ((reesAlgebra I).algebraMap_mem _)), k₁ + k₂, ?_⟩
        rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, ← h₁, ← h₂]
        simp only [Polynomial.map_pow, map_C, map_pow, pow_add, C_mul]
        ring
      · intro n _
        have hn : (z : S[X]).coeff n ∈ (I ^ n).map (algebraMap R S) := by
          rw [Ideal.map_pow]
          exact hJ ▸ z.2 n
        obtain ⟨⟨⟨a, ha⟩, ⟨_, k, rfl⟩⟩, hak⟩ :=
          (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers r) S).1 hn
        refine ⟨monomial n a, reesAlgebra.monomial_mem.2 ha, k, ?_⟩
        have hak' : (z : S[X]).coeff n * φ r ^ k = φ a := by
          simpa [RingHom.algebraMap_toAlgebra] using hak
        rw [mul_comm, C_mul_monomial, map_monomial, mul_comm, hak']
    obtain ⟨p, hp, k, h⟩ := hP
    refine ⟨(⟨p, hp⟩, ⟨_, k, rfl⟩), Subtype.ext ?_⟩
    change (z : S[X]) * (algebraMap (reesAlgebra I) (reesAlgebra J)
      ((algebraMap R (reesAlgebra I) r) ^ k) : S[X]) = p.map φ
    rw [← map_pow (algebraMap R (reesAlgebra I)) r k, hC, map_pow, h]
  · intro x y hxy
    -- Coefficients killed by `S` are killed by a power of `r`.
    let P : R[X] → Prop := fun q => ∃ k : ℕ, C (r ^ k) * q = 0
    have hxy' : ((x : R[X]) - y).map φ = 0 := by
      rw [Polynomial.map_sub, ← coe_reesMap φ hJ.le, ← coe_reesMap φ hJ.le]
      exact sub_eq_zero.2 (congrArg Subtype.val hxy)
    have hP : P ((x : R[X]) - y) := by
      rw [((x : R[X]) - y).as_sum_support]
      refine Finset.sum_induction _ P ?_ ⟨0, by simp⟩ ?_
      · rintro q₁ q₂ ⟨k₁, h₁⟩ ⟨k₂, h₂⟩
        refine ⟨k₁ + k₂, ?_⟩
        rw [pow_add, C_mul]
        linear_combination C (r ^ k₂) * h₁ + C (r ^ k₁) * h₂
      · intro n _
        have h0 : algebraMap R S (((x : R[X]) - y).coeff n) = 0 := by
          change φ _ = 0
          rw [← coeff_map, hxy', coeff_zero]
        obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers r) S _).1 h0
        exact ⟨k, by rw [C_mul_monomial, hk, map_zero]⟩
    obtain ⟨k, hk⟩ := hP
    refine ⟨⟨_, k, rfl⟩, Subtype.ext ?_⟩
    change (algebraMap R (reesAlgebra I) r : R[X]) ^ k * x =
      (algebraMap R (reesAlgebra I) r) ^ k * y
    rw [← sub_eq_zero, ← mul_sub]
    simpa using hk

end Algebra

/-! ### The sheaf of Rees algebras -/

section Sheaf

open Scheme.AffineZariskiSite

variable {X : Scheme.{u}} (J : X.IdealSheafData)

namespace ReesAlgebraSheaf

/-- The ideal `J(U) ⊆ Γ(U, 𝒪_X)` over an object `U` of the affine Zariski site. -/
abbrev idealOn (U : X.AffineZariskiSite) : Ideal Γ(X, U.toOpens) :=
  J.ideal ⟨U.toOpens, U.2⟩

theorem map_idealOn {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    (idealOn J V).map (X.presheaf.map ((toOpensFunctor X).map f).op).hom = idealOn J U :=
  J.map_ideal' _

/-- The rings of sections `Γ(U, ⨁_d J^d) = ⨁_d J(U)^d tᵈ` over the affine opens `U`. -/
def functor : X.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u} where
  obj U := CommRingCat.of (reesAlgebra (idealOn J U.unop))
  map f := CommRingCat.ofHom
    (reesMap (X.presheaf.map ((toOpensFunctor X).map f.unop).op).hom (map_idealOn J f.unop).le)
  map_id U := CommRingCat.hom_ext (reesMap_eq_id _ (by simp; rfl) (map_idealOn J (𝟙 U).unop).le)
  map_comp f g := CommRingCat.hom_ext (reesMap_comp_reesMap _ _ _
    (by rw [unop_comp, Functor.map_comp, op_comp, Functor.map_comp, CommRingCat.hom_comp]; rfl)
    (map_idealOn J f.unop).le (map_idealOn J g.unop).le (map_idealOn J (f ≫ g).unop).le).symm

/-- The polynomial in `Γ(U, 𝒪_X)[t]` underlying a section of the sheaf of Rees algebras. -/
abbrev toPolynomial {U : X.AffineZariskiSiteᵒᵖ} (p : (functor J).obj U) : Γ(X, U.unop.toOpens)[X] :=
  (show reesAlgebra (idealOn J U.unop) from p).1

theorem toPolynomial_functor_map {U V : X.AffineZariskiSiteᵒᵖ} (f : U ⟶ V)
    (p : (functor J).obj U) :
    toPolynomial J ((functor J).map f p) =
      (toPolynomial J p).map (X.presheaf.map ((toOpensFunctor X).map f.unop).op).hom :=
  rfl

/-- The `𝒪_X`-algebra structure `Γ(U, 𝒪_X) → ⨁_d J(U)^d tᵈ` (constants, in degree zero). -/
def structureMap : (toOpensFunctor X).op ⋙ X.presheaf ⟶ functor J where
  app U := CommRingCat.ofHom (algebraMap Γ(X, U.unop.toOpens) (reesAlgebra (idealOn J U.unop)))
  naturality U V f := by
    ext r : 2
    refine Subtype.ext ?_
    exact (map_C _).symm

theorem toPolynomial_structureMap_app (U : X.AffineZariskiSiteᵒᵖ) (r : Γ(X, U.unop.toOpens)) :
    toPolynomial J ((structureMap J).app U r) = C r :=
  rfl

theorem coequifibered : (structureMap J).Coequifibered := by
  refine coequifibered_iff_forall_isLocalizationAway.mpr fun U r => ?_
  exact reesMap_isLocalizationAway
    (X.presheaf.map ((toOpensFunctor X).map (homOfLE (U.basicOpen_le r))).op).hom
    (map_idealOn J _) r (U.2.isLocalization_basicOpen r)

end ReesAlgebraSheaf

open ReesAlgebraSheaf in
/-- **The sheaf of Rees algebras** `⨁_{d ≥ 0} Jᵈ` of a quasi-coherent ideal sheaf `J` (Hartshorne
II.7, p. 163), as a quasi-coherent sheaf of graded `𝒪_X`-algebras: over an affine open `U` its
ring of sections is the Rees algebra `⨁_d J(U)ᵈ tᵈ ⊆ Γ(U, 𝒪_X)[t]`, graded by the degree in `t`. -/
def reesAlgebraSheaf : QuasiCoherentGradedAlgebra X where
  obj := functor J
  structureMap := structureMap J
  coequifibered := coequifibered J
  grading U := reesGrading (idealOn J U)
  gradedRing U := reesGrading_gradedRing (idealOn J U)
  map_mem f _ _ hx := reesMap_mem_reesGrading _ (map_idealOn J f.op.unop).le hx
  structureMap_mem U r m hm := by
    change (C r).coeff m = 0
    rw [coeff_C, if_neg hm]

namespace ReesAlgebraSheaf

theorem mem_grading_iff (U : X.AffineZariskiSite) (d : ℕ)
    (x : (reesAlgebraSheaf J).obj.obj (.op U)) :
    x ∈ (reesAlgebraSheaf J).grading U d ↔
      ∃ a ∈ idealOn J U ^ d, toPolynomial J x = monomial d a := by
  refine ⟨fun hx => ⟨_, (mem_reesAlgebra_iff _ _).1 x.2 d, mem_reesGrading_iff.1 hx⟩, ?_⟩
  rintro ⟨a, -, ha⟩ m hm
  change (toPolynomial J x).coeff m = 0
  rw [ha, coeff_monomial, if_neg (Ne.symm hm)]

/-- `S₀ = 𝒪_X` for the sheaf of Rees algebras. -/
theorem degreeZeroIsStructureSheaf : (reesAlgebraSheaf J).DegreeZeroIsStructureSheaf :=
  fun U => bijective_reesGrading_zero (idealOn J U)

/-- `S₁ = J` is coherent when the ideals `J(U)` on affine opens are finitely generated. -/
theorem degreeOneCoherent (hJ : ∀ U : X.affineOpens, (J.ideal U).FG) :
    (reesAlgebraSheaf J).DegreeOneCoherent :=
  fun U => exists_reesGrading_one_generators (idealOn J U) (hJ _)

/-- The sheaf of Rees algebras is generated by `S₁ = J` as an `𝒪_X`-algebra. -/
theorem generatedInDegreeOne : (reesAlgebraSheaf J).GeneratedInDegreeOne :=
  fun U => closure_reesGrading_zero_union_one (idealOn J U)

end ReesAlgebraSheaf

end Sheaf

/-! ### The inverse image ideal sheaf -/

section InverseImage

variable {X Y : Scheme.{u}}

/-- A section `t` of `𝒪_Y` over `W` vanishes on the closed subscheme cut out by `K` exactly when its
restriction to every affine open `U ⊆ W` lies in `K(U)`. -/
theorem subschemeι_app_eq_zero_iff (K : Y.IdealSheafData) {W : Y.Opens} (t : Γ(Y, W)) :
    K.subschemeι.app W t = 0 ↔
      ∀ (U : Y.affineOpens) (h : (U : Y.Opens) ≤ W),
        Y.presheaf.map (homOfLE h).op t ∈ K.ideal U := by
  have key : ∀ (U : Y.affineOpens) (h : (U : Y.Opens) ≤ W),
      K.subschemeι.app U (Y.presheaf.map (homOfLE h).op t) =
        K.subscheme.presheaf.map ((TopologicalSpace.Opens.map K.subschemeι.base).map
          (homOfLE h)).op (K.subschemeι.app W t) := by
    intro U h
    rw [← ConcreteCategory.comp_apply, K.subschemeι.naturality, ConcreteCategory.comp_apply]
    rfl
  constructor
  · intro h0 U h
    rw [← K.ker_subschemeι_app U, RingHom.mem_ker]
    change K.subschemeι.app U _ = 0
    rw [key, h0, map_zero]
  · intro H
    refine TopCat.Presheaf.section_ext K.subscheme.sheaf _ _ _ fun x hx => ?_
    obtain ⟨U, hUW, hxU⟩ := ArtinReesKernelSheaf.exists_affine_le (X := Y) hx
    have h0 : K.subschemeι.app U (Y.presheaf.map (homOfLE hUW).op t) = 0 := by
      have := H U hUW
      rw [← K.ker_subschemeι_app U, RingHom.mem_ker] at this
      exact this
    rw [key] at h0
    have e := TopCat.Presheaf.germ_res_apply K.subscheme.presheaf
      ((TopologicalSpace.Opens.map K.subschemeι.base).map (homOfLE hUW)) x hxU
      (K.subschemeι.app W t)
    rw [h0, map_zero] at e
    exact e.symm.trans (map_zero _).symm

/-- The push-forward `K.map f` of an ideal sheaf on `Y` (the ideal of the scheme-theoretic image of
`V(K) → X`) contains `J` exactly when `f^♯` maps `J(V)` into `K(U)` for all affine opens
`U ⊆ f⁻¹V`. -/
theorem le_map_iff (K : Y.IdealSheafData) (f : Y ⟶ X) (J : X.IdealSheafData) :
    J ≤ K.map f ↔ ∀ (V : X.affineOpens) (U : Y.affineOpens) (h : (U : Y.Opens) ≤ f ⁻¹ᵁ V),
      (J.ideal V).map (f.appLE V U h).hom ≤ K.ideal U := by
  rw [Scheme.IdealSheafData.map, Scheme.Hom.ker, Scheme.IdealSheafData.le_ofIdeals_iff]
  refine ⟨fun H V U h => Ideal.map_le_iff_le_comap.2 fun s hs => ?_, fun H V s hs => ?_⟩
  · have : K.subschemeι.app (f ⁻¹ᵁ V) (f.app V s) = 0 := H V hs
    exact (subschemeι_app_eq_zero_iff K _).1 this U h
  · change K.subschemeι.app (f ⁻¹ᵁ V) (f.app V s) = 0
    refine (subschemeι_app_eq_zero_iff K _).2 fun U h => ?_
    exact H V U h (Ideal.mem_map_of_mem _ hs)

/-- **The inverse image ideal sheaf** `f⁻¹I · 𝒪_Y` of a quasi-coherent sheaf of ideals `I` on `X`
under a morphism `f : Y ⟶ X` (Hartshorne II.7, p. 163): the image of `f^*I → 𝒪_Y`, that is, the
sheaf of ideals of `𝒪_Y` generated by `f^♯(I)`: see `inverseImageIdeal_le_iff` and, on affine
opens, `inverseImageIdeal_ideal`. It is an ideal sheaf, not the module `f^*I` itself. It is Mathlib's `IdealSheafData.comap`, the ideal
sheaf of the closed subscheme `Y ×_X V(I)`. -/
def inverseImageIdeal (f : Y ⟶ X) (I : X.IdealSheafData) : Y.IdealSheafData :=
  I.comap f

/-- The inverse image ideal sheaf `f⁻¹I · 𝒪_Y` is the smallest quasi-coherent sheaf of ideals of
`𝒪_Y` containing `f^♯(Γ(V, I)) · Γ(U, 𝒪_Y)` for all affine opens `V ⊆ X` and `U ⊆ f⁻¹V`: the image
of `f^*I → 𝒪_Y`. -/
theorem inverseImageIdeal_le_iff (f : Y ⟶ X) (I : X.IdealSheafData) (K : Y.IdealSheafData) :
    inverseImageIdeal f I ≤ K ↔
      ∀ (V : X.affineOpens) (U : Y.affineOpens) (h : (U : Y.Opens) ≤ f ⁻¹ᵁ V),
        (I.ideal V).map (f.appLE V U h).hom ≤ K.ideal U :=
  Scheme.IdealSheafData.le_map_iff_comap_le.symm.trans (le_map_iff K f I)

/-- `f^♯(Γ(V, I)) · Γ(U, 𝒪_Y) ⊆ Γ(U, f⁻¹I · 𝒪_Y)` for affine opens `V ⊆ X` and `U ⊆ f⁻¹V`. -/
theorem map_ideal_le_inverseImageIdeal (f : Y ⟶ X) (I : X.IdealSheafData) (V : X.affineOpens)
    (U : Y.affineOpens) (h : (U : Y.Opens) ≤ f ⁻¹ᵁ V) :
    (I.ideal V).map (f.appLE V U h).hom ≤ (inverseImageIdeal f I).ideal U :=
  (inverseImageIdeal_le_iff f I _).1 le_rfl V U h

/-- The inverse image ideal sheaf `f⁻¹I · 𝒪_Y`, as a quasi-coherent ideal subsheaf of `𝒪_Y`. -/
def QuasicoherentIdealSubsheaf.inverseImage (f : Y ⟶ X) (I : QuasicoherentIdealSubsheaf X) :
    QuasicoherentIdealSubsheaf Y :=
  quasicoherentIdealSubsheafEquiv.symm (inverseImageIdeal f (quasicoherentIdealSubsheafEquiv I))

/-- The inverse image ideal sheaf `f⁻¹I · 𝒪_Y ⊆ 𝒪_Y` is the image of `f^*I → 𝒪_Y`: the smallest
quasi-coherent sheaf of ideals of `𝒪_Y` containing `f^♯(Γ(V, I)) · Γ(U, 𝒪_Y)` for all affine opens
`V ⊆ X` and `U ⊆ f⁻¹V`. -/
theorem QuasicoherentIdealSubsheaf.inverseImage_le_iff (f : Y ⟶ X)
    (I : QuasicoherentIdealSubsheaf X) (K : QuasicoherentIdealSubsheaf Y) :
    (∀ U : Y.affineOpens, (I.inverseImage f).ideal U ≤ K.ideal U) ↔
      ∀ (V : X.affineOpens) (U : Y.affineOpens) (h : (U : Y.Opens) ≤ f ⁻¹ᵁ V),
        (I.ideal V).map (f.appLE V U h).hom ≤ K.ideal U := by
  have e : ∀ U : Y.affineOpens, (I.inverseImage f).ideal U =
      (inverseImageIdeal f (quasicoherentIdealSubsheafEquiv I)).ideal U :=
    quasicoherentIdealSubsheafEquiv_symm_ideal _
  simp_rw [e]
  exact inverseImageIdeal_le_iff f _ (quasicoherentIdealSubsheafEquiv K)

/-- Pulling an ideal sheaf back to an open subscheme `U` restricts it: over an affine open `W`
of `U`, the ideal is `J(W)`. -/
theorem ideal_comap_opensι (J : Y.IdealSheafData) (U : Y.Opens) (W : U.toScheme.affineOpens) :
    (J.comap U.ι).ideal W = J.ideal ⟨U.ι ''ᵁ W, W.2.image_of_isOpenImmersion _⟩ := by
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion]
  simp only [Scheme.Opens.ι_appIso, Iso.refl_inv]
  exact Ideal.comap_id _

/-- The ideal on `⊤` of the restriction of `J` to an affine open `U` is `J(U)`. -/
theorem comap_ideal_comap_ι (J : Y.IdealSheafData) (U : Y.affineOpens) :
    haveI : IsAffine U.1.toScheme := U.2
    (J.comap U.1.ι).ideal ⟨⊤, isAffineOpen_top _⟩ = J.ideal ⟨U.1.ι ''ᵁ ⊤,
      (isAffineOpen_top _).image_of_isOpenImmersion _⟩ := by
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion]
  simp only [Scheme.Opens.ι_appIso, Iso.refl_inv]
  exact Ideal.comap_id _

/-- Auxiliary form of `inverseImageIdeal_ideal`, with `U` written as the image of `⊤ ⊆ U`. -/
theorem inverseImageIdeal_ideal_le_aux (f : Y ⟶ X) (I : X.IdealSheafData) (V : X.affineOpens)
    (U : Y.affineOpens) (h : (U : Y.Opens) ≤ f ⁻¹ᵁ V) :
    haveI : IsAffine U.1.toScheme := U.2
    (inverseImageIdeal f I).ideal ⟨U.1.ι ''ᵁ ⊤, (isAffineOpen_top _).image_of_isOpenImmersion _⟩ ≤
      (I.ideal V).map (f.appLE V (U.1.ι ''ᵁ ⊤) ((Scheme.Opens.ι_image_top _).le.trans h)).hom := by
  have : IsAffine U.1.toScheme := U.2
  let g := f.resLE V U h
  rw [← comap_ideal_comap_ι]
  have e1 : (inverseImageIdeal f I).comap U.1.ι = (I.comap V.1.ι).comap g := by
    rw [inverseImageIdeal, ← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp,
      Scheme.Hom.resLE_comp_ι]
  let 𝔞 : Ideal Γ(U.1.toScheme, ⊤) :=
    (I.ideal V).map (f.appLE V (U.1.ι ''ᵁ ⊤) ((Scheme.Opens.ι_image_top _).le.trans h)).hom
  have key : (I.comap V.1.ι).comap g ≤ Scheme.IdealSheafData.ofIdealTop 𝔞 := by
    refine (inverseImageIdeal_le_iff g _ _).2 fun V' U' h' => ?_
    rw [ideal_comap_opensι, Scheme.Hom.resLE_appLE, Scheme.IdealSheafData.ofIdealTop_ideal]
    have hV' : (⟨V.1.ι ''ᵁ V'.1, V'.2.image_of_isOpenImmersion _⟩ : X.affineOpens) ≤ V :=
      Scheme.Hom.image_le_opensRange _ _ |>.trans (by simp)
    rw [← I.map_ideal hV']
    refine le_of_eq ?_
    have h1 : U.1.ι ''ᵁ U'.1 ≤ U.1.ι ''ᵁ ⊤ := Scheme.Hom.image_mono _ le_top
    change Ideal.map (f.appLE _ _ _).hom
        (Ideal.map (X.presheaf.map (homOfLE (show V.1.ι ''ᵁ V'.1 ≤ V.1 from hV')).op).hom
          (I.ideal V)) =
      Ideal.map (Y.presheaf.map (homOfLE h1).op).hom
        (Ideal.map (f.appLE V (U.1.ι ''ᵁ ⊤) ((Scheme.Opens.ι_image_top _).le.trans h)).hom
          (I.ideal V))
    rw [Ideal.map_map, Ideal.map_map, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp,
      Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
  have := key ⟨⊤, isAffineOpen_top _⟩
  rw [← e1, Scheme.IdealSheafData.ofIdealTop_ideal] at this
  refine this.trans (le_of_eq ?_)
  change Ideal.map (U.1.toScheme.presheaf.map (𝟙 _)).hom 𝔞 = 𝔞
  rw [CategoryTheory.Functor.map_id, CommRingCat.hom_id, Ideal.map_id]

/-- **The inverse image ideal sheaf on affine opens**: for affine opens `V ⊆ X` and `U ⊆ f⁻¹V`,
`Γ(U, f⁻¹I · 𝒪_Y) = f^♯(Γ(V, I)) · Γ(U, 𝒪_Y)`, the image of `Γ(U, f^*I) = Γ(V, I) ⊗ Γ(U, 𝒪_Y)`
in `Γ(U, 𝒪_Y)`. -/
theorem inverseImageIdeal_ideal (f : Y ⟶ X) (I : X.IdealSheafData) (V : X.affineOpens)
    (U : Y.affineOpens) (h : (U : Y.Opens) ≤ f ⁻¹ᵁ V) :
    (inverseImageIdeal f I).ideal U = (I.ideal V).map (f.appLE V U h).hom := by
  refine le_antisymm ?_ (map_ideal_le_inverseImageIdeal f I V U h)
  have : IsAffine U.1.toScheme := U.2
  have transfer : ∀ (U₁ U₂ : Y.affineOpens) (e : U₁ = U₂) (h₁ : (U₁ : Y.Opens) ≤ f ⁻¹ᵁ V)
      (h₂ : (U₂ : Y.Opens) ≤ f ⁻¹ᵁ V),
      (inverseImageIdeal f I).ideal U₁ ≤ (I.ideal V).map (f.appLE V U₁ h₁).hom →
        (inverseImageIdeal f I).ideal U₂ ≤ (I.ideal V).map (f.appLE V U₂ h₂).hom := by
    rintro U₁ U₂ rfl h₁ h₂ H
    exact H
  exact transfer _ U (Subtype.ext (Scheme.Opens.ι_image_top _)) _ h
    (inverseImageIdeal_ideal_le_aux f I V U h)

/-- The inverse image ideal subsheaf on affine opens: `Γ(U, f⁻¹I · 𝒪_Y) = f^♯(Γ(V, I)) · Γ(U, 𝒪_Y)`
for affine opens `V ⊆ X` and `U ⊆ f⁻¹V`. -/
theorem QuasicoherentIdealSubsheaf.inverseImage_ideal (f : Y ⟶ X)
    (I : QuasicoherentIdealSubsheaf X) (V : X.affineOpens) (U : Y.affineOpens)
    (h : (U : Y.Opens) ≤ f ⁻¹ᵁ V) :
    (I.inverseImage f).ideal U = (I.ideal V).map (f.appLE V U h).hom :=
  (quasicoherentIdealSubsheafEquiv_symm_ideal _ U).trans (inverseImageIdeal_ideal f _ V U h)

end InverseImage

/-! ### Blowing up a coherent sheaf of ideals -/

namespace QuasicoherentIdealSubsheaf

variable {X : Scheme.{u}} (I : QuasicoherentIdealSubsheaf X)

/-- **The sheaf of Rees algebras** `𝒮 = ⨁_{d ≥ 0} Iᵈ` of a quasi-coherent sheaf of ideals `I`
(Hartshorne II.7, p. 163), a quasi-coherent sheaf of graded `𝒪_X`-algebras with `𝒮_d = Iᵈ`:
over an affine open `U` its sections are `⨁_d Γ(U, I)ᵈ tᵈ ⊆ Γ(U, 𝒪_X)[t]`. -/
def reesAlgebra : QuasiCoherentGradedAlgebra X :=
  reesAlgebraSheaf (quasicoherentIdealSubsheafEquiv I)

/-- Over an affine open `U`, the degree-`d` sections of `⨁_d Iᵈ` are the `a tᵈ` with
`a ∈ Γ(U, I)ᵈ`. -/
theorem mem_reesAlgebra_grading_iff (U : X.AffineZariskiSite) (d : ℕ)
    (x : I.reesAlgebra.obj.obj (.op U)) :
    x ∈ I.reesAlgebra.grading U d ↔
      ∃ a ∈ I.ideal U.toOpens ^ d, ReesAlgebraSheaf.toPolynomial _ x = monomial d a :=
  ReesAlgebraSheaf.mem_grading_iff _ U d x

/-- For a coherent sheaf of ideals, `Γ(U, I)` is a finitely generated ideal on every affine
open `U`. -/
theorem fg_ideal_of_isCoherent (hI : IsCoherent I.toModules) (U : X.affineOpens) :
    (I.ideal U).FG :=
  Module.Finite.iff_fg.1 (forall_affine_finite_of_isCoherent I.toModules hI U).1

/-- The data of Hartshorne's relative `Proj` for the sheaf of Rees algebras `⨁_d Iᵈ` of a
coherent sheaf of ideals `I` on a Noetherian scheme: `𝒮₀ = 𝒪_X`, `𝒮₁ = I` is coherent, and `𝒮`
is generated by `𝒮₁`. -/
def blowupData [IsNoetherian X] (hI : IsCoherent I.toModules) : RelativeProjData X where
  algebra := I.reesAlgebra
  degreeZero := ReesAlgebraSheaf.degreeZeroIsStructureSheaf _
  degreeOne_coherent := ReesAlgebraSheaf.degreeOneCoherent _ (I.fg_ideal_of_isCoherent hI)
  generated := ReesAlgebraSheaf.generatedInDegreeOne _

/-- **The blowing-up of `X` with respect to a coherent sheaf of ideals `I`** (Hartshorne II.7,
p. 163): for a Noetherian scheme `X`, `X̃ = Proj_X 𝒮` with `𝒮 = ⨁_{d ≥ 0} Iᵈ`. -/
def blowup [IsNoetherian X] (hI : IsCoherent I.toModules) : Scheme.{u} :=
  (I.blowupData hI).relativeProj

/-- The projection `π : X̃ = Proj_X (⨁_d Iᵈ) ⟶ X` of the blowing-up. -/
def blowupProjection [IsNoetherian X] (hI : IsCoherent I.toModules) : I.blowup hI ⟶ X :=
  (I.blowupData hI).projection

/-- Over an affine open `U ⊆ X`, the blowing-up is `Proj (⨁_d Γ(U, I)ᵈ tᵈ)`, compatibly with the
projections to `U`. -/
theorem blowupRestrictIso_hom_projToOpen [IsNoetherian X] (hI : IsCoherent I.toModules)
    (U : X.AffineZariskiSite) :
    ((I.blowupData hI).restrictIso U).hom ≫ I.reesAlgebra.projToOpen U =
      I.blowupProjection hI ∣_ U.toOpens :=
  (I.blowupData hI).restrictIso_hom_projToOpen U

end QuasicoherentIdealSubsheaf

end Hartshorne
