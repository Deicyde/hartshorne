import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
import Hartshorne.Scheme.InvertibleSectionClearingDenominators
import Hartshorne.Scheme.AffineGlobalSectionsExact

/-!
# The ideal data of the image of a morphism into the structure sheaf

Let `X` be a scheme, `F` a quasi-coherent `𝒪_X`-module and `φ : F ⟶ 𝒪_X` a morphism of
`𝒪_X`-modules. On each open `U` the image `φ(Γ(U, F))` is an ideal of `Γ(X, U)`
(`homRangeIdeal φ U`). On affine opens these ideals are compatible with localization: for
`f ∈ Γ(X, U)` the ideal over `D(f)` is generated by the restriction of the ideal over `U`
(Hartshorne II.5.3(b) for `F`). They therefore form Mathlib's ideal data
`idealSheafDataOfHom φ : X.IdealSheafData`, hence a closed subscheme
`(idealSheafDataOfHom φ).subscheme`, whose ideal over an affine open `U` is the kernel of
`Γ(X, U) ⟶ Γ(Z, Z ∩ U)` (`ker_subschemeι_app_idealSheafDataOfHom`).

The ideal over an affine open `U` contains every section of `𝒪_X` over `U` that lies locally in
the image of `φ` (`mem_homRangeIdeal_of_locally`). Hence if `φ = π ≫ ι` with `π` an epimorphism,
then the ideal over `U` is also the image of the sections of `ι` over `U`
(`homRangeIdeal_eq_of_epi_comp`); in particular for the image factorization, the ideal data is
that of the quasi-coherent ideal sheaf `image φ ⊆ 𝒪_X`.
-/

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry

namespace Hartshorne

variable {X : Scheme.{u}} {F : X.Modules}

/-- Morphisms of `𝒪_X`-modules commute with restriction of sections. -/
theorem modules_app_res {F G : X.Modules} (φ : F ⟶ G) {U V : X.Opens} (h : V ≤ U)
    (a : Γ(F, U)) :
    φ.app V (F.presheaf.map (homOfLE h).op a) = G.presheaf.map (homOfLE h).op (φ.app U a) := by
  have := ConcreteCategory.congr_hom (φ.mapPresheaf.naturality (homOfLE h).op) a
  simpa using this

/-- The ideal `φ(Γ(U, F)) ⊆ Γ(X, U)`: the image on sections over `U` of a morphism
`φ : F ⟶ 𝒪_X`. -/
def homRangeIdeal (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf) (U : X.Opens) :
    Ideal Γ(X, U) where
  carrier := Set.range (φ.app U)
  add_mem' := by
    rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨a + b, map_add _ a b⟩
  zero_mem' := ⟨0, map_zero _⟩
  smul_mem' := by
    rintro r _ ⟨a, rfl⟩
    exact ⟨r • a, φ.app_smul r a⟩

theorem mem_homRangeIdeal {φ : F ⟶ SheafOfModules.unit X.ringCatSheaf} {U : X.Opens}
    {t : Γ(X, U)} : t ∈ homRangeIdeal φ U ↔ ∃ a : Γ(F, U), φ.app U a = t :=
  Iff.rfl

/-- Restriction maps the image ideal over `U` into the image ideal over `V ⊆ U`. -/
theorem homRangeIdeal_map_le (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf) {U V : X.Opens}
    (h : V ≤ U) :
    (homRangeIdeal φ U).map (X.presheaf.map (homOfLE h).op).hom ≤ homRangeIdeal φ V := by
  rw [Ideal.map_le_iff_le_comap]
  rintro _ ⟨a, rfl⟩
  exact ⟨F.presheaf.map (homOfLE h).op a, modules_app_res φ h a⟩

/-- **Localization of the image ideal.** For quasi-coherent `F`, an affine open `U` and
`f ∈ Γ(X, U)`, the image ideal over `D(f)` is generated by the restriction of the image ideal
over `U`. -/
theorem homRangeIdeal_map_basicOpen [F.IsQuasicoherent]
    (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf) {U : X.Opens} (hU : IsAffineOpen U)
    (f : Γ(X, U)) :
    (homRangeIdeal φ U).map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom =
      homRangeIdeal φ (X.basicOpen f) := by
  refine le_antisymm (homRangeIdeal_map_le φ _) ?_
  rintro _ ⟨b, rfl⟩
  obtain ⟨n, t, ht⟩ := exists_pow_smul_extension_of_isAffineOpen F hU f b
  set ρ := X.presheaf.map (homOfLE (X.basicOpen_le f)).op
  have hu : IsUnit (ρ f ^ n) := (X.toRingedSpace.isUnit_res_basicOpen f).pow n
  let c : Γ(X, X.basicOpen f) := φ.app (X.basicOpen f) b
  have key : ρ (φ.app U t) = ρ f ^ n * c := by
    have h1 := modules_app_res φ (X.basicOpen_le f) t
    rw [ht, φ.app_smul] at h1
    exact h1.symm
  have : c = ↑hu.unit⁻¹ * ρ (φ.app U t) := by
    rw [key, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
  change c ∈ _
  rw [this]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ ⟨t, rfl⟩)

/-- **The ideal data of the image of a morphism into `𝒪_X`.** For a quasi-coherent `F` and
`φ : F ⟶ 𝒪_X`, the ideals `φ(Γ(U, F)) ⊆ Γ(X, U)` on affine opens `U` form compatible ideal
data. -/
noncomputable def idealSheafDataOfHom [F.IsQuasicoherent]
    (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf) : X.IdealSheafData where
  ideal U := homRangeIdeal φ U
  map_ideal_basicOpen U f := homRangeIdeal_map_basicOpen φ U.2 f

theorem idealSheafDataOfHom_ideal [F.IsQuasicoherent]
    (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf) (U : X.affineOpens) :
    (idealSheafDataOfHom φ).ideal U = homRangeIdeal φ U :=
  rfl

/-- The closed subscheme cut out by the image of `φ` has, over each affine open `U`, the image
ideal `φ(Γ(U, F))` as the kernel of restriction of functions: the sequence
`Γ(U, F) ⟶ Γ(U, 𝒪_X) ⟶ Γ(Z ∩ U, 𝒪_Z) ⟶ 0` is exact. -/
theorem ker_subschemeι_app_idealSheafDataOfHom [F.IsQuasicoherent]
    (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf) (U : X.affineOpens) :
    RingHom.ker ((idealSheafDataOfHom φ).subschemeι.app U).hom = homRangeIdeal φ U :=
  (idealSheafDataOfHom φ).ker_subschemeι_app U

/-- A section of `𝒪_X` over an affine open which lies locally in the image of `φ` lies in the
image ideal. -/
theorem mem_homRangeIdeal_of_locally [F.IsQuasicoherent]
    (φ : F ⟶ SheafOfModules.unit X.ringCatSheaf) {U : X.Opens} (hU : IsAffineOpen U)
    (t : Γ(X, U))
    (h : ∀ x ∈ U, ∃ (V : X.Opens) (hVU : V ≤ U), x ∈ V ∧
      X.presheaf.map (homOfLE hVU).op t ∈ homRangeIdeal φ V) :
    t ∈ homRangeIdeal φ U := by
  rw [hU.mem_ideal_iff]
  intro x hx
  obtain ⟨V, hVU, hxV, hV⟩ := h x hx
  obtain ⟨g, hgV, hxg⟩ := hU.exists_basicOpen_le ⟨x, hxV⟩ hx
  have hmem : X.presheaf.map (homOfLE (X.basicOpen_le g)).op t ∈
      homRangeIdeal φ (X.basicOpen g) := by
    have := homRangeIdeal_map_le φ hgV (Ideal.mem_map_of_mem _ hV)
    rwa [← CommRingCat.comp_apply, ← Functor.map_comp, ← op_comp, homOfLE_comp] at this
  rw [← homRangeIdeal_map_basicOpen φ hU g] at hmem
  have := Ideal.mem_map_of_mem (X.presheaf.germ (X.basicOpen g) x hxg).hom hmem
  rwa [Ideal.map_map, ← CommRingCat.hom_comp, ← CommRingCat.comp_apply, X.presheaf.germ_res]
    at this

/-- If `φ = π ≫ ι` with `π` an epimorphism, then over an affine open `U` the image ideal of `φ`
is the image of the sections of `ι` over `U`. -/
theorem homRangeIdeal_eq_of_epi_comp [F.IsQuasicoherent] {I : X.Modules}
    (π : F ⟶ I) [Epi π] (ι : I ⟶ SheafOfModules.unit X.ringCatSheaf) {U : X.Opens}
    (hU : IsAffineOpen U) :
    homRangeIdeal (π ≫ ι) U = homRangeIdeal ι U := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨a, rfl⟩
    exact ⟨π.app U a, rfl⟩
  · rintro _ ⟨a, rfl⟩
    refine mem_homRangeIdeal_of_locally _ hU _ fun x hx => ?_
    obtain ⟨V, hVU, hxV, b, hb⟩ := modules_exists_local_lift π a hx
    refine ⟨V, hVU, hxV, b, ?_⟩
    change ι.app V (π.app V b) = _
    rw [hb]
    exact modules_app_res ι hVU a

end Hartshorne
