import Hartshorne.Scheme.RelativeProjLineBundleTwist

/-!
# The twisting sheaf of `Proj_X (S · L)`

Hartshorne, *Algebraic Geometry*, II.7, Lemma 7.9 (p. 161), the formula for `𝒪(1)`.

Let `L` be an invertible sheaf on `X` and `φ : Proj_X (S · L) ≅ Proj_X S` the isomorphism of
`Hartshorne.QuasiCoherentGradedAlgebra.lineBundleTwistIso`. Over an affine open `U ⊆ X` with a
frame `e` of `L`, `φ` restricts to `Proj (S · L)(U) ≅ Proj S(U)`, induced by the graded
isomorphism `s ↦ s ⊗ e^d`; when `S` is generated by `S₁` as an `S₀`-algebra, it pulls
`𝒪_{Proj S(U)}(n)` back to `𝒪_{Proj (S · L)(U)}(n)` (`framedPullbackTwistIso`, by Hartshorne
II.5.12(c) for graded isomorphisms). Hence `φ^* 𝒪_{Proj_X S}(n)` restricts to
`𝒪_{Proj (S · L)(U)}(n)` on each such piece (`restrictPullbackTwistIso`).
-/

universe u

noncomputable section

open CategoryTheory Opposite AlgebraicGeometry Scheme.Modules

namespace Hartshorne

namespace QuasiCoherentGradedAlgebra

variable {X : Scheme.{u}} {L : X.Modules} (hL : L.IsInvertible) (n : ℤ)

variable (S : QuasiCoherentGradedAlgebra X)

attribute [local instance] sectionsAlgebra

variable {hL} in
/-- Over an affine open `U` with a frame `e` of `L`, when `S` is generated by `S₁` over `S₀`, the
local isomorphism `Proj (S · L)(U) ≅ Proj S(U)` (induced by `s ↦ s ⊗ e^d`) pulls
`𝒪_{Proj S(U)}(n)` back to `𝒪_{Proj (S · L)(U)}(n)` (Hartshorne II.5.12(c) for this graded
isomorphism). -/
def framedPullbackTwistIso (hS : S.GeneratedInDegreeOne) (U : (framedAffines L).FullSubcategory) :
    (Scheme.Modules.pullback (S.framedIso (hL := hL) U).hom).obj (S.twistingSheaf n U.obj) ≅
      (S.lineBundleTwist L hL).twistingSheaf n U.obj :=
  let := SegreProduct.gradedRing Γ(X, U.obj.1) (S.grading U.obj)
    ((lineBundleSym L hL).grading U.obj) (S.algebraMap_sections_mem U.obj)
    ((lineBundleSym L hL).algebraMap_sections_mem U.obj)
  (pullbackCongr (SegreProduct.projIsoOfGenerator_hom (S.grading U.obj)
    ((lineBundleSym L hL).grading U.obj) (S.algebraMap_sections_mem U.obj)
    ((lineBundleSym L hL).algebraMap_sections_mem U.obj) frameGenerator_mem
    (frameGenerator_free U.property.choose_spec)).choose_spec).app _ ≪≫
    pullbackProjMapTwistIso _ _ (S.adjoin_eq_top_of_generatedInDegreeOne hS U.obj) n

variable {hL} in
/-- Over each framed piece `Proj (S · L)(U)` of `Proj_X (S · L)`, the pullback
`φ^* 𝒪_{Proj_X S}(n)` restricts to `𝒪_{Proj (S · L)(U)}(n)`. -/
def restrictPullbackTwistIso (hS : S.GeneratedInDegreeOne)
    (U : (framedAffines L).FullSubcategory) :
    ((Scheme.Modules.pullback (S.lineBundleTwistIso hL).hom).obj (S.relTwistingSheaf n)).restrict
        ((S.lineBundleTwist L hL).projι U.obj) ≅
      (S.lineBundleTwist L hL).twistingSheaf n U.obj :=
  (restrictFunctorIsoPullback _).app _ ≪≫ (pullbackComp _ _).app _ ≪≫
    (pullbackCongr (S.projι_lineBundleTwistHom U)).app _ ≪≫ ((pullbackComp _ _).app _).symm ≪≫
    (Scheme.Modules.pullback _).mapIso (((restrictFunctorIsoPullback _).app _).symm ≪≫
      S.relTwistingSheafRestrictIso n U.obj) ≪≫
    S.framedPullbackTwistIso n hS U

end QuasiCoherentGradedAlgebra

end Hartshorne
