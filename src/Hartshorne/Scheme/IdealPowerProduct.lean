import Hartshorne.Cohomology.ArtinReesKernelSheaf
import Hartshorne.Scheme.InvertibleSectionClearingDenominators
import Hartshorne.Scheme.CoherentAffineLocalCriterion

/-!
# The product of a power of an ideal sheaf with a submodule sheaf

Let `X` be a scheme, `I` a quasi-coherent ideal sheaf on `X`, given by its ideals
`I(V) ⊆ Γ(X, V)` on affine opens (`X.IdealSheafData`), `E` an `𝒪_X`-module and `N ⊆ E` a
submodule sheaf. The submodule sheaf `I ^ k N` (`ArtinReesKernelSheaf.powSmul`) consists of the
sections lying, near every point, in `I(V) ^ k N(V)` on an affine open `V`. For a module `N`
without an ambient module, take `E = N` and the top submodule.

* `isQuasicoherent_powSmul`: if `N` is quasi-coherent, so is `I ^ k N`;
* `sub_powSmul_eq`: if `N` is quasi-coherent, then on every affine open `V` the sections of
  `I ^ k N` are exactly `I(V) ^ k N(V)`;
* `isCoherent_powSmul`: if `X` is locally Noetherian and `N` is coherent, `I ^ k N` is coherent;
* `powSmul_zero`: `I ^ 0 N = N`.

The quasi-coherence uses a converse of Hartshorne II.5.3, `isQuasicoherent_of_pow_smul`: an
`𝒪_X`-module is quasi-coherent if, on every affine open `U` and for every `g ∈ Γ(X, U)`, sections
over `U` vanishing on `D(g)` are killed by a power of `g` and sections over `D(g)` extend to `U`
after multiplication by a power of `g`. These two conditions say that `Γ(U, F) → Γ(D(g), F)` is
the localization at `g`, which on `Spec Γ(X, U)` is Mathlib's criterion
`isIso_fromTildeΓ_iff_isLocalizing`.

The inclusion `I(V) ^ k N(V) ⊆ Γ(V, I ^ k N)` holds by definition. For the converse, a section
`s` of `I ^ k N` over `V` lies in `I(D(g)) ^ k N(D(g))` on a cover of `V` by basic opens `D(g)`.
Since `I(D(g))` is generated by the image of `I(V)` and every section of `N` over `D(g)` extends
to `V` after multiplication by a power of `g` (Hartshorne II.5.3(b)), some `g ^ n s` agrees on
`D(g)` with an element of `I(V) ^ k N(V)`; by II.5.3(a) a further power of `g` makes them equal.
The `g` with `g ^ n s ∈ I(V) ^ k N(V)` for some `n` generate the unit ideal, so
`s ∈ I(V) ^ k N(V)`. The same extension statement, with this identity on `D(g)`, is the second
hypothesis of the criterion for `I ^ k N`.
-/

noncomputable section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry

namespace Hartshorne

universe u

/-! ### A converse of Hartshorne II.5.3 -/

open FiberDimAux in
/-- **A converse of II.5.3.** An `𝒪_X`-module `F` is quasi-coherent if, for every affine
open `U` and `g ∈ Γ(X, U)`, a section over `U` vanishing on `D(g)` is killed by a power of `g`,
and every section over `D(g)`, multiplied by a power of `g`, extends to `U`. -/
theorem isQuasicoherent_of_pow_smul {X : Scheme.{u}} (F : X.Modules)
    (hzero : ∀ (U : X.affineOpens) (g : Γ(X, U)) (s : Γ(F, U)),
      F.presheaf.map (homOfLE (X.basicOpen_le g)).op s = 0 → ∃ n : ℕ, g ^ n • s = 0)
    (hext : ∀ (U : X.affineOpens) (g : Γ(X, U)) (t : Γ(F, X.basicOpen g)),
      ∃ (n : ℕ) (s : Γ(F, U)), F.presheaf.map (homOfLE (X.basicOpen_le g)).op s =
        (X.presheaf.map (homOfLE (X.basicOpen_le g)).op g) ^ n • t) :
    F.IsQuasicoherent := by
  refine ((quasicoherent_affine_local_tfae F).out 2 0).mp fun U => ?_
  have hU : IsAffineOpen (U : X.Opens) := U.2
  let : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
  change IsIso (F.restrict hU.fromSpec).fromTildeΓ
  rw [isIso_fromTildeΓ_iff_isLocalizing]
  intro f
  let e := CoherentAux.sectionsEquiv F hU
  let ρ : Γ(F.restrict hU.fromSpec, ⊤) →ₗ[Γ(X, U)]
      Γ(F.restrict hU.fromSpec, CoherentAux.D f) :=
    ((modulesSpecToSheaf.obj (F.restrict hU.fromSpec)).obj.map (CoherentAux.D f).leTop.op).hom
  change IsLocalizedModule (Submonoid.powers f) ρ
  refine (IsLocalizedModule.comp_iff_of_bijective_right (S := Submonoid.powers f)
    e.toLinearMap (f := ρ) e.bijective).mp ?_
  set W := hU.fromSpec ''ᵁ CoherentAux.D f
  have hWU : W ≤ U := fromSpec_image_basicOpen_le hU f
  have hres (m : Γ(F, U)) : ρ (e m) = F.presheaf.map (homOfLE hWU).op m := by
    change F.presheaf.map _ (F.presheaf.map _ m) = _
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hsmul (a : Γ(X, U)) (t : Γ(F.restrict hU.fromSpec, CoherentAux.D f)) :
      (a • t : Γ(F.restrict hU.fromSpec, CoherentAux.D f)) =
        (X.presheaf.map (homOfLE hWU).op a • (show Γ(F, W) from t) :) := by
    rw [Scheme.Modules.smul_Spec_def, ← ring_compat_basicOpen hU f]
    rfl
  have hzero' : ∀ (V : X.Opens) (hV : V = X.basicOpen f) (hVU : V ≤ U) (s : Γ(F, U)),
      F.presheaf.map (homOfLE hVU).op s = 0 → ∃ n : ℕ, f ^ n • s = 0 := by
    rintro V rfl hVU s hs
    exact hzero U f s hs
  have hext' : ∀ (V : X.Opens) (hV : V = X.basicOpen f) (hVU : V ≤ U) (t : Γ(F, V)),
      ∃ (n : ℕ) (s : Γ(F, U)), F.presheaf.map (homOfLE hVU).op s =
        (X.presheaf.map (homOfLE hVU).op f) ^ n • t := by
    rintro V rfl hVU t
    exact hext U f t
  have hW : W = X.basicOpen f := hU.fromSpec_image_basicOpen f
  refine ⟨fun s => ?_, fun t => ?_, fun {m₁ m₂} h => ?_⟩
  · obtain ⟨n, hn⟩ := s.2
    have hu0 := (ArtinReesKernelSheaf.isUnit_res_of_le_basicOpen f hWU hW.le).pow n
    have hn' : f ^ n = (s : Γ(X, U)) := hn
    rw [← map_pow, hn'] at hu0
    obtain ⟨u, hu⟩ := hu0
    rw [Module.End.isUnit_iff]
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun y => (show Γ(F.restrict hU.fromSpec, CoherentAux.D f) from
        (↑u⁻¹ : Γ(X, W)) • (show Γ(F, W) from y)), fun y => ?_, fun y => ?_⟩
    · simp only [Module.algebraMap_end_apply]
      rw [hsmul, ← hu]
      change (↑u⁻¹ : Γ(X, W)) • (↑u : Γ(X, W)) • (show Γ(F, W) from y) = y
      rw [smul_smul, Units.inv_mul, one_smul]
    · change (s : Γ(X, U)) • (show Γ(F.restrict hU.fromSpec, CoherentAux.D f) from
        (↑u⁻¹ : Γ(X, W)) • (show Γ(F, W) from y)) = y
      rw [hsmul, ← hu]
      change (↑u : Γ(X, W)) • (↑u⁻¹ : Γ(X, W)) • (show Γ(F, W) from y) = y
      rw [smul_smul, Units.mul_inv, one_smul]
  · obtain ⟨n, m, hm⟩ := hext' W hW hWU t
    refine ⟨⟨m, ⟨f ^ n, n, rfl⟩⟩, ?_⟩
    change (f ^ n) • t = ρ (e m)
    rw [hres, hm, hsmul, map_pow]
  · replace h : F.presheaf.map (homOfLE hWU).op m₁ = F.presheaf.map (homOfLE hWU).op m₂ := by
      rw [← hres, ← hres]
      exact h
    rw [← sub_eq_zero, ← map_sub] at h
    obtain ⟨n, hn⟩ := hzero' W hW hWU _ h
    refine ⟨⟨f ^ n, n, rfl⟩, ?_⟩
    rw [smul_sub, sub_eq_zero] at hn
    exact hn

namespace ArtinReesKernelSheaf

variable {X : Scheme.{u}} {E : X.Modules}

lemma res_refl (U : X.Opens) (s : Γ(E, U)) : res E (le_refl U) s = s := by
  change E.presheaf.map (𝟙 (op U)) s = s
  rw [CategoryTheory.Functor.map_id]
  rfl

/-- On an affine open `V`, `I(V) ^ k N(V)` consists of sections of `I ^ k N`. -/
theorem le_sub_powSmul (I : X.IdealSheafData) (k : ℕ) (N : E.val.Submodule)
    (V : X.affineOpens) : I.ideal V ^ k • sub N V ≤ sub (powSmul I k N) V := fun s hs x hx =>
  ⟨V, le_rfl, hx, by rwa [res_refl]⟩

/-- The sections of `I ^ k N` lie in `N`. -/
theorem powSmul_le {I : X.IdealSheafData} {k : ℕ} {N : E.val.Submodule} (hN : IsLocal N) :
    powSmul I k N ≤ N :=
  (powSmulFamily I k N).closure_le hN fun _ => Submodule.smul_le_right

/-- `I ^ 0 N = N`. -/
theorem powSmul_zero (I : X.IdealSheafData) {N : E.val.Submodule} (hN : IsLocal N) :
    powSmul I 0 N = N :=
  le_antisymm (powSmul_le hN) fun U s hs x hx => by
    obtain ⟨V, hVU, hxV⟩ := exists_affine_le hx
    refine ⟨V, hVU, hxV, ?_⟩
    change _ ∈ I.ideal V ^ 0 • sub N V
    rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]
    exact res_mem N hVU hs

/-- Extension along a basic open: if `t ∈ I(D(g)) ^ k N(D(g))` for a basic open `D(g)` of the
affine open `V`, then some `g ^ n t` is the restriction of an element of `I(V) ^ k N(V)`. -/
theorem exists_pow_smul_eq_res (I : X.IdealSheafData) (k : ℕ) {N : E.val.Submodule}
    (hN : IsLocal N) [(toModules N hN).IsQuasicoherent] (V : X.affineOpens) (g : Γ(X, V))
    (hDV : (X.affineBasicOpen g : X.Opens) ≤ V) {t : Γ(E, (X.affineBasicOpen g : X.Opens))}
    (ht : t ∈ I.ideal (X.affineBasicOpen g) ^ k • sub N (X.affineBasicOpen g)) :
    ∃ (n : ℕ) (p : Γ(E, V)), p ∈ I.ideal V ^ k • sub N V ∧
      (X.presheaf.map (homOfLE hDV).op).hom g ^ n • t = res E hDV p := by
  set D : X.affineOpens := X.affineBasicOpen g
  set ρ := (X.presheaf.map (homOfLE hDV).op).hom
  set P := I.ideal V ^ k • sub N V
  have hloc : IsLocalization.Away g Γ(X, X.basicOpen g) := V.2.isLocalization_basicOpen g
  -- The sections over `D(g)` which, after multiplication by a power of `g`, come from `P`.
  let Q : Submodule Γ(X, D) Γ(E, D) :=
    { carrier := {t | ∃ (n : ℕ) (p : Γ(E, V)), p ∈ P ∧ ρ g ^ n • t = res E hDV p}
      zero_mem' := ⟨0, 0, zero_mem _, by rw [smul_zero, map_zero]⟩
      add_mem' := by
        rintro t₁ t₂ ⟨n₁, p₁, hp₁, h₁⟩ ⟨n₂, p₂, hp₂, h₂⟩
        refine ⟨n₁ + n₂, g ^ n₂ • p₁ + g ^ n₁ • p₂,
          add_mem (Submodule.smul_mem _ _ hp₁) (Submodule.smul_mem _ _ hp₂), ?_⟩
        rw [map_add, LinearMap.map_smulₛₗ, LinearMap.map_smulₛₗ, ← h₁, ← h₂, map_pow, map_pow,
          smul_add, smul_smul, smul_smul, ← pow_add, ← pow_add, add_comm n₂ n₁]
      smul_mem' := by
        rintro c t ⟨n, p, hp, h⟩
        let c' : Γ(X, X.basicOpen g) := c
        obtain ⟨⟨a, _, m, rfl⟩, hc⟩ :=
          IsLocalization.surj (R := Γ(X, V)) (S := Γ(X, X.basicOpen g)) (Submonoid.powers g) c'
        change c * ρ (g ^ m) = ρ a at hc
        refine ⟨n + m, a • p, Submodule.smul_mem _ _ hp, ?_⟩
        rw [LinearMap.map_smulₛₗ, ← h, ← hc, smul_smul, smul_smul, map_pow]
        congr 1
        ring }
  have hI : I.ideal D ^ k = (I.ideal V ^ k).map ρ := by
    rw [Ideal.map_pow]
    exact congrArg (· ^ k) (I.map_ideal (U := D) (V := V) hDV).symm
  have hle : I.ideal D ^ k • sub N D ≤ Q := by
    rw [hI, Submodule.smul_le]
    intro r hr m hm
    obtain ⟨n, t', ht'⟩ := exists_pow_smul_extension_of_isAffineOpen (toModules N hN) V.2 g
      (⟨m, hm⟩ : N.obj (op (D : X.Opens)))
    let m' : Γ(E, V) := (t' : N.obj (op (V : X.Opens))).1
    have hm'N : m' ∈ sub N V := (t' : N.obj (op (V : X.Opens))).2
    have hm' : res E hDV m' = ρ g ^ n • m := congrArg Subtype.val ht'
    let K : Ideal Γ(X, D) := Q.comap (LinearMap.toSpanSingleton Γ(X, D) Γ(E, D) m)
    have hK : (I.ideal V ^ k).map ρ ≤ K := by
      rw [Ideal.map_le_iff_le_comap]
      intro j hj
      change ρ j • m ∈ Q
      refine ⟨n, j • m', Submodule.smul_mem_smul hj hm'N, ?_⟩
      rw [LinearMap.map_smulₛₗ, hm', smul_comm]
    exact hK hr
  exact hle ht

/-- The local step: if `s ∈ N(V)` lies in `I(D(g)) ^ k N(D(g))` after restriction to a basic
open `D(g)` of the affine open `V`, then `g ^ n s ∈ I(V) ^ k N(V)` for some `n`. -/
theorem exists_pow_smul_mem_of_res_mem (I : X.IdealSheafData) (k : ℕ) {N : E.val.Submodule}
    (hN : IsLocal N) [(toModules N hN).IsQuasicoherent] (V : X.affineOpens) (g : Γ(X, V))
    {s : Γ(E, V)} (hsN : s ∈ sub N V)
    (hs : res E (X.basicOpen_le g : (X.affineBasicOpen g : X.Opens) ≤ V) s ∈
      I.ideal (X.affineBasicOpen g) ^ k • sub N (X.affineBasicOpen g)) :
    ∃ n : ℕ, g ^ n • s ∈ I.ideal V ^ k • sub N V := by
  set D : X.affineOpens := X.affineBasicOpen g
  have hDV : (D : X.Opens) ≤ V := X.basicOpen_le g
  set ρ := (X.presheaf.map (homOfLE hDV).op).hom
  set P := I.ideal V ^ k • sub N V
  obtain ⟨n, p, hp, h⟩ := exists_pow_smul_eq_res I k hN V g hDV hs
  replace h : ρ g ^ n • res E hDV s = res E hDV p := h
  have hpN : p ∈ sub N V := Submodule.smul_le_right hp
  have hdN : g ^ n • s - p ∈ sub N V := sub_mem (Submodule.smul_mem _ _ hsN) hpN
  have hres : res E hDV (g ^ n • s - p) = 0 := by
    rw [map_sub, LinearMap.map_smulₛₗ, map_pow]
    change ρ g ^ n • res E hDV s - res E hDV p = 0
    rw [h, sub_self]
  obtain ⟨n', hn'⟩ := exists_pow_smul_eq_zero_of_isAffineOpen (toModules N hN) V.2 g
    (⟨_, hdN⟩ : N.obj (op (V : X.Opens))) (Subtype.ext hres)
  have h0 : g ^ n' • (g ^ n • s - p) = 0 := congrArg Subtype.val hn'
  rw [smul_sub, sub_eq_zero] at h0
  refine ⟨n' + n, ?_⟩
  rw [pow_add, mul_smul, h0]
  exact Submodule.smul_mem _ _ hp

/-- **Sections of `I ^ k N` on an affine open.** If `N` is quasi-coherent, then over every
affine open `V` the sections of `I ^ k N` are exactly `I(V) ^ k N(V)`. -/
theorem sub_powSmul_eq (I : X.IdealSheafData) (k : ℕ) {N : E.val.Submodule} (hN : IsLocal N)
    [(toModules N hN).IsQuasicoherent] (V : X.affineOpens) :
    sub (powSmul I k N) V = I.ideal V ^ k • sub N V := by
  refine le_antisymm (fun s hs => ?_) (le_sub_powSmul I k N V)
  have hsN : s ∈ sub N V := PresheafOfModules.Submodule.le_iff.1 (powSmul_le hN) _ hs
  set P := I.ideal V ^ k • sub N V
  let T : Set Γ(X, V) := {g | ∃ n : ℕ, g ^ n • s ∈ P}
  have hT : Ideal.span T = ⊤ := by
    rw [← V.2.self_le_iSup_basicOpen_iff]
    intro x hxV
    obtain ⟨W, hWV, hxW, hW⟩ := hs x hxV
    have hWV' : (W : X.Opens) ≤ V := hWV
    replace hW : res E hWV' s ∈ I.ideal W ^ k • sub N W := hW
    obtain ⟨g, hgW, hxg⟩ := V.2.exists_basicOpen_le ⟨x, hxW⟩ hxV
    have hgW' : ((X.affineBasicOpen g : X.affineOpens) : X.Opens) ≤ W := hgW
    have hD := (powSmulFamily I k N).res_mem (V := W) (W := X.affineBasicOpen g) hgW' hW
    rw [res_res] at hD
    exact Opens.mem_iSup.2 ⟨⟨g, exists_pow_smul_mem_of_res_mem I k hN V g hsN hD⟩, hxg⟩
  exact Submodule.mem_of_span_eq_top_of_smul_pow_mem P T hT s fun g => g.2

/-- **`I ^ k N` is quasi-coherent** when `N` is. -/
theorem isQuasicoherent_powSmul (I : X.IdealSheafData) (k : ℕ) {N : E.val.Submodule}
    (hN : IsLocal N) [(toModules N hN).IsQuasicoherent] :
    (toModules (powSmul I k N) (isLocal_powSmul I k N)).IsQuasicoherent := by
  refine isQuasicoherent_of_pow_smul _ (fun U g s hs => ?_) (fun U g t => ?_)
  · let s' : (powSmul I k N).obj (op (U : X.Opens)) := s
    have hs' := congrArg
      (fun x : (powSmul I k N).obj (op (X.basicOpen g)) => x.1) hs
    obtain ⟨n, hn⟩ := exists_pow_smul_eq_zero_of_isAffineOpen (toModules N hN) U.2 g
      (⟨s'.1, PresheafOfModules.Submodule.le_iff.1 (powSmul_le hN) _ s'.2⟩ :
        N.obj (op (U : X.Opens))) (Subtype.ext hs')
    have hn' := congrArg (fun x : N.obj (op (U : X.Opens)) => x.1) hn
    exact ⟨n, Subtype.ext hn'⟩
  · let t' : (powSmul I k N).obj (op (X.basicOpen g)) := t
    have ht : t'.1 ∈ I.ideal (X.affineBasicOpen g) ^ k • sub N (X.affineBasicOpen g) :=
      (sub_powSmul_eq I k hN (X.affineBasicOpen g)).le t'.2
    obtain ⟨n, p, hp, h⟩ := exists_pow_smul_eq_res I k hN U g (X.basicOpen_le g) ht
    exact ⟨n, (⟨p, le_sub_powSmul I k N U hp⟩ : (powSmul I k N).obj (op (U : X.Opens))),
      Subtype.ext h.symm⟩

/-- **`I ^ k N` is coherent** on a locally Noetherian scheme when `N` is. -/
theorem isCoherent_powSmul [IsLocallyNoetherian X] (I : X.IdealSheafData) (k : ℕ)
    {N : E.val.Submodule} (hN : IsLocal N) (hcoh : IsCoherent (toModules N hN)) :
    IsCoherent (toModules (powSmul I k N) (isLocal_powSmul I k N)) := by
  have h4 := ((coherent_affine_local_tfae (toModules N hN)).out 0 3).mp hcoh
  have : (toModules N hN).IsQuasicoherent :=
    ((quasicoherent_affine_local_tfae _).out 2 0).mp fun U => (h4 U).2
  have hqc := isQuasicoherent_powSmul I k hN
  have hiso := ((quasicoherent_affine_local_tfae _).out 0 2).mp hqc
  refine ((coherent_affine_local_tfae _).out 3 0).mp ?_
  intro U
  refine ⟨?_, hiso U⟩
  have := IsLocallyNoetherian.component_noetherian U
  have : Module.Finite Γ(X, U) (sub N U) := (h4 U).1
  have : IsNoetherian Γ(X, U) (sub N U) :=
    isNoetherian_of_isNoetherianRing_of_finite _ _
  have : IsNoetherian Γ(X, U) (sub (powSmul I k N) U) :=
    isNoetherian_of_injective
      (Submodule.inclusion (p := sub (powSmul I k N) U) (p' := sub N U)
        (PresheafOfModules.Submodule.le_iff.1 (powSmul_le hN) _))
      (Submodule.inclusion_injective _)
  exact Module.IsNoetherian.finite Γ(X, U) (sub (powSmul I k N) U)

end ArtinReesKernelSheaf

end Hartshorne
