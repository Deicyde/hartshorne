/-!
# Toward "a regular local ring is a UFD"

Partial progress on the Auslander–Buchsbaum theorem (Matsumura, *Commutative Algebra*,
Theorem 48, p. 142, as cited by Hartshorne II, Remark 6.11.1A).

## Main results

* `Hartshorne.RegularLocalFactorial.uniqueFactorizationMonoid_of_ringKrullDim_le_one`:
  a regular local ring of dimension at most one is a UFD.
* `Hartshorne.RegularLocalFactorial.prime_of_mem_maximalIdeal_of_notMem_sq`:
  in a regular local ring, an element of `𝔪 \ 𝔪²` is a prime element.
* `Hartshorne.RegularLocalFactorial.uniqueFactorizationMonoid_iff_localizationAway`:
  for such an element `x`, the ring is a UFD if and only if `R[1/x]` is (Nagata's criterion).
* `Hartshorne.RegularLocalFactorial.exists_mem_maximalIdeal_notMem_sq`:
  a regular local ring of positive dimension has an element of `𝔪 \ 𝔪²`.
* `Hartshorne.RegularLocalFactorial.isUnit_map_of_forall_exists_mul_eq`:
  a nonzero finitely generated ideal of a domain that is principal at every maximal ideal is an
  invertible fractional ideal.
* `Hartshorne.RegularLocalFactorial.uniqueFactorizationMonoid_of_isStablyFree`:
  a Noetherian domain whose localizations at maximal ideals are UFDs and whose projective
  height-one primes are stably free is a UFD.
* `Hartshorne.RegularLocalFactorial.isStablyFree_of_exact`:
  in `0 → K → F → M → 0` with `F` finite free and `M` projective, `K` stably free implies `M`
  stably free.
* `Hartshorne.RegularLocalFactorial.uniqueFactorizationMonoid_of_forall_localization`:
  the induction on the dimension, with its two remaining inputs (regularity of localizations,
  stable freeness of projective ideals of `R[1/x]`) as hypotheses.
* `Hartshorne.RegularLocalFactorial.isStablyFree_of_isLocalizedModule_of_hasProjectiveDimensionLE`:
  over a Noetherian local ring, a projective localization of a finitely generated module of finite
  projective dimension is stably free.
* `Hartshorne.RegularLocalFactorial.uniqueFactorizationMonoid_of_forall_hasProjectiveDimensionLE`:
  a regular local ring is a UFD, assuming that localizations of regular local rings are regular
  and that finitely generated modules over regular local rings have finite projective dimension.

The two inputs still missing are thus the regularity of localizations of regular local rings and
one direction of Serre's theorem (finite projective dimension over a regular local ring).
-/

open IsLocalRing Ideal

namespace Hartshorne.RegularLocalFactorial

variable {R : Type*} [CommRing R] [IsRegularLocalRing R]

/-- A regular local ring of dimension at most one is a unique factorization domain: its only
height-one prime (if any) is the maximal ideal, which is then generated by one element. -/
theorem uniqueFactorizationMonoid_of_ringKrullDim_le_one (h : ringKrullDim R ≤ 1) :
    UniqueFactorizationMonoid R := by
  have := Hartshorne.RegularLocal.isDomain R
  rw [UniqueFactorizationMonoid.iff_forall_isPrincipal_of_height_eq_one]
  intro p _ hp
  have hpbot : p ≠ ⊥ := p.ne_bot_of_height_eq_one hp
  obtain rfl : p = maximalIdeal R :=
    (Hartshorne.RegularLocalization.eq_bot_or_eq_maximalIdeal_of_ringKrullDim_le_one p h).resolve_left
      hpbot
  have hsf : ((maximalIdeal R).spanFinrank : WithBot ℕ∞) ≤ 1 :=
    (IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)).symm ▸ h
  have hsf1 : (maximalIdeal R).spanFinrank ≤ 1 := by exact_mod_cast hsf
  have hsf0 : (maximalIdeal R).spanFinrank ≠ 0 := by
    rw [Ne, Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian _)]
    exact hpbot
  exact ((Submodule.spanFinrank_eq_one_iff _).mp (by omega)).1

/-- In a regular local ring, an element of the maximal ideal not in its square is a prime element:
the quotient by it is again regular local, hence a domain. -/
theorem prime_of_mem_maximalIdeal_of_notMem_sq {x : R} (hxm : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2) : Prime x := by
  have hx0 : x ≠ 0 := by
    rintro rfl
    exact hx2 (zero_mem _)
  have := (Hartshorne.RegularLocal.isRegularLocalRing_quotient_of_notMem_sq hxm hx2).1
  have := Hartshorne.RegularLocal.isDomain (R ⧸ span {x})
  exact (span_singleton_prime hx0).mp ((Ideal.Quotient.isDomain_iff_prime _).mp ‹_›)

/-- Nagata's criterion in a regular local ring: for `x ∈ 𝔪 \ 𝔪²`, the ring `R` is a UFD if and only
if its localization `R[1/x]` is. -/
theorem uniqueFactorizationMonoid_iff_localizationAway {x : R} (hxm : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2) :
    UniqueFactorizationMonoid R ↔ UniqueFactorizationMonoid (Localization.Away x) := by
  have := Hartshorne.RegularLocal.isDomain R
  exact UniqueFactorizationMonoid.iff_localizationAway_of_prime
    (prime_of_mem_maximalIdeal_of_notMem_sq hxm hx2)

/-- A regular local ring of positive dimension has an element of the maximal ideal outside its
square (Nakayama: otherwise the maximal ideal would be idempotent, hence zero). -/
theorem exists_mem_maximalIdeal_notMem_sq (h : 0 < ringKrullDim R) :
    ∃ x ∈ maximalIdeal R, x ∉ maximalIdeal R ^ 2 := by
  by_contra! hsq
  have hle : maximalIdeal R ≤ maximalIdeal R ^ 2 := hsq
  have hidem : IsIdempotentElem (maximalIdeal R) :=
    (pow_two _).symm.trans (le_antisymm (Ideal.pow_le_self two_ne_zero) hle)
  rcases (Ideal.isIdempotentElem_iff_eq_bot_or_top_of_isLocalRing _).mp hidem with hbot | htop
  · have hfield : IsField R := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot
    rw [ringKrullDim_eq_zero_of_isField hfield] at h
    exact lt_irrefl _ h
  · exact (maximalIdeal.isMaximal R).ne_top htop

section Descent

variable {A : Type*} [CommRing A]

/-- If the extension of an ideal `p` to the localization at a prime `m` is principal, then some
`a ∈ p` generates `p` away from `m`: every `b ∈ p` satisfies `t * b = a * c` with `t ∉ m`. -/
theorem exists_mem_forall_exists_mul_eq_of_isPrincipal_map {p : Ideal A} (m : Ideal A)
    [m.IsPrime] (h : (p.map (algebraMap A (Localization.AtPrime m))).IsPrincipal) :
    ∃ a ∈ p, ∀ b ∈ p, ∃ t ∉ m, ∃ c, t * b = a * c := by
  set S := Localization.AtPrime m
  obtain ⟨g, hg⟩ := h
  have hgmem : g ∈ p.map (algebraMap A S) := hg ▸ Submodule.mem_span_singleton_self g
  obtain ⟨⟨⟨a, ha⟩, s⟩, hs⟩ := (IsLocalization.mem_map_algebraMap_iff m.primeCompl S).mp hgmem
  refine ⟨a, ha, fun b hb => ?_⟩
  have hbmem : algebraMap A S b ∈ (Submodule.span S {g} : Ideal S) := hg ▸ mem_map_of_mem _ hb
  obtain ⟨z, hz⟩ := mem_span_singleton'.mp hbmem
  obtain ⟨⟨c, u⟩, hu⟩ := IsLocalization.surj m.primeCompl z
  have key : algebraMap A S (s * u * b) = algebraMap A S (a * c) := by
    simp only [map_mul]
    rw [← hz, ← hs, ← hu]
    ring
  obtain ⟨v, hv⟩ := (IsLocalization.eq_iff_exists m.primeCompl S).mp key
  exact ⟨v * (s * u), m.primeCompl.mul_mem v.2 (m.primeCompl.mul_mem s.2 u.2), v * c, by
    linear_combination hv⟩

variable [IsDomain A] (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]

/-- A nonzero finitely generated ideal of a domain that is principal near every maximal ideal (in
the sense of `exists_mem_forall_exists_mul_eq_of_isPrincipal_map`) is invertible as a fractional
ideal. -/
theorem isUnit_map_of_forall_exists_mul_eq {p : Ideal A} (hp : p ≠ ⊥) (hfg : p.FG)
    (h : ∀ m : Ideal A, m.IsMaximal → ∃ a ∈ p, ∀ b ∈ p, ∃ t ∉ m, ∃ c, t * b = a * c) :
    IsUnit (Submodule.map (Algebra.linearMap A K) p) := by
  set I := Submodule.map (Algebra.linearMap A K) p
  have hinj := IsFractionRing.injective A K
  have key : (1 : Submodule A K) ≤ I * (1 / I) := by
    let J : Ideal A := Submodule.comap (Algebra.linearMap A K) (I * (1 / I))
    suffices hJ : J = ⊤ by
      rw [Submodule.one_le]
      have : (1 : A) ∈ J := hJ ▸ Submodule.mem_top
      simpa [J] using this
    by_contra hJ
    obtain ⟨m, hm, hJm⟩ := Ideal.exists_le_maximal J hJ
    obtain ⟨a, ha, hab⟩ := h m hm
    obtain ⟨S, hS⟩ := hfg
    choose! t ht c hc using hab
    have hSp : ∀ x ∈ S, x ∈ p := fun x hx => hS ▸ Submodule.subset_span hx
    set s := ∏ x ∈ S, t x
    have hs : s ∉ m :=
      m.primeCompl.prod_mem fun x hx => ht x (hSp x hx)
    have ha0 : algebraMap A K a ≠ 0 := by
      rw [ne_eq, map_eq_zero_iff _ hinj]
      rintro rfl
      apply hp
      rw [eq_bot_iff]
      intro b hb
      have hcb := hc b hb
      rw [zero_mul] at hcb
      have htb : t b ≠ 0 := fun h0 => ht b hb (h0 ▸ zero_mem m)
      exact (mul_eq_zero.mp hcb).resolve_left htb
    set y : K := algebraMap A K s / algebraMap A K a
    have hy : y ∈ 1 / I := by
      rw [Submodule.mem_div_iff_forall_mul_mem]
      intro x hx
      obtain ⟨b, hb, rfl⟩ := Submodule.mem_map.mp hx
      clear hx
      rw [← hS] at hb
      induction hb using Submodule.span_induction with
      | mem x hxS =>
        rw [Submodule.mem_one]
        obtain ⟨r, hr⟩ : t x ∣ s := Finset.dvd_prod_of_mem t hxS
        refine ⟨r * c x, ?_⟩
        have hcx := hc x (hSp x hxS)
        simp only [Algebra.linearMap_apply, y]
        rw [div_mul_eq_mul_div, eq_div_iff ha0, hr]
        simp only [map_mul]
        have : algebraMap A K (t x) * algebraMap A K x = algebraMap A K a * algebraMap A K (c x) := by
          rw [← map_mul, ← map_mul, hcx]
        linear_combination -(algebraMap A K r) * this
      | zero => simp
      | add x x' _ _ hx hx' =>
        rw [map_add, mul_add]
        exact add_mem hx hx'
      | smul r x _ hx =>
        rw [map_smul, mul_smul_comm]
        exact Submodule.smul_mem _ r hx
    have hsI : algebraMap A K s ∈ I * (1 / I) := by
      have : algebraMap A K a * y = algebraMap A K s := by
        simp only [y]
        field_simp
      rw [← this]
      exact Submodule.mul_mem_mul (Submodule.mem_map_of_mem ha) hy
    exact hs (hJm hsI)
  exact IsUnit.of_mul_eq_one _ (le_antisymm Submodule.mul_one_div_le_one key)

omit [IsDomain A] in
/-- An ideal that is free (hence isomorphic to the ring, being of rank one) is principal. -/
theorem isPrincipal_of_linearEquiv {p : Ideal A} (f : p ≃ₗ[A] A) : p.IsPrincipal := by
  refine ⟨⟨(f.symm 1 : A), ?_⟩⟩
  ext x
  constructor
  · intro hx
    rw [mem_span_singleton']
    refine ⟨f ⟨x, hx⟩, ?_⟩
    have := congrArg Subtype.val (f.symm.map_smul (f ⟨x, hx⟩) 1)
    simp only [smul_eq_mul, mul_one, LinearEquiv.symm_apply_apply, SetLike.val_smul] at this
    exact this.symm
  · intro hx
    obtain ⟨r, rfl⟩ := mem_span_singleton'.mp hx
    exact p.mul_mem_left r (f.symm 1).2

variable [IsNoetherianRing A]

omit K in
/-- A nonzero ideal of a Noetherian domain whose extension to every localization at a maximal ideal
is principal, and which is stably free as soon as it is projective, is itself principal: it is
invertible (hence projective), and an invertible stably free module is free. -/
theorem isPrincipal_of_isStablyFree_of_forall_isPrincipal_map {p : Ideal A} (hp : p ≠ ⊥)
    (hsf : Module.Projective A p → Module.IsStablyFree A p)
    (h : ∀ (m : Ideal A) [m.IsMaximal],
      (p.map (algebraMap A (Localization.AtPrime m))).IsPrincipal) :
    p.IsPrincipal := by
  let K := FractionRing A
  have hu := isUnit_map_of_forall_exists_mul_eq K hp (IsNoetherian.noetherian p)
    (fun m hm => exists_mem_forall_exists_mul_eq_of_isPrincipal_map m (h m))
  let e : p ≃ₗ[A] (Submodule.map (Algebra.linearMap A K) p) :=
    Submodule.equivMapOfInjective _ (IsFractionRing.injective A K) p
  have : Module.Invertible A (Submodule.map (Algebra.linearMap A K) p) :=
    inferInstanceAs (Module.Invertible A (hu.unit : Submodule A K))
  have : Module.Invertible A p := Module.Invertible.congr e.symm
  have : Module.IsStablyFree A p := hsf inferInstance
  have : Module.Free A p := Module.free_of_isStablyFree_of_invertible A p
  obtain ⟨f⟩ := Module.Invertible.free_iff_linearEquiv.mp this
  exact isPrincipal_of_linearEquiv f

omit K in
/-- A Noetherian domain whose localizations at maximal ideals are UFDs, and whose projective
height-one primes are stably free, is a UFD. -/
theorem uniqueFactorizationMonoid_of_isStablyFree
    (hloc : ∀ (m : Ideal A) [m.IsMaximal], UniqueFactorizationMonoid (Localization.AtPrime m))
    (hsf : ∀ p : Ideal A, p.IsPrime → p.height = 1 → Module.Projective A p →
      Module.IsStablyFree A p) :
    UniqueFactorizationMonoid A := by
  rw [UniqueFactorizationMonoid.iff_forall_isPrincipal_of_height_eq_one]
  intro p _ hp1
  refine isPrincipal_of_isStablyFree_of_forall_isPrincipal_map (p.ne_bot_of_height_eq_one hp1)
    (hsf p ‹_› hp1) fun m _ => ?_
  by_cases hpm : p ≤ m
  · have hd : Disjoint (m.primeCompl : Set A) p :=
      Set.disjoint_left.mpr fun x hx hxp => hx (hpm hxp)
    have := IsLocalization.isPrime_of_isPrime_disjoint m.primeCompl (Localization.AtPrime m) p
      ‹_› hd
    have := hloc m
    apply UniqueFactorizationMonoid.isPrincipal_of_height_eq_one
    rw [← IsLocalization.height_under m.primeCompl,
      IsLocalization.under_map_of_isPrime_disjoint m.primeCompl _ ‹_› hd, hp1]
  · obtain ⟨s, hsp, hsm⟩ := SetLike.not_le_iff_exists.mp hpm
    have : p.map (algebraMap A (Localization.AtPrime m)) = ⊤ :=
      Ideal.eq_top_of_isUnit_mem _ (mem_map_of_mem _ hsp)
        (IsLocalization.map_units _ (⟨s, hsm⟩ : m.primeCompl))
    rw [this]
    exact ⟨⟨1, Ideal.span_singleton_one.symm⟩⟩

end Descent

section StablyFree

variable {R K F M : Type*} [CommRing R] [AddCommGroup K] [Module R K] [AddCommGroup F]
  [Module R F] [AddCommGroup M] [Module R M]

/-- In a short exact sequence `0 → K → F → M → 0` with `F` finite free and `M` projective, if `K`
is stably free then so is `M`. Iterating this along a finite free resolution shows that a
projective module with a finite free resolution is stably free. -/
theorem isStablyFree_of_exact {f : K →ₗ[R] F} {g : F →ₗ[R] M} (hf : Function.Injective f)
    (hfg : Function.Exact f g) (hg : Function.Surjective g) [Module.Finite R F] [Module.Free R F]
    [Module.Projective R M] [Module.IsStablyFree R K] : Module.IsStablyFree R M := by
  obtain ⟨l, hl⟩ := Module.projective_lifting_property g LinearMap.id hg
  let e : F ≃ₗ[R] K × M := (hfg.splitSurjectiveEquiv hf ⟨l, hl⟩).1
  obtain ⟨N, _, _, _, _, _⟩ := Module.IsStablyFree.exist_free_prod R K
  have : Module.Finite R K :=
    Module.Finite.of_surjective ((LinearMap.fst R K M).comp e.toLinearMap)
      fun k => ⟨e.symm (k, 0), by simp⟩
  have : Module.Free R ((K × M) × N) := Module.Free.of_equiv (e.prodCongr (LinearEquiv.refl R N))
  have : Module.Free R ((M × K) × N) :=
    Module.Free.of_equiv ((LinearEquiv.prodComm R K M).prodCongr (LinearEquiv.refl R N))
  have : Module.Free R (M × (K × N)) := Module.Free.of_equiv (LinearEquiv.prodAssoc R M K N)
  exact Module.IsStablyFree.of_free_prod R M (K × N)

end StablyFree

section Induction

universe u

/-- The induction on the dimension behind "a regular local ring is a UFD", with its two remaining
inputs as hypotheses: localizations of regular local rings at primes are regular, and projective
ideals of the localization `R[1/x]` of a regular local ring are stably free. For `x ∈ 𝔪 \ 𝔪²`,
`R` is a UFD iff `R[1/x]` is; the localizations of `R[1/x]` at maximal ideals are localizations of
`R` at non-maximal primes, which are UFDs by induction. -/
theorem uniqueFactorizationMonoid_of_forall_localization
    (H1 : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (q : Ideal R) [q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime q))
    (H2 : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (x : R)
      (P : Ideal (Localization.Away x)), Module.Projective (Localization.Away x) P →
        Module.IsStablyFree (Localization.Away x) P)
    (R : Type u) [CommRing R] [IsRegularLocalRing R] : UniqueFactorizationMonoid R := by
  suffices h : ∀ n : ℕ, ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R],
      ringKrullDim R = n → UniqueFactorizationMonoid R from
    h _ R (IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)).symm
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro R _ _ hn
  rcases le_or_gt n 1 with h1 | h1
  · exact uniqueFactorizationMonoid_of_ringKrullDim_le_one (by rw [hn]; exact_mod_cast h1)
  obtain ⟨x, hxm, hx2⟩ := exists_mem_maximalIdeal_notMem_sq (R := R)
    (by rw [hn]; exact_mod_cast (by omega : 0 < n))
  have := Hartshorne.RegularLocal.isDomain R
  have hx0 : x ≠ 0 := (prime_of_mem_maximalIdeal_of_notMem_sq hxm hx2).ne_zero
  rw [uniqueFactorizationMonoid_iff_localizationAway hxm hx2]
  have : IsDomain (Localization.Away x) := IsLocalization.Away.isDomain (Localization.Away x) hx0
  have : IsNoetherianRing (Localization.Away x) :=
    IsLocalization.isNoetherianRing (Submonoid.powers x) _ inferInstance
  refine uniqueFactorizationMonoid_of_isStablyFree (fun m _ => ?_) (fun P _ _ hP => H2 R x P hP)
  set q := m.comap (algebraMap R (Localization.Away x))
  have hxq : x ∉ q := by
    intro hxq
    exact (‹m.IsMaximal›.ne_top) (Ideal.eq_top_of_isUnit_mem _ hxq
      (IsLocalization.Away.algebraMap_isUnit x))
  have hqm : q < maximalIdeal R :=
    lt_of_le_of_ne (le_maximalIdeal (IsPrime.ne_top inferInstance)) fun h => hxq (h ▸ hxm)
  have := H1 R q
  set k := (maximalIdeal (Localization.AtPrime q)).spanFinrank
  have hk : ringKrullDim (Localization.AtPrime q) = k :=
    (IsRegularLocalRing.spanFinrank_maximalIdeal (R := Localization.AtPrime q)).symm
  have hkn : k < n := by
    have e1 := IsLocalization.AtPrime.ringKrullDim_eq_height q (Localization.AtPrime q)
    have e2 := Ideal.height_add_one_le_of_lt_of_isPrime hqm
    have e3 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := R)
    rw [hk] at e1
    rw [hn] at e3
    have hq : q.height = k := by exact_mod_cast e1.symm
    have hm : (maximalIdeal R).height = n := by exact_mod_cast e3
    rw [hq, hm] at e2
    have : ((k + 1 : ℕ) : ℕ∞) ≤ n := by exact_mod_cast e2
    have : k + 1 ≤ n := by exact_mod_cast this
    omega
  have := ih k hkn (Localization.AtPrime q) hk
  exact (IsLocalization.localizationLocalizationAtPrimeIsoLocalization (Submonoid.powers x)
    m).toMulEquiv.uniqueFactorizationMonoid this

end Induction

section FiniteProjectiveDimension

open CategoryTheory

universe u

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (S : Submonoid R)

/-- Over a Noetherian local ring, let `M` be a finitely generated module of finite projective
dimension. Then any localization of `M` that is projective is stably free (localize a finite free
resolution of `M` and split it from the left). -/
theorem isStablyFree_of_isLocalizedModule_of_hasProjectiveDimensionLE (n : ℕ) :
    ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
      [HasProjectiveDimensionLE (ModuleCat.of R M) n]
      (Mₛ : Type u) [AddCommGroup Mₛ] [Module R Mₛ] [Module (Localization S) Mₛ]
      [IsScalarTower R (Localization S) Mₛ] (f : M →ₗ[R] Mₛ) [IsLocalizedModule S f],
      Module.Projective (Localization S) Mₛ → Module.IsStablyFree (Localization S) Mₛ := by
  induction n with
  | zero =>
    intro M _ _ _ hM Mₛ _ _ _ _ f _ _
    have : Projective (ModuleCat.of R M) := (projective_iff_hasProjectiveDimensionLE_zero _).mpr hM
    have : Module.Projective R M := (IsProjective.iff_projective M).mpr this
    have : Module.Free R M := Module.free_of_flat_of_isLocalRing
    have : Module.Free (Localization S) Mₛ := Module.free_of_isLocalizedModule S f
    infer_instance
  | succ n ih =>
    intro M _ _ _ hM Mₛ _ _ _ _ f _ hproj
    obtain ⟨F, _, _, _, _, g, hg⟩ := Module.exists_finite_presentation R M
    have hS := LinearMap.shortExact_shortComplexKer hg
    have hK : HasProjectiveDimensionLE (ModuleCat.of R (LinearMap.ker g)) n :=
      (hS.hasProjectiveDimensionLT_X₃_iff n inferInstance).mp hM
    let Kₛ := LocalizedModule S (LinearMap.ker g)
    let Fₛ := LocalizedModule S F
    let i : Kₛ →ₗ[Localization S] Fₛ :=
      IsLocalizedModule.mapExtendScalars S (LocalizedModule.mkLinearMap S (LinearMap.ker g))
        (LocalizedModule.mkLinearMap S F) (Localization S) (LinearMap.ker g).subtype
    let p : Fₛ →ₗ[Localization S] Mₛ :=
      IsLocalizedModule.mapExtendScalars S (LocalizedModule.mkLinearMap S F) f (Localization S) g
    have hi : Function.Injective i :=
      IsLocalizedModule.map_injective S _ _ _ (LinearMap.ker g).injective_subtype
    have hp : Function.Surjective p := IsLocalizedModule.map_surjective S _ _ _ hg
    have hip : Function.Exact i p :=
      IsLocalizedModule.map_exact S _ _ _ _ _ (LinearMap.exact_subtype_ker_map g)
    have : Module.Free (Localization S) Fₛ :=
      Module.free_of_isLocalizedModule S (LocalizedModule.mkLinearMap S F)
    obtain ⟨l, hl⟩ := Module.projective_lifting_property p LinearMap.id hp
    let e := (hip.splitSurjectiveEquiv hi ⟨l, hl⟩).1
    have : Module.Projective (Localization S) (Kₛ × Mₛ) := Module.Projective.of_equiv e
    have : Module.Projective (Localization S) Kₛ :=
      Module.Projective.of_split (LinearMap.inl _ Kₛ Mₛ) (LinearMap.fst _ Kₛ Mₛ)
        (LinearMap.ext fun _ => rfl)
    have : Module.IsStablyFree (Localization S) Kₛ :=
      ih (LinearMap.ker g) Kₛ (LocalizedModule.mkLinearMap S (LinearMap.ker g)) inferInstance
    exact isStablyFree_of_exact hi hip hp

/-- Over a Noetherian local ring all of whose finitely generated modules have finite projective
dimension, every projective ideal of a localization is stably free. -/
theorem isStablyFree_of_forall_hasProjectiveDimensionLE
    (hfin : ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M],
      ∃ n, HasProjectiveDimensionLE (ModuleCat.of R M) n)
    (P : Ideal (Localization S)) (hP : Module.Projective (Localization S) P) :
    Module.IsStablyFree (Localization S) P := by
  let P₀ : Ideal R :=
    Submodule.comap (Algebra.linearMap R (Localization S)) (P.restrictScalars R)
  have hP₀ : P₀.localized' (Localization S) S (Algebra.linearMap R (Localization S)) = P :=
    (Submodule.localized'gi (Localization S) S (Algebra.linearMap R (Localization S))).l_u_eq P
  obtain ⟨n, hn⟩ := hfin P₀
  have := isStablyFree_of_isLocalizedModule_of_hasProjectiveDimensionLE S n P₀
    (P₀.localized' (Localization S) S (Algebra.linearMap R (Localization S)))
    (P₀.toLocalized' (Localization S) S (Algebra.linearMap R (Localization S)))
  revert hP
  rw [← hP₀]
  exact this

end FiniteProjectiveDimension

section Conditional

open CategoryTheory

universe u

/-- A regular local ring is a UFD, assuming the two inputs not yet available: localizations of
regular local rings at primes are regular, and finitely generated modules over a regular local
ring have finite projective dimension (one direction of Serre's theorem). -/
theorem uniqueFactorizationMonoid_of_forall_hasProjectiveDimensionLE
    (H1 : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (q : Ideal R) [q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime q))
    (H2 : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (M : Type u) [AddCommGroup M]
      [Module R M] [Module.Finite R M], ∃ n, HasProjectiveDimensionLE (ModuleCat.of R M) n)
    (R : Type u) [CommRing R] [IsRegularLocalRing R] : UniqueFactorizationMonoid R :=
  uniqueFactorizationMonoid_of_forall_localization H1
    (fun A _ _ x P hP =>
      isStablyFree_of_forall_hasProjectiveDimensionLE (Submonoid.powers x) (H2 A) P hP) R

end Conditional

section Serre

open CategoryTheory

universe u

variable {R : Type u} [CommRing R] [IsDomain R] {x : R}

/-- For a nonzero element `x` of a domain `R`, a finite free `R ⧸ (x)`-module has projective
dimension at most one over `R`. -/
theorem hasProjectiveDimensionLE_pi_quotient (hx : x ≠ 0) (m : ℕ) :
    HasProjectiveDimensionLE (ModuleCat.of R (Fin m → R ⧸ Ideal.span {x})) 1 := by
  let f : (Fin m → R) →ₗ[R] (Fin m → R) := x • LinearMap.id
  let g : (Fin m → R) →ₗ[R] (Fin m → R ⧸ Ideal.span {x}) :=
    LinearMap.compLeft (Algebra.linearMap R (R ⧸ Ideal.span {x})) (Fin m)
  have hf : Function.Injective f := smul_right_injective (Fin m → R) hx
  have hg : Function.Surjective g := by
    intro b
    choose c hc using fun i => Ideal.Quotient.mk_surjective (b i)
    exact ⟨c, funext hc⟩
  have hfg : Function.Exact f g := by
    intro a
    constructor
    · intro ha
      have hc : ∀ i, ∃ c, x * c = a i := fun i => by
        have := congr_fun ha i
        simp only [g, LinearMap.compLeft_apply, Function.comp_apply, Algebra.linearMap_apply,
          Pi.zero_apply, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem] at this
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp this
        exact ⟨c, by rw [mul_comm]; exact hc⟩
      choose c hc using hc
      exact ⟨c, funext fun i => by simp [f, hc]⟩
    · rintro ⟨b, rfl⟩
      funext i
      simp only [g, f, LinearMap.compLeft_apply, Function.comp_apply, LinearMap.smul_apply,
        LinearMap.id_apply, Pi.smul_apply, smul_eq_mul, Algebra.linearMap_apply, Pi.zero_apply,
        Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self x)
  let S : ShortComplex (ModuleCat.{u} R) :=
    ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g)
      (ModuleCat.hom_ext (LinearMap.ext fun a => hfg.apply_apply_eq_zero a))
  have hS : S.ShortExact :=
    { exact := (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mpr hfg
      mono_f := (ModuleCat.mono_iff_injective _).mpr hf
      epi_g := (ModuleCat.epi_iff_surjective _).mpr hg }
  exact (hS.hasProjectiveDimensionLT_X₃_iff 0 inferInstance).mpr inferInstance

variable (x) in
/-- Change of rings: for a nonzero element `x` of a domain `R`, a finitely generated
`R ⧸ (x)`-module of projective dimension at most `k` over `R ⧸ (x)` has projective dimension at
most `k + 1` over `R`. -/
theorem hasProjectiveDimensionLE_of_quotient [IsNoetherianRing R] (hx : x ≠ 0) (k : ℕ) :
    ∀ (L : Type u) [AddCommGroup L] [Module (R ⧸ Ideal.span {x}) L] [Module R L]
      [IsScalarTower R (R ⧸ Ideal.span {x}) L] [Module.Finite (R ⧸ Ideal.span {x}) L],
      HasProjectiveDimensionLE (ModuleCat.of (R ⧸ Ideal.span {x}) L) k →
        HasProjectiveDimensionLE (ModuleCat.of R L) (k + 1) := by
  induction k with
  | zero =>
    intro L _ _ _ _ _ hL
    obtain ⟨m, π, hπ⟩ := Module.Finite.exists_fin' (R ⧸ Ideal.span {x}) L
    have : Module.Projective (R ⧸ Ideal.span {x}) L :=
      (IsProjective.iff_projective L).mpr
        ((projective_iff_hasProjectiveDimensionLE_zero _).mpr hL)
    obtain ⟨s, hs⟩ := Module.projective_lifting_property π LinearMap.id hπ
    have := hasProjectiveDimensionLE_pi_quotient hx m
    let r : Retract (ModuleCat.of R L) (ModuleCat.of R (Fin m → R ⧸ Ideal.span {x})) :=
      { i := ModuleCat.ofHom (s.restrictScalars R)
        r := ModuleCat.ofHom (π.restrictScalars R)
        retract := ModuleCat.hom_ext (LinearMap.ext fun l => DFunLike.congr_fun hs l) }
    exact r.hasProjectiveDimensionLT 2
  | succ k ih =>
    intro L _ _ _ _ _ hL
    obtain ⟨m, π, hπ⟩ := Module.Finite.exists_fin' (R ⧸ Ideal.span {x}) L
    have hS := LinearMap.shortExact_shortComplexKer hπ
    have hK : HasProjectiveDimensionLE
        (ModuleCat.of (R ⧸ Ideal.span {x}) (LinearMap.ker π)) k :=
      (hS.hasProjectiveDimensionLT_X₃_iff k inferInstance).mp hL
    have hKR := ih (LinearMap.ker π) hK
    have := hasProjectiveDimensionLE_pi_quotient hx m
    let i : LinearMap.ker π →ₗ[R] (Fin m → R ⧸ Ideal.span {x}) :=
      (LinearMap.ker π).subtype.restrictScalars R
    let p : (Fin m → R ⧸ Ideal.span {x}) →ₗ[R] L := π.restrictScalars R
    have hip : Function.Exact i p := LinearMap.exact_subtype_ker_map π
    let S' : ShortComplex (ModuleCat.{u} R) :=
      ShortComplex.mk (ModuleCat.ofHom i) (ModuleCat.ofHom p)
        (ModuleCat.hom_ext (LinearMap.ext fun a => hip.apply_apply_eq_zero a))
    have hS' : S'.ShortExact :=
      { exact := (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mpr hip
        mono_f := (ModuleCat.mono_iff_injective _).mpr (LinearMap.ker π).injective_subtype
        epi_g := (ModuleCat.epi_iff_surjective _).mpr hπ }
    have h2 : HasProjectiveDimensionLT S'.X₂ (k + 1 + 1 + 1) :=
      hasProjectiveDimensionLT_of_ge _ 2 _ (by omega)
    exact hS'.hasProjectiveDimensionLT_X₃ (k + 1 + 1) hKR h2

/-- One direction of Serre's theorem: a finitely generated module over a regular local ring whose
maximal ideal is generated by `d` elements has projective dimension at most `d`. -/
theorem hasProjectiveDimensionLE_of_isRegularLocalRing (d : ℕ) :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A], (IsLocalRing.maximalIdeal A).spanFinrank = d →
      ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
        HasProjectiveDimensionLE (ModuleCat.of A M) d := by
  induction d with
  | zero =>
    intro A _ _ hd M _ _ _
    have hbot : IsLocalRing.maximalIdeal A = ⊥ :=
      (Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian _)).mp hd
    let := (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot).toField
    have : Module.Free A M := Module.Free.of_divisionRing A M
    exact (projective_iff_hasProjectiveDimensionLE_zero _).mp inferInstance
  | succ d ih =>
    intro A _ _ hd M _ _ _
    have := Hartshorne.RegularLocal.isDomain A
    have hdim : ringKrullDim A = ((d + 1 : ℕ) : WithBot ℕ∞) := by
      rw [← hd]
      exact (IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)).symm
    obtain ⟨y, hym, hy2⟩ := exists_mem_maximalIdeal_notMem_sq (R := A)
      (by rw [hdim]; exact_mod_cast Nat.succ_pos d)
    have hy0 : y ≠ 0 := (prime_of_mem_maximalIdeal_of_notMem_sq hym hy2).ne_zero
    obtain ⟨hregq, hdimq⟩ := Hartshorne.RegularLocal.isRegularLocalRing_quotient_of_notMem_sq hym hy2
    have hdq : (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {y})).spanFinrank = d := by
      have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A ⧸ Ideal.span {y})
      rw [← h1, hdim] at hdimq
      have : (IsLocalRing.maximalIdeal (A ⧸ Ideal.span {y})).spanFinrank + 1 = d + 1 := by
        exact_mod_cast hdimq
      omega
    obtain ⟨F, _, _, _, _, g, hg⟩ := Module.exists_finite_presentation A M
    have hS := LinearMap.shortExact_shortComplexKer hg
    suffices hN : HasProjectiveDimensionLE (ModuleCat.of A (LinearMap.ker g)) d from
      (hS.hasProjectiveDimensionLT_X₃_iff d inferInstance).mpr hN
    have hreg : IsSMulRegular (LinearMap.ker g) y := IsSMulRegular.of_ne_zero hy0
    have : Module.Finite (A ⧸ Ideal.span {y}) (QuotSMulTop y (LinearMap.ker g)) :=
      Module.Finite.of_restrictScalars_finite A _ _
    have hQ := ih (A ⧸ Ideal.span {y}) hdq (QuotSMulTop y (LinearMap.ker g))
    have hQR := hasProjectiveDimensionLE_of_quotient y hy0 d (QuotSMulTop y (LinearMap.ker g)) hQ
    have heq := ModuleCat.projectiveDimension_quotSMulTop_eq_succ_of_isSMulRegular
      (ModuleCat.of A (LinearMap.ker g)) y hreg hym
    rw [← projectiveDimension_le_iff] at hQR ⊢
    erw [heq] at hQR
    generalize projectiveDimension (ModuleCat.of A (LinearMap.ker g)) = e at hQR ⊢
    induction e using WithBot.recBotCoe with
    | bot => exact bot_le
    | coe e =>
      have h1 : e + 1 ≤ (d : ℕ∞) + 1 := by exact_mod_cast hQR
      have h2 : e ≤ d := (ENat.add_le_add_iff_right ENat.one_ne_top).mp h1
      exact_mod_cast h2

/-- A regular local ring is a UFD, assuming only that localizations of regular local rings at prime
ideals are regular. -/
theorem uniqueFactorizationMonoid_of_forall_isRegularLocalRing_localization
    (H1 : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] (q : Ideal A) [q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime q))
    (A : Type u) [CommRing A] [IsRegularLocalRing A] : UniqueFactorizationMonoid A :=
  uniqueFactorizationMonoid_of_forall_hasProjectiveDimensionLE H1
    (fun B _ _ M _ _ _ => ⟨_, hasProjectiveDimensionLE_of_isRegularLocalRing _ B rfl M⟩) A

end Serre

end Hartshorne.RegularLocalFactorial
