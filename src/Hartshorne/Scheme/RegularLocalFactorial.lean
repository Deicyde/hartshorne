import Mathlib.RingTheory.Ideal.UFD
import Mathlib.Algebra.Module.StablyFree.FreeOfInvertible
import Mathlib.RingTheory.LocalProperties.ProjectiveDimension
import Mathlib.RingTheory.LocalRing.Module
