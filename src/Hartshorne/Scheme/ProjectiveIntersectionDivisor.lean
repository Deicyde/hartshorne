/-!
# Divisors cut by hypersurfaces of projective space

Hartshorne, *Algebraic Geometry*, Exercise II.6.2(a) (p. 146).

Let `ℙⁿ_k = Proj k[x₀, ..., xₙ]` and let `ι : X ⟶ ℙⁿ_k` be a morphism from a scheme `X` satisfying
Hartshorne's condition `(*)`. An irreducible hypersurface `V ⊆ ℙⁿ_k` is a prime divisor of
`ℙⁿ_k`; its homogeneous prime is generated by one homogeneous polynomial `f`
(`Hartshorne.exists_projectivePrimeDivisor_equation`), and conversely an irreducible homogeneous
`f` cuts out the prime divisor `Hartshorne.projectiveHypersurfacePrimeDivisor`.

A *local equation* of `V` on an open set `U ⊆ ℙⁿ_k` is a regular function on `U` whose germ at
every point `q ∈ U` generates the ideal of `V` in `𝒪_{ℙⁿ, q}`, i.e. is associated to `f / g` with
`g` homogeneous of degree `deg f` and `g(q) ≠ 0`
(`Hartshorne.IsProjectiveHypersurfaceLocalEquation`).
The divisor `V · X` has coefficient `ord_Y (h|_X)` along a prime divisor `Y` of `X`, for a local
equation `h` of `V` near the image of the generic point of `Y`; it is computed with the standard
local equation `f / x_i^d` on a chart `D₊(x_i)`, and any other local equation gives the same
coefficient as soon as `V` does not contain `X`
(`Hartshorne.projectiveIntersectionDivisor_apply_eq_ord`): two local equations differ by a unit
of the local ring, and units have order zero. The divisor is supported on the prime divisors of
`X` lying in `V`. Finally `D ↦ D · X` is extended linearly to
the Weil divisors of `ℙⁿ_k` none of whose components contain `X`.

## Main definitions

* `Hartshorne.IsProjectiveHypersurfaceLocalEquation`: local equations of a prime divisor of `ℙⁿ_k`.
* `Hartshorne.projectiveIntersectionDivisor`: the Weil divisor `V · X`.
* `Hartshorne.projectiveIntersectionDivisorHom`: the linear extension `D ↦ D · X`.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial HomogeneousLocalization

namespace Hartshorne

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type u} [Field k] {n : ℕ}

local notation "𝒜" => homogeneousSubmodule (Fin (n + 1)) k

local notation "S" => MvPolynomial (Fin (n + 1)) k

/-- The regular function `f / g` on the chart `D₊(g)` of `ℙⁿ_k`, for homogeneous `f` and `g` of
the same degree. -/
def hypersurfaceChartEquation (f g : S) {d : ℕ} (hf : f.IsHomogeneous d)
    (hg : g.IsHomogeneous d) : Γ(Proj 𝒜, Proj.basicOpen 𝒜 g) :=
  Proj.awayToSection 𝒜 g
    (HomogeneousLocalization.mk ⟨d, ⟨f, (mem_homogeneousSubmodule d f).mpr hf⟩,
      ⟨g, (mem_homogeneousSubmodule d g).mpr hg⟩, ⟨1, pow_one g⟩⟩)

/-- The germ of `f / g` at a point of `D₊(g)` is the fraction `f / g` of the homogeneous
localization. -/
theorem germ_hypersurfaceChartEquation (f g : S) {d : ℕ} (hf : f.IsHomogeneous d)
    (hg : g.IsHomogeneous d) (q : Proj 𝒜) (hq : q ∈ Proj.basicOpen 𝒜 g) :
    (Proj 𝒜).presheaf.germ _ q hq (hypersurfaceChartEquation f g hf hg) =
      (Proj.stalkIso 𝒜 q).inv (HomogeneousLocalization.mk
        ⟨d, ⟨f, (mem_homogeneousSubmodule d f).mpr hf⟩,
          ⟨g, (mem_homogeneousSubmodule d g).mpr hg⟩, hq⟩) := by
  have := congr($(ProjectiveSpectrum.Proj.awayToSection_germ 𝒜 g q hq)
    (HomogeneousLocalization.mk ⟨d, ⟨f, (mem_homogeneousSubmodule d f).mpr hf⟩,
      ⟨g, (mem_homogeneousSubmodule d g).mpr hg⟩, ⟨1, pow_one g⟩⟩))
  exact this

section atPrime
variable {P : Ideal (MvPolynomial (Fin (n + 1)) k)} [P.IsPrime]

private theorem atPrime_mk_eq_mk' {i j : ℕ} {a b : 𝒜 i} {a' b' : 𝒜 j}
    (hb : (b : S) ∈ P.primeCompl) (hb' : (b' : S) ∈ P.primeCompl) (h : (a : S) * b' = a' * b) :
    (HomogeneousLocalization.mk ⟨i, a, b, hb⟩ : AtPrime 𝒜 P) =
      HomogeneousLocalization.mk ⟨j, a', b', hb'⟩ := by
  apply HomogeneousLocalization.val_injective
  simp only [HomogeneousLocalization.val_mk]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp only [OneMemClass.coe_one, one_mul]; rw [mul_comm, h, mul_comm]⟩

private theorem atPrime_mk_isUnit' {i : ℕ} {a b : 𝒜 i} (hb : (b : S) ∈ P.primeCompl)
    (ha : (a : S) ∈ P.primeCompl) :
    IsUnit (HomogeneousLocalization.mk ⟨i, a, b, hb⟩ : AtPrime 𝒜 P) := by
  refine isUnit_iff_exists_inv.mpr ⟨HomogeneousLocalization.mk ⟨i, b, a, ha⟩, ?_⟩
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_mk,
    HomogeneousLocalization.val_mk, HomogeneousLocalization.val_one, Localization.mk_mul,
    mul_comm (a : S)]
  exact Localization.mk_self ⟨(b : S) * a, P.primeCompl.mul_mem hb ha⟩

/-- Two fractions `a / b` and `a' / b'` are associated when `a' / b' = (a / b) * (c / e)` with
`c, e` outside the prime. -/
private theorem atPrime_mk_associated' {i j l : ℕ} {a b : 𝒜 i} {a' b' : 𝒜 j} {c e : 𝒜 l}
    (hb : (b : S) ∈ P.primeCompl) (hb' : (b' : S) ∈ P.primeCompl)
    (hc : (c : S) ∈ P.primeCompl) (he : (e : S) ∈ P.primeCompl)
    (h : (a' : S) * (b * e) = a * c * b') :
    Associated (HomogeneousLocalization.mk ⟨i, a, b, hb⟩ : AtPrime 𝒜 P)
      (HomogeneousLocalization.mk ⟨j, a', b', hb'⟩) := by
  obtain ⟨u, hu⟩ := atPrime_mk_isUnit' (P := P) he hc
  refine ⟨u, ?_⟩
  rw [hu, ← HomogeneousLocalization.mk_mul]
  apply atPrime_mk_eq_mk'
  change (a : S) * c * b' = a' * (b * e)
  rw [h]

end atPrime

private theorem exists_projectiveSpace_X_notMem (p : Proj 𝒜) :
    ∃ i, (MvPolynomial.X i : S) ∉ p.asHomogeneousIdeal := by
  by_contra hall
  push Not at hall
  apply p.not_irrelevant_le
  intro a ha
  have ha0 : homogeneousComponent 0 a = 0 := by
    rw [← decomposition.decompose'_apply]
    exact ha
  have hspan : a ∈ Ideal.span ((MvPolynomial.X : Fin (n + 1) → S) '' Set.univ) := by
    rw [mem_ideal_span_X_image]
    intro m hm
    by_contra hm0
    push Not at hm0
    have hm0' : m = 0 := by ext i; simpa using hm0 i trivial
    subst hm0'
    have := congr(MvPolynomial.coeff 0 $ha0)
    rw [coeff_homogeneousComponent] at this
    simp at this
    exact (MvPolynomial.mem_support_iff.mp hm) this
  refine (Ideal.span_le.mpr ?_) hspan
  rintro _ ⟨i, -, rfl⟩
  exact hall i

private theorem exists_projectiveSpace_chart (p : Proj 𝒜) (d : ℕ) :
    ∃ g : S, g.IsHomogeneous d ∧ p ∈ Proj.basicOpen 𝒜 g := by
  obtain ⟨i, hi⟩ := exists_projectiveSpace_X_notMem p
  refine ⟨MvPolynomial.X i ^ d, isHomogeneous_X_pow i d, ?_⟩
  rw [Proj.mem_basicOpen]
  exact fun h ↦ hi (p.isPrime.mem_of_pow_mem d h)

section ord
variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]

private theorem ord_algebraMap_stalk_of_isUnit {x : X} {u : X.presheaf.stalk x} (hu : IsUnit u) :
    X.ord (algebraMap _ X.functionField u) x = 0 := by
  by_cases hx : Order.coheight x = 1
  · have : Ring.KrullDimLE 1 (X.presheaf.stalk x) := krullDimLE_of_coheight_le hx.le
    have hu' : algebraMap _ X.functionField u ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective (X.presheaf.stalk x) X.functionField)).mpr
        hu.ne_zero
    rw [Scheme.ord_eq_iff hx hu', Scheme.ordHom]
    exact Ring.ordFrac_of_isUnit hu
  · exact Scheme.ord_eq_zero_of_coheight_neq_one hx _

private theorem ord_algebraMap_stalk_eq_of_associated {x : X} {a b : X.presheaf.stalk x}
    (hab : Associated a b) (ha : a ≠ 0) :
    X.ord (algebraMap _ X.functionField b) x = X.ord (algebraMap _ X.functionField a) x := by
  obtain ⟨u, rfl⟩ := hab
  have hinj := IsFractionRing.injective (X.presheaf.stalk x) X.functionField
  have ha' : algebraMap _ X.functionField a ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr ha
  have hu' : algebraMap _ X.functionField (u : X.presheaf.stalk x) ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr u.ne_zero
  rw [map_mul, Scheme.ord_mul ha' hu', add_eq_left]
  exact ord_algebraMap_stalk_of_isUnit u.isUnit

end ord

private theorem projectiveSpace_specializes_iff (x y : Proj 𝒜) :
    x ⤳ y ↔ x.asHomogeneousIdeal ≤ y.asHomogeneousIdeal := by
  rw [specializes_iff_mem_closure]
  exact (ProjectiveSpectrum.le_iff_mem_closure 𝒜 x y).symm

/-- The homogeneous prime of a prime divisor of `ℙⁿ_k` is generated by one nonzero homogeneous
polynomial. -/
theorem exists_projectivePrimeDivisor_equation (V : (Proj 𝒜).PrimeDivisor) :
    ∃ (f : S) (d : ℕ), f.IsHomogeneous d ∧ f ≠ 0 ∧
      V.1.asHomogeneousIdeal.toIdeal = Ideal.span {f} := by
  classical
  set 𝔭 := V.1.asHomogeneousIdeal.toIdeal with h𝔭
  have hprime : 𝔭.IsPrime := V.1.isPrime
  have hhom : 𝔭.IsHomogeneous 𝒜 := V.1.asHomogeneousIdeal.isHomogeneous
  -- the ideal is nonzero, since otherwise `V` would be the generic point
  have hne : 𝔭 ≠ ⊥ := by
    intro hbot
    have hmax : IsMax V.1 := by
      intro w hw
      change V.1 ⤳ w
      change w ⤳ V.1 at hw
      rw [projectiveSpace_specializes_iff] at hw ⊢
      intro a ha
      have : a ∈ 𝔭 := ha
      rw [hbot] at this
      rw [(Submodule.mem_bot _).mp this]
      exact zero_mem _
    have := V.2
    rw [Order.coheight_eq_zero.mpr hmax] at this
    exact zero_ne_one this
  -- a nonzero homogeneous element of the ideal
  have hhomog_ne : ∀ a ∈ 𝔭, a ≠ 0 → ∃ i, homogeneousComponent i a ∈ 𝔭 ∧
      homogeneousComponent i a ≠ 0 := by
    intro a ha ha0
    by_contra hall
    push Not at hall
    apply ha0
    rw [← sum_homogeneousComponent a]
    refine Finset.sum_eq_zero fun i _ ↦ hall i ?_
    have := hhom.mem_iff.mp ha i
    rwa [← decomposition.decompose'_apply]
  obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  obtain ⟨i, hb, hb0⟩ := hhomog_ne a ha ha0
  set b := homogeneousComponent i a
  -- a prime factor of `b` lying in the ideal
  have hprod : (UniqueFactorizationMonoid.factors b).prod ∈ 𝔭 := by
    obtain ⟨u, hu⟩ := UniqueFactorizationMonoid.factors_prod hb0
    rwa [← hu, Ideal.mul_unit_mem_iff_mem _ u.isUnit] at hb
  obtain ⟨q, hqf, hq𝔭⟩ := (hprime.multiset_prod_mem_iff_exists_mem _).mp hprod
  have hqprime : Prime q := UniqueFactorizationMonoid.prime_of_factor q hqf
  have hqb : q ∣ b := UniqueFactorizationMonoid.dvd_of_mem_factors hqf
  set J := Ideal.span ({q} : Set (S))
  have hJprime : J.IsPrime := (Ideal.span_singleton_prime hqprime.ne_zero).mpr hqprime
  have hJ𝔭 : J ≤ 𝔭 := (Ideal.span_singleton_le_iff_mem _).mpr hq𝔭
  set Jc := J.homogeneousCore 𝒜
  have hbJc : b ∈ Jc.toIdeal :=
    Ideal.mem_homogeneousCore_of_homogeneous_of_mem
      ⟨i, (mem_homogeneousSubmodule i b).mpr (homogeneousComponent_isHomogeneous i a)⟩
      (Ideal.mem_span_singleton.mpr hqb)
  have hJcJ : Jc.toIdeal ≤ J := Ideal.toIdeal_homogeneousCore_le 𝒜 J
  let w : Proj 𝒜 := ⟨Jc, hJprime.homogeneousCore,
    fun h ↦ V.1.not_irrelevant_le (h.trans (hJcJ.trans hJ𝔭))⟩
  have hbot_relevant : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ (⊥ : HomogeneousIdeal 𝒜) := by
    intro h
    have hX : (MvPolynomial.X 0 : S) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply,
        DirectSum.decompose_of_mem_ne 𝒜 ((mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X k 0))
          one_ne_zero]
    have := h hX
    exact MvPolynomial.X_ne_zero 0 ((Submodule.mem_bot _).mp this)
  let gen : Proj 𝒜 := ⟨⊥, Ideal.isPrime_bot, hbot_relevant⟩
  have hwgen : w < gen := by
    refine ⟨?_, ?_⟩
    · rw [projectiveSpace_specializes_iff]
      exact bot_le
    · intro h
      change w ⤳ gen at h
      rw [projectiveSpace_specializes_iff] at h
      exact hb0 ((Submodule.mem_bot _).mp (h hbJc))
  have hJc_eq : Jc.toIdeal = 𝔭 := by
    by_contra hne'
    have hvw : V.1 < w := by
      refine ⟨?_, ?_⟩
      · rw [projectiveSpace_specializes_iff]
        exact hJcJ.trans hJ𝔭
      · intro h
        change V.1 ⤳ w at h
        rw [projectiveSpace_specializes_iff] at h
        exact hne' (le_antisymm (hJcJ.trans hJ𝔭) h)
    have h1 := Order.coheight_add_one_le hvw
    have h2 := Order.coheight_add_one_le hwgen
    rw [V.2] at h1
    have h3 := (show Order.coheight gen + 1 + 1 ≤ Order.coheight w + 1 by gcongr).trans h1
    rw [add_assoc] at h3
    have := le_trans le_add_self h3
    norm_num at this
  have h𝔭J : 𝔭 = J := le_antisymm (hJc_eq ▸ hJcJ) hJ𝔭
  -- the top-degree argument: a nonzero homogeneous component of `q` is a unit multiple of `q`
  have hq0 : q ≠ 0 := hqprime.ne_zero
  obtain ⟨j, hfj, hf0⟩ := hhomog_ne q hq𝔭 hq0
  set f := homogeneousComponent j q
  rw [h𝔭J] at hfj
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hfj
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hc
    exact hf0 hc.symm
  have hdeg := totalDegree_mul_of_isDomain hc0 hq0
  have hfdeg : f.totalDegree = j := (homogeneousComponent_isHomogeneous j q).totalDegree hf0
  have hjle : j ≤ q.totalDegree := by
    by_contra h
    push Not at h
    exact hf0 (homogeneousComponent_eq_zero j q h)
  rw [hc, hfdeg] at hdeg
  have hcdeg : c.totalDegree = 0 := by omega
  have hcunit : IsUnit c := by
    rw [totalDegree_eq_zero_iff_eq_C] at hcdeg
    rw [hcdeg]
    refine (isUnit_iff_ne_zero.mpr fun h0 ↦ hc0 ?_).map MvPolynomial.C
    rw [hcdeg, h0, map_zero]
  refine ⟨f, j, homogeneousComponent_isHomogeneous j q, hf0, ?_⟩
  rw [h𝔭J]
  exact Ideal.span_singleton_eq_span_singleton.mpr ⟨hcunit.unit, by rw [← hc, mul_comm]; rfl⟩

private theorem germ_chartEquation_associated {f f' g g' : S} {d d' : ℕ}
    (hf : f.IsHomogeneous d) (hf' : f'.IsHomogeneous d') (hg : g.IsHomogeneous d)
    (hg' : g'.IsHomogeneous d') (hf0 : f ≠ 0)
    (hff' : Ideal.span ({f} : Set (S)) = Ideal.span {f'})
    (q : Proj 𝒜) (hq : q ∈ Proj.basicOpen 𝒜 g) (hq' : q ∈ Proj.basicOpen 𝒜 g') :
    Associated ((Proj 𝒜).presheaf.germ _ q hq (hypersurfaceChartEquation f g hf hg))
      ((Proj 𝒜).presheaf.germ _ q hq' (hypersurfaceChartEquation f' g' hf' hg')) := by
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hff'
  obtain ⟨c, hc, hcu⟩ := (isUnit_iff_eq_C_of_isReduced (P := (u : S))).mp
    u.isUnit
  have hf'C : f' = f * C c := by rw [← hu, hcu]
  have hdd' : d = d' := by
    have h1 : f'.IsHomogeneous (d + 0) := hf'C ▸ hf.mul (isHomogeneous_C _ c)
    rw [add_zero] at h1
    refine h1.inj_right hf' ?_
    rw [hf'C]
    exact mul_ne_zero hf0 (by rwa [Ne, C_eq_zero, ← isUnit_iff_ne_zero.not_left, not_not])
  subst hdd'
  have := q.isPrime
  rw [germ_hypersurfaceChartEquation, germ_hypersurfaceChartEquation]
  refine Associated.map (Proj.stalkIso 𝒜 q).inv.hom ?_
  have hgq : g ∈ q.asHomogeneousIdeal.toIdeal.primeCompl := hq
  have hCg : C c * g ∈ q.asHomogeneousIdeal.toIdeal.primeCompl := by
    intro hmem
    rcases q.isPrime.mem_or_mem hmem with h | h
    · exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h (hc.map C))
    · exact hgq h
  refine atPrime_mk_associated' (c := ⟨C c * g, (mem_homogeneousSubmodule d _).mpr
      (by simpa using (isHomogeneous_C _ c).mul hg)⟩)
    (e := ⟨g', (mem_homogeneousSubmodule d _).mpr hg'⟩) _ _ hCg hq' ?_
  change f' * (g * g') = f * (C c * g) * g'
  rw [hf'C]
  ring

section ord
variable {X : Scheme.{u}}

/-- If `f` does not vanish identically on `X`, the restriction of `f / g` to `X` is nonzero in
every stalk of `X` along `D₊(g)`. -/
private theorem stalkMap_germ_chartEquation_ne_zero [IsIntegral X] (ι : X ⟶ Proj 𝒜) {f g : S}
    {d : ℕ} (hf : f.IsHomogeneous d) (hg : g.IsHomogeneous d)
    (hXf : ∃ z : X, f ∉ (ι z).asHomogeneousIdeal) (x : X) (hx : ι x ∈ Proj.basicOpen 𝒜 g) :
    ι.stalkMap x ((Proj 𝒜).presheaf.germ _ (ι x) hx (hypersurfaceChartEquation f g hf hg)) ≠ 0 := by
  obtain ⟨z, hz⟩ := hXf
  set η := genericPoint X
  have hηU : ι η ∈ Proj.basicOpen 𝒜 g :=
    ((genericPoint_spec X).mem_open_set_iff (ι ⁻¹ᵁ Proj.basicOpen 𝒜 g).isOpen).mpr
      ⟨x, trivial, hx⟩
  have hfη : f ∉ (ι η).asHomogeneousIdeal := by
    have hsp : ι η ⤳ ι z := ((genericPoint_spec X).specializes trivial).map ι.continuous
    rw [projectiveSpace_specializes_iff] at hsp
    exact fun h ↦ hz (hsp h)
  have hunit :
      IsUnit ((Proj 𝒜).presheaf.germ _ (ι η) hηU (hypersurfaceChartEquation f g hf hg)) := by
    have := (ι η).isPrime
    rw [germ_hypersurfaceChartEquation]
    exact (atPrime_mk_isUnit' (P := (ι η).asHomogeneousIdeal.toIdeal)
      (a := ⟨f, (mem_homogeneousSubmodule d f).mpr hf⟩)
      (b := ⟨g, (mem_homogeneousSubmodule d g).mpr hg⟩) hηU hfη).map _
  intro h0
  rw [Scheme.Hom.germ_stalkMap_apply] at h0
  have hsec : ι.app _ (hypersurfaceChartEquation f g hf hg) = 0 :=
    (map_eq_zero_iff _ (germ_injective_of_isIntegral X x hx)).mp h0
  have h1 : ι.stalkMap η
      ((Proj 𝒜).presheaf.germ _ (ι η) hηU (hypersurfaceChartEquation f g hf hg)) = 0 := by
    rw [Scheme.Hom.germ_stalkMap_apply, hsec, map_zero]
  exact (hunit.map (ι.stalkMap η).hom).ne_zero h1

/-- Associated germs of local equations at `ι x` have the same order along `x` after restriction
to `X`. -/
private theorem ord_restrict_eq_of_associated' [IsIntegral X] [IsLocallyNoetherian X]
    (ι : X ⟶ Proj 𝒜)
    {U U' : (Proj 𝒜).Opens} (h : Γ(Proj 𝒜, U)) (h' : Γ(Proj 𝒜, U')) (x : X)
    (hx : ι x ∈ U) (hx' : ι x ∈ U')
    (hassoc : Associated ((Proj 𝒜).presheaf.germ U (ι x) hx h)
      ((Proj 𝒜).presheaf.germ U' (ι x) hx' h'))
    (hne : ι.stalkMap x ((Proj 𝒜).presheaf.germ U (ι x) hx h) ≠ 0) :
    X.ord (algebraMap (X.presheaf.stalk x) X.functionField
        (X.presheaf.germ (ι ⁻¹ᵁ U') x hx' (ι.app U' h'))) x =
      X.ord (algebraMap (X.presheaf.stalk x) X.functionField
        (X.presheaf.germ (ι ⁻¹ᵁ U) x hx (ι.app U h))) x := by
  rw [← Scheme.Hom.germ_stalkMap_apply, ← Scheme.Hom.germ_stalkMap_apply]
  exact ord_algebraMap_stalk_eq_of_associated (hassoc.map (ι.stalkMap x).hom) hne

end ord

/-- The chosen homogeneous equation of a prime divisor of `ℙⁿ_k`. -/
def projectivePrimeDivisorEquation (V : (Proj 𝒜).PrimeDivisor) : S :=
  Classical.choose (exists_projectivePrimeDivisor_equation V)

/-- The degree of the chosen homogeneous equation of a prime divisor of `ℙⁿ_k`. -/
def projectivePrimeDivisorEquationDegree (V : (Proj 𝒜).PrimeDivisor) : ℕ :=
  Classical.choose (Classical.choose_spec (exists_projectivePrimeDivisor_equation V))

theorem projectivePrimeDivisorEquation_isHomogeneous (V : (Proj 𝒜).PrimeDivisor) :
    (projectivePrimeDivisorEquation V).IsHomogeneous (projectivePrimeDivisorEquationDegree V) :=
  (Classical.choose_spec (Classical.choose_spec (exists_projectivePrimeDivisor_equation V))).1

theorem projectivePrimeDivisorEquation_ne_zero (V : (Proj 𝒜).PrimeDivisor) :
    projectivePrimeDivisorEquation V ≠ 0 :=
  (Classical.choose_spec (Classical.choose_spec (exists_projectivePrimeDivisor_equation V))).2.1

theorem span_projectivePrimeDivisorEquation (V : (Proj 𝒜).PrimeDivisor) :
    V.1.asHomogeneousIdeal.toIdeal = Ideal.span {projectivePrimeDivisorEquation V} :=
  (Classical.choose_spec (Classical.choose_spec (exists_projectivePrimeDivisor_equation V))).2.2

/-- A point of `ℙⁿ_k` lies on a prime divisor exactly when the equation vanishes there. -/
theorem mem_closure_projectivePrimeDivisor_iff (V : (Proj 𝒜).PrimeDivisor) (p : Proj 𝒜) :
    p ∈ closure ({V.1} : Set (Proj 𝒜)) ↔
      projectivePrimeDivisorEquation V ∈ p.asHomogeneousIdeal := by
  rw [← specializes_iff_mem_closure, projectiveSpace_specializes_iff]
  constructor
  · intro h
    apply h
    change projectivePrimeDivisorEquation V ∈ V.1.asHomogeneousIdeal.toIdeal
    rw [span_projectivePrimeDivisorEquation]
    exact Ideal.subset_span rfl
  · intro h a ha
    change a ∈ V.1.asHomogeneousIdeal.toIdeal at ha
    rw [span_projectivePrimeDivisorEquation, Ideal.mem_span_singleton'] at ha
    obtain ⟨b, rfl⟩ := ha
    exact Ideal.mul_mem_left _ b h

private theorem projectiveSpace_X_mem_irrelevant (i : Fin (n + 1)) :
    (MvPolynomial.X i : S) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
  rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply,
    DirectSum.decompose_of_mem_ne 𝒜 ((mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X k i))
      one_ne_zero]

/-- The prime ideal `(f)` of an irreducible homogeneous polynomial, as a homogeneous ideal. -/
def projectiveHypersurfaceIdeal {f : S} {d : ℕ}
    (hf : f.IsHomogeneous d) : HomogeneousIdeal 𝒜 :=
  ⟨Ideal.span {f}, Ideal.homogeneous_span _ _ fun g hg ↦ by
    rw [Set.mem_singleton_iff.mp hg]
    exact ⟨d, (mem_homogeneousSubmodule d f).mpr hf⟩⟩

theorem mem_projectiveHypersurfaceIdeal {f : S} {d : ℕ}
    (hf : f.IsHomogeneous d) (a : S) :
    a ∈ projectiveHypersurfaceIdeal hf ↔ f ∣ a :=
  Ideal.mem_span_singleton

theorem projectiveHypersurfaceIdeal_isPrime {f : S} {d : ℕ}
    (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    (projectiveHypersurfaceIdeal hf).toIdeal.IsPrime :=
  (Ideal.span_singleton_prime hirr.ne_zero).mpr
    (UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr)

theorem projectiveHypersurfaceIdeal_relevant (hn : 0 < n) {f : S}
    {d : ℕ} (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    ¬HomogeneousIdeal.irrelevant 𝒜 ≤ projectiveHypersurfaceIdeal hf := by
  intro h
  have hdvd : ∀ i : Fin (n + 1), (MvPolynomial.X i : S) ∣ f :=
    fun i ↦ hirr.dvd_symm (MvPolynomial.X_prime (R := k) (i := i)).irreducible
      ((mem_projectiveHypersurfaceIdeal hf _).mp (h (projectiveSpace_X_mem_irrelevant i)))
  have h01 : (MvPolynomial.X 0 : S) ∣ MvPolynomial.X ⟨1, by omega⟩ :=
    (hdvd 0).trans ((mem_projectiveHypersurfaceIdeal hf _).mp
      (h (projectiveSpace_X_mem_irrelevant ⟨1, by omega⟩)))
  rw [X_dvd_X] at h01
  have := congrArg Fin.val h01
  simp at this

/-- The generic point of the hypersurface `V(f) ⊆ ℙⁿ_k`: the relevant homogeneous prime `(f)`. -/
def projectiveHypersurfacePoint (hn : 0 < n) {f : S} {d : ℕ}
    (hf : f.IsHomogeneous d) (hirr : Irreducible f) : Proj 𝒜 :=
  ⟨projectiveHypersurfaceIdeal hf, projectiveHypersurfaceIdeal_isPrime hf hirr,
    projectiveHypersurfaceIdeal_relevant hn hf hirr⟩

theorem coheight_projectiveHypersurfacePoint (hn : 0 < n) {f : S}
    {d : ℕ} (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    Order.coheight (projectiveHypersurfacePoint hn hf hirr) = 1 := by
  set v := projectiveHypersurfacePoint hn hf hirr
  have hvideal : v.asHomogeneousIdeal.toIdeal = Ideal.span {f} := rfl
  -- every point strictly more general than `v` is the generic point
  have habove : ∀ w : Proj 𝒜, v < w → w.asHomogeneousIdeal.toIdeal = ⊥ := by
    intro w hvw
    have hwv : w.asHomogeneousIdeal.toIdeal ≤ Ideal.span {f} :=
      hvideal ▸ (projectiveSpace_specializes_iff w v).mp hvw.1
    by_contra hne
    obtain ⟨p, hpw, hp⟩ := w.isPrime.exists_mem_prime_of_ne_bot hne
    have hpf : p ∣ f := hirr.dvd_symm hp.irreducible (Ideal.mem_span_singleton.mp (hwv hpw))
    have hfw : f ∈ w.asHomogeneousIdeal.toIdeal := by
      obtain ⟨c, hc⟩ := hpf
      rw [hc]
      exact Ideal.mul_mem_right _ _ hpw
    apply hvw.2
    rw [projectiveSpace_specializes_iff]
    change v.asHomogeneousIdeal.toIdeal ≤ w.asHomogeneousIdeal.toIdeal
    rw [hvideal]
    exact (Ideal.span_singleton_le_iff_mem _).mpr hfw
  have hmax : ∀ w : Proj 𝒜, v < w → IsMax w := by
    intro w hvw w' _
    change w ⤳ w'
    rw [projectiveSpace_specializes_iff]
    change w.asHomogeneousIdeal.toIdeal ≤ w'.asHomogeneousIdeal.toIdeal
    rw [habove w hvw]
    exact bot_le
  have hbot_relevant : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ (⊥ : HomogeneousIdeal 𝒜) := fun h ↦
    MvPolynomial.X_ne_zero 0 ((Submodule.mem_bot _).mp (h (projectiveSpace_X_mem_irrelevant 0)))
  let gen : Proj 𝒜 := ⟨⊥, Ideal.isPrime_bot, hbot_relevant⟩
  have hvgen : v < gen := by
    refine ⟨?_, ?_⟩
    · rw [projectiveSpace_specializes_iff]
      exact bot_le
    · intro h
      change v ⤳ gen at h
      rw [projectiveSpace_specializes_iff] at h
      have hf' : f ∈ v.asHomogeneousIdeal.toIdeal := by
        rw [hvideal]
        exact Ideal.subset_span rfl
      exact hirr.ne_zero ((Submodule.mem_bot _).mp (h hf'))
  rw [Order.coheight_eq_iSup_gt_coheight]
  apply le_antisymm
  · refine iSup₂_le fun w hw ↦ ?_
    rw [Order.coheight_eq_zero.mpr (hmax w hw), zero_add]
  · exact le_iSup₂_of_le gen hvgen le_add_self

/-- The irreducible hypersurface `V(f) ⊆ ℙⁿ_k` cut out by an irreducible homogeneous polynomial
`f`, as a prime divisor of `ℙⁿ_k` (for `n ≥ 1`). -/
def projectiveHypersurfacePrimeDivisor (hn : 0 < n) {f : S} {d : ℕ}
    (hf : f.IsHomogeneous d) (hirr : Irreducible f) : (Proj 𝒜).PrimeDivisor :=
  ⟨projectiveHypersurfacePoint hn hf hirr, coheight_projectiveHypersurfacePoint hn hf hirr⟩

theorem projectiveHypersurfacePrimeDivisor_asHomogeneousIdeal (hn : 0 < n)
    {f : S} {d : ℕ} (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    (projectiveHypersurfacePrimeDivisor hn hf hirr).1.asHomogeneousIdeal.toIdeal =
      Ideal.span {f} :=
  rfl

/-- The closure of the generic point of `V(f)` is the zero locus of `f`. -/
theorem mem_closure_projectiveHypersurfacePrimeDivisor_iff (hn : 0 < n)
    {f : S} {d : ℕ} (hf : f.IsHomogeneous d) (hirr : Irreducible f)
    (p : Proj 𝒜) :
    p ∈ closure ({(projectiveHypersurfacePrimeDivisor hn hf hirr).1} : Set (Proj 𝒜)) ↔
      f ∈ p.asHomogeneousIdeal := by
  rw [← specializes_iff_mem_closure, projectiveSpace_specializes_iff]
  change Ideal.span {f} ≤ p.asHomogeneousIdeal.toIdeal ↔ _
  exact Ideal.span_singleton_le_iff_mem _

/-- A local equation of a prime divisor `V` of `ℙⁿ_k` on an open set `U`: a regular function on
`U` whose germ at every point of `U` generates the ideal of `V` in the local ring, that is, is
associated to `f / g` for a homogeneous equation `f` of `V` and a homogeneous `g` of the same
degree not vanishing at that point. -/
def IsProjectiveHypersurfaceLocalEquation (V : (Proj 𝒜).PrimeDivisor) (U : (Proj 𝒜).Opens)
    (h : Γ(Proj 𝒜, U)) : Prop :=
  ∀ (q : Proj 𝒜) (hqU : q ∈ U), ∃ (f g : S) (d : ℕ)
    (hf : f.IsHomogeneous d) (hg : g.IsHomogeneous d) (hqg : q ∈ Proj.basicOpen 𝒜 g),
    V.1.asHomogeneousIdeal.toIdeal = Ideal.span {f} ∧
      Associated ((Proj 𝒜).presheaf.germ U q hqU h)
        ((Proj 𝒜).presheaf.germ _ q hqg (hypersurfaceChartEquation f g hf hg))

/-- On `D₊(g)`, the function `f / g` is a local equation of `V`. -/
theorem isProjectiveHypersurfaceLocalEquation_chartEquation (V : (Proj 𝒜).PrimeDivisor)
    (g : S) (hg : g.IsHomogeneous (projectivePrimeDivisorEquationDegree V)) :
    IsProjectiveHypersurfaceLocalEquation V (Proj.basicOpen 𝒜 g)
      (hypersurfaceChartEquation (projectivePrimeDivisorEquation V) g
        (projectivePrimeDivisorEquation_isHomogeneous V) hg) :=
  fun _ hq ↦ ⟨_, g, _, projectivePrimeDivisorEquation_isHomogeneous V, hg, hq,
    span_projectivePrimeDivisorEquation V, Associated.refl _⟩

/-- Every point of `ℙⁿ_k` has a neighbourhood carrying a local equation of `V`. -/
theorem exists_projectiveHypersurfaceLocalEquation (V : (Proj 𝒜).PrimeDivisor) (p : Proj 𝒜) :
    ∃ (U : (Proj 𝒜).Opens) (h : Γ(Proj 𝒜, U)), p ∈ U ∧
      IsProjectiveHypersurfaceLocalEquation V U h := by
  obtain ⟨g, hg, hp⟩ := exists_projectiveSpace_chart p (projectivePrimeDivisorEquationDegree V)
  exact ⟨_, _, hp, isProjectiveHypersurfaceLocalEquation_chartEquation V g hg⟩

/-- Any two local equations of `V` near a point have associated germs there. -/
theorem IsProjectiveHypersurfaceLocalEquation.associated {V : (Proj 𝒜).PrimeDivisor}
    {U U' : (Proj 𝒜).Opens} {h : Γ(Proj 𝒜, U)} {h' : Γ(Proj 𝒜, U')}
    (hh : IsProjectiveHypersurfaceLocalEquation V U h)
    (hh' : IsProjectiveHypersurfaceLocalEquation V U' h') (q : Proj 𝒜) (hq : q ∈ U)
    (hq' : q ∈ U') :
    Associated ((Proj 𝒜).presheaf.germ U q hq h) ((Proj 𝒜).presheaf.germ U' q hq' h') := by
  obtain ⟨f, g, d, hf, hg, hqg, hfV, hA⟩ := hh q hq
  obtain ⟨f', g', d', hf', hg', hqg', hfV', hA'⟩ := hh' q hq'
  have hf0 : f ≠ 0 := by
    rintro rfl
    apply projectivePrimeDivisorEquation_ne_zero V
    have := span_projectivePrimeDivisorEquation V
    rw [hfV, Ideal.span_singleton_eq_bot.mpr rfl, eq_comm, Ideal.span_singleton_eq_bot] at this
    exact this
  exact hA.trans ((germ_chartEquation_associated hf hf' hg hg' hf0 (hfV.symm.trans hfV') q hqg
    hqg').trans hA'.symm)

/-- A coordinate not vanishing at a point of `ℙⁿ_k`. -/
private def projectiveChartIndex (p : Proj 𝒜) : Fin (n + 1) :=
  Classical.choose (exists_projectiveSpace_X_notMem p)

private theorem mem_basicOpen_projectiveChartIndex (p : Proj 𝒜) (d : ℕ) :
    p ∈ Proj.basicOpen 𝒜 (MvPolynomial.X (projectiveChartIndex p) ^ d) := by
  rw [Proj.mem_basicOpen]
  exact fun h ↦
    Classical.choose_spec (exists_projectiveSpace_X_notMem p) (p.isPrime.mem_of_pow_mem d h)

private theorem exists_notMem_primeDivisorEquation {X : Scheme.{u}} (ι : X ⟶ Proj 𝒜)
    (V : (Proj 𝒜).PrimeDivisor)
    (hXV : ¬Set.range ι ⊆ closure ({V.1} : Set (Proj 𝒜))) :
    ∃ z : X, projectivePrimeDivisorEquation V ∉ (ι z).asHomogeneousIdeal := by
  by_contra hall
  push Not at hall
  exact hXV fun _ ⟨z, hz⟩ ↦ hz ▸ (mem_closure_projectivePrimeDivisor_iff V (ι z)).mpr (hall z)

section divisor
variable {X : Scheme.{u}}

/-- The multiplicity of `V · X` at a point `x` of `X`, computed with the local equation
`f / x_i^d` of `V` on the standard chart `D₊(x_i)` containing the image of `x`. -/
private def projectiveIntersectionCoeff [IsIntegral X] [IsLocallyNoetherian X] (ι : X ⟶ Proj 𝒜)
    (V : (Proj 𝒜).PrimeDivisor) (x : X) : ℤ :=
  X.ord (algebraMap (X.presheaf.stalk x) X.functionField
    (X.presheaf.germ _ x
      (mem_basicOpen_projectiveChartIndex (ι x) (projectivePrimeDivisorEquationDegree V))
      (ι.app _ (hypersurfaceChartEquation (projectivePrimeDivisorEquation V)
        (MvPolynomial.X (projectiveChartIndex (ι x)) ^ projectivePrimeDivisorEquationDegree V)
        (projectivePrimeDivisorEquation_isHomogeneous V) (isHomogeneous_X_pow _ _))))) x

private theorem projectiveIntersectionCoeff_eq [IsIntegral X] [IsLocallyNoetherian X]
    (ι : X ⟶ Proj 𝒜)
    (V : (Proj 𝒜).PrimeDivisor) (hXV : ¬Set.range ι ⊆ closure ({V.1} : Set (Proj 𝒜)))
    (x : X) (U : (Proj 𝒜).Opens) (h : Γ(Proj 𝒜, U)) (hx : ι x ∈ U)
    (hh : IsProjectiveHypersurfaceLocalEquation V U h) :
    projectiveIntersectionCoeff ι V x = X.ord (algebraMap (X.presheaf.stalk x) X.functionField
      (X.presheaf.germ (ι ⁻¹ᵁ U) x hx (ι.app U h))) x := by
  symm
  apply ord_restrict_eq_of_associated'
  · exact (isProjectiveHypersurfaceLocalEquation_chartEquation V _
      (isHomogeneous_X_pow _ _)).associated
      hh _ _ _
  · exact stalkMap_germ_chartEquation_ne_zero ι _ _ (exists_notMem_primeDivisorEquation ι V hXV) x _

private theorem projectiveIntersectionCoeff_eq_zero_of_notMem [IsIntegral X] [IsLocallyNoetherian X]
    (ι : X ⟶ Proj 𝒜) (V : (Proj 𝒜).PrimeDivisor) (x : X)
    (hx : ι x ∉ closure ({V.1} : Set (Proj 𝒜))) :
    projectiveIntersectionCoeff ι V x = 0 := by
  rw [mem_closure_projectivePrimeDivisor_iff] at hx
  have := (ι x).isPrime
  apply ord_algebraMap_stalk_of_isUnit
  rw [← Scheme.Hom.germ_stalkMap_apply]
  refine IsUnit.map (ι.stalkMap x).hom ?_
  rw [germ_hypersurfaceChartEquation]
  exact (atPrime_mk_isUnit' (P := (ι x).asHomogeneousIdeal.toIdeal)
    (a := ⟨_, (mem_homogeneousSubmodule _ _).mpr (projectivePrimeDivisorEquation_isHomogeneous V)⟩)
    (b := ⟨_, (mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X_pow _ _)⟩)
    (mem_basicOpen_projectiveChartIndex (ι x) (projectivePrimeDivisorEquationDegree V)) hx).map _

private theorem projectiveIntersectionCoeff_support_finite (hX : X.SatisfiesConditionStar)
    [IsIntegral X]
    [IsLocallyNoetherian X] (ι : X ⟶ Proj 𝒜) (V : (Proj 𝒜).PrimeDivisor) :
    (Function.support (projectiveIntersectionCoeff ι V)).Finite := by
  classical
  set d := projectivePrimeDivisorEquationDegree V
  let D : Fin (n + 1) → (Proj 𝒜).Opens := fun i ↦ Proj.basicOpen 𝒜 (MvPolynomial.X i ^ d)
  let s : ∀ i, Γ(Proj 𝒜, D i) := fun i ↦
    hypersurfaceChartEquation (projectivePrimeDivisorEquation V) (MvPolynomial.X i ^ d)
      (projectivePrimeDivisorEquation_isHomogeneous V) (isHomogeneous_X_pow _ _)
  let T : Fin (n + 1) → Set X := fun i ↦ {x | ∃ hx : ι x ∈ D i,
    X.ord (algebraMap (X.presheaf.stalk x) X.functionField
      (X.presheaf.germ (ι ⁻¹ᵁ D i) x hx (ι.app (D i) (s i)))) x ≠ 0}
  have hsub : Function.support (projectiveIntersectionCoeff ι V) ⊆ ⋃ i, T i := by
    intro x hx
    exact Set.mem_iUnion.mpr
      ⟨projectiveChartIndex (ι x), mem_basicOpen_projectiveChartIndex (ι x) d, hx⟩
  refine (Set.finite_iUnion fun i ↦ ?_).subset hsub
  by_cases hne : ∃ x : X, ι x ∈ D i
  · obtain ⟨x₀, hx₀⟩ := hne
    have : Nonempty (ι ⁻¹ᵁ D i) := ⟨⟨x₀, hx₀⟩⟩
    let φ := X.germToFunctionField (ι ⁻¹ᵁ D i) (ι.app (D i) (s i))
    have hφS : T i ⊆ Function.support fun x ↦ X.ord φ x := by
      rintro x ⟨hx, hord⟩
      have heq := Scheme.algebraMap_germ_eq_germToFunctionField (X := X) (U := ι ⁻¹ᵁ D i)
        (x := x) hx (ι.app (D i) (s i))
      have hφeq : φ = _ := heq.symm
      change X.ord φ x ≠ 0
      rw [hφeq]
      exact hord
    by_cases hφ : φ = 0
    · refine Set.finite_empty.subset (hφS.trans ?_)
      intro x hx
      exact hx (by rw [hφ, Scheme.ord_zero]; rfl)
    · exact (X.finite_support_ord_of_satisfiesConditionStar hX hφ).subset hφS
  · refine Set.finite_empty.subset ?_
    rintro x ⟨hx, -⟩
    exact hne ⟨x, hx⟩

/-- **Hartshorne II, Exercise 6.2(a).** The Weil divisor `V · X` cut on `X` by a prime divisor
`V` of `ℙⁿ_k`: its coefficient along a prime divisor `Y` of `X` is `ord_Y (f|_X)` for a local
equation `f` of `V` near the image of the generic point of `Y`. -/
def projectiveIntersectionDivisor (ι : X ⟶ Proj 𝒜) (hX : X.SatisfiesConditionStar)
    (V : (Proj 𝒜).PrimeDivisor) : X.WeilDivisor := by
  let _ : IsIntegral X := hX.isIntegral
  let _ : IsNoetherian X := hX.isNoetherian
  refine ⟨{ toFun := projectiveIntersectionCoeff ι V
            supportWithinDomain' := Set.subset_univ _
            supportLocallyFiniteWithinDomain' := fun _ _ ↦
              ⟨Set.univ, Filter.univ_mem, by
                simpa using projectiveIntersectionCoeff_support_finite hX ι V⟩ }, ?_⟩
  intro x hx
  exact Scheme.ord_eq_zero_of_coheight_neq_one hx _

/-- **Hartshorne II, Exercise 6.2(a), independence of the local equations.** If `V` does not
contain `X`, then for every point `x` of `X` and every local equation `h` of `V` on an open set
`U` containing the image of `x`, the coefficient of `V · X` at `x` is the order of `h|_X`
at `x`. -/
theorem projectiveIntersectionDivisor_apply_eq_ord (ι : X ⟶ Proj 𝒜)
    (hX : X.SatisfiesConditionStar) (V : (Proj 𝒜).PrimeDivisor)
    (hXV : ¬Set.range ι ⊆ closure ({V.1} : Set (Proj 𝒜))) (x : X) (U : (Proj 𝒜).Opens)
    (h : Γ(Proj 𝒜, U)) (hx : ι x ∈ U) (hh : IsProjectiveHypersurfaceLocalEquation V U h) :
    let _ : IsIntegral X := hX.isIntegral
    let _ : IsNoetherian X := hX.isNoetherian
    (projectiveIntersectionDivisor ι hX V).1 x =
      X.ord (algebraMap (X.presheaf.stalk x) X.functionField
        (X.presheaf.germ (ι ⁻¹ᵁ U) x hx (ι.app U h))) x := by
  let _ : IsIntegral X := hX.isIntegral
  let _ : IsNoetherian X := hX.isNoetherian
  exact projectiveIntersectionCoeff_eq ι V hXV x U h hx hh

/-- The divisor `V · X` is supported on the prime divisors of `X` contained in `V`, that is, on
the codimension-one components of `V ∩ X`. -/
theorem projectiveIntersectionDivisor_apply_eq_zero_of_notMem (ι : X ⟶ Proj 𝒜)
    (hX : X.SatisfiesConditionStar) (V : (Proj 𝒜).PrimeDivisor) (x : X)
    (hx : ι x ∉ closure ({V.1} : Set (Proj 𝒜))) :
    (projectiveIntersectionDivisor ι hX V).1 x = 0 := by
  let _ : IsIntegral X := hX.isIntegral
  let _ : IsNoetherian X := hX.isNoetherian
  exact projectiveIntersectionCoeff_eq_zero_of_notMem ι V x hx

/-- The Weil divisors on `ℙⁿ_k` none of whose components contain `X`. -/
def ambientDivisorsNotContaining (ι : X ⟶ Proj 𝒜) : AddSubgroup (Proj 𝒜).WeilDivisor where
  carrier := {D | ∀ V : (Proj 𝒜).PrimeDivisor, D.1 V.1 ≠ 0 →
    ¬Set.range ι ⊆ closure ({V.1} : Set (Proj 𝒜))}
  zero_mem' V hV := (hV rfl).elim
  add_mem' {D E} hD hE V hV := by
    by_cases hDV : D.1 V.1 = 0
    · refine hE V fun hEV ↦ hV ?_
      change D.1 V.1 + E.1 V.1 = 0
      rw [hDV, hEV, add_zero]
    · exact hD V hDV
  neg_mem' {D} hD V hV := hD V fun hDV ↦ hV (by
    change -D.1 V.1 = 0
    rw [hDV, neg_zero])

/-- **Hartshorne II, Exercise 6.2(a), linear extension.** The homomorphism `D ↦ D · X` on Weil
divisors of `ℙⁿ_k` none of whose components contain `X`, extending `V ↦ V · X` linearly. -/
def projectiveIntersectionDivisorHom (ι : X ⟶ Proj 𝒜) (hX : X.SatisfiesConditionStar) :
    ambientDivisorsNotContaining ι →+ X.WeilDivisor where
  toFun D := ∑ᶠ V : (Proj 𝒜).PrimeDivisor,
    (D : (Proj 𝒜).WeilDivisor).1 V.1 • projectiveIntersectionDivisor ι hX V
  map_zero' := by simp
  map_add' D E := by
    have hD := (finite_support_primeDivisor_of_isClosedImmersion (𝟙 (Proj 𝒜))
      (D : (Proj 𝒜).WeilDivisor)).subset (Function.support_smul_subset_left
        (fun V : (Proj 𝒜).PrimeDivisor ↦ (D : (Proj 𝒜).WeilDivisor).1 V.1)
        (projectiveIntersectionDivisor ι hX))
    have hE := (finite_support_primeDivisor_of_isClosedImmersion (𝟙 (Proj 𝒜))
      (E : (Proj 𝒜).WeilDivisor)).subset (Function.support_smul_subset_left
        (fun V : (Proj 𝒜).PrimeDivisor ↦ (E : (Proj 𝒜).WeilDivisor).1 V.1)
        (projectiveIntersectionDivisor ι hX))
    simp only [AddSubgroup.coe_add, Function.locallyFinsuppWithin.coe_add, Pi.add_apply,
      add_smul]
    exact finsum_add_distrib hD hE

/-- The linear extension takes the value `V · X` on the divisor `1 · V`. -/
theorem projectiveIntersectionDivisorHom_of_primeDivisor (ι : X ⟶ Proj 𝒜)
    (hX : X.SatisfiesConditionStar) (V : (Proj 𝒜).PrimeDivisor)
    (D : ambientDivisorsNotContaining ι) (hDV : (D : (Proj 𝒜).WeilDivisor).1 V.1 = 1)
    (hD : ∀ y, y ≠ V.1 → (D : (Proj 𝒜).WeilDivisor).1 y = 0) :
    projectiveIntersectionDivisorHom ι hX D = projectiveIntersectionDivisor ι hX V := by
  change ∑ᶠ W : (Proj 𝒜).PrimeDivisor,
    (D : (Proj 𝒜).WeilDivisor).1 W.1 • projectiveIntersectionDivisor ι hX W = _
  rw [finsum_eq_single _ V]
  · rw [hDV, one_smul]
  · intro W hW
    rw [hD W.1 fun h ↦ hW (Subtype.ext h), zero_smul]

end divisor

end Hartshorne
