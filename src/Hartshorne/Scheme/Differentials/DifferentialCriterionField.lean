/-!
# The differential criterion for smoothness over a field

Let `T` be a finite type algebra over a field `K` and `q` a prime of `T`. If
`dim_{κ(q)} κ(q) ⊗_T Ω_{T/K} ≤ n ≤ dim T_q + dim T ⧸ q`, then `T` is smooth over `K` at `q`.

Present `T = R ⧸ I` with `R = K[x₁, …, x_N]` and let `Q` be the preimage of `q`.

1. `κ(q) ⊗_T Ω_{T/K}` is a quotient of `κ(q) ⊗_R Ω_{R/K}` (of dimension `N`) by the span of the
   differentials of elements of `I`, so there are `f₁, …, f_c ∈ I` with linearly independent
   differentials and `N ≤ c + n`.
2. `R_Q ⧸ (f)` is a regular local ring, hence a domain, of dimension `ht Q - c`; since
   `ht Q + dim R ⧸ Q = N` and `R ⧸ Q ≅ T ⧸ q`, this is at most `dim T_q`.
3. `T_q ≅ R_Q ⧸ I R_Q` is a quotient of the domain `R_Q ⧸ (f)` of at least the same dimension,
   so `I R_Q = (f)`.
4. The Jacobian criterion for local algebras: the kernel of `R_Q → T_q` is generated by the
   `fᵢ`, whose differentials are linearly independent in `κ(q) ⊗ Ω_{R_Q/K}`, so `T_q` is
   formally smooth over `K`.

This is the differential criterion used in the comparison of Hartshorne's definition of a smooth
morphism (III.10, p. 268) with the standard smooth predicate.

## Main results

* `Hartshorne.exists_linearIndependent_D_ker`
* `Hartshorne.isSmoothAt_of_finrank_le`
* `Hartshorne.smooth_of_forall_finrank_le`
-/

namespace Hartshorne

open IsLocalRing Ideal Module KaehlerDifferential TensorProduct

/-- Linear independence of the vectors `1 ⊗ vᵢ` descends along a homomorphism of fields
`F → L` compatible with the `R`-algebra structures. -/
theorem linearIndependent_one_tmul_of_ringHom {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] {F L : Type*} [Field F] [Field L] [Algebra R F] [Algebra R L] (φ : F →+* L)
    (hφ : ∀ r, φ (algebraMap R F r) = algebraMap R L r) {ι : Type*} (v : ι → M)
    (h : LinearIndependent L (fun i => (1 : L) ⊗ₜ[R] v i)) :
    LinearIndependent F (fun i => (1 : F) ⊗ₜ[R] v i) := by
  let φR : F →ₗ[R] L :=
    { toFun := φ
      map_add' := φ.map_add
      map_smul' := fun r x => by simp [Algebra.smul_def, hφ] }
  let Φ : F ⊗[R] M →ₗ[R] L ⊗[R] M := TensorProduct.map φR LinearMap.id
  have key : ∀ (c : F) (j : ι), Φ (c • ((1 : F) ⊗ₜ[R] v j)) = φ c • ((1 : L) ⊗ₜ[R] v j) := by
    intro c j
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, TensorProduct.map_tmul,
      TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rfl
  rw [linearIndependent_iff'] at h ⊢
  intro s c hs i hi
  have h1 := congrArg Φ hs
  simp only [map_sum, map_zero, key] at h1
  exact (map_eq_zero φ).mp (h s (fun j => φ (c j)) h1 i hi)


/-- A linear map sending a spanning family to a linearly independent family is injective. -/
theorem injective_of_span_eq_top_of_linearIndependent {F M N : Type*} [Field F] [AddCommGroup M]
    [Module F M] [AddCommGroup N] [Module F N] (f : M →ₗ[F] N) {ι : Type*} (v : ι → M)
    (hv : Submodule.span F (Set.range v) = ⊤) (hli : LinearIndependent F (f ∘ v)) :
    Function.Injective f := by
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro m hm
  have hmem : m ∈ Submodule.span F (Set.range v) := hv ▸ Submodule.mem_top
  obtain ⟨c, rfl⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).mp hmem
  rw [LinearMap.mem_ker, map_finsuppSum] at hm
  simp only [map_smul] at hm
  have hc : c = 0 := by
    rw [linearIndependent_iff] at hli
    apply hli
    rw [Finsupp.linearCombination_apply]
    exact hm
  simp [hc]

/-- In a Noetherian local domain `D`, an ideal `J` with `dim D ≤ dim D ⧸ J` is zero. -/
theorem eq_bot_of_ringKrullDim_le_quotient {D : Type*} [CommRing D] [IsDomain D] [IsLocalRing D]
    [IsNoetherianRing D] (J : Ideal D) (h : ringKrullDim D ≤ ringKrullDim (D ⧸ J)) : J = ⊥ := by
  by_contra hJ
  obtain ⟨x, hxJ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  have hfin : ringKrullDim D ≠ ⊤ := ringKrullDim_lt_top.ne
  have hnonneg : (0 : WithBot ℕ∞) ≤ ringKrullDim D := ringKrullDim_nonneg_of_nontrivial
  by_cases hxm : x ∈ maximalIdeal D
  · have hsucc := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero hx0) hxm
    have hle : ringKrullDim (D ⧸ J) ≤ ringKrullDim (D ⧸ span {x}) :=
      ringKrullDim_le_of_surjective (Ideal.Quotient.factor (by
        rw [span_le, Set.singleton_subset_iff]; exact hxJ))
        (Ideal.Quotient.factor_surjective _)
    have key : ringKrullDim (D ⧸ span {x}) + 1 ≤ ringKrullDim (D ⧸ span {x}) := by
      rw [hsucc]; exact h.trans hle
    generalize ringKrullDim (D ⧸ span {x}) = a at key hsucc
    induction a using WithBot.recBotCoe with
    | bot => rw [← hsucc] at hnonneg; simp at hnonneg
    | coe a =>
      induction a using ENat.recTopCoe with
      | top =>
        rw [← hsucc] at hfin
        exact hfin rfl
      | coe a =>
        norm_cast at key
        omega
  · have hunit : IsUnit x := by
      by_contra hu
      exact hxm ((IsLocalRing.mem_maximalIdeal x).mpr hu)
    have htop : J = ⊤ := Ideal.eq_top_of_isUnit_mem J hxJ hunit
    subst htop
    have : Subsingleton (D ⧸ (⊤ : Ideal D)) := Ideal.Quotient.subsingleton_iff.mpr rfl
    have : ringKrullDim (D ⧸ (⊤ : Ideal D)) = ⊥ := ringKrullDim_eq_bot_of_subsingleton
    rw [this] at h
    exact absurd (hnonneg.trans h) (by simp)


/-- A surjection from a Noetherian local domain onto a ring of at least the same dimension is
injective. -/
theorem injective_of_ringKrullDim_le {D E : Type*} [CommRing D] [IsDomain D] [IsLocalRing D]
    [IsNoetherianRing D] [CommRing E] (φ : D →+* E) (hφ : Function.Surjective φ)
    (h : ringKrullDim D ≤ ringKrullDim E) : Function.Injective φ := by
  rw [injective_iff_map_eq_zero]
  have hker := eq_bot_of_ringKrullDim_le_quotient (RingHom.ker φ)
    (h.trans (ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hφ)).ge)
  intro x hx
  have : x ∈ RingHom.ker φ := hx
  rw [hker, Ideal.mem_bot] at this
  exact this

section Quotient

variable {K R T : Type*} [Field K] [CommRing R] [CommRing T] [Algebra K R] [Algebra K T]
  [Algebra R T] [IsScalarTower K R T] (q : Ideal T) [q.IsPrime]

/-- For `T` a quotient of `R` and `L` the residue field of a prime of `T`, there is a surjection
`L ⊗_T Ω_{T/K} → (L ⊗_R Ω_{R/K}) ⧸ W`, where `W` is spanned by the differentials of the kernel
of `R → T`; it is induced by the derivation `t ↦ [1 ⊗ d(lift of t)]`. -/
theorem exists_surjective_fibre_kaehler_quotient (hπ : Function.Surjective (algebraMap R T)) :
    ∃ Ψ : q.ResidueField ⊗[T] Ω[T⁄K] →ₗ[q.ResidueField]
        (q.ResidueField ⊗[R] Ω[R⁄K]) ⧸ Submodule.span q.ResidueField
          ((fun x : R => (1 : q.ResidueField) ⊗ₜ[R] D K R x) ''
            (RingHom.ker (algebraMap R T) : Set R)),
      Function.Surjective Ψ := by
  classical
  set L := q.ResidueField
  set I := RingHom.ker (algebraMap R T)
  set V := L ⊗[R] Ω[R⁄K]
  set W : Submodule L V := Submodule.span L ((fun x : R => (1 : L) ⊗ₜ[R] D K R x) '' (I : Set R))
  set σ := Function.surjInv hπ
  have hσ : ∀ t, algebraMap R T (σ t) = t := Function.surjInv_eq hπ
  have hW : ∀ x : R, x ∈ I → ((1 : L) ⊗ₜ[R] D K R x : V) ∈ W :=
    fun x hx => Submodule.subset_span ⟨x, hx, rfl⟩
  let d0 : T → V ⧸ W := fun t => Submodule.Quotient.mk ((1 : L) ⊗ₜ[R] D K R (σ t))
  have hd0 : ∀ x : R, d0 (algebraMap R T x) =
      Submodule.Quotient.mk ((1 : L) ⊗ₜ[R] D K R x) := by
    intro x
    simp only [d0]
    rw [Submodule.Quotient.eq, ← TensorProduct.tmul_sub, ← map_sub]
    apply hW
    simp [I, RingHom.mem_ker, hσ]
  have hRT : ∀ (x : R) (v : V ⧸ W), algebraMap R T x • v = x • v :=
    fun x v => IsScalarTower.algebraMap_smul T x v
  let d : Derivation K T (V ⧸ W) :=
    { toFun := d0
      map_add' := fun a b => by
        obtain ⟨a, rfl⟩ := hπ a
        obtain ⟨b, rfl⟩ := hπ b
        rw [← map_add, hd0, hd0, hd0, map_add, TensorProduct.tmul_add, Submodule.Quotient.mk_add]
      map_smul' := fun c a => by
        obtain ⟨a, rfl⟩ := hπ a
        have : c • algebraMap R T a = algebraMap R T (c • a) := by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply]
        rw [RingHom.id_apply, this, hd0, hd0, (D K R).map_smul, ← Submodule.Quotient.mk_smul]
        congr 1
        rw [← algebraMap_smul R c (D K R a), TensorProduct.tmul_smul, algebraMap_smul]
      map_one_eq_zero' := by
        change d0 1 = 0
        rw [← map_one (algebraMap R T), hd0, Derivation.map_one_eq_zero, TensorProduct.tmul_zero,
          Submodule.Quotient.mk_zero]
      leibniz' := fun a b => by
        obtain ⟨a, rfl⟩ := hπ a
        obtain ⟨b, rfl⟩ := hπ b
        change d0 _ = _ • d0 _ + _ • d0 _
        rw [← map_mul, hd0, hd0, hd0, Derivation.leibniz, TensorProduct.tmul_add,
          TensorProduct.tmul_smul, TensorProduct.tmul_smul, Submodule.Quotient.mk_add,
          Submodule.Quotient.mk_smul, Submodule.Quotient.mk_smul, hRT, hRT] }
  have hd : ∀ x : R, d (algebraMap R T x) = Submodule.Quotient.mk ((1 : L) ⊗ₜ[R] D K R x) := hd0
  refine ⟨d.liftKaehlerDifferential.liftBaseChange L, ?_⟩
  rw [← LinearMap.range_eq_top, eq_top_iff]
  rintro v -
  obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective W v
  set Rg := LinearMap.range (d.liftKaehlerDifferential.liftBaseChange L)
  have hbasic : ∀ ω : Ω[R⁄K], Submodule.Quotient.mk ((1 : L) ⊗ₜ[R] ω) ∈ Rg := by
    intro ω
    have hω : ω ∈ Submodule.span R (Set.range (D K R)) := by
      rw [span_range_derivation]; trivial
    induction hω using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨x, rfl⟩ := hx
      refine ⟨(1 : L) ⊗ₜ[T] D K T (algebraMap R T x), ?_⟩
      rw [LinearMap.liftBaseChange_tmul, one_smul, Derivation.liftKaehlerDifferential_comp_D, hd]
    | zero => simp
    | add x y _ _ hx hy =>
      rw [TensorProduct.tmul_add, Submodule.Quotient.mk_add]
      exact Rg.add_mem hx hy
    | smul r x _ hx =>
      rw [TensorProduct.tmul_smul, Submodule.Quotient.mk_smul, ← algebraMap_smul L r]
      exact Rg.smul_mem _ hx
  induction v using TensorProduct.induction_on with
  | zero => simp
  | tmul l ω =>
    have : (l ⊗ₜ[R] ω : V) = l • ((1 : L) ⊗ₜ[R] ω) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [this, Submodule.Quotient.mk_smul]
    exact Rg.smul_mem _ (hbasic ω)
  | add x y hx hy =>
    rw [Submodule.Quotient.mk_add]
    exact Rg.add_mem hx hy

set_option backward.isDefEq.respectTransparency false in
/-- For `T` a quotient of `R` and `L` the residue field of a prime of `T`, there are elements
`f₁, …, f_c` of the kernel of `R → T` whose differentials are linearly independent in
`L ⊗_R Ω_{R/K}`, with `dim (L ⊗_R Ω_{R/K}) ≤ c + dim (L ⊗_T Ω_{T/K})`. -/
theorem exists_linearIndependent_D_ker (hπ : Function.Surjective (algebraMap R T))
    [Module.Finite R Ω[R⁄K]] [Module.Finite T Ω[T⁄K]] :
    ∃ (ι : Type (max u_2 u_3)) (_ : Fintype ι) (f : ι → R),
      (∀ i, f i ∈ RingHom.ker (algebraMap R T)) ∧
      LinearIndependent q.ResidueField
        (fun i => (1 : q.ResidueField) ⊗ₜ[R] D K R (f i)) ∧
      finrank q.ResidueField (q.ResidueField ⊗[R] Ω[R⁄K]) ≤
        Fintype.card ι + finrank q.ResidueField (q.ResidueField ⊗[T] Ω[T⁄K]) := by
  classical
  set L := q.ResidueField
  set I := RingHom.ker (algebraMap R T)
  set V := L ⊗[R] Ω[R⁄K]
  set S0 : Set V := (fun x : R => (1 : L) ⊗ₜ[R] D K R x) '' (I : Set R)
  obtain ⟨Ψ, hΨ⟩ := exists_surjective_fibre_kaehler_quotient (K := K) q hπ
  obtain ⟨b, hbS, hbspan, hbli⟩ := exists_linearIndependent L S0
  have : Finite b := hbli.finite
  have := Fintype.ofFinite b
  choose g hgI hgv using fun v : b => hbS v.2
  refine ⟨b, inferInstance, g, hgI, ?_, ?_⟩
  · have hfun : (fun v : b => (1 : L) ⊗ₜ[R] D K R (g v)) = Subtype.val := funext hgv
    rw [hfun]
    exact hbli
  · have h1 := Submodule.finrank_quotient_add_finrank (Submodule.span L S0)
    have h2 : finrank L (Submodule.span L S0) = Fintype.card b := by
      rw [← hbspan, ← finrank_span_eq_card hbli, Subtype.range_coe]
    have h3 := LinearMap.finrank_range_le Ψ
    rw [LinearMap.range_eq_top.mpr hΨ, finrank_top] at h3
    change finrank L (V ⧸ Submodule.span L S0) ≤ finrank L (L ⊗[T] Ω[T⁄K]) at h3
    change finrank L V ≤ Fintype.card b + finrank L (L ⊗[T] Ω[T⁄K])
    omega

end Quotient

/-- For an algebra `F` over `P_Q`, the comparison `F ⊗_{P_Q} Ω_{P_Q/k} → F ⊗_P Ω_{P/k}`, sending
`1 ⊗ d(r/1)` to `1 ⊗ d r`. -/
theorem exists_localization_tensor_kaehler_toTensor {k P : Type*} [CommRing k] [CommRing P]
    [Algebra k P] (Q : Ideal P) [Q.IsPrime] (F : Type*) [CommRing F] [Algebra P F]
    [Algebra (Localization.AtPrime Q) F] [IsScalarTower P (Localization.AtPrime Q) F] :
    ∃ χ : F ⊗[Localization.AtPrime Q] Ω[Localization.AtPrime Q⁄k] →ₗ[F] F ⊗[P] Ω[P⁄k],
      ∀ r : P, χ ((1 : F) ⊗ₜ D k _ (algebraMap P (Localization.AtPrime Q) r)) =
        (1 : F) ⊗ₜ D k P r := by
  let B := Localization.AtPrime Q
  have : Algebra.FormallyEtale P B := .of_isLocalization Q.primeCompl
  let e := tensorKaehlerEquivOfFormallyEtale k P B
  refine ⟨(AlgebraTensorModule.cancelBaseChange P B F F Ω[P⁄k]).toLinearMap ∘ₗ
    (e.symm.toLinearMap.baseChange F), fun r => ?_⟩
  change AlgebraTensorModule.cancelBaseChange P B F F Ω[P⁄k]
    ((1 : F) ⊗ₜ e.symm (D k B (algebraMap P B r))) = _
  rw [tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap,
    AlgebraTensorModule.cancelBaseChange_tmul, one_smul]

universe u

set_option backward.isDefEq.respectTransparency false in
/-- **Differential criterion for smoothness over a field.** Let `T` be a finite type algebra
over a field `K` and `q` a prime of `T`. If `dim_{κ(q)} κ(q) ⊗ Ω_{T/K} ≤ n ≤ dim T_q + dim T ⧸ q`,
then `T` is smooth over `K` at `q`. -/
theorem isSmoothAt_of_finrank_le {K T : Type u} [Field K] [CommRing T] [Algebra K T]
    [Algebra.FiniteType K T] (q : Ideal T) [q.IsPrime] (n : ℕ)
    (hΩ : finrank q.ResidueField (q.ResidueField ⊗[T] Ω[T⁄K]) ≤ n)
    (hdim : (n : WithBot ℕ∞) ≤ ringKrullDim (Localization.AtPrime q) + ringKrullDim (T ⧸ q)) :
    Algebra.IsSmoothAt K q := by
  classical
  obtain ⟨N, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  let R := MvPolynomial (Fin N) K
  let : Algebra R T := f.toRingHom.toAlgebra
  have : IsScalarTower K R T := IsScalarTower.of_algebraMap_eq' f.comp_algebraMap.symm
  have hπ : Function.Surjective (algebraMap R T) := hf
  set L := q.ResidueField
  set I := RingHom.ker (algebraMap R T)
  set Q := q.comap (algebraMap R T)
  -- Step 1: elements of `I` with independent differentials.
  obtain ⟨ι, _, g, hgI, hgli, hcard⟩ := exists_linearIndependent_D_ker (K := K) q hπ
  have hN : finrank L (L ⊗[R] Ω[R⁄K]) = N := by
    rw [Module.finrank_baseChange, Module.finrank_eq_card_basis (mvPolynomialBasis K (Fin N)),
      Fintype.card_fin]
  have hgQ : ∀ i, g i ∈ Q := fun i => by
    change algebraMap R T (g i) ∈ q
    rw [RingHom.mem_ker.mp (hgI i)]
    exact q.zero_mem
  have hliQ : LinearIndependent Q.ResidueField
      (fun i => (1 : Q.ResidueField) ⊗ₜ[R] D K R (g i)) :=
    linearIndependent_one_tmul_of_ringHom (Ideal.ResidueField.map Q q (algebraMap R T) rfl)
      (Ideal.ResidueField.map_algebraMap Q q (algebraMap R T) rfl) _ hgli
  -- Step 2: the regular quotient `D = R_Q ⧸ (g)`.
  let RQ := Localization.AtPrime Q
  let G : Ideal RQ := span (Set.range fun i => algebraMap R RQ (g i))
  have hreg : IsRegularLocalRing (RQ ⧸ G) :=
    isRegularLocalRing_localization_quotient_of_linearIndependent_D Q g hgQ hliQ
  have hdimD : ringKrullDim (RQ ⧸ G) + Fintype.card ι = Q.height :=
    ringKrullDim_localization_quotient_add_card_of_linearIndependent_D Q g hgQ hliQ
  -- Step 3: heights and dimensions.
  have hRdim : ringKrullDim R = N := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
      Nat.card_eq_fintype_card, Fintype.card_fin]
  have hQfin : Q.height ≠ ⊤ := by
    intro htop
    have := Ideal.height_le_ringKrullDim_of_ne_top (IsPrime.ne_top (inferInstance : Q.IsPrime))
    rw [htop, hRdim] at this
    exact absurd (top_le_iff.mp this).symm
      (fun h => ENat.natCast_ne_top _ (WithBot.coe_injective h).symm)
  obtain ⟨h, hh⟩ := ENat.ne_top_iff_exists.mp hQfin
  have hformula := height_add_ringKrullDim_quotient_eq K R Q h hh.symm
  rw [hRdim] at hformula
  have hquot : ringKrullDim (T ⧸ q) = ringKrullDim (R ⧸ Q) := by
    have hker : RingHom.ker ((Ideal.Quotient.mk q).comp (algebraMap R T)) = Q := by
      ext x
      simp only [RingHom.mem_ker, RingHom.coe_comp, Function.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem, Q, Ideal.mem_comap]
    exact ringKrullDim_eq_of_ringEquiv
      ((Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective
        (Ideal.Quotient.mk_surjective.comp hπ))).symm
  rw [← hh] at hdimD
  obtain ⟨-, hD⟩ := withBot_eq_sub_of_add_eq hdimD
  rw [add_comm] at hformula
  obtain ⟨hhN, hRQ⟩ := withBot_eq_sub_of_add_eq hformula
  -- Step 4: `T_q ≅ R_Q ⧸ I R_Q`.
  let J : Ideal RQ := I.map (algebraMap R RQ)
  have hGJ : G ≤ J := span_le.mpr (by
    rintro _ ⟨i, rfl⟩
    exact mem_map_of_mem _ (hgI i))
  let e : R ⧸ I ≃+* T := RingHom.quotientKerEquivOfSurjective hπ
  have H : (Algebra.algebraMapSubmonoid (R ⧸ I) Q.primeCompl).map e.toMonoidHom =
      q.primeCompl := by
    ext x
    constructor
    · rintro ⟨_, ⟨y, hy, rfl⟩, rfl⟩
      exact hy
    · intro hx
      obtain ⟨y, rfl⟩ := hπ x
      exact ⟨Ideal.Quotient.mk I y, ⟨y, hx, rfl⟩, rfl⟩
  let e' := IsLocalization.ringEquivOfRingEquiv (RQ ⧸ J) (Localization.AtPrime q) e H
  have hdimTq : ringKrullDim (RQ ⧸ J) = ringKrullDim (Localization.AtPrime q) :=
    ringKrullDim_eq_of_ringEquiv e'
  -- Step 5: `I R_Q = (g)`.
  have hNle : N ≤ Fintype.card ι + n := by
    rw [← hN]
    exact hcard.trans (by omega)
  have hle : ringKrullDim (RQ ⧸ G) ≤ ringKrullDim (RQ ⧸ J) := by
    rw [hdimTq, hD]
    rw [hquot, hRQ] at hdim
    generalize ringKrullDim (Localization.AtPrime q) = x at hdim ⊢
    induction x using WithBot.recBotCoe with
    | bot => simp at hdim
    | coe x =>
      induction x using ENat.recTopCoe with
      | top => exact le_top
      | coe m =>
        obtain ⟨r, hr⟩ : ∃ r, r = N - h := ⟨_, rfl⟩
        obtain ⟨t, ht⟩ : ∃ t, t = h - Fintype.card ι := ⟨_, rfl⟩
        rw [← hr] at hdim
        rw [← ht]
        have hdim' : n ≤ m + r := by exact_mod_cast hdim
        have : t ≤ m := by omega
        exact_mod_cast this
  have := Hartshorne.RegularLocal.isDomain (RQ ⧸ G)
  have hinjG := injective_of_ringKrullDim_le (D := RQ ⧸ G) (E := RQ ⧸ J)
    (Ideal.Quotient.factor hGJ)
    (Ideal.Quotient.factor_surjective hGJ) hle
  have hJG : J ≤ G := by
    intro x hx
    have h0 : Ideal.Quotient.factor hGJ (Ideal.Quotient.mk G x) = 0 := by
      rw [Ideal.Quotient.factor_mk]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
    exact Ideal.Quotient.eq_zero_iff_mem.mp ((map_eq_zero_iff _ hinjG).mp h0)
  -- Step 6: `T_q` as a quotient of `R_Q`, with kernel `J ≤ (g)`.
  let Tq := Localization.AtPrime q
  let φ : RQ →+* Tq := Localization.localRingHom Q q (algebraMap R T) rfl
  have hφe : φ = e'.toRingHom.comp (Ideal.Quotient.mk J) := by
    apply IsLocalization.ringHom_ext Q.primeCompl
    refine RingHom.ext fun r => ?_
    simp only [RingHom.comp_apply, φ]
    change _ = e' (algebraMap (R ⧸ I) (RQ ⧸ J) (Ideal.Quotient.mk I r))
    rw [IsLocalization.ringEquivOfRingEquiv_apply, IsLocalization.map_eq,
      Localization.localRingHom_to_map]
    rfl
  have hφsurj : Function.Surjective φ := by
    rw [hφe]
    exact e'.surjective.comp Ideal.Quotient.mk_surjective
  have hφker : ∀ x, φ x = 0 ↔ x ∈ J := by
    intro x
    rw [hφe, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      map_eq_zero_iff _ e'.injective, Ideal.Quotient.eq_zero_iff_mem]
  let : Algebra RQ Tq := φ.toAlgebra
  have : IsScalarTower K RQ Tq := IsScalarTower.of_algebraMap_eq (fun c => by
    change algebraMap K Tq c =
      Localization.localRingHom Q q (algebraMap R T) rfl (algebraMap K RQ c)
    rw [IsScalarTower.algebraMap_apply K R RQ, Localization.localRingHom_to_map,
      ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply])
  let F := q.ResidueField
  have : Algebra.FormallyEtale R RQ := .of_isLocalization Q.primeCompl
  have : Algebra.FormallySmooth K RQ := .comp K R RQ
  let eΩ := tensorKaehlerEquivOfFormallyEtale K R RQ
  have : Module.Free RQ Ω[RQ⁄K] := .of_equiv eΩ
  have : Module.Finite RQ Ω[RQ⁄K] := .equiv eΩ
  have : IsScalarTower R RQ F := IsScalarTower.of_algebraMap_eq (fun r => by
    rw [IsScalarTower.algebraMap_apply RQ Tq F, IsScalarTower.algebraMap_apply R T F,
      IsScalarTower.algebraMap_apply T Tq F]
    congr 1
    change _ = Localization.localRingHom Q q (algebraMap R T) rfl (algebraMap R RQ r)
    rw [Localization.localRingHom_to_map])
  have hker : ∀ x ∈ G, x ∈ RingHom.ker (algebraMap RQ Tq) := fun x hx => by
    rw [RingHom.mem_ker]
    exact (hφker x).mpr (hGJ hx)
  have hsmooth : Algebra.FormallySmooth K Tq := by
    rw [Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange RQ F hφsurj
      (IsNoetherian.noetherian _) (IsLocalRing.ker_residue (R := Tq)).ge]
    obtain ⟨χ, hχ⟩ := exists_localization_tensor_kaehler_toTensor (k := K) Q F
    let v : ι → F ⊗[RQ] RingHom.ker (algebraMap RQ Tq) := fun i =>
      (1 : F) ⊗ₜ ⟨_, hker _ (subset_span ⟨i, rfl⟩)⟩
    apply injective_of_span_eq_top_of_linearIndependent _ v
    · rw [eq_top_iff]
      rintro z -
      induction z using TensorProduct.induction_on with
      | zero => exact zero_mem _
      | tmul a m =>
        have hz : (a ⊗ₜ[RQ] m : F ⊗[RQ] _) = a • ((1 : F) ⊗ₜ m) := by
          rw [smul_tmul', smul_eq_mul, mul_one]
        rw [hz]
        apply Submodule.smul_mem
        obtain ⟨m, hm⟩ := m
        have hmG : m ∈ G := hJG ((hφker m).mp hm)
        suffices H : ∀ x (hx : x ∈ G), (1 : F) ⊗ₜ[RQ]
            (⟨x, hker x hx⟩ : RingHom.ker (algebraMap RQ Tq)) ∈
              Submodule.span F (Set.range v) from H m hmG
        intro x hx
        induction hx using Submodule.span_induction with
        | mem x hx' =>
          obtain ⟨i, rfl⟩ := hx'
          exact Submodule.subset_span ⟨i, rfl⟩
        | zero =>
          have h0 : (⟨0, hker 0 (zero_mem _)⟩ : RingHom.ker (algebraMap RQ Tq)) = 0 := rfl
          rw [h0, tmul_zero]
          exact zero_mem _
        | add x y hx hy ihx ihy =>
          have hxy : (⟨x + y, hker _ (add_mem hx hy)⟩ : RingHom.ker (algebraMap RQ Tq)) =
              ⟨x, hker x hx⟩ + ⟨y, hker y hy⟩ := rfl
          rw [hxy, tmul_add]
          exact add_mem ihx ihy
        | smul r x hx ih =>
          have hrx : (⟨r • x, hker _ (Submodule.smul_mem _ r hx)⟩ :
              RingHom.ker (algebraMap RQ Tq)) = r • ⟨x, hker x hx⟩ := rfl
          rw [hrx, tmul_smul, ← algebraMap_smul F r]
          exact Submodule.smul_mem _ _ ih
      | add x y hx hy => exact add_mem hx hy
    · apply LinearIndependent.of_comp χ
      have hfun : ∀ i, χ (cotangentComplexBaseChange K Tq RQ F (v i)) =
          (1 : F) ⊗ₜ[R] D K R (g i) := by
        intro i
        simp only [v]
        rw [cotangentComplexBaseChange_tmul, one_smul, kerToTensor_apply]
        exact hχ (g i)
      have hcomp : (⇑χ ∘ (⇑(cotangentComplexBaseChange K Tq RQ F) ∘ v)) =
          fun i => (1 : F) ⊗ₜ[R] D K R (g i) := funext hfun
      rw [hcomp]
      exact hgli
  exact hsmooth


/-- **Differential criterion for smoothness over a field**, global form. A finite type algebra
`T` over a field `K` such that `dim_{κ(q)} κ(q) ⊗ Ω_{T/K} ≤ dim T_q + dim T ⧸ q` at every prime
`q` (the integer `n` of the pointwise criterion may depend on `q`) is smooth over `K`. -/
theorem smooth_of_forall_finrank_le_ringKrullDim {K T : Type u} [Field K] [CommRing T]
    [Algebra K T] [Algebra.FiniteType K T]
    (h : ∀ (q : Ideal T) [q.IsPrime],
      (finrank q.ResidueField (q.ResidueField ⊗[T] Ω[T⁄K]) : WithBot ℕ∞) ≤
        ringKrullDim (Localization.AtPrime q) + ringKrullDim (T ⧸ q)) :
    Algebra.Smooth K T := by
  have : Algebra.FinitePresentation K T := Algebra.FinitePresentation.of_finiteType.mp ‹_›
  refine ⟨Algebra.smoothLocus_eq_univ_iff.mp (Set.eq_univ_iff_forall.mpr fun q => ?_), ‹_›⟩
  exact isSmoothAt_of_finrank_le q.asIdeal _ le_rfl (h q.asIdeal)

/-- **Differential criterion for smoothness over a field**, global form with one integer `n` for
every prime: a finite type algebra `T` over a field `K` such that
`dim_{κ(q)} κ(q) ⊗ Ω_{T/K} ≤ n ≤ dim T_q + dim T ⧸ q` for every prime `q` is smooth over `K`.
A special case of `Hartshorne.smooth_of_forall_finrank_le_ringKrullDim`. -/
theorem smooth_of_forall_finrank_le {K T : Type u} [Field K] [CommRing T] [Algebra K T]
    [Algebra.FiniteType K T] (n : ℕ)
    (h : ∀ (q : Ideal T) [q.IsPrime],
      finrank q.ResidueField (q.ResidueField ⊗[T] Ω[T⁄K]) ≤ n ∧
        (n : WithBot ℕ∞) ≤ ringKrullDim (Localization.AtPrime q) + ringKrullDim (T ⧸ q)) :
    Algebra.Smooth K T :=
  smooth_of_forall_finrank_le_ringKrullDim fun q _ =>
    le_trans (by exact_mod_cast (h q).1) (h q).2

end Hartshorne
