import Hartshorne.Scheme.Differentials.AdjunctionDeterminantNormalBundle
import Hartshorne.Scheme.Differentials.TangentNormalExactSequence
import Hartshorne.Scheme.EffectiveCartierIdealSheaf
import Hartshorne.Scheme.RankTwoDualDeterminant

/-!
# Adjunction for an effective Cartier divisor

Hartshorne, *Algebraic Geometry*, II, second part of Proposition 8.20 (p. 182): if `Y` is a
nonsingular effective Cartier divisor in a nonsingular variety `X` over `k`, and `L = 𝒪_X(Y)` is
its associated invertible sheaf, then `ω_Y ≅ (ω_X ⊗ L)|_Y`.

## Proof

Following the book, apply the first part of Proposition 8.20
(`Hartshorne.adjunctionDeterminantNormalSheafIso`) with `r = 1`:

* `Y` has codimension one in `X`: at the generic point `η` of `Y`, the ideal of `Y` is generated
  by one non-zero-divisor `g` of an affine coordinate ring, and the prime of `η` is minimal over
  `(g)`; by Krull's principal ideal theorem it has height one
  (`AlgebraicGeometry.Scheme.CartierDivisor.codim_range_subschemeι`);
* `⋀^1 N_{Y/X} ≅ N_{Y/X}`;
* the ideal sheaf of `Y` is `𝒪_X(-Y) = L^{-1}` (Proposition 6.18), so the conormal sheaf is
  `J/J² ≅ L^{-1}|_Y`, and the normal sheaf is `N_{Y/X} = (L^{-1}|_Y)^∨ ≅ (L^{-1})^∨|_Y ≅ L|_Y`,
  using that pullback commutes with duals of locally free sheaves and `𝒪_X(-D) ≅ 𝒪_X(D)^∨`
  (Proposition 6.13(b));
* `ω_X|_Y ⊗ L|_Y ≅ (ω_X ⊗ L)|_Y`, as pullback commutes with tensor products of invertible
  sheaves.
-/

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry

namespace AlgebraicGeometry.Scheme.CartierDivisor

open Hartshorne

variable {X : Scheme.{u}} [IsLocallyNoetherian X] {D : X.CartierDivisor} (hD : D.IsEffective)

/-- On a locally Noetherian scheme, an irreducible effective Cartier divisor has codimension one:
the prime of its generic point is minimal over the principal ideal generated by a local equation,
which is a non-zero-divisor, so it has height one by Krull's principal ideal theorem. -/
theorem codim_range_subschemeι [IrreducibleSpace (idealSheafData hD).subscheme] :
    codim (Set.range (subschemeι hD).base) = 1 := by
  set I := idealSheafData hD
  set i := subschemeι hD
  set x := i.base (genericPoint I.subscheme)
  -- the range of `i` is the closure of `x`
  have hgen : ∀ z ∈ Set.range i.base, x ⤳ z := by
    rintro _ ⟨y, rfl⟩
    exact ((genericPoint_spec I.subscheme).specializes (Set.mem_univ y)).map i.continuous
  have hrange : Set.range i.base = closure {x} := by
    refine Set.Subset.antisymm (fun z hz => specializes_iff_mem_closure.mp (hgen z hz)) ?_
    exact closure_minimal (Set.singleton_subset_iff.mpr (Set.mem_range_self _))
      i.isClosedEmbedding.isClosed_range
  have hsupp : ∀ z, z ∈ Set.range i.base ↔ z ∈ I.support := fun z => by
    rw [show Set.range i.base = I.support from I.range_subschemeι]
    rfl
  rw [hrange, codim_closure_singleton_eq_coheight]
  -- an affine neighbourhood `W` of `x` on which the ideal is generated by a non-zero-divisor `g`
  obtain ⟨W, hxW, g, hg, hIW⟩ := isLocallyPrincipalNonZeroDivisor_idealSheafData hD x
  have hW : IsAffineOpen (W : X.Opens) := W.2
  have : IsNoetherianRing Γ(X, W) := IsLocallyNoetherian.component_noetherian W
  set P := hW.primeIdealOf ⟨x, hxW⟩
  have hPx : hW.fromSpec P = x := hW.fromSpec_primeIdealOf ⟨x, hxW⟩
  -- a point of `Spec Γ(X, W)` lies on `Y` exactly when its prime contains `g`
  have hmemY : ∀ Q : PrimeSpectrum Γ(X, W),
      hW.fromSpec Q ∈ Set.range i.base ↔ g ∈ Q.asIdeal := fun Q => by
    have hQW : hW.fromSpec Q ∈ (W : X.Opens) := hW.range_fromSpec.subset ⟨Q, rfl⟩
    rw [hsupp, I.mem_support_iff_of_mem (U := W) hQW]
    change Q ∈ hW.fromSpec ⁻¹' X.zeroLocus (I.ideal W : Set Γ(X, W)) ↔ _
    rw [hW.fromSpec_preimage_zeroLocus]
    change (I.ideal W : Set Γ(X, W)) ⊆ Q.asIdeal ↔ _
    rw [hIW, SetLike.coe_subset_coe, Ideal.span_singleton_le_iff_mem]
  have hgP : g ∈ P.asIdeal := (hmemY P).1 (hPx ▸ Set.mem_range_self _)
  -- `P` is minimal over `(g)`
  have hmin : P.asIdeal ∈ (Ideal.span {g}).minimalPrimes := by
    refine ⟨⟨P.isPrime, (Ideal.span_singleton_le_iff_mem _).2 hgP⟩, fun Q hQ hQP => ?_⟩
    let Q' : PrimeSpectrum Γ(X, W) := ⟨Q, hQ.1⟩
    have hgQ : g ∈ Q'.asIdeal := (Ideal.span_singleton_le_iff_mem _).1 hQ.2
    have h₁ : hW.fromSpec Q' ⤳ x :=
      hPx ▸ ((PrimeSpectrum.le_iff_specializes Q' P).1 hQP).map hW.fromSpec.continuous
    have h₂ : x ⤳ hW.fromSpec Q' := hgen _ ((hmemY Q').2 hgQ)
    have h₃ : Q' = P := hW.fromSpec.isOpenEmbedding.injective ((h₁.antisymm h₂).eq.trans hPx.symm)
    rw [← h₃]
  have hheight : P.asIdeal.height = 1 := by
    refine le_antisymm (Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ _ hmin) ?_
    exact (Ideal.one_le_height_span_singleton_of_mem_nonZeroDivisors hg).trans
      (Ideal.height_mono hmin.1.2)
  rw [← hPx]
  calc Order.coheight (hW.fromSpec P) = Order.coheight (show Spec Γ(X, W) from P) :=
        coheight_eq_of_isOpenImmersion _
    _ = P.asIdeal.height := (idealHeight_eq_coheight _ P).symm
    _ = 1 := hheight

end AlgebraicGeometry.Scheme.CartierDivisor

namespace Hartshorne

open Ringed AlgebraicGeometry.Scheme.CartierDivisor

section NormalSheaf

variable {X : Scheme.{u}} {D : X.CartierDivisor} (hD : D.IsEffective)

/-- Let `D` be an effective Cartier divisor on `X`, with associated closed subscheme
`i : Y ⟶ X`, and `L = 𝒪_X(D)`. Then the normal sheaf `N_{Y/X}` is `L|_Y = i^* L`: the conormal
sheaf is `J/J² = i^* J ≅ i^* 𝒪_X(-D)` (Proposition 6.18), and dualizing gives
`N_{Y/X} ≅ (i^* 𝒪_X(-D))^∨ ≅ i^* (𝒪_X(-D)^∨) ≅ i^* (L^∨∨) ≅ i^* L`, using that pullback commutes
with duals of locally free sheaves and `𝒪_X(-D) ≅ L^∨` (Proposition 6.13(b)). This is the
identification `N_{Y/X} ≅ L|_Y` in the proof of Hartshorne II, Proposition 8.20, which holds for
any effective Cartier divisor. -/
noncomputable def normalSheafIsoPullbackCartierDivisorSheaf :
    normalSheaf (subschemeι hD) ≅ (Scheme.Modules.pullback (subschemeι hD)).obj D.sheaf :=
  have hL : Ringed.IsLocallyFreeOfRank (R := X.sheaf) D.sheaf 1 :=
    (Scheme.Modules.isInvertible_iff_ringed _).1 D.isInvertible_sheaf
  have hL' : Ringed.IsLocallyFreeOfRank (R := X.sheaf) (-D).sheaf 1 :=
    (Scheme.Modules.isInvertible_iff_ringed _).1 (-D).isInvertible_sheaf
  moduleSheafDualIsoOfIso (immersionConormalSheafIso (subschemeι hD) ≪≫
      (Scheme.Modules.pullback (subschemeι hD)).mapIso (idealSheafIso hD).symm) ≪≫
    (pullbackDualIso (subschemeι hD) (-D).sheaf hL').symm ≪≫
    (Scheme.Modules.pullback (subschemeι hD)).mapIso (moduleSheafDualIsoOfIso (negIsoDual D) ≪≫
      (moduleSheafDoubleDualIso _ hL.isFiniteLocallyFree).symm)

end NormalSheaf

section Adjunction

variable {k : Type u} [Field k] [IsAlgClosed k] {X : Scheme.{u}} (p : X ⟶ Spec (.of k))
  {D : X.CartierDivisor} (hD : D.IsEffective)

/-- **Hartshorne II, Proposition 8.20** (second part), as an explicit isomorphism. Let `X` be a
nonsingular variety over an algebraically closed field `k`, `D` an effective Cartier divisor on `X`
whose associated closed subscheme `i : Y ⟶ X` is nonsingular (irreducible and regular), and
`L = 𝒪_X(D)`. Then `ω_Y ≅ (ω_X ⊗ L)|_Y`, where `(ω_X ⊗ L)|_Y = i^* (ω_X ⊗ L)`.

The isomorphism is the composite of the first part of Proposition 8.20
(`adjunctionDeterminantNormalSheafIso`) with `r = 1`, as `Y` has codimension one
(`Scheme.CartierDivisor.codim_range_subschemeι`); the isomorphism `⋀^1 N_{Y/X} ≅ N_{Y/X}`; the
identification `N_{Y/X} ≅ i^* L` (`normalSheafIsoPullbackCartierDivisorSheaf`); and the inverse of
the isomorphism `i^* (ω_X ⊗ L) ≅ i^* ω_X ⊗ i^* L` for the invertible sheaves `ω_X` and `L`. As in
the formalization of the first part, `X` is irreducible, regular and of finite type over `k`;
separatedness is not used. -/
noncomputable def adjunctionEffectiveCartierDivisorIso (hp : FiniteType p) [IrreducibleSpace X]
    (hX : X.IsRegular) [IrreducibleSpace (idealSheafData hD).subscheme]
    (hY : (idealSheafData hD).subscheme.IsRegular) :
    canonicalSheaf (subschemeι hD ≫ p) ≅
      (Scheme.Modules.pullback (subschemeι hD)).obj
        (moduleSheafTensor (R := X.sheaf) (canonicalSheaf p) D.sheaf) :=
  haveI : IsLocallyNoetherian X := hX.1
  have hω : Ringed.IsInvertible (R := X.sheaf) (canonicalSheaf p) := by
    have : IsIntegral X := isIntegral_of_isRegular hX
    obtain ⟨n, hn⟩ := ProductNonsingular.exists_topologicalKrullDim_eq p hp
    exact (Scheme.Modules.isInvertible_iff_ringed _).1 (canonicalSheaf_isInvertible p hp hX n hn)
  have hL : Ringed.IsInvertible (R := X.sheaf) D.sheaf :=
    (Scheme.Modules.isInvertible_iff_ringed _).1 D.isInvertible_sheaf
  have h1 : codim (Set.range (subschemeι hD).base) = ((1 : ℕ) : ℕ∞) := by
    rw [Nat.cast_one]
    exact codim_range_subschemeι hD
  adjunctionDeterminantNormalSheafIso p (subschemeι hD) hp hX hY 1 h1 ≪≫
    moduleSheafTensorIsoOfIso (Iso.refl _)
      (moduleSheafExteriorPowerOneIso _ ≪≫ normalSheafIsoPullbackCartierDivisorSheaf hD) ≪≫
    (pullbackTensorIso (subschemeι hD) hω hL).symm

/-- **Hartshorne II, Proposition 8.20** (second part). Let `X` be a nonsingular variety over an
algebraically closed field `k`, `D` an effective Cartier divisor on `X` whose associated closed
subscheme `i : Y ⟶ X` is nonsingular (irreducible and regular), and `L = 𝒪_X(D)`. Then
`ω_Y ≅ (ω_X ⊗ L)|_Y`, where `(ω_X ⊗ L)|_Y = i^* (ω_X ⊗ L)`.

The isomorphism is `adjunctionEffectiveCartierDivisorIso`. As in the formalization of the first
part, `X` is irreducible, regular and of finite type over `k`; separatedness is not used. -/
theorem adjunction_effectiveCartierDivisor (hp : FiniteType p) [IrreducibleSpace X]
    (hX : X.IsRegular) [IrreducibleSpace (idealSheafData hD).subscheme]
    (hY : (idealSheafData hD).subscheme.IsRegular) :
    Nonempty (canonicalSheaf (subschemeι hD ≫ p) ≅
      (Scheme.Modules.pullback (subschemeι hD)).obj
        (moduleSheafTensor (R := X.sheaf) (canonicalSheaf p) D.sheaf)) :=
  ⟨adjunctionEffectiveCartierDivisorIso p hD hp hX hY⟩

end Adjunction

end Hartshorne
