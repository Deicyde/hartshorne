/-!
# The conormal criterion for nonsingularity

Hartshorne, *Algebraic Geometry*, II, Theorem 8.17 (pp. 178–179).

Let `X` be a nonsingular variety over an algebraically closed field `k` and `i : Y ⟶ X` an
irreducible closed subscheme with ideal sheaf `I`. Then `Y` is nonsingular if and only if
`Ω_{Y/k}` is locally free and the conormal sequence `0 → i^* I → i^* Ω_{X/k} → Ω_{Y/k} → 0` is
exact on the left (`Hartshorne.ConormalCriterion.conormal_criterion_nonsingular`). Here `i^* I`
is the conormal sheaf, whose pushforward is `I/I²`, and the sequence is the right exact sequence
of Proposition 8.12.

## Proof

The forward direction is the forward direction of Theorem 8.17
(`Hartshorne.NonsingularConormal.nonsingular_closedImmersion_conormal`), together with
Theorem 8.15 for the local freeness of `Ω_{Y/k}`.

For the converse we follow the printed proof
(`Hartshorne.ConormalCriterion.isRegular_of_isLocallyFree_of_mono`). On the irreducible scheme
`Y` the locally free sheaf `Ω_{Y/k}` has constant rank `q`, and `Ω_{X/k}` is locally free of rank
`n = dim X` (Theorem 8.15). By Theorem 8.15 it suffices to show `q = dim Y`; we compare both at a
closed point `y` of `Y`, where `𝒪_{X,y}` has dimension `n` and `𝒪_{Y,y}` has dimension `dim Y`.

* At `y` the conormal sequence is a short exact sequence `0 → C → B^n → B^q → 0` over
  `B = 𝒪_{Y,y}`, so its first term `C = B ⊗ I_y` is free of rank `s = n - q`
  (`ConormalCriterion.exists_linearEquiv_of_exact`). By Nakayama's lemma the ideal `I_y` of
  `A = 𝒪_{X,y}` is generated by `s` elements (`ConormalCriterion.span_eq_top_of_span_tmul_eq_top`),
  so `dim A ≤ dim B + s` (Exercise I.1.9; `ConormalCriterion.ringKrullDim_stalk_le_add`). Hence
  `dim Y ≥ q`.
* At a closed point, `q = dim_k Ω_{Y/k} ⊗ k(y) = dim_k 𝔪_y/𝔪_y²` (Proposition 8.7), which is at
  least `dim 𝒪_{Y,y} = dim Y` (`ConormalCriterion.ringKrullDim_stalk_le_finrank_fibre`).
-/

universe u v w

open IsLocalRing Ideal Module
open scoped TensorProduct ChangeOfRings

namespace Hartshorne

namespace ConormalCriterion

section Algebra

variable {B : Type u} [CommRing B] [IsLocalRing B] {C : Type v} {E : Type w} {F : Type w}
  [AddCommGroup C] [Module B C] [AddCommGroup E] [Module B E] [AddCommGroup F] [Module B F]

/-- Let `0 → C → E → F → 0` be a short exact sequence of modules over a local ring `B`, with `E`
free of rank `n` and `F` free of rank `q`. Then `C` is free of rank `n - q`: the kernel of
`E → F` is a direct summand of `E`, hence finite projective, hence free. -/
theorem exists_linearEquiv_of_exact (g : C →ₗ[B] E) (h : E →ₗ[B] F) (hex : Function.Exact g h)
    (hg : Function.Injective g) (hh : Function.Surjective h) {n q : ℕ}
    (eE : E ≃ₗ[B] (Fin n → B)) (eF : F ≃ₗ[B] (Fin q → B)) :
    ∃ s : ℕ, n = q + s ∧ Nonempty (C ≃ₗ[B] (Fin s → B)) := by
  have : Module.Free B F := Module.Free.of_equiv eF.symm
  have : Module.Free B E := Module.Free.of_equiv eE.symm
  have : Module.Finite B F := Module.Finite.equiv eF.symm
  have : Module.Finite B E := Module.Finite.equiv eE.symm
  let K := LinearMap.ker h
  obtain ⟨σ, hσ⟩ := Module.projective_lifting_property h LinearMap.id hh
  obtain ⟨e, hf, -⟩ := (h.exact_subtype_ker_map.splitSurjectiveEquiv
    (Submodule.injective_subtype K)) ⟨σ, hσ⟩
  have hek : ∀ k : K, e k = (k, 0) := fun k => by
    have : (k : E) = e.symm (k, 0) := LinearMap.congr_fun hf k
    rw [this, LinearEquiv.apply_symm_apply]
  have : Module.Finite B K :=
    Module.Finite.of_surjective ((LinearMap.fst B K F).comp e.toLinearMap)
      (fun k => ⟨k, by simp [hek]⟩)
  have : Module.Projective B K :=
    Module.Projective.of_split K.subtype ((LinearMap.fst B K F).comp e.toLinearMap)
      (by ext k; simp [hek])
  have : Module.Free B K := Module.free_of_flat_of_isLocalRing
  have h1 : finrank B E = finrank B (K × F) := e.finrank_eq
  rw [Module.finrank_prod, eE.finrank_eq, eF.finrank_eq, Module.finrank_fin_fun,
    Module.finrank_fin_fun] at h1
  refine ⟨finrank B K, by omega, ⟨?_⟩⟩
  let eC : C ≃ₗ[B] K := (LinearEquiv.ofInjective g hg).trans
    (LinearEquiv.ofEq _ _ hex.linearMap_ker_eq.symm)
  exact eC.trans (Module.finBasisOfFinrankEq B K rfl).equivFun

end Algebra

section ExtendScalars

variable {A : Type u} [CommRing A] {B : Type u} [CommRing B] (ρ : A →+* B)

/-- Along a surjection `ρ : A → B`, every element of `B ⊗_A M` has the form `1 ⊗ m`. -/
theorem exists_tmul_eq (hρ : Function.Surjective ρ) (M : ModuleCat.{u} A)
    (z : (ModuleCat.extendScalars ρ).obj M) :
    ∃ m : M, (show ((ModuleCat.extendScalars ρ).obj M : Type u) from (1 : B) ⊗ₜ[A,ρ] m) = z := by
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, TensorProduct.tmul_zero _ _⟩
  | tmul b m =>
    obtain ⟨a, rfl⟩ := hρ b
    let N := (ModuleCat.restrictScalars ρ).obj (ModuleCat.of B B)
    refine ⟨a • m, ?_⟩
    have h : (show N from ρ a) = a • (show N from (1 : B)) := by
      change ρ a = ρ a * 1
      rw [mul_one]
    change (show N from (1 : B)) ⊗ₜ[A] (a • m) = (show N from ρ a) ⊗ₜ[A] m
    rw [h, TensorProduct.smul_tmul]
  | add z z' hz hz' =>
    obtain ⟨m, rfl⟩ := hz
    obtain ⟨m', rfl⟩ := hz'
    exact ⟨m + m', TensorProduct.tmul_add _ _ _⟩

/-- The kernel of `M → B ⊗_A M`, `m ↦ 1 ⊗ m`, along a surjection `ρ : A → B`, lies in
`(ker ρ) M`: indeed `B ⊗_A M ≅ (A / ker ρ) ⊗_A M ≅ M / (ker ρ) M`. -/
theorem mem_smul_top_of_tmul_eq_zero (hρ : Function.Surjective ρ) (M : ModuleCat.{u} A) (m : M)
    (hm : (show ((ModuleCat.extendScalars ρ).obj M : Type u) from (1 : B) ⊗ₜ[A,ρ] m) = 0) :
    m ∈ RingHom.ker ρ • (⊤ : Submodule A M) := by
  let J := RingHom.ker ρ
  let e : A ⧸ J ≃+* B := RingHom.quotientKerEquivOfSurjective hρ
  let N := (ModuleCat.restrictScalars ρ).obj (ModuleCat.of B B)
  let τ : N →ₗ[A] A ⧸ J :=
    { toFun := fun b => e.symm (show B from b)
      map_add' := fun b b' => map_add e.symm (show B from b) (show B from b')
      map_smul' := fun a b => by
        change e.symm (ρ a * (show B from b)) = Ideal.Quotient.mk J a * e.symm (show B from b)
        rw [map_mul]
        congr 1
        apply e.injective
        rw [RingEquiv.apply_symm_apply]
        rfl }
  let ψ : TensorProduct A N M →ₗ[A] M ⧸ (J • (⊤ : Submodule A M)) :=
    TensorProduct.quotTensorEquivQuotSMul M J ∘ₗ τ.rTensor M
  have h1 : ψ ((show N from (1 : B)) ⊗ₜ[A] m) = Submodule.Quotient.mk m := by
    have hτ : τ (show N from (1 : B)) = Ideal.Quotient.mk J 1 := by
      apply e.injective
      change e (e.symm 1) = _
      rw [RingEquiv.apply_symm_apply, map_one, map_one]
    change TensorProduct.quotTensorEquivQuotSMul M J (τ (show N from (1 : B)) ⊗ₜ[A] m) = _
    rw [hτ, TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul]
  have h0 : ψ ((show N from (1 : B)) ⊗ₜ[A] m) = 0 := by
    have : (show N from (1 : B)) ⊗ₜ[A] m = 0 := hm
    rw [this, map_zero]
  rw [h1] at h0
  exact (Submodule.Quotient.mk_eq_zero _).mp h0

/-- **Nakayama's lemma** along a local surjection: if `ρ : A → B` is a surjection from a local
ring onto a nonzero ring and `M` is a finite `A`-module, elements `v j` of `M` whose images
`1 ⊗ v j` generate `B ⊗_A M` over `B` generate `M` over `A`. -/
theorem span_eq_top_of_span_tmul_eq_top [IsLocalRing A] [Nontrivial B]
    (hρ : Function.Surjective ρ) (M : ModuleCat.{u} A) [Module.Finite A M] {ι : Type*}
    (v : ι → M)
    (hv : Submodule.span B (Set.range fun j =>
      (show ((ModuleCat.extendScalars ρ).obj M : Type u) from (1 : B) ⊗ₜ[A,ρ] v j)) = ⊤) :
    Submodule.span A (Set.range v) = ⊤ := by
  set N := Submodule.span A (Set.range v)
  let J := RingHom.ker ρ
  have hJ : J ≤ Ideal.jacobson ⊥ := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    exact IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top ρ)
  let u := ModuleCat.ExtendRestrictScalarsAdj.Unit.map ρ (X := M)
  let φ : M →+ (ModuleCat.extendScalars ρ).obj M := u.hom.toAddMonoidHom
  have hφ : ∀ (a : A) (m : M), φ (a • m) = ρ a • φ m := fun a m => u.hom.map_smul a m
  -- every element of the span of the `1 ⊗ v j` is `1 ⊗ n` with `n ∈ N`
  have key : ∀ z ∈ Submodule.span B (Set.range fun j =>
      (show ((ModuleCat.extendScalars ρ).obj M : Type u) from (1 : B) ⊗ₜ[A,ρ] v j)),
      ∃ n ∈ N, φ n = z := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨j, rfl⟩ := hz
      exact ⟨v j, Submodule.subset_span ⟨j, rfl⟩, rfl⟩
    | zero => exact ⟨0, zero_mem _, map_zero φ⟩
    | add z z' _ _ hz hz' =>
      obtain ⟨n, hn, rfl⟩ := hz
      obtain ⟨n', hn', rfl⟩ := hz'
      exact ⟨n + n', add_mem hn hn', map_add φ n n'⟩
    | smul b z _ hz =>
      obtain ⟨n, hn, rfl⟩ := hz
      obtain ⟨a, rfl⟩ := hρ b
      exact ⟨a • n, Submodule.smul_mem _ a hn, hφ a n⟩
  refine top_le_iff.mp (Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hJ ?_)
  intro m _
  obtain ⟨n, hn, hnm⟩ := key (φ m) (hv ▸ Submodule.mem_top)
  have hz : φ (m - n) = 0 := by rw [map_sub, hnm, sub_self]
  have := mem_smul_top_of_tmul_eq_zero ρ hρ M (m - n) hz
  have hmn : m = n + (m - n) := by abel
  rw [hmn]
  exact Submodule.add_mem_sup hn this

end ExtendScalars

section Stalks

open CategoryTheory AlgebraicGeometry

/-- The stalks of a monomorphism of `𝒪_Y`-modules are injective. -/
theorem injective_stalk_of_mono {Y : Scheme.{u}} {F G : Y.Modules} (φ : F ⟶ G) [Mono φ]
    (y : Y) : Function.Injective ((Ringed.moduleStalkFunctor (R := Y.sheaf) y).map φ) :=
  TopCat.Presheaf.stalkFunctor_map_injective_of_app_injective (C := AddCommGrpCat.{u})
    (fun U => NonsingularConormal.modules_app_injective_of_mono φ U) y

end Stalks

section ClosedPoint

open CategoryTheory AlgebraicGeometry DifferentialsNonsingular

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- At a closed point `x` of a scheme of finite type over an algebraically closed field `k`, the
fibre `Ω_{X/k} ⊗ k(x)` has dimension at least `dim 𝒪_{X,x}`: by Proposition 8.7 it is the
cotangent space `𝔪_x/𝔪_x²`, whose dimension bounds that of the local ring. -/
theorem ringKrullDim_stalk_le_finrank_fibre {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (hf : FiniteType f) (x : X) (hx : IsClosed ({x} : Set X)) :
    ringKrullDim (X.presheaf.stalk x) ≤
      finrank (ResidueField (X.presheaf.stalk x))
        (ResidueField (X.presheaf.stalk x) ⊗[X.presheaf.stalk x]
          (Scheme.relativeDifferentials f).presheaf.stalk x) := by
  have : LocallyOfFiniteType f := hf.1
  -- the base ring `Γ(Spec k, ⊤) ≅ k` is an algebraically closed field
  let eA := (Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv
  let : Field Γ(Spec (.of k), ⊤) := (eA.toMulEquiv.isField (Field.toIsField k)).toField
  have : IsAlgClosed Γ(Spec (.of k), ⊤) := IsAlgClosed.of_ringEquiv k _ eA.symm
  let V : (Spec (.of k)).affineOpens := ⟨⊤, isAffineOpen_top _⟩
  obtain ⟨U, y, rfl⟩ := exists_fromSpec_eq x
  have hm : y.asIdeal.IsMaximal := isMaximal_of_isClosed_fromSpec U y hx
  let T := Γ(X, (U : X.Opens))
  have hUV : (U : X.Opens) ≤ f ⁻¹ᵁ (V : (Spec (.of k)).Opens) := le_top
  let : Algebra Γ(Spec (.of k), ⊤) T := (f.appLE ⊤ U hUV).hom.toAlgebra
  have : Algebra.FiniteType Γ(Spec (.of k), ⊤) T := f.finiteType_appLE V.2 U.2 hUV
  have : IsNoetherianRing T := Algebra.FiniteType.isNoetherianRing Γ(Spec (.of k), ⊤) T
  -- `𝒪_{X,x}` is the localization `B = T_m` at the maximal ideal `m` of `x`
  let B := Localization.AtPrime y.asIdeal
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨U.2.fromSpec y, fromSpec_mem U y⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk (U.2.fromSpec y)) y.asIdeal :=
    U.2.isLocalization_stalk' y (fromSpec_mem U y)
  let eB : X.presheaf.stalk (U.2.fromSpec y) ≃+* B :=
    (IsLocalization.algEquiv y.asIdeal.primeCompl _ B).toRingEquiv
  have hbij := bijective_algebraMap_residueField (k := Γ(Spec (.of k), ⊤)) y.asIdeal
  -- the fibre of `Ω_{X/k}` at `x` is the fibre of `Ω_{B/k}`, i.e. `𝔪_B/𝔪_B²` (Proposition 8.7)
  have hfib : finrank (ResidueField (X.presheaf.stalk (U.2.fromSpec y)))
      (ResidueField (X.presheaf.stalk (U.2.fromSpec y)) ⊗[X.presheaf.stalk (U.2.fromSpec y)]
        (Scheme.relativeDifferentials f).presheaf.stalk (U.2.fromSpec y)) =
      finrank y.asIdeal.ResidueField (y.asIdeal.ResidueField ⊗[B] Ω[B⁄Γ(Spec (.of k), ⊤)]) := by
    exact (finrank_fibre_relativeDifferentials_affine f U V hUV y).trans
      (finrank_tensor_kaehler_localization y.asIdeal.primeCompl B _)
  rw [hfib, ← finrank_cotangentSpace_eq_finrank_residueField_tensor_kaehlerDifferential _ B hbij,
    ringKrullDim_eq_of_ringEquiv eB,
    ← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
  exact ringKrullDim_le_spanFinrank_maximalIdeal B

end ClosedPoint

section Krull

open CategoryTheory Limits AlgebraicGeometry Ringed ModuleSheafTensor LCICohenMacaulay

variable {k : Type u} [Field k] {X Y : Scheme.{u}} (p : X ⟶ Spec (.of k))
  (i : Y ⟶ X) [IsClosedImmersion i]

/-- **The local step of the converse of Hartshorne II, Theorem 8.17.** Suppose that the conormal
sequence `0 → i^* I → i^* Ω_{X/k} → Ω_{Y/k} → 0` is exact on the left, with `Ω_{X/k}` locally free
of rank `n` and `Ω_{Y/k}` locally free of rank `q`. Then at every point `y` of `Y`, `n = q + s`
where the stalk of the ideal sheaf at `i y` is generated by `s` elements (Nakayama), so that
`dim 𝒪_{X,i y} ≤ dim 𝒪_{Y,y} + s` (the dimension inequality for quotients by `s` elements,
Exercise I.1.9). -/
theorem ringKrullDim_stalk_le_add [IsLocallyNoetherian X]
    (hmono : Mono (ClosedConormal.conormalToPullback i p)) {n q : ℕ}
    (hΩX : (Scheme.relativeDifferentials p).IsLocallyFreeOfRank n)
    (hΩY : (Scheme.relativeDifferentials (i ≫ p)).IsLocallyFreeOfRank q) (y : Y) :
    ∃ s : ℕ, n = q + s ∧
      ringKrullDim (X.presheaf.stalk (i y)) ≤ ringKrullDim (Y.presheaf.stalk y) + s := by
  classical
  -- the conormal sequence on stalks is short exact
  obtain ⟨hex, hepi⟩ := ClosedConormal.closedImmersion_conormal_exact i p
  obtain ⟨hex', hsurj⟩ :=
    NonsingularConormal.stalk_exact_and_surjective (R := Y.sheaf) _ hex hepi y
  have hinj := injective_stalk_of_mono (ClosedConormal.conormalToPullback i p) y
  have hE := ProductNonsingular.isLocallyFreeOfRank_pullback i hΩX
  obtain ⟨eE⟩ := NonsingularConormal.nonempty_stalk_equiv_of_isLocallyFreeOfRank _ n hE y
  obtain ⟨eF⟩ := NonsingularConormal.nonempty_stalk_equiv_of_isLocallyFreeOfRank _ q hΩY y
  have : IsLocalRing (ringSheafStalk Y.sheaf y) :=
    inferInstanceAs (IsLocalRing (Y.presheaf.stalk y))
  -- so the stalk of `i^* I` is free of rank `s = n - q`
  obtain ⟨s, hs, ⟨eC⟩⟩ := exists_linearEquiv_of_exact _ _ hex' hinj hsurj eE eF
  refine ⟨s, hs, ?_⟩
  let ρ : ringSheafStalk X.sheaf (i y) →+* ringSheafStalk Y.sheaf y := (i.stalkMap y).hom
  have hρ : Function.Surjective ρ := i.stalkMap_surjective y
  let M := (moduleStalkFunctor (R := X.sheaf) (i y)).obj (closedImmersionIdealSheaf i)
  let M' := (ModuleCat.extendScalars ρ).obj M
  let C' := (moduleStalkFunctor (R := Y.sheaf) y).obj
    ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i))
  let e : C' ≃ₗ[ringSheafStalk Y.sheaf y] M' :=
    pullbackStalkLinearEquiv i y (closedImmersionIdealSheaf i)
  let c : Fin s → M' := fun j => e (eC.symm (Pi.single j 1))
  have hc : Submodule.span (ringSheafStalk Y.sheaf y) (Set.range c) = ⊤ := by
    have := (((Pi.basisFun (ringSheafStalk Y.sheaf y) (Fin s)).map eC.symm).map e).span_eq
    convert this using 2
    ext j
    simp [c]
  -- lifting the generators of `B ⊗_A I_{i y}` to `I_{i y}`, Nakayama's lemma shows that
  -- `I_{i y}` is generated by `s` elements
  choose v hv using fun j => exists_tmul_eq ρ hρ M (c j)
  have hv' : Submodule.span (ringSheafStalk Y.sheaf y) (Set.range fun j =>
      (show (M' : Type u) from (1 : ringSheafStalk Y.sheaf y) ⊗ₜ[_,ρ] v j)) = ⊤ := by
    rw [← hc]
    congr 2
    exact funext hv
  let L : M →ₗ[ringSheafStalk X.sheaf (i y)] ringSheafStalk X.sheaf (i y) :=
    { toFun := idealStalkMap i (i y)
      map_add' := map_add _
      map_smul' := idealStalkMap_smul i (i y) }
  have : IsNoetherianRing (ringSheafStalk X.sheaf (i y)) :=
    inferInstanceAs (IsNoetherianRing (X.presheaf.stalk (i y)))
  have : Module.Finite (ringSheafStalk X.sheaf (i y)) M :=
    Module.Finite.of_injective L (NonsingularConormal.idealStalkMap_injective i (i y))
  have : IsLocalRing (ringSheafStalk X.sheaf (i y)) :=
    inferInstanceAs (IsLocalRing (X.presheaf.stalk (i y)))
  have : Nontrivial (ringSheafStalk Y.sheaf y) :=
    inferInstanceAs (Nontrivial (Y.presheaf.stalk y))
  have hM := span_eq_top_of_span_tmul_eq_top ρ hρ M v hv'
  -- hence the kernel of `𝒪_{X,i y} → 𝒪_{Y,y}` is generated by `s` elements
  let S : Finset (ringSheafStalk X.sheaf (i y)) := Finset.univ.image fun j => L (v j)
  have hker : RingHom.ker ρ = Ideal.span (S : Set (ringSheafStalk X.sheaf (i y))) := by
    refine le_antisymm (fun a ha => ?_) (Ideal.span_le.mpr ?_)
    · obtain ⟨m, rfl⟩ := NonsingularConormal.exists_idealStalkMap_eq i y a ha
      have hm : m ∈ Submodule.span _ (Set.range v) := hM ▸ Submodule.mem_top
      have := Submodule.mem_map_of_mem (f := L) hm
      rw [Submodule.map_span, ← Set.range_comp] at this
      simp only [S, Finset.coe_image, Finset.coe_univ, Set.image_univ]
      exact this
    · intro a ha
      obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp ha
      exact stalkMap_idealStalkMap i y (v j)
  have hS : (S : Set (ringSheafStalk X.sheaf (i y))) ⊆
      (Ring.jacobson (ringSheafStalk X.sheaf (i y)) : Set (ringSheafStalk X.sheaf (i y))) := by
    rw [IsLocalRing.ringJacobson_eq_maximalIdeal]
    intro a ha
    have hk : RingHom.ker ρ ≤ maximalIdeal _ := IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top ρ)
    exact hk (hker ▸ Ideal.subset_span ha)
  have hK := ringKrullDim_le_ringKrullDim_quotient_add_card S hS
  rw [← hker, ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hρ)] at hK
  have : S.card ≤ s := (Finset.card_image_le).trans (by simp)
  have hcard : ((S.card : ℕ∞) : WithBot ℕ∞) ≤ ((s : ℕ∞) : WithBot ℕ∞) := by exact_mod_cast this
  exact hK.trans (add_le_add_right hcard _)

end Krull

section Main

open CategoryTheory Limits AlgebraicGeometry DifferentialsNonsingular

variable {k : Type u} [Field k] [IsAlgClosed k] {X Y : Scheme.{u}} (p : X ⟶ Spec (.of k))
  (i : Y ⟶ X) [IsClosedImmersion i]

omit [IsAlgClosed k] in
/-- A nonempty closed subscheme `Y` of an integral scheme `X` of finite type over a field, of
dimension `n`, has finite dimension `d` and finite codimension `r`, with `n = d + r`
(Exercise II.3.20). -/
theorem exists_topologicalKrullDim_eq (hp : FiniteType p) [IsIntegral X] [Nonempty Y] {n : ℕ}
    (hn : topologicalKrullDim X = n) :
    ∃ d r : ℕ, topologicalKrullDim Y = d ∧ codim (Set.range i.base) = r ∧ n = d + r := by
  obtain ⟨y⟩ := ‹Nonempty Y›
  have hdc := dimension_codimension_formula p hp (Set.range i.base)
    i.isClosedEmbedding.isClosed_range ⟨i y, y, rfl⟩
  rw [← IsHomeomorph.topologicalKrullDim_eq _
    (i.isClosedEmbedding.toHomeomorph).isHomeomorph, hn] at hdc
  generalize topologicalKrullDim Y = e at hdc ⊢
  generalize codim (Set.range i.base) = c at hdc ⊢
  induction e using WithBot.recBotCoe with
  | bot => simp at hdc
  | coe e =>
    have h : e + c = n := by exact_mod_cast hdc
    induction e using ENat.recTopCoe with
    | top => simp at h
    | coe d =>
      induction c using ENat.recTopCoe with
      | top => simp at h
      | coe r => exact ⟨d, r, rfl, rfl, by exact_mod_cast h.symm⟩

/-- **Hartshorne II, Theorem 8.17** (converse direction). Let `X` be a nonsingular variety over an
algebraically closed field `k` and `Y` an irreducible closed subscheme. If `Ω_{Y/k}` is locally
free and the conormal sequence `0 → i^* I → i^* Ω_{X/k} → Ω_{Y/k} → 0` is exact on the left,
then `Y` is nonsingular.

Following the printed proof: `Ω_{Y/k}` is locally free of some rank `q`, and `Ω_{X/k}` of rank
`n = dim X`, so the conormal sheaf is locally free of rank `n - q` and, by Nakayama's lemma, the
ideal of `Y` is locally generated by `n - q` elements; hence `dim Y ≥ q` (Exercise I.1.9). At a
closed point `y`, `q = dim_k 𝔪_y/𝔪_y² ≥ dim Y` (Proposition 8.7). So `q = dim Y`, and `Y` is
nonsingular by Theorem 8.15. -/
theorem isRegular_of_isLocallyFree_of_mono (hp : FiniteType p) [IrreducibleSpace X]
    (hX : X.IsRegular) [IrreducibleSpace Y]
    (hΩ : (Scheme.relativeDifferentials (i ≫ p)).IsLocallyFree)
    (hmono : Mono (ClosedConormal.conormalToPullback i p)) : Y.IsRegular := by
  have : IsIntegral X := isIntegral_of_isRegular hX
  have := hp.1
  have := hp.2
  have hp' : FiniteType (i ≫ p) := ⟨inferInstance, inferInstance⟩
  have : LocallyOfFiniteType (i ≫ p) := hp'.1
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p
  have : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace (i ≫ p)
  -- a closed point `y₀` of `Y`, and the dimensions `n = dim X` and `d = dim Y`
  obtain ⟨y₀, -, hy₀⟩ := nonempty_inter_closedPoints (X := Y) Set.univ_nonempty
    isClosed_univ.isLocallyClosed
  rw [mem_closedPoints_iff] at hy₀
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (i y₀)) isOpen_univ
  have : Nonempty U := ⟨⟨i y₀, hyU⟩⟩
  obtain ⟨n, -, hn⟩ := DimensionCodimension.exists_ringKrullDim_eq p hp U hU
  obtain ⟨d, -, hd, -, -⟩ := exists_topologicalKrullDim_eq p i hp hn
  -- `Ω_{Y/k}` is locally free of constant rank `q`, its rank at `y₀`
  let F := Scheme.relativeDifferentials (i ≫ p)
  let q := finrank (ResidueField (Y.presheaf.stalk y₀))
    (ResidueField (Y.presheaf.stalk y₀) ⊗[Y.presheaf.stalk y₀] F.presheaf.stalk y₀)
  have hq : F.IsLocallyFreeOfRank q := by
    refine (F.isLocallyFreeOfRank_iff q).mpr ⟨hΩ, fun x => ?_⟩
    rw [F.rankAt_eq_of_connectedSpace hΩ x y₀]
    obtain ⟨W, hW, I, ⟨α⟩⟩ := hΩ y₀
    have := finite_fibre_relativeDifferentials (i ≫ p) y₀
    rw [F.rankAt_eq α hW, ← rank_fibre_of_restrict_iso_free F α hW]
    exact (Module.finrank_eq_rank _ _).symm
  -- `Ω_{X/k}` is locally free of rank `n` (Theorem 8.15)
  have hΩX := (isRegular_iff_relativeDifferentials_isLocallyFreeOfRank p hp n hn).mp hX
  -- the dimensions of the local rings at the closed points `i y₀` and `y₀`
  have hcl : IsClosed ({i y₀} : Set X) := by
    simpa using i.isClosedEmbedding.isClosedMap _ hy₀
  have hA := ringKrullDim_stalk_of_isClosed p hp hn (i y₀) hcl
  have hB := ringKrullDim_stalk_of_isClosed (i ≫ p) hp' hd y₀ hy₀
  -- `q ≥ dim Y` (Proposition 8.7) and `dim Y ≥ q` (Nakayama and Exercise I.1.9)
  have hle := ringKrullDim_stalk_le_finrank_fibre (i ≫ p) hp' y₀ hy₀
  obtain ⟨s, hs, hge⟩ := ringKrullDim_stalk_le_add p i hmono hΩX hq y₀
  rw [hB] at hle
  rw [hA, hB] at hge
  have h1 : d ≤ q := by exact_mod_cast hle
  have h2 : n ≤ d + s := by exact_mod_cast hge
  have hqd : q = d := by omega
  exact (isRegular_iff_relativeDifferentials_isLocallyFreeOfRank (i ≫ p) hp' d hd).mpr
    (hqd ▸ hq)

/-- **Hartshorne II, Theorem 8.17.** Let `X` be a nonsingular variety over an algebraically closed
field `k`, and let `i : Y ⟶ X` be an irreducible closed subscheme, with ideal sheaf `I`. Then `Y`
is nonsingular if and only if

1. `Ω_{Y/k}` is locally free, and
2. the conormal sequence `0 → i^* I → i^* Ω_{X/k} → Ω_{Y/k} → 0` (Proposition 8.12; `i^* I` is
   the conormal sheaf, whose pushforward is `I/I²`) is exact on the left.

The forward direction is `NonsingularConormal.nonsingular_closedImmersion_conormal` together with
Theorem 8.15; the converse is `isRegular_of_isLocallyFree_of_mono`. Hartshorne states this for a
nonsingular variety (integral, separated, of finite type over `k`); the proof uses only that `X`
is irreducible, regular and of finite type over `k`. -/
theorem conormal_criterion_nonsingular (hp : FiniteType p) [IrreducibleSpace X]
    (hX : X.IsRegular) [IrreducibleSpace Y] :
    Y.IsRegular ↔ (Scheme.relativeDifferentials (i ≫ p)).IsLocallyFree ∧
      Mono (ClosedConormal.conormalToPullback i p) := by
  refine ⟨fun hY => ?_, fun h => isRegular_of_isLocallyFree_of_mono p i hp hX h.1 h.2⟩
  have : IsIntegral X := isIntegral_of_isRegular hX
  have hp' : FiniteType (i ≫ p) := by
    have := hp.1
    have := hp.2
    exact ⟨inferInstance, inferInstance⟩
  obtain ⟨y₀⟩ := (inferInstance : Nonempty Y)
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (i y₀)) isOpen_univ
  have : Nonempty U := ⟨⟨i y₀, hyU⟩⟩
  obtain ⟨n, -, hn⟩ := DimensionCodimension.exists_ringKrullDim_eq p hp U hU
  obtain ⟨d, r, hd, hr, -⟩ := exists_topologicalKrullDim_eq p i hp hn
  obtain ⟨hses, -, -⟩ := NonsingularConormal.nonsingular_closedImmersion_conormal p i hp hX hY r hr
  refine ⟨?_, hses.mono_f⟩
  have hΩ := (isRegular_iff_relativeDifferentials_isLocallyFreeOfRank (i ≫ p) hp' d hd).mp hY
  exact ((Scheme.relativeDifferentials (i ≫ p)).isLocallyFreeOfRank_iff d).mp hΩ |>.1

end Main

