import Mathlib.RingTheory.Kaehler.Basic
import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.FiniteType

/-!
# Local frames for first-order jets

Let `A` be a finitely generated algebra over a field `k` and let `ev₀ : A →ₐ[k] k` be a `k`-point
with maximal ideal `𝔪₀ = ker ev₀`. Suppose that `g₀, …, gᵣ ∈ A` span `A / 𝔪₀²` over `k`. We show
that the `gℓ` then form a frame of first-order jets in a neighbourhood of `ev₀`: there is
`h ∈ A` with `h(ev₀) ≠ 0` such that every `f ∈ A` admits coefficients `μ₀, …, μᵣ ∈ A` with
`h(ev) · f ≡ ∑ μℓ(ev) · gℓ (mod 𝔪_ev²)` simultaneously for all `k`-points `ev`.

The proof works in the module of principal parts `A ⊗[k] A`, viewed as an `A`-module through the
left factor, modulo the square of the diagonal ideal `J = ker (A ⊗[k] A → A)`. This quotient is a
finitely generated `A`-module, and the hypothesis says that it is generated by the classes of
`1 ⊗ gℓ` modulo `𝔪₀`; Nakayama's lemma produces `h ≡ 1 (mod 𝔪₀)` such that `h ⊗ f` lies in the
span of the `1 ⊗ gℓ` modulo `J²`. Specialising the left factor along `ev` gives the claim.

## Main results

* `Hartshorne.BertiniIncidence.exists_jet_frame`: the local frame statement above.
-/

namespace Hartshorne.BertiniIncidence

open TensorProduct
open scoped Pointwise

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A]

/-- For `b` in the subalgebra generated by `t`, the element `1 ⊗ b - b ⊗ 1` lies in the left
`A`-span of the elements `1 ⊗ y - y ⊗ 1` (`y ∈ t`) modulo the square of the diagonal ideal. -/
private lemma jetFrame_one_tmul_sub_mem {t : Set A} {b : A} (hb : b ∈ Algebra.adjoin k t) :
    (1 : A) ⊗ₜ[k] b - b ⊗ₜ[k] (1 : A) ∈
      Submodule.span A ((fun y : A => (1 : A) ⊗ₜ[k] y - y ⊗ₜ[k] (1 : A)) '' t) ⊔
        ((KaehlerDifferential.ideal k A) ^ 2).restrictScalars A := by
  induction hb using Algebra.adjoin_induction with
  | mem x hx => exact Submodule.mem_sup_left (Submodule.subset_span ⟨x, hx, rfl⟩)
  | algebraMap c =>
    have : (1 : A) ⊗ₜ[k] (algebraMap k A c) - (algebraMap k A c) ⊗ₜ[k] (1 : A) = 0 := by
      rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, sub_self]
    rw [this]
    exact zero_mem _
  | add x y _ _ hx hy =>
    have : (1 : A) ⊗ₜ[k] (x + y) - (x + y) ⊗ₜ[k] (1 : A) =
        ((1 : A) ⊗ₜ[k] x - x ⊗ₜ[k] (1 : A)) + ((1 : A) ⊗ₜ[k] y - y ⊗ₜ[k] (1 : A)) := by
      rw [tmul_add, add_tmul]
      abel
    rw [this]
    exact add_mem hx hy
  | mul x y _ _ hx hy =>
    have key : (1 : A) ⊗ₜ[k] (x * y) - (x * y) ⊗ₜ[k] (1 : A) =
        ((1 : A) ⊗ₜ[k] x - x ⊗ₜ[k] (1 : A)) * ((1 : A) ⊗ₜ[k] y - y ⊗ₜ[k] (1 : A)) +
          x • ((1 : A) ⊗ₜ[k] y - y ⊗ₜ[k] (1 : A)) +
          y • ((1 : A) ⊗ₜ[k] x - x ⊗ₜ[k] (1 : A)) := by
      simp only [sub_mul, mul_sub, Algebra.TensorProduct.tmul_mul_tmul, smul_sub, smul_tmul',
        smul_eq_mul, mul_one, one_mul]
      rw [mul_comm y x]
      abel
    rw [key]
    refine add_mem (add_mem ?_ (Submodule.smul_mem _ _ hy)) (Submodule.smul_mem _ _ hx)
    apply Submodule.mem_sup_right
    rw [Submodule.restrictScalars_mem, pow_two]
    exact Ideal.mul_mem_mul (KaehlerDifferential.one_smul_sub_smul_one_mem_ideal k x)
      (KaehlerDifferential.one_smul_sub_smul_one_mem_ideal k y)

/-- A left `A`-submodule of `A ⊗[k] A` containing every `1 ⊗ b` is everything. -/
private lemma jetFrame_mem_of_one_tmul_mem (M : Submodule A (A ⊗[k] A))
    (hM : ∀ b : A, (1 : A) ⊗ₜ[k] b ∈ M) (x : A ⊗[k] A) : x ∈ M := by
  induction x using TensorProduct.induction_on with
  | zero => exact zero_mem _
  | tmul a b =>
    have : a ⊗ₜ[k] b = a • ((1 : A) ⊗ₜ[k] b) := by rw [smul_tmul', smul_eq_mul, mul_one]
    rw [this]
    exact M.smul_mem a (hM b)
  | add x y hx hy => exact add_mem hx hy

/-- Specialising the left factor of `A ⊗[k] A` along a `k`-point `ev`: the `k`-algebra map
`a ⊗ b ↦ ev(a) · b`. -/
private noncomputable def jetFrameSpecialize (ev : A →ₐ[k] k) : A ⊗[k] A →ₐ[k] A :=
  Algebra.TensorProduct.productMap ((Algebra.ofId k A).comp ev) (AlgHom.id k A)

private lemma jetFrameSpecialize_tmul (ev : A →ₐ[k] k) (a b : A) :
    jetFrameSpecialize ev (a ⊗ₜ[k] b) = algebraMap k A (ev a) * b := by
  simp [jetFrameSpecialize, Algebra.TensorProduct.productMap_apply_tmul]

private lemma jetFrameSpecialize_smul_one_tmul (ev : A →ₐ[k] k) (a b : A) :
    jetFrameSpecialize ev (a • ((1 : A) ⊗ₜ[k] b)) = algebraMap k A (ev a) * b := by
  rw [smul_tmul', smul_eq_mul, mul_one, jetFrameSpecialize_tmul]

/-- The specialisation along `ev` maps the square of the diagonal ideal into `(ker ev)²`. -/
private lemma jetFrameSpecialize_mem_ker_sq (ev : A →ₐ[k] k) {y : A ⊗[k] A}
    (hy : y ∈ KaehlerDifferential.ideal k A ^ 2) :
    jetFrameSpecialize ev y ∈ RingHom.ker ev ^ 2 := by
  have hcomp : ev.comp (jetFrameSpecialize ev) = ev.comp (Algebra.TensorProduct.lmul' k) :=
    Algebra.TensorProduct.ext' fun a b => by
      simp [jetFrameSpecialize_tmul]
  have hJ : Ideal.map (jetFrameSpecialize ev) (KaehlerDifferential.ideal k A) ≤
      RingHom.ker ev := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker]
    have h1 := congrArg (fun φ : A ⊗[k] A →ₐ[k] k => φ x) hcomp
    simp only [AlgHom.comp_apply] at h1
    rw [h1, RingHom.mem_ker.mp hx, map_zero]
  have := Ideal.mem_map_of_mem (jetFrameSpecialize ev) hy
  rw [Ideal.map_pow] at this
  exact Ideal.pow_right_mono hJ 2 this

/-- **Local frames for first-order jets.** If `g₀, …, gᵣ` span `A / 𝔪₀²` over `k`, where
`𝔪₀ = ker ev₀` is the maximal ideal of a `k`-point, then there is `h ∈ A` not vanishing at
`ev₀` such that for every `f ∈ A` there are `μ₀, …, μᵣ ∈ A` with
`h(ev) · f ≡ ∑ μℓ(ev) · gℓ (mod (ker ev)²)` for every `k`-point `ev`. -/
theorem exists_jet_frame [Algebra.FiniteType k A] (ev₀ : A →ₐ[k] k) {r : ℕ}
    (g : Fin (r + 1) → A)
    (hg : ∀ a : A, ∃ c : Fin (r + 1) → k,
      a - ∑ ℓ, algebraMap k A (c ℓ) * g ℓ ∈ RingHom.ker ev₀ ^ 2) :
    ∃ h : A, ev₀ h ≠ 0 ∧ ∀ f : A, ∃ μ : Fin (r + 1) → A,
      ∀ ev : A →ₐ[k] k,
        ev h • f - ∑ ℓ, algebraMap k A (ev (μ ℓ)) * g ℓ ∈ RingHom.ker ev ^ 2 := by
  classical
  obtain ⟨t, ht⟩ := Algebra.FiniteType.out (R := k) (A := A)
  set J2 : Submodule A (A ⊗[k] A) := ((KaehlerDifferential.ideal k A) ^ 2).restrictScalars A
    with hJ2
  set m₀ : Ideal A := RingHom.ker ev₀ with hm₀
  -- the finitely generated module `N'` which generates modulo `J²`
  set S : Set (A ⊗[k] A) := insert ((1 : A) ⊗ₜ[k] (1 : A))
    ((fun y : A => (1 : A) ⊗ₜ[k] y - y ⊗ₜ[k] (1 : A)) '' (t : Set A)) with hS
  set N' : Submodule A (A ⊗[k] A) := Submodule.span A S with hN'
  have hN'fg : N'.FG :=
    Submodule.fg_span (((Finset.finite_toSet t).image _).insert _)
  have hV : ∀ b : A, (1 : A) ⊗ₜ[k] b ∈ N' ⊔ J2 := by
    intro b
    have hb : b ∈ Algebra.adjoin k (t : Set A) := by rw [ht]; trivial
    have h1 := jetFrame_one_tmul_sub_mem hb
    have hsplit : (1 : A) ⊗ₜ[k] b =
        ((1 : A) ⊗ₜ[k] b - b ⊗ₜ[k] (1 : A)) + b • ((1 : A) ⊗ₜ[k] (1 : A)) := by
      rw [smul_tmul', smul_eq_mul, mul_one, sub_add_cancel]
    rw [hsplit]
    refine add_mem ?_ (Submodule.smul_mem _ _
      (Submodule.mem_sup_left (Submodule.subset_span (Set.mem_insert _ _))))
    refine (sup_le_sup_right ?_ J2) h1
    exact Submodule.span_mono (Set.subset_insert _ _)
  -- the target module `N`
  set N : Submodule A (A ⊗[k] A) :=
    Submodule.span A (Set.range fun ℓ => (1 : A) ⊗ₜ[k] g ℓ) ⊔ J2 with hN
  have hsmul : ∀ p ∈ m₀, ∀ x ∈ N' ⊔ J2, p • x ∈ N ⊔ m₀ • N' := by
    intro p hp x hx
    obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.1 hx
    rw [smul_add]
    exact add_mem (Submodule.mem_sup_right (Submodule.smul_mem_smul hp hu))
      (Submodule.mem_sup_left (Submodule.mem_sup_right (J2.smul_mem p hv)))
  have hJ2le : J2 ≤ N ⊔ m₀ • N' := le_sup_right.trans le_sup_left
  have hsq : ∀ m ∈ m₀ ^ 2, (1 : A) ⊗ₜ[k] m ∈ N ⊔ m₀ • N' := by
    intro m hm
    rw [pow_two] at hm
    induction hm using Submodule.mul_induction_on' with
    | mem_mul_mem p hp q hq =>
      have key : (1 : A) ⊗ₜ[k] (p * q) =
          ((1 : A) ⊗ₜ[k] p - p ⊗ₜ[k] (1 : A)) * ((1 : A) ⊗ₜ[k] q - q ⊗ₜ[k] (1 : A)) +
            p • ((1 : A) ⊗ₜ[k] q) + q • ((1 : A) ⊗ₜ[k] p) -
            (p * q) • ((1 : A) ⊗ₜ[k] (1 : A)) := by
        simp only [sub_mul, mul_sub, Algebra.TensorProduct.tmul_mul_tmul, smul_tmul',
          smul_eq_mul, mul_one, one_mul]
        abel
      rw [key]
      refine sub_mem (add_mem (add_mem (hJ2le ?_) (hsmul p hp _ (hV q)))
        (hsmul q hq _ (hV p))) (hsmul _ (m₀.mul_mem_right q hp) _ (hV 1))
      rw [hJ2, Submodule.restrictScalars_mem, pow_two]
      exact Ideal.mul_mem_mul (KaehlerDifferential.one_smul_sub_smul_one_mem_ideal k p)
        (KaehlerDifferential.one_smul_sub_smul_one_mem_ideal k q)
    | add x _ y _ hx hy =>
      rw [tmul_add]
      exact add_mem hx hy
  have htop : (⊤ : Submodule A (A ⊗[k] A)) ≤ N ⊔ m₀ • N' := by
    intro x _
    refine jetFrame_mem_of_one_tmul_mem _ (fun b => ?_) x
    obtain ⟨c, hc⟩ := hg b
    have hsplit : (1 : A) ⊗ₜ[k] b =
        ∑ ℓ, algebraMap k A (c ℓ) • ((1 : A) ⊗ₜ[k] g ℓ) +
          (1 : A) ⊗ₜ[k] (b - ∑ ℓ, algebraMap k A (c ℓ) * g ℓ) := by
      have hsum : ∑ ℓ, algebraMap k A (c ℓ) • ((1 : A) ⊗ₜ[k] g ℓ) =
          ∑ ℓ, (1 : A) ⊗ₜ[k] (algebraMap k A (c ℓ) * g ℓ) := by
        refine Finset.sum_congr rfl fun ℓ _ => ?_
        rw [smul_tmul', smul_eq_mul, mul_one, ← Algebra.smul_def,
          Algebra.algebraMap_eq_smul_one, smul_tmul]
      rw [tmul_sub, tmul_sum, hsum, add_sub_cancel]
    rw [hsplit]
    refine add_mem (Submodule.mem_sup_left (Submodule.mem_sup_left ?_)) (hsq _ hc)
    exact Submodule.sum_mem _ fun ℓ _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨ℓ, rfl⟩)
  obtain ⟨s, hs1, hsN⟩ :=
    Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hN'fg le_top htop
  refine ⟨s, ?_, fun f => ?_⟩
  · have : ev₀ s - 1 = 0 := by
      have := RingHom.mem_ker.mp hs1
      simpa using this
    rw [sub_eq_zero] at this
    rw [this]
    exact one_ne_zero
  have hf : s • ((1 : A) ⊗ₜ[k] f) ∈ N :=
    hsN (Submodule.smul_mem_pointwise_smul _ s ⊤ trivial)
  obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.1 hf
  obtain ⟨μ, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 hx
  refine ⟨μ, fun ev => ?_⟩
  have hy' : y = s • ((1 : A) ⊗ₜ[k] f) - ∑ ℓ, μ ℓ • ((1 : A) ⊗ₜ[k] g ℓ) := by
    rw [← hxy, add_sub_cancel_left]
  have := jetFrameSpecialize_mem_ker_sq ev (y := y) hy
  rw [hy', map_sub, map_sum, jetFrameSpecialize_smul_one_tmul] at this
  simp only [jetFrameSpecialize_smul_one_tmul] at this
  rwa [Algebra.smul_def]

end Hartshorne.BertiniIncidence
