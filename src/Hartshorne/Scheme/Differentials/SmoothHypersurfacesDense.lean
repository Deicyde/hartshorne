import Hartshorne.Scheme.Differentials.BertiniRegularHyperplaneSection
import Hartshorne.Scheme.ProjectiveClosedImmersionChartCriterion
import Hartshorne.Scheme.VeroneseDuple
import Hartshorne.Scheme.ProjGammaStarReconstruction
import Hartshorne.Scheme.SectionAlgebraSheafComparison
import Hartshorne.Scheme.VeryAmpleHilbertPolynomial
import Hartshorne.Scheme.ProjectiveIntersectionDegreeFormula
import Hartshorne.Scheme.ProjectiveSpaceClassGroup
import Hartshorne.Intersection.ProjectiveIntersectionNonempty
import Hartshorne.Intersection.ProjectiveCodimensionOne

/-!
# Smooth hypersurfaces form a dense open family

Hartshorne, *Algebraic Geometry*, II.8, Example 8.20.2 (p. 183).

Let `k` be algebraically closed, `n ≥ 2` and `d ≥ 1`, and let `ℙⁿ_k = Proj S`,
`S = k[x₀, …, xₙ]`. The degree-`d` hypersurfaces of `ℙⁿ_k` which are nonsingular varieties form
a dense open subset of the complete linear system `|dH|`.

## Model

The complete linear system `|dH|` is the projective space `ℙᴺ_k` of coefficient vectors, where
`N + 1` is the number of monomials `x^{mⱼ}` of degree `d` (enumerated as in the Veronese module):
the closed point `[a]` is the hypersurface `V(f_a)`, `f_a = ∑ⱼ aⱼ x^{mⱼ}`. For `f ∈ S_d` the
hypersurface `V(f)` is the zero scheme of the global section `f` of `𝒪(d)`; on a chart
`D₊(h)`, `h ∈ S_d`, its ideal is generated by `f / h`. A nonsingular variety is a scheme that is
integral with regular local rings; a closed subscheme of `ℙⁿ_k` is automatically separated and of
finite type over `k`.

## Proof

The sections `x^m` of `𝒪(d)` generate it, so they define a morphism `ρ : ℙⁿ_k ⟶ ℙᴺ_k`,
`y_m ↦ x^m`, with `ρ^* 𝒪(1) ≅ 𝒪(d)` (the `d`-uple embedding). The preimage of the hyperplane
`∑ⱼ aⱼ yⱼ = 0` is the zero scheme of `∑ⱼ aⱼ x^{mⱼ}`, that is `V(f_a)`. The morphism `ρ` is a closed
immersion by the chart criterion: on `D₊(x^m)` the ring `S_(x^m)` is generated over `k` by the
ratios `x^{m'} / x^m`, since a monomial of degree `r d` is a product of `r` monomials of degree `d`.
Bertini's theorem for `ρ` gives a dense open `U ⊆ ℙᴺ_k` whose closed points are the `[a]` with
`V(f_a)` regular and not all of `ℙⁿ_k`; the second condition always holds because `f_a ≠ 0`.

It remains to see that a regular `V(f)` is integral. If `f = g h` with `g, h` not units, choose
prime factors `p ∣ g` and `q ∣ h`; they are homogeneous of positive degree, so `V(p)` and `V(q)`
are projective varieties of dimension `n - 1` (Exercise I.2.8), and as `(n - 1) + (n - 1) ≥ n`
they meet at a point `P` (Theorem I.7.2). Writing `f = p w` with `w` homogeneous, both `p` and `w`
vanish at `P`, so near `P` the local equation `f / xᵢ^d = (p / xᵢ^j)(w / xᵢ^l)` lies in `𝔪_P²`
and `V(f)` is singular at `P`. Hence `f` is irreducible, `(f)` is a homogeneous prime, and `V(f)`
is the closure of the point `(f)`, hence irreducible. A regular scheme is reduced, so `V(f)` is
integral.

## Main definitions and results

* `Hartshorne.SmoothHypersurface.hypersurfaceIdeal`: the hypersurface `V(f)` of `f ∈ S_d`.
* `Hartshorne.SmoothHypersurface.hypersurfacePolynomial`: `f_a = ∑ⱼ aⱼ x^{mⱼ}`.
* `Hartshorne.SmoothHypersurface.dupleMorphism`: the `d`-uple morphism `ℙⁿ_k ⟶ ℙᴺ_k`.
* `Hartshorne.SmoothHypersurface.isClosedImmersion_dupleMorphism`: it is a closed immersion.
* `Hartshorne.SmoothHypersurface.hyperplaneSectionIdeal_dupleMorphism`: its hyperplane sections
  are the hypersurfaces `V(f_a)`.
* `Hartshorne.SmoothHypersurface.isIntegral_hypersurface_of_isRegular`: a regular hypersurface of
  `ℙⁿ`, `n ≥ 2`, is integral.
* `Hartshorne.SmoothHypersurface.smooth_hypersurfaces_dense`: the main theorem.
-/

universe u

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace
  HomogeneousLocalization IsLocalRing

namespace Hartshorne

namespace SmoothHypersurface

attribute [local instance] MvPolynomial.gradedAlgebra

open GradedGlobalSections GammaStarReconstruction ProjGradedModuleSheaf

variable {k : Type u} [Field k] {n d : ℕ}

local notation "𝒮" => MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k

local notation "S" => MvPolynomial (Fin (n + 1)) k

/-! ### Degree-`d` hypersurfaces -/

variable (k n d) in
/-- The monomial `x^m` of degree `d` with index `j` (through the enumeration of the
multi-indices of degree `d`), an element of `S_d` for `S = k[x₀, …, xₙ]`. -/
def dupleMonomial (j : Fin (Veronese.dupleN n d + 1)) : 𝒮 d :=
  ⟨MvPolynomial.monomial (Veronese.dupleEquiv n d j).1 1,
    (MvPolynomial.mem_homogeneousSubmodule _ _).2
      (MvPolynomial.isHomogeneous_monomial _ (Veronese.dupleEquiv n d j).2)⟩

/-- The homogeneous polynomial `f_a = ∑ⱼ aⱼ x^{mⱼ}` of degree `d` with coefficient vector `a`,
indexed by the monomials of degree `d`. -/
def hypersurfacePolynomial (a : Fin (Veronese.dupleN n d + 1) → k) : 𝒮 d :=
  ∑ j, a j • dupleMonomial k n d j

variable (k n d) in
/-- The twisting sheaf `𝒪(d)` on `ℙⁿ_k = Proj k[x₀, …, xₙ]` is invertible. -/
theorem isInvertible_twist : (projTwistingSheaf 𝒮 (d : ℤ)).IsInvertible :=
  ProjTwistingSheaf.isInvertible (ProjectiveSpacePicard.adjoin_one_eq_top k n) d

/-- The global section `f / 1` of `𝒪(d)` on `ℙⁿ_k` given by `f ∈ S_d`. -/
def hypersurfaceSection (f : 𝒮 d) : Γ(projTwistingSheaf 𝒮 (d : ℤ), ⊤) :=
  twistSection d f (op ⊤)

/-- **The hypersurface `V(f) ⊆ ℙⁿ_k`** of a homogeneous polynomial `f ∈ S_d`: the zero scheme of
the global section `f` of `𝒪(d)`. On a chart `D₊(h)`, `h ∈ S_d`, its ideal is generated by the
function `f / h`. -/
def hypersurfaceIdeal (f : 𝒮 d) : (Proj 𝒮).IdealSheafData :=
  invertibleZeroIdeal (isInvertible_twist k n d) (hypersurfaceSection f)

/-! ### Local equations -/

/-- On `D₊(h)`, `f / 1 = (f / h) · (h / 1)` for `f, h ∈ S_e`. -/
theorem twistSection_res_eq_ringFrac_smul {e : ℕ} (f h : 𝒮 e) :
    (projTwistingSheaf 𝒮 (e : ℤ)).presheaf.map (homOfLE le_top).op
        (show Γ(projTwistingSheaf 𝒮 (e : ℤ), ⊤) from twistSection e f (op ⊤)) =
      ringFrac e f h • (show Γ(projTwistingSheaf 𝒮 (e : ℤ), Proj.basicOpen 𝒮 (h : S)) from
        twistSection e h (op (Proj.basicOpen 𝒮 (h : S)))) := by
  apply section_ext
  intro x
  rw [twistingSheaf_smul_apply]
  apply HomogeneousLocalizedModule.ext
  rw [HomogeneousLocalizedModule.val_smul]
  change LocalizedModule.mk (f : S) 1 = Localization.mk (f : S) ⟨h, x.2⟩ *
    Localization.mk (h : S) 1
  rw [Localization.mk_mul]
  refine Localization.mk_eq_mk_iff.2 (Localization.r_iff_exists.2 ⟨1, ?_⟩)
  simp only [OneMemClass.coe_one, one_mul, mul_one]
  ring

/-- A point of `V(f)` is a homogeneous prime containing `f`. -/
theorem mem_support_hypersurfaceIdeal_iff (f : 𝒮 d) (x : Proj 𝒮) :
    x ∈ (hypersurfaceIdeal f).support ↔ (f : S) ∈ x.asHomogeneousIdeal := by
  rw [hypersurfaceIdeal, mem_support_invertibleZeroIdeal_iff, hypersurfaceSection,
    mem_nonvanishingLocus_twistSection (ProjectiveSpacePicard.adjoin_one_eq_top k n), not_not]

/-- **The local equation of `V(f)`**: on a chart `D₊(h)`, `h ∈ S_d` with `d > 0`, the ideal of
`V(f)` is generated by the function `f / h`. -/
theorem hypersurfaceIdeal_ideal_basicOpen (hd : 0 < d) (f h : 𝒮 d) :
    (hypersurfaceIdeal f).ideal ⟨Proj.basicOpen 𝒮 (h : S), Proj.isAffineOpen_basicOpen 𝒮 _ h.2 hd⟩ =
      Ideal.span {ringFrac d f h} :=
  invertibleZeroIdeal_ideal_eq_span _ (isTrivializingSection_twistSection h)
    (twistSection_res_eq_ringFrac_smul f h)

/-- Some variable `xᵢ` does not lie in a relevant homogeneous prime. -/
theorem exists_variable_notMem (x : Proj 𝒮) :
    ∃ i, (MvPolynomial.X i : S) ∉ x.asHomogeneousIdeal := by
  obtain ⟨f, hf, hfx⟩ := ProjTwistingSheaf.exists_mem_one_notMem
    (ProjectiveSpacePicard.adjoin_one_eq_top k n) x
  by_contra! h
  refine hfx ?_
  have hle : (𝒮 1 : Submodule k S) ≤ x.asHomogeneousIdeal.toIdeal.restrictScalars k := by
    rw [MvPolynomial.homogeneousSubmodule_one_eq_span_X, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact h i
  exact hle hf

variable (n d) in
/-- The index of the monomial `xᵢ^d`. -/
def powIndex (i : Fin (n + 1)) : Fin (Veronese.dupleN n d + 1) :=
  (Veronese.dupleEquiv n d).symm ⟨Finsupp.single i d, Finsupp.degree_single i d⟩

/-- The monomial with index `powIndex n d i` is `xᵢ^d`. -/
theorem coe_dupleMonomial_powIndex (i : Fin (n + 1)) :
    (dupleMonomial k n d (powIndex n d i) : S) = MvPolynomial.X i ^ d := by
  rw [MvPolynomial.X_pow_eq_monomial]
  simp [dupleMonomial, powIndex]

/-! ### The `d`-uple morphism -/

variable (k n d) in
/-- The global sections `x^m` of `𝒪(d)`, `m` running over the monomials of degree `d`. -/
def dupleSections (j : Fin (Veronese.dupleN n d + 1)) : Γ(projTwistingSheaf 𝒮 (d : ℤ), ⊤) :=
  hypersurfaceSection (dupleMonomial k n d j)

/-- The monomials of degree `d` generate `𝒪(d)`: near a point with `xᵢ ≠ 0`, the section
`xᵢ^d` trivializes `𝒪(d)`. -/
theorem isGeneratedBySections_dupleSections :
    (projTwistingSheaf 𝒮 (d : ℤ)).IsGeneratedBySections
      (fun j : ULift.{u} (Fin (Veronese.dupleN n d + 1)) => dupleSections k n d j.down) := by
  refine isGeneratedBySections_of_forall_isTrivializingSection _ fun x => ?_
  obtain ⟨i, hi⟩ := exists_variable_notMem x
  refine ⟨⟨powIndex n d i⟩, Proj.basicOpen 𝒮 ((dupleMonomial k n d (powIndex n d i) : S)), ?_,
    isTrivializingSection_twistSection _⟩
  change (dupleMonomial k n d (powIndex n d i) : S) ∉ x.asHomogeneousIdeal
  rw [coe_dupleMonomial_powIndex]
  exact fun h => hi (x.isPrime.mem_of_pow_mem d h)

variable (k n d) in
/-- The sections `x^m` of `𝒪(d)` define a morphism `ℙⁿ_k ⟶ ℙᴺ_k` over `k` pulling `𝒪(1)` back to
`𝒪(d)` and the coordinate `y_m` back to `x^m` (Theorem II.7.1). -/
theorem exists_dupleMorphism :
    ∃ φ : Proj 𝒮 ⟶ projectiveSpaceOverScheme (Veronese.dupleN n d) (Spec (.of k)),
      φ ≫ projectiveSpaceOverSchemeProjection _ _ = projectiveSpaceStructureMorphism ∧
      ∃ e : (Scheme.Modules.pullback φ).obj
          (projectiveSpaceTwistingSheaf (Veronese.dupleN n d) (Spec (.of k)) 1) ≅
          projTwistingSheaf 𝒮 (d : ℤ),
        ∀ j, e.hom.app ⊤ (pullbackGlobalSection φ (projectiveSpaceCoordinate _ _ j)) =
          dupleSections k n d j :=
  (existsUnique_morphism_of_isGeneratedBySections projectiveSpaceStructureMorphism
    (isInvertible_twist k n d) (dupleSections k n d) isGeneratedBySections_dupleSections).exists

variable (k n d) in
/-- **The `d`-uple morphism** `ℙⁿ_k ⟶ ℙᴺ_k`, `N + 1` the number of monomials of degree `d`: the
morphism over `k` defined by the sections `x^m` of `𝒪(d)`, that is, `y_m ↦ x^m`. -/
def dupleMorphism : Proj 𝒮 ⟶ projectiveSpaceOverScheme (Veronese.dupleN n d) (Spec (.of k)) :=
  (exists_dupleMorphism k n d).choose

/-- The `d`-uple morphism is a morphism over `k`. -/
theorem dupleMorphism_projection :
    dupleMorphism k n d ≫ projectiveSpaceOverSchemeProjection _ _ =
      projectiveSpaceStructureMorphism :=
  (exists_dupleMorphism k n d).choose_spec.1

/-- The `d`-uple morphism pulls `𝒪(1)` back to `𝒪(d)` and `y_m` back to `x^m`. -/
theorem exists_dupleMorphism_iso :
    ∃ e : (Scheme.Modules.pullback (dupleMorphism k n d)).obj
        (projectiveSpaceTwistingSheaf (Veronese.dupleN n d) (Spec (.of k)) 1) ≅
        projTwistingSheaf 𝒮 (d : ℤ),
      ∀ j, e.hom.app ⊤ (pullbackGlobalSection (dupleMorphism k n d)
        (projectiveSpaceCoordinate _ _ j)) = dupleSections k n d j :=
  (exists_dupleMorphism k n d).choose_spec.2

/-- Constants act on the sections `f / 1` through scalar multiplication of `f`. -/
theorem kConst_smul_hypersurfaceSection (c : k) (f : 𝒮 d) :
    kConst (projectiveSpaceStructureMorphism (k := k) (n := n)) c • hypersurfaceSection f =
      hypersurfaceSection (c • f) := by
  rw [kConst_apply, projectiveSpaceStructureMorphism, Scheme.Hom.comp_appTop,
    CommRingCat.comp_apply, specConst, ← CommRingCat.comp_apply (Scheme.ΓSpecIso _).inv,
    ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
  refine (SectionAlgebraModel.toSpecZero_appTop_smul_twistSection _ d f).trans ?_
  change twistSection d _ (op ⊤) = twistSection d _ (op ⊤)
  congr 2
  rw [Algebra.smul_def]
  rfl

/-- **The hyperplane sections of the `d`-uple morphism are the degree-`d` hypersurfaces**: the
preimage of the hyperplane `∑ⱼ aⱼ yⱼ = 0` is `V(f_a)`, `f_a = ∑ⱼ aⱼ x^{mⱼ}`. -/
theorem hyperplaneSectionIdeal_dupleMorphism (a : Fin (Veronese.dupleN n d + 1) → k) :
    BertiniIncidence.hyperplaneSectionIdeal (dupleMorphism k n d) a =
      hypersurfaceIdeal (hypersurfacePolynomial a) := by
  obtain ⟨e, he⟩ := exists_dupleMorphism_iso (k := k) (n := n) (d := d)
  rw [BertiniIncidence.hyperplaneSectionIdeal_eq, hypersurfaceIdeal,
    ← invertibleZeroIdeal_map_iso _ (isInvertible_twist k n d) e,
    iso_app_linearSection dupleMorphism_projection e he a]
  congr 1
  simp only [dupleSections, kConst_smul_hypersurfaceSection, hypersurfacePolynomial]
  induction (Finset.univ : Finset (Fin (Veronese.dupleN n d + 1))) using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty, hypersurfaceSection]
    exact (SectionAlgebraModel.twistSection_zero d).symm
  | insert j t hj ih =>
    rw [Finset.sum_insert hj, Finset.sum_insert hj, ih, hypersurfaceSection,
      hypersurfaceSection, hypersurfaceSection, SectionAlgebraModel.twistSection_add]
    rfl

/-! ### The `d`-uple morphism is a closed immersion -/

/-- Induction over the homogeneous elements of degree `m`: they are sums of terms `c x^α`
with `|α| = m`. -/
theorem homogeneous_induction {m : ℕ} (P : S → Prop) (h0 : P 0)
    (hadd : ∀ a b, a ∈ 𝒮 m → b ∈ 𝒮 m → P a → P b → P (a + b))
    (hmono : ∀ (α : Fin (n + 1) →₀ ℕ) (c : k), α.degree = m → P (MvPolynomial.monomial α c))
    (a : S) (ha : a ∈ 𝒮 m) : P a := by
  have hdeg : ∀ α ∈ a.support, α.degree = m := fun α hα => by
    by_contra h
    exact (MvPolynomial.mem_support_iff.1 hα)
      (((MvPolynomial.mem_homogeneousSubmodule m a).1 ha).coeff_eq_zero h)
  have key : ∀ t : Finset (Fin (n + 1) →₀ ℕ), t ⊆ a.support →
      (∑ α ∈ t, MvPolynomial.monomial α (MvPolynomial.coeff α a)) ∈ 𝒮 m ∧
        P (∑ α ∈ t, MvPolynomial.monomial α (MvPolynomial.coeff α a)) := by
    intro t
    induction t using Finset.induction_on with
    | empty => exact fun _ => ⟨by simp, by simpa using h0⟩
    | insert α t hα ih =>
      intro hsub
      rw [Finset.sum_insert hα]
      have hαd := hdeg α (hsub (Finset.mem_insert_self α t))
      have hmα : MvPolynomial.monomial α (MvPolynomial.coeff α a) ∈ 𝒮 m :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_monomial _ hαd)
      obtain ⟨h1, h2⟩ := ih ((Finset.subset_insert α t).trans hsub)
      exact ⟨add_mem hmα h1, hadd _ _ hmα h1 (hmono _ _ hαd) h2⟩
  have := (key a.support subset_rfl).2
  rwa [← MvPolynomial.as_sum] at this

/-- `a / g^r + b / g^r = (a + b) / g^r` in `S_(g)`. -/
theorem away_mk_add {e : ℕ} {g : S} (hg : g ∈ 𝒮 e) (r : ℕ) (a b : S) (ha : a ∈ 𝒮 (r • e))
    (hb : b ∈ 𝒮 (r • e)) :
    Away.mk 𝒮 hg r (a + b) (add_mem ha hb) = Away.mk 𝒮 hg r a ha + Away.mk 𝒮 hg r b hb := by
  apply HomogeneousLocalization.val_injective
  simp only [Away.val_mk, HomogeneousLocalization.val_add, Localization.add_mk_self]

/-- `0 / g^r = 0` in `S_(g)`. -/
theorem away_mk_zero {e : ℕ} {g : S} (hg : g ∈ 𝒮 e) (r : ℕ) :
    Away.mk 𝒮 hg r 0 (zero_mem _) = 0 := by
  apply HomogeneousLocalization.val_injective
  simp only [Away.val_mk, HomogeneousLocalization.val_zero, Localization.mk_zero]

/-- **The `d`-uple morphism is a closed immersion** (for `d > 0`). On the chart `X_{x^m} = D₊(x^m)`
the ring `S_(x^m)` is generated over `k` by the ratios `x^{m'} / x^m`, since every monomial of
degree `r d` is a product of `r` monomials of degree `d`. -/
theorem isClosedImmersion_dupleMorphism (hd : 0 < d) :
    IsClosedImmersion (dupleMorphism k n d) := by
  obtain ⟨e, he⟩ := exists_dupleMorphism_iso (k := k) (n := n) (d := d)
  set hL := isInvertible_twist k n d
  set s := dupleSections k n d with hs
  rw [isClosedImmersion_iff_isAffineOpen_and_surjective_chartSectionPolynomialMap hL s
    projectiveSpaceStructureMorphism _ e he dupleMorphism_projection]
  intro i
  set g := dupleMonomial k n d i
  have hV : nonvanishingLocusOpens hL (s i) = Proj.basicOpen 𝒮 (g : S) :=
    Opens.ext (Set.ext fun x =>
      mem_nonvanishingLocus_twistSection (ProjectiveSpacePicard.adjoin_one_eq_top k n) g x)
  refine ⟨hV ▸ Proj.isAffineOpen_basicOpen 𝒮 (g : S) g.2 hd, ?_⟩
  set χ := chartSectionPolynomialMap hL s projectiveSpaceStructureMorphism i
  let ρ := ((Proj 𝒮).presheaf.map (homOfLE hV.ge).op).hom
  have hρ : Function.Injective ρ := by
    intro a b hab
    have h2 := congrArg ((Proj 𝒮).presheaf.map (homOfLE hV.le).op).hom hab
    simp only [ρ, ← CommRingCat.comp_apply, ← Functor.map_comp, ← op_comp, homOfLE_comp,
      homOfLE_refl, op_id] at h2
    simpa using h2
  let R : Subring Γ(Proj 𝒮, Proj.basicOpen 𝒮 (g : S)) := (ρ.comp χ).range
  have hR : ∀ j, ringFrac d (dupleMonomial k n d j) g ∈ R := by
    intro j
    refine ⟨MvPolynomial.X j, ?_⟩
    apply eq_of_smul_eq hL s i hV.ge
    simp only [RingHom.comp_apply, χ, chartSectionPolynomialMap, MvPolynomial.coe_eval₂Hom,
      MvPolynomial.eval₂_X, ρ]
    rw [← restrict_eq_sectionRatio_smul hL s i j hV.ge]
    exact twistSection_res_eq_ringFrac_smul _ _
  have hK : ∀ c : k, ringFrac d (c • g) g ∈ R := by
    intro c
    refine ⟨MvPolynomial.C (specConst k c), ?_⟩
    apply eq_of_smul_eq hL s i hV.ge
    simp only [RingHom.comp_apply, χ, chartSectionPolynomialMap, MvPolynomial.coe_eval₂Hom,
      MvPolynomial.eval₂_C, ρ]
    have hc : ((Proj 𝒮).presheaf.map (homOfLE hV.ge).op).hom
        ((projectiveSpaceStructureMorphism.appLE ⊤ (nonvanishingLocusOpens hL (s i)) le_top).hom
          (specConst k c)) = (Proj 𝒮).presheaf.map (homOfLE le_top).op
            (kConst projectiveSpaceStructureMorphism c) := by
      rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map, kConst_apply, Scheme.Hom.appLE]
      rfl
    rw [hc, ← Scheme.Modules.map_smul, hs, dupleSections, kConst_smul_hypersurfaceSection]
    exact twistSection_res_eq_ringFrac_smul _ _
  let T : Subring (Away 𝒮 (g : S)) := R.comap (Proj.awayToSection 𝒮 (g : S)).hom
  have hT1 : ∀ (a : S) (ha : a ∈ 𝒮 (1 • d)), Away.mk 𝒮 g.2 1 a ha ∈ T := by
    intro a ha
    refine homogeneous_induction (fun a => ∀ ha : a ∈ 𝒮 (1 • d), Away.mk 𝒮 g.2 1 a ha ∈ T)
      (fun _ => by rw [away_mk_zero]; exact zero_mem _)
      (fun a b ha hb Ha Hb _ => by rw [away_mk_add _ _ _ _ ha hb]; exact add_mem (Ha ha) (Hb hb))
      ?_ a ha ha
    intro α c hα hm
    rw [one_smul] at hα
    let j := (Veronese.dupleEquiv n d).symm ⟨α, hα⟩
    have hj : (dupleMonomial k n d j : S) = MvPolynomial.monomial α 1 := by
      simp [dupleMonomial, j]
    have heq : Away.mk 𝒮 g.2 1 (MvPolynomial.monomial α c) hm =
        (HomogeneousLocalization.mk ⟨d, c • g, g, ⟨1, pow_one _⟩⟩ : Away 𝒮 (g : S)) *
          (HomogeneousLocalization.mk ⟨d, dupleMonomial k n d j, g, ⟨1, pow_one _⟩⟩ :
            Away 𝒮 (g : S)) := by
      apply HomogeneousLocalization.val_injective
      simp only [Away.val_mk, HomogeneousLocalization.val_mul, HomogeneousLocalization.val_mk,
        Localization.mk_mul, hj]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul, pow_one, Submodule.coe_smul,
        MvPolynomial.smul_eq_C_mul]
      rw [show MvPolynomial.monomial α c = MvPolynomial.C c * MvPolynomial.monomial α 1 by
        rw [MvPolynomial.C_mul_monomial, mul_one]]
      ring
    rw [heq]
    exact mul_mem (hK c) (hR j)
  have hT : ∀ (r : ℕ) (a : S) (ha : a ∈ 𝒮 (r • d)), Away.mk 𝒮 g.2 r a ha ∈ T := by
    intro r
    induction r with
    | zero =>
      intro a ha
      refine homogeneous_induction (fun a => ∀ ha : a ∈ 𝒮 (0 • d), Away.mk 𝒮 g.2 0 a ha ∈ T)
        (fun _ => by rw [away_mk_zero]; exact zero_mem _)
        (fun a b ha hb Ha Hb _ => by
          rw [away_mk_add _ _ _ _ ha hb]; exact add_mem (Ha ha) (Hb hb)) ?_ a ha ha
      intro α c hα hm
      rw [zero_smul] at hα
      obtain rfl : α = 0 := (Finsupp.degree_eq_zero_iff α).1 hα
      have heq : Away.mk 𝒮 g.2 0 (MvPolynomial.monomial 0 c) hm =
          (HomogeneousLocalization.mk ⟨d, c • g, g, ⟨1, pow_one _⟩⟩ : Away 𝒮 (g : S)) := by
        apply HomogeneousLocalization.val_injective
        simp only [Away.val_mk, HomogeneousLocalization.val_mk]
        rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [OneMemClass.coe_one, one_mul, pow_zero, Submodule.coe_smul,
          MvPolynomial.smul_eq_C_mul, MvPolynomial.monomial_zero']
        ring
      rw [heq]
      exact hK c
    | succ r ih =>
      intro a ha
      refine homogeneous_induction
        (fun a => ∀ ha : a ∈ 𝒮 ((r + 1) • d), Away.mk 𝒮 g.2 (r + 1) a ha ∈ T)
        (fun _ => by rw [away_mk_zero]; exact zero_mem _)
        (fun a b ha hb Ha Hb _ => by
          rw [away_mk_add _ _ _ _ ha hb]; exact add_mem (Ha ha) (Hb hb)) ?_ a ha ha
      intro α c hα hm
      obtain ⟨β, hβα, hβ⟩ := Veronese.exists_le_degree_eq α d
        (by rw [hα, smul_eq_mul]; nlinarith)
      have hγ : (α - β).degree = r • d := by
        have := congrArg Finsupp.degree (add_tsub_cancel_of_le hβα)
        rw [map_add, hβ, hα, smul_eq_mul] at this
        rw [smul_eq_mul]
        rw [add_mul, one_mul] at this
        omega
      have hmβ : MvPolynomial.monomial β c ∈ 𝒮 (1 • d) :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).2
          (MvPolynomial.isHomogeneous_monomial _ (by rw [hβ, one_smul]))
      have hmγ : MvPolynomial.monomial (α - β) (1 : k) ∈ 𝒮 (r • d) :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_monomial _ hγ)
      have heq : Away.mk 𝒮 g.2 (r + 1) (MvPolynomial.monomial α c) hm =
          Away.mk 𝒮 g.2 1 (MvPolynomial.monomial β c) hmβ *
            Away.mk 𝒮 g.2 r (MvPolynomial.monomial (α - β) 1) hmγ := by
        apply HomogeneousLocalization.val_injective
        simp only [Away.val_mk, HomogeneousLocalization.val_mul, Localization.mk_mul]
        congr 1
        · rw [MvPolynomial.monomial_mul, mul_one, add_tsub_cancel_of_le hβα]
        · ext
          simp [pow_succ, mul_comm]
      rw [heq]
      exact mul_mem (hT1 _ _) (ih _ _)
  have hsurj : Function.Surjective (Proj.awayToSection 𝒮 (g : S)).hom := by
    have := (ConcreteCategory.bijective_of_isIso (Proj.basicOpenIsoAway 𝒮 (g : S) g.2 hd).hom).2
    rwa [Proj.basicOpenIsoAway_hom] at this
  intro t
  obtain ⟨z, hz⟩ := hsurj (ρ t)
  obtain ⟨r, a, ha, rfl⟩ := Away.mk_surjective 𝒮 g.2 z
  obtain ⟨y, hy⟩ := hT r a ha
  exact ⟨y, hρ (hy.trans hz)⟩

/-! ### Reducible hypersurfaces are singular -/

/-- If `f = p w` with `p, w` homogeneous and both in the homogeneous prime of `x`, the germ of
the section `f` of `𝒪(d)` at `x` lies in `𝔪ₓ² 𝒪(d)ₓ`: near `x`, `f = (p / xᵢ^j)(w / xᵢ^l) xᵢ^d`
with both fractions in `𝔪ₓ`. -/
theorem germ_mem_maximalIdeal_sq {j l : ℕ} (f : 𝒮 d) (p : 𝒮 j) (w : 𝒮 l) (hjl : j + l = d)
    (hf : (f : S) = p * w) (x : Proj 𝒮) (hp : (p : S) ∈ x.asHomogeneousIdeal)
    (hw : (w : S) ∈ x.asHomogeneousIdeal) :
    (projTwistingSheaf 𝒮 (d : ℤ)).presheaf.germ ⊤ x trivial (hypersurfaceSection f) ∈
      maximalIdeal ((Proj 𝒮).presheaf.stalk x) ^ 2 •
        (⊤ : Submodule ((Proj 𝒮).presheaf.stalk x)
          ((projTwistingSheaf 𝒮 (d : ℤ)).presheaf.stalk x)) := by
  obtain ⟨i, hi⟩ := exists_variable_notMem x
  have hpow : ∀ e : ℕ, (MvPolynomial.X i ^ e : S) ∈ 𝒮 e := fun e =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X_pow i e)
  have hpowx : ∀ e : ℕ, (MvPolynomial.X i ^ e : S) ∉ x.asHomogeneousIdeal := fun e hm =>
    hi (x.isPrime.mem_of_pow_mem e hm)
  let h : 𝒮 d := ⟨MvPolynomial.X i ^ d, hpow d⟩
  have hx : x ∈ Proj.basicOpen 𝒮 (h : S) := hpowx d
  have he := isTrivializingSection_twistSection h
  have hgerm : (projTwistingSheaf 𝒮 (d : ℤ)).presheaf.germ ⊤ x trivial (hypersurfaceSection f) =
      (Proj 𝒮).presheaf.germ _ x hx (ringFrac d f h) •
        (projTwistingSheaf 𝒮 (d : ℤ)).presheaf.germ _ x hx
          (show Γ(projTwistingSheaf 𝒮 (d : ℤ), Proj.basicOpen 𝒮 (h : S)) from
            twistSection d h (op (Proj.basicOpen 𝒮 (h : S)))) := by
    rw [← BertiniIncidence.germ_smul_module, ← twistSection_res_eq_ringFrac_smul f h,
      TopCat.Presheaf.germ_res_apply]
    rfl
  rw [hgerm, BertiniIncidence.smul_germ_mem_smul_top_iff he hx, germ_ringFrac]
  let u : HomogeneousLocalization.AtPrime 𝒮 x.asHomogeneousIdeal.toIdeal :=
    HomogeneousLocalization.mk ⟨j, p, ⟨_, hpow j⟩, hpowx j⟩
  let v : HomogeneousLocalization.AtPrime 𝒮 x.asHomogeneousIdeal.toIdeal :=
    HomogeneousLocalization.mk ⟨l, w, ⟨_, hpow l⟩, hpowx l⟩
  have huv : (HomogeneousLocalization.mk ⟨d, f, h, hx⟩ :
      HomogeneousLocalization.AtPrime 𝒮 x.asHomogeneousIdeal.toIdeal) = u * v := by
    apply HomogeneousLocalization.val_injective
    simp only [u, v, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mul,
      Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul, h, hf, ← hjl, pow_add]
  have hmax : ∀ {e : ℕ} (a : 𝒮 e) (ha : (a : S) ∈ x.asHomogeneousIdeal),
      stalkRingHomInv 𝒮 x (HomogeneousLocalization.mk ⟨e, a, ⟨_, hpow e⟩, hpowx e⟩) ∈
        maximalIdeal ((Proj 𝒮).presheaf.stalk x) := by
    intro e a ha
    rw [mem_maximalIdeal, mem_nonunits_iff]
    change ¬ IsUnit ((stalkRingEquiv 𝒮 x).symm _)
    rw [isUnit_map_iff, isUnit_mk_iff x a ⟨_, hpow e⟩ (hpowx e), not_not]
    exact ha
  rw [huv, map_mul, pow_two]
  exact Ideal.mul_mem_mul (hmax p hp) (hmax w hw)

/-- **A hypersurface `V(p w)` with `V(p) ∩ V(w) ≠ ∅` is singular.** -/
theorem not_isRegular_of_eq_mul {j l : ℕ} (f : 𝒮 d) (hf0 : (f : S) ≠ 0) (p : 𝒮 j) (w : 𝒮 l)
    (hjl : j + l = d) (hf : (f : S) = p * w) (x : Proj 𝒮) (hp : (p : S) ∈ x.asHomogeneousIdeal)
    (hw : (w : S) ∈ x.asHomogeneousIdeal) : ¬ (hypersurfaceIdeal f).subscheme.IsRegular := by
  intro hreg
  have : IsRegularLocalRing ((Proj 𝒮).presheaf.stalk x) := projectiveSpace_isRegular.2 x
  rcases (BertiniIncidence.germ_mem_maximalIdeal_sq_smul_top_iff (isInvertible_twist k n d)
      (hypersurfaceSection f) x).1 (germ_mem_maximalIdeal_sq f p w hjl hf x hp hw) with
    h0 | ⟨z, -, hz⟩
  · have hg : genericPoint (Proj 𝒮) ∈ (hypersurfaceIdeal f).support := by
      rw [hypersurfaceIdeal, mem_support_invertibleZeroIdeal_iff, h0, nonvanishingLocus_zero]
      exact Set.notMem_empty _
    rw [mem_support_hypersurfaceIdeal_iff] at hg
    exact notMem_genericPoint_proj 𝒮 hf0 hg
  · exact hz (hreg.2 z)

/-! ### Two hypersurfaces of `ℙⁿ`, `n ≥ 2`, meet -/

/-- For `n ≥ 1`, a prime `p` never generates an ideal containing the irrelevant ideal: otherwise
`p` would divide both `x₀` and `x₁`, hence be associated to both. -/
theorem not_irrelevant_le_span (hn : 1 ≤ n) {p : S} (hp : Prime p) :
    ¬ (HomogeneousIdeal.irrelevant 𝒮).toIdeal ≤ Ideal.span {p} := by
  intro hle
  have hX : ∀ i, p ∣ (MvPolynomial.X i : S) := fun i => Ideal.mem_span_singleton.1
    (hle (HomogeneousIdeal.mem_irrelevant_of_mem 𝒮 one_pos
      (X_mem_homogeneousSubmodule_one k i)))
  have ha := hp.irreducible.associated_of_dvd MvPolynomial.X_prime.irreducible (hX 0)
  have h01 := ha.symm.dvd.trans (hX ⟨1, by omega⟩)
  rw [MvPolynomial.X_dvd_X] at h01
  exact absurd (congrArg Fin.val h01) (by simp)

/-- The zero set in `ℙⁿ(k)` of a homogeneous prime `p` of positive degree is a projective
variety of dimension `n - 1`. -/
theorem isProjVariety_projDim_projZeroSet [IsAlgClosed k] (hn : 1 ≤ n) {p : S} (hp : Prime p)
    {j : ℕ} (hj : 0 < j) (hhom : p.IsHomogeneous j) :
    IsProjVariety (projZeroSet ({p} : Set S)) ∧
      projDim (projZeroSet ({p} : Set S)) = ((n - 1 : ℕ) : WithBot ℕ∞) := by
  let q : Proj 𝒮 := ⟨⟨Ideal.span {p}, Ideal.homogeneous_span _ _ (by
      rintro _ rfl
      exact ⟨j, (MvPolynomial.mem_homogeneousSubmodule _ _).2 hhom⟩)⟩,
    (Ideal.span_singleton_prime hp.ne_zero).2 hp, not_irrelevant_le_span hn hp⟩
  have hY : IsProjVariety (projZeroSet ({p} : Set S)) := by
    have := (isProjVariety_projZeroSet_asHomogeneousIdeal q).1
    rwa [show (q.asHomogeneousIdeal.toIdeal : Set S) = (Ideal.span {p} : Set S) from rfl,
      projZeroSet_span] at this
  exact ⟨hY, (projective_codimension_one_iff_hypersurface hY (by omega)).2
    ⟨p, j, hj, hhom, hp.irreducible, rfl⟩⟩

/-- A prime factor of a nonzero homogeneous polynomial of degree `d` is homogeneous of some
degree `j` with `0 < j ≤ d`. -/
theorem exists_pos_isHomogeneous_of_prime_dvd {f p : S} (hf : f.IsHomogeneous d) (hf0 : f ≠ 0)
    (hp : Prime p) (hpf : p ∣ f) : ∃ j, 0 < j ∧ j ≤ d ∧ p.IsHomogeneous j := by
  obtain ⟨j, hj⟩ := exists_isHomogeneous_of_prime_dvd hf hf0 hp hpf
  refine ⟨j, Nat.pos_of_ne_zero fun h0 => ?_, ?_, hj⟩
  · subst h0
    have hc := MvPolynomial.totalDegree_eq_zero_iff_eq_C.1 (hj.totalDegree hp.ne_zero)
    refine hp.not_isUnit ?_
    rw [hc]
    refine (MvPolynomial.isUnit_iff_eq_C_of_isReduced).2 ⟨_, ?_, rfl⟩
    exact isUnit_iff_ne_zero.2 fun h => hp.ne_zero (by rw [hc, h, map_zero])
  · obtain ⟨c, hc⟩ := hpf
    rw [hc, mul_comm] at hf hf0
    exact le_of_mul_isHomogeneous hj hf hf0

/-- **A reducible hypersurface of `ℙⁿ`, `n ≥ 2`, has two components meeting at a point.** If a
nonzero homogeneous `f` of degree `d ≥ 1` is not irreducible, then `f = p w` with `p, w`
homogeneous and some point of `ℙⁿ_k` lying on both `V(p)` and `V(w)`: for prime factors `p` of
one factor and `q` of the other, the hypersurfaces `V(p)` and `V(q)` have dimension `n - 1` and
`(n - 1) + (n - 1) ≥ n`, so they meet by the projective dimension theorem. -/
theorem exists_eq_mul_mem_mem [IsAlgClosed k] (hn : 2 ≤ n) (hd : 1 ≤ d) (f : 𝒮 d)
    (hf0 : (f : S) ≠ 0) (hirr : ¬ Irreducible (f : S)) :
    ∃ (j l : ℕ) (p : 𝒮 j) (w : 𝒮 l) (x : Proj 𝒮), j + l = d ∧ (f : S) = p * w ∧
      (p : S) ∈ x.asHomogeneousIdeal ∧ (w : S) ∈ x.asHomogeneousIdeal := by
  have hfh : (f : S).IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule _ _).1 f.2
  have hfu : ¬ IsUnit (f : S) := by
    intro hu
    have := (MvPolynomial.isUnit_iff_totalDegree_of_isReduced.1 hu).2
    rw [hfh.totalDegree hf0] at this
    omega
  obtain ⟨g, h, hgh, hg, hh⟩ : ∃ g h : S, (f : S) = g * h ∧ ¬ IsUnit g ∧ ¬ IsUnit h := by
    by_contra! H
    exact hirr ⟨hfu, fun a b hab => by
      by_contra! H'
      exact H'.2 (H a b hab H'.1)⟩
  have hg0 : g ≠ 0 := fun h0 => hf0 (by rw [hgh, h0, zero_mul])
  have hh0 : h ≠ 0 := fun h0 => hf0 (by rw [hgh, h0, mul_zero])
  obtain ⟨p, hpi, hpg⟩ := WfDvdMonoid.exists_irreducible_factor hg hg0
  obtain ⟨q, hqi, hqh⟩ := WfDvdMonoid.exists_irreducible_factor hh hh0
  have hp := hpi.prime
  have hq := hqi.prime
  obtain ⟨g', rfl⟩ := hpg
  obtain ⟨h', rfl⟩ := hqh
  have hpf : p ∣ (f : S) := ⟨g' * (q * h'), by rw [hgh]; ring⟩
  have hqf : q ∣ (f : S) := ⟨p * g' * h', by rw [hgh]; ring⟩
  obtain ⟨j, hj0, hjd, hpj⟩ := exists_pos_isHomogeneous_of_prime_dvd hfh hf0 hp hpf
  obtain ⟨j', hj'0, -, hqj⟩ := exists_pos_isHomogeneous_of_prime_dvd hfh hf0 hq hqf
  obtain ⟨hYp, hdp⟩ := isProjVariety_projDim_projZeroSet (by omega) hp hj0 hpj
  obtain ⟨hYq, hdq⟩ := isProjVariety_projDim_projZeroSet (by omega) hq hj'0 hqj
  obtain ⟨P, hPp, hPq⟩ := projective_inter_nonempty_of_dim hYp hYq hdp hdq (by omega)
  let x : Proj 𝒮 := VeryAmpleHilbert.classicalPoint P
  have hmem : ∀ {r : S} {e : ℕ}, r.IsHomogeneous e → P ∈ projZeroSet ({r} : Set S) →
      r ∈ x.asHomogeneousIdeal := fun hr hP =>
    (mem_homogeneousVanishingIdeal_singleton_iff hr P).2 (hP _ rfl)
  have hf' : (f : S) = p * (g' * (q * h')) := by rw [hgh]; ring
  have hw0 : g' * (q * h') ∈ x.asHomogeneousIdeal :=
    Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ (hmem hqj hPq))
  refine ⟨j, d - j, ⟨p, (MvPolynomial.mem_homogeneousSubmodule _ _).2 hpj⟩,
    DirectSum.decompose 𝒮 (g' * (q * h')) (d - j), x, by omega, ?_, hmem hpj hPp,
    x.asHomogeneousIdeal.isHomogeneous (d - j) hw0⟩
  calc (f : S) = DirectSum.decompose 𝒮 (f : S) d := (DirectSum.decompose_of_mem_same 𝒮 f.2).symm
    _ = DirectSum.decompose 𝒮 (p * (g' * (q * h'))) (j + (d - j)) := by
      rw [← hf', Nat.add_sub_cancel' hjd]
    _ = p * DirectSum.decompose 𝒮 (g' * (q * h')) (d - j) :=
      DirectSum.coe_decompose_mul_add_of_left_mem 𝒮
        ((MvPolynomial.mem_homogeneousSubmodule _ _).2 hpj)

/-! ### Regular hypersurfaces are integral -/

/-- **A regular hypersurface of `ℙⁿ`, `n ≥ 2`, is integral.** Let `k` be algebraically closed and
`f ≠ 0` homogeneous of degree `d ≥ 1`. If `V(f)` is regular, then `f` is irreducible, since a
factorization `f = p w` gives a point on both `V(p)` and `V(w)` at which `V(f)` is singular. So
`(f)` is a homogeneous prime, `V(f)` is the closure of the point `(f)` of `ℙⁿ_k`, hence irreducible,
and being regular it is reduced. -/
theorem isIntegral_hypersurface_of_isRegular [IsAlgClosed k] (hn : 2 ≤ n) (hd : 1 ≤ d) (f : 𝒮 d)
    (hf0 : (f : S) ≠ 0) (hreg : (hypersurfaceIdeal f).subscheme.IsRegular) :
    IsIntegral (hypersurfaceIdeal f).subscheme := by
  have hirr : Irreducible (f : S) := by
    by_contra hirr
    obtain ⟨j, l, p, w, x, hjl, hf, hp, hw⟩ := exists_eq_mul_mem_mem hn hd f hf0 hirr
    exact not_isRegular_of_eq_mul f hf0 p w hjl hf x hp hw hreg
  have hprime := hirr.prime
  let ξ : Proj 𝒮 := ⟨⟨Ideal.span {(f : S)}, Ideal.homogeneous_span _ _ (by
      rintro _ rfl
      exact ⟨d, f.2⟩)⟩,
    (Ideal.span_singleton_prime hprime.ne_zero).2 hprime, not_irrelevant_le_span (by omega) hprime⟩
  set I := hypersurfaceIdeal f
  have hsupp : (I.support : Set (Proj 𝒮)) = closure {ξ} := by
    ext x
    rw [SetLike.mem_coe, mem_support_hypersurfaceIdeal_iff, ← specializes_iff_mem_closure,
      projectiveSpace_specializes_iff_le]
    constructor
    · intro h
      change Ideal.span {(f : S)} ≤ x.asHomogeneousIdeal.toIdeal
      rwa [Ideal.span_singleton_le_iff_mem]
    · intro h
      exact h (Ideal.mem_span_singleton_self (f : S))
  have hirrsupp : IsIrreducible (Set.range I.subschemeι) := by
    rw [I.range_subschemeι, hsupp]
    exact isIrreducible_singleton.closure
  have : IrreducibleSpace (Set.range I.subschemeι) := Subtype.irreducibleSpace hirrsupp
  have : IrreducibleSpace I.subscheme :=
    let e := I.subschemeι.isClosedEmbedding.isEmbedding.toHomeomorph
    e.symm.surjective.irreducibleSpace e.symm.continuous
  have : ∀ y : I.subscheme, _root_.IsReduced (I.subscheme.presheaf.stalk y) := fun y => by
    have : IsRegularLocalRing (I.subscheme.presheaf.stalk y) := hreg.2 y
    have := RegularLocal.isDomain (I.subscheme.presheaf.stalk y)
    infer_instance
  have : IsReduced I.subscheme := isReduced_of_isReduced_stalk _
  exact isIntegral_of_irreducibleSpace_of_isReduced _

/-! ### The main theorem -/

/-- The coefficient of the monomial `x^{mⱼ}` in `f_a` is `aⱼ`. -/
theorem coeff_hypersurfacePolynomial (a : Fin (Veronese.dupleN n d + 1) → k)
    (j : Fin (Veronese.dupleN n d + 1)) :
    MvPolynomial.coeff (Veronese.dupleEquiv n d j).1 (hypersurfacePolynomial a : S) = a j := by
  classical
  simp only [hypersurfacePolynomial, dupleMonomial, Submodule.coe_sum, Submodule.coe_smul,
    MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, MvPolynomial.coeff_monomial]
  rw [Finset.sum_eq_single j]
  · simp
  · intro b _ hb
    rw [if_neg (Subtype.val_injective.ne ((Veronese.dupleEquiv n d).injective.ne hb)),
      smul_zero]
  · simp

/-- `f_a ≠ 0` for `a ≠ 0`. -/
theorem hypersurfacePolynomial_ne_zero {a : Fin (Veronese.dupleN n d + 1) → k} (ha : a ≠ 0) :
    (hypersurfacePolynomial a : S) ≠ 0 := by
  intro h
  refine ha (funext fun j => ?_)
  rw [Pi.zero_apply, ← coeff_hypersurfacePolynomial a j, h, MvPolynomial.coeff_zero]

/-- **Smooth hypersurfaces form a dense open family** (Hartshorne II, Example 8.20.2). Let `k` be
algebraically closed, `n ≥ 2` and `d ≥ 1`. The complete linear system `|dH|` of degree-`d`
hypersurfaces of `ℙⁿ_k = Proj k[x₀, …, xₙ]` is the projective space `ℙᴺ_k` of coefficient
vectors, with coordinates indexed by the `N + 1` monomials `x^{mⱼ}` of degree `d`: a closed point
`H` represents the vectors `a ≠ 0` with `H = [a]`, and the corresponding hypersurface is
`V(f_a) ⊆ ℙⁿ_k`, the zero scheme of the section `f_a = ∑ⱼ aⱼ x^{mⱼ}` of `𝒪(d)`. Then there is a
dense open subset `U ⊆ ℙᴺ_k` whose closed points are exactly the `[a]` for which `V(f_a)` is a
nonsingular variety, i.e. integral with regular local rings (as a closed subscheme of `ℙⁿ_k` it
is automatically separated and of finite type over `k`).

The `d`-uple morphism `ℙⁿ_k ⟶ ℙᴺ_k`, `y_m ↦ x^m`, is a closed immersion whose hyperplane sections
are the hypersurfaces `V(f_a)`, so Bertini's theorem gives `U`, the locus where `V(f_a)` is regular
(it is never all of `ℙⁿ_k`, as `f_a ≠ 0`). A regular `V(f_a)` is integral, since `n ≥ 2`. -/
theorem smooth_hypersurfaces_dense [IsAlgClosed k] (hn : 2 ≤ n) (hd : 1 ≤ d) :
    ∃ U : Set (projectiveSpaceScheme k (Veronese.dupleN n d)), IsOpen U ∧ Dense U ∧
      ∀ H : projectiveSpaceScheme k (Veronese.dupleN n d), IsClosed {H} →
        ∀ a : Fin (Veronese.dupleN n d + 1) → k, a ≠ 0 → BertiniIncidence.Represents a H →
          (H ∈ U ↔ (hypersurfaceIdeal (hypersurfacePolynomial a)).subscheme.IsRegular ∧
            IsIntegral (hypersurfaceIdeal (hypersurfacePolynomial a)).subscheme) := by
  have : IsClosedImmersion (dupleMorphism k n d) := isClosedImmersion_dupleMorphism (by omega)
  obtain ⟨U, hUo, hUd, hU⟩ := BertiniIncidence.bertini_regular_hyperplane_section
    (dupleMorphism k n d) projectiveSpace_isRegular
  refine ⟨U, hUo, hUd, fun H hH a ha hra => ?_⟩
  rw [hU H hH a ha hra, hyperplaneSectionIdeal_dupleMorphism]
  have hf0 := hypersurfacePolynomial_ne_zero ha
  constructor
  · rintro ⟨-, hreg⟩
    exact ⟨hreg, isIntegral_hypersurface_of_isRegular hn hd _ hf0 hreg⟩
  · rintro ⟨hreg, -⟩
    refine ⟨⟨genericPoint (Proj 𝒮), ?_⟩, hreg⟩
    rw [mem_support_hypersurfaceIdeal_iff]
    exact notMem_genericPoint_proj 𝒮 hf0

end SmoothHypersurface

end Hartshorne
