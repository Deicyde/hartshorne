/-!
# The conormal bundle of a nonsingular closed subvariety

Hartshorne, *Algebraic Geometry*, II, Theorem 8.17 (pp. 178–179), forward direction.

Let `X` be a nonsingular variety over an algebraically closed field `k`, of dimension `n`, and let
`i : Y ⟶ X` be an irreducible closed subscheme which is nonsingular, of codimension `r`. Then the
conormal sequence `0 ⟶ i^* I ⟶ i^* Ω_{X/k} ⟶ Ω_{Y/k} ⟶ 0` is short exact and the conormal sheaf
`i^* I` (whose pushforward is `I/I²`) is locally free of rank `r`
(`Hartshorne.NonsingularConormal.shortExact_conormal_and_isLocallyFreeOfRank`). At every point
`y ∈ Y` the stalk of the ideal sheaf, the kernel of `𝒪_{X,y} → 𝒪_{Y,y}`, is generated by `r`
elements (`Hartshorne.NonsingularConormal.ker_stalkMap_eq_span`).

## Proof

By Theorem 8.15, `Ω_{X/k}` and `Ω_{Y/k}` are locally free of ranks `n` and `q = dim Y`, and
`n = q + r` (Exercise II.3.20). The conormal sequence of Proposition 8.12 is right exact; we work
on stalks at a point `y ∈ Y`, with `A = 𝒪_{X,y}` and `B = 𝒪_{Y,y}`.

* Both local rings are regular and `dim A = dim B + r`
  (`NonsingularConormal.ringKrullDim_stalk_eq_add_codim`): one inequality holds for every closed
  subscheme, and the other comes from the height–coheight formula on the varieties `X` and `Y`.
* Choosing elements of `ker (A → B)` whose classes form a basis of its image in `𝔪_A/𝔪_A²`, the
  quotient of `A` by them is regular of dimension `dim A` minus their number, hence a domain, and
  comparing dimensions shows that they generate the kernel and that there are `r` of them
  (`NonsingularConormal.exists_ker_eq_span`). This is the local form of Hartshorne's argument with
  the auxiliary subscheme `Y'` cut out by `r` local equations.
* Hence the stalk of `i^* I`, which is `B ⊗_A I_y`, is generated by `r` elements. It surjects onto
  the kernel of the map of free modules `B^n → B^q`, which is free of rank `r`, so the surjection
  is an isomorphism (`NonsingularConormal.injective_and_free_of_exact`).
* Injectivity on all stalks gives a monomorphism (`NonsingularConormal.mono_of_injective_stalk`),
  and freeness of rank `r` of all stalks of the coherent sheaf `i^* I` on the reduced scheme `Y`
  gives local freeness of rank `r` (Exercise II.5.8(c)).
-/

universe u v w

open IsLocalRing Ideal Module
open scoped TensorProduct ChangeOfRings

namespace Hartshorne

namespace NonsingularConormal

section Algebra

variable {B : Type u} [CommRing B] [IsLocalRing B] {C : Type v} {E : Type w} {F : Type w}
  [AddCommGroup C] [Module B C] [AddCommGroup E] [Module B E] [AddCommGroup F] [Module B F]

/-- Let `C → E → F → 0` be an exact sequence of modules over a local ring `B`, with `E` free of
rank `n`, `F` free of rank `q`, and `C` generated by `r = n - q` elements. Then `C → E` is
injective and `C` is free of rank `r`. The kernel of `E → F` is a direct summand of `E`, hence free
of rank `r`; the composite `B^r → C → ker` is a surjective endomorphism of `B^r`, hence
bijective. -/
theorem injective_and_free_of_exact (g : C →ₗ[B] E) (h : E →ₗ[B] F) (hex : Function.Exact g h)
    (hh : Function.Surjective h) {n q r : ℕ} (eE : E ≃ₗ[B] (Fin n → B))
    (eF : F ≃ₗ[B] (Fin q → B)) (hn : n = q + r) (v : Fin r → C)
    (hv : Submodule.span B (Set.range v) = ⊤) :
    Function.Injective g ∧ Nonempty (C ≃ₗ[B] (Fin r → B)) := by
  have : Module.Free B F := Module.Free.of_equiv eF.symm
  have : Module.Free B E := Module.Free.of_equiv eE.symm
  have : Module.Finite B F := Module.Finite.equiv eF.symm
  have : Module.Finite B E := Module.Finite.equiv eE.symm
  let K := LinearMap.ker h
  obtain ⟨s, hs⟩ := Module.projective_lifting_property h LinearMap.id hh
  obtain ⟨e, hf, -⟩ := (h.exact_subtype_ker_map.splitSurjectiveEquiv
    (Submodule.injective_subtype K)) ⟨s, hs⟩
  have hek : ∀ k : K, e k = (k, 0) := fun k => by
    have : (k : E) = e.symm (k, 0) := LinearMap.congr_fun hf k
    rw [this, LinearEquiv.apply_symm_apply]
  -- `K` is a direct summand of `E`, hence finite projective, hence free
  have : Module.Finite B K :=
    Module.Finite.of_surjective ((LinearMap.fst B K F).comp e.toLinearMap)
      (fun k => ⟨k, by simp [hek]⟩)
  have : Module.Projective B K :=
    Module.Projective.of_split K.subtype ((LinearMap.fst B K F).comp e.toLinearMap)
      (by ext k; simp [hek])
  have : Module.Free B K := Module.free_of_flat_of_isLocalRing
  have hrank : finrank B K = r := by
    have h1 : finrank B E = finrank B (K × F) := e.finrank_eq
    rw [Module.finrank_prod, eE.finrank_eq, eF.finrank_eq, Module.finrank_fin_fun,
      Module.finrank_fin_fun, hn] at h1
    omega
  let eK : K ≃ₗ[B] (Fin r → B) := (Module.finBasisOfFinrankEq B K hrank).equivFun
  let g' : C →ₗ[B] K := g.codRestrict K fun c => hex.apply_apply_eq_zero c
  have hg' : Function.Surjective g' := by
    rintro ⟨x, hx⟩
    obtain ⟨c, rfl⟩ := (hex x).mp hx
    exact ⟨c, rfl⟩
  let φ : (Fin r → B) →ₗ[B] C := Fintype.linearCombination B v
  have hφ : Function.Surjective φ := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hv]
  let ψ : (Fin r → B) →ₗ[B] (Fin r → B) := eK.toLinearMap ∘ₗ g' ∘ₗ φ
  have hψ : Function.Injective ψ :=
    OrzechProperty.injective_of_surjective_endomorphism ψ
      (eK.surjective.comp (hg'.comp hφ))
  have hφi : Function.Injective φ := fun a b hab => hψ (by simp [ψ, hab])
  refine ⟨fun c c' hcc => ?_, ⟨(LinearEquiv.ofBijective φ ⟨hφi, hφ⟩).symm⟩⟩
  obtain ⟨a, rfl⟩ := hφ c
  obtain ⟨a', rfl⟩ := hφ c'
  have : g' (φ a) = g' (φ a') := Subtype.ext hcc
  exact congrArg φ (hψ (by simp [ψ, this]))

end Algebra

section RegularQuotient

variable {A : Type u} [CommRing A] [IsRegularLocalRing A] {B : Type u} [CommRing B]
  [IsRegularLocalRing B]

/-- The cotangent space of `A` is spanned by the classes of the elements of `ker ρ` together with
lifts of generators of the maximal ideal of `B`: for a local surjection `ρ : A → B`,
`dim_κ 𝔪_A/𝔪_A² ≤ dim (image of ker ρ in 𝔪_A/𝔪_A²) + μ(𝔪_B)`. -/
theorem finrank_cotangentSpace_le (ρ : A →+* B) (hρ : Function.Surjective ρ)
    (b : Set (CotangentSpace A))
    (hb : Submodule.span (ResidueField A) b = Submodule.span (ResidueField A)
      ((maximalIdeal A).toCotangent '' {x | (x : A) ∈ RingHom.ker ρ})) [Fintype b] :
    finrank (ResidueField A) (CotangentSpace A) ≤
      Fintype.card b + (maximalIdeal B).spanFinrank := by
  classical
  set m := maximalIdeal A
  have hcomap : (maximalIdeal B).comap ρ = m :=
    IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective ρ hρ)
  obtain ⟨t, ht, htspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal B)).exists_span_set_encard_eq_spanFinrank
  have htfin : t.Finite := Set.finite_of_encard_eq_coe ht
  have htm : ∀ y ∈ t, y ∈ maximalIdeal B := fun y hy => htspan ▸ Submodule.subset_span hy
  have hlift : ∀ y : t, ∃ a : m, ρ a = y := fun y => by
    obtain ⟨a, ha⟩ := hρ y
    exact ⟨⟨a, by rw [← hcomap, Ideal.mem_comap, ha]; exact htm _ y.2⟩, ha⟩
  choose g hg using hlift
  have : Fintype t := htfin.fintype
  set s0 : Set m := {x | (x : A) ∈ RingHom.ker ρ}
  -- `ker ρ` and the lifts `g` span `𝔪_A`
  have hspan : Submodule.span A (s0 ∪ Set.range g) = ⊤ := by
    apply Submodule.map_injective_of_injective m.injective_subtype
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype]
    refine le_antisymm (Submodule.span_le.mpr ?_) fun x hx => ?_
    · rintro _ ⟨y, -, rfl⟩
      exact y.2
    have hρx : ρ x ∈ (Ideal.span (Set.range fun y => (g y : A))).map ρ := by
      rw [Ideal.map_span, ← Set.range_comp]
      have : (ρ ∘ fun y => (g y : A)) = fun y : t => (y : B) := funext hg
      rw [this, Subtype.range_coe]
      change ρ x ∈ Submodule.span B t
      rw [htspan]
      rw [← hcomap] at hx
      exact hx
    rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective _ hρ] at hρx
    refine (show Ideal.span (Set.range fun y => (g y : A)) ⊔ Ideal.comap ρ ⊥ ≤
        Submodule.span A (Subtype.val '' (s0 ∪ Set.range g)) from
      sup_le (Ideal.span_le.mpr ?_) (fun z hz => ?_)) hρx
    · rintro _ ⟨y, rfl⟩
      exact Submodule.subset_span ⟨g y, Or.inr ⟨y, rfl⟩, rfl⟩
    · have hzm : z ∈ m := by
        rw [← hcomap, Ideal.mem_comap, (Ideal.mem_bot.mp hz)]
        exact zero_mem _
      exact Submodule.subset_span ⟨⟨z, hzm⟩, Or.inl hz, rfl⟩
  have htop : Submodule.span (ResidueField A) (Set.range
      (Sum.elim ((↑) : b → CotangentSpace A) (fun y => m.toCotangent (g y)))) = ⊤ := by
    rw [Set.Sum.elim_range, Subtype.range_coe, Submodule.span_union, hb, ← Submodule.span_union,
      Set.range_comp', ← Set.image_union]
    exact CotangentSpace.span_image_eq_top_iff.mpr hspan
  have hcard : (Fintype.card t : ℕ∞) = (maximalIdeal B).spanFinrank := by
    rw [← ht, Set.encard_eq_coe_toFinset_card, Set.toFinset_card]
  calc finrank (ResidueField A) (CotangentSpace A)
      = finrank (ResidueField A) (⊤ : Submodule (ResidueField A) (CotangentSpace A)) :=
        (finrank_top _ _).symm
    _ ≤ Fintype.card (b ⊕ t) := htop ▸ finrank_range_le_card _
    _ = Fintype.card b + (maximalIdeal B).spanFinrank := by
        rw [Fintype.card_sum]
        exact_mod_cast congrArg (Fintype.card b + ·) (by exact_mod_cast hcard)

/-- **Hartshorne II, Theorem 8.17, local step.** Let `ρ : A → B` be a surjection of regular local
rings with `dim A = dim B + c`. Then `ker ρ` is generated by `c` elements. Choose `f₁, …, f_s` in
`ker ρ` whose classes form a basis of the image of `ker ρ` in `𝔪_A/𝔪_A²`. Then `s ≥ c`, and
`A/(f)` is regular of dimension `dim A - s`, hence a domain. The surjection `A/(f) → B` has a
prime kernel; a nonzero prime would drop the dimension below `dim B`, so `ker ρ = (f)` and
`s = c`. -/
theorem exists_ker_eq_span (ρ : A →+* B) (hρ : Function.Surjective ρ) (c : ℕ)
    (hdim : ringKrullDim A = ringKrullDim B + c) :
    ∃ f : Fin c → A, RingHom.ker ρ = Ideal.span (Set.range f) := by
  classical
  set m := maximalIdeal A
  set S := m.toCotangent '' {x : m | (x : A) ∈ RingHom.ker ρ}
  obtain ⟨b, hbS, hbspan, hbli⟩ := exists_linearIndependent (ResidueField A) S
  have : Finite b := hbli.finite
  have : Fintype b := Fintype.ofFinite b
  have hbound := finrank_cotangentSpace_le ρ hρ b hbspan
  have hl : ∀ v : b, ∃ x : m, (x : A) ∈ RingHom.ker ρ ∧ m.toCotangent x = v := fun v => by
    obtain ⟨x, hx, hxv⟩ := hbS v.2
    exact ⟨x, hx, hxv⟩
  choose f hfker hfv using hl
  have hli : LinearIndependent (ResidueField A) (fun i => m.toCotangent (f i)) := by
    simpa [hfv] using hbli
  set J := Ideal.span (Set.range fun i => (f i : A))
  have hreg : IsRegularLocalRing (A ⧸ J) :=
    isRegularLocalRing_quotient_span_range_of_linearIndependent f hli
  have hdimJ := ringKrullDim_quotient_span_range_add_card_of_linearIndependent f hli
  have hJI : J ≤ RingHom.ker ρ := Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hfker i)
  let ρ' : A ⧸ J →+* B := Ideal.Quotient.lift J ρ (fun a ha => hJI ha)
  have hρ' : Function.Surjective ρ' := fun y => by
    obtain ⟨a, rfl⟩ := hρ y
    exact ⟨Ideal.Quotient.mk J a, rfl⟩
  have eB := IsRegularLocalRing.spanFinrank_maximalIdeal (R := B)
  have eJ := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A ⧸ J)
  have hfr := (IsRegularLocalRing.iff_finrank_cotangentSpace A).mp inferInstance
  set d := finrank (ResidueField A) (CotangentSpace A)
  set e := (maximalIdeal B).spanFinrank
  set r' := (maximalIdeal (A ⧸ J)).spanFinrank
  have hde : d = e + c := by
    rw [← hfr, ← eB] at hdim
    exact_mod_cast hdim
  have hdJ : r' + Fintype.card b = d := by
    rw [← eJ, ← hfr] at hdimJ
    exact_mod_cast hdimJ
  have hinj : Function.Injective ρ' := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hne
    have : IsDomain (A ⧸ J) := RegularLocal.isDomain _
    have hnzd : x ∈ nonZeroDivisors (A ⧸ J) := mem_nonZeroDivisors_of_ne_zero hne
    have h1 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hnzd
    let ρ'' : (A ⧸ J) ⧸ Ideal.span {x} →+* B := Ideal.Quotient.lift _ ρ' (fun a ha => by
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp [hx])
    have h2 := ringKrullDim_le_of_surjective ρ'' (fun y => by
      obtain ⟨a, rfl⟩ := hρ' y
      exact ⟨Ideal.Quotient.mk _ a, rfl⟩)
    have h3 : (e : WithBot ℕ∞) + 1 ≤ r' := by
      rw [eB, eJ]
      exact (add_le_add_left h2 1).trans h1
    have h4 : e + 1 ≤ r' := by exact_mod_cast h3
    omega
  have hker : RingHom.ker ρ = J := le_antisymm (fun a ha => by
      have h0 : ρ' (Ideal.Quotient.mk J a) = 0 := ha
      exact Ideal.Quotient.eq_zero_iff_mem.mp (hinj (h0.trans (map_zero ρ').symm))) hJI
  have hdimeq : ringKrullDim (A ⧸ J) = ringKrullDim B :=
    ringKrullDim_eq_of_ringEquiv (RingEquiv.ofBijective ρ' ⟨hinj, hρ'⟩)
  have hre : r' = e := by
    rw [← eJ, ← eB] at hdimeq
    exact_mod_cast hdimeq
  have hc : Fintype.card b = c := by omega
  refine ⟨fun i => (f ((Fintype.equivFinOfCardEq hc).symm i) : A), ?_⟩
  rw [hker]
  exact congrArg Ideal.span
    (EquivLike.range_comp (fun i => (f i : A)) (Fintype.equivFinOfCardEq hc).symm).symm

end RegularQuotient

section Dimension

open CategoryTheory AlgebraicGeometry Order

variable {k : Type u} [Field k] {X Y : Scheme.{u}}

/-- On an integral scheme of finite type over a field of dimension `n`, the height and the
coheight of a point (for the specialization order) add up to `n`. -/
theorem height_add_coheight_point (p : X ⟶ Spec (.of k)) [IsIntegral X] (hp : FiniteType p)
    (x : X) : (((height x + coheight x : ℕ∞)) : WithBot ℕ∞) = topologicalKrullDim X := by
  let e : TopologicalSpace.IrreducibleCloseds X ≃o X := irreducibleSetEquivPoints
  rw [← DimensionCodimension.height_add_coheight p hp (e.symm x), height_orderIso e.symm x,
    coheight_orderIso e.symm x]

/-- For an integral closed subscheme `Y` of codimension `r` of an integral scheme `X` of finite
type over a field, `dim 𝒪_{X,y} = dim 𝒪_{Y,y} + r` at every point `y` of `Y`. -/
theorem ringKrullDim_stalk_eq_add_codim (p : X ⟶ Spec (.of k)) [IsIntegral X] (hp : FiniteType p)
    {n : ℕ} (hn : topologicalKrullDim X = n) (i : Y ⟶ X) [IsClosedImmersion i] [IsIntegral Y]
    (r : ℕ) (hr : codim (Set.range i.base) = r) (y : Y) :
    ringKrullDim (X.presheaf.stalk (i y)) = ringKrullDim (Y.presheaf.stalk y) + r := by
  have := hp.1
  have := hp.2
  have hp' : FiniteType (i ≫ p) := ⟨inferInstance, inferInstance⟩
  have hle := LCICohenMacaulay.ringKrullDim_stalk_add_codim_le i y
  rw [hr] at hle
  refine le_antisymm ?_ hle
  have hX := height_add_coheight_point p hp (i y)
  have hY := height_add_coheight_point (i ≫ p) hp' y
  have hdc := dimension_codimension_formula p hp (Set.range i.base)
    i.isClosedEmbedding.isClosed_range (Set.range_nonempty_iff_nonempty.mpr ⟨y⟩)
  rw [← IsHomeomorph.topologicalKrullDim_eq _
    (i.isClosedEmbedding.toHomeomorph).isHomeomorph, hr, hn, ← hY] at hdc
  rw [hn] at hX
  have hh := height_le_height_apply_of_strictMono _
    (LCICohenMacaulay.strictMono_of_isClosedImmersion i) y
  rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight]
  have h1 : height (i y) + coheight (i y) = (n : ℕ∞) := by exact_mod_cast hX
  have h2 : height y + coheight y + r = (n : ℕ∞) := by exact_mod_cast hdc
  suffices coheight (i y) ≤ coheight y + r by exact_mod_cast this
  generalize height (i y) = a at h1 hh
  generalize coheight (i y) = b at h1 ⊢
  generalize height y = c at h2 hh
  generalize coheight y = d at h2 ⊢
  lift a to ℕ using (by rintro rfl; simp at h1)
  lift b to ℕ using (by rintro rfl; simp at h1)
  lift c to ℕ using (by rintro rfl; simp at h2)
  lift d to ℕ using (by rintro rfl; simp at h2)
  norm_cast at h1 h2 hh ⊢
  omega

end Dimension

section Stalks

open CategoryTheory Limits TopologicalSpace Opposite Ringed ModuleSheafTensor

variable {X : TopCat.{u}} {R : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}

/-- A morphism of sheaves of modules on a ringed space is a monomorphism if it is injective on
all stalks. -/
theorem mono_of_injective_stalk {M N : SheafOfModules.{u} (ringCatSheafOf R)} (φ : M ⟶ N)
    (h : ∀ x : X, Function.Injective ((moduleStalkFunctor (R := R) x).map φ)) : Mono φ := by
  have happ : ∀ U : (Opens X)ᵒᵖ,
      Function.Injective (((PresheafOfModules.toPresheaf _).map φ.val).app U) := fun U =>
    TopCat.Presheaf.app_injective_of_stalkFunctor_map_injective (C := AddCommGrpCat.{u})
      (F := ⟨M.val.presheaf, M.isSheaf⟩) ((PresheafOfModules.toPresheaf _).map φ.val) U.unop
      (fun x _ => h x)
  have h1 : Mono ((PresheafOfModules.toPresheaf _).map φ.val) := by
    have : ∀ U, Mono (((PresheafOfModules.toPresheaf _).map φ.val).app U) := fun U =>
      (AddCommGrpCat.mono_iff_injective _).mpr (happ U)
    exact NatTrans.mono_of_mono_app _
  have h2 : Mono φ.val := (PresheafOfModules.toPresheaf _).mono_of_mono_map h1
  exact (SheafOfModules.forget _).mono_of_mono_map h2

/-- The stalk functor of a ringed space is right exact: it takes a right exact sequence
`M₁ ⟶ M₂ ⟶ M₃ ⟶ 0` of sheaves of modules to a right exact sequence of modules over the local
ring, since it is a left adjoint (of the skyscraper functor). -/
theorem stalk_exact_and_surjective (S : ShortComplex (SheafOfModules.{u} (ringCatSheafOf R)))
    (hS : S.Exact) (hg : Epi S.g) (x : X) :
    Function.Exact ((moduleStalkFunctor (R := R) x).map S.f)
        ((moduleStalkFunctor (R := R) x).map S.g) ∧
      Function.Surjective ((moduleStalkFunctor (R := R) x).map S.g) := by
  have hadj := moduleStalkSkyscraperAdjunction (R := R) x
  have : (moduleStalkFunctor (R := R) x).IsLeftAdjoint := hadj.isLeftAdjoint
  have hex := hS.map_of_epi_of_preservesCokernel (moduleStalkFunctor (R := R) x) hg
    inferInstance
  refine ⟨(ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mp hex, ?_⟩
  exact (ModuleCat.epi_iff_surjective _).mp inferInstance

end Stalks

section LocallyFreeStalk

open AlgebraicGeometry

/-- The stalks of a module sheaf on a scheme that is locally free of rank `n` are free of
rank `n`. -/
theorem nonempty_stalk_equiv_of_isLocallyFreeOfRank {X : Scheme.{u}} (F : X.Modules) (n : ℕ)
    (hF : F.IsLocallyFreeOfRank n) (x : X) :
    Nonempty (F.presheaf.stalk x ≃ₗ[X.presheaf.stalk x] (Fin n → X.presheaf.stalk x)) := by
  obtain ⟨U, hxU, ⟨α⟩⟩ := hF x
  have hLF : F.IsLocallyFree := fun z => by
    obtain ⟨V, hzV, ⟨β⟩⟩ := hF z
    exact ⟨V, hzV, _, ⟨β⟩⟩
  have : Module.Free (X.presheaf.stalk x) (F.presheaf.stalk x) :=
    free_stalk_of_isLocallyFree F hLF x
  have hrank : Module.rank (ResidueField (X.presheaf.stalk x))
      (ResidueField (X.presheaf.stalk x) ⊗[X.presheaf.stalk x] F.presheaf.stalk x) =
        Cardinal.mk (ULift.{u} (Fin n)) := rank_fibre_of_restrict_iso_free F α hxU
  rw [Module.rank_baseChange, Cardinal.mk_uLift, Cardinal.mk_fintype, Fintype.card_fin] at hrank
  have hr : Module.rank (X.presheaf.stalk x) (F.presheaf.stalk x) = n := by
    simpa using hrank
  have := Module.finite_of_rank_eq_nat hr
  exact ⟨(Module.finBasisOfFinrankEq _ _ (Module.finrank_eq_of_rank_eq hr)).equivFun⟩

end LocallyFreeStalk

section ExtendScalars

open scoped ChangeOfRings

/-- If `v` generates an `R`-module `M`, then the elements `1 ⊗ v j` generate `S ⊗_R M` over `S`. -/
theorem span_extendScalars_eq_top {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
    (M : ModuleCat.{u} R) {ι : Type*} (v : ι → M)
    (hv : Submodule.span R (Set.range v) = ⊤) :
    Submodule.span S (Set.range fun j =>
      (show ((ModuleCat.extendScalars f).obj M : Type u) from (1 : S) ⊗ₜ[R,f] v j)) = ⊤ := by
  let N := (ModuleCat.extendScalars f).obj M
  let u := ModuleCat.ExtendRestrictScalarsAdj.Unit.map f (X := M)
  let φ : M →+ N := u.hom.toAddMonoidHom
  have hφ : ∀ (b : R) (m : M), φ (b • m) = f b • φ m := fun b m =>
    u.hom.map_smul b m
  rw [eq_top_iff]
  rintro z -
  induction z using TensorProduct.induction_on with
  | zero => exact zero_mem _
  | tmul s m =>
    have hm := LCICohenMacaulay.mem_span_image_of_map_smul φ f hφ (hv ▸ Submodule.mem_top (x := m))
    rw [← Set.range_comp] at hm
    have h1 := Submodule.smul_mem _ (show S from s) hm
    have e : (show S from s) • φ m = ((show S from s) * 1) ⊗ₜ[R,f] m :=
      ModuleCat.ExtendScalars.smul_tmul f _ 1 m
    rw [e, mul_one] at h1
    exact h1
  | add a b ha hb => exact add_mem ha hb

end ExtendScalars

section IdealStalk

open CategoryTheory Limits Opposite AlgebraicGeometry LCICohenMacaulay

variable {X Y : Scheme.{u}} (i : Y ⟶ X) [IsClosedImmersion i]

/-- A monomorphism of `𝒪_X`-modules is injective on sections. -/
theorem modules_app_injective_of_mono {F G : X.Modules} (φ : F ⟶ G) [Mono φ] (U : X.Opens) :
    Function.Injective (φ.app U) := by
  let Gf : X.Modules ⥤ AddCommGrpCat.{u} :=
    Scheme.Modules.toPresheaf X ⋙ (evaluation _ _).obj (op U)
  have : PreservesFiniteLimits Gf := by
    have := PreservesLimitsOfSize.preservesFiniteLimits (Scheme.Modules.toPresheaf X)
    have := PreservesLimitsOfSize.preservesFiniteLimits
      ((evaluation (TopologicalSpace.Opens X)ᵒᵖ AddCommGrpCat.{u}).obj (op U))
    exact comp_preservesFiniteLimits _ _
  have : Mono (Gf.map φ) := inferInstance
  exact (AddCommGrpCat.mono_iff_injective _).mp this

omit [IsClosedImmersion i] in
/-- The map `(I_Y)_x → 𝒪_{X,x}` is injective. -/
theorem idealStalkMap_injective (x : X) : Function.Injective (idealStalkMap i x) := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  obtain ⟨U, hU, s, rfl⟩ := (closedImmersionIdealSheaf i).presheaf.exists_germ_eq a
  rw [idealStalkMap_germ] at ha
  obtain ⟨W, hxW, j₁, j₂, hW⟩ := X.presheaf.germ_eq x hU hU _ 0 (ha.trans (map_zero _).symm)
  have h0 : (closedImmersionIdealSheafι i).app W
      ((closedImmersionIdealSheaf i).presheaf.map (homOfLE j₁.le).op s) = 0 := by
    erw [modules_app_res (closedImmersionIdealSheafι i) j₁.le s]
    exact hW.trans (map_zero _)
  have h1 := modules_app_injective_of_mono (closedImmersionIdealSheafι i) W
    (h0.trans (map_zero _).symm)
  rw [← (closedImmersionIdealSheaf i).presheaf.germ_res_apply (homOfLE j₁.le) x hxW s, h1,
    map_zero]

/-- Every element of the kernel of `𝒪_{X,i y} → 𝒪_{Y,y}` is the germ of a section of `I_Y`. -/
theorem exists_idealStalkMap_eq (y : Y) (a : X.presheaf.stalk (i y))
    (ha : a ∈ RingHom.ker (i.stalkMap y).hom) :
    ∃ m, idealStalkMap i (i y) m = a := by
  rw [RingHom.mem_ker] at ha
  obtain ⟨V, hxV, s, rfl⟩ := X.presheaf.exists_germ_eq a
  erw [Scheme.Hom.germ_stalkMap_apply i V y hxV] at ha
  obtain ⟨W', hyW', j₁, j₂, hW'⟩ := Y.presheaf.germ_eq y (U := i ⁻¹ᵁ V) (V := i ⁻¹ᵁ V)
    hxV hxV (i.app V s) 0 (ha.trans (map_zero _).symm)
  obtain ⟨t, ht, htW⟩ := i.isClosedEmbedding.isInducing.isOpen_iff.mp W'.2
  let V' : X.Opens := V ⊓ ⟨t, ht⟩
  have hyt : y ∈ i ⁻¹' t := by rw [htW]; exact hyW'
  have hxV' : i y ∈ V' := ⟨hxV, hyt⟩
  have hle : i ⁻¹ᵁ V' ≤ W' := fun z hz => by
    have : z ∈ i ⁻¹' t := hz.2
    rw [htW] at this
    exact this
  let s' := X.presheaf.map (homOfLE inf_le_left : V' ⟶ V).op s
  have hs' : i.app V' s' = 0 := by
    have hnat := congr(ConcreteCategory.hom $(i.naturality (homOfLE inf_le_left : V' ⟶ V).op) s)
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply] at hnat
    rw [hnat]
    have hcomp : Y.presheaf.map ((TopologicalSpace.Opens.map i.base).map
        (homOfLE (inf_le_left : V' ≤ V)).op.unop).op =
        Y.presheaf.map (j₁.op ≫ (homOfLE hle).op) := rfl
    rw [hcomp, Functor.map_comp, ConcreteCategory.comp_apply, hW', map_zero, map_zero]
  let S : ShortComplex X.Modules := ShortComplex.mk (kernel.ι (structureSheafToPushforward i))
    (structureSheafToPushforward i) (kernel.condition (structureSheafToPushforward i))
  have : Mono S.f := by change Mono (closedImmersionIdealSheafι i); infer_instance
  obtain ⟨t', ht'⟩ := modules_sections_exact (S := S)
    (ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel _)) (U := V') s' hs'
  refine ⟨(closedImmersionIdealSheaf i).presheaf.germ V' (i y) hxV' t', ?_⟩
  refine (idealStalkMap_germ i (i y) V' hxV' t').trans ?_
  have ht'' : (closedImmersionIdealSheafι i).app V' t' = s' := ht'
  rw [ht'']
  exact X.presheaf.germ_res_apply (homOfLE inf_le_left) (i y) hxV' s

/-- If the kernel of `𝒪_{X,i y} → 𝒪_{Y,y}` is generated by `r` elements, then the stalk of `I_Y`
at `i y` is generated by `r` elements. -/
theorem exists_span_idealStalk_eq_top (y : Y) {r : ℕ} (f : Fin r → X.presheaf.stalk (i y))
    (hf : RingHom.ker (i.stalkMap y).hom = Ideal.span (Set.range f)) :
    ∃ v : Fin r → (closedImmersionIdealSheaf i).presheaf.stalk (i y),
      Submodule.span (X.presheaf.stalk (i y)) (Set.range v) = ⊤ := by
  have hmem : ∀ j, f j ∈ RingHom.ker (i.stalkMap y).hom := fun j =>
    hf ▸ Ideal.subset_span ⟨j, rfl⟩
  choose v hv using fun j => exists_idealStalkMap_eq i y (f j) (hmem j)
  refine ⟨v, eq_top_iff.mpr fun m _ => ?_⟩
  have hm : idealStalkMap i (i y) m ∈ Ideal.span (Set.range f) := by
    rw [← hf, RingHom.mem_ker]
    exact stalkMap_idealStalkMap i y m
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hm
  have : m = ∑ j, c j • v j := by
    apply idealStalkMap_injective i
    rw [← hc, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [idealStalkMap_smul, hv]
  rw [this]
  exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

end IdealStalk

section Spreading

open CategoryTheory AlgebraicGeometry Opposite

variable {X : Scheme.{u}}

/-- If the germ at `x` of a function `b` lies in the ideal generated by the germs of finitely many
functions `a j`, then the same holds at every point of a neighbourhood of `x`. -/
theorem exists_open_germ_mem_span {V : X.Opens} {r : ℕ} (a : Fin r → Γ(X, V)) (b : Γ(X, V))
    {x : X} (hx : x ∈ V)
    (h : X.presheaf.germ V x hx b ∈ Ideal.span (Set.range fun j => X.presheaf.germ V x hx (a j))) :
    ∃ W : X.Opens, x ∈ W ∧ ∃ hWV : W ≤ V, ∀ z (hz : z ∈ W), X.presheaf.germ V z (hWV hz) b ∈
      Ideal.span (Set.range fun j => X.presheaf.germ V z (hWV hz) (a j)) := by
  classical
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp h
  choose D hDV hxD γ hγ using fun j => X.presheaf.exists_le_germ_eq (c j) hx
  let D0 : X.Opens := V ⊓ Finset.univ.inf D
  have hxD0 : x ∈ D0 := ⟨hx, by
    change x ∈ ((Finset.univ.inf D : X.Opens) : Set X)
    rw [TopologicalSpace.Opens.coe_finset_inf]
    simpa using fun j => hxD j⟩
  have hD0j : ∀ j, D0 ≤ D j := fun j => inf_le_right.trans (Finset.inf_le (Finset.mem_univ j))
  let res : ∀ {U : X.Opens}, D0 ≤ U → Γ(X, U) → Γ(X, D0) := fun hU t =>
    X.presheaf.map (homOfLE hU).op t
  let e : Γ(X, D0) := res inf_le_left b - ∑ j, res (hD0j j) (γ j) * res inf_le_left (a j)
  have hgerm : ∀ z (hz : z ∈ D0), X.presheaf.germ D0 z hz e = X.presheaf.germ V z hz.1 b -
      ∑ j, X.presheaf.germ (D j) z (hD0j j hz) (γ j) * X.presheaf.germ V z hz.1 (a j) := by
    intro z hz
    simp only [e, res, map_sub, map_sum, map_mul, TopCat.Presheaf.germ_res_apply]
  have he : X.presheaf.germ D0 x hxD0 e = X.presheaf.germ D0 x hxD0 0 := by
    rw [hgerm, map_zero, sub_eq_zero, ← hc]
    exact Finset.sum_congr rfl fun j _ => by rw [hγ]
  obtain ⟨W, hxW, iU, iV, hW⟩ := X.presheaf.germ_eq x hxD0 hxD0 e 0 he
  refine ⟨W, hxW, fun z hz => (iU.le hz).1, fun z hz => ?_⟩
  have h0 : X.presheaf.germ D0 z (iU.le hz) e = 0 := by
    rw [← X.presheaf.germ_res_apply iU z hz, hW, map_zero, map_zero]
  rw [hgerm, sub_eq_zero] at h0
  rw [h0]
  exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)

end Spreading

section Main

open CategoryTheory Limits AlgebraicGeometry Ringed ModuleSheafTensor

variable {k : Type u} [Field k] [IsAlgClosed k] {X Y : Scheme.{u}} (p : X ⟶ Spec (.of k))
  (i : Y ⟶ X) [IsClosedImmersion i]

/-- The stalkwise form of Theorem 8.17: at every point `y` of `Y`, the stalk of the conormal map
`i^* I ⟶ i^* Ω_{X/k}` is injective and the stalk of `i^* I` is free of rank `r = codim (Y, X)`. -/
theorem stalk_conormal (hp : FiniteType p) [IrreducibleSpace X] (hX : X.IsRegular)
    [IrreducibleSpace Y] (hY : Y.IsRegular) (r : ℕ) (hr : codim (Set.range i.base) = r) (y : Y) :
    Function.Injective ((moduleStalkFunctor (R := Y.sheaf) y).map
        (ClosedConormal.conormalToPullback i p)) ∧
      Nonempty (((moduleStalkFunctor (R := Y.sheaf) y).obj
        ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i))) ≃ₗ[
          ringSheafStalk Y.sheaf y] (Fin r → ringSheafStalk Y.sheaf y)) := by
  have : IsIntegral X := isIntegral_of_isRegular hX
  have : IsIntegral Y := isIntegral_of_isRegular hY
  have := hp.1
  have := hp.2
  have hp' : FiniteType (i ≫ p) := ⟨inferInstance, inferInstance⟩
  -- the dimensions `n = dim X` and `q = dim Y`, with `n = q + r`
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (i y)) isOpen_univ
  have : Nonempty U := ⟨⟨i y, hyU⟩⟩
  obtain ⟨n, -, hn⟩ := DimensionCodimension.exists_ringKrullDim_eq p hp U hU
  have hdc := dimension_codimension_formula p hp (Set.range i.base)
    i.isClosedEmbedding.isClosed_range (Set.range_nonempty_iff_nonempty.mpr ⟨y⟩)
  rw [← IsHomeomorph.topologicalKrullDim_eq _
    (i.isClosedEmbedding.toHomeomorph).isHomeomorph, hr, hn] at hdc
  obtain ⟨q, hq⟩ : ∃ q : ℕ, topologicalKrullDim Y = q := by
    generalize topologicalKrullDim Y = e at hdc
    induction e using WithBot.recBotCoe with
    | bot => simp at hdc
    | coe e =>
      induction e using ENat.recTopCoe with
      | top =>
        have : ((⊤ : ℕ∞) + r : ℕ∞) = n := by exact_mod_cast hdc
        simp at this
      | coe e => exact ⟨e, rfl⟩
  have hnqr : n = q + r := by
    rw [hq] at hdc
    exact_mod_cast hdc.symm
  -- `Ω_{X/k}` and `Ω_{Y/k}` are locally free of ranks `n` and `q` (Theorem 8.15)
  have hΩX := (isRegular_iff_relativeDifferentials_isLocallyFreeOfRank p hp n hn).mp hX
  have hΩY := (isRegular_iff_relativeDifferentials_isLocallyFreeOfRank (i ≫ p) hp' q hq).mp hY
  have hE := ProductNonsingular.isLocallyFreeOfRank_pullback i hΩX
  obtain ⟨eE⟩ := nonempty_stalk_equiv_of_isLocallyFreeOfRank _ n hE y
  obtain ⟨eF⟩ := nonempty_stalk_equiv_of_isLocallyFreeOfRank _ q hΩY y
  -- the conormal sequence (Proposition 8.12) on stalks
  obtain ⟨hex, hepi⟩ := ClosedConormal.closedImmersion_conormal_exact i p
  obtain ⟨hex', hsurj⟩ := stalk_exact_and_surjective (R := Y.sheaf) _ hex hepi y
  -- the stalk of `I` at `i y` is generated by `r` elements
  have : IsRegularLocalRing (X.presheaf.stalk (i y)) := hX.2 (i y)
  have : IsRegularLocalRing (Y.presheaf.stalk y) := hY.2 y
  have hdim := ringKrullDim_stalk_eq_add_codim p hp hn i r hr y
  obtain ⟨f, hf⟩ := exists_ker_eq_span (i.stalkMap y).hom (i.stalkMap_surjective y) r hdim
  obtain ⟨v, hv⟩ := exists_span_idealStalk_eq_top i y f hf
  let ρ : ringSheafStalk X.sheaf (i y) →+* ringSheafStalk Y.sheaf y := (i.stalkMap y).hom
  let M := (moduleStalkFunctor (R := X.sheaf) (i y)).obj (closedImmersionIdealSheaf i)
  have hv' : Submodule.span (ringSheafStalk X.sheaf (i y))
      (Set.range (show Fin r → M from v)) = ⊤ :=
    hv
  let M' := (ModuleCat.extendScalars ρ).obj M
  let C' := (moduleStalkFunctor (R := Y.sheaf) y).obj
    ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i))
  let e : C' ≃ₗ[ringSheafStalk Y.sheaf y] M' :=
    pullbackStalkLinearEquiv i y (closedImmersionIdealSheaf i)
  let g : Fin r → M' := fun j => (1 : ringSheafStalk Y.sheaf y) ⊗ₜ[_, ρ] v j
  have hg : Submodule.span (ringSheafStalk Y.sheaf y) (Set.range g) = ⊤ :=
    span_extendScalars_eq_top ρ M v hv'
  have hw : Submodule.span (ringSheafStalk Y.sheaf y)
      (Set.range (e.symm.toLinearMap ∘ g)) = ⊤ := by
    rw [Set.range_comp, ← Submodule.map_span, hg, Submodule.map_top, LinearEquiv.range]
  have : IsLocalRing (ringSheafStalk Y.sheaf y) :=
    inferInstanceAs (IsLocalRing (Y.presheaf.stalk y))
  exact injective_and_free_of_exact _ _ hex' hsurj eE eF hnqr _ hw

/-- **Hartshorne II, Theorem 8.17** (forward direction; left exactness and the conormal sheaf).
Let `X` be a nonsingular variety over an algebraically closed field `k` and `Y` an irreducible
closed subscheme which is nonsingular, of codimension `r`. Then the conormal sequence
`0 ⟶ i^* I ⟶ i^* Ω_{X/k} ⟶ Ω_{Y/k} ⟶ 0` is short exact, and the conormal sheaf `i^* I`
(whose pushforward is `I/I²`) is locally free of rank `r`. -/
theorem shortExact_conormal_and_isLocallyFreeOfRank (hp : FiniteType p) [IrreducibleSpace X]
    (hX : X.IsRegular) [IrreducibleSpace Y] (hY : Y.IsRegular) (r : ℕ)
    (hr : codim (Set.range i.base) = r) :
    (ShortComplex.mk (ClosedConormal.conormalToPullback i p)
      (Scheme.pullbackRelativeDifferentialsToComp i p)
      (ClosedConormal.conormalToPullback_comp i p)).ShortExact ∧
    ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i)).IsLocallyFreeOfRank r := by
  have key := stalk_conormal p i hp hX hY r hr
  obtain ⟨hex, hepi⟩ := ClosedConormal.closedImmersion_conormal_exact i p
  have hmono : Mono (ClosedConormal.conormalToPullback i p) :=
    mono_of_injective_stalk (R := Y.sheaf) _ fun y => (key y).1
  refine ⟨{ exact := hex, mono_f := hmono, epi_g := hepi }, ?_⟩
  have : IsIntegral Y := isIntegral_of_isRegular hY
  have := hY.1
  have := hX.1
  have := hp.2
  have : CompactSpace X := ⟨by
    simpa using QuasiCompact.isCompact_preimage (f := p) _ isOpen_univ isCompact_univ⟩
  have : IsNoetherian X := {}
  have hcoh := isCoherent_pullback i (isCoherent_closedImmersionIdealSheaf i)
  rw [isLocallyFreeOfRank_iff_forall_finrank_fibre _ hcoh r]
  intro y
  obtain ⟨eC⟩ := (key y).2
  have eC' : ((Scheme.Modules.pullback i).obj (closedImmersionIdealSheaf i)).presheaf.stalk y ≃ₗ[
      Y.presheaf.stalk y] (Fin r → Y.presheaf.stalk y) := eC
  have h1 :=
    (eC'.baseChange (Y.presheaf.stalk y) (ResidueField (Y.presheaf.stalk y)) _ _).finrank_eq
  have h2 : finrank (ResidueField (Y.presheaf.stalk y)) (ResidueField (Y.presheaf.stalk y) ⊗[
      Y.presheaf.stalk y] (Fin r → Y.presheaf.stalk y)) = r := by
    rw [Module.finrank_baseChange, Module.finrank_fin_fun]
  exact h1.trans h2

omit [IsAlgClosed k] in
/-- **Hartshorne II, Theorem 8.17**, the generation statement at the level of local rings: at every
point `y` of `Y`, the kernel of `𝒪_{X,y} → 𝒪_{Y,y}` (the stalk of the ideal sheaf of `Y`) is
generated by `r = codim (Y, X)` elements. -/
theorem ker_stalkMap_eq_span (hp : FiniteType p) [IrreducibleSpace X] (hX : X.IsRegular)
    [IrreducibleSpace Y] (hY : Y.IsRegular) (r : ℕ) (hr : codim (Set.range i.base) = r) (y : Y) :
    ∃ f : Fin r → X.presheaf.stalk (i y),
      RingHom.ker (i.stalkMap y).hom = Ideal.span (Set.range f) := by
  have : IsIntegral X := isIntegral_of_isRegular hX
  have : IsIntegral Y := isIntegral_of_isRegular hY
  have : IsRegularLocalRing (X.presheaf.stalk (i y)) := hX.2 (i y)
  have : IsRegularLocalRing (Y.presheaf.stalk y) := hY.2 y
  obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (i y)) isOpen_univ
  have : Nonempty U := ⟨⟨i y, hyU⟩⟩
  obtain ⟨n, -, hn⟩ := DimensionCodimension.exists_ringKrullDim_eq p hp U hU
  exact exists_ker_eq_span (i.stalkMap y).hom (i.stalkMap_surjective y) r
    (ringKrullDim_stalk_eq_add_codim p hp hn i r hr y)

end Main

end NonsingularConormal

