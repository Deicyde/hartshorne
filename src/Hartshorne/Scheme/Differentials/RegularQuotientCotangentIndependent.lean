import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

/-!
# Quotients of a regular local ring by part of a regular system of parameters

Let `(R, 𝔪, κ)` be a regular local ring of dimension `d` and let `f₁, …, f_c ∈ 𝔪` have
`κ`-linearly independent classes in the cotangent space `𝔪 ⧸ 𝔪²`. Then `R ⧸ (f₁, …, f_c)` is a
regular local ring of dimension `d - c`.

Extend the classes of the `fᵢ` to a basis of `𝔪 ⧸ 𝔪²` by classes of `g₁, …, g_{d-c}`. By
Nakayama the `fᵢ` and `gⱼ` generate `𝔪`, so the maximal ideal of the quotient is generated by the
images of the `gⱼ`, and its embedding dimension is at most `d - c`. Krull's height theorem gives
`d ≤ dim R ⧸ (f) + c`, and the dimension of a Noetherian local ring is at most its embedding
dimension.

This is a supporting step for the comparison of Hartshorne's definition of a smooth morphism
(III.10, p. 268) with the standard smooth predicate: elements of a polynomial ring whose
differentials are independent at a prime form part of a regular system of parameters there.

## Main results

* `Hartshorne.isRegularLocalRing_quotient_span_range_of_linearIndependent`
* `Hartshorne.ringKrullDim_quotient_span_range_add_card_of_linearIndependent`
-/

namespace Hartshorne

open IsLocalRing Ideal Module

variable {R : Type*} [CommRing R] [IsRegularLocalRing R] {ι : Type*} [Fintype ι]

/-- Auxiliary statement: for `f₁, …, f_c ∈ 𝔪` with independent classes in `𝔪 ⧸ 𝔪²`, the quotient
`R ⧸ (f)` is a local ring whose maximal ideal needs at most `dim_κ (𝔪 ⧸ 𝔪²) - c` generators,
and `dim R ≤ dim R ⧸ (f) + c`. -/
theorem quotient_span_range_aux (f : ι → maximalIdeal R)
    (hf : LinearIndependent (ResidueField R)
      (fun i => ((maximalIdeal R).toCotangent (f i) : CotangentSpace R))) :
    ∃ _ : IsLocalRing (R ⧸ span (Set.range fun i => (f i : R))),
      (maximalIdeal (R ⧸ span (Set.range fun i => (f i : R)))).spanFinrank + Fintype.card ι ≤
          finrank (ResidueField R) (CotangentSpace R) ∧
        ringKrullDim R ≤
          ringKrullDim (R ⧸ span (Set.range fun i => (f i : R))) + Fintype.card ι := by
  classical
  set J := span (Set.range fun i => (f i : R))
  set κ := ResidueField R
  set V := CotangentSpace R
  set v : ι → V := fun i => (maximalIdeal R).toCotangent (f i)
  let π : R →+* R ⧸ J := Ideal.Quotient.mk J
  have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
  have hJm : J ≤ maximalIdeal R := by
    rw [span_le]
    rintro _ ⟨i, rfl⟩
    exact (f i).2
  have hJ : J ≠ ⊤ := ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top hJm
  have : Nontrivial (R ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  have : IsLocalRing (R ⧸ J) := IsLocalRing.of_surjective' π hπ
  have hcomap : (maximalIdeal (R ⧸ J)).comap π = maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective π hπ)
  have hmap : (maximalIdeal R).map π = maximalIdeal (R ⧸ J) := by
    rw [← hcomap, Ideal.map_comap_of_surjective π hπ]
  refine ⟨this, ?_, ?_⟩
  · -- Extend the classes of the `fᵢ` to a basis of the cotangent space.
    have hs := hf.linearIndepOn_id
    set b := hs.extend (Set.subset_univ _)
    have hvb : Set.range v ⊆ b := hs.subset_extend _
    have hbli : LinearIndepOn κ id b := hs.linearIndepOn_extend _
    let B : Basis b κ V := Basis.extend hs
    have hbspan : Submodule.span κ b = ⊤ := by
      have := B.span_eq
      rwa [Basis.coe_extend, Subtype.range_coe] at this
    have hbfin : b.Finite := B.finite_index_of_rank_lt_aleph0 (Module.rank_lt_aleph0 κ V)
    set E : Set V := b \ Set.range v
    have hEfin : E.Finite := hbfin.subset Set.sdiff_subset
    have hcardb : b.ncard = finrank κ V := by
      rw [finrank_eq_nat_card_basis B, Nat.card_coe_set_eq]
    have hcardE : E.ncard + Fintype.card ι = finrank κ V := by
      rw [← hcardb, ← Set.ncard_sdiff_add_ncard_of_subset hvb hbfin,
        Set.ncard_range_of_injective hf.injective, Nat.card_eq_fintype_card]
    -- Lift the new basis vectors to elements of `𝔪`.
    have hlift : ∀ e : V, ∃ g : maximalIdeal R, (maximalIdeal R).toCotangent g = e :=
      fun e => (maximalIdeal R).toCotangent_surjective e
    choose g hg using hlift
    set s : Set (maximalIdeal R) := Set.range f ∪ g '' E
    have hspan : Submodule.span R s = ⊤ := by
      rw [← CotangentSpace.span_image_eq_top_iff, eq_top_iff, ← hbspan]
      apply Submodule.span_mono
      intro x hx
      by_cases hxv : x ∈ Set.range v
      · obtain ⟨i, rfl⟩ := hxv
        exact ⟨f i, Or.inl ⟨i, rfl⟩, rfl⟩
      · exact ⟨g x, Or.inr ⟨x, ⟨hx, hxv⟩, rfl⟩, hg x⟩
    have hspanI : span (Subtype.val '' s) = maximalIdeal R := by
      have := congrArg (Submodule.map (maximalIdeal R).subtype) hspan
      rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at this
      exact this
    have hzero : span (π '' (Subtype.val '' Set.range f)) = ⊥ := by
      rw [span_eq_bot]
      rintro _ ⟨_, ⟨_, ⟨i, rfl⟩, rfl⟩, rfl⟩
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (subset_span ⟨i, rfl⟩)
    have hmax : maximalIdeal (R ⧸ J) =
        span ((fun e => π (g e : R)) '' E) := by
      calc maximalIdeal (R ⧸ J) = map π (span (Subtype.val '' s)) := by rw [hspanI, hmap]
        _ = span ((fun e => π (g e : R)) '' E) := by
          rw [Ideal.map_span, Set.image_union, Set.image_union, span_union, hzero, bot_sup_eq,
            Set.image_image, Set.image_image]
    have hle : (maximalIdeal (R ⧸ J)).spanFinrank ≤ E.ncard := by
      rw [hmax]
      exact (Submodule.spanFinrank_span_le_ncard_of_finite (hEfin.image _)).trans
        (Set.ncard_image_le hEfin)
    change E.ncard + Fintype.card ι = finrank (ResidueField R) (CotangentSpace R) at hcardE
    omega
  · have h := ringKrullDim_le_ringKrullDim_quotient_add_encard
      (Set.range fun i => (f i : R)) (by
        rw [IsLocalRing.ringJacobson_eq_maximalIdeal]
        rintro _ ⟨i, rfl⟩
        exact (f i).2)
    refine h.trans ?_
    gcongr
    have := Set.encard_image_le (fun i => (f i : R)) Set.univ
    rw [Set.image_univ, Set.encard_univ, ENat.card_eq_coe_fintype_card] at this
    exact_mod_cast this

/-- Let `(R, 𝔪)` be a regular local ring and `f₁, …, f_c ∈ 𝔪` with `κ`-linearly independent
classes in `𝔪 ⧸ 𝔪²`. Then `R ⧸ (f₁, …, f_c)` is a regular local ring. -/
theorem isRegularLocalRing_quotient_span_range_of_linearIndependent (f : ι → maximalIdeal R)
    (hf : LinearIndependent (ResidueField R)
      (fun i => ((maximalIdeal R).toCotangent (f i) : CotangentSpace R))) :
    IsRegularLocalRing (R ⧸ span (Set.range fun i => (f i : R))) := by
  obtain ⟨_, hgen, hdim⟩ := quotient_span_range_aux f hf
  have hR := (IsRegularLocalRing.iff_finrank_cotangentSpace R).mp inferInstance
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [← hR] at hdim
  have hfin : ringKrullDim (R ⧸ span (Set.range fun i => (f i : R))) ≠ ⊤ :=
    ne_top_of_le_ne_top (b := ((maximalIdeal _).spanFinrank : WithBot ℕ∞))
      (fun h => ENat.natCast_ne_top _ (WithBot.coe_injective h))
      (ringKrullDim_le_spanFinrank_maximalIdeal _)
  generalize ringKrullDim (R ⧸ span (Set.range fun i => (f i : R))) = e at hdim hfin ⊢
  generalize (maximalIdeal (R ⧸ span (Set.range fun i => (f i : R)))).spanFinrank = a at hgen ⊢
  generalize finrank (ResidueField R) (CotangentSpace R) = d at hdim hgen
  induction e using WithBot.recBotCoe with
  | bot => simp at hdim
  | coe e =>
    induction e using ENat.recTopCoe with
    | top => simp at hfin
    | coe e =>
      norm_cast at hdim ⊢
      omega

/-- Let `(R, 𝔪)` be a regular local ring and `f₁, …, f_c ∈ 𝔪` with `κ`-linearly independent
classes in `𝔪 ⧸ 𝔪²`. Then `dim R ⧸ (f₁, …, f_c) + c = dim R`. -/
theorem ringKrullDim_quotient_span_range_add_card_of_linearIndependent (f : ι → maximalIdeal R)
    (hf : LinearIndependent (ResidueField R)
      (fun i => ((maximalIdeal R).toCotangent (f i) : CotangentSpace R))) :
    ringKrullDim (R ⧸ span (Set.range fun i => (f i : R))) + Fintype.card ι = ringKrullDim R := by
  obtain ⟨_, hgen, hdim⟩ := quotient_span_range_aux f hf
  have hR := (IsRegularLocalRing.iff_finrank_cotangentSpace R).mp inferInstance
  refine le_antisymm ?_ hdim
  rw [← hR]
  have hle := ringKrullDim_le_spanFinrank_maximalIdeal (R ⧸ span (Set.range fun i => (f i : R)))
  generalize ringKrullDim (R ⧸ span (Set.range fun i => (f i : R))) = e at hle ⊢
  generalize (maximalIdeal (R ⧸ span (Set.range fun i => (f i : R)))).spanFinrank = a at hgen hle
  generalize finrank (ResidueField R) (CotangentSpace R) = d at hgen
  induction e using WithBot.recBotCoe with
  | bot => simp
  | coe e =>
    induction e using ENat.recTopCoe with
    | top =>
      simp only [WithBot.coe_top, top_le_iff] at hle
      exact absurd hle (fun h => ENat.natCast_ne_top a (WithBot.coe_injective h))
    | coe e =>
      norm_cast at hle ⊢
      omega

end Hartshorne
