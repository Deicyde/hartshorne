/-!
# The conormal sequence of a closed immersion

Hartshorne, *Algebraic Geometry*, II, Proposition 8.12 (p. 176).

Let `i : Z ⟶ X` be a closed immersion with ideal sheaf `I` and let `f : X ⟶ Y` be a morphism.
The sequence of `𝒪_Z`-modules

`i^* I ⟶ i^* Ω_{X/Y} ⟶ Ω_{Z/Y} ⟶ 0`

is exact (`Hartshorne.ClosedConormal.closedImmersion_conormal_exact`). The left term is the
conormal sheaf `i^* I` of `i`; its pushforward `i_* i^* I` is `I/I²`
(`Hartshorne.isIso_idealSheafSqQuotientToPushforward`). The first map is adjoint to the
`𝒪_X`-linear map `I ⟶ i_* i^* Ω_{X/Y}`, `a ↦ 1 ⊗ d a`, and the second map is the first map of the
transitivity sequence (`pullbackRelativeDifferentialsToComp`). Injectivity of the first map is not
claimed.

## Proof

Hartshorne's proof: the statement follows from the algebraic conormal sequence (8.4A),
`Hartshorne.kaehlerConormal_rightExact`.

Here (8.4A) is applied on stalks. Exactness of a sequence of `𝒪_Z`-modules is checked on
stalks (`modules_exact_of_stalk`, `modules_epi_of_stalk`). Fix `z ∈ Z` with image `x = i z` and
`y = f x`, and put `A = 𝒪_{Y,y}`, `B = 𝒪_{X,x}` and `C = 𝒪_{Z,z}`; the stalk map `B → C` is
surjective, so (8.4A) gives the exact sequence

`ker(B → C)/ker(B → C)² ⟶ C ⊗_B Ω_{B/A} ⟶ Ω_{C/A} ⟶ 0`.

It is compared with the stalk sequence at `z`:

* `C ⊗_B Ω_{B/A} ⟶ (i^*Ω_{X/Y})_z`, `1 ⊗ d s ↦ (i^* d s)_z`, is surjective, because the stalk
  is generated by the germs `(i^* d s)_z` (`span_germUnitD`, from the universal properties of the
  pullback, the stalk and `Ω_{X/Y}`);
* `Ω_{C/A} ⟶ (Ω_{Z/Y})_z`, `d s ↦ (d s)_z`, is bijective: it is surjective for the same reason
  (`span_germD`), and the derivation `𝒪_Z ⟶ z_*Ω_{C/A}` into the skyscraper sheaf gives a left
  inverse (`exists_stalkD_inverse`);
* the square with the second maps commutes (`map_stalkUnitD`), and the image of
  `ker(B → C)` lies in the image of `(i^* I)_z`, since every element of `ker(B → C)` is the germ
  of a section of `I` (`exists_conormal_stalk`).

Exactness of the stalk sequence then follows from that of the algebraic sequence
(`stalk_conormal_exact`).
-/

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry
open scoped TensorProduct

namespace Hartshorne.ClosedConormal

open Scheme

variable {Z X Y : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (f : X ⟶ Y)

/-- The unit `Ω_{X/Y} ⟶ i_* i^* Ω_{X/Y}`. -/
noncomputable abbrev unitΩ :
    relativeDifferentials f ⟶
      (Modules.pushforward i).obj ((Modules.pullback i).obj (relativeDifferentials f)) :=
  (Modules.pullbackPushforwardAdjunction i).unit.app (relativeDifferentials f)

omit [IsClosedImmersion i] in
/-- The sections of `I` vanish on `Z`. -/
theorem app_idealSheafι (U : X.Opens) (a : Γ(closedImmersionIdealSheaf i, U)) :
    i.app U ((closedImmersionIdealSheafι i).app U a) = 0 :=
  congrArg (fun φ => Scheme.Modules.Hom.app φ U a)
    (kernel.condition (structureSheafToPushforward i))

/-- The `𝒪_X`-linear map `I ⟶ i_* i^* Ω_{X/Y}`, `a ↦ 1 ⊗ d a`. -/
noncomputable def idealToPushforward :
    closedImmersionIdealSheaf i ⟶
      (Modules.pushforward i).obj ((Modules.pullback i).obj (relativeDifferentials f)) where
  val := PresheafOfModules.homMk
    { app U := AddCommGrpCat.ofHom (((unitΩ i f).val.app U).hom.toAddMonoidHom.comp
        (((relativeDifferentialsDerivation f).d (X := U)).comp
          ((closedImmersionIdealSheafι i).val.app U).hom.toAddMonoidHom))
      naturality U V j := by
        ext a
        change (unitΩ i f).val.app V ((relativeDifferentialsDerivation f).d
            ((closedImmersionIdealSheafι i).val.app V
              ((closedImmersionIdealSheaf i).val.map j a))) =
          ((Modules.pushforward i).obj ((Modules.pullback i).obj
            (relativeDifferentials f))).val.map j ((unitΩ i f).val.app U
              ((relativeDifferentialsDerivation f).d ((closedImmersionIdealSheafι i).val.app U a)))
        rw [PresheafOfModules.naturality_apply (closedImmersionIdealSheafι i).val j a]
        erw [(relativeDifferentialsDerivation f).d_map j]
        exact PresheafOfModules.naturality_apply (unitΩ i f).val j _ }
    (fun U r a => by
      change (unitΩ i f).val.app U ((relativeDifferentialsDerivation f).d
          ((closedImmersionIdealSheafι i).val.app U (r • a))) =
        r • (unitΩ i f).val.app U ((relativeDifferentialsDerivation f).d
          ((closedImmersionIdealSheafι i).val.app U a))
      rw [((closedImmersionIdealSheafι i).val.app U).hom.map_smul]
      erw [(relativeDifferentialsDerivation f).d_mul]
      rw [map_add]
      erw [((unitΩ i f).val.app U).hom.map_smul, ((unitΩ i f).val.app U).hom.map_smul]
      have h0 : i.app U.unop ((closedImmersionIdealSheafι i).app U.unop a) = 0 :=
        app_idealSheafι i U.unop a
      refine add_eq_left.mpr ?_
      have hz : ∀ m : Γ((Modules.pullback i).obj (relativeDifferentials f), i ⁻¹ᵁ U.unop),
          i.app U.unop ((closedImmersionIdealSheafι i).app U.unop a) • m = 0 := fun m => by
        rw [h0, zero_smul]
      exact hz _)

/-- The conormal map `i^* I ⟶ i^* Ω_{X/Y}`, adjoint to `a ↦ 1 ⊗ d a`. -/
noncomputable def conormalToPullback :
    (Modules.pullback i).obj (closedImmersionIdealSheaf i) ⟶
      (Modules.pullback i).obj (relativeDifferentials f) :=
  ((Modules.pullbackPushforwardAdjunction i).homEquiv _ _).symm (idealToPushforward i f)

omit [IsClosedImmersion i] in
theorem homEquiv_conormalToPullback :
    (Modules.pullbackPushforwardAdjunction i).homEquiv _ _ (conormalToPullback i f) =
      idealToPushforward i f :=
  Equiv.apply_symm_apply _ _

omit [IsClosedImmersion i] in
/-- The adjoint of `i^*Ω_{X/Y} ⟶ Ω_{Z/Y}` is `Ω_{X/Y} ⟶ i_*Ω_{Z/Y}`, `d a ↦ d (i^♯ a)`. -/
theorem unit_comp_pushforward_map :
    (Modules.pullbackPushforwardAdjunction i).unit.app (relativeDifferentials f) ≫
      (Modules.pushforward i).map (pullbackRelativeDifferentialsToComp i f) =
        relativeDifferentialsToPushforwardComp i f := by
  exact ((Modules.pullbackPushforwardAdjunction i).homEquiv_unit _ _ _).symm.trans
    (pullbackRelativeDifferentialsToComp_homEquiv i f)

omit [IsClosedImmersion i] in
theorem conormalToPullback_comp :
    conormalToPullback i f ≫ pullbackRelativeDifferentialsToComp i f = 0 := by
  apply ((Modules.pullbackPushforwardAdjunction i).homEquiv _ _).injective
  rw [Adjunction.homEquiv_naturality_right, homEquiv_conormalToPullback,
    Adjunction.homEquiv_unit, Functor.map_zero, comp_zero]
  refine Scheme.Modules.hom_ext _ _ fun V => ?_
  ext a
  have h1 := congr(($(unit_comp_pushforward_map i f)).val.app (op V)
    ((relativeDifferentialsDerivation f).d ((closedImmersionIdealSheafι i).val.app (op V) a)))
  have h2 : (relativeDifferentialsToPushforwardComp i f).val.app (op V)
      ((relativeDifferentialsDerivation f).d ((closedImmersionIdealSheafι i).val.app (op V) a)) =
        0 := by
    refine (relativeDifferentialsToPushforwardComp_d i f (op V)
      ((closedImmersionIdealSheafι i).val.app (op V) a)).trans ?_
    have h0 := app_idealSheafι i V a
    change (relativeDifferentialsDerivation (i ≫ f)).d
      (i.app V ((closedImmersionIdealSheafι i).app V a)) = 0
    rw [h0]
    exact map_zero _
  exact (h1.trans h2).trans rfl

end Hartshorne.ClosedConormal

namespace Hartshorne.ClosedConormal

open Ringed ModuleSheafTensor

section StalkLift

variable {T : TopCat.{u}} (F : TopCat.Presheaf CommRingCat.{u} T) (x : T) {A : Type*}
  (δ : ∀ U : Opens T, x ∈ U → F.obj (op U) → A)
  (hδ : ∀ (U V : Opens T) (j : V ⟶ U) (hV : x ∈ V) (s : F.obj (op U)),
    δ V hV (F.map j.op s) = δ U (j.le hV) s)

/-- A function on sections near `x`, compatible with restriction, as a function on the stalk. -/
noncomputable def stalkLift (r : F.stalk x) : A :=
  δ _ (F.exists_germ_eq r).choose_spec.choose (F.exists_germ_eq r).choose_spec.choose_spec.choose

include hδ in
theorem stalkLift_germ (U : Opens T) (hU : x ∈ U) (s : F.obj (op U)) :
    stalkLift F x δ (F.germ U x hU s) = δ U hU s := by
  have H := (F.exists_germ_eq (F.germ U x hU s)).choose_spec.choose_spec.choose_spec
  obtain ⟨W, hxW, j₁, j₂, hW⟩ := F.germ_eq x _ hU _ s H
  rw [stalkLift, ← hδ _ W j₁ hxW, hW, hδ]

/-- Two elements of the stalk are germs of sections over a common open. -/
theorem exists_germ_pair (r r' : F.stalk x) :
    ∃ (U : Opens T) (hU : x ∈ U) (s s' : F.obj (op U)),
      F.germ U x hU s = r ∧ F.germ U x hU s' = r' := by
  obtain ⟨U, hU, s, rfl⟩ := F.exists_germ_eq r
  obtain ⟨V, hV, s', rfl⟩ := F.exists_germ_eq r'
  exact ⟨U ⊓ V, ⟨hU, hV⟩, F.map (homOfLE inf_le_left).op s, F.map (homOfLE inf_le_right).op s',
    F.germ_res_apply _ _ _ _, F.germ_res_apply _ _ _ _⟩

end StalkLift

section StalkD

variable {Z Y : Scheme.{u}} (g : Z ⟶ Y) (z : Z)

/-- The germ at `z` of `d s`, for a section `s` of `𝒪_Z` near `z`. -/
noncomputable def germD (U : Z.Opens) (hU : z ∈ U) (s : Γ(Z, U)) :
    (moduleStalkFunctor (R := Z.sheaf) z).obj (Scheme.relativeDifferentials g) :=
  sectionGerm (Scheme.relativeDifferentials g).val z U hU
    ((Scheme.relativeDifferentialsDerivation g).d (X := op U) s)

theorem germD_res (U V : Z.Opens) (j : V ⟶ U) (hV : z ∈ V) (s : Γ(Z, U)) :
    germD g z V hV (Z.presheaf.map j.op s) = germD g z U (j.le hV) s := by
  unfold germD
  erw [(Scheme.relativeDifferentialsDerivation g).d_map]
  exact sectionGerm_res _ z j hV _

/-- The derivation `𝒪_{Z,z} → (Ω_{Z/Y})_z`, `s_z ↦ (d s)_z`. -/
noncomputable def stalkD (r : ringSheafStalk Z.sheaf z) :
    (moduleStalkFunctor (R := Z.sheaf) z).obj (Scheme.relativeDifferentials g) :=
  stalkLift Z.sheaf.obj z (germD g z) r

theorem stalkD_germ (U : Z.Opens) (hU : z ∈ U) (s : Γ(Z, U)) :
    stalkD g z (Z.presheaf.germ U z hU s) = germD g z U hU s :=
  stalkLift_germ Z.sheaf.obj z (germD g z) (germD_res g z) U hU s

theorem stalkD_add (r r' : ringSheafStalk Z.sheaf z) :
    stalkD g z (r + r') = stalkD g z r + stalkD g z r' := by
  obtain ⟨U, hU, s, s', rfl, rfl⟩ := exists_germ_pair Z.sheaf.obj z r r'
  erw [← map_add, stalkD_germ, stalkD_germ, stalkD_germ]
  unfold germD
  rw [map_add, map_add]
  rfl

theorem stalkD_mul (r r' : ringSheafStalk Z.sheaf z) :
    stalkD g z (r * r') = r • stalkD g z r' + r' • stalkD g z r := by
  obtain ⟨U, hU, s, s', rfl, rfl⟩ := exists_germ_pair Z.sheaf.obj z r r'
  erw [← map_mul, stalkD_germ, stalkD_germ, stalkD_germ]
  unfold germD
  erw [(Scheme.relativeDifferentialsDerivation g).d_mul, map_add, sectionGerm_smul,
    sectionGerm_smul]
  rfl

theorem stalkD_app (V : Y.Opens) (t : Γ(Y, V)) (hz : z ∈ g ⁻¹ᵁ V) :
    stalkD g z (Z.presheaf.germ (g ⁻¹ᵁ V) z hz (g.app V t)) = 0 := by
  rw [stalkD_germ]
  unfold germD
  rw [RelDiffLocal.kills_of_derivation g (Scheme.relativeDifferentialsDerivation g) V t, map_zero]
  rfl

theorem span_germD : Submodule.span (ringSheafStalk Z.sheaf z)
    {t | ∃ (U : Z.Opens) (hU : z ∈ U) (s : Γ(Z, U)), germD g z U hU s = t} = ⊤ := by
  set N := Submodule.span (ringSheafStalk Z.sheaf z)
    {t | ∃ (U : Z.Opens) (hU : z ∈ U) (s : Γ(Z, U)), germD g z U hU s = t}
  let π : (moduleStalkFunctor (R := Z.sheaf) z).obj (Scheme.relativeDifferentials g) ⟶
      ModuleCat.of (ringSheafStalk Z.sheaf z) (_ ⧸ N) := ModuleCat.ofHom N.mkQ
  have hπ : π = 0 := by
    apply ((moduleStalkSkyscraperAdjunction (R := Z.sheaf) z).homEquiv _ _).injective
    apply (Scheme.relativeDifferentialsHomEquiv g _).injective
    ext U s
    funext h
    change N.mkQ (germD g z U.unop h.down s) = 0
    exact (Submodule.Quotient.mk_eq_zero N).mpr
      (Submodule.subset_span ⟨U.unop, h.down, s, rfl⟩)
  rw [eq_top_iff]
  intro t _
  exact (Submodule.Quotient.mk_eq_zero N).mp congr(ModuleCat.Hom.hom $hπ t)

end StalkD

section StalkPullback

open Scheme

variable {Z X Y : Scheme.{u}} (i : Z ⟶ X) (f : X ⟶ Y) (z : Z)

/-- The stalk map `𝒪_{X,i z} → 𝒪_{Z,z}`. -/
noncomputable abbrev stalkHom : ringSheafStalk X.sheaf (i z) →+* ringSheafStalk Z.sheaf z :=
  (i.stalkMap z).hom

/-- The germ at `z` of `i^*(d s)`, for a section `s` of `𝒪_X` near `i z`. -/
noncomputable def germUnitD (U : X.Opens) (hU : i z ∈ U) (s : Γ(X, U)) :
    (moduleStalkFunctor (R := Z.sheaf) z).obj
      ((Modules.pullback i).obj (relativeDifferentials f)) :=
  sectionGerm ((Modules.pullback i).obj (relativeDifferentials f)).val z (i ⁻¹ᵁ U) hU
    (((Modules.pullbackPushforwardAdjunction i).unit.app (relativeDifferentials f)).val.app (op U)
      ((relativeDifferentialsDerivation f).d (X := op U) s))

theorem germUnitD_res (U V : X.Opens) (j : V ⟶ U) (hV : i z ∈ V) (s : Γ(X, U)) :
    germUnitD i f z V hV (X.presheaf.map j.op s) = germUnitD i f z U (j.le hV) s := by
  unfold germUnitD
  erw [(relativeDifferentialsDerivation f).d_map,
    PresheafOfModules.naturality_apply
      ((Modules.pullbackPushforwardAdjunction i).unit.app (relativeDifferentials f)).val j.op]
  exact sectionGerm_res _ z ((Opens.map i.base).map j) hV _

/-- The derivation `𝒪_{X,i z} → (i^*Ω_{X/Y})_z`, `s_{i z} ↦ (i^* d s)_z`. -/
noncomputable def stalkUnitD (r : ringSheafStalk X.sheaf (i z)) :
    (moduleStalkFunctor (R := Z.sheaf) z).obj
      ((Modules.pullback i).obj (relativeDifferentials f)) :=
  stalkLift X.sheaf.obj (i z) (germUnitD i f z) r

theorem stalkUnitD_germ (U : X.Opens) (hU : i z ∈ U) (s : Γ(X, U)) :
    stalkUnitD i f z (X.presheaf.germ U (i z) hU s) = germUnitD i f z U hU s :=
  stalkLift_germ X.sheaf.obj (i z) (germUnitD i f z) (germUnitD_res i f z) U hU s

theorem stalkUnitD_add (r r' : ringSheafStalk X.sheaf (i z)) :
    stalkUnitD i f z (r + r') = stalkUnitD i f z r + stalkUnitD i f z r' := by
  obtain ⟨U, hU, s, s', rfl, rfl⟩ := exists_germ_pair X.sheaf.obj (i z) r r'
  erw [← map_add, stalkUnitD_germ, stalkUnitD_germ, stalkUnitD_germ]
  unfold germUnitD
  rw [map_add, map_add]
  exact map_add _ _ _

theorem stalkUnitD_mul (r r' : ringSheafStalk X.sheaf (i z)) :
    stalkUnitD i f z (r * r') =
      stalkHom i z r • stalkUnitD i f z r' + stalkHom i z r' • stalkUnitD i f z r := by
  obtain ⟨U, hU, s, s', rfl, rfl⟩ := exists_germ_pair X.sheaf.obj (i z) r r'
  erw [← map_mul, stalkUnitD_germ, stalkUnitD_germ, stalkUnitD_germ]
  unfold germUnitD
  erw [(relativeDifferentialsDerivation f).d_mul, map_add,
    (((Modules.pullbackPushforwardAdjunction i).unit.app
      (relativeDifferentials f)).val.app _).hom.map_smul,
    (((Modules.pullbackPushforwardAdjunction i).unit.app
      (relativeDifferentials f)).val.app _).hom.map_smul,
    map_add, sectionGerm_smul, sectionGerm_smul, Scheme.Hom.germ_stalkMap_apply,
    Scheme.Hom.germ_stalkMap_apply]
  rfl

theorem stalkUnitD_app (V : Y.Opens) (t : Γ(Y, V)) (hz : i z ∈ f ⁻¹ᵁ V) :
    stalkUnitD i f z (X.presheaf.germ (f ⁻¹ᵁ V) (i z) hz (f.app V t)) = 0 := by
  rw [stalkUnitD_germ]
  unfold germUnitD
  rw [RelDiffLocal.kills_of_derivation f (relativeDifferentialsDerivation f) V t, map_zero]
  exact map_zero _

theorem span_germUnitD : Submodule.span (ringSheafStalk Z.sheaf z)
    {t | ∃ (U : X.Opens) (hU : i z ∈ U) (s : Γ(X, U)), germUnitD i f z U hU s = t} = ⊤ := by
  set N := Submodule.span (ringSheafStalk Z.sheaf z)
    {t | ∃ (U : X.Opens) (hU : i z ∈ U) (s : Γ(X, U)), germUnitD i f z U hU s = t}
  let π : (moduleStalkFunctor (R := Z.sheaf) z).obj
      ((Modules.pullback i).obj (relativeDifferentials f)) ⟶
      ModuleCat.of (ringSheafStalk Z.sheaf z) (_ ⧸ N) := ModuleCat.ofHom N.mkQ
  have hπ : π = 0 := by
    apply ((pullbackStalkAdjunction i z).homEquiv _ _).injective
    apply (relativeDifferentialsHomEquiv f _).injective
    ext U s
    funext h
    change N.mkQ (germUnitD i f z U.unop h.down s) = 0
    exact (Submodule.Quotient.mk_eq_zero N).mpr
      (Submodule.subset_span ⟨U.unop, h.down, s, rfl⟩)
  rw [eq_top_iff]
  intro t _
  exact (Submodule.Quotient.mk_eq_zero N).mp congr(ModuleCat.Hom.hom $hπ t)

/-- On stalks, `i^*Ω_{X/Y} ⟶ Ω_{Z/Y}` sends `i^*(d s)` to `d (i^♯ s)`. -/
theorem map_stalkUnitD (r : ringSheafStalk X.sheaf (i z)) :
    (moduleStalkFunctor (R := Z.sheaf) z).map (pullbackRelativeDifferentialsToComp i f)
      (stalkUnitD i f z r) = stalkD (i ≫ f) z (stalkHom i z r) := by
  obtain ⟨U, hU, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.sheaf.obj r
  erw [stalkUnitD_germ, Scheme.Hom.germ_stalkMap_apply, stalkD_germ]
  unfold germUnitD germD
  erw [moduleStalkFunctor_map_germ, pullbackRelativeDifferentialsToComp_unit_d]

end StalkPullback

section Kernel

open Scheme

variable {Z X Y : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (f : X ⟶ Y) (z : Z)

/-- Every element of `ker(𝒪_{X,i z} → 𝒪_{Z,z})` is the germ of a section `a` of the ideal sheaf
`I`, so `(i^* d a)_z` lies in the image of the conormal map on stalks. -/
theorem exists_conormal_stalk (a : ringSheafStalk X.sheaf (i z)) (ha : stalkHom i z a = 0) :
    ∃ m, (moduleStalkFunctor (R := Z.sheaf) z).map (conormalToPullback i f) m =
      stalkUnitD i f z a := by
  obtain ⟨V, hxV, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.sheaf.obj a
  have ha' : Z.presheaf.germ (i ⁻¹ᵁ V) z hxV (i.app V s) = 0 := by
    erw [← Scheme.Hom.germ_stalkMap_apply]
    exact ha
  obtain ⟨W', hzW', j₁, j₂, hW'⟩ := Z.presheaf.germ_eq z (U := i ⁻¹ᵁ V) (V := i ⁻¹ᵁ V)
    hxV hxV (i.app V s) 0 (ha'.trans (map_zero _).symm)
  obtain ⟨t, ht, htW⟩ := i.isClosedEmbedding.isInducing.isOpen_iff.mp W'.2
  let V' : X.Opens := V ⊓ ⟨t, ht⟩
  have hzt : z ∈ i ⁻¹' t := by rw [htW]; exact hzW'
  have hxV' : i z ∈ V' := ⟨hxV, hzt⟩
  have hle : i ⁻¹ᵁ V' ≤ W' := fun w hw => by
    have : w ∈ i ⁻¹' t := hw.2
    rw [htW] at this
    exact this
  let s' := X.presheaf.map (homOfLE inf_le_left : V' ⟶ V).op s
  have hs' : i.app V' s' = 0 := by
    have hnat : i.app V' s' = Z.presheaf.map ((TopologicalSpace.Opens.map i.base).map
        (homOfLE (inf_le_left : V' ≤ V)).op.unop).op (i.app V s) :=
      congr(ConcreteCategory.hom $(i.naturality (homOfLE inf_le_left : V' ⟶ V).op) s)
    rw [hnat]
    have hcomp : Z.presheaf.map ((TopologicalSpace.Opens.map i.base).map
        (homOfLE (inf_le_left : V' ≤ V)).op.unop).op =
        Z.presheaf.map (j₁.op ≫ (homOfLE hle).op) := rfl
    rw [hcomp, Functor.map_comp, ConcreteCategory.comp_apply, hW', map_zero, map_zero]
  let S : ShortComplex X.Modules := ShortComplex.mk (kernel.ι (structureSheafToPushforward i))
    (structureSheafToPushforward i) (kernel.condition (structureSheafToPushforward i))
  have : Mono S.f := by change Mono (closedImmersionIdealSheafι i); infer_instance
  obtain ⟨t', ht'⟩ := modules_sections_exact (S := S)
    (ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel _)) (U := V') s' hs'
  refine ⟨sectionGerm ((Modules.pullback i).obj (closedImmersionIdealSheaf i)).val z (i ⁻¹ᵁ V')
    hxV' (((Modules.pullbackPushforwardAdjunction i).unit.app
      (closedImmersionIdealSheaf i)).val.app (op V') t'), ?_⟩
  erw [moduleStalkFunctor_map_germ,
    ← X.presheaf.germ_res_apply (homOfLE inf_le_left : V' ⟶ V) (i z) hxV' s, stalkUnitD_germ]
  have h1 := congr(($(homEquiv_conormalToPullback i f)).val.app (op V') t')
  rw [Adjunction.homEquiv_unit] at h1
  refine (congrArg (sectionGerm _ z _ hxV') h1).trans ?_
  have ht'' : (closedImmersionIdealSheafι i).val.app (op V') t' = s' := ht'
  exact congrArg (fun v => sectionGerm ((Modules.pullback i).obj (relativeDifferentials f)).val z
    (i ⁻¹ᵁ V') hxV' (((Modules.pullbackPushforwardAdjunction i).unit.app
      (relativeDifferentials f)).val.app (op V') ((relativeDifferentialsDerivation f).d v))) ht''

end Kernel

section Inverse

open Scheme

variable {Z Y : Scheme.{u}} (g : Z ⟶ Y) (z : Z)

/-- A left inverse of `Ω_{C/A} ⟶ (Ω_{Z/Y})_z` for `C = 𝒪_{Z,z}`: the derivation
`𝒪_Z ⟶ z_* Ω_{C/A}`, `s ↦ d(s_z)`, into the skyscraper sheaf, gives by the universal properties of
`Ω_{Z/Y}` and of the stalk a linear map `(Ω_{Z/Y})_z ⟶ Ω_{C/A}` with `(d s)_z ↦ d(s_z)`. -/
theorem exists_stalkD_inverse {A : Type u} [CommRing A] [Algebra A (ringSheafStalk Z.sheaf z)]
    (hk : ∀ (V : Y.Opens) (t : Γ(Y, V)) (hz : z ∈ g ⁻¹ᵁ V),
      KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
        (TopCat.Presheaf.germ Z.sheaf.obj (g ⁻¹ᵁ V) z hz (g.app V t)) = 0) :
    ∃ b : (moduleStalkFunctor (R := Z.sheaf) z).obj (relativeDifferentials g) →ₗ[
        ringSheafStalk Z.sheaf z] Ω[ringSheafStalk Z.sheaf z⁄A],
      ∀ (U : Z.Opens) (hU : z ∈ U) (s : Γ(Z, U)),
        b (germD g z U hU s) =
          KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
            (TopCat.Presheaf.germ Z.sheaf.obj U z hU s) := by
  let K := ModuleCat.of (ringSheafStalk Z.sheaf z) Ω[ringSheafStalk Z.sheaf z⁄A]
  let N : Z.Modules := (moduleSkyscraper (R := Z.sheaf) z).obj K
  let δ : ∀ {U : Z.Opensᵒᵖ}, Z.presheaf.obj U →+ N.val.obj U := fun {U} =>
    AddMonoidHom.mk' (fun s h => KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
      (TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down s)) (fun a b => funext fun h => by
        change KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
            (TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down (a + b)) =
          KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
              (TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down a) +
            KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
              (TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down b)
        erw [map_add]
        exact map_add _ _ _)
  let D : N.val.Derivation' (inverseImageStructureSheafMap g).hom :=
    RelDiffLocal.derivationOfKills g δ
      (fun {U} a b => funext fun h => by
        change KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
            (TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down (a * b)) =
          TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down a •
              KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
                (TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down b) +
            TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down b •
              KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
                (TopCat.Presheaf.germ Z.sheaf.obj U.unop z h.down a)
        erw [map_mul, Derivation.leibniz])
      (fun {U V} j a => funext fun h => by
        change KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
            (TopCat.Presheaf.germ Z.sheaf.obj V.unop z h.down (Z.presheaf.map j a)) =
          KaehlerDifferential.D A (ringSheafStalk Z.sheaf z)
            (TopCat.Presheaf.germ Z.sheaf.obj U.unop z (j.unop.le h.down) a)
        erw [TopCat.Presheaf.germ_res_apply'])
      (fun U m hm => RelDiffLocal.modules_sep N U m hm)
      (fun V t => funext fun h => hk V t h.down)
  let φ := (relativeDifferentialsHomEquiv g N).symm D
  have hφ : ∀ (U : Z.Opens) (s : Γ(Z, U)),
      φ.val.app (op U) ((relativeDifferentialsDerivation g).d s) = D.d s := by
    have h : (relativeDifferentialsDerivation g).postcomp φ.val = D := by
      rw [← relativeDifferentialsHomEquiv_apply]
      exact Equiv.apply_symm_apply _ _
    exact fun U s => PresheafOfModules.Derivation.congr_d h s
  refine ⟨(ofSkyscraper φ).hom, fun U hU s => ?_⟩
  exact (ofSkyscraper_germ φ U hU _).trans (congrFun (hφ U s) ⟨hU⟩)

end Inverse

section Reflection

/-- Exactness of a complex of `𝒪_X`-modules can be checked on stalks. -/
theorem modules_exact_of_stalk {X : Scheme.{u}} (S : ShortComplex X.Modules)
    (h : ∀ x : X, Function.Exact ((moduleStalkFunctor (R := X.sheaf) x).map S.f)
      ((moduleStalkFunctor (R := X.sheaf) x).map S.g)) : S.Exact := by
  let G : X.Modules ⥤ TopCat.Sheaf AddCommGrpCat.{u} X := SheafOfModules.toSheaf X.ringCatSheaf
  have : G.PreservesZeroMorphisms := ⟨fun _ _ => rfl⟩
  have : PreservesFiniteLimits G :=
    inferInstanceAs (PreservesFiniteLimits (SheafOfModules.toSheaf X.ringCatSheaf))
  have : G.Faithful := inferInstanceAs (SheafOfModules.toSheaf X.ringCatSheaf).Faithful
  have hT : (S.map G).Exact := by
    rw [TopCat.Sheaf.exact_iff_stalkFunctor_map_exact]
    intro x
    rw [ShortComplex.ab_exact_iff_function_exact]
    exact h x
  rw [ShortComplex.exact_iff_epi_kernel_lift] at hT ⊢
  have e := map_lift_kernelComparison S.g G (h := S.f) (w := S.zero)
  have : Epi (G.map (kernel.lift S.g S.f S.zero) ≫ kernelComparison S.g G) := by
    rw [e]; exact hT
  have : Epi (G.map (kernel.lift S.g S.f S.zero)) := by
    have h' := epi_comp (G.map (kernel.lift S.g S.f S.zero) ≫ kernelComparison S.g G)
      (inv (kernelComparison S.g G))
    rwa [Category.assoc, IsIso.hom_inv_id, Category.comp_id] at h'
  exact G.epi_of_epi_map this

open ZeroObject in
/-- A morphism of `𝒪_X`-modules is an epimorphism if it is surjective on stalks. -/
theorem modules_epi_of_stalk {X : Scheme.{u}} {M N : X.Modules} (g : M ⟶ N)
    (h : ∀ x : X, Function.Surjective ((moduleStalkFunctor (R := X.sheaf) x).map g)) : Epi g := by
  let S := ShortComplex.mk g (0 : N ⟶ 0) comp_zero
  refine (S.exact_iff_epi rfl).mp (modules_exact_of_stalk S fun x => ?_)
  intro b
  constructor
  · intro _; exact h x b
  · intro _
    obtain ⟨U, hU, t, rfl⟩ := ModuleSheafTensor.exists_sectionGerm _ x b
    refine (moduleStalkFunctor_map_germ x (0 : N ⟶ 0) U hU t).trans ?_
    exact map_zero _

end Reflection

section Main

open Scheme

variable {Z X Y : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (f : X ⟶ Y)

omit [IsClosedImmersion i] in
/-- The germ at `z` of `(i ≫ f)^♯ t` is the image of the germ of `t` under the stalk maps. -/
theorem stalkHom_stalkHom_germ (z : Z) (V : Y.Opens) (t : Γ(Y, V)) (hz : f (i z) ∈ V) :
    stalkHom i z (stalkHom f (i z) (Y.presheaf.germ V (f (i z)) hz t)) =
      Z.presheaf.germ ((i ≫ f) ⁻¹ᵁ V) z hz ((i ≫ f).app V t) := by
  erw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.germ_stalkMap_apply]
  rfl

/-- **The conormal sequence on stalks.** At every `z ∈ Z`, the stalk of the conormal sequence is
right exact. This is the algebraic conormal sequence (Hartshorne II, Proposition 8.4A) for
`𝒪_{Y,f(i z)} → 𝒪_{X,i z} → 𝒪_{Z,z}`, transported to the stalks. -/
theorem stalk_conormal_exact (z : Z) :
    Function.Exact ((moduleStalkFunctor (R := Z.sheaf) z).map (conormalToPullback i f))
        ((moduleStalkFunctor (R := Z.sheaf) z).map (pullbackRelativeDifferentialsToComp i f)) ∧
      Function.Surjective
        ((moduleStalkFunctor (R := Z.sheaf) z).map (pullbackRelativeDifferentialsToComp i f)) := by
  let Rz := ringSheafStalk Z.sheaf z
  let Rx := ringSheafStalk X.sheaf (i z)
  let Ry := ringSheafStalk Y.sheaf (f (i z))
  let _ : Algebra Rx Rz := (stalkHom i z).toAlgebra
  let _ : Algebra Ry Rx := (stalkHom f (i z)).toAlgebra
  let _ : Algebra Ry Rz := ((stalkHom i z).comp (stalkHom f (i z))).toAlgebra
  have _ : IsScalarTower Ry Rx Rz := IsScalarTower.of_algebraMap_eq fun _ => rfl
  -- Hartshorne II, Proposition 8.4A for `A = 𝒪_{Y,y} → B = 𝒪_{X,x} → C = 𝒪_{Z,z}`
  obtain ⟨hex, hsurj⟩ := kaehlerConormal_rightExact Ry Rx Rz (i.stalkMap_surjective z)
  let T2 := (moduleStalkFunctor (R := Z.sheaf) z).obj
    ((Modules.pullback i).obj (relativeDifferentials f))
  let T3 := (moduleStalkFunctor (R := Z.sheaf) z).obj (relativeDifferentials (i ≫ f))
  let _ : Module Rx T2 := Module.compHom T2 (stalkHom i z)
  have _ : IsScalarTower Rx Rz T2 := ⟨fun a b c => mul_smul (stalkHom i z a) b c⟩
  let _ : Module Ry T2 := Module.compHom T2 (algebraMap Ry Rz)
  have _ : IsScalarTower Ry Rx T2 := ⟨fun a b c => by
    change (stalkHom i z (stalkHom f (i z) a * b)) • c =
      (stalkHom i z (stalkHom f (i z) a)) • (stalkHom i z b • c)
    rw [map_mul, mul_smul]⟩
  let _ : Module Ry T3 := Module.compHom T3 (algebraMap Ry Rz)
  have _ : IsScalarTower Ry Rz T3 := ⟨fun a b c => mul_smul (algebraMap Ry Rz a) b c⟩
  -- the sections `d (f^♯ t)` vanish
  have hk2 : ∀ a : Ry, stalkUnitD i f z (algebraMap Ry Rx a) = 0 := fun a => by
    obtain ⟨V, hV, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq Y.sheaf.obj a
    erw [Scheme.Hom.germ_stalkMap_apply]
    exact stalkUnitD_app i f z V t hV
  have hk3 : ∀ a : Ry, stalkD (i ≫ f) z (algebraMap Ry Rz a) = 0 := fun a => by
    obtain ⟨V, hV, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq Y.sheaf.obj a
    erw [stalkHom_stalkHom_germ i f z V t hV]
    exact stalkD_app (i ≫ f) z V t hV
  -- the derivations `B → (i^*Ω_{X/Y})_z` and `C → (Ω_{Z/Y})_z`
  let D2 : Derivation Ry Rx T2 := Derivation.mk'
    { toFun := stalkUnitD i f z
      map_add' := stalkUnitD_add i f z
      map_smul' := fun a r => by
        change stalkUnitD i f z (algebraMap Ry Rx a * r) = algebraMap Ry Rz a • _
        rw [stalkUnitD_mul, hk2, smul_zero, add_zero]
        rfl }
    (stalkUnitD_mul i f z)
  let D3 : Derivation Ry Rz T3 := Derivation.mk'
    { toFun := stalkD (i ≫ f) z
      map_add' := stalkD_add (i ≫ f) z
      map_smul' := fun a r => by
        change stalkD (i ≫ f) z (algebraMap Ry Rz a * r) = algebraMap Ry Rz a • _
        rw [stalkD_mul, hk3, smul_zero, add_zero] }
    (stalkD_mul (i ≫ f) z)
  let φ2 : Rz ⊗[Rx] Ω[Rx⁄Ry] →ₗ[Rz] T2 := D2.liftKaehlerDifferential.liftBaseChange Rz
  let φ3 : Ω[Rz⁄Ry] →ₗ[Rz] T3 := D3.liftKaehlerDifferential
  let p := ((moduleStalkFunctor (R := Z.sheaf) z).map (conormalToPullback i f)).hom
  let q := ((moduleStalkFunctor (R := Z.sheaf) z).map
    (pullbackRelativeDifferentialsToComp i f)).hom
  -- the comparison square commutes
  have hcomm : ∀ w, q (φ2 w) = φ3 (KaehlerDifferential.mapBaseChange Ry Rx Rz w) := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero, map_zero]
    | tmul c ω =>
      have hω : ω ∈ Submodule.span Rx (Set.range (KaehlerDifferential.D Ry Rx)) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      induction hω using Submodule.span_induction generalizing c with
      | mem _ h =>
        obtain ⟨r, rfl⟩ := h
        rw [LinearMap.liftBaseChange_tmul, KaehlerDifferential.mapBaseChange_tmul, map_smul,
          map_smul, KaehlerDifferential.map_D, Derivation.liftKaehlerDifferential_comp_D,
          Derivation.liftKaehlerDifferential_comp_D]
        exact congrArg (c • ·) (map_stalkUnitD i f z r)
      | zero => rw [TensorProduct.tmul_zero, map_zero, map_zero, map_zero, map_zero]
      | add x y _ _ hx hy => rw [TensorProduct.tmul_add, map_add, map_add, hx, hy, map_add, map_add]
      | smul r ω _ h => rw [← TensorProduct.smul_tmul, h]
    | add w w' hw hw' => rw [map_add, map_add, hw, hw', map_add, map_add]
  -- `C ⊗_B Ω_{B/A} ⟶ (i^*Ω_{X/Y})_z` is surjective
  have hφ2 : Function.Surjective φ2 := by
    rw [← LinearMap.range_eq_top, eq_top_iff, ← span_germUnitD i f z, Submodule.span_le]
    rintro _ ⟨U, hU, s, rfl⟩
    refine ⟨1 ⊗ₜ KaehlerDifferential.D Ry Rx (TopCat.Presheaf.germ X.sheaf.obj U (i z) hU s), ?_⟩
    rw [LinearMap.liftBaseChange_tmul, one_smul, Derivation.liftKaehlerDifferential_comp_D]
    exact stalkUnitD_germ i f z U hU s
  -- `Ω_{C/A} ⟶ (Ω_{Z/Y})_z` is bijective
  have hφ3s : Function.Surjective φ3 := by
    rw [← LinearMap.range_eq_top, eq_top_iff, ← span_germD (i ≫ f) z, Submodule.span_le]
    rintro _ ⟨U, hU, s, rfl⟩
    refine ⟨KaehlerDifferential.D Ry Rz (TopCat.Presheaf.germ Z.sheaf.obj U z hU s), ?_⟩
    rw [Derivation.liftKaehlerDifferential_comp_D]
    exact stalkD_germ (i ≫ f) z U hU s
  have hφ3i : Function.Injective φ3 := by
    obtain ⟨b, hb⟩ := exists_stalkD_inverse (i ≫ f) z (A := Ry) fun V t hz => by
      erw [← stalkHom_stalkHom_germ i f z V t hz]
      exact (KaehlerDifferential.D Ry Rz).map_algebraMap _
    refine Function.LeftInverse.injective (g := b) fun ω => ?_
    have hω : ω ∈ Submodule.span Rz (Set.range (KaehlerDifferential.D Ry Rz)) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    induction hω using Submodule.span_induction with
    | mem _ h =>
      obtain ⟨r, rfl⟩ := h
      obtain ⟨U, hU, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq Z.sheaf.obj r
      rw [Derivation.liftKaehlerDifferential_comp_D]
      exact (congrArg b (stalkD_germ (i ≫ f) z U hU s)).trans (hb U hU s)
    | zero => rw [map_zero, map_zero]
    | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
    | smul r x _ h => rw [map_smul, map_smul, h]
  -- the image of `ker(B → C)` lies in the image of `(i^* I)_z`
  have hker : ∀ c, φ2 (KaehlerDifferential.kerCotangentToTensor Ry Rx Rz c) ∈
      LinearMap.range p := by
    intro c
    obtain ⟨a, rfl⟩ := Ideal.toCotangent_surjective _ c
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent, LinearMap.liftBaseChange_tmul,
      one_smul, Derivation.liftKaehlerDifferential_comp_D]
    exact exists_conormal_stalk i f z a.1 (RingHom.mem_ker.mp a.2)
  have hzero : ∀ m, q (p m) = 0 := fun m => by
    obtain ⟨U, hU, t, rfl⟩ := exists_sectionGerm _ z m
    change (moduleStalkFunctor (R := Z.sheaf) z).map (pullbackRelativeDifferentialsToComp i f)
      ((moduleStalkFunctor (R := Z.sheaf) z).map (conormalToPullback i f)
        (sectionGerm _ z U hU t)) = 0
    erw [moduleStalkFunctor_map_germ, moduleStalkFunctor_map_germ]
    have h := congr(($(conormalToPullback_comp i f)).val.app (op U) t)
    refine (congrArg (sectionGerm _ z U hU) h).trans ?_
    exact map_zero _
  refine ⟨fun t => ⟨fun ht => ?_, ?_⟩, fun t => ?_⟩
  · obtain ⟨w, rfl⟩ := hφ2 t
    have hw : KaehlerDifferential.mapBaseChange Ry Rx Rz w = 0 :=
      hφ3i (by rw [← hcomm, map_zero]; exact ht)
    obtain ⟨c, rfl⟩ := (hex w).mp hw
    exact hker c
  · rintro ⟨m, rfl⟩
    exact hzero m
  · obtain ⟨ω, rfl⟩ := hφ3s t
    obtain ⟨w, rfl⟩ := hsurj ω
    exact ⟨φ2 w, hcomm w⟩

/-- **The conormal sequence of a closed immersion** (Hartshorne II, Proposition 8.12). For a
closed immersion `i : Z ⟶ X` with ideal sheaf `I` and a morphism `f : X ⟶ Y`, the sequence
`i^* I ⟶ i^* Ω_{X/Y} ⟶ Ω_{Z/Y} ⟶ 0` of `𝒪_Z`-modules is exact. Here `i^* I` is the conormal sheaf
of `i`, whose pushforward `i_* i^* I` is `I/I²` (`isIso_idealSheafSqQuotientToPushforward`). -/
theorem closedImmersion_conormal_exact :
    (ShortComplex.mk (conormalToPullback i f) (pullbackRelativeDifferentialsToComp i f)
      (conormalToPullback_comp i f)).Exact ∧ Epi (pullbackRelativeDifferentialsToComp i f) :=
  ⟨modules_exact_of_stalk _ fun z => (stalk_conormal_exact i f z).1,
    modules_epi_of_stalk _ fun z => (stalk_conormal_exact i f z).2⟩

end Main

end Hartshorne.ClosedConormal
