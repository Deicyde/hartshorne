import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.KrullDimension.Regular

/-!
# Lifting regularity from a regular hypersurface quotient

Hartshorne, *Algebraic Geometry*, II.8, local algebra used in the proof of
Theorem 8.24(a) (p. 187); Stacks Project, tag 00NU.

Let `(A, 𝔪)` be a Noetherian local ring and let `f ∈ 𝔪` be a non-zero-divisor.
If `A ⧸ (f)` is a regular local ring, then so is `A`: lifting a minimal
generating set of the maximal ideal of `A ⧸ (f)` and adjoining `f` generates
`𝔪`, while the Krull dimension rises by exactly one across the regular element
`f`.

## Main results

* `Hartshorne.isRegularLocalRing_of_isRegularLocalRing_quotient_span_singleton`
-/

namespace Hartshorne

open IsLocalRing Ideal

/-- Let `(A, 𝔪)` be a Noetherian local ring and `f ∈ 𝔪` a non-zero-divisor. If `A ⧸ (f)` is a
regular local ring, then `A` is a regular local ring. -/
theorem isRegularLocalRing_of_isRegularLocalRing_quotient_span_singleton
    {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] {f : A}
    (hf : f ∈ nonZeroDivisors A) (hfm : f ∈ maximalIdeal A)
    [IsRegularLocalRing (A ⧸ span {f})] : IsRegularLocalRing A := by
  set B := A ⧸ span {f}
  let π : A →+* B := Ideal.Quotient.mk (span {f})
  have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
  -- Dimension rises by one across the regular element `f`.
  have hdim : ringKrullDim B + 1 = ringKrullDim A :=
    ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors hf hfm
  -- The maximal ideal of `B` is generated by `dim B` elements.
  have hB := (isRegularLocalRing_iff B).mp ‹_›
  have fgB : (maximalIdeal B).FG := (maximalIdeal B).fg_of_isNoetherianRing
  set S := (maximalIdeal B).generators
  have hSfin : S.Finite := Submodule.FG.finite_generators fgB
  -- Lift the generators.
  set T : Set A := Function.surjInv hπ '' S
  have hTfin : T.Finite := hSfin.image _
  have hπT : π '' T = S := by
    simp only [T, ← Set.image_comp, Function.comp_def, Function.surjInv_eq hπ, Set.image_id']
  -- The maximal ideal of `A` is the preimage of the maximal ideal of `B`.
  have hcomap : (maximalIdeal B).comap π = maximalIdeal A := by
    have : ((maximalIdeal B).comap π).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective π hπ
    exact IsLocalRing.eq_maximalIdeal this
  have hspan : maximalIdeal A = span (insert f T) := by
    rw [← hcomap, ← (maximalIdeal B).span_generators]
    change comap π (Submodule.span B S) = _
    rw [← hπT, ← Ideal.span, ← Ideal.map_span, Ideal.comap_map_of_surjective' π hπ,
      Ideal.span_insert, sup_comm, Ideal.mk_ker]
  have hle : (maximalIdeal A).spanFinrank ≤ (maximalIdeal B).spanFinrank + 1 := by
    rw [hspan]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (hTfin.insert f)).trans ?_
    refine (Set.ncard_insert_le _ _).trans ?_
    gcongr
    rw [← Submodule.FG.generators_ncard fgB]
    exact Set.ncard_image_le hSfin
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [← hdim, ← hB]
  exact_mod_cast hle

end Hartshorne
