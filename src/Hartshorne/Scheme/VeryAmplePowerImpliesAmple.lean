import Hartshorne.Scheme.AmplePowerEquivalence
import Hartshorne.Scheme.SerreGlobalGeneration
import Hartshorne.Scheme.CoherentExtension
import Hartshorne.Scheme.PullbackQuasicoherent
import Hartshorne.Scheme.FiniteType
import Hartshorne.Scheme.ModuleSheafTensorRestrict
import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree

/-!
# A very ample power implies ampleness

Hartshorne, *Algebraic Geometry*, II, Theorem 7.6, first implication (p. 154).

Let `X` be of finite type over a Noetherian ring `A` and `L` an invertible sheaf on `X`. If some
positive tensor power `L^m` is very ample over `Spec A`, then `L` is ample
(`Hartshorne.isAmple_of_isVeryAmpleRelative_moduleSheafTensorPower`).

## Proof

Write the immersion of `X` as an open immersion `o : X ⟶ Z` followed by a closed immersion
`c : Z ⟶ ℙʳ_A`, with `L^m ≅ (o ≫ c)^* 𝒪(1)`. Then `Z` is projective over `A`, hence Noetherian,
and `M = c^* 𝒪(1)` is very ample on `Z`. For a coherent `F` on `X`, extend it to a coherent `G`
on `Z` with `G|_X ≅ F` (`Hartshorne.exists_isCoherent_restrict_iso_of_isNoetherian`). By Serre's
theorem (`Hartshorne.exists_isGeneratedBySections_tensorPowerTwist_of_projective`),
`G ⊗ M^n` is generated by global sections for `n ≫ 0`, hence so is its restriction
`F ⊗ (L^m)^n` to `X`. So `L^m` is ample, and therefore `L` is ample
(`AlgebraicGeometry.Scheme.Modules.isAmple_tfae`).
-/

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry Limits

namespace Hartshorne

variable {X : Scheme.{u}}

namespace VeryAmplePower

/-- Tensor powers of isomorphic module sheaves are isomorphic. -/
noncomputable def tensorPowerIsoOfIso {E E' : X.Modules} (α : E ≅ E') : ∀ n : ℕ,
    moduleSheafTensorPower n E ≅ moduleSheafTensorPower n E'
  | 0 => Ringed.moduleSheafTensorPowerZeroIso E ≪≫ (Ringed.moduleSheafTensorPowerZeroIso E').symm
  | n + 1 => Ringed.moduleSheafTensorPowerSuccIso E n ≪≫
      Ringed.moduleSheafTensorIsoOfIso (tensorPowerIsoOfIso α n) α ≪≫
      (Ringed.moduleSheafTensorPowerSuccIso E' n).symm

/-- The preimage functor on opens of a morphism of schemes is final: every comma category has the
terminal object `⊤`. -/
theorem opensMap_final {Y : Scheme.{u}} (f : X ⟶ Y) : (Opens.map f.base).Final := by
  constructor
  intro U
  refine isConnected_of_isTerminal _
    (x := StructuredArrow.mk (homOfLE le_top : U ⟶ (Opens.map f.base).obj ⊤)) ?_
  refine IsTerminal.ofUniqueHom
    (fun A ↦ StructuredArrow.homMk (homOfLE le_top) (Subsingleton.elim _ _)) ?_
  intro A m
  ext
  exact Subsingleton.elim _ _

attribute [local instance] opensMap_final

set_option backward.isDefEq.respectTransparency false in
/-- Restriction along an open immersion preserves generation by global sections. -/
theorem isGloballyGenerated_restrict {Y : Scheme.{u}} (o : X ⟶ Y) [IsOpenImmersion o]
    {F : Y.Modules} (hF : F.IsGloballyGenerated) : (F.restrict o).IsGloballyGenerated := by
  have : (SheafOfModules.pushforward o.toRingCatSheafHom).IsRightAdjoint :=
    (Scheme.Modules.pullbackPushforwardAdjunction o).isRightAdjoint
  obtain ⟨I, p, hp⟩ := (Scheme.Modules.isGloballyGenerated_iff_exists_epi F).1 hF
  refine isGloballyGenerated_of_iso ((Scheme.Modules.restrictFunctorIsoPullback o).app F).symm ?_
  refine (Scheme.Modules.isGloballyGenerated_iff_exists_epi _).2
    ⟨I, (SheafOfModules.pullbackObjFreeIso o.toRingCatSheafHom I).inv ≫
      (Scheme.Modules.pullback o).map p, ?_⟩
  have : @Epi (SheafOfModules.{u} X.ringCatSheaf) _ _ _ ((Scheme.Modules.pullback o).map p) :=
    @Functor.map_epi _ _ _ _ (Scheme.Modules.pullback o) _ _ _ p hp
  exact epi_comp _ _

/-- A coherent sheaf on `X` extends to a coherent sheaf on any Noetherian scheme `Z` into which
`X` embeds by an open immersion. -/
theorem exists_isCoherent_restrict_iso_of_isOpenImmersion {Z : Scheme.{u}} [IsNoetherian Z] (o : X ⟶ Z)
    [IsOpenImmersion o] (F : X.Modules) (hF : IsCoherent F) :
    ∃ G : Z.Modules, IsCoherent G ∧ Nonempty (G.restrict o ≅ F) := by
  let e := o.isoOpensRange
  have hFU : IsCoherent (F.restrict e.inv) :=
    isCoherent_of_iso ((Scheme.Modules.restrictFunctorIsoPullback e.inv).app F).symm
      (isCoherent_pullback e.inv hF)
  obtain ⟨G, hG, ⟨φ⟩⟩ :=
    exists_isCoherent_restrict_iso_of_isNoetherian o.opensRange (F.restrict e.inv) hFU
  exact ⟨G, hG, ⟨(Scheme.Modules.restrictFunctorCongr (Scheme.Hom.isoOpensRange_hom_ι o).symm).app G ≪≫
    (Scheme.Modules.restrictFunctorComp e.hom o.opensRange.ι).app G ≪≫
    (Scheme.Modules.restrictFunctor e.hom).mapIso φ ≪≫
    ((Scheme.Modules.restrictFunctorComp e.hom e.inv).app F).symm ≪≫
    (Scheme.Modules.restrictFunctorCongr e.hom_inv_id).app F ≪≫
    Scheme.Modules.restrictFunctorId.app F⟩⟩

end VeryAmplePower

open VeryAmplePower in
/-- **Hartshorne II, Theorem 7.6, first implication.** Let `X` be of finite type over a Noetherian
ring `A` and `L` an invertible sheaf on `X`. If `L^m` is very ample relative to `Spec A` for some
`m > 0`, then `L` is ample. -/
theorem isAmple_of_isVeryAmpleRelative_moduleSheafTensorPower {A : CommRingCat.{u}}
    [IsNoetherianRing A] (f : X ⟶ Spec A) (hf : FiniteType f) {L : X.Modules}
    (hL : L.IsInvertible) {m : ℕ} (hm : 0 < m)
    (hLm : IsVeryAmpleRelative f (moduleSheafTensorPower m L)) :
    haveI := finiteType_isNoetherian f hf; L.IsAmple := by
  have := finiteType_isNoetherian f hf
  apply ((Scheme.Modules.isAmple_tfae L hL).out 0 2).mpr
  refine ⟨m, hm, ?_⟩
  obtain ⟨hLminv, r, Z, o, c, ho, hc, -, ⟨α⟩⟩ := hLm
  let M := (Scheme.Modules.pullback c).obj (projectiveSpaceTwistingSheaf r (Spec A) 1)
  have hZp : Projective (c ≫ projectiveSpaceOverSchemeProjection r (Spec A)) :=
    Projective.mk r c rfl
  have hM : IsVeryAmpleRelative (c ≫ projectiveSpaceOverSchemeProjection r (Spec A)) M :=
    ⟨Scheme.Modules.IsInvertible.pullback c (isInvertible_projectiveSpaceTwistingSheaf r _ 1),
      r, Z, 𝟙 Z, c, inferInstance, hc, by simp,
      ⟨(Scheme.Modules.pullbackCongr (Category.id_comp c)).app _⟩⟩
  have : IsNoetherian Z := by
    have := hZp.isProper
    exact finiteType_isNoetherian (c ≫ projectiveSpaceOverSchemeProjection r (Spec A))
      ⟨inferInstance, inferInstance⟩
  let β : moduleSheafTensorPower m L ≅ M.restrict o :=
    α.symm ≪≫ ((Scheme.Modules.pullbackComp o c).app _).symm ≪≫
      ((Scheme.Modules.restrictFunctorIsoPullback o).app M).symm
  refine ⟨hLminv, fun F hF => ?_⟩
  obtain ⟨G, hG, ⟨γ⟩⟩ := exists_isCoherent_restrict_iso_of_isOpenImmersion o F hF
  obtain ⟨n₀, hn₀⟩ := exists_isGeneratedBySections_tensorPowerTwist_of_projective hZp hM G hG
  refine ⟨n₀, fun n hn => ?_⟩
  obtain ⟨ι, -, t, ht⟩ := hn₀ n hn
  refine isGloballyGenerated_of_iso ?_ (isGloballyGenerated_restrict o ⟨ι, t, ht⟩)
  exact moduleSheafTensorRestrictIso o G (moduleSheafTensorPower n M) ≪≫
    Ringed.moduleSheafTensorIsoOfIso γ
      (moduleSheafTensorPowerRestrictIso o M n ≪≫ tensorPowerIsoOfIso β.symm n)

end Hartshorne
