import Hartshorne.Scheme.ProjTwistLocalization

/-!
# Descent data for the twisting sheaves of a relative Proj

Hartshorne, *Algebraic Geometry*, II.7, the relative `Proj` construction (pp. 160–161); see also
Stacks Project, tag 01NM.

Let `S` be a quasi-coherent sheaf of graded `𝒪_X`-algebras and `n ∈ ℤ`. On each affine piece
`Proj S(U)` of `Proj_X S` there is the twisting sheaf `𝒪(n) = S(U)(n)~`. For a basic open
inclusion `D(r) ⊆ U` the transition map `Proj S(D(r)) = Proj S(U)[1/r] ⟶ Proj S(U)` is an open
immersion, and the twisting sheaf of `Proj S(U)` restricts to the twisting sheaf of
`Proj S(D(r))`. These transition isomorphisms satisfy the identity and cocycle conditions: they
form the descent datum along which the twisting sheaves glue to `𝒪_{Proj_X S}(n)`. If `S` is
generated by `S₁` as an `S₀`-algebra, every piece is invertible.

## Main definitions and results

* `Hartshorne.QuasiCoherentGradedAlgebra.twistTransitionHom`, `twistTransition`: for `f : U ⟶ V`,
  `𝒪_{Proj S(V)}(n)|_{Proj S(U)} ≅ 𝒪_{Proj S(U)}(n)`.
* `Hartshorne.QuasiCoherentGradedAlgebra.twistTransitionHom_id`,
  `twistTransitionHom_comp`: the identity and cocycle conditions.
* `Hartshorne.QuasiCoherentGradedAlgebra.isInvertible_twistingSheaf`: under generation in degree
  one, each piece `𝒪_{Proj S(U)}(n)` is invertible.
-/

universe u

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace Hartshorne

namespace QuasiCoherentGradedAlgebra

open AlgebraicGeometry TopologicalSpace CategoryTheory Opposite

variable {X : Scheme.{u}} (S : QuasiCoherentGradedAlgebra X) (n : ℤ)

instance isOpenImmersion_projMap_restrict {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    IsOpenImmersion (Proj.map (S.restrict f) (S.irrelevant_le f)) :=
  inferInstanceAs (IsOpenImmersion (S.relativeGluingData.functor.map f))

/-- The twisting sheaf `𝒪(n) = S(U)(n)~` on the affine piece `Proj S(U)` of `Proj_X S`. -/
abbrev twistingSheaf (U : X.AffineZariskiSite) : (Proj (S.grading U)).Modules :=
  projTwistingSheaf (S.grading U) n

/-- The transition morphism `𝒪_{Proj S(V)}(n)|_{Proj S(U)} ⟶ 𝒪_{Proj S(U)}(n)` along an arrow
`U ⟶ V` of affine opens. -/
def twistTransitionHom {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    (S.twistingSheaf n V).restrict (Proj.map (S.restrict f) (S.irrelevant_le f)) ⟶ S.twistingSheaf n U :=
  ProjTwistMap.twistRestrictHom (S.restrict f) (S.irrelevant_le f) n

instance isIso_twistTransitionHom {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    IsIso (S.twistTransitionHom n f) := by
  obtain ⟨r, hr⟩ := f.le
  obtain rfl : V.basicOpen r = U := Subtype.ext hr
  obtain rfl : f = homOfLE (V.basicOpen_le r) := rfl
  let := (S.obj.map (homOfLE (V.basicOpen_le r)).op).hom.toAlgebra
  have := S.isLocalizationAway V r
  exact ProjTwistMap.isIso_twistRestrictHom (S.restrict (homOfLE (V.basicOpen_le r)))
    (S.irrelevant_le _) n (S.structureMap_mem V r) (fun _ => rfl)

/-- **The transition isomorphisms** `𝒪_{Proj S(V)}(n)|_{Proj S(U)} ≅ 𝒪_{Proj S(U)}(n)` along the
basic open inclusions `U = D(r) ⊆ V` of affine opens. -/
def twistTransition {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    (S.twistingSheaf n V).restrict (Proj.map (S.restrict f) (S.irrelevant_le f)) ≅ S.twistingSheaf n U :=
  asIso (S.twistTransitionHom n f)

theorem projMap_restrict_comp {U V W : X.AffineZariskiSite} (f : U ⟶ V) (g : V ⟶ W) :
    Proj.map (S.restrict (f ≫ g)) (S.irrelevant_le (f ≫ g)) =
      Proj.map (S.restrict f) (S.irrelevant_le f) ≫ Proj.map (S.restrict g) (S.irrelevant_le g) :=
  S.projFunctor.map_comp f g

theorem projMap_restrict_id (U : X.AffineZariskiSite) :
    Proj.map (S.restrict (𝟙 U)) (S.irrelevant_le (𝟙 U)) = 𝟙 _ :=
  S.projFunctor.map_id U

/-- **The cocycle condition** for the transition morphisms of the twisting sheaves: along
`U ⟶ V ⟶ W`, the transition morphism of the composite is the composite of the transition
morphisms (up to the canonical identifications of restrictions). -/
theorem twistTransitionHom_comp {U V W : X.AffineZariskiSite} (f : U ⟶ V) (g : V ⟶ W) :
    S.twistTransitionHom n (f ≫ g) =
      (Scheme.Modules.restrictFunctorCongr (S.projMap_restrict_comp f g)).hom.app
          (S.twistingSheaf n W) ≫
        (Scheme.Modules.restrictFunctorComp (Proj.map (S.restrict f) (S.irrelevant_le f))
          (Proj.map (S.restrict g) (S.irrelevant_le g))).hom.app (S.twistingSheaf n W) ≫
        (Scheme.Modules.restrictFunctor (Proj.map (S.restrict f) (S.irrelevant_le f))).map
          (S.twistTransitionHom n g) ≫
        S.twistTransitionHom n f := by
  apply Scheme.Modules.hom_ext
  intro O
  ext t
  apply Subtype.ext
  funext y
  let t' : (ProjGradedModuleSheaf.sheafInType (S.grading W) (gradedTwist (S.grading W) n)).1.obj
      (op (Proj.map (S.restrict (f ≫ g)) (S.irrelevant_le (f ≫ g)) ''ᵁ O)) := t
  change ProjTwistMap.twistFiber (S.restrict (f ≫ g)) n _ (t'.1 ⟨_, y.1, y.2, rfl⟩) =
    ProjTwistMap.twistFiber (S.restrict f) n _ (ProjTwistMap.twistFiber (S.restrict g) n _
      (t'.1 ⟨ProjectiveSpectrum.comap _ (S.irrelevant_le g)
        (ProjectiveSpectrum.comap _ (S.irrelevant_le f) y.1), _⟩))
  have hp : (Proj.map (S.restrict (f ≫ g)) (S.irrelevant_le (f ≫ g))).base y.1 =
      ProjectiveSpectrum.comap _ (S.irrelevant_le g)
        (ProjectiveSpectrum.comap _ (S.irrelevant_le f) y.1) := by
    rw [S.projMap_restrict_comp f g]
    rfl
  have hcomp : ∀ a, S.restrict (f ≫ g) a = S.restrict f (S.restrict g a) := fun a => by
    simp [restrict_apply]
  have h'' : (ProjectiveSpectrum.comap _ (S.irrelevant_le g)
        (ProjectiveSpectrum.comap _ (S.irrelevant_le f) y.1)).asHomogeneousIdeal.toIdeal.primeCompl
      ≤ (y.1.asHomogeneousIdeal.toIdeal.primeCompl).comap (S.restrict (f ≫ g)) := by
    rw [← hp]
    exact ProjTwistMap.primeCompl_le_comap _ (S.irrelevant_le (f ≫ g)) y.1
  rw [← ProjTwistMap.twistFiber_comp (S.restrict g) (S.restrict f) (S.restrict (f ≫ g)) hcomp n
    _ _ h'']
  have key : ∀ (p : ProjectiveSpectrum (S.grading W))
      (hp' : (Proj.map (S.restrict (f ≫ g)) (S.irrelevant_le (f ≫ g))).base y.1 = p)
      (m : p ∈ Proj.map (S.restrict (f ≫ g)) (S.irrelevant_le (f ≫ g)) ''ᵁ O)
      (h : p.asHomogeneousIdeal.toIdeal.primeCompl ≤
        (y.1.asHomogeneousIdeal.toIdeal.primeCompl).comap (S.restrict (f ≫ g))),
      ProjTwistMap.twistFiber (S.restrict (f ≫ g)) n
          (ProjTwistMap.primeCompl_le_comap _ (S.irrelevant_le (f ≫ g)) y.1)
          (t'.1 ⟨_, y.1, y.2, rfl⟩) =
        ProjTwistMap.twistFiber (S.restrict (f ≫ g)) n h (t'.1 ⟨p, m⟩) := by
    rintro p rfl m h
    rfl
  exact key _ hp _ _

/-- **The identity condition** for the transition morphisms of the twisting sheaves: along the
identity arrow the transition morphism is the canonical identification. -/
theorem twistTransitionHom_id (U : X.AffineZariskiSite) :
    S.twistTransitionHom n (𝟙 U) =
      (Scheme.Modules.restrictFunctorCongr (S.projMap_restrict_id U)).hom.app
          (S.twistingSheaf n U) ≫
        Scheme.Modules.restrictFunctorId.hom.app (S.twistingSheaf n U) := by
  apply Scheme.Modules.hom_ext
  intro O
  ext t
  apply Subtype.ext
  funext y
  let t' : (ProjGradedModuleSheaf.sheafInType (S.grading U) (gradedTwist (S.grading U) n)).1.obj
      (op (Proj.map (S.restrict (𝟙 U)) (S.irrelevant_le (𝟙 U)) ''ᵁ O)) := t
  change ProjTwistMap.twistFiber (S.restrict (𝟙 U)) n _ (t'.1 ⟨_, y.1, y.2, rfl⟩) =
    t'.1 ⟨y.1, _⟩
  have hp : (Proj.map (S.restrict (𝟙 U)) (S.irrelevant_le (𝟙 U))).base y.1 = y.1 := by
    rw [S.projMap_restrict_id U]
    rfl
  have hid : ∀ a, S.restrict (𝟙 U) a = a := fun a => by simp [restrict_apply]
  have key : ∀ (p : ProjectiveSpectrum (S.grading U))
      (hp' : (Proj.map (S.restrict (𝟙 U)) (S.irrelevant_le (𝟙 U))).base y.1 = p)
      (m : p ∈ Proj.map (S.restrict (𝟙 U)) (S.irrelevant_le (𝟙 U)) ''ᵁ O)
      (h : p.asHomogeneousIdeal.toIdeal.primeCompl ≤
        (y.1.asHomogeneousIdeal.toIdeal.primeCompl).comap (S.restrict (𝟙 U))),
      ProjTwistMap.twistFiber (S.restrict (𝟙 U)) n
          (ProjTwistMap.primeCompl_le_comap _ (S.irrelevant_le (𝟙 U)) y.1)
          (t'.1 ⟨_, y.1, y.2, rfl⟩) =
        ProjTwistMap.twistFiber (S.restrict (𝟙 U)) n h (t'.1 ⟨p, m⟩) := by
    rintro p rfl m h
    rfl
  have h' : y.1.asHomogeneousIdeal.toIdeal.primeCompl ≤
      (y.1.asHomogeneousIdeal.toIdeal.primeCompl).comap (S.restrict (𝟙 U)) := by
    have := ProjTwistMap.primeCompl_le_comap _ (S.irrelevant_le (𝟙 U)) y.1
    rwa [show ProjectiveSpectrum.comap _ (S.irrelevant_le (𝟙 U)) y.1 = y.1 from hp] at this
  exact (key y.1 hp _ h').trans (ProjTwistMap.twistFiber_id _ hid n h' _)

/-- If `S` is generated by `S₁` as an `S₀`-algebra, then over every affine open `U` the ring
`S(U)` is generated by `S(U)₁` as an `S(U)₀`-algebra. -/
theorem adjoin_eq_top_of_generatedInDegreeOne (hS : S.GeneratedInDegreeOne)
    (U : X.AffineZariskiSite) :
    Algebra.adjoin (S.grading U 0) (S.grading U 1 : Set (S.obj.obj (op U))) = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  have hx : x ∈ Subring.closure
      ((S.grading U 0 : Set (S.obj.obj (op U))) ∪ S.grading U 1) := by
    rw [hS U]; exact Subring.mem_top x
  refine Subring.closure_le (t := (Algebra.adjoin (S.grading U 0)
    (S.grading U 1 : Set (S.obj.obj (op U)))).toSubring) |>.2 ?_ hx
  rintro y (hy | hy)
  · exact Subalgebra.algebraMap_mem _ (⟨y, hy⟩ : S.grading U 0)
  · exact Algebra.subset_adjoin hy

/-- **Each piece of the relative twisting sheaf is invertible** when `S` is generated by `S₁` as
an `S₀`-algebra. -/
theorem isInvertible_twistingSheaf (hS : S.GeneratedInDegreeOne) (U : X.AffineZariskiSite) :
    (S.twistingSheaf n U).IsInvertible :=
  ProjTwistingSheaf.isInvertible (S.adjoin_eq_top_of_generatedInDegreeOne hS U) n

end QuasiCoherentGradedAlgebra

end Hartshorne
