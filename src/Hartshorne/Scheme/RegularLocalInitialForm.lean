import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Algebra.MvPolynomial.Funext
import Hartshorne.Scheme.ProjectiveSpaceChart

/-!
# Initial forms in a regular local ring

Let `(A, 𝔪, κ)` be a Noetherian local ring of dimension `d` whose maximal ideal is generated by
`x_1, …, x_d` (a regular local ring with a regular system of parameters), and assume `κ` is
infinite. Every element of `𝔪^s` is `F(x_1, …, x_d)` for a homogeneous polynomial `F` of degree
`s` with coefficients in `A`.

* `Hartshorne.RegularLocal.eval_notMem_pow_succ`: if `F` is homogeneous of degree `s` and its
  reduction modulo `𝔪` is nonzero, then `F(x) ∉ 𝔪^{s+1}`. Thus the classes of the `x_i` in
  `gr_𝔪(A)` are algebraically independent over `κ` (Matsumura, Thm 14.4, here under the extra
  hypothesis that `κ` is infinite).
* `Hartshorne.RegularLocal.mul_notMem_pow_add_succ`: the `𝔪`-adic order is additive:
  if `f ∈ 𝔪^a ∖ 𝔪^{a+1}` and `g ∈ 𝔪^b ∖ 𝔪^{b+1}`, then `fg ∉ 𝔪^{a+b+1}`.

## Proof outline

Suppose `F(x) ∈ 𝔪^{s+1}` with `F̄ ≠ 0`. As `κ` is infinite there is `a ∈ κ^d` with `a_j ≠ 0` and
`F̄(a) ≠ 0`. Lift `a` to `ã ∈ A^d`, put `u = ã_j` (a unit) and let `I` be the ideal generated by
the `d - 1` elements `u x_i - ã_i x_j` (`i ≠ j`). Modulo `I`, homogeneity gives
`u^s G(x) ≡ G(ã) x_j^s` for every homogeneous `G` of degree `s`. Taking `G = F`, where `F(ã)` is a
unit, gives `x_j^s ∈ I + 𝔪^{s+1}`, and then `𝔪^s ⊆ I + 𝔪^{s+1}` for every `G`. By Nakayama
`𝔪^s ⊆ I`, so `𝔪` is a minimal prime of an ideal with `d - 1` generators, and Krull's height
theorem gives `d = ht 𝔪 ≤ d - 1`, a contradiction.
-/

open IsLocalRing MvPolynomial

namespace Hartshorne.RegularLocal

section

variable {A : Type*} [CommRing A] [IsLocalRing A]

/-- If `x_1, …, x_d` lie in `𝔪` and `F` is homogeneous of degree `s` with every coefficient in
`𝔪`, then `F(x) ∈ 𝔪^{s+1}`. -/
theorem eval_mem_pow_succ_of_map_eq_zero {ι : Type*} {x : ι → A}
    (hx : Ideal.span (Set.range x) = maximalIdeal A) {F : MvPolynomial ι A} {s : ℕ}
    (hF : F.IsHomogeneous s) (hF0 : F.map (residue A) = 0) :
    F.eval x ∈ maximalIdeal A ^ (s + 1) := by
  rw [F.as_sum, map_sum]
  refine Ideal.sum_mem _ fun v hv ↦ ?_
  have hc : F.coeff v ∈ maximalIdeal A := by
    have := congrArg (coeff v) hF0
    rwa [coeff_map, coeff_zero, residue_eq_zero_iff] at this
  have hmon : eval x (monomial v (1 : A)) ∈ maximalIdeal A ^ s := by
    rw [← hx, Ideal.mem_span_pow_iff_exists_isHomogeneous]
    refine ⟨monomial v 1, ?_, rfl⟩
    have := hF (mem_support_iff.mp hv)
    exact isHomogeneous_monomial _ (by rw [Finsupp.degree_eq_weight_one]; exact this)
  rw [← mul_one (F.coeff v), ← C_mul_monomial, map_mul, eval_C, pow_succ']
  exact Ideal.mul_mem_mul hc hmon

/-- **Initial forms in a regular local ring.** Let `A` be a Noetherian local ring with infinite
residue field `κ`, whose maximal ideal `𝔪` is generated by `x_1, …, x_d` where `d = dim A`.
If `F ∈ A[X_1, …, X_d]` is homogeneous of degree `s` and its reduction modulo `𝔪` is nonzero,
then `F(x) ∉ 𝔪^{s+1}`: the classes of the `x_i` in `gr_𝔪(A)` are algebraically independent over
`κ`. -/
theorem eval_notMem_pow_succ [IsNoetherianRing A] [Infinite (ResidueField A)] {ι : Type*}
    [Fintype ι] {x : ι → A} (hx : Ideal.span (Set.range x) = maximalIdeal A)
    (hdim : ringKrullDim A = Fintype.card ι) {F : MvPolynomial ι A} {s : ℕ}
    (hF : F.IsHomogeneous s) (hF0 : F.map (residue A) ≠ 0) :
    F.eval x ∉ maximalIdeal A ^ (s + 1) := by
  classical
  intro hmem
  set m := maximalIdeal A
  have hxm : ∀ i, x i ∈ m := fun i ↦ hx ▸ Ideal.subset_span ⟨i, rfl⟩
  -- the residue of an evaluation is the evaluation of the reduction
  have hres : ∀ (y : ι → A) (G : MvPolynomial ι A),
      residue A (G.eval y) = (G.map (residue A)).eval (residue A ∘ y) := by
    intro y G
    rw [eval_map]
    change residue A (eval₂ (RingHom.id A) y G) = _
    rw [eval₂_comp_left, RingHom.comp_id]
  rcases isEmpty_or_nonempty ι with hι | ⟨⟨j⟩⟩
  · obtain ⟨a, ha⟩ : ∃ a : ι → ResidueField A, (F.map (residue A)).eval a ≠ 0 := by
      by_contra! h
      exact hF0 (MvPolynomial.funext fun a ↦ by rw [h a, map_zero])
    have hle : m ^ (s + 1) ≤ m := Ideal.pow_le_self (Nat.succ_ne_zero s)
    have h0 := (residue_eq_zero_iff _).mpr (hle hmem)
    rw [hres, Subsingleton.elim (residue A ∘ x) a] at h0
    exact ha h0
  -- choose `a` with `a_j ≠ 0` and `F̄(a) ≠ 0`
  obtain ⟨a, ha⟩ : ∃ a : ι → ResidueField A, (X j * F.map (residue A)).eval a ≠ 0 := by
    by_contra! h
    exact mul_ne_zero (X_ne_zero j) hF0 (MvPolynomial.funext fun a ↦ by rw [h a, map_zero])
  rw [map_mul, eval_X] at ha
  have haj : a j ≠ 0 := left_ne_zero_of_mul ha
  have haF : (F.map (residue A)).eval a ≠ 0 := right_ne_zero_of_mul ha
  choose b hb using fun i ↦ residue_surjective (a i)
  have hb' : residue A ∘ b = a := funext hb
  have hu : IsUnit (b j) :=
    notMem_maximalIdeal.mp fun h ↦ haj (by rw [← hb, residue_eq_zero_iff]; exact h)
  have hv : IsUnit (F.eval b) :=
    notMem_maximalIdeal.mp fun h ↦ haF (by rw [← hb', ← hres, residue_eq_zero_iff]; exact h)
  set I : Ideal A := Ideal.span (Set.range fun i : {i // i ≠ j} ↦ b j * x i - b i * x j)
  have hIm : I ≤ m := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact sub_mem (Ideal.mul_mem_left _ _ (hxm i)) (Ideal.mul_mem_left _ _ (hxm j))
  -- modulo `I`, `u^s G(x) ≡ G(ã) x_j^s`
  have hcong : ∀ G : MvPolynomial ι A, G.IsHomogeneous s →
      b j ^ s * G.eval x - x j ^ s * G.eval b ∈ I := by
    intro G hG
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, map_mul, map_pow, map_pow]
    set π := Ideal.Quotient.mk I
    have hπ : ∀ y : ι → A, π (G.eval y) = G.eval₂ π (π ∘ y) := by
      intro y
      change π (eval₂ (RingHom.id A) y G) = _
      rw [eval₂_comp_left, RingHom.comp_id]
    have hlin : (fun i ↦ π (b j) * (π ∘ x) i) = fun i ↦ π (x j) * (π ∘ b) i := by
      funext i
      by_cases hij : i = j
      · subst hij; simp only [Function.comp_apply, mul_comm]
      · rw [Function.comp_apply, Function.comp_apply, ← map_mul, ← map_mul,
          Ideal.Quotient.eq, mul_comm (x j)]
        exact Ideal.subset_span ⟨⟨i, hij⟩, rfl⟩
    rw [hπ, hπ, ← isHomogeneous_eval₂_mul_left hG, ← isHomogeneous_eval₂_mul_left hG, hlin,
      sub_self]
  -- hence `x_j^s ∈ I + 𝔪^{s+1}`
  have hxj : x j ^ s ∈ I ⊔ m ^ (s + 1) := by
    obtain ⟨w, hw⟩ := hv.exists_left_inv
    have h := Ideal.mul_mem_left I w (hcong F hF)
    rw [Submodule.mem_sup]
    refine ⟨-(w * (b j ^ s * F.eval x - x j ^ s * F.eval b)), I.neg_mem h,
      w * b j ^ s * F.eval x, Ideal.mul_mem_left _ _ hmem, ?_⟩
    linear_combination (x j ^ s) * hw
  -- and then `𝔪^s ⊆ I + 𝔪 • 𝔪^s`
  have hle : m ^ s ≤ I ⊔ m • m ^ s := by
    rw [Ideal.smul_eq_mul, ← pow_succ']
    intro z hz
    rw [← hx, Ideal.mem_span_pow_iff_exists_isHomogeneous] at hz
    obtain ⟨G, hG, rfl⟩ := hz
    obtain ⟨w, hw⟩ := hu.pow s |>.exists_left_inv
    have h1 : w * (b j ^ s * G.eval x - x j ^ s * G.eval b) ∈ I ⊔ m ^ (s + 1) :=
      Ideal.mem_sup_left (Ideal.mul_mem_left I w (hcong G hG))
    have h2 : w * (x j ^ s * G.eval b) ∈ I ⊔ m ^ (s + 1) :=
      Ideal.mul_mem_left _ w (Ideal.mul_mem_right _ _ hxj)
    have := add_mem h1 h2
    rwa [← mul_add, sub_add_cancel, ← mul_assoc, hw, one_mul] at this
  have hsI : m ^ s ≤ I :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (Ideal.fg_of_isNoetherianRing _)
      (maximalIdeal_le_jacobson ⊥) hle
  -- `𝔪` is a minimal prime over `I`
  have hmin : m ∈ (Ideal.span (Finset.univ.image fun i : {i // i ≠ j} ↦
      b j * x i - b i * x j : Set A)).minimalPrimes := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    refine ⟨⟨(maximalIdeal.isMaximal A).isPrime, hIm⟩, fun q hq _ ↦ ?_⟩
    have := hq.1
    exact Ideal.IsPrime.le_of_pow_le (hsI.trans hq.2)
  have hht := Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin
  have hcard : (Finset.univ.image fun i : {i // i ≠ j} ↦ b j * x i - b i * x j).card <
      Fintype.card ι := by
    refine (Finset.card_image_le).trans_lt ?_
    rw [Finset.card_univ]
    exact Fintype.card_subtype_lt (p := (· ≠ j)) (x := j) (by simp)
  have hm : (m.height : WithBot ℕ∞) = Fintype.card ι := by
    rw [maximalIdeal_height_eq_ringKrullDim, hdim]
  have hm' : m.height = Fintype.card ι := by exact_mod_cast hm
  rw [hm'] at hht
  exact absurd (Nat.cast_le.mp hht) (not_le.mpr hcard)

end

section

variable {A : Type*} [CommRing A]

/-- **The order is additive in a regular local ring** with infinite residue field: if
`f ∈ 𝔪^a ∖ 𝔪^{a+1}` and `g ∈ 𝔪^b ∖ 𝔪^{b+1}`, then `fg ∉ 𝔪^{a+b+1}`. -/
theorem mul_notMem_pow_add_succ [IsRegularLocalRing A] [Infinite (ResidueField A)] {f g : A}
    {a b : ℕ} (hf : f ∈ maximalIdeal A ^ a) (hf' : f ∉ maximalIdeal A ^ (a + 1))
    (hg : g ∈ maximalIdeal A ^ b) (hg' : g ∉ maximalIdeal A ^ (b + 1)) :
    f * g ∉ maximalIdeal A ^ (a + b + 1) := by
  obtain ⟨t, htcard, htspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank (maximalIdeal A).fg_of_isNoetherianRing
  have hx : Ideal.span (Set.range ((↑) : t → A)) = maximalIdeal A := by
    rw [Subtype.range_coe_subtype, Finset.setOfPred_mem]
    exact htspan
  have hdim : ringKrullDim A = Fintype.card t := by
    rw [Fintype.card_coe, htcard, IsRegularLocalRing.spanFinrank_maximalIdeal]
  rw [← hx, Ideal.mem_span_pow_iff_exists_isHomogeneous] at hf hg
  obtain ⟨F, hF, rfl⟩ := hf
  obtain ⟨G, hG, rfl⟩ := hg
  have hF0 : F.map (residue A) ≠ 0 := fun h ↦ hf' (eval_mem_pow_succ_of_map_eq_zero hx hF h)
  have hG0 : G.map (residue A) ≠ 0 := fun h ↦ hg' (eval_mem_pow_succ_of_map_eq_zero hx hG h)
  rw [← map_mul]
  exact eval_notMem_pow_succ hx hdim (hF.mul hG) (by rw [map_mul]; exact mul_ne_zero hF0 hG0)

end

end Hartshorne.RegularLocal
