import Hartshorne.Scheme.FormalSpectrum
import Hartshorne.Scheme.FormalCompletionAffineSections
import Hartshorne.Scheme.CompletedIdealPowers

/-!
# Thickenings of an affine formal scheme

Hartshorne, *Algebraic Geometry*, II.9, Proposition 9.4(a) (pp. 195–196).

Let `I` be a quasi-coherent ideal subsheaf of `𝒪_X` cutting out `Y`, let `X̂ = X̂_Y` be the formal
completion, with structure sheaf `𝒪_{X̂} = lim_n 𝒪_{Y_(n+1)}` on `|Y|`, and write
`πₙ : 𝒪_{X̂} ⟶ 𝒪_{Y_(n+1)}` for the projections.

* `Hartshorne.QuasicoherentIdealSubsheaf.formalCompletionIdeal I V`: the ideal
  `J(V) = ker (𝒪_{X̂}(V) → 𝒪_Y(V))`; these ideals form an ideal subsheaf `J` of `𝒪_{X̂}`
  (`formalCompletionIdeal_le_comap`, `mem_formalCompletionIdeal_of_locally`). On every affine
  open `U = Spec B` of `X` it is the completed ideal `I(U) B̂` of `B̂`
  (`formalCompletionAffineSectionsIso_formalCompletionIdeal`), that is, `J` is the completion of
  the ideal sheaf `I`.
* `Hartshorne.sheafIdealPow`: the `k`-th power of an ideal subsheaf, the ideal subsheaf of
  sections lying locally in the `k`-th powers of the ideals of sections.
* `Hartshorne.idealQuotientSheaf F K`: the quotient sheaf of rings `F / K`, the sheaf associated
  to `V ↦ F(V) ⧸ K(V)`; `Hartshorne.idealQuotientSheafIso`: a locally surjective morphism of
  sheaves of rings `F ⟶ G` with kernel `K` induces `F / K ≅ G`.
* `Hartshorne.QuasicoherentIdealSubsheaf.mem_formalCompletionIdealPow_iff`: for `X` locally
  Noetherian, `J ^ (n + 1)` is exactly the kernel of `πₙ`.
* `Hartshorne.QuasicoherentIdealSubsheaf.isLocallySurjective_formalCompletionπ`: `πₙ` is locally
  surjective (it is surjective on every `U ∩ |Y|`, `U` affine).
* `Hartshorne.QuasicoherentIdealSubsheaf.formalCompletionQuotientIso`: hence
  `𝒪_{X̂} / J ^ (n + 1) ≅ 𝒪_{Y_(n+1)}` for `X` locally Noetherian.
* `Hartshorne.specIdealSubsheafNeighborhoodIso`: for `X = Spec A`, `Y_k ≅ Spec (A ⧸ I ^ k)`.
* `Hartshorne.affineFormalThickenings`: Hartshorne's Proposition 9.4(a) for `Spf_I(A)`: `J` is an
  ideal subsheaf of `𝒪_{X̂}`, it is the completion of the ideal sheaf of `I`, and
  `𝒪_{X̂} / J ^ (n + 1) ≅ 𝒪_{Y_(n+1)}`, the structure sheaf of the closed subscheme
  `Y_(n+1) ≅ Spec (A ⧸ I ^ (n + 1))` of `Spec A`, transported to `V(I)`.

Hartshorne states the result for `X = Spec A` with `A` Noetherian; the sheaf-level statements are
proved here for every locally Noetherian scheme `X`, which supplements his result.
-/

noncomputable section

open CategoryTheory Limits AlgebraicGeometry Topology Opposite TopologicalSpace

namespace Hartshorne

universe u

section SheafIdealPow

variable {T : TopCat.{u}} (F : TopCat.Sheaf CommRingCat.{u} T)

/-- The `k`-th power of a family of ideals `J(V) ⊆ F(V)` of a sheaf of rings, as an ideal subsheaf:
the sections lying, near every point, in the `k`-th power of the ideal of sections. This is the
ideal subsheaf generated by the presheaf `V ↦ J(V) ^ k`. -/
def sheafIdealPow (J : ∀ V : Opens T, Ideal (F.presheaf.obj (op V)))
    (hJ : ∀ {V W : Opens T} (h : W ≤ V), J V ≤ (J W).comap (F.presheaf.map (homOfLE h).op).hom)
    (k : ℕ) (V : Opens T) : Ideal (F.presheaf.obj (op V)) where
  carrier := {s | ∀ x ∈ V, ∃ (W : Opens T) (h : W ≤ V), x ∈ W ∧
    F.presheaf.map (homOfLE h).op s ∈ J W ^ k}
  zero_mem' := fun x hx => ⟨V, le_rfl, hx, by rw [map_zero]; exact zero_mem _⟩
  add_mem' := by
    intro s t hs ht x hx
    obtain ⟨W₁, h₁, hx₁, hs₁⟩ := hs x hx
    obtain ⟨W₂, h₂, hx₂, ht₂⟩ := ht x hx
    refine ⟨W₁ ⊓ W₂, inf_le_left.trans h₁, ⟨hx₁, hx₂⟩, ?_⟩
    have e₁ : F.presheaf.map (homOfLE (inf_le_left.trans h₁ : W₁ ⊓ W₂ ≤ V)).op =
        F.presheaf.map (homOfLE h₁).op ≫ F.presheaf.map (homOfLE inf_le_left).op := by
      rw [← Functor.map_comp]; rfl
    have e₂ : F.presheaf.map (homOfLE (inf_le_left.trans h₁ : W₁ ⊓ W₂ ≤ V)).op =
        F.presheaf.map (homOfLE h₂).op ≫ F.presheaf.map (homOfLE inf_le_right).op := by
      rw [← Functor.map_comp]; rfl
    rw [map_add]
    refine add_mem ?_ ?_
    · rw [e₁, CommRingCat.comp_apply]
      exact pow_le_comap_pow (hJ inf_le_left) k hs₁
    · rw [e₂, CommRingCat.comp_apply]
      exact pow_le_comap_pow (hJ inf_le_right) k ht₂
  smul_mem' := by
    intro r s hs x hx
    obtain ⟨W, h, hxW, hsW⟩ := hs x hx
    refine ⟨W, h, hxW, ?_⟩
    rw [smul_eq_mul, map_mul]
    exact Ideal.mul_mem_left _ _ hsW

/-- The powers of an ideal subsheaf are stable under restriction. -/
lemma sheafIdealPow_le_comap (J : ∀ V : Opens T, Ideal (F.presheaf.obj (op V)))
    (hJ : ∀ {V W : Opens T} (h : W ≤ V), J V ≤ (J W).comap (F.presheaf.map (homOfLE h).op).hom)
    (k : ℕ) {V W : Opens T} (h : W ≤ V) :
    sheafIdealPow F J hJ k V ≤
      (sheafIdealPow F J hJ k W).comap (F.presheaf.map (homOfLE h).op).hom := by
  intro s hs x hx
  obtain ⟨W', h', hxW', hsW'⟩ := hs x (h hx)
  refine ⟨W ⊓ W', inf_le_left, ⟨hx, hxW'⟩, ?_⟩
  have e : F.presheaf.map (homOfLE h).op ≫ F.presheaf.map (homOfLE (inf_le_left : W ⊓ W' ≤ W)).op =
      F.presheaf.map (homOfLE h').op ≫ F.presheaf.map (homOfLE inf_le_right).op := by
    rw [← Functor.map_comp, ← Functor.map_comp]; rfl
  change (F.presheaf.map (homOfLE h).op ≫ F.presheaf.map (homOfLE inf_le_left).op) s ∈ _
  rw [e, CommRingCat.comp_apply]
  exact pow_le_comap_pow (hJ inf_le_right) k hsW'

/-- The powers of an ideal subsheaf are local: a section lying locally in `J ^ k` lies in it. -/
lemma mem_sheafIdealPow_of_locally (J : ∀ V : Opens T, Ideal (F.presheaf.obj (op V)))
    (hJ : ∀ {V W : Opens T} (h : W ≤ V), J V ≤ (J W).comap (F.presheaf.map (homOfLE h).op).hom)
    (k : ℕ) {V : Opens T} (s : F.presheaf.obj (op V))
    (hs : ∀ x ∈ V, ∃ (W : Opens T) (h : W ≤ V), x ∈ W ∧
      F.presheaf.map (homOfLE h).op s ∈ sheafIdealPow F J hJ k W) :
    s ∈ sheafIdealPow F J hJ k V := by
  intro x hx
  obtain ⟨W, h, hxW, hsW⟩ := hs x hx
  obtain ⟨W', h', hxW', hsW'⟩ := hsW x hxW
  refine ⟨W', h'.trans h, hxW', ?_⟩
  have e : F.presheaf.map (homOfLE (h'.trans h)).op =
      F.presheaf.map (homOfLE h).op ≫ F.presheaf.map (homOfLE h').op := by
    rw [← Functor.map_comp]; rfl
  rw [e, CommRingCat.comp_apply]
  exact hsW'

end SheafIdealPow

section IdealQuotient

variable {T : TopCat.{u}} (F : TopCat.Sheaf CommRingCat.{u} T)
  (K : ∀ V : Opens T, Ideal (F.presheaf.obj (op V)))
  (hK : ∀ {V W : Opens T} (h : W ≤ V), K V ≤ (K W).comap (F.presheaf.map (homOfLE h).op).hom)

/-- The presheaf of rings `V ↦ F(V) ⧸ K(V)` for a family of ideals `K(V) ⊆ F(V)` stable under
restriction. -/
def idealQuotientPresheaf : (Opens T)ᵒᵖ ⥤ CommRingCat.{u} where
  obj V := CommRingCat.of (F.presheaf.obj V ⧸ K V.unop)
  map {V W} i := CommRingCat.ofHom (Ideal.quotientMap (K W.unop) (F.presheaf.map i).hom
    (by simpa only [show i = (homOfLE i.unop.le).op from rfl] using hK i.unop.le))
  map_id V := by
    ext s
    simp only [CommRingCat.hom_ofHom, CategoryTheory.Functor.map_id, CommRingCat.hom_id]
    rfl
  map_comp {V W Z} i j := by
    ext s
    simp only [CommRingCat.hom_ofHom, Ideal.quotientMap_mk, Functor.map_comp,
      CommRingCat.hom_comp, RingHom.comp_apply]

/-- **The quotient sheaf of rings** `F / K`: the sheaf associated to the presheaf
`V ↦ F(V) ⧸ K(V)`. -/
def idealQuotientSheaf : TopCat.Sheaf CommRingCat.{u} T :=
  (presheafToSheaf (Opens.grothendieckTopology T) CommRingCat.{u}).obj
    (idealQuotientPresheaf F K hK)

variable {F K} {G : TopCat.Sheaf CommRingCat.{u} T} (φ : F ⟶ G)
  (hker : ∀ V : Opens T, K V = RingHom.ker (φ.hom.app (op V)).hom)

/-- The map `F(V) ⧸ K(V) → G(V)` induced by `φ` when `K(V) = ker φ`. -/
def idealQuotientPresheafLift : idealQuotientPresheaf F K hK ⟶ G.presheaf where
  app V := CommRingCat.ofHom (Ideal.Quotient.lift (K V.unop) (φ.hom.app V).hom
    (fun s hs => by rw [hker V.unop] at hs; exact hs))
  naturality V W i := by
    ext x
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective (x : F.presheaf.obj V ⧸ K V.unop)
    change (φ.hom.app W) (F.presheaf.map i s) = G.presheaf.map i ((φ.hom.app V) s)
    exact NatTrans.naturality_apply φ.hom i s

lemma injective_idealQuotientPresheafLift_app (V : (Opens T)ᵒᵖ) :
    Function.Injective ((idealQuotientPresheafLift hK φ hker).app V) := by
  refine (injective_iff_map_eq_zero ((idealQuotientPresheafLift hK φ hker).app V).hom).mpr ?_
  intro x hx
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective (x : F.presheaf.obj V ⧸ K V.unop)
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (by rw [hker V.unop]; exact hx)

variable (hφ : TopCat.Presheaf.IsLocallySurjective φ.hom)
include hφ

lemma isLocallySurjective_idealQuotientPresheafLift :
    Presheaf.IsLocallySurjective (Opens.grothendieckTopology T)
      (idealQuotientPresheafLift hK φ hker) := by
  rw [← TopCat.Presheaf.IsLocallySurjective, TopCat.Presheaf.isLocallySurjective_iff]
  intro V t x hx
  obtain ⟨W, hWV, ⟨s, hs⟩, hxW⟩ :=
    (TopCat.Presheaf.isLocallySurjective_iff φ.hom).mp hφ V t x hx
  exact ⟨W, hWV, ⟨Ideal.Quotient.mk _ s, hs⟩, hxW⟩

/-- **Quotient by a kernel.** If `φ : F ⟶ G` is a locally surjective morphism of sheaves of rings
with kernel `K`, then `F / K ≅ G`. -/
lemma isIso_presheafToSheaf_map_idealQuotientPresheafLift :
    IsIso ((presheafToSheaf (Opens.grothendieckTopology T) CommRingCat.{u}).map
      (idealQuotientPresheafLift hK φ hker)) := by
  have := Presheaf.isLocallyInjective_of_injective (Opens.grothendieckTopology T)
    (idealQuotientPresheafLift hK φ hker) (injective_idealQuotientPresheafLift_app hK φ hker)
  have := isLocallySurjective_idealQuotientPresheafLift hK φ hker hφ
  exact ((Opens.grothendieckTopology T).W_iff _).mp
    ((Opens.grothendieckTopology T).W_of_isLocallyBijective _)

/-- **Quotient by a kernel.** If `φ : F ⟶ G` is a locally surjective morphism of sheaves of rings
with kernel `K`, then `F / K ≅ G`. -/
def idealQuotientSheafIso : idealQuotientSheaf F K hK ≅ G :=
  @asIso _ _ _ _ ((presheafToSheaf (Opens.grothendieckTopology T) CommRingCat.{u}).map
      (idealQuotientPresheafLift hK φ hker))
    (isIso_presheafToSheaf_map_idealQuotientPresheafLift hK φ hker hφ) ≪≫
    (sheafificationIso G).symm

end IdealQuotient

namespace QuasicoherentIdealSubsheaf

variable {X : Scheme.{u}} (I : QuasicoherentIdealSubsheaf X)

/-- The projection `πₙ : 𝒪_{X̂} ⟶ 𝒪_{Y_(n+1)}` from the structure sheaf of the formal
completion. -/
abbrev formalCompletionπ (n : ℕ) : I.formalCompletionSheaf ⟶ I.formalCompletionSheafObj n :=
  limit.π I.formalCompletionDiagram (op n)

/-- **The ideal `J` of `𝒪_{X̂}`**: over `V`, the kernel of `π₀ : 𝒪_{X̂}(V) → 𝒪_Y(V)`. On affine
opens it is the completion of the ideal sheaf `I`
(`formalCompletionAffineSectionsIso_formalCompletionIdeal`). -/
def formalCompletionIdeal (V : Opens (I.infinitesimalNeighborhood 1)) :
    Ideal (I.formalCompletionSheaf.presheaf.obj (op V)) :=
  RingHom.ker ((I.formalCompletionπ 0).hom.app (op V)).hom

lemma mem_formalCompletionIdeal_iff (V : Opens (I.infinitesimalNeighborhood 1))
    (s : I.formalCompletionSheaf.presheaf.obj (op V)) :
    s ∈ I.formalCompletionIdeal V ↔ (I.formalCompletionπ 0).hom.app (op V) s = 0 :=
  Iff.rfl

/-- The ideals `J(V)` are stable under restriction. -/
lemma formalCompletionIdeal_le_comap {V W : Opens (I.infinitesimalNeighborhood 1)} (h : W ≤ V) :
    I.formalCompletionIdeal V ≤ (I.formalCompletionIdeal W).comap
      (I.formalCompletionSheaf.presheaf.map (homOfLE h).op).hom := by
  intro s hs
  change (I.formalCompletionπ 0).hom.app (op W)
    (I.formalCompletionSheaf.presheaf.map (homOfLE h).op s) = 0
  rw [NatTrans.naturality_apply, (I.mem_formalCompletionIdeal_iff V s).mp hs, map_zero]

/-- The ideals `J(V)` are local: a section lying locally in `J` lies in `J`. Together with
`formalCompletionIdeal_le_comap`, `J` is an ideal subsheaf of `𝒪_{X̂}`. -/
lemma mem_formalCompletionIdeal_of_locally {V : Opens (I.infinitesimalNeighborhood 1)}
    (s : I.formalCompletionSheaf.presheaf.obj (op V))
    (hs : ∀ x ∈ V, ∃ (W : Opens (I.infinitesimalNeighborhood 1)) (h : W ≤ V), x ∈ W ∧
      I.formalCompletionSheaf.presheaf.map (homOfLE h).op s ∈ I.formalCompletionIdeal W) :
    s ∈ I.formalCompletionIdeal V := by
  refine TopCat.Presheaf.section_ext (I.formalCompletionSheafObj 0) V _ _ fun x hx => ?_
  obtain ⟨W, h, hxW, hsW⟩ := hs x hx
  rw [map_zero, ← TopCat.Presheaf.germ_res_apply _ (homOfLE h) x hxW, ← NatTrans.naturality_apply,
    (I.mem_formalCompletionIdeal_iff W _).mp hsW, map_zero]

/-- The opens `U ∩ |Y|`, `U` affine, form a basis of `|Y|`. -/
lemma exists_affineOpens_preimage_le {V : Opens (I.infinitesimalNeighborhood 1)}
    {x : I.infinitesimalNeighborhood 1} (hx : x ∈ V) :
    ∃ U : X.affineOpens, x ∈ (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)) ∧ (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)) ≤ V := by
  obtain ⟨t, ht, hV⟩ := ((I.infinitesimalNeighborhoodι 1).isClosedEmbedding.isInducing.isOpen_iff
    (s := (V : Set (I.infinitesimalNeighborhood 1)))).mp V.isOpen
  have hxt : (I.infinitesimalNeighborhoodι 1) x ∈ t := by
    have : x ∈ (I.infinitesimalNeighborhoodι 1) ⁻¹' t := hV ▸ hx
    exact this
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUt⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxt ht
  refine ⟨⟨U, hU⟩, hxU, fun y hy => ?_⟩
  change y ∈ (V : Set (I.infinitesimalNeighborhood 1))
  rw [← hV]
  exact hUt hy

section Affine

variable (U : X.affineOpens)

/-- On `U ∩ |Y|`, `U = Spec B` affine, the kernel of `πₙ` corresponds to the kernel of the
reduction `B̂ → B ⧸ I(U) ^ (n + 1)`. -/
lemma formalCompletionπ_eq_zero_iff (n : ℕ)
    (s : I.formalCompletionSheaf.presheaf.obj (op (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)))) :
    (I.formalCompletionπ n).hom.app (op (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens))) s = 0 ↔
      AdicCompletion.evalₐ (I.ideal U) (n + 1) (I.formalCompletionAffineSectionsIso U s) = 0 := by
  refine Iff.trans ?_ (map_eq_zero_iff _ (I.formalCompletionSheafObjAffineEquiv U n).injective)
  rw [I.formalCompletionSheafObjAffineEquiv_evalₐ_formalCompletionAffineSectionsIso U n s]
  exact Iff.rfl

/-- For a Noetherian ring `B`, the kernel of the reduction `B̂ → B ⧸ 𝔞 ^ (n + 1)` is
`𝔞 ^ (n + 1) B̂` (Hartshorne II.9.3A(a)). -/
lemma ker_evalₐ_eq_map {B : Type u} [CommRing B] [IsNoetherianRing B] (𝔞 : Ideal B) (n : ℕ) :
    RingHom.ker (AdicCompletion.evalₐ 𝔞 (n + 1)).toRingHom =
      (𝔞 ^ (n + 1)).map (algebraMap B (AdicCompletion 𝔞 B)) := by
  obtain ⟨e, he⟩ := exists_adicCompletionQuotientRingEquiv 𝔞 n
  have h0 : RingHom.ker e.toRingHom = ⊥ := (RingHom.injective_iff_ker_eq_bot _).mp e.injective
  rw [← he, ← RingHom.comap_ker, h0, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]

variable [IsLocallyNoetherian X]

/-- **The completed ideal on affine opens.** On `U ∩ |Y|`, `U = Spec B` affine, the ideal `J`
corresponds under `Γ(U ∩ |Y|, 𝒪_{X̂}) ≅ B̂` to the extension `I(U) B̂` of `I(U)`, that is, to the
completion `Î(U)` of `I(U)` (Hartshorne II.9.3A, `completedIdealMap_range`). -/
theorem formalCompletionAffineSectionsIso_formalCompletionIdeal :
    (I.formalCompletionIdeal (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens))).map (I.formalCompletionAffineSectionsIso U) =
      (I.ideal U).map (algebraMap Γ(X, U) (AdicCompletion (I.ideal U) Γ(X, U))) := by
  have := IsLocallyNoetherian.component_noetherian U
  rw [← Ideal.comap_symm]
  ext y
  rw [Ideal.mem_comap, mem_formalCompletionIdeal_iff, formalCompletionπ_eq_zero_iff,
    RingEquiv.apply_symm_apply]
  have h := ker_evalₐ_eq_map (I.ideal U) 0
  have h1 : (I.ideal U ^ (0 + 1)).map (algebraMap Γ(X, U) (AdicCompletion (I.ideal U) Γ(X, U))) =
      (I.ideal U).map (algebraMap Γ(X, U) (AdicCompletion (I.ideal U) Γ(X, U))) := by
    rw [zero_add, _root_.pow_one]
  rw [← h1, ← h]
  exact Iff.rfl

/-- On `U ∩ |Y|`, `U` affine, `J(U ∩ |Y|) ^ (n + 1)` is the kernel of `πₙ`. -/
theorem formalCompletionIdeal_pow_eq_ker (n : ℕ) :
    I.formalCompletionIdeal (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)) ^ (n + 1) =
      RingHom.ker ((I.formalCompletionπ n).hom.app (op (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)))).hom := by
  have := IsLocallyNoetherian.component_noetherian U
  have hker : RingHom.ker ((I.formalCompletionπ n).hom.app (op (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)))).hom =
      ((I.ideal U ^ (n + 1)).map (algebraMap Γ(X, U) (AdicCompletion (I.ideal U) Γ(X, U)))).map
        (I.formalCompletionAffineSectionsIso U).symm := by
    rw [Ideal.map_symm, ← ker_evalₐ_eq_map]
    ext s
    exact I.formalCompletionπ_eq_zero_iff U n s
  rw [hker, Ideal.map_pow, ← formalCompletionAffineSectionsIso_formalCompletionIdeal,
    Ideal.map_pow, Ideal.map_symm, Ideal.comap_map_of_bijective _
      (I.formalCompletionAffineSectionsIso U).bijective]

end Affine

/-- `πₙ` is surjective on the sections over `U ∩ |Y|` for `U` affine. -/
lemma surjective_formalCompletionπ_app (n : ℕ) (U : X.affineOpens) :
    Function.Surjective ((I.formalCompletionπ n).hom.app (op (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)))).hom := by
  intro t
  obtain ⟨a, rfl⟩ := I.surjective_formalCompletionSheafObjSectionsMap n U t
  exact ⟨I.formalCompletionSectionsMap U a,
    congrArg (fun φ => φ a) (I.formalCompletionSectionsMap_π U n)⟩

/-- **`πₙ` is locally surjective**: every section of `𝒪_{Y_(n+1)}` lifts to `𝒪_{X̂}` locally,
namely on every `U ∩ |Y|` with `U` affine. -/
theorem isLocallySurjective_formalCompletionπ (n : ℕ) :
    TopCat.Presheaf.IsLocallySurjective (I.formalCompletionπ n).hom := by
  rw [TopCat.Presheaf.isLocallySurjective_iff]
  intro V t x hx
  obtain ⟨U, hxU, hUV⟩ := I.exists_affineOpens_preimage_le hx
  obtain ⟨s, hs⟩ := I.surjective_formalCompletionπ_app n U
    ((I.formalCompletionSheafObj n).presheaf.map (homOfLE hUV).op t)
  exact ⟨_, hUV, ⟨s, hs⟩, hxU⟩

/-- The ideal sheaf `J ^ k` of `𝒪_{X̂}`. -/
abbrev formalCompletionIdealPow (k : ℕ) (V : Opens (I.infinitesimalNeighborhood 1)) :
    Ideal (I.formalCompletionSheaf.presheaf.obj (op V)) :=
  sheafIdealPow I.formalCompletionSheaf I.formalCompletionIdeal
    (fun h => I.formalCompletionIdeal_le_comap h) k V

/-- **`J ^ (n + 1)` is the kernel of `πₙ`** for `X` locally Noetherian: a section of `𝒪_{X̂}` lies
in `J ^ (n + 1)` if and only if its image in `𝒪_{Y_(n+1)}` vanishes. -/
theorem mem_formalCompletionIdealPow_iff [IsLocallyNoetherian X] (n : ℕ)
    (V : Opens (I.infinitesimalNeighborhood 1)) (s : I.formalCompletionSheaf.presheaf.obj (op V)) :
    s ∈ I.formalCompletionIdealPow (n + 1) V ↔ (I.formalCompletionπ n).hom.app (op V) s = 0 := by
  constructor
  · intro hs
    refine TopCat.Presheaf.section_ext (I.formalCompletionSheafObj n) V _ _ fun x hx => ?_
    obtain ⟨W, h, hxW, hsW⟩ := hs x hx
    obtain ⟨U, hxU, hUW⟩ := I.exists_affineOpens_preimage_le hxW
    have hU : I.formalCompletionSheaf.presheaf.map (homOfLE (hUW.trans h)).op s ∈
        RingHom.ker ((I.formalCompletionπ n).hom.app (op (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)))).hom := by
      rw [← formalCompletionIdeal_pow_eq_ker]
      have e : I.formalCompletionSheaf.presheaf.map (homOfLE (hUW.trans h)).op =
          I.formalCompletionSheaf.presheaf.map (homOfLE h).op ≫
            I.formalCompletionSheaf.presheaf.map (homOfLE hUW).op := by
        rw [← Functor.map_comp]; rfl
      rw [e, CommRingCat.comp_apply]
      exact pow_le_comap_pow (I.formalCompletionIdeal_le_comap hUW) (n + 1) hsW
    rw [map_zero, ← TopCat.Presheaf.germ_res_apply _ (homOfLE (hUW.trans h)) x hxU,
      ← NatTrans.naturality_apply]
    rw [RingHom.mem_ker] at hU
    erw [hU]
    rw [map_zero]
  · intro hs x hx
    obtain ⟨U, hxU, hUV⟩ := I.exists_affineOpens_preimage_le hx
    refine ⟨_, hUV, hxU, ?_⟩
    rw [formalCompletionIdeal_pow_eq_ker, RingHom.mem_ker]
    change (I.formalCompletionπ n).hom.app (op (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens)))
      (I.formalCompletionSheaf.presheaf.map (homOfLE hUV).op s) = 0
    rw [NatTrans.naturality_apply, hs, map_zero]

/-- **The completed ideal on affine opens.** On `U ∩ |Y|`, `U = Spec B` affine, the ideal `J`
corresponds under `Γ(U ∩ |Y|, 𝒪_{X̂}) ≅ B̂` to the image of the completion
`Î(U) = lim_n I(U) ⧸ I(U) ^ n` of the ideal `I(U)` in `B̂` (Hartshorne II.9.3A). -/
theorem formalCompletionAffineSectionsIso_formalCompletionIdeal_eq_range [IsLocallyNoetherian X]
    (U : X.affineOpens) :
    (I.formalCompletionIdeal (I.infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : X.Opens))).map
        (I.formalCompletionAffineSectionsIso U) =
      LinearMap.range (completedIdealMap (I.ideal U) (I.ideal U)) := by
  have := IsLocallyNoetherian.component_noetherian U
  rw [formalCompletionAffineSectionsIso_formalCompletionIdeal, completedIdealMap_range]
  rfl

/-- The ideal subsheaves `J ^ k` are stable under restriction. -/
lemma formalCompletionIdealPow_le_comap (k : ℕ) {V W : Opens (I.infinitesimalNeighborhood 1)}
    (h : W ≤ V) :
    I.formalCompletionIdealPow k V ≤ (I.formalCompletionIdealPow k W).comap
      (I.formalCompletionSheaf.presheaf.map (homOfLE h).op).hom :=
  sheafIdealPow_le_comap _ _ _ k h

/-- **The quotient sheaf** `𝒪_{X̂} / J ^ k` of rings on `|Y|`. -/
abbrev formalCompletionQuotient (k : ℕ) :
    TopCat.Sheaf CommRingCat.{u} (I.infinitesimalNeighborhood 1) :=
  idealQuotientSheaf I.formalCompletionSheaf (I.formalCompletionIdealPow k)
    (fun h => I.formalCompletionIdealPow_le_comap k h)

/-- **The thickenings of a formal completion** (Hartshorne II.9.4(a), there for `X` affine
Noetherian; this supplements it to locally Noetherian `X`): `𝒪_{X̂} / J ^ (n + 1) ≅ 𝒪_{Y_(n+1)}`,
induced by `πₙ`. -/
def formalCompletionQuotientIso [IsLocallyNoetherian X] (n : ℕ) :
    I.formalCompletionQuotient (n + 1) ≅ I.formalCompletionSheafObj n :=
  idealQuotientSheafIso _ (I.formalCompletionπ n)
    (fun V => by ext s; exact I.mem_formalCompletionIdealPow_iff n V s)
    (I.isLocallySurjective_formalCompletionπ n)

end QuasicoherentIdealSubsheaf

section SpecThickening

variable (A : Type u) [CommRing A] (I : Ideal A)

/-- The kernel of `Γ(Spec A, 𝒪) → Γ(Spec (A ⧸ J), 𝒪)` is `J`, read in `Γ(Spec A, 𝒪) ≅ A`. -/
private lemma ker_appTop_spec_map_quotient_mk (J : Ideal A) :
    RingHom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))).appTop.hom =
      J.comap (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom := by
  have h := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (Ideal.Quotient.mk J))
  have hinj : Function.Injective (Scheme.ΓSpecIso (CommRingCat.of (A ⧸ J))).hom.hom :=
    ((ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of (A ⧸ J))).hom)).1
  rw [← RingHom.ker_comp_of_injective _ hinj, ← CommRingCat.hom_comp, h, CommRingCat.hom_comp,
    ← RingHom.comap_ker, CommRingCat.hom_ofHom, Ideal.mk_ker]

/-- The `k`-th power of the ideal sheaf attached to `I` is the ideal sheaf attached to `I ^ k`. -/
theorem specIdealSubsheaf_pow (k : ℕ) : specIdealSubsheaf A I ^ k = specIdealSubsheaf A (I ^ k) := by
  apply quasicoherentIdealSubsheafEquiv.injective
  rw [quasicoherentIdealSubsheafEquiv_pow]
  simp only [specIdealSubsheaf, Equiv.apply_symm_apply]
  apply Scheme.IdealSheafData.ext_of_isAffine
  simp only [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply]
  rw [Scheme.ker_of_isAffine,
    Scheme.ker_of_isAffine, Scheme.IdealSheafData.ofIdealTop_ideal,
    Scheme.IdealSheafData.ofIdealTop_ideal, ker_appTop_spec_map_quotient_mk,
    ker_appTop_spec_map_quotient_mk]
  let e := (Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv
  change (Ideal.comap e I).map _ ^ k = (Ideal.comap e (I ^ k)).map _
  rw [← Ideal.map_symm, ← Ideal.map_symm, Ideal.map_pow, Ideal.map_pow]

private lemma quasicoherentIdealSubsheafEquiv_specIdealSubsheaf_pow (k : ℕ) :
    quasicoherentIdealSubsheafEquiv (specIdealSubsheaf A I ^ k) =
      quasicoherentIdealSubsheafEquiv (specIdealSubsheaf A (I ^ k) ^ 1) := by
  rw [specIdealSubsheaf_pow, QuasicoherentIdealSubsheaf.pow_one]

/-- The closed subschemes cut out by equal ideal data are isomorphic over `X`. -/
private def subschemeIsoOfEq' {X : Scheme.{u}} {J K : X.IdealSheafData} (h : J = K) :
    J.subscheme ≅ K.subscheme where
  hom := Scheme.IdealSheafData.inclusion h.ge
  inv := Scheme.IdealSheafData.inclusion h.le
  hom_inv_id := by simp
  inv_hom_id := by simp

/-- **The thickenings of `Spec A` along `V(I)`.** The closed subscheme `Y_k` of `Spec A` cut out
by the `k`-th power of the ideal sheaf attached to `I` is `Spec (A ⧸ I ^ k)`; in particular its
structure sheaf is `(A ⧸ I ^ k)~`. -/
def specIdealSubsheafNeighborhoodIso (k : ℕ) :
    (specIdealSubsheaf A I).infinitesimalNeighborhood k ≅
      Spec (CommRingCat.of (A ⧸ I ^ k)) :=
  subschemeIsoOfEq' (quasicoherentIdealSubsheafEquiv_specIdealSubsheaf_pow A I k) ≪≫
    specIdealSubsheafNeighborhoodOneIso A (I ^ k)

/-- The identification `Y_k ≅ Spec (A ⧸ I ^ k)` is compatible with the closed immersions into
`Spec A`. -/
@[reassoc (attr := simp)]
theorem specIdealSubsheafNeighborhoodIso_hom_comp (k : ℕ) :
    (specIdealSubsheafNeighborhoodIso A I k).hom ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I ^ k))) =
      (specIdealSubsheaf A I).infinitesimalNeighborhoodι k := by
  change (Scheme.IdealSheafData.inclusion _ ≫ (specIdealSubsheafNeighborhoodOneIso A (I ^ k)).hom) ≫
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I ^ k))) = _
  refine (Category.assoc _ _ _).trans ?_
  refine (congrArg (Scheme.IdealSheafData.inclusion _ ≫ ·)
    (specIdealSubsheafNeighborhoodOneIso_hom_comp A (I ^ k))).trans ?_
  exact Scheme.IdealSheafData.inclusion_subschemeι _

end SpecThickening

/-- **Hartshorne II.9, Proposition 9.4(a).** Let `A` be a Noetherian ring, `I ⊆ A` an ideal, and
`X̂ = Spf_I(A)` the completion of `Spec A` along `V(I)`, with structure sheaf `𝒪_{X̂}` on `V(I)`.
Let `J ⊆ 𝒪_{X̂}` be the ideal of sections vanishing in `𝒪_{Y_1} = 𝒪_{Spec (A ⧸ I)}`. Then
* `J` is an ideal subsheaf of `𝒪_{X̂}` (stable under restriction, and local);
* `J` is the completion of the ideal sheaf `Ĩ`: over `U ∩ V(I)`, `U = Spec B` affine, under
  `Γ(U ∩ V(I), 𝒪_{X̂}) ≅ B̂` it is the image of the completion `Î(U)` of the ideal `I(U) ⊆ B`;
* for every `n ≥ 0`, `𝒪_{X̂} / J ^ (n + 1) ≅ 𝒪_{Y_(n+1)}`, the structure sheaf of the closed
  subscheme `Y_(n+1)` of `Spec A` cut out by `Ĩ ^ (n + 1)`, transported to `V(I)`; and
  `Y_(n+1) ≅ Spec (A ⧸ I ^ (n + 1))` over `Spec A`, so that this structure sheaf is
  `(A ⧸ I ^ (n + 1))~`. Here `J ^ (n + 1)` is the ideal-subsheaf power and the quotient is the
  sheaf associated to `V ↦ 𝒪_{X̂}(V) ⧸ J ^ (n + 1)(V)`. -/
theorem affineFormalThickenings (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A) :
    (∀ {V W : Opens (Spf A I).carrier} (h : W ≤ V),
      (specIdealSubsheaf A I).formalCompletionIdeal V ≤
        ((specIdealSubsheaf A I).formalCompletionIdeal W).comap
          ((Spf A I).presheaf.map (homOfLE h).op).hom) ∧
    (∀ {V : Opens (Spf A I).carrier} (s : (Spf A I).presheaf.obj (op V)),
      (∀ x ∈ V, ∃ (W : Opens (Spf A I).carrier) (h : W ≤ V), x ∈ W ∧
        (Spf A I).presheaf.map (homOfLE h).op s ∈
          (specIdealSubsheaf A I).formalCompletionIdeal W) →
      s ∈ (specIdealSubsheaf A I).formalCompletionIdeal V) ∧
    (∀ U : (Spec (CommRingCat.of A)).affineOpens,
      ((specIdealSubsheaf A I).formalCompletionIdeal
          ((specIdealSubsheaf A I).infinitesimalNeighborhoodι 1 ⁻¹ᵁ (U : Opens _))).map
          ((specIdealSubsheaf A I).formalCompletionAffineSectionsIso U) =
        LinearMap.range (completedIdealMap ((specIdealSubsheaf A I).ideal U)
          ((specIdealSubsheaf A I).ideal U))) ∧
    ∀ n : ℕ, Nonempty ((specIdealSubsheaf A I).formalCompletionQuotient (n + 1) ≅
        (specIdealSubsheaf A I).formalCompletionSheafObj n) ∧
      ∃ e : (specIdealSubsheaf A I).infinitesimalNeighborhood (n + 1) ≅
          Spec (CommRingCat.of (A ⧸ I ^ (n + 1))),
        e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I ^ (n + 1)))) =
          (specIdealSubsheaf A I).infinitesimalNeighborhoodι (n + 1) :=
  ⟨fun h => (specIdealSubsheaf A I).formalCompletionIdeal_le_comap h,
    fun s hs => (specIdealSubsheaf A I).mem_formalCompletionIdeal_of_locally s hs,
    fun U => (specIdealSubsheaf A I).formalCompletionAffineSectionsIso_formalCompletionIdeal_eq_range U,
    fun n => ⟨⟨(specIdealSubsheaf A I).formalCompletionQuotientIso n⟩,
      specIdealSubsheafNeighborhoodIso A I (n + 1),
      specIdealSubsheafNeighborhoodIso_hom_comp A I (n + 1)⟩⟩

end Hartshorne
