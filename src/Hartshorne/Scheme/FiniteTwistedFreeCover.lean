import Hartshorne.Scheme.SerreGlobalGeneration
import Hartshorne.RingedSpace.SheafExtFiniteLocallyFree
import Hartshorne.RingedSpace.ModuleSheafTensorPowerIso

/-!
# Coherent sheaves on a projective scheme are quotients of sums of twists

Hartshorne, *Algebraic Geometry*, II, Corollary 5.18 (pp. 121–122).

Let `X` be projective over a ring `A` and let `L = 𝒪_X(1)` be an invertible sheaf on `X` that is
very ample relative to `Spec A`. For `m ∈ ℤ` write `L^{⊗ m}` for `tensorZPow L m`: the tensor
power for `m ≥ 0` and the dual of `L^{⊗ (-m)}` for `m < 0`. Every coherent `𝒪_X`-module `F` is a
quotient of a finite direct sum `⨁_i L^{⊗ m_i}`
(`Hartshorne.exists_epi_sigma_tensorZPow_of_projective`).

## Proof

By Serre's theorem (`exists_isGeneratedBySections_tensorPowerTwist_of_projective`) there is
`n ≥ 1` such that `F ⊗ L^{⊗ n}` is generated by finitely many global sections `s_1, …, s_k`, which
give an epimorphism `𝒪_X^k ⟶ F ⊗ L^{⊗ n}`. Tensoring with `D = (L^{⊗ n})^∨` preserves
epimorphisms and coproducts (both by the tensor–Hom adjunction), and `D ⊗ (F ⊗ L^{⊗ n}) ≅ F`
because evaluation `L^{⊗ n} ⊗ D ⟶ 𝒪_X` is an isomorphism. This gives `D^k ⟶ F`, an
epimorphism, with `D = L^{⊗ (-n)}`.

As in Serre's theorem, the argument does not use that `A` is Noetherian.
-/

universe u

open CategoryTheory Limits AlgebraicGeometry

namespace Hartshorne

variable {X : Scheme.{u}}

/-- The integer tensor power `L^{⊗ m}` of an `𝒪_X`-module `L`: the tensor power `L^{⊗ m}` for
`m ≥ 0`, and the dual `(L^{⊗ n})^∨` of the tensor power for `m = -n < 0`. When `L = 𝒪_X(1)` is
invertible these are the twisting sheaves `𝒪_X(m)`. -/
noncomputable def tensorZPow (L : X.Modules) : ℤ → X.Modules
  | .ofNat n => moduleSheafTensorPower n L
  | .negSucc n => Ringed.moduleSheafDual (R := X.sheaf) (moduleSheafTensorPower (n + 1) L)

set_option backward.isDefEq.respectTransparency.types false in
/-- For any `𝒪_X`-module `D`, the canonical map `⨁_I D ⟶ D ⊗ ⨁_I 𝒪_X` is an epimorphism. -/
theorem epi_sigmaDesc_modulesTensorMap_ιFree (D : X.Modules) (I : Type u) :
    Epi (Sigma.desc fun i : I => (Ringed.moduleSheafUnitTensor (R := X.sheaf) D).inv ≫
      (Ringed.moduleSheafTensorComm (R := X.sheaf) _ D).hom ≫
      Ringed.modulesTensorMap (R := X.sheaf) (𝟙 D) (SheafOfModules.ιFree i)) where
  left_cancellation {Z} u v h := by
    apply (Ringed.moduleSheafTensorHomAdjunction (R := X.sheaf) D _ Z).injective
    refine Sigma.hom_ext _ _ fun i => ?_
    change SheafOfModules.ιFree i ≫ _ = SheafOfModules.ιFree i ≫ _
    refine (Ringed.moduleSheafTensorHomAdjunction_naturality_right _ u).symm.trans
      (Eq.trans ?_ (Ringed.moduleSheafTensorHomAdjunction_naturality_right _ v))
    congr 1
    have hi := Sigma.ι _ i ≫= h
    simp only [Sigma.ι_desc_assoc, Category.assoc, Iso.cancel_iso_inv_left,
      Iso.cancel_iso_hom_left] at hi
    exact hi

set_option backward.isDefEq.respectTransparency.types false in
/-- **Hartshorne II, Corollary 5.18.** Let `X` be projective over a ring `A` and let `L` be an
invertible sheaf on `X` that is very ample relative to `Spec A`. Every coherent `𝒪_X`-module `F` is
a quotient of a finite direct sum of integer tensor powers `L^{⊗ m_i}`. Hartshorne assumes `A`
Noetherian; the proof here does not use it. -/
theorem exists_epi_sigma_tensorZPow_of_projective {A : Type u} [CommRing A]
    {X : Scheme.{u}} {p : X ⟶ Spec (.of A)} (hp : Projective p) {L : X.Modules}
    (hL : IsVeryAmpleRelative p L) (F : X.Modules) (hF : IsCoherent F) :
    ∃ (ι : Type u) (_ : Finite ι) (m : ι → ℤ) (π : ∐ (fun i => tensorZPow L (m i)) ⟶ F),
      Epi π := by
  obtain ⟨n₀, hn₀⟩ := exists_isGeneratedBySections_tensorPowerTwist_of_projective hp hL F hF
  obtain ⟨ι, hι, t, ht⟩ := hn₀ (n₀ + 1) (Nat.le_succ n₀)
  have hinv : Ringed.IsInvertible (R := X.sheaf) (moduleSheafTensorPower (n₀ + 1) L) :=
    Ringed.isInvertible_moduleSheafTensorPower
      ((Scheme.Modules.isInvertible_iff_ringed L).mp hL.1) (n₀ + 1)
  let D : X.Modules := tensorZPow L (.negSucc n₀)
  let G := tensorPowerTwist F L (n₀ + 1)
  let q : SheafOfModules.free ι ⟶ G :=
    G.freeHomEquiv.symm fun i => Scheme.Modules.GloballyGenerated.sectionsOfTop G (t i)
  have hq : @Epi (SheafOfModules (ringCatSheafOf X.sheaf)) _ _ _ q := ht.epi
  let T := Ringed.modulesTensorMap (R := X.sheaf) (𝟙 D) q
  have hT : Epi T := Ringed.modulesTensorMap_epi (R := X.sheaf) D q
  let c : ∐ (fun _ : ι => D) ⟶ moduleSheafTensor D (SheafOfModules.free ι) :=
    Sigma.desc fun i : ι => (Ringed.moduleSheafUnitTensor (R := X.sheaf) D).inv ≫
      (Ringed.moduleSheafTensorComm (R := X.sheaf) _ D).hom ≫
      Ringed.modulesTensorMap (R := X.sheaf) (𝟙 D) (SheafOfModules.ιFree i)
  have hc : Epi c := epi_sigmaDesc_modulesTensorMap_ιFree D ι
  let e : moduleSheafTensor D G ≅ F :=
    Ringed.moduleSheafTensorComm (R := X.sheaf) D G ≪≫
      Ringed.moduleSheafTensorAssoc (R := X.sheaf) F _ D ≪≫
      Ringed.moduleSheafTensorIsoOfIso (R := X.sheaf) (Iso.refl F)
        (Ringed.moduleSheafDualEvalIso (R := X.sheaf) _ hinv) ≪≫
      Ringed.moduleSheafTensorComm (R := X.sheaf) F _ ≪≫
      Ringed.moduleSheafUnitTensor (R := X.sheaf) F
  exact ⟨ι, hι, fun _ => .negSucc n₀, c ≫ T ≫ e.hom,
    @epi_comp _ _ _ _ _ c hc _ (@epi_comp _ _ _ _ _ T hT _ inferInstance)⟩

end Hartshorne
