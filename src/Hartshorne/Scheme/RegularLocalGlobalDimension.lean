import Hartshorne.Scheme.LocalRingGlobalDimension
import Hartshorne.Scheme.RegularLocalCohenMacaulay
import Mathlib.RingTheory.LocalProperties.ProjectiveDimension

/-!
# Regular local rings have finite global dimension

Let `R` be a regular local ring with maximal ideal `𝔪` minimally generated by `d` elements.

* The maximal ideal is generated by a regular sequence of length `d`, so the residue field `k`
  has projective dimension exactly `d` (compare Matsumura, *Commutative Ring Theory*,
  Theorem 19.2).
* Consequently every finitely generated `R`-module has projective dimension at most `d`.
* For a prime `𝔭`, the residue field of `R_𝔭` is the localization of `R ⧸ 𝔭`, so it has
  projective dimension at most `d` over `R_𝔭`.

The last statement is the half of Serre's proof that localizations of regular local rings are
regular which needs only the regularity of `R`; the other half, that a Noetherian local ring
whose residue field has finite projective dimension is regular, is in
`Hartshorne.Scheme.SerreRegularity`.
-/

universe u

open CategoryTheory Abelian IsLocalRing RingTheory.Sequence Pointwise

namespace Hartshorne.RegularLocal

/-- A regular local ring whose maximal ideal is generated by `n` elements has a weakly regular
sequence of length `n` generating its maximal ideal. -/
theorem exists_isWeaklyRegular_ofList_eq_maximalIdeal (n : ℕ) :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A],
      (maximalIdeal A).spanFinrank = n →
        ∃ rs : List A, rs.length = n ∧ Ideal.ofList rs = maximalIdeal A ∧
          IsWeaklyRegular A rs := by
  induction n with
  | zero =>
    intro A _ _ h
    refine ⟨[], rfl, ?_, IsWeaklyRegular.nil A A⟩
    rw [Ideal.ofList_nil, eq_comm,
      ← Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal A).fg_of_isNoetherianRing]
    exact h
  | succ n ih =>
    intro A _ _ hn
    have := isDomain (R := A)
    obtain ⟨x, hxm, hx2, -⟩ :=
      exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes (R := A) (by omega)
    have hx0 : x ≠ 0 := by
      rintro rfl
      exact hx2 (zero_mem _)
    obtain ⟨hreg, hdim⟩ := isRegularLocalRing_quotient_of_notMem_sq hxm hx2
    set B := A ⧸ Ideal.span {x}
    let π : A →+* B := Ideal.Quotient.mk (Ideal.span {x})
    have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
    have hBn : (maximalIdeal B).spanFinrank = n := by
      have h1 := (isRegularLocalRing_iff B).mp hreg
      rw [← (isRegularLocalRing_iff A).mp ‹_›, hn, ← h1] at hdim
      have : ((maximalIdeal B).spanFinrank + 1 : ℕ) = n + 1 := by exact_mod_cast hdim
      omega
    obtain ⟨ys, hlen, hgen, hys⟩ := ih B hBn
    set zs := ys.map (Function.surjInv hπ)
    have hzs : zs.map π = ys := by
      simp only [zs, List.map_map, Function.comp_def, Function.surjInv_eq hπ, List.map_id']
    have hcomap : (maximalIdeal B).comap π = maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective π hπ)
    refine ⟨x :: zs, by simp [zs, hlen], ?_, ?_⟩
    · rw [Ideal.ofList_cons, ← hcomap, ← hgen, ← hzs, ← Ideal.map_ofList,
        Ideal.comap_map_of_surjective _ hπ, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_comm]
    · have hI : (x • (⊤ : Submodule A A)) = Ideal.span {x} := by
        rw [← Submodule.ideal_span_singleton_smul, smul_eq_mul, Ideal.mul_top]
      rw [isWeaklyRegular_cons_iff, LinearEquiv.isWeaklyRegular_congr
        (Submodule.quotEquivOfEq _ _ hI), ← isWeaklyRegular_map_algebraMap_iff B B]
      refine ⟨IsSMulRegular.of_right_eq_zero_of_smul (fun y hy => ?_), ?_⟩
      · exact (mul_eq_zero.mp hy).resolve_left hx0
      · rw [Ideal.Quotient.algebraMap_eq]
        exact hzs ▸ hys

variable (R : Type u) [CommRing R]

/-- The residue field of a regular local ring has projective dimension equal to the minimal number
of generators of the maximal ideal, that is, to the dimension of the ring (compare Matsumura,
*Commutative Ring Theory*, Theorem 19.2). -/
theorem projectiveDimension_residueField [IsRegularLocalRing R] :
    projectiveDimension (ModuleCat.of R (ResidueField R)) =
      ((maximalIdeal R).spanFinrank : WithBot ℕ∞) := by
  obtain ⟨rs, hlen, hgen, hrs⟩ := exists_isWeaklyRegular_ofList_eq_maximalIdeal _ R rfl
  have hmem : ∀ r ∈ rs, r ∈ maximalIdeal R := fun r hr => hgen ▸ Ideal.subset_span hr
  have reg := IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal _ hmem hrs
  have h := ModuleCat.projectiveDimension_quotient_eq_length rs reg
  let e : Shrink.{u} (R ⧸ Ideal.ofList rs) ≃ₗ[R] ResidueField R :=
    (Shrink.linearEquiv R _).trans (Submodule.quotEquivOfEq _ _ hgen)
  rw [← projectiveDimension_eq_of_iso e.toModuleIso, h, hlen]

/-- The residue field of a regular local ring `R` has projective dimension `dim R`. -/
theorem projectiveDimension_residueField_eq_ringKrullDim [IsRegularLocalRing R] :
    projectiveDimension (ModuleCat.of R (ResidueField R)) = ringKrullDim R := by
  rw [projectiveDimension_residueField, (isRegularLocalRing_iff R).mp ‹_›]

/-- Over a regular local ring whose maximal ideal is generated by `d` elements, every finitely
generated module has projective dimension at most `d`. -/
theorem hasProjectiveDimensionLE_of_isRegularLocalRing [IsRegularLocalRing R]
    (M : ModuleCat.{u} R) [Module.Finite R M] :
    HasProjectiveDimensionLE M (maximalIdeal R).spanFinrank := by
  have hk : HasProjectiveDimensionLE (ModuleCat.of R (ResidueField R))
      (maximalIdeal R).spanFinrank :=
    (projectiveDimension_le_iff _ _).mp (projectiveDimension_residueField R).le
  exact Hartshorne.LocalGlobalDimension.hasProjectiveDimensionLE_of_residueField _ hk M

/-- The residue field of `R_𝔭` is, as an `R_𝔭`-module, the localization of `R ⧸ 𝔭` at `𝔭`. -/
noncomputable def localizedModuleQuotientIsoResidueField (p : Ideal R) [p.IsPrime] :
    (ModuleCat.of R (R ⧸ p)).localizedModule p.primeCompl ≅
      ModuleCat.of (Localization.AtPrime p) (ResidueField (Localization.AtPrime p)) := by
  let Ap := Localization.AtPrime p
  let f : R →ₗ[R] Ap := Algebra.linearMap R Ap
  have hJ : (p : Submodule R R).localized' Ap p.primeCompl f = maximalIdeal Ap := by
    rw [Submodule.localized'_eq_span, ← Localization.AtPrime.map_eq_maximalIdeal]
    rfl
  let g := (p : Submodule R R).toLocalizedQuotient' Ap p.primeCompl f
  let e1 : LocalizedModule p.primeCompl (R ⧸ p) ≃ₗ[R]
      Ap ⧸ (p : Submodule R R).localized' Ap p.primeCompl f :=
    IsLocalizedModule.iso p.primeCompl g
  let e2 : LocalizedModule p.primeCompl (R ⧸ p) ≃ₗ[Ap]
      Ap ⧸ (p : Submodule R R).localized' Ap p.primeCompl f :=
    e1.extendScalarsOfIsLocalization p.primeCompl Ap
  let e3 : Shrink.{u} (LocalizedModule p.primeCompl (R ⧸ p)) ≃ₗ[Ap] ResidueField Ap :=
    (Shrink.linearEquiv Ap _).trans (e2.trans (Submodule.quotEquivOfEq _ _ hJ))
  exact e3.toModuleIso

/-- Let `R` be a regular local ring whose maximal ideal is generated by `d` elements and `𝔭` a
prime ideal. Then the residue field of `R_𝔭` has projective dimension at most `d` over `R_𝔭`. -/
theorem hasProjectiveDimensionLE_residueField_localization [IsRegularLocalRing R]
    (p : Ideal R) [p.IsPrime] :
    HasProjectiveDimensionLE
      (ModuleCat.of (Localization.AtPrime p) (ResidueField (Localization.AtPrime p)))
      (maximalIdeal R).spanFinrank := by
  have := hasProjectiveDimensionLE_of_isRegularLocalRing R (ModuleCat.of R (R ⧸ p))
  have := ModuleCat.localizedModule_hasProjectiveDimensionLE (maximalIdeal R).spanFinrank
    p.primeCompl
    (ModuleCat.of R (R ⧸ p))
  exact hasProjectiveDimensionLT_of_iso (localizedModuleQuotientIsoResidueField R p) _

end Hartshorne.RegularLocal
