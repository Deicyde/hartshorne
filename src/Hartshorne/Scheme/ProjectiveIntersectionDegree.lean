import Hartshorne.Intersection.HypersurfaceHilbertPolynomial
import Hartshorne.Scheme.ProjectiveIntersectionDivisor

/-!
# Toward the degree of an ambient hypersurface section

Hartshorne, *Algebraic Geometry*, Exercise II.6.2(c) (p. 146).

Let `ℙⁿ_k = Proj k[x₀, ..., xₙ]` with its standard grading. A prime divisor `V` of `ℙⁿ_k` has a
homogeneous prime generated by one homogeneous polynomial `f`. This file records the facts about
that equation needed for `deg(V · X) = deg V · deg X`: `f` is prime, its degree is positive, and
(for `k` algebraically closed and `n ≥ 1`) the projective degree of `V` equals `deg f`.

## Main results

* `Hartshorne.projectivePrimeDivisorEquation_prime`: the equation of `V` is a prime element.
* `Hartshorne.projectivePrimeDivisorEquationDegree_pos`: its degree is positive.
* `Hartshorne.projectiveSpectrumPointDegree_primeDivisor`: `deg V = deg f`.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial

namespace Hartshorne

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type u} [Field k] {n : ℕ}

/-- The homogeneous equation of a prime divisor of `ℙⁿ_k` is a prime element of the polynomial
ring. -/
theorem projectivePrimeDivisorEquation_prime
    (V : (Proj (homogeneousSubmodule (Fin (n + 1)) k)).PrimeDivisor) :
    Prime (projectivePrimeDivisorEquation V) := by
  have h : (Ideal.span {projectivePrimeDivisorEquation V}).IsPrime := by
    rw [← span_projectivePrimeDivisorEquation]
    exact V.1.isPrime
  exact (Ideal.span_singleton_prime (projectivePrimeDivisorEquation_ne_zero V)).mp h

/-- The homogeneous equation of a prime divisor of `ℙⁿ_k` has positive degree: a nonzero
constant is a unit, hence generates no prime ideal. -/
theorem projectivePrimeDivisorEquationDegree_pos
    (V : (Proj (homogeneousSubmodule (Fin (n + 1)) k)).PrimeDivisor) :
    0 < projectivePrimeDivisorEquationDegree V := by
  by_contra h0
  have hd : projectivePrimeDivisorEquationDegree V = 0 := by omega
  have hh := projectivePrimeDivisorEquation_isHomogeneous V
  rw [hd] at hh
  have htd := hh.totalDegree (projectivePrimeDivisorEquation_ne_zero V)
  rw [totalDegree_eq_zero_iff_eq_C] at htd
  apply (projectivePrimeDivisorEquation_prime V).not_isUnit
  rw [htd]
  refine (isUnit_iff_ne_zero.mpr fun hc ↦ projectivePrimeDivisorEquation_ne_zero V ?_).map C
  rw [htd, hc, map_zero]

/-- The projective degree of a prime divisor `V` of `ℙⁿ_k` (`n ≥ 1`, `k` algebraically closed) is
the degree of its homogeneous equation. -/
theorem projectiveSpectrumPointDegree_primeDivisor [IsAlgClosed k] (hn : 0 < n)
    (V : (Proj (homogeneousSubmodule (Fin (n + 1)) k)).PrimeDivisor) :
    projectiveSpectrumPointDegree V.1 = projectivePrimeDivisorEquationDegree V := by
  have h := projectiveSpectrumPointDegree_cast V.1
  have hs : (V.1.asHomogeneousIdeal : Set (MvPolynomial (Fin (n + 1)) k)) =
      (Ideal.span {projectivePrimeDivisorEquation V} : Set (MvPolynomial (Fin (n + 1)) k)) := by
    rw [← span_projectivePrimeDivisorEquation]
    rfl
  rw [hs, projZeroSet_span, (hypersurface_hilbertPolynomial_and_degree hn
    (projectivePrimeDivisorEquationDegree_pos V) _
    (projectivePrimeDivisorEquation_isHomogeneous V)
    (projectivePrimeDivisorEquation_prime V).irreducible).2] at h
  exact_mod_cast h

end Hartshorne
