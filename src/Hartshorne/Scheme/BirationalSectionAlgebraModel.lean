import Hartshorne.Scheme.ProjEventualSectionRecovery
import Hartshorne.Scheme.VeroneseDuple
import Hartshorne.Scheme.ProjectiveChartCoordinateRing

/-!
# The section algebra of a projective morphism, over an affine open

Hartshorne, *Algebraic Geometry*, II, proof of Theorem 7.17, Step 2 (pp. 166–167): the affine
part.

Let `f : Z → X` be projective and `U = Spec A ⊆ X` an affine open. Over `U` the projective
embedding exhibits `f⁻¹(U)` as `Proj T` for the homogeneous coordinate ring
`T = A[x₀, …, xₙ] / I` (Corollary 5.16), with `L = 𝒪(1)`. The section algebra
`A ⊕ ⨁_{d ≥ 1} Γ(f⁻¹ U, L^d)` is then `T₀ ⊕ ⨁_{d ≥ 1} Γ(Proj T, 𝒪(d))`. This file proves the
comparison of Hartshorne's (omitted) Step 2 on this chart:

* `SectionAlgebraModel.exists_bijective_twistSection`: `T_n → Γ(Proj T, 𝒪(n))`, `s ↦ s / 1`, is
  bijective for all large `n`. This is Exercise 5.9(b) for `M = T`
  (`EventualSectionRecovery.exists_bijective_alphaComponent`).
* For a domain `T` (the case of a variety `Z`), the sections of `𝒪(n)` are elements of the
  fraction field `K` of `T` (`ProjectiveSectionRing.sectionToFraction`, multiplicative for the
  product of sections), and the section algebra of `L^d = 𝒪(d)` is the family of subgroups
  `sectionAlgebraPiece d m ⊆ K` (`T₀` in degree `0`, the sections of `𝒪(md)` in degree
  `m ≥ 1`). `SectionAlgebraModel.exists_sectionAlgebraPiece_eq_veronese`: after replacing `L` by a
  sufficiently high power `L^d`, the section algebra is the image of the Veronese ring
  `T^{(d)} = ⨁_m T_{md}` in every degree, and it is generated by its degree-one part over its
  degree-zero part. Its `Proj` is therefore `Proj T^{(d)} ≅ Proj T` (Exercise 5.13,
  `Veronese.projIso`).

The global statement (gluing these over the affine opens of `X` into a quasi-coherent graded
`𝒪_X`-algebra and identifying its relative `Proj` with `Z`) is not proved here.
-/

universe u

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace Hartshorne

open AlgebraicGeometry CategoryTheory MonoidalCategory HomogeneousLocalization TopologicalSpace
  Opposite

namespace SectionAlgebraModel

open ProjGradedModuleSheaf GradedGlobalSections EventualSectionRecovery ProjectiveSectionRing

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]

omit [GradedRing 𝒜] in
/-- The membership in `gradedModuleTwist (gradedTwist 𝒜 0) n i` and `gradedTwist 𝒜 n i` agree. -/
private theorem mem_gradedModuleTwist_gradedTwist_iff (n i : ℤ) (a : A) :
    a ∈ gradedModuleTwist (gradedTwist 𝒜 0) n i ↔ a ∈ gradedTwist 𝒜 n i := by
  change a ∈ gradedTwist 𝒜 0 (i + n) ↔ a ∈ gradedTwist 𝒜 n i
  change (a ∈ 𝒜 (0 + (i + n)).toNat ∧ (0 + (i + n) < 0 → a = 0)) ↔
    (a ∈ 𝒜 (n + i).toNat ∧ (n + i < 0 → a = 0))
  rw [zero_add, add_comm i n]

/-- **Step 2 comparison on an affine chart.** Let `T` be a graded ring whose degree-zero part is a
finitely generated algebra over a field, generated over `T₀` by finitely many elements of degree
one. Then `T_n → Γ(Proj T, 𝒪(n))`, `s ↦ s / 1`, is bijective for all large `n`.

This is the comparison of the section algebra `⨁ Γ(Proj T, 𝒪(n))` with the homogeneous coordinate
ring `T` "in all sufficiently large degrees" used in Step 2 of the proof of Hartshorne II,
Theorem 7.17; it is Exercise 5.9(b) for the module `M = T`. -/
theorem exists_bijective_twistSection (k : Type u) [Field k] [Algebra k (𝒜 0)]
    [Algebra.FiniteType k (𝒜 0)] {s : Finset A} (hs : ∀ a ∈ s, a ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (s : Set A) = ⊤) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, Function.Bijective (fun a : 𝒜 n => twistSection n a (op ⊤)) := by
  obtain ⟨d₀, hd₀⟩ := exists_bijective_alphaComponent (ℳ := gradedTwist 𝒜 0) k hs hgen
  refine ⟨d₀.toNat, fun n hn => ?_⟩
  have h1 := (bijective_alphaComponent_iff _ _ (n : ℤ)).1 (hd₀ n (by omega))
  rw [bijective_constHom_iff,
    bijective_constHom0_congr _ (gradedTwist 𝒜 n) (mem_gradedModuleTwist_gradedTwist_iff n)] at h1
  let e : 𝒜 n ≃ ↥(gradedTwist 𝒜 (n : ℤ) 0) :=
    { toFun := fun a => ⟨a, (mem_gradedTwist_of_eq (k := n) (by omega)).2 a.2⟩
      invFun := fun a => ⟨a, (mem_gradedTwist_of_eq (k := n) (by omega)).1 a.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have h : (fun a : 𝒜 n => twistSection n a (op ⊤)) =
      constHom0 (𝒜 := 𝒜) (gradedTwist 𝒜 n) ∘ e := rfl
  rw [h]
  exact h1.comp e.bijective

/-- `exists_bijective_twistSection` for generators indexed by `Fin (r + 1)`. -/
private theorem exists_bijective_twistSection_range (k : Type u) [Field k] [Algebra k (𝒜 0)]
    [Algebra.FiniteType k (𝒜 0)] {r : ℕ} (x : Fin (r + 1) → A) (hx : ∀ i, x i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, Function.Bijective (fun a : 𝒜 n => twistSection n a (op ⊤)) := by
  classical
  have hs : ∀ a ∈ Finset.univ.image x, a ∈ 𝒜 1 := by
    intro a ha
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 ha
    exact hx i
  have hgen' : Algebra.adjoin (𝒜 0) ((Finset.univ.image x : Finset A) : Set A) = ⊤ := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact hgen
  exact exists_bijective_twistSection k hs hgen'

/-- The additive map `T_n → Γ(Proj T, 𝒪(n))`, `s ↦ s / 1`. -/
private def twistSectionHom (n : ℕ) : 𝒜 n →+ (projTwistingSheaf 𝒜 n).val.obj (op ⊤) where
  toFun a := twistSection n a (op ⊤)
  map_zero' := by
    apply section_ext
    intro x
    apply HomogeneousLocalizedModule.ext
    change LocalizedModule.mk ((0 : 𝒜 n) : A) 1 = 0
    rw [ZeroMemClass.coe_zero, LocalizedModule.zero_mk]
  map_add' s s' := by
    apply section_ext
    intro x
    apply HomogeneousLocalizedModule.ext
    change LocalizedModule.mk ((s : A) + s') 1 =
      LocalizedModule.mk (s : A) 1 + LocalizedModule.mk (s' : A) 1
    rw [LocalizedModule.mk_add_mk, one_smul, one_smul, mul_one]

/-! ### The section algebra of `𝒪(d)` for a graded domain -/

section Domain

variable [IsDomain A]

variable (𝒜) in
/-- The image `T_n ⊆ K` of the degree-`n` part of `T` in its fraction field. -/
def gradedImage (n : ℕ) : AddSubgroup (FractionRing A) :=
  ((algebraMap A (FractionRing A)).toAddMonoidHom.comp (AddSubgroupClass.subtype (𝒜 n))).range

omit [GradedRing 𝒜] [IsDomain A] in
theorem mem_gradedImage_iff {n : ℕ} {z : FractionRing A} :
    z ∈ gradedImage 𝒜 n ↔ ∃ a ∈ 𝒜 n, algebraMap A (FractionRing A) a = z :=
  ⟨fun ⟨a, ha⟩ => ⟨a, a.2, ha⟩, fun ⟨a, ha, h⟩ => ⟨⟨a, ha⟩, h⟩⟩

variable (𝒜) in
/-- The degree-`m` part of the **section algebra** `T₀ ⊕ ⨁_{m ≥ 1} Γ(Proj T, 𝒪(md))` of
`L^d = 𝒪(d)` on `Proj T`, as a subgroup of the fraction field `K` of the graded domain `T`: the
image of `T₀` for `m = 0`, and the image of the global sections of `𝒪(md)` under the
(multiplicative, injective) value map `ProjectiveSectionRing.sectionToFraction` for `m ≥ 1`. -/
def sectionAlgebraPiece (d m : ℕ) : AddSubgroup (FractionRing A) :=
  if m = 0 then gradedImage 𝒜 0 else (sectionToFraction 𝒜 ((m * d : ℕ) : ℤ)).range

/-- The section `s / 1` of `𝒪(n)` has value `s` in `K`. -/
private theorem sectionToFraction_eq_of_unitorGlobal (h : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥)
    {n : ℕ} (t : twistGlobal (𝟙_ (Proj 𝒜).Modules) (n : ℤ)) (a : 𝒜 n)
    (ht : unitorGlobal (n : ℤ) t = twistSection n a (op ⊤)) :
    sectionToFraction 𝒜 n t = algebraMap A (FractionRing A) a := by
  rw [sectionToFraction_apply h _ _ (genericPoint h)]
  unfold sectionValue
  rw [ht]
  change toFraction _ (twistFraction n (genericPoint h) a.2).val = _
  rw [twistFraction_val, toFraction_mk]
  simp

/-- In a degree `n` where `T_n → Γ(Proj T, 𝒪(n))` is surjective, the sections of `𝒪(n)` are the
elements of `T_n ⊆ K`. -/
private theorem range_sectionToFraction_eq (h : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥) {n : ℕ}
    (hn : Function.Surjective (fun a : 𝒜 n => twistSection n a (op ⊤))) :
    (sectionToFraction 𝒜 (n : ℤ)).range = gradedImage 𝒜 n := by
  ext z
  constructor
  · rintro ⟨t, rfl⟩
    obtain ⟨a, ha⟩ := hn (unitorGlobal (n : ℤ) t)
    exact ⟨a, (sectionToFraction_eq_of_unitorGlobal h t a ha.symm).symm⟩
  · rintro ⟨a, rfl⟩
    obtain ⟨t, ht⟩ := (unitorGlobal_bijective (𝒜 := 𝒜) (n : ℤ)).2 (twistSection n a (op ⊤))
    exact ⟨t, sectionToFraction_eq_of_unitorGlobal h t a ht⟩

/-- **The section algebra of a sufficiently high power of `L`, on an affine chart** (Hartshorne
II, proof of Theorem 7.17, Step 2). Let `T` be a graded domain with `T₀` a finitely generated
algebra over a field, generated over `T₀` by `x₀, …, xᵣ ∈ T₁` (the homogeneous coordinates of a
projective embedding, with `L = 𝒪(1)`), and `T₊ ≠ 0` (so `Proj T` is nonempty). Then for all large
`d`:

* the section algebra `T₀ ⊕ ⨁_{m ≥ 1} Γ(Proj T, 𝒪(md))` of `L^d`, inside `K`, agrees with the
  Veronese ring `T^{(d)}` in every degree: its degree-`m` part is `T_{md}`;
* it is generated by its degree-one part over its degree-zero part;
* the subring of `K` it generates is the image of `T^{(d)}` (which embeds in `K`).

Hence it is a graded ring isomorphic to `T^{(d)}`, generated in degree one, whose `Proj` is
`Proj T^{(d)} ≅ Proj T` (`Veronese.projIso`). Hartshorne's varieties make `T` a domain; the
fraction field is used here to multiply sections. The field need not be algebraically closed. -/
theorem exists_sectionAlgebraPiece_eq_veronese (k : Type u) [Field k] [Algebra k (𝒜 0)]
    [Algebra.FiniteType k (𝒜 0)] {r : ℕ} (x : Fin (r + 1) → A) (hx : ∀ i, x i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤) (h : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥) :
    ∃ d₀ : ℕ, ∀ d ≥ d₀, 0 < d ∧
      (∀ m, sectionAlgebraPiece 𝒜 d m = gradedImage 𝒜 (m * d)) ∧
      (∀ m, (sectionAlgebraPiece 𝒜 d m : Set (FractionRing A)) ⊆
        (Subring.closure (sectionAlgebraPiece 𝒜 d 0 ∪ sectionAlgebraPiece 𝒜 d 1 :
          Set (FractionRing A)) : Set (FractionRing A))) ∧
      Subring.closure (⋃ m, (sectionAlgebraPiece 𝒜 d m : Set (FractionRing A))) =
        (veroneseSubring 𝒜 d).map (algebraMap A (FractionRing A)) := by
  classical
  have hs : ∀ a ∈ Finset.univ.image x, a ∈ 𝒜 1 := by
    intro a ha
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 ha
    exact hx i
  have hgen' : Algebra.adjoin (𝒜 0) ((Finset.univ.image x : Finset A) : Set A) = ⊤ := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact hgen
  obtain ⟨n₀, hn₀⟩ := exists_bijective_twistSection k hs hgen'
  refine ⟨max n₀ 1, fun d hd => ?_⟩
  have hd1 : 0 < d := by omega
  have : NeZero d := ⟨hd1.ne'⟩
  have hpiece : ∀ m, sectionAlgebraPiece 𝒜 d m = gradedImage 𝒜 (m * d) := by
    intro m
    unfold sectionAlgebraPiece
    split_ifs with hm
    · rw [hm, zero_mul]
    · have hle : n₀ ≤ m * d := le_trans (le_of_max_le_left hd)
        (Nat.le_mul_of_pos_left d (Nat.pos_of_ne_zero hm))
      exact range_sectionToFraction_eq h (hn₀ (m * d) hle).2
  -- Every piece lies in the image of `T^{(d)}`.
  have hsub : ∀ m, (sectionAlgebraPiece 𝒜 d m : Set (FractionRing A)) ⊆
      (veroneseSubring 𝒜 d).map (algebraMap A (FractionRing A)) := by
    intro m z hz
    rw [SetLike.mem_coe, hpiece m] at hz
    obtain ⟨⟨a, ha⟩, rfl⟩ := hz
    exact ⟨a, Veronese.mem_veroneseSubring_of_mem ha, rfl⟩
  -- The image of `T^{(d)}` is generated by the degree-zero and degree-one pieces.
  let φ : veroneseSubring 𝒜 d →+* FractionRing A :=
    (algebraMap A (FractionRing A)).comp (veroneseSubring 𝒜 d).subtype
  have hle : Subring.closure (Set.range (algebraMap ((veronese 𝒜 d) 0) (veroneseSubring 𝒜 d)) ∪
      Set.range (Veronese.dupleCoords d x hx)) ≤
      (Subring.closure (sectionAlgebraPiece 𝒜 d 0 ∪ sectionAlgebraPiece 𝒜 d 1 :
        Set (FractionRing A))).comap φ := by
    rw [Subring.closure_le]
    rintro y (⟨c, rfl⟩ | ⟨j, rfl⟩)
    · refine Subring.subset_closure (Or.inl ?_)
      rw [SetLike.mem_coe, hpiece 0]
      exact ⟨⟨_, c.2⟩, rfl⟩
    · refine Subring.subset_closure (Or.inr ?_)
      rw [SetLike.mem_coe, hpiece 1]
      exact ⟨⟨_, Veronese.dupleCoords_mem d x hx j⟩, rfl⟩
  have hgenK : (veroneseSubring 𝒜 d).map (algebraMap A (FractionRing A)) ≤
      Subring.closure (sectionAlgebraPiece 𝒜 d 0 ∪ sectionAlgebraPiece 𝒜 d 1 :
        Set (FractionRing A)) := by
    rintro _ ⟨a, ha, rfl⟩
    have hmem : (⟨a, ha⟩ : veroneseSubring 𝒜 d) ∈
        Algebra.adjoin ((veronese 𝒜 d) 0) (Set.range (Veronese.dupleCoords d x hx)) := by
      rw [Veronese.adjoin_dupleCoords x hx hgen]
      trivial
    rw [← Subalgebra.mem_toSubring, Algebra.adjoin_eq_ring_closure] at hmem
    exact hle hmem
  refine ⟨hd1, hpiece, fun m => (hsub m).trans hgenK, le_antisymm ?_ ?_⟩
  · rw [Subring.closure_le]
    exact Set.iUnion_subset hsub
  · refine hgenK.trans (Subring.closure_mono ?_)
    exact Set.union_subset (Set.subset_iUnion_of_subset 0 le_rfl)
      (Set.subset_iUnion_of_subset 1 le_rfl)

end Domain

/-! ### The chart statement for a closed subscheme of `ℙʳ_A` -/

section Chart

attribute [local instance] MvPolynomial.gradedAlgebra

variable {R : Type u} [CommRing R] {r : ℕ}

local notation "𝒮" => MvPolynomial.homogeneousSubmodule (Fin (r + 1)) R

/-- The map `A → (A[x]/I)₀`. -/
private def chartZeroHom (I : HomogeneousIdeal 𝒮) : R →+* gradedQuotient 𝒮 I 0 :=
  (gradedQuotientMk 𝒮 I).gradedZeroRingHom.comp (algebraMap R (𝒮 0))

private theorem chartZeroHom_surjective (I : HomogeneousIdeal 𝒮) :
    Function.Surjective (chartZeroHom I) := by
  intro y
  obtain ⟨b, hb, hby⟩ := mem_gradedQuotient_iff.mp y.2
  obtain ⟨a, ha⟩ := (bijective_algebraMap_mvPolynomial_homogeneousSubmodule_zero R r).2 ⟨b, hb⟩
  refine ⟨a, Subtype.ext ?_⟩
  change Ideal.Quotient.mk _ ((algebraMap R (𝒮 0) a : MvPolynomial (Fin (r + 1)) R)) = _
  rw [ha]
  exact hby

/-- The images of `x₀, …, xᵣ` generate `A[x]/I` over its degree-zero part. -/
private theorem adjoin_coord_eq_top (I : HomogeneousIdeal 𝒮) :
    Algebra.adjoin (gradedQuotient 𝒮 I 0)
      (Set.range fun j : Fin (r + 1) => Ideal.Quotient.mk I.toIdeal (MvPolynomial.X j)) = ⊤ := by
  rw [eq_top_iff]
  rintro y -
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
  induction p using MvPolynomial.induction_on with
  | C a =>
    exact Subalgebra.algebraMap_mem _ (chartZeroHom I a)
  | add p q hp hq =>
    rw [map_add]
    exact add_mem hp hq
  | mul_X p j hp =>
    rw [map_mul]
    exact mul_mem hp (Algebra.subset_adjoin ⟨j, rfl⟩)

/-- **The section algebra of a sufficiently high power of `L`, for a closed subscheme of `ℙʳ_A`**
(Hartshorne II, proof of Theorem 7.17, Step 2, over an affine open `U = Spec A` of the base). Let
`A` be a finitely generated algebra over a field `k`, and `i : Z ⟶ ℙʳ_{Spec A}` a closed immersion
of an integral scheme `Z`, with `L = i^* 𝒪(1)`. Then `Z ≅ Proj T` over `ℙʳ_{Spec A}` for the
homogeneous coordinate ring `T = A[x₀, …, xᵣ]/I` (`I` saturated), which is a domain, and under this
isomorphism `i^* 𝒪(n)` is `𝒪_{Proj T}(n)`. Moreover for all large `d` the section algebra
`T₀ ⊕ ⨁_{m ≥ 1} Γ(Z, L^{md})`, realized inside the fraction field of `T` as the pieces
`sectionAlgebraPiece d m` (sections of `𝒪_{Proj T}(md)`), agrees with the Veronese ring `T^{(d)}`
in every degree and is generated by its degree-one part over its degree-zero part; its `Proj` is
`Proj T^{(d)} ≅ Proj T ≅ Z` (`Veronese.projIso`). -/
theorem exists_iso_proj_sectionAlgebraPiece_eq_veronese (k : Type u) [Field k] [Algebra k R]
    [Algebra.FiniteType k R] {Z : Scheme.{u}} [IsIntegral Z]
    (i : Z ⟶ projectiveSpaceOverScheme r (Spec (.of R))) [IsClosedImmersion i] :
    ∃ (I : HomogeneousIdeal 𝒮) (_ : IsDomain (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal)),
      ProjectiveClosedSubscheme.saturation I.toIdeal = I.toIdeal ∧
      ∃ e : Z ≅ Proj (gradedQuotient 𝒮 I),
        e.hom ≫ projQuotientι 𝒮 I ≫ (projectiveSpaceOverSpecIso R r (Equiv.refl _)).hom = i ∧
        (∀ n : ℤ, Nonempty ((Scheme.Modules.pullback i).obj
            (projectiveSpaceTwistingSheaf r (Spec (.of R)) n) ≅
          (Scheme.Modules.pullback e.hom).obj (projTwistingSheaf (gradedQuotient 𝒮 I) n))) ∧
        ∃ d₀ : ℕ, ∀ d ≥ d₀, 0 < d ∧
          (∀ m, sectionAlgebraPiece (gradedQuotient 𝒮 I) d m =
            gradedImage (gradedQuotient 𝒮 I) (m * d)) ∧
          (∀ m, (sectionAlgebraPiece (gradedQuotient 𝒮 I) d m :
              Set (FractionRing (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal))) ⊆
            (Subring.closure (sectionAlgebraPiece (gradedQuotient 𝒮 I) d 0 ∪
              sectionAlgebraPiece (gradedQuotient 𝒮 I) d 1 :
                Set (FractionRing (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal))) :
              Set (FractionRing (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal)))) ∧
          Subring.closure (⋃ m, (sectionAlgebraPiece (gradedQuotient 𝒮 I) d m :
              Set (FractionRing (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal)))) =
            (veroneseSubring (gradedQuotient 𝒮 I) d).map
              (algebraMap _ (FractionRing (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal))) := by
  obtain ⟨I, hsat, e, hfac, htw, hdom⟩ := exists_iso_proj_homogeneousCoordinateRing i
  have : IsDomain (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal) := hdom inferInstance
  let : Algebra k (gradedQuotient 𝒮 I 0) :=
    ((chartZeroHom I).comp (algebraMap k R)).toAlgebra
  let φ : R →ₐ[k] gradedQuotient 𝒮 I 0 :=
    { chartZeroHom I with commutes' := fun _ => rfl }
  have : Algebra.FiniteType k (gradedQuotient 𝒮 I 0) :=
    Algebra.FiniteType.of_surjective φ (chartZeroHom_surjective I)
  have hirr : ¬HomogeneousIdeal.irrelevant (gradedQuotient 𝒮 I) ≤ ⊥ := fun h =>
    (e.hom (Nonempty.some inferInstance)).not_irrelevant_le (h.trans bot_le)
  exact ⟨I, inferInstance, hsat, e, hfac, htw,
    exists_sectionAlgebraPiece_eq_veronese k _
      (fun j => mk_mem_gradedQuotient (MvPolynomial.isHomogeneous_X R j))
      (adjoin_coord_eq_top I) hirr⟩

/-- **Step 2 of the proof of Theorem 7.17 over an affine open of the base** (Hartshorne II,
pp. 166–167). Let `i : Z ⟶ ℙʳ_X` be a closed immersion of an integral scheme, `f = π ∘ i`, and
`L = i^* 𝒪(1)`. Let `U ⊆ X` be an affine open with `Γ(X, U)` a finitely generated algebra over a
field `k` and `f⁻¹(U)` nonempty. Then `f⁻¹(U) ≅ Proj T` over `ℙʳ_{Spec Γ(X, U)}` for the
homogeneous coordinate ring `T = Γ(X, U)[x₀, …, xᵣ]/I` of `f⁻¹(U) ⊆ ℙʳ_{Spec Γ(X, U)}` (`I`
saturated, `T` a domain), `L^{n}|_{f⁻¹(U)}` corresponds to `𝒪_{Proj T}(n)`, and for all large `d`
the section algebra of `L^d` over `f⁻¹(U)` (inside the fraction field of `T`) is the Veronese ring
`T^{(d)}` in every degree and is generated in degree one. -/
theorem exists_iso_proj_sectionAlgebraPiece_eq_veronese_of_isAffineOpen (k : Type u) [Field k]
    {X Z : Scheme.{u}} [IsIntegral Z] (i : Z ⟶ projectiveSpaceOverScheme r X)
    [IsClosedImmersion i] {U : X.Opens} (hU : IsAffineOpen U) [Algebra k Γ(X, U)]
    [Algebra.FiniteType k Γ(X, U)]
    (hne : ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U : Set Z).Nonempty) :
    ∃ (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) Γ(X, U)))
      (_ : IsDomain (MvPolynomial (Fin (r + 1)) Γ(X, U) ⧸ I.toIdeal)),
      ProjectiveClosedSubscheme.saturation I.toIdeal = I.toIdeal ∧
      ∃ e : ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).toScheme ≅
          Proj (gradedQuotient (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) Γ(X, U)) I),
        e.hom ≫ projQuotientι _ I ≫
            (projectiveSpaceOverSpecIso Γ(X, U) r (Equiv.refl _)).hom = chartEmbedding i hU ∧
        (∀ n : ℤ, Nonempty ((Scheme.Modules.pullback
            ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).ι).obj
              ((Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf r X n)) ≅
          (Scheme.Modules.pullback e.hom).obj (projTwistingSheaf (gradedQuotient _ I) n))) ∧
        ∃ d₀ : ℕ, ∀ d ≥ d₀, 0 < d ∧
          (∀ m, sectionAlgebraPiece (gradedQuotient _ I) d m =
            gradedImage (gradedQuotient _ I) (m * d)) ∧
          (∀ m, (sectionAlgebraPiece (gradedQuotient _ I) d m :
              Set (FractionRing (MvPolynomial (Fin (r + 1)) Γ(X, U) ⧸ I.toIdeal))) ⊆
            (Subring.closure (sectionAlgebraPiece (gradedQuotient _ I) d 0 ∪
              sectionAlgebraPiece (gradedQuotient _ I) d 1 :
                Set (FractionRing (MvPolynomial (Fin (r + 1)) Γ(X, U) ⧸ I.toIdeal))) :
              Set (FractionRing (MvPolynomial (Fin (r + 1)) Γ(X, U) ⧸ I.toIdeal)))) ∧
          Subring.closure (⋃ m, (sectionAlgebraPiece (gradedQuotient _ I) d m :
              Set (FractionRing (MvPolynomial (Fin (r + 1)) Γ(X, U) ⧸ I.toIdeal)))) =
            (veroneseSubring (gradedQuotient _ I) d).map
              (algebraMap _ (FractionRing (MvPolynomial (Fin (r + 1)) Γ(X, U) ⧸ I.toIdeal))) := by
  have : Nonempty ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).toScheme :=
    ⟨⟨hne.some, hne.some_mem⟩⟩
  have : IsIntegral ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).toScheme :=
    isIntegral_of_isOpenImmersion (Scheme.Opens.ι _)
  obtain ⟨I, hdom, hsat, e, hfac, htw, hd⟩ :=
    exists_iso_proj_sectionAlgebraPiece_eq_veronese k (chartEmbedding i hU)
  exact ⟨I, hdom, hsat, e, hfac,
    fun n => ⟨(pullbackChartEmbeddingTwistIso i hU n).symm ≪≫ (htw n).some⟩, hd⟩

/-- Sections over `⊤` of a pullback along an isomorphism. -/
private def sectionsPullbackIso {Y W : Scheme.{u}} (e : Y ≅ W) (F : W.Modules) :
    Γ((Scheme.Modules.pullback e.hom).obj F, ⊤) ≅ Γ(F, ⊤) :=
  ((Scheme.Modules.toPresheaf Y).mapIso
      ((Scheme.Modules.restrictFunctorIsoPullback e.hom).app F).symm).app (op ⊤) ≪≫
    F.restrictAppIso e.hom ⊤ ≪≫
    (F.presheaf.mapIso (eqToIso (by rw [Scheme.Hom.image_top_eq_opensRange,
      Scheme.Hom.opensRange_of_isIso] : e.hom ''ᵁ ⊤ = ⊤)).op).symm

/-- **Step 2 of the proof of Theorem 7.17: the sections of `L^N` over `f⁻¹(U)` are the degree-`N`
part of the homogeneous coordinate ring, for large `N`** (Hartshorne II, pp. 166–167). Let
`i : Z ⟶ ℙʳ_X` be a closed immersion, `f = π ∘ i`, `L = i^* 𝒪(1)`, and `U ⊆ X` an affine open
with `Γ(X, U)` a finitely generated algebra over a field `k`. Let `T = Γ(X, U)[x₀, …, xᵣ]/I` be
the homogeneous coordinate ring of `f⁻¹(U) ⊆ ℙʳ_{Spec Γ(X, U)}` (`I` saturated), so that
`f⁻¹(U) ≅ Proj T`. Then for all large `N`, `Γ(f⁻¹(U), L^{N}) ≅ T_N`, the sections of the `N`-th
tensor power of `L|_{f⁻¹(U)}` (through `T_N → Γ(Proj T, 𝒪(N))`, `s ↦ s / 1`, Exercise 5.9). -/
theorem exists_addEquiv_sections_tensorPower_of_isAffineOpen (k : Type u) [Field k]
    {X Z : Scheme.{u}} (i : Z ⟶ projectiveSpaceOverScheme r X) [IsClosedImmersion i]
    {U : X.Opens} (hU : IsAffineOpen U) [Algebra k Γ(X, U)] [Algebra.FiniteType k Γ(X, U)] :
    ∃ I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) Γ(X, U)),
      ProjectiveClosedSubscheme.saturation I.toIdeal = I.toIdeal ∧
      ∃ e : ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).toScheme ≅
          Proj (gradedQuotient (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) Γ(X, U)) I),
        e.hom ≫ projQuotientι _ I ≫
            (projectiveSpaceOverSpecIso Γ(X, U) r (Equiv.refl _)).hom = chartEmbedding i hU ∧
        ∃ n₀ : ℕ, ∀ N ≥ n₀, Nonempty (Γ(moduleSheafTensorPower (N + 1)
            ((Scheme.Modules.pullback ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).ι).obj
              ((Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf r X 1))), ⊤) ≃+
          gradedQuotient (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) Γ(X, U)) I (N + 1)) := by
  obtain ⟨I, hsat, e, hfac, htw, -⟩ :=
    exists_iso_proj_homogeneousCoordinateRing (chartEmbedding i hU)
  let : Algebra k (gradedQuotient (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) Γ(X, U)) I 0) :=
    ((chartZeroHom I).comp (algebraMap k Γ(X, U))).toAlgebra
  let φ : Γ(X, U) →ₐ[k]
      gradedQuotient (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) Γ(X, U)) I 0 :=
    { chartZeroHom I with commutes' := fun _ => rfl }
  have : Algebra.FiniteType k
      (gradedQuotient (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) Γ(X, U)) I 0) :=
    Algebra.FiniteType.of_surjective φ (chartZeroHom_surjective I)
  obtain ⟨n₀, hn₀⟩ := exists_bijective_twistSection_range k _
    (fun j => mk_mem_gradedQuotient (MvPolynomial.isHomogeneous_X _ j)) (adjoin_coord_eq_top I)
  refine ⟨I, hsat, e, hfac, n₀, fun N hN => ⟨?_⟩⟩
  let ι := ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).ι
  let fst := Limits.pullback.fst (projectiveSpaceOverIntegersMap r) (schemeToSpecZ X)
  let α : (Scheme.Modules.pullback ι).obj
      ((Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf r X 1)) ≅
      (Scheme.Modules.pullback (ι ≫ i ≫ fst)).obj
        (projTwistingSheaf (GeneratedProj.intGrading r) 1) :=
    (Scheme.Modules.pullback ι).mapIso ((Scheme.Modules.pullbackComp i fst).app _) ≪≫
      (Scheme.Modules.pullbackComp ι (i ≫ fst)).app _
  let β : (Scheme.Modules.pullback (ι ≫ i ≫ fst)).obj
      (projTwistingSheaf (GeneratedProj.intGrading r) ((N + 1 : ℕ) : ℤ)) ≅
      (Scheme.Modules.pullback ι).obj
        ((Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf r X ((N + 1 : ℕ) : ℤ))) :=
    ((Scheme.Modules.pullbackComp ι (i ≫ fst)).app _).symm ≪≫
      (Scheme.Modules.pullback ι).mapIso ((Scheme.Modules.pullbackComp i fst).app _).symm
  let γ := tensorPowerPullbackTwistIso (adjoin_intGrading_one_eq_top r) (ι ≫ i ≫ fst) α N ≪≫ β ≪≫
    (pullbackChartEmbeddingTwistIso i hU _).symm ≪≫ (htw _).some
  let δ := ((Scheme.Modules.toPresheaf _).mapIso γ).app (op ⊤) ≪≫ sectionsPullbackIso e _
  exact δ.addCommGroupIsoToAddEquiv.trans
    (AddEquiv.ofBijective (twistSectionHom (N + 1)) (hn₀ (N + 1) (by omega))).symm

