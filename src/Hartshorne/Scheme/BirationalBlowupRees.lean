/-!
# A graded algebra embedded in a polynomial ring is a Rees algebra

Supplements Hartshorne, *Algebraic Geometry*, II, proof of Theorem 7.17, Step 5 (p. 168).

Let `κ : A → K` be an injective ring map, `J ⊆ A` an ideal, and `S = ⊕_m S_m` a graded ring
generated by `S₀ ∪ S₁`, with `S₀ = A` through a ring map `ε : A → S`. Suppose `φ : S → K[T]` is an
injective ring map sending `S_m` to `K Tᵐ`, with `φ(ε a) = κ(a)` and `φ(S₁) = κ(J) T`. Then `φ`
identifies `S` with the Rees algebra `⊕_m Jᵐ Tᵐ ⊆ A[T]`: every graded piece `S_m` becomes `Jᵐ Tᵐ`
(`Hartshorne.BirationalBlowup.reesHomOfEmbedding`, `reesHomOfEmbedding_bijective`). This is the
identification, in the proof of Theorem 7.17, of every graded piece of the twisted section
algebra with the corresponding power of an ideal inside the function field.
-/

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry Limits Polynomial

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace Hartshorne.BirationalBlowup

section Algebra

variable {A K S : Type u} [CommRing A] [CommRing K] [CommRing S] {κ : A →+* K}
  (hκ : Function.Injective κ) {𝒮 : ℕ → AddSubgroup S} (J : Ideal A)
  (ε : A →+* S) (φ : S →+* K[X])
  (hgen : Subring.closure ((𝒮 0 : Set S) ∪ 𝒮 1) = ⊤)
  (h0 : ∀ x ∈ 𝒮 0, ∃ a, ε a = x) (hε : ∀ a, φ (ε a) = C (κ a))
  (h1 : ∀ x ∈ 𝒮 1, ∃ a ∈ J, φ x = monomial 1 (κ a))

include hgen h0 hε h1 in
theorem exists_rees_map_eq (x : S) :
    ∃ y ∈ reesAlgebra J, Polynomial.map κ y = φ x := by
  let T : Subring S :=
    { carrier := {x | ∃ y ∈ reesAlgebra J, Polynomial.map κ y = φ x}
      mul_mem' := fun ⟨y, hy, e⟩ ⟨y', hy', e'⟩ =>
        ⟨y * y', Subalgebra.mul_mem _ hy hy', by rw [Polynomial.map_mul, e, e', map_mul]⟩
      one_mem' := ⟨1, Subalgebra.one_mem _, by rw [Polynomial.map_one, map_one]⟩
      add_mem' := fun ⟨y, hy, e⟩ ⟨y', hy', e'⟩ =>
        ⟨y + y', Subalgebra.add_mem _ hy hy', by rw [Polynomial.map_add, e, e', map_add]⟩
      zero_mem' := ⟨0, Subalgebra.zero_mem _, by rw [Polynomial.map_zero, map_zero]⟩
      neg_mem' := fun ⟨y, hy, e⟩ =>
        ⟨-y, Subalgebra.neg_mem _ hy, by rw [Polynomial.map_neg, e, map_neg]⟩ }
  have hT : Subring.closure ((𝒮 0 : Set S) ∪ 𝒮 1) ≤ T := by
    refine Subring.closure_le.2 ?_
    rintro x (hx | hx)
    · obtain ⟨a, rfl⟩ := h0 x hx
      exact ⟨C a, Subalgebra.algebraMap_mem _ a, by rw [map_C, hε]⟩
    · obtain ⟨a, ha, e⟩ := h1 x hx
      exact ⟨monomial 1 a, reesAlgebra.monomial_mem.2 (by rwa [pow_one]),
        by rw [map_monomial, e]⟩
  rw [hgen] at hT
  exact hT (Subring.mem_top x)

/-- The element of the Rees algebra corresponding to an element of `S`. -/
def reesFun (x : S) : reesAlgebra J :=
  ⟨Classical.choose (exists_rees_map_eq J ε φ hgen h0 hε h1 x),
    (Classical.choose_spec (exists_rees_map_eq J ε φ hgen h0 hε h1 x)).1⟩

theorem map_reesFun (x : S) :
    Polynomial.map κ (reesFun J ε φ hgen h0 hε h1 x : A[X]) = φ x :=
  (Classical.choose_spec (exists_rees_map_eq J ε φ hgen h0 hε h1 x)).2

include hκ in
theorem reesFun_eq_iff (x : S) (y : reesAlgebra J) :
    reesFun J ε φ hgen h0 hε h1 x = y ↔ Polynomial.map κ (y : A[X]) = φ x :=
  ⟨fun h => h ▸ map_reesFun J ε φ hgen h0 hε h1 x, fun h => Subtype.ext
    (Polynomial.map_injective κ hκ ((map_reesFun J ε φ hgen h0 hε h1 x).trans h.symm))⟩

/-- **The identification with the Rees algebra** as a ring homomorphism `S → ⊕_m Jᵐ Tᵐ`. -/
def reesRingHom : S →+* reesAlgebra J where
  toFun := reesFun J ε φ hgen h0 hε h1
  map_one' := (reesFun_eq_iff hκ J ε φ hgen h0 hε h1 1 1).2 (by
    rw [OneMemClass.coe_one, Polynomial.map_one, map_one])
  map_mul' x y := (reesFun_eq_iff hκ J ε φ hgen h0 hε h1 _ _).2 (by
    rw [Subalgebra.coe_mul, Polynomial.map_mul, map_reesFun, map_reesFun, map_mul])
  map_zero' := (reesFun_eq_iff hκ J ε φ hgen h0 hε h1 0 0).2 (by
    rw [ZeroMemClass.coe_zero, Polynomial.map_zero, map_zero])
  map_add' x y := (reesFun_eq_iff hκ J ε φ hgen h0 hε h1 _ _).2 (by
    rw [Subalgebra.coe_add, Polynomial.map_add, map_reesFun, map_reesFun, map_add])

theorem map_reesRingHom (x : S) :
    Polynomial.map κ (reesRingHom hκ J ε φ hgen h0 hε h1 x : A[X]) = φ x :=
  map_reesFun J ε φ hgen h0 hε h1 x

theorem reesRingHom_eq_iff (x : S) (y : reesAlgebra J) :
    reesRingHom hκ J ε φ hgen h0 hε h1 x = y ↔ Polynomial.map κ (y : A[X]) = φ x :=
  reesFun_eq_iff hκ J ε φ hgen h0 hε h1 x y

theorem reesRingHom_algebraMap (a : A) :
    reesRingHom hκ J ε φ hgen h0 hε h1 (ε a) = algebraMap A (reesAlgebra J) a :=
  (reesRingHom_eq_iff hκ J ε φ hgen h0 hε h1 _ _).2 (by
    rw [coe_algebraMap_reesAlgebra, map_C, hε])

variable (hdeg : ∀ m, ∀ x ∈ 𝒮 m, ∃ b, φ x = monomial m b)

/-- **The identification with the Rees algebra** as a graded ring homomorphism
`S → ⊕_m Jᵐ Tᵐ`. -/
def reesHomOfEmbedding : 𝒮 →+*ᵍ reesGrading J where
  toRingHom := reesRingHom hκ J ε φ hgen h0 hε h1
  map_mem {m x} hx := fun k hk => by
    obtain ⟨b, hb⟩ := hdeg m x hx
    apply hκ
    rw [← coeff_map, map_reesRingHom, hb, coeff_monomial, if_neg (Ne.symm hk), map_zero]

theorem map_reesHomOfEmbedding (x : S) :
    Polynomial.map κ (reesHomOfEmbedding hκ J ε φ hgen h0 hε h1 hdeg x : A[X]) = φ x :=
  map_reesFun J ε φ hgen h0 hε h1 x

theorem reesHomOfEmbedding_algebraMap (a : A) :
    reesHomOfEmbedding hκ J ε φ hgen h0 hε h1 hdeg (ε a) = algebraMap A (reesAlgebra J) a :=
  reesRingHom_algebraMap hκ J ε φ hgen h0 hε h1 a

include hκ hgen h0 hε h1 hdeg in
/-- **Every graded piece is the corresponding power of the ideal**: if moreover `φ` is injective
and `κ(J) T ⊆ φ(S₁)`, then `S ≅ ⊕_m Jᵐ Tᵐ` as graded rings. -/
theorem reesHomOfEmbedding_bijective (hinj : Function.Injective φ)
    (h1' : ∀ a ∈ J, ∃ x ∈ 𝒮 1, φ x = monomial 1 (κ a)) :
    Function.Bijective (reesHomOfEmbedding hκ J ε φ hgen h0 hε h1 hdeg) := by
  refine ⟨fun x y hxy => hinj ?_, ?_⟩
  · rw [← map_reesHomOfEmbedding hκ J ε φ hgen h0 hε h1 hdeg x,
      ← map_reesHomOfEmbedding hκ J ε φ hgen h0 hε h1 hdeg y, hxy]
  · have hR : Subring.closure ((reesGrading J 0 : Set (reesAlgebra J)) ∪ reesGrading J 1) ≤
        (reesRingHom hκ J ε φ hgen h0 hε h1).range := by
      refine Subring.closure_le.2 ?_
      rintro y (hy | hy)
      · obtain ⟨a, ha⟩ := (bijective_reesGrading_zero J).2 ⟨y, hy⟩
        exact ⟨ε a, (reesRingHom_algebraMap hκ J ε φ hgen h0 hε h1 a).trans
          (congrArg Subtype.val ha)⟩
      · have hy1 := mem_reesGrading_iff.1 hy
        have ha : (y : A[X]).coeff 1 ∈ J := by
          simpa using (mem_reesAlgebra_iff J _).1 y.2 1
        obtain ⟨x, -, hx⟩ := h1' _ ha
        refine ⟨x, (reesRingHom_eq_iff hκ J ε φ hgen h0 hε h1 _ _).2 ?_⟩
        rw [hy1, map_monomial, hx]
    rw [closure_reesGrading_zero_union_one] at hR
    exact fun y => hR (Subring.mem_top y)

end Algebra

/-! ### The setting of Theorem 7.17, Steps 4–5 -/

section Setup

variable {r : ℕ} {X Z : Scheme.{u}} (i : Z ⟶ projectiveSpaceOverScheme r X) [IsIntegral X]
  [IsIntegral Z] [IsNoetherian X]

open SectionAlgebraModel Scheme in
/-- **The data of Hartshorne II, proof of Theorem 7.17, Steps 4–5**: `f = π ∘ i` maps the generic
point to the generic point, `θ` is a left inverse of `K(X) → K(Z)`, `e` trivializes `L = i^* 𝒪(1)`
near the generic point of `Z`, `S` is a section-algebra model of `f` in degree `d`,
`F = f_* L^{d}` is coherent, and `t : D ⟶ 𝒪_X` is a nonzero morphism from an invertible sheaf
with values in the denominator ideal of `F ⊆ K_X`. -/
structure Setup (d : ℕ) where
  /-- `f` maps the generic point to the generic point. -/
  hf : (proj i).base (genericPoint Z) = genericPoint X
  /-- A left inverse of `K(X) → K(Z)`. -/
  θ : Z.functionField →+* X.functionField
  hθ : ∀ g, θ ((proj i).genericFunctionFieldMap hf g) = g
  /-- An open set containing the generic point of `Z` on which `L` is trivial. -/
  W : Z.Opens
  /-- A trivializing section of `L` over `W`. -/
  e : Γ((Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf r X 1), W)
  he : IsTrivializingSection _ W e
  hW : genericPoint Z ∈ W
  /-- The section-algebra model. -/
  M : SectionModel i d
  hF : IsCoherent ((Modules.pushforward (proj i)).obj (tensorPowerL i (1 * d)))
  /-- The invertible sheaf `D = A^{-n}`. -/
  D : X.Modules
  hD : D.IsInvertible
  /-- The morphism `t : D ⟶ 𝒪_X`. -/
  t : @Quiver.Hom X.Modules _ D (SheafOfModules.unit X.ringCatSheaf)
  ht : ∀ (V : X.Opens) (ψ : Γ(D, V)),
    t.app V ψ ∈ (denominatorIdealSheaf hF (fracHom hf θ hθ he hW (1 * d))).ideal V
  ht0 : t ≠ 0

namespace Setup

variable {i} {d : ℕ} (P : Setup i d)

/-- The embedding `F = f_* L^{d} ⟶ K_X`. -/
abbrev ι := fracHom P.hf P.θ P.hθ P.he P.hW (1 * d)

theorem ι_injective (U : X.Opens) (hU : genericPoint X ∈ U) :
    Function.Injective (P.ι.app U) :=
  fracApp_injective P.hf P.he P.hW (1 * d) hU

/-- **The ideal `I` of the blowup**, the image of `F ⊗ D ⟶ 𝒪_X`. -/
abbrev I : QuasicoherentIdealSubsheaf X :=
  blowupIdeal P.hF P.ι P.ι_injective P.hD P.t P.ht P.ht0

/-- The section algebra `S`. -/
abbrev S : QuasiCoherentGradedAlgebra X := P.M.data.algebra

/-- The embedding `S(U) → K(X)[T]`. -/
abbrev β (U : X.AffineZariskiSite) (hU : genericPoint X ∈ U.1) :
    P.S.obj.obj (op U) →+* X.functionField[X] :=
  sectionToPoly P.hf P.θ P.hθ P.he P.hW P.M U hU

/-- The value `t(ψ) ∈ K(X)` on a frame `ψ` of `D` over `U`. -/
abbrev frameConst (U : X.AffineZariskiSite) (hU : genericPoint X ∈ U.1)
    (p : ULift.{u} (Fin 1) → Γ(P.D, U.1)) : X.functionField :=
  X.presheaf.germ U.1 (genericPoint X) hU (P.t.app U.1 (p default))

end Setup

end Setup

/-! ### Scaling the variable of a polynomial ring -/

section Scale

variable {K : Type u} [Field K]

/-- The substitution `T ↦ c T` on `K[T]`. -/
def scalePoly (c : K) : K[X] →+* K[X] :=
  eval₂RingHom C (C c * X)

theorem scalePoly_C (c b : K) : scalePoly c (C b) = C b :=
  eval₂_C _ _

theorem scalePoly_monomial (c b : K) (m : ℕ) :
    scalePoly c (monomial m b) = monomial m (c ^ m * b) := by
  rw [scalePoly, coe_eval₂RingHom, eval₂_monomial, mul_pow, ← C_pow, ← mul_assoc, ← C_mul,
    C_mul_X_pow_eq_monomial, mul_comm]

theorem scalePoly_injective {c : K} (hc : c ≠ 0) : Function.Injective (scalePoly c) := by
  have h : ∀ q : K[X], scalePoly c⁻¹ (scalePoly c q) = q := by
    intro q
    have := Polynomial.ringHom_ext (f := (scalePoly c⁻¹).comp (scalePoly c)) (g := RingHom.id _)
      (fun b => by simp [scalePoly_C]) (by
        change scalePoly c⁻¹ (scalePoly c X) = X
        rw [show scalePoly c X = C c * X from eval₂_X _ _, map_mul, scalePoly_C,
          show scalePoly c⁻¹ X = C c⁻¹ * X from eval₂_X _ _, ← mul_assoc, ← C_mul,
          mul_inv_cancel₀ hc, C_1, one_mul])
    exact congr($this q)
  exact Function.LeftInverse.injective h

end Scale

/-! ### The local identification `S(U) ≅ ⊕_m I(U)ᵐ` over a framed affine open -/

namespace Setup

open SectionAlgebraModel Scheme

variable {r : ℕ} {X Z : Scheme.{u}} {i : Z ⟶ projectiveSpaceOverScheme r X} [IsIntegral X]
  [IsIntegral Z] [IsNoetherian X] {d : ℕ} (P : Setup i d)
  (U : X.AffineZariskiSite) (hU : genericPoint X ∈ U.1) (p : ULift.{u} (Fin 1) → Γ(P.D, U.1))

/-- The embedding `S(U) → K(X)[T]` twisted by `t(ψ)`: `s ↦ t(ψ)ᵐ c(s) Tᵐ` for `s ∈ S(U)_m`. -/
abbrev φ : P.S.obj.obj (op U) →+* X.functionField[X] :=
  (scalePoly (P.frameConst U hU p)).comp (P.β U hU)

theorem φ_of_mem {m : ℕ} {x : P.S.obj.obj (op U)} (hx : x ∈ P.S.grading U m) :
    P.φ U hU p x = monomial m (P.frameConst U hU p ^ m *
      pieceCoeff P.hf P.θ P.he P.hW P.M U hU m ⟨x, hx⟩) := by
  rw [RingHom.comp_apply, sectionToPoly_of_mem, scalePoly_monomial]

theorem φ_structureMap (a : Γ(X, U.1)) :
    P.φ U hU p (P.S.structureMap.app (op U) a) = C (X.presheaf.germ U.1 (genericPoint X) hU a) := by
  rw [RingHom.comp_apply, sectionToPoly_structureMap, scalePoly_C]

theorem germ_eq_of_frac (s : Γ((Modules.pushforward (proj i)).obj (tensorPowerL i (1 * d)), U.1))
    (b : Γ(X, U.1))
    (hb : P.ι.app U.1 ((show Γ(X, U.1) from P.t.app U.1 (p default)) • s) = X.toK U.1 b) :
    X.presheaf.germ U.1 (genericPoint X) hU b =
      P.frameConst U hU p * coeffK P.hf P.θ P.he P.hW (1 * d) hU s := by
  have h2 : fracApp P.hf P.θ P.he P.hW (1 * d) U.1
      ((proj i).app U.1 (show Γ(X, U.1) from P.t.app U.1 (p default)) •
        (show Γ(tensorPowerL i (1 * d), proj i ⁻¹ᵁ U.1) from s)) = X.toK U.1 b := hb
  have := congrArg (totalQuotientSheafEquivFunctionField U.1 hU) h2
  rw [fracApp_spec, totalQuotientSheafEquivFunctionField_toK, coeffK_smul P.hf P.hθ] at this
  exact this.symm

variable {p} (hp : Ringed.IsLocalFrame (R := X.sheaf) P.D U.1 p)

include hp in
theorem exists_φ_eq_of_mem_one (x : P.S.obj.obj (op U)) (hx : x ∈ P.S.grading U 1) :
    ∃ a ∈ ReesAlgebraSheaf.idealOn (quasicoherentIdealSubsheafEquiv P.I) U,
      P.φ U hU p x = monomial 1 (X.presheaf.germ U.1 (genericPoint X) hU a) := by
  set s := (P.M.E U Nat.one_pos).symm ⟨x, hx⟩
  obtain ⟨b, hb⟩ := exists_smul_eq_toK_of_mem_denominatorIdealSheaf P.hF P.ι
    (P.ht U.1 (p default)) s
  refine ⟨b, (mem_blowupIdeal_iff P.hF P.ι P.ι_injective P.hD P.t P.ht P.ht0 hp b).2 ⟨s, hb⟩, ?_⟩
  rw [φ_of_mem P U hU p hx, pow_one, germ_eq_of_frac P U hU p s b hb,
    pieceCoeff_pos P.hf P.he P.hW P.M U hU Nat.one_pos]

include hp in
theorem exists_mem_one_φ_eq (a : Γ(X, U.1))
    (ha : a ∈ ReesAlgebraSheaf.idealOn (quasicoherentIdealSubsheafEquiv P.I) U) :
    ∃ x ∈ P.S.grading U 1,
      P.φ U hU p x = monomial 1 (X.presheaf.germ U.1 (genericPoint X) hU a) := by
  obtain ⟨s, hs⟩ := (mem_blowupIdeal_iff P.hF P.ι P.ι_injective P.hD P.t P.ht P.ht0 hp a).1 ha
  refine ⟨_, (P.M.E U Nat.one_pos s).2, ?_⟩
  rw [φ_of_mem P U hU p (P.M.E U Nat.one_pos s).2, pow_one, germ_eq_of_frac P U hU p s a hs,
    pieceCoeff_pos P.hf P.he P.hW P.M U hU Nat.one_pos]
  simp

theorem exists_structureMap_eq (x : P.S.obj.obj (op U)) (hx : x ∈ P.S.grading U 0) :
    ∃ a, P.S.structureMap.app (op U) a = x := by
  obtain ⟨a, ha⟩ := (P.M.data.degreeZero U).2 ⟨x, hx⟩
  exact ⟨a, congrArg Subtype.val ha⟩

theorem exists_φ_eq_monomial (m : ℕ) (x : P.S.obj.obj (op U)) (hx : x ∈ P.S.grading U m) :
    ∃ b, P.φ U hU p x = monomial m b :=
  ⟨_, φ_of_mem P U hU p hx⟩

/-- **The identification `S(U) ≅ ⊕_m I(U)ᵐ`** over an affine open `U` containing the generic point
on which `D` has a frame `ψ`: `s ∈ S(U)_m` goes to the function `t(ψ)ᵐ c(s)`. -/
def ρ : P.S.grading U →+*ᵍ P.I.reesAlgebra.grading U :=
  reesHomOfEmbedding (κ := (X.presheaf.germ U.1 (genericPoint X) hU).hom)
    (germ_injective_of_isIntegral X _ hU)
    (ReesAlgebraSheaf.idealOn (quasicoherentIdealSubsheafEquiv P.I) U)
    (P.S.structureMap.app (op U)).hom (P.φ U hU p) (P.M.data.generated U)
    (P.exists_structureMap_eq U) (P.φ_structureMap U hU p) (P.exists_φ_eq_of_mem_one U hU hp)
    (P.exists_φ_eq_monomial U hU (p := p))

theorem map_ρ (x : P.S.obj.obj (op U)) :
    Polynomial.map (X.presheaf.germ U.1 (genericPoint X) hU).hom
        (ReesAlgebraSheaf.toPolynomial _ (P.ρ U hU hp x)) = P.φ U hU p x :=
  map_reesHomOfEmbedding _ _ _ _ _ _ _ _ _ x

theorem ρ_structureMap (a : Γ(X, U.1)) :
    P.ρ U hU hp (P.S.structureMap.app (op U) a) = P.I.reesAlgebra.structureMap.app (op U) a :=
  reesHomOfEmbedding_algebraMap _ _ _ _ _ _ _ _ _ a

theorem ρ_bijective : Function.Bijective (P.ρ U hU hp) :=
  reesHomOfEmbedding_bijective _ _ _ _ _ _ _ _ _
    ((scalePoly_injective (germ_app_frame_ne_zero P.t P.ht0 hp hU)).comp
      (sectionToPoly_injective P.hf P.hθ P.he P.hW P.M U hU))
    (P.exists_mem_one_φ_eq U hU hp)


theorem ρ_eq_iff (x : P.S.obj.obj (op U)) (y : P.I.reesAlgebra.obj.obj (op U)) :
    P.ρ U hU hp x = y ↔ Polynomial.map (X.presheaf.germ U.1 (genericPoint X) hU).hom
      (ReesAlgebraSheaf.toPolynomial _ y) = P.φ U hU p x :=
  reesRingHom_eq_iff (germ_injective_of_isIntegral X _ hU) _ _ _ _ _ _ _ x y

end Setup

/-! ### Naturality and independence of the frame -/

namespace Setup

open SectionAlgebraModel Scheme QuasiCoherentGradedAlgebra

variable {r : ℕ} {X Z : Scheme.{u}} {i : Z ⟶ projectiveSpaceOverScheme r X} [IsIntegral X]
  [IsIntegral Z] [IsNoetherian X] {d : ℕ} (P : Setup i d)

theorem t_app_map {U V : X.Opens} (h : V ≤ U) (ψ : Γ(P.D, U)) :
    P.t.app V (P.D.presheaf.map (homOfLE h).op ψ) =
      X.presheaf.map (homOfLE h).op (P.t.app U ψ) := by
  have htn := ConcreteCategory.congr_hom (P.t.mapPresheaf.naturality (homOfLE h).op) ψ
  simp only [Modules.mapPresheaf_app, ConcreteCategory.comp_apply] at htn
  exact htn

theorem frameConst_restrict {U V : X.AffineZariskiSite} (g : V ⟶ U) (hV : genericPoint X ∈ V.1)
    (p : ULift.{u} (Fin 1) → Γ(P.D, U.1)) :
    P.frameConst V hV (restrictFrame g p) =
      P.frameConst U (AffineZariskiSite.toOpens_mono g.le hV) p := by
  rw [frameConst, frameConst, restrictFrame]
  refine (congrArg _ (P.t_app_map _ (p default))).trans ?_
  exact TopCat.Presheaf.germ_res_apply _ _ _ _ _

theorem φ_restrict {U V : X.AffineZariskiSite} (g : V ⟶ U) (hV : genericPoint X ∈ V.1)
    (p : ULift.{u} (Fin 1) → Γ(P.D, U.1)) (x : P.S.obj.obj (op U)) :
    P.φ V hV (restrictFrame g p) (P.S.restrict g x) =
      P.φ U (AffineZariskiSite.toOpens_mono g.le hV) p x := by
  rw [RingHom.comp_apply, RingHom.comp_apply, frameConst_restrict,
    sectionToPoly_restrict P.hf P.hθ P.he P.hW P.M U (AffineZariskiSite.toOpens_mono g.le hV) g hV]

/-- **Naturality of the identification `S(U) ≅ ⊕_m I(U)ᵐ`** under restriction, with the restricted
frame. -/
theorem ρ_restrict {U V : X.AffineZariskiSite} (g : V ⟶ U) (hV : genericPoint X ∈ V.1)
    {p : ULift.{u} (Fin 1) → Γ(P.D, U.1)} (hp : Ringed.IsLocalFrame (R := X.sheaf) P.D U.1 p) :
    (P.I.reesAlgebra.restrict g).comp (P.ρ U (AffineZariskiSite.toOpens_mono g.le hV) hp) =
      (P.ρ V hV (isLocalFrame_restrictFrame g hp)).comp (P.S.restrict g) := by
  refine GradedRingHom.ext fun x =>
    ((P.ρ_eq_iff V hV (isLocalFrame_restrictFrame g hp) _ _).2 ?_).symm
  change Polynomial.map _ (ReesAlgebraSheaf.toPolynomial _
    ((ReesAlgebraSheaf.functor _).map g.op (P.ρ U _ hp x))) = _
  rw [ReesAlgebraSheaf.toPolynomial_functor_map, Polynomial.map_map]
  refine Eq.trans ?_ (P.φ_restrict g hV p x).symm
  rw [← P.map_ρ U (AffineZariskiSite.toOpens_mono g.le hV) hp x]
  congr 1
  rw [← CommRingCat.hom_comp]
  exact congrArg CommRingCat.Hom.hom (X.presheaf.germ_res _ _ _)

attribute [local instance] sectionsAlgebra

theorem φ_scale (U : X.AffineZariskiSite) (hU : genericPoint X ∈ U.1)
    {p p' : ULift.{u} (Fin 1) → Γ(P.D, U.1)} (v : Γ(X, U.1)) (hv : p' default = v • p default)
    (x : P.S.obj.obj (op U)) :
    P.φ U hU p (SegreProduct.scale (P.S.grading U) (P.S.algebraMap_sections_mem U) v x) =
      P.φ U hU p' x := by
  have key := SegreProduct.ringHom_ext_of_homogeneous (𝒮 := P.S.grading U)
    (f := (P.φ U hU p).comp (SegreProduct.scale (P.S.grading U)
      (P.S.algebraMap_sections_mem U) v).toRingHom) (g := P.φ U hU p') fun m y hy => by
      change P.φ U hU p (SegreProduct.scale _ _ v y) = _
      rw [SegreProduct.scale_of_mem _ _ _ hy, Algebra.smul_def, map_mul, φ_of_mem P U hU p hy,
        φ_of_mem P U hU p' hy]
      change P.φ U hU p (P.S.structureMap.app (op U) (v ^ m)) * _ = _
      rw [φ_structureMap, C_mul_monomial]
      congr 1
      have ht : (show Γ(X, U.1) from P.t.app U.1 (v • p default)) =
          v * (show Γ(X, U.1) from P.t.app U.1 (p default)) :=
        Modules.Hom.app_smul P.t v (p default)
      have hc : P.frameConst U hU p' =
          X.presheaf.germ U.1 (genericPoint X) hU v * P.frameConst U hU p := by
        rw [frameConst, frameConst, hv, ← map_mul]
        exact congrArg _ ht
      rw [hc, map_pow, mul_pow, mul_assoc]
  exact congr($key x)

/-- **Changing the frame** `ψ` to `v ψ` composes the identification with `s ↦ vᵐ s`. -/
theorem ρ_smul (U : X.AffineZariskiSite) (hU : genericPoint X ∈ U.1)
    {p p' : ULift.{u} (Fin 1) → Γ(P.D, U.1)} (hp : Ringed.IsLocalFrame (R := X.sheaf) P.D U.1 p)
    (hp' : Ringed.IsLocalFrame (R := X.sheaf) P.D U.1 p') (v : Γ(X, U.1))
    (hv : p' default = v • p default) :
    P.ρ U hU hp' = (P.ρ U hU hp).comp
      (SegreProduct.scale (P.S.grading U) (P.S.algebraMap_sections_mem U) v) :=
  GradedRingHom.ext fun x => (P.ρ_eq_iff U hU hp' _ _).2 (by
    change Polynomial.map _ (ReesAlgebraSheaf.toPolynomial _ (P.ρ U hU hp _)) = _
    exact (P.map_ρ U hU hp _).trans (φ_scale P U hU v hv x))

private theorem exists_eq_smul_of_trivializing {V : X.Opens} {e : Γ(P.D, V)}
    (he : IsTrivializingSection P.D V e) (x : Γ(P.D, V)) : ∃ c : Γ(X, V), x = c • e := by
  obtain ⟨c, hc⟩ := (he V le_rfl).2 x
  refine ⟨c, hc.symm.trans ?_⟩
  change c • P.D.presheaf.map (𝟙 _) e = c • e
  rw [CategoryTheory.Functor.map_id]
  rfl

private theorem smul_left_injective_of_trivializing {V : X.Opens} {e : Γ(P.D, V)}
    (he : IsTrivializingSection P.D V e) {c c' : Γ(X, V)} (h : c • e = c' • e) : c = c' := by
  refine (he V le_rfl).1 ?_
  change c • P.D.presheaf.map (𝟙 _) e = c' • P.D.presheaf.map (𝟙 _) e
  rw [CategoryTheory.Functor.map_id]
  exact h

private theorem projMap_congr {A B : Type u} [CommRing A] [CommRing B] {𝒜 : ℕ → AddSubgroup A}
    {ℬ : ℕ → AddSubgroup B} [GradedRing 𝒜] [GradedRing ℬ] {φ ψ : 𝒜 →+*ᵍ ℬ} (e : φ = ψ)
    (hφ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map φ)
    (hψ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map ψ) :
    Proj.map φ hφ = Proj.map ψ hψ := by
  subst e
  rfl

/-- **Independence of the frame**: two frames of `D` over `U` give the same isomorphism
`Proj (⊕_m I(U)ᵐ) ≅ Proj S(U)`. -/
theorem projIso_ρ_eq (U : X.AffineZariskiSite) (hU : genericPoint X ∈ U.1)
    {p p' : ULift.{u} (Fin 1) → Γ(P.D, U.1)} (hp : Ringed.IsLocalFrame (R := X.sheaf) P.D U.1 p)
    (hp' : Ringed.IsLocalFrame (R := X.sheaf) P.D U.1 p') :
    projIsoOfBijective (P.ρ U hU hp') (P.ρ_bijective U hU hp') =
      projIsoOfBijective (P.ρ U hU hp) (P.ρ_bijective U hU hp) := by
  have ht : IsTrivializingSection P.D U.1 (p default) := IsTrivializingSection.of_isLocalFrame hp
  have ht' : IsTrivializingSection P.D U.1 (p' default) :=
    IsTrivializingSection.of_isLocalFrame hp'
  obtain ⟨v, hv⟩ := P.exists_eq_smul_of_trivializing ht (p' default)
  obtain ⟨w, hw⟩ := P.exists_eq_smul_of_trivializing ht' (p default)
  have hvw : v * w = 1 := P.smul_left_injective_of_trivializing ht'
    (by rw [mul_smul, ← hw, ← hv, one_smul])
  have hu : IsUnit v := IsUnit.of_mul_eq_one w hvw
  refine Iso.ext ?_
  rw [projIsoOfBijective_hom, projIsoOfBijective_hom]
  exact (projMap_congr (P.ρ_smul U hU hp hp' v hv) _ _).trans ((Proj.map_comp _ _
    (SegreProduct.irrelevant_le_scale _ _ hu) _).trans (by
      rw [SegreProduct.projMap_scale _ _ hu, Category.comp_id]))

end Setup

