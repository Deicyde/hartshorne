import Hartshorne.Scheme.ProjSurjectionClosedImmersion
import Mathlib.AlgebraicGeometry.IdealSheaf.Basic

/-!
# Homogeneous ideals and truncation define the same Proj subscheme

Hartshorne, *Algebraic Geometry*, II, Exercise 3.12(b).

Let `S` be an `ℕ`-graded ring and `I ⊆ S` a homogeneous ideal. The quotient `S/I`
is graded by the images of the graded pieces of `S`, and the quotient map
`S → S/I` is a surjective graded homomorphism, so (Exercise 3.12(a)) it induces a
closed immersion `Proj (S/I) ⟶ Proj S`. For `d₀ : ℕ`, the truncation
`I_{≥d₀} = ⊕_{d ≥ d₀} I_d` is the homogeneous ideal generated by the homogeneous
elements of `I` of degree `≥ d₀`. The closed subschemes defined by `I` and by
`I_{≥d₀}` coincide: the two closed immersions have the same ideal sheaf (kernel),
and `Proj (S/I) ≅ Proj (S/I_{≥d₀})` over `Proj S`.

The natural graded map `S/I_{≥d₀} → S/I` is bijective in every degree `≥ d₀`, so the
induced morphism `Proj (S/I) ⟶ Proj (S/I_{≥d₀})` is an isomorphism (chartwise, the
maps of degree-zero localizations at elements of degree `≥ d₀` are bijective), and
by functoriality of `Proj` it is compatible with the two closed immersions.

## Main results

* `Hartshorne.gradedQuotient`: the grading of `S/I`, with its `GradedRing` instance.
* `Hartshorne.homogeneousTruncation`: the truncation `I_{≥d₀}`, characterised by
  `Hartshorne.mem_homogeneousTruncation_of_mem_iff`.
* `Hartshorne.projQuotientι`: the closed immersion `Proj (S/I) ⟶ Proj S`.
* `Hartshorne.ker_projQuotientι_homogeneousTruncation`: equality of ideal sheaves.
* `Hartshorne.exists_iso_projQuotientι_homogeneousTruncation`: isomorphism over
  `Proj S`.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits
open HomogeneousIdeal HomogeneousLocalization TopologicalSpace
open AlgebraicGeometry

universe u

namespace Hartshorne

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

section GradedQuotient

variable (I : HomogeneousIdeal 𝒜)

/-- The grading of `S/I` by the images of the graded pieces of `S`. -/
def gradedQuotient (i : ℕ) : AddSubgroup (A ⧸ I.toIdeal) :=
  ((Ideal.Quotient.mk I.toIdeal).toAddMonoidHom.comp (AddSubgroupClass.subtype (𝒜 i))).range

variable {𝒜 I} in
theorem mem_gradedQuotient_iff {i : ℕ} {x : A ⧸ I.toIdeal} :
    x ∈ gradedQuotient 𝒜 I i ↔ ∃ a ∈ 𝒜 i, Ideal.Quotient.mk I.toIdeal a = x := by
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨a, a.2, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨⟨a, ha⟩, rfl⟩

variable {𝒜 I} in
theorem mk_mem_gradedQuotient {i : ℕ} {a : A} (ha : a ∈ 𝒜 i) :
    Ideal.Quotient.mk I.toIdeal a ∈ gradedQuotient 𝒜 I i :=
  mem_gradedQuotient_iff.mpr ⟨a, ha, rfl⟩

instance gradedQuotient_gradedMonoid : SetLike.GradedMonoid (gradedQuotient 𝒜 I) where
  one_mem := by
    rw [← map_one (Ideal.Quotient.mk I.toIdeal)]
    exact mk_mem_gradedQuotient SetLike.GradedOne.one_mem
  mul_mem := by
    intro i j x y hx hy
    obtain ⟨a, ha, rfl⟩ := mem_gradedQuotient_iff.mp hx
    obtain ⟨b, hb, rfl⟩ := mem_gradedQuotient_iff.mp hy
    rw [← map_mul]
    exact mk_mem_gradedQuotient (SetLike.mul_mem_graded ha hb)

namespace ProjTruncation

/-- The quotient map restricted to one graded piece. -/
def gradedQuotientPieceMk (i : ℕ) : 𝒜 i →+ gradedQuotient 𝒜 I i :=
  ((Ideal.Quotient.mk I.toIdeal).toAddMonoidHom.comp (AddSubgroupClass.subtype (𝒜 i))).rangeRestrict

theorem coe_gradedQuotientPieceMk (i : ℕ) (a : 𝒜 i) :
    (gradedQuotientPieceMk 𝒜 I i a : A ⧸ I.toIdeal) = Ideal.Quotient.mk I.toIdeal a :=
  rfl

theorem gradedQuotientDecompose_wd {a b : A} (h : I.toIdeal.quotientRel a b) :
    DirectSum.map (gradedQuotientPieceMk 𝒜 I) (DirectSum.decompose 𝒜 a) =
      DirectSum.map (gradedQuotientPieceMk 𝒜 I) (DirectSum.decompose 𝒜 b) := by
  rw [Submodule.quotientRel_def] at h
  refine DFinsupp.ext fun d => ?_
  rw [DirectSum.map_apply, DirectSum.map_apply]
  apply Subtype.ext
  rw [coe_gradedQuotientPieceMk, coe_gradedQuotientPieceMk, Ideal.Quotient.eq]
  have hd : (DirectSum.decompose 𝒜 (a - b) d : A) =
      (DirectSum.decompose 𝒜 a d : A) - (DirectSum.decompose 𝒜 b d : A) := by
    rw [DirectSum.decompose_sub]
    rfl
  rw [← hd]
  exact I.isHomogeneous d h

/-- The decomposition of `S/I` into its graded pieces. -/
def gradedQuotientDecomposeHom : (A ⧸ I.toIdeal) →+ DirectSum ℕ fun i => gradedQuotient 𝒜 I i :=
  AddMonoidHom.mk'
    (Quotient.lift (fun a => DirectSum.map (gradedQuotientPieceMk 𝒜 I) (DirectSum.decompose 𝒜 a))
      (fun _ _ h => gradedQuotientDecompose_wd 𝒜 I h))
    (by
      rintro ⟨a⟩ ⟨b⟩
      change DirectSum.map _ (DirectSum.decompose 𝒜 (a + b)) = _
      rw [DirectSum.decompose_add, map_add])

theorem gradedQuotientDecomposeHom_mk (a : A) :
    gradedQuotientDecomposeHom 𝒜 I (Ideal.Quotient.mk I.toIdeal a) =
      DirectSum.map (gradedQuotientPieceMk 𝒜 I) (DirectSum.decompose 𝒜 a) :=
  rfl

theorem coe_map_gradedQuotientPieceMk (z : DirectSum ℕ fun i => 𝒜 i) :
    DirectSum.coeAddMonoidHom (gradedQuotient 𝒜 I)
        (DirectSum.map (gradedQuotientPieceMk 𝒜 I) z) =
      Ideal.Quotient.mk I.toIdeal (DirectSum.coeAddMonoidHom 𝒜 z) := by
  induction z using DirectSum.induction_on with
  | zero => simp
  | add x y hx hy => simp [hx, hy]
  | of d x => simp [DirectSum.coeAddMonoidHom_of, coe_gradedQuotientPieceMk]

end ProjTruncation

open ProjTruncation in
/-- The images of the graded pieces form a direct-sum decomposition of `S/I`. -/
instance gradedQuotient_decomposition : DirectSum.Decomposition (gradedQuotient 𝒜 I) :=
  DirectSum.Decomposition.ofAddHom (gradedQuotient 𝒜 I) (gradedQuotientDecomposeHom 𝒜 I)
    (by
      apply AddMonoidHom.ext
      intro x
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      change DirectSum.coeAddMonoidHom _ (gradedQuotientDecomposeHom 𝒜 I _) = _
      rw [gradedQuotientDecomposeHom_mk, coe_map_gradedQuotientPieceMk]
      rw [show DirectSum.coeAddMonoidHom 𝒜 (DirectSum.decompose 𝒜 a) = a from
        (DirectSum.decompose 𝒜).symm_apply_apply a]
      rfl)
    (by
      apply AddMonoidHom.ext
      intro z
      induction z using DirectSum.induction_on with
      | zero => simp
      | add x y hx hy => simp only [map_add, hx, hy, AddMonoidHom.id_apply]
      | of d y =>
          obtain ⟨a, ha, hay⟩ := mem_gradedQuotient_iff.mp y.2
          change gradedQuotientDecomposeHom 𝒜 I
              (DirectSum.coeAddMonoidHom _ (DirectSum.of _ d y)) = _
          rw [DirectSum.coeAddMonoidHom_of, ← hay, gradedQuotientDecomposeHom_mk,
            DirectSum.decompose_of_mem 𝒜 ha, DirectSum.map_of]
          exact congrArg (DirectSum.of _ d) (Subtype.ext hay))

/-- **The graded quotient ring.** `S/I` is graded by the images of the `S_d`. -/
instance gradedQuotient_gradedRing : GradedRing (gradedQuotient 𝒜 I) where

/-- The quotient map `S → S/I` as a graded ring homomorphism. -/
def gradedQuotientMk : 𝒜 →+*ᵍ gradedQuotient 𝒜 I where
  __ := Ideal.Quotient.mk I.toIdeal
  map_mem := mk_mem_gradedQuotient

@[simp]
theorem gradedQuotientMk_apply (a : A) :
    gradedQuotientMk 𝒜 I a = Ideal.Quotient.mk I.toIdeal a :=
  rfl

theorem gradedQuotientMk_surjective : Function.Surjective (gradedQuotientMk 𝒜 I) :=
  Ideal.Quotient.mk_surjective

end GradedQuotient

section Truncation

/-- **The truncation** `I_{≥d₀} = ⊕_{d ≥ d₀} I_d` of a homogeneous ideal: the ideal
generated by the homogeneous elements of `I` of degree at least `d₀`. -/
def homogeneousTruncation (I : HomogeneousIdeal 𝒜) (d₀ : ℕ) : HomogeneousIdeal 𝒜 where
  toSubmodule := Ideal.span {a | ∃ d, d₀ ≤ d ∧ a ∈ 𝒜 d ∧ a ∈ I}
  is_homogeneous' := Ideal.homogeneous_span 𝒜 _ fun _ ⟨d, _, ha, _⟩ => ⟨d, ha⟩

variable {𝒜}

theorem homogeneousTruncation_le (I : HomogeneousIdeal 𝒜) (d₀ : ℕ) :
    homogeneousTruncation 𝒜 I d₀ ≤ I :=
  show Ideal.span _ ≤ I.toIdeal from Ideal.span_le.mpr fun _ ⟨_, _, _, h⟩ => h

theorem mem_homogeneousTruncation_of_le {I : HomogeneousIdeal 𝒜} {d₀ d : ℕ} (hd : d₀ ≤ d)
    {a : A} (ha : a ∈ 𝒜 d) (haI : a ∈ I) : a ∈ homogeneousTruncation 𝒜 I d₀ :=
  Ideal.subset_span ⟨d, hd, ha, haI⟩

/-- Every element of the truncation has vanishing components in degrees `< d₀`. -/
theorem decompose_eq_zero_of_mem_homogeneousTruncation {I : HomogeneousIdeal 𝒜} {d₀ : ℕ}
    {a : A} (ha : a ∈ homogeneousTruncation 𝒜 I d₀) {n : ℕ} (hn : n < d₀) :
    (DirectSum.decompose 𝒜 a n : A) = 0 := by
  change a ∈ Ideal.span _ at ha
  induction ha using Submodule.span_induction generalizing n with
  | mem x hx =>
    obtain ⟨d, hd, hx, -⟩ := hx
    exact DirectSum.decompose_of_mem_ne 𝒜 hx (by omega)
  | zero => simp
  | add x y _ _ hx hy =>
    rw [DirectSum.decompose_add, DirectSum.add_apply, AddMemClass.coe_add, hx hn, hy hn,
      add_zero]
  | smul r x _ ih =>
    induction r using DirectSum.Decomposition.inductionOn 𝒜 with
    | zero => simp
    | homogeneous m =>
      rw [smul_eq_mul, DirectSum.coe_decompose_mul_of_left_mem 𝒜 n m.2]
      split_ifs
      · rw [ih (by omega), mul_zero]
      · rfl
    | add r s hr hs =>
      rw [add_smul, DirectSum.decompose_add, DirectSum.add_apply, AddMemClass.coe_add, hr, hs,
        add_zero]

/-- **The homogeneous pieces of the truncation.** A homogeneous element of degree `d`
lies in `I_{≥d₀}` exactly when it is zero, or `d ≥ d₀` and it lies in `I`. -/
theorem mem_homogeneousTruncation_of_mem_iff {I : HomogeneousIdeal 𝒜} {d₀ d : ℕ}
    {a : A} (ha : a ∈ 𝒜 d) :
    a ∈ homogeneousTruncation 𝒜 I d₀ ↔ a = 0 ∨ (d₀ ≤ d ∧ a ∈ I) := by
  constructor
  · intro h
    by_cases hd : d₀ ≤ d
    · exact Or.inr ⟨hd, homogeneousTruncation_le I d₀ h⟩
    · left
      rw [← DirectSum.decompose_of_mem_same 𝒜 ha]
      exact decompose_eq_zero_of_mem_homogeneousTruncation h (by omega)
  · rintro (rfl | ⟨hd, haI⟩)
    · exact zero_mem _
    · exact mem_homogeneousTruncation_of_le hd ha haI

end Truncation

section Scheme

variable {𝒜}

namespace ProjTruncation

/-- A surjective graded homomorphism carries `S₊` onto a generating set of `T₊`. -/
theorem irrelevant_le_map_of_surjective {B τ : Type u} [CommRing B] [SetLike τ B]
    [AddSubgroupClass τ B] {ℬ : ℕ → τ} [GradedRing ℬ] {f : 𝒜 →+*ᵍ ℬ}
    (hf : Function.Surjective f) : ℬ₊ ≤ 𝒜₊.map f := by
  rw [← toIdeal_le_toIdeal_iff, toIdeal_irrelevant_le]
  intro i hi x hx
  obtain ⟨a, ha, rfl⟩ := ProjSurjection.exists_homogeneous_preimage hf hx
  exact Ideal.mem_map_of_mem _ (mem_irrelevant_of_mem 𝒜 hi ha)

/-- For a surjective graded homomorphism, the everywhere-defined partial Proj morphism
is Mathlib's `Proj.map`. -/
theorem topIso_inv_homOfLE_projPartialMap {B τ : Type u} [CommRing B] [SetLike τ B]
    [AddSubgroupClass τ B] {ℬ : ℕ → τ} [GradedRing ℬ] {f : 𝒜 →+*ᵍ ℬ}
    (hf : Function.Surjective f) :
    (Proj ℬ).topIso.inv ≫ (Proj ℬ).homOfLE (projPartialDomain_eq_top_of_surjective hf).ge ≫
      projPartialMap f = Proj.map f (irrelevant_le_map_of_surjective hf) := by
  rw [projPartialMap_eq_map (irrelevant_le_map_of_surjective hf), Scheme.homOfLE_ι_assoc]
  simp

end ProjTruncation

open ProjTruncation

variable (𝒜) in
/-- **The closed immersion `Proj (S/I) ⟶ Proj S`** induced by the graded quotient map
(Hartshorne II, Exercise 3.12(a)). -/
def projQuotientι (I : HomogeneousIdeal 𝒜) : Proj (gradedQuotient 𝒜 I) ⟶ Proj 𝒜 :=
  (Proj (gradedQuotient 𝒜 I)).topIso.inv ≫
    (Proj (gradedQuotient 𝒜 I)).homOfLE
      (projPartialDomain_eq_top_of_surjective (gradedQuotientMk_surjective 𝒜 I)).ge ≫
    projPartialMap (gradedQuotientMk 𝒜 I)

instance isClosedImmersion_projQuotientι (I : HomogeneousIdeal 𝒜) :
    IsClosedImmersion (projQuotientι 𝒜 I) :=
  isClosedImmersion_projPartialMap_comp_top_of_surjective (gradedQuotientMk_surjective 𝒜 I)

theorem projQuotientι_eq_map (I : HomogeneousIdeal 𝒜) :
    projQuotientι 𝒜 I = Proj.map (gradedQuotientMk 𝒜 I)
      (irrelevant_le_map_of_surjective (gradedQuotientMk_surjective 𝒜 I)) :=
  topIso_inv_homOfLE_projPartialMap (gradedQuotientMk_surjective 𝒜 I)

namespace ProjTruncation

variable (I : HomogeneousIdeal 𝒜) (d₀ : ℕ)

/-- The natural graded map `S/I_{≥d₀} → S/I`. -/
def truncationQuotientMap :
    gradedQuotient 𝒜 (homogeneousTruncation 𝒜 I d₀) →+*ᵍ gradedQuotient 𝒜 I where
  __ := Ideal.Quotient.factor (homogeneousTruncation_le I d₀)
  map_mem := by
    intro i x hx
    obtain ⟨a, ha, rfl⟩ := mem_gradedQuotient_iff.mp hx
    exact mk_mem_gradedQuotient ha

@[simp]
theorem truncationQuotientMap_mk (a : A) :
    truncationQuotientMap I d₀ (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk I.toIdeal a :=
  rfl

theorem truncationQuotientMap_surjective :
    Function.Surjective (truncationQuotientMap I d₀) := by
  intro y
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨Ideal.Quotient.mk _ a, rfl⟩

theorem truncationQuotientMap_comp :
    (truncationQuotientMap I d₀).comp (gradedQuotientMk 𝒜 (homogeneousTruncation 𝒜 I d₀)) =
      gradedQuotientMk 𝒜 I :=
  GradedRingHom.ext fun _ => rfl

/-- The natural map `S/I_{≥d₀} → S/I` is bijective in every degree `d ≥ d₀`. -/
theorem bijective_truncationQuotientMap (d : ℕ) (hd : d₀ ≤ d) :
    Function.Bijective ((truncationQuotientMap I d₀).gradedAddHom d) := by
  constructor
  · refine (injective_iff_map_eq_zero _).mpr fun x hx => ?_
    obtain ⟨a, ha, hax⟩ := mem_gradedQuotient_iff.mp x.2
    have h0 : Ideal.Quotient.mk I.toIdeal a = 0 := by
      have := congrArg Subtype.val hx
      rw [GradedRingHom.gradedAddHom_apply_coe, ← hax] at this
      exact this
    rw [Ideal.Quotient.eq_zero_iff_mem] at h0
    apply Subtype.ext
    rw [← hax, ZeroMemClass.coe_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact mem_homogeneousTruncation_of_le hd ha h0
  · intro y
    obtain ⟨a, ha, hay⟩ := mem_gradedQuotient_iff.mp y.2
    refine ⟨⟨Ideal.Quotient.mk _ a, mk_mem_gradedQuotient ha⟩, Subtype.ext ?_⟩
    rw [GradedRingHom.gradedAddHom_apply_coe, ← hay]
    rfl

/-- The induced morphism `Proj (S/I) ⟶ Proj (S/I_{≥d₀})` is an isomorphism. -/
theorem isIso_map_truncationQuotientMap :
    IsIso (Proj.map (truncationQuotientMap I d₀)
      (irrelevant_le_map_of_surjective (truncationQuotientMap_surjective I d₀))) := by
  have hiso : IsIso (projPartialMap (truncationQuotientMap I d₀)) :=
    isIso_projPartialMap_of_bijective (bijective_truncationQuotientMap I d₀)
  have hι : IsIso (projPartialDomain (truncationQuotientMap I d₀)).ι := by
    rw [isIso_iff_isOpenImmersion_and_surjective]
    refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
    have hy : y ∈ projPartialDomain (truncationQuotientMap I d₀) := by
      rw [projPartialDomain_eq_top_of_surjective (truncationQuotientMap_surjective I d₀)]
      trivial
    exact ⟨⟨y, hy⟩, rfl⟩
  rw [projPartialMap_eq_map
    (irrelevant_le_map_of_surjective (truncationQuotientMap_surjective I d₀))] at hiso
  exact IsIso.of_isIso_comp_left (projPartialDomain (truncationQuotientMap I d₀)).ι _

theorem map_congr {B τ : Type u} [CommRing B] [SetLike τ B]
    [AddSubgroupClass τ B] {ℬ : ℕ → τ} [GradedRing ℬ] {f f' : 𝒜 →+*ᵍ ℬ} (h : f = f')
    (hf : ℬ₊ ≤ 𝒜₊.map f) (hf' : ℬ₊ ≤ 𝒜₊.map f') : Proj.map f hf = Proj.map f' hf' := by
  subst h
  rfl

/-- The isomorphism `Proj (S/I) ⟶ Proj (S/I_{≥d₀})` is compatible with the closed
immersions into `Proj S`. -/
theorem map_truncationQuotientMap_comp_projQuotientι :
    Proj.map (truncationQuotientMap I d₀)
        (irrelevant_le_map_of_surjective (truncationQuotientMap_surjective I d₀)) ≫
      projQuotientι 𝒜 (homogeneousTruncation 𝒜 I d₀) = projQuotientι 𝒜 I := by
  rw [projQuotientι_eq_map, projQuotientι_eq_map, ← Proj.map_comp]
  exact map_congr (truncationQuotientMap_comp I d₀) _ _

end ProjTruncation

/-- **Hartshorne II, Exercise 3.12(b), isomorphism over `Proj S`.** For a homogeneous
ideal `I` and `d₀ : ℕ`, the closed subschemes `Proj (S/I)` and `Proj (S/I_{≥d₀})` of
`Proj S` are isomorphic over `Proj S`. -/
theorem exists_iso_projQuotientι_homogeneousTruncation (I : HomogeneousIdeal 𝒜) (d₀ : ℕ) :
    ∃ e : Proj (gradedQuotient 𝒜 I) ≅ Proj (gradedQuotient 𝒜 (homogeneousTruncation 𝒜 I d₀)),
      e.hom ≫ projQuotientι 𝒜 (homogeneousTruncation 𝒜 I d₀) = projQuotientι 𝒜 I := by
  have := isIso_map_truncationQuotientMap I d₀
  exact ⟨asIso (Proj.map (truncationQuotientMap I d₀)
    (irrelevant_le_map_of_surjective (truncationQuotientMap_surjective I d₀))),
    map_truncationQuotientMap_comp_projQuotientι I d₀⟩

/-- **Hartshorne II, Exercise 3.12(b).** For a homogeneous ideal `I` and `d₀ : ℕ`, the
truncation `I_{≥d₀}` defines the same closed subscheme of `Proj S` as `I`: the closed
immersions `Proj (S/I_{≥d₀}) ⟶ Proj S` and `Proj (S/I) ⟶ Proj S` have the same ideal
sheaf. -/
theorem ker_projQuotientι_homogeneousTruncation (I : HomogeneousIdeal 𝒜) (d₀ : ℕ) :
    (projQuotientι 𝒜 (homogeneousTruncation 𝒜 I d₀)).ker = (projQuotientι 𝒜 I).ker := by
  have := isIso_map_truncationQuotientMap I d₀
  rw [← map_truncationQuotientMap_comp_projQuotientι I d₀, Scheme.Hom.ker_comp_of_isIso]

end Scheme

end Hartshorne
