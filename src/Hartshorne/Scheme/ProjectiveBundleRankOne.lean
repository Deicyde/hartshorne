/-!
# The projective bundle of an invertible sheaf

Hartshorne, *Algebraic Geometry*, II, Caution 7.8.8 (p. 161) and Exercise 7.14(a) (p. 171). The
book treats `X = ℙ¹`, `E = 𝒪(-1)`; the statements for an arbitrary invertible `E` generalize it.

Let `X` be a Noetherian scheme and `E` an invertible `𝒪_X`-module, so that `E` has rank one. Then
the projection `π : P(E) ⟶ X` is an isomorphism and, along it, `𝒪_{P(E)}(1)` corresponds to `E`:

* By Exercise 7.8, the identity quotient `E ⟶ E` gives a section `s` of `π`, and the invertible
  quotient `E ≅ s^* π^* E ⟶ s^* 𝒪(1)` attached to `s` is equivalent to it, so `s^* 𝒪(1) ≅ E`.
* Any two invertible quotients of an invertible sheaf are equivalent, since a surjection of
  invertible sheaves is an isomorphism (Exercise 7.1). The morphisms `s ∘ π` and `id` of `P(E)`
  over `X` therefore give equivalent quotients of `π^* E`, so `s ∘ π = id` by Proposition 7.12.
* The tautological quotient `π^* E ⟶ 𝒪(1)` is a surjection of invertible sheaves, hence an
  isomorphism `𝒪(1) ≅ π^* E`.

If moreover `X` is nonempty and `Γ(X, E) = 0`, then `𝒪_{P(E)}(1)` is not very ample relative to
`X`: a very ample sheaf is the pullback of `𝒪(1)` along an immersion into projective space, hence
generated by global sections; pulling back along `s`, so is `E`, which is impossible for an
invertible sheaf without nonzero global sections on a nonempty scheme. This applies to
`X = ℙ¹_k` and `E = 𝒪(-1)`, which has no nonzero global sections.

## Main results

* `AlgebraicGeometry.Scheme.Modules.projectiveBundleIsoOfIsInvertible`: `P(E) ≅ X`, whose
  forward map is `π`.
* `AlgebraicGeometry.Scheme.Modules.nonempty_pullback_projectiveBundleIsoOfIsInvertible_inv_iso`:
  the pullback of `𝒪_{P(E)}(1)` along `X ≅ P(E)` is isomorphic to `E`.
* `AlgebraicGeometry.Scheme.Modules.isIso_projectiveBundleTautologicalQuotient_of_isInvertible`:
  the tautological quotient `π^* E ⟶ 𝒪(1)` is an isomorphism.
* `AlgebraicGeometry.Scheme.Modules.not_isVeryAmpleRelative_projectiveBundleTwistingSheaf`:
  `𝒪_{P(E)}(1)` is not very ample relative to `X` when `X` is nonempty and `Γ(X, E) = 0`.
* `Hartshorne.projectiveBundle_projectiveLine_twist_neg_one`: the example `X = ℙ¹_k`,
  `E = 𝒪(-1)`.
-/

universe u

open CategoryTheory

noncomputable section

namespace AlgebraicGeometry.Scheme.Modules

open Hartshorne

/-- **Invertible quotients of an invertible sheaf are all equivalent.** For an invertible sheaf
`F`, each quotient map `F ⟶ L` onto an invertible sheaf is a surjection of invertible sheaves,
hence an isomorphism, so any two such quotients differ by an isomorphism of the targets. -/
theorem InvertibleQuotient.equiv_of_isInvertible {Y : Scheme.{u}} {F : Y.Modules}
    (hF : F.IsInvertible) (a b : InvertibleQuotient F) : a.Equiv b := by
  have := a.epi
  have := b.epi
  have := isIso_of_epi_of_isInvertible hF a.isInvertible a.quotient
  have := isIso_of_epi_of_isInvertible hF b.isInvertible b.quotient
  exact ⟨(asIso a.quotient).symm ≪≫ asIso b.quotient, by simp⟩

/-- The identity quotient `F ⟶ F` of an invertible sheaf `F`. -/
def InvertibleQuotient.ofIsInvertible {Y : Scheme.{u}} {F : Y.Modules} (hF : F.IsInvertible) :
    InvertibleQuotient F where
  sheaf := F
  isInvertible := hF
  quotient := 𝟙 F
  epi := inferInstance

variable {X : Scheme.{u}} {E : X.Modules} (hE : E.IsLocallyFree)
  (hfin : ∀ x, E.rankAt x < Cardinal.aleph0) [IsNoetherian X] (hL : E.IsInvertible)

/-- For an invertible sheaf `E`, the section of `π : P(E) ⟶ X` corresponding to the identity
quotient `E ⟶ E` under the bijection between sections of `π` and invertible quotients of `E`. -/
def projectiveBundleSectionOfIsInvertible : X ⟶ projectiveBundle hE hfin :=
  ((projectiveBundleSectionEquiv hE hfin).symm ⟦InvertibleQuotient.ofIsInvertible hL⟧).1

/-- The morphism `projectiveBundleSectionOfIsInvertible` is a section of `π : P(E) ⟶ X`. -/
@[reassoc (attr := simp)]
theorem projectiveBundleSectionOfIsInvertible_proj :
    projectiveBundleSectionOfIsInvertible hE hfin hL ≫ projectiveBundleProj hE hfin = 𝟙 X :=
  ((projectiveBundleSectionEquiv hE hfin).symm ⟦InvertibleQuotient.ofIsInvertible hL⟧).2

/-- The section `s` of `π : P(E) ⟶ X` attached to the identity quotient of an invertible sheaf
`E` satisfies `s^* 𝒪_{P(E)}(1) ≅ E`. -/
theorem nonempty_pullback_projectiveBundleSectionOfIsInvertible_iso :
    Nonempty ((Scheme.Modules.pullback (projectiveBundleSectionOfIsInvertible hE hfin hL)).obj
      (projectiveBundleTwistingSheaf hE hfin 1) ≅ E) := by
  have h := (projectiveBundleSectionEquiv_apply hE hfin _
    (projectiveBundleSectionOfIsInvertible_proj hE hfin hL)).symm.trans
    ((projectiveBundleSectionEquiv hE hfin).apply_symm_apply
      ⟦InvertibleQuotient.ofIsInvertible hL⟧)
  obtain ⟨e, -⟩ := Quotient.exact h
  exact ⟨e⟩

/-- For an invertible sheaf `E`, the section `s` of `π : P(E) ⟶ X` attached to the identity
quotient is also a retraction: `s ∘ π = id`. Both `s ∘ π` and `id` are morphisms `P(E) ⟶ P(E)`
over `X`, and any two invertible quotients of the invertible sheaf `π^* E` are equivalent. -/
@[reassoc (attr := simp)]
theorem projectiveBundleProj_sectionOfIsInvertible :
    projectiveBundleProj hE hfin ≫ projectiveBundleSectionOfIsInvertible hE hfin hL = 𝟙 _ := by
  have hφ : (projectiveBundleProj hE hfin ≫ projectiveBundleSectionOfIsInvertible hE hfin hL) ≫
      projectiveBundleProj hE hfin = projectiveBundleProj hE hfin := by
    rw [Category.assoc, projectiveBundleSectionOfIsInvertible_proj, Category.comp_id]
  exact projectiveBundle_hom_eq_of_equiv hE hfin hφ (Category.id_comp _)
    (InvertibleQuotient.equiv_of_isInvertible (IsInvertible.pullback _ hL) _ _)

/-- **The projective bundle of an invertible sheaf**: for an invertible sheaf `E` on a Noetherian
scheme `X`, the projection `π : P(E) ⟶ X` is an isomorphism, with inverse the section of `π`
attached to the identity quotient `E ⟶ E`. This generalizes the case `X = ℙ¹`, `E = 𝒪(-1)` of
Hartshorne II, Caution 7.8.8. -/
def projectiveBundleIsoOfIsInvertible : projectiveBundle hE hfin ≅ X where
  hom := projectiveBundleProj hE hfin
  inv := projectiveBundleSectionOfIsInvertible hE hfin hL
  hom_inv_id := projectiveBundleProj_sectionOfIsInvertible hE hfin hL
  inv_hom_id := projectiveBundleSectionOfIsInvertible_proj hE hfin hL

/-- The isomorphism `P(E) ≅ X` for an invertible sheaf `E` is the projection `π`, so it is an
isomorphism over `X`. -/
@[simp]
theorem projectiveBundleIsoOfIsInvertible_hom :
    (projectiveBundleIsoOfIsInvertible hE hfin hL).hom = projectiveBundleProj hE hfin :=
  rfl

/-- **`𝒪_{P(E)}(1)` corresponds to `E`**: for an invertible sheaf `E` on a Noetherian scheme `X`,
the pullback of `𝒪_{P(E)}(1)` along the inverse `X ≅ P(E)` of the projection is isomorphic to
`E`. This generalizes the case `X = ℙ¹`, `E = 𝒪(-1)` of Hartshorne II, Caution 7.8.8. -/
theorem nonempty_pullback_projectiveBundleIsoOfIsInvertible_inv_iso :
    Nonempty ((Scheme.Modules.pullback (projectiveBundleIsoOfIsInvertible hE hfin hL).inv).obj
      (projectiveBundleTwistingSheaf hE hfin 1) ≅ E) :=
  nonempty_pullback_projectiveBundleSectionOfIsInvertible_iso hE hfin hL

include hL in
/-- For an invertible sheaf `E` on a Noetherian scheme `X`, the tautological quotient
`π^* E ⟶ 𝒪_{P(E)}(1)` is an isomorphism: it is a surjection of invertible sheaves. -/
theorem isIso_projectiveBundleTautologicalQuotient_of_isInvertible :
    IsIso (projectiveBundleTautologicalQuotient hE hfin) :=
  isIso_of_epi_of_isInvertible (IsInvertible.pullback _ hL)
    (isInvertible_projectiveBundleTwistingSheaf_one hE hfin) _

/-- On a nonempty scheme, an invertible sheaf without nonzero global sections is not generated by
global sections. -/
theorem not_isGloballyGenerated_of_isInvertible {Y : Scheme.{u}} {F : Y.Modules}
    (hF : F.IsInvertible) (hY : Nonempty Y) (hΓ : ∀ t : Γ(F, ⊤), t = 0) :
    ¬ F.IsGloballyGenerated := by
  rintro ⟨ι, σ, hσ⟩
  have hgen : F.IsGeneratedBySections (fun i : PEmpty.{u + 1} => i.elim) := fun x => by
    rw [eq_top_iff, ← hσ x, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    dsimp only
    rw [hΓ (σ i), map_zero]
    exact zero_mem _
  exact (isEmpty_of_isInvertible_of_isGeneratedBySections hF hgen).false hY.some

include hL in
/-- **The tautological sheaf need not be very ample**: for an invertible sheaf `E` without nonzero
global sections on a nonempty Noetherian scheme `X`, the sheaf `𝒪_{P(E)}(1)` is not very ample
relative to `X`. This generalizes the case `X = ℙ¹`, `E = 𝒪(-1)` of Hartshorne II,
Caution 7.8.8. A sheaf very ample relative to `X` is generated by global sections, and its
pullback `E` along the section of `π` attached to the identity quotient would then be generated
by global sections too. -/
theorem not_isVeryAmpleRelative_projectiveBundleTwistingSheaf (hX : Nonempty X)
    (hΓ : ∀ t : Γ(E, ⊤), t = 0) :
    ¬ Hartshorne.IsVeryAmpleRelative (projectiveBundleProj hE hfin)
      (projectiveBundleTwistingSheaf hE hfin 1) := by
  intro hV
  obtain ⟨e⟩ := nonempty_pullback_projectiveBundleSectionOfIsInvertible_iso hE hfin hL
  exact not_isGloballyGenerated_of_isInvertible hL hX hΓ (isGloballyGenerated_of_iso e
    (isGloballyGenerated_pullback _ (isGloballyGenerated_of_isVeryAmpleRelative hV)))

end AlgebraicGeometry.Scheme.Modules

namespace Hartshorne

open AlgebraicGeometry Scheme.Modules

attribute [local instance] MvPolynomial.gradedAlgebra

variable (k : Type u) [Field k]

/-- The twisting sheaf `𝒪(-1)` on `ℙ¹_k = Proj k[x₀, x₁]`. -/
local notation "𝒪₋₁" => projTwistingSheaf (MvPolynomial.homogeneousSubmodule (Fin 2) k) (-1)

/-- `𝒪(-1)` on `ℙ¹_k` is locally free. -/
theorem isLocallyFree_projectiveLine_twist_neg_one : (𝒪₋₁).IsLocallyFree :=
  ((isInvertible_iff _).1 (ProjectiveSpacePicard.projTwistingSheaf_isInvertible (n := 1) (-1))).1

/-- `𝒪(-1)` on `ℙ¹_k` has finite rank. -/
theorem rankAt_projectiveLine_twist_neg_one_lt (x : Proj (MvPolynomial.homogeneousSubmodule
    (Fin 2) k)) : (𝒪₋₁).rankAt x < Cardinal.aleph0 := by
  rw [((isInvertible_iff _).1
    (ProjectiveSpacePicard.projTwistingSheaf_isInvertible (n := 1) (-1))).2 x]
  exact Cardinal.one_lt_aleph0

/-- **The tautological sheaf of `P(𝒪(-1))` on `ℙ¹` is not very ample** (Hartshorne II,
Caution 7.8.8 and Exercise 7.14(a)). Let `X = ℙ¹_k` over a field `k` and `E = 𝒪_X(-1)`. The
projection `π : P(E) ⟶ X` is an isomorphism over `X`; along it, `𝒪_{P(E)}(1)` corresponds to `E`;
and `𝒪_{P(E)}(1)` is not very ample relative to `X`. The last part uses `Γ(ℙ¹_k, 𝒪(-1)) = 0`. -/
theorem projectiveBundle_projectiveLine_twist_neg_one :
    ∃ e : projectiveBundle (isLocallyFree_projectiveLine_twist_neg_one k)
        (rankAt_projectiveLine_twist_neg_one_lt k) ≅
        Proj (MvPolynomial.homogeneousSubmodule (Fin 2) k),
      e.hom = projectiveBundleProj _ _ ∧
      Nonempty ((Scheme.Modules.pullback e.inv).obj (projectiveBundleTwistingSheaf
        (isLocallyFree_projectiveLine_twist_neg_one k)
        (rankAt_projectiveLine_twist_neg_one_lt k) 1) ≅ 𝒪₋₁) ∧
      ¬ IsVeryAmpleRelative (projectiveBundleProj (isLocallyFree_projectiveLine_twist_neg_one k)
        (rankAt_projectiveLine_twist_neg_one_lt k))
        (projectiveBundleTwistingSheaf (isLocallyFree_projectiveLine_twist_neg_one k)
          (rankAt_projectiveLine_twist_neg_one_lt k) 1) := by
  have hL := ProjectiveSpacePicard.projTwistingSheaf_isInvertible (k := k) (n := 1) (-1)
  refine ⟨projectiveBundleIsoOfIsInvertible _ _ hL, rfl,
    nonempty_pullback_projectiveBundleIsoOfIsInvertible_inv_iso _ _ hL,
    not_isVeryAmpleRelative_projectiveBundleTwistingSheaf _ _ hL inferInstance fun t => ?_⟩
  exact ProjectiveSpaceSectionRing.projTwistingSheaf_global_eq_zero (r := 1) Nat.one_pos
    (by norm_num) t

end Hartshorne
