import Hartshorne.RingedSpace.ModuleSheafTensorPowerIso

/-!
# A closed subscheme of `ℙʳ_A` as `Proj` of its homogeneous coordinate ring, with `𝒪(1)`

Hartshorne, *Algebraic Geometry*, II, proof of Theorem 7.17, Step 2 (pp. 166–167), the affine
input: over an affine open `U = Spec A` of the base, a projective embedding `Z ⊆ ℙʳ_A` exhibits `Z`
as `Proj T` for the homogeneous coordinate ring `T = A[x₀, …, xᵣ] / I` (Corollary 5.16), and the
line bundle `L = 𝒪(1)|_Z` of the embedding as `𝒪_{Proj T}(1)`.

* `SectionAlgebraModel.pullbackProjMapTwistIso`: for a graded homomorphism `φ : S → T` with
  `T₊ ⊆ φ(S₊)T` and `S` generated by `S₁` over `S₀`, `(Proj.map φ)^* 𝒪_{Proj S}(n) ≅ 𝒪_{Proj T}(n)`
  (from Proposition 5.12(c) in the form `ProjTwistPullback.pullbackTwistIso`).
* `SectionAlgebraModel.pullbackProjectiveSpaceOverSpecTwistIso`: under
  `Proj A[x₀, …, xᵣ] ≅ ℙʳ_{Spec A}` the twisting sheaf `𝒪(n)` of `ℙʳ_{Spec A}` (pulled back from
  `ℙʳ_ℤ`) is `𝒪_{Proj A[x]}(n)`.
* `SectionAlgebraModel.exists_iso_proj_homogeneousCoordinateRing`: for a closed immersion
  `i : Z ⟶ ℙʳ_{Spec A}` there is a saturated homogeneous ideal `I` (Exercise 5.10) and an
  isomorphism `e : Z ≅ Proj (A[x]/I)` over `ℙʳ_{Spec A}` with `i^* 𝒪(n) ≅ e^* 𝒪_{Proj (A[x]/I)}(n)`
  for all `n`; if `Z` is integral, `A[x]/I` is a domain.
* `SectionAlgebraModel.tensorPowerPullbackTwistIso`,
  `SectionAlgebraModel.tensorPowerPullbackProjectiveSpaceTwistIso`: for `L = ψ^* 𝒪(1)`, the tensor
  power `L^{N+1}` is `ψ^* 𝒪(N + 1)` (Proposition 5.12(b) pulled back).
* `SectionAlgebraModel.chartEmbedding`, `isClosedImmersion_chartEmbedding`,
  `pullbackChartEmbeddingTwistIso`: for `i : Z ⟶ ℙʳ_X` and an affine open `U ⊆ X`, the closed
  immersion `f⁻¹(U) ⟶ ℙʳ_{Spec Γ(X, U)}` induced by `i` (`f = π ∘ i`), along which `𝒪(n)` pulls
  back to the restriction of `i^* 𝒪(n)`.
-/

universe u

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace Hartshorne

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

namespace SectionAlgebraModel

section ProjMap

variable {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ] (φ : 𝒜 →+*ᵍ ℬ)
  (hf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map φ)

/-- The inverse `Proj T ⟶ U` of the inclusion of the (full) domain `U` of the partial map. -/
private def toDomain : Proj ℬ ⟶ (projPartialDomain φ).toScheme :=
  (Proj ℬ).topIso.inv ≫ (Proj ℬ).homOfLE (projPartialDomain_eq_top hf).ge

private theorem toDomain_ι : toDomain φ hf ≫ (projPartialDomain φ).ι = 𝟙 _ := by
  simp [toDomain]

private theorem toDomain_projPartialMap : toDomain φ hf ≫ projPartialMap φ = Proj.map φ hf := by
  rw [projPartialMap_eq_map hf, ← Category.assoc, toDomain_ι, Category.id_comp]

/-- **Pullback of twisting sheaves along `Proj.map`** (Hartshorne II, Proposition 5.12(c), the
everywhere-defined case). For a graded homomorphism `φ : S → T` with `T₊ ⊆ φ(S₊) T`, where `S` is
generated by `S₁` over `S₀`, `(Proj.map φ)^* 𝒪_{Proj S}(n) ≅ 𝒪_{Proj T}(n)`. -/
def pullbackProjMapTwistIso (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℤ) :
    (Scheme.Modules.pullback (Proj.map φ hf)).obj (projTwistingSheaf 𝒜 n) ≅
      projTwistingSheaf ℬ n :=
  (Scheme.Modules.pullbackCongr (toDomain_projPartialMap φ hf).symm).app _ ≪≫
    ((Scheme.Modules.pullbackComp (toDomain φ hf) (projPartialMap φ)).app _).symm ≪≫
    (Scheme.Modules.pullback (toDomain φ hf)).mapIso
      (ProjTwistPullback.pullbackTwistIso φ n hgen ≪≫
        (Scheme.Modules.restrictFunctorIsoPullback (projPartialDomain φ).ι).app _) ≪≫
    (Scheme.Modules.pullbackComp (toDomain φ hf) (projPartialDomain φ).ι).app _ ≪≫
    (Scheme.Modules.pullbackCongr (toDomain_ι φ hf)).app _ ≪≫
    (Scheme.Modules.pullbackId _).app _

end ProjMap

section TensorPower

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜] (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤)
  {Z : Scheme.{u}} (ψ : Z ⟶ Proj 𝒜)

/-- `F ≅ F'` and `G ≅ G'` induce `F ⊗ G ≅ F' ⊗ G'`. -/
private def tensorIsoOfIso {F F' G G' : Z.Modules} (α : F ≅ F') (β : G ≅ G') :
    moduleSheafTensor F G ≅ moduleSheafTensor F' G' :=
  Ringed.moduleSheafTensorIsoTensor F G ≪≫ MonoidalCategory.tensorIso α β ≪≫
    (Ringed.moduleSheafTensorIsoTensor F' G').symm

/-- **Tensor powers of a pulled-back `𝒪(1)`** (Hartshorne II.5.12(b) with pullback). For a
morphism `ψ : Z ⟶ Proj S`, where `S` is generated by `S₁` over `S₀`, and `L ≅ ψ^* 𝒪(1)`, the
tensor power `L^{N+1}` is `ψ^* 𝒪(N + 1)`. -/
noncomputable def tensorPowerPullbackTwistIso {L : Z.Modules}
    (α : L ≅ (Scheme.Modules.pullback ψ).obj (projTwistingSheaf 𝒜 1)) : ∀ N : ℕ,
    moduleSheafTensorPower (N + 1) L ≅
      (Scheme.Modules.pullback ψ).obj (projTwistingSheaf 𝒜 ((N + 1 : ℕ) : ℤ))
  | 0 => Ringed.moduleSheafTensorPowerSuccIso _ 0 ≪≫
      tensorIsoOfIso (Ringed.moduleSheafTensorPowerZeroIso _) (Iso.refl _) ≪≫
      Ringed.moduleSheafUnitTensor _ ≪≫ α
  | N + 1 => Ringed.moduleSheafTensorPowerSuccIso _ (N + 1) ≪≫
      tensorIsoOfIso (tensorPowerPullbackTwistIso α N) α ≪≫
      (pullbackTensorIso ψ
        ((Scheme.Modules.isInvertible_iff_ringed _).1 (ProjTwistingSheaf.isInvertible hgen _))
        ((Scheme.Modules.isInvertible_iff_ringed _).1
          (ProjTwistingSheaf.isInvertible hgen 1))).symm ≪≫
      (Scheme.Modules.pullback ψ).mapIso
        (Ringed.moduleSheafTensorIsoTensor _ _ ≪≫ twistMulIso 𝒜 hgen _ 1 ≪≫
          eqToIso (congrArg (projTwistingSheaf 𝒜) (by push_cast; ring)))

end TensorPower

section ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] (r : ℕ)

local notation "𝒮" => MvPolynomial.homogeneousSubmodule (Fin (r + 1)) R

private theorem adjoin_one_eq_top :
    Algebra.adjoin (𝒮 0) (𝒮 1 : Set (MvPolynomial (Fin (r + 1)) R)) = ⊤ :=
  top_le_iff.1 ((adjoin_projectiveSpaceGenerators R r (Equiv.refl _)).ge.trans
    (Algebra.adjoin_mono (Set.range_subset_iff.2 fun l => projectiveSpaceGenerators_mem R r _ l)))

private theorem projectiveSpaceOverSpecIso_hom_fst :
    (projectiveSpaceOverSpecIso R r (Equiv.refl _)).hom ≫
        pullback.fst (projectiveSpaceOverIntegersMap r) (schemeToSpecZ (Spec (.of R))) =
      Proj.map (projectiveSpaceComparisonHom R r (Equiv.refl _))
        (GeneratedProj.irrelevant_le_map_evalGradedHom 𝒮 (projectiveSpaceGenerators_mem R r _)
          (adjoin_projectiveSpaceGenerators R r _)) := by
  rw [projectiveSpaceOverSpecIso_hom, projToProjectiveSpaceOverSpec_fst]
  rfl

/-- **`𝒪(n)` on `ℙʳ_{Spec A}` is `𝒪_{Proj A[x]}(n)`.** Under the comparison isomorphism
`Proj A[x₀, …, xᵣ] ≅ ℙʳ_{Spec A}`, the twisting sheaf `𝒪(n)` of `ℙʳ_{Spec A}` (the pullback of
`𝒪(n)` on `ℙʳ_ℤ`) pulls back to the twisting sheaf `𝒪(n)` of `Proj A[x₀, …, xᵣ]`. -/
def pullbackProjectiveSpaceOverSpecTwistIso (n : ℤ) :
    (Scheme.Modules.pullback (projectiveSpaceOverSpecIso R r (Equiv.refl _)).hom).obj
        (projectiveSpaceTwistingSheaf r (Spec (.of R)) n) ≅ projTwistingSheaf 𝒮 n :=
  (Scheme.Modules.pullbackComp _ _).app _ ≪≫
    (Scheme.Modules.pullbackCongr (projectiveSpaceOverSpecIso_hom_fst R r)).app _ ≪≫
    pullbackProjMapTwistIso _ _ (adjoin_intGrading_one_eq_top r) n

variable {R r}

/-- **Tensor powers of `L = φ^* 𝒪(1)` for a morphism `φ : Z ⟶ ℙʳ_Y`.** The tensor power
`L^{N+1}` is `φ^* 𝒪(N + 1)` (Hartshorne II.5.12(b), pulled back from `ℙʳ_ℤ`). -/
noncomputable def tensorPowerPullbackProjectiveSpaceTwistIso {Y Z : Scheme.{u}}
    (φ : Z ⟶ projectiveSpaceOverScheme r Y) (N : ℕ) :
    moduleSheafTensorPower (N + 1)
        ((Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf r Y 1)) ≅
      (Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf r Y ((N + 1 : ℕ) : ℤ)) :=
  tensorPowerPullbackTwistIso (adjoin_intGrading_one_eq_top r) _
      ((Scheme.Modules.pullbackComp _ _).app _) N ≪≫
    ((Scheme.Modules.pullbackComp _ _).app _).symm


/-- For a saturated homogeneous ideal `I` of `A[x₀, …, xᵣ]` whose `Proj (A[x]/I)` is integral,
`A[x]/I` is a domain (the argument of Hartshorne II, Exercise 5.14(a), over any base ring). -/
private theorem isDomain_of_isIntegral_proj (I : HomogeneousIdeal 𝒮)
    [IsIntegral (Proj (gradedQuotient 𝒮 I))]
    (hsat : ∀ s : MvPolynomial (Fin (r + 1)) R,
      (∀ i, ∃ n : ℕ, MvPolynomial.X i ^ n * s ∈ I.toIdeal) → s ∈ I.toIdeal) :
    IsDomain (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal) := by
  obtain ⟨x⟩ := (inferInstance : Nonempty (Proj (gradedQuotient 𝒮 I)))
  let c : Fin (r + 1) → MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal :=
    fun i => Ideal.Quotient.mk I.toIdeal (MvPolynomial.X i)
  have hc : ∀ i, c i ∈ gradedQuotient 𝒮 I 1 := fun i =>
    mk_mem_gradedQuotient (MvPolynomial.isHomogeneous_X R i)
  have hsat' : ∀ {d : ℕ} {a : MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal},
      a ∈ gradedQuotient 𝒮 I d → (∀ i, ∃ m : ℕ, c i ^ m * a = 0) → a = 0 := by
    intro d a ha h
    obtain ⟨P, -, rfl⟩ := mem_gradedQuotient_iff.1 ha
    rw [Ideal.Quotient.eq_zero_iff_mem]
    refine hsat P fun i => ?_
    obtain ⟨m, hm⟩ := h i
    refine ⟨m, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_pow]
    exact hm
  have hbot : (⊥ : Ideal (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal)).IsPrime := by
    have hhom : (⊥ : Ideal (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal)).IsHomogeneous
        (gradedQuotient 𝒮 I) := by
      have := (⊥ : HomogeneousIdeal (gradedQuotient 𝒮 I)).isHomogeneous
      rwa [HomogeneousIdeal.toIdeal_bot] at this
    refine hhom.isPrime_of_homogeneous_mem_or_mem ?_ ?_
    · intro htop
      apply x.isPrime.ne_top
      rw [eq_top_iff]
      intro y _
      have : (1 : MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal) = 0 := by
        rw [← Ideal.mem_bot, htop]
        trivial
      rw [← one_mul y, this, zero_mul]
      exact zero_mem _
    · rintro a b ⟨p, ha⟩ ⟨q, hb⟩ hab
      rw [Ideal.mem_bot] at hab ⊢
      rw [Ideal.mem_bot]
      rcases ProjectiveSectionRing.forall_pow_mul_eq_zero_or c hc ha hb hab with h | h
      · exact Or.inl (hsat' ha h)
      · exact Or.inr (hsat' hb h)
  exact IsDomain.of_bot_isPrime _

/-- **A closed subscheme of `ℙʳ_A` is `Proj` of its homogeneous coordinate ring, with its
`𝒪(1)`** (Hartshorne II, Corollary 5.16 and Exercise 5.10, as used in the proof of Theorem 7.17,
Step 2). Let `i : Z ⟶ ℙʳ_{Spec A}` be a closed immersion. There is a homogeneous ideal `I` of
`S = A[x₀, …, xᵣ]` such that

* `I` is saturated: `I^sat = I`;
* `Z ≅ Proj (S/I)` over `ℙʳ_{Spec A}` (through `Proj (S/I) ⟶ Proj S ≅ ℙʳ_{Spec A}`);
* under this isomorphism `i^* 𝒪(n)` is `𝒪_{Proj (S/I)}(n)`, for every `n`;
* if `Z` is integral, the homogeneous coordinate ring `S/I` is a domain.

The ideal is `I = Γ_*(ℐ_Z) ∩ S`. -/
theorem exists_iso_proj_homogeneousCoordinateRing {Z : Scheme.{u}}
    (i : Z ⟶ projectiveSpaceOverScheme r (Spec (.of R))) [IsClosedImmersion i] :
    ∃ I : HomogeneousIdeal 𝒮,
      ProjectiveClosedSubscheme.saturation I.toIdeal = I.toIdeal ∧
      ∃ e : Z ≅ Proj (gradedQuotient 𝒮 I),
        e.hom ≫ projQuotientι 𝒮 I ≫ (projectiveSpaceOverSpecIso R r (Equiv.refl _)).hom = i ∧
        (∀ n : ℤ, Nonempty ((Scheme.Modules.pullback i).obj
            (projectiveSpaceTwistingSheaf r (Spec (.of R)) n) ≅
          (Scheme.Modules.pullback e.hom).obj (projTwistingSheaf (gradedQuotient 𝒮 I) n))) ∧
        (IsIntegral Z → IsDomain (MvPolynomial (Fin (r + 1)) R ⧸ I.toIdeal)) := by
  let P := projectiveSpaceOverSpecIso R r (Equiv.refl _)
  let g : Z ⟶ Proj 𝒮 := i ≫ P.inv
  let I := ProjectiveClosedSubscheme.gammaStarIdeal R r
    (quasicoherentIdealSubsheafEquiv.symm g.ker)
  obtain ⟨e, he⟩ := ProjectiveClosedSubscheme.exists_iso_projQuotientι_gammaStarIdeal g
  have hsat : ProjectiveClosedSubscheme.saturation I.toIdeal = I.toIdeal :=
    ProjectiveClosedSubscheme.saturation_gammaStarIdeal _
  have hfac : e.hom ≫ projQuotientι 𝒮 I ≫ P.hom = i := by
    rw [← Category.assoc, he]
    simp [g]
  refine ⟨I, hsat, e, hfac, fun n => ⟨?_⟩, fun hZ => ?_⟩
  · exact (Scheme.Modules.pullbackCongr hfac.symm).app _ ≪≫
      ((Scheme.Modules.pullbackComp e.hom (projQuotientι 𝒮 I ≫ P.hom)).app _).symm ≪≫
      (Scheme.Modules.pullback e.hom).mapIso
        (((Scheme.Modules.pullbackComp (projQuotientι 𝒮 I) P.hom).app _).symm ≪≫
          (Scheme.Modules.pullback (projQuotientι 𝒮 I)).mapIso
            (pullbackProjectiveSpaceOverSpecTwistIso R r n) ≪≫
          (Scheme.Modules.pullbackCongr (projQuotientι_eq_map I)).app _ ≪≫
          pullbackProjMapTwistIso _ _ (adjoin_one_eq_top R r) n)
  · have : Nonempty (Proj (gradedQuotient 𝒮 I)) := ⟨e.hom (Nonempty.some inferInstance)⟩
    have : IsIntegral (Proj (gradedQuotient 𝒮 I)) := isIntegral_of_isOpenImmersion e.inv
    refine isDomain_of_isIntegral_proj I fun s hs => ?_
    rw [← hsat]
    exact hs

end ProjectiveSpace

/-! ### Restricting a projective embedding over an affine open of the base -/

section AffineBase

variable {X Z : Scheme.{u}} {r : ℕ} (i : Z ⟶ projectiveSpaceOverScheme r X) {U : X.Opens}
  (hU : IsAffineOpen U)

private theorem projectiveSpaceOverSchemeMap_eq_fst {Y Y' : Scheme.{u}} (g : Y' ⟶ Y) :
    projectiveSpaceOverSchemeMap r g = (projectiveSpaceOverSchemeBaseChangeIso r g).inv ≫
      pullback.fst (projectiveSpaceOverSchemeProjection r Y) g := by
  rw [Iso.eq_inv_comp]
  apply pullback.hom_ext
  · rw [Category.assoc, projectiveSpaceOverSchemeMap_fst,
      projectiveSpaceOverSchemeBaseChangeIso_hom_fst]
  · rw [Category.assoc, projectiveSpaceOverSchemeMap_projection,
      projectiveSpaceOverSchemeBaseChangeIso_hom_projection_assoc, pullback.condition]

private instance isOpenImmersion_projectiveSpaceOverSchemeMap {Y Y' : Scheme.{u}} (g : Y' ⟶ Y)
    [IsOpenImmersion g] : IsOpenImmersion (projectiveSpaceOverSchemeMap r g) := by
  rw [projectiveSpaceOverSchemeMap_eq_fst]
  infer_instance

private theorem opensRange_projectiveSpaceOverSchemeMap {Y Y' : Scheme.{u}} (g : Y' ⟶ Y)
    [IsOpenImmersion g] : (projectiveSpaceOverSchemeMap r g).opensRange =
      projectiveSpaceOverSchemeProjection r Y ⁻¹ᵁ g.opensRange := by
  have key : ∀ (φ ψ : projectiveSpaceOverScheme r Y' ⟶ projectiveSpaceOverScheme r Y)
      [IsOpenImmersion φ] [IsOpenImmersion ψ], φ = ψ → φ.opensRange = ψ.opensRange := by
    rintro φ ψ _ _ rfl
    rfl
  rw [key _ _ (projectiveSpaceOverSchemeMap_eq_fst g), Scheme.Hom.opensRange_comp_of_isIso,
    Scheme.Hom.opensRange_pullbackFst]

/-- **The projective embedding over an affine open `U ⊆ X`.** For `i : Z ⟶ ℙʳ_X` with
`f = π ∘ i`, the morphism `f⁻¹(U) ⟶ ℙʳ_{Spec Γ(X, U)}` induced by `i` and `f|_U`. -/
def chartEmbedding :
    ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).toScheme ⟶
      projectiveSpaceOverScheme r (Spec Γ(X, U)) :=
  pullback.lift (((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).ι ≫ i ≫
      pullback.fst (projectiveSpaceOverIntegersMap r) (schemeToSpecZ X))
    ((i ≫ projectiveSpaceOverSchemeProjection r X) ∣_ U ≫ hU.isoSpec.hom)
    (specULiftZIsTerminal.hom_ext _ _)

@[reassoc]
theorem chartEmbedding_fst : chartEmbedding i hU ≫
      pullback.fst (projectiveSpaceOverIntegersMap r) (schemeToSpecZ (Spec Γ(X, U))) =
    ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).ι ≫ i ≫
      pullback.fst (projectiveSpaceOverIntegersMap r) (schemeToSpecZ X) :=
  pullback.lift_fst _ _ _

/-- The embedding over `U` lies over `U ≅ Spec Γ(X, U)`. -/
@[reassoc]
theorem chartEmbedding_projection : chartEmbedding i hU ≫
      projectiveSpaceOverSchemeProjection r (Spec Γ(X, U)) =
    (i ≫ projectiveSpaceOverSchemeProjection r X) ∣_ U ≫ hU.isoSpec.hom :=
  pullback.lift_snd _ _ _

/-- The embedding over `U` is the restriction of `i`: `f⁻¹(U) ⟶ ℙʳ_{Spec Γ(X, U)} ⟶ ℙʳ_X` is
`f⁻¹(U) ⊆ Z ⟶ ℙʳ_X`. -/
theorem chartEmbedding_comp :
    chartEmbedding i hU ≫ projectiveSpaceOverSchemeMap r hU.fromSpec =
      ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).ι ≫ i := by
  apply pullback.hom_ext
  · rw [Category.assoc, projectiveSpaceOverSchemeMap_fst, chartEmbedding_fst, Category.assoc]
  · rw [Category.assoc, projectiveSpaceOverSchemeMap_projection, chartEmbedding_projection_assoc,
      IsAffineOpen.isoSpec_hom_fromSpec, morphismRestrict_ι, Category.assoc]

theorem isPullback_chartEmbedding :
    IsPullback (chartEmbedding i hU) ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).ι
      (projectiveSpaceOverSchemeMap r hU.fromSpec) i := by
  refine IsOpenImmersion.isPullback _ _ _ _ (chartEmbedding_comp i hU).symm ?_
  rw [opensRange_projectiveSpaceOverSchemeMap, IsAffineOpen.opensRange_fromSpec,
    Scheme.Opens.opensRange_ι, Scheme.Hom.comp_preimage]

/-- The embedding over `U` of a closed immersion is a closed immersion. -/
instance isClosedImmersion_chartEmbedding [IsClosedImmersion i] :
    IsClosedImmersion (chartEmbedding i hU) :=
  MorphismProperty.of_isPullback (P := @IsClosedImmersion) (isPullback_chartEmbedding i hU).flip
    inferInstance

/-- Under the embedding over `U`, `𝒪(n)` pulls back to the restriction of `i^* 𝒪(n)` to
`f⁻¹(U)`. -/
def pullbackChartEmbeddingTwistIso (n : ℤ) :
    (Scheme.Modules.pullback (chartEmbedding i hU)).obj
        (projectiveSpaceTwistingSheaf r (Spec Γ(X, U)) n) ≅
      (Scheme.Modules.pullback ((i ≫ projectiveSpaceOverSchemeProjection r X) ⁻¹ᵁ U).ι).obj
        ((Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf r X n)) :=
  (Scheme.Modules.pullbackComp _ _).app _ ≪≫
    (Scheme.Modules.pullbackCongr (chartEmbedding_fst i hU)).app _ ≪≫
    ((Scheme.Modules.pullbackComp _ _).app _).symm ≪≫
    (Scheme.Modules.pullback _).mapIso ((Scheme.Modules.pullbackComp _ _).app _).symm

end AffineBase

end SectionAlgebraModel

end Hartshorne
