import Hartshorne.Scheme.ProjectiveSchemeAsProj
import Hartshorne.Scheme.ProjTwistPullback
import Hartshorne.Scheme.ProjectiveIdealSaturation
import Hartshorne.Scheme.ProjectiveSectionRingIntegralClosure
import Hartshorne.Scheme.RelativeVeryAmple
