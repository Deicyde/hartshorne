import Hartshorne.Scheme.InvertibleSectionClearingDenominators
import Hartshorne.Scheme.GloballyGenerated
import Hartshorne.RingedSpace.PicardGroup
import Mathlib.RingTheory.LocalRing.Module

/-!
# Germs of local frames

Toward Hartshorne, *Algebraic Geometry*, II, Exercise 8.2 (p. 187).

Let `E` be an `𝒪_X`-module on a scheme `X`.

* `Hartshorne.NowhereVanishingSection.linearIndependent_germ_of_isLocalFrame`,
  `Hartshorne.NowhereVanishingSection.span_germ_of_isLocalFrame`: the germs at `x` of a local
  frame of `E` over `U ∋ x` form a basis of the stalk `E_x`.
* `Hartshorne.NowhereVanishingSection.exists_isLocalFrame_basicOpen_of_span_germ`: if
  `(f_j)` is a local frame of `E` over `U` and sections `(e_i)` over `U`, as many as the `f_j`,
  have germs generating `E_x`, then the `e_i` form a local frame over a basic open
  neighbourhood `D(d) ⊆ U` of `x`: writing `e_i = ∑_j C_{i j} f_j`, the matrix `C` is
  invertible at `x`, and one takes `d = det C`.
* `Hartshorne.NowhereVanishingSection.exists_embedding_isLocalFrame`: if `E` is locally free of
  rank `r` and generated by a finite family of global sections `v_l`, then near every point some
  `r` of the `v_l` form a local frame. Over the local ring `𝒪_{X,x}` a generating family of the
  free module `E_x` contains a basis (Nakayama's lemma), which has `r` elements.
-/

noncomputable section

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry IsLocalRing

namespace Hartshorne

namespace NowhereVanishingSection

universe u

variable {X : Scheme.{u}} {E : X.Modules}

/-- Germs of module sections are compatible with the action of functions. -/
theorem germ_smul_frame (F : X.Modules) {U : X.Opens} (x : X) (hx : x ∈ U) (r : Γ(X, U))
    (m : Γ(F, U)) :
    F.presheaf.germ U x hx (r • m) = X.presheaf.germ U x hx r • F.presheaf.germ U x hx m :=
  let M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat) := F.val
  PresheafOfModules.germ_smul M x U hx r m

/-- Two successive restrictions of module sections compose to a restriction. -/
theorem res_res_frame (F : X.Modules) {U V W : X.Opens} (h₁ : V ≤ U) (h₂ : W ≤ V)
    (h₃ : W ≤ U) (m : Γ(F, U)) :
    F.presheaf.map (homOfLE h₂).op (F.presheaf.map (homOfLE h₁).op m) =
      F.presheaf.map (homOfLE h₃).op m := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

variable {ι : Type*} [Fintype ι] {U : X.Opens} {e : ι → Γ(E, U)}

/-- The map `(a_i) ↦ ∑ a_i e_i|_V`, with its value in the scheme-theoretic notation. -/
theorem localFrameMap_apply_scheme (e : ι → Γ(E, U)) {V : X.Opens} (h : V ≤ U)
    (a : ι → Γ(X, V)) :
    Ringed.localFrameMap (R := X.sheaf) E e h a =
      ∑ i, a i • E.presheaf.map (homOfLE h).op (e i) :=
  Ringed.localFrameMap_apply (R := X.sheaf) E e h a

/-- The germs at a point of `U` of a local frame over `U` are linearly independent. -/
theorem linearIndependent_germ_of_isLocalFrame (he : Ringed.IsLocalFrame (R := X.sheaf) E U e)
    {x : X} (hx : x ∈ U) :
    LinearIndependent (X.presheaf.stalk x) (fun i => E.presheaf.germ U x hx (e i)) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg
  choose V hVU hxV c hc using fun i => X.presheaf.exists_le_germ_eq (g i) hx
  let W : X.Opens := U ⊓ Finset.univ.inf V
  have hxW : x ∈ W := by
    refine ⟨hx, ?_⟩
    change x ∈ ((Finset.univ.inf V : X.Opens) : Set X)
    rw [Opens.coe_finset_inf, Finset.inf_eq_iInf]
    simp only [Set.iInf_eq_iInter, Set.mem_iInter, Function.comp_apply]
    exact fun i _ => hxV i
  have hWV : ∀ i, W ≤ V i := fun i => inf_le_right.trans (Finset.inf_le (Finset.mem_univ i))
  have hWU : W ≤ U := inf_le_left
  let c' : ι → Γ(X, W) := fun i => X.presheaf.map (homOfLE (hWV i)).op (c i)
  have hc' : ∀ i, X.presheaf.germ W x hxW (c' i) = g i := fun i => by
    rw [← hc i]
    exact X.presheaf.germ_res_apply _ x hxW _
  have hgerm : E.presheaf.germ W x hxW (Ringed.localFrameMap (R := X.sheaf) E e hWU c') =
      E.presheaf.germ W x hxW 0 := by
    rw [map_zero, localFrameMap_apply_scheme, map_sum, ← hg]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [germ_smul_frame, hc']
    congr 1
    exact E.presheaf.germ_res_apply _ x hxW _
  obtain ⟨W', hxW', i₁, i₂, heq⟩ := E.presheaf.germ_eq x hxW hxW _ _ hgerm
  have hi₁ : i₁ = homOfLE i₁.le := Subsingleton.elim _ _
  rw [map_zero, hi₁] at heq
  erw [Ringed.localFrameMap_restrict (R := X.sheaf) E e hWU i₁.le c'] at heq
  have h0 := (he W' (i₁.le.trans hWU)).1 (heq.trans (map_zero _).symm)
  intro i
  rw [← hc' i, ← X.presheaf.germ_res_apply (homOfLE i₁.le) x hxW']
  have := congrFun h0 i
  change X.presheaf.map (homOfLE i₁.le).op (c' i) = 0 at this
  rw [this, map_zero]

/-- The germs at a point of `U` of a local frame over `U` generate the stalk. -/
theorem span_germ_of_isLocalFrame (he : Ringed.IsLocalFrame (R := X.sheaf) E U e)
    {x : X} (hx : x ∈ U) :
    Submodule.span (X.presheaf.stalk x) (Set.range fun i => E.presheaf.germ U x hx (e i)) =
      ⊤ := by
  refine Submodule.eq_top_iff'.mpr fun z => ?_
  obtain ⟨W, hWU, hxW, t, rfl⟩ := E.presheaf.exists_le_germ_eq z hx
  obtain ⟨a, ha⟩ : ∃ a : ι → Γ(X, W), Ringed.localFrameMap (R := X.sheaf) E e hWU a = t :=
    (he W hWU).2 t
  rw [← ha, localFrameMap_apply_scheme e hWU a, map_sum]
  refine Submodule.sum_mem _ fun i _ => ?_
  rw [germ_smul_frame]
  refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, ?_⟩)
  exact (E.presheaf.germ_res_apply _ x hxW _).symm

/-- The germs at a point of `U` of a local frame over `U` form a basis of the stalk. -/
theorem exists_basis_germ_of_isLocalFrame (he : Ringed.IsLocalFrame (R := X.sheaf) E U e)
    {x : X} (hx : x ∈ U) :
    ∃ b : Module.Basis ι (X.presheaf.stalk x) (E.presheaf.stalk x),
      ∀ i, b i = E.presheaf.germ U x hx (e i) :=
  ⟨Module.Basis.mk (linearIndependent_germ_of_isLocalFrame he hx)
      (span_germ_of_isLocalFrame he hx).ge,
    fun i => Module.Basis.mk_apply _ _ i⟩

/-- The coordinates in a basis of an element of `I • M` lie in `I`. -/
theorem repr_mem_of_mem_smul_top {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {κ : Type*} (b : Module.Basis κ R M) (I : Ideal R) {z : M}
    (hz : z ∈ I • (⊤ : Submodule R M)) (j : κ) : b.repr z j ∈ I := by
  refine Submodule.smul_induction_on hz (fun a ha n _ => ?_) (fun y z hy hz => ?_)
  · rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
    exact I.mul_mem_right _ ha
  · rw [map_add, Finsupp.add_apply]
    exact I.add_mem hy hz

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

/-- **Frames from generating germs.** Let `(f_j)` be a local frame of `E` over `U'` and let
`(e_i)` be sections of `E` over `U'`, indexed by the same type, whose germs at `x ∈ U'` generate
the stalk `E_x`. Then there is `d ∈ Γ(U', 𝒪_X)` with `x ∈ D(d)` such that the restrictions of
the `e_i` form a local frame over `D(d)`. -/
theorem exists_isLocalFrame_basicOpen_of_span_germ {U' : X.Opens} {f : κ → Γ(E, U')}
    (hf : Ringed.IsLocalFrame (R := X.sheaf) E U' f) (e : κ → Γ(E, U')) {x : X} (hx : x ∈ U')
    (hspan : Submodule.span (X.presheaf.stalk x)
      (Set.range fun i => E.presheaf.germ U' x hx (e i)) = ⊤) :
    ∃ d : Γ(X, U'), x ∈ X.basicOpen d ∧ Ringed.IsLocalFrame (R := X.sheaf) E (X.basicOpen d)
      (fun i => E.presheaf.map (homOfLE (X.basicOpen_le d)).op (e i)) := by
  -- the coordinates of the `e_i` in the frame `f`
  let C : Matrix κ κ Γ(X, U') := Matrix.of fun i j => hf.coord le_rfl (e i) j
  have hC : ∀ {V : X.Opens} (hV : V ≤ U') i, E.presheaf.map (homOfLE hV).op (e i) =
      Ringed.localFrameMap (R := X.sheaf) E f hV
        (fun j => X.presheaf.map (homOfLE hV).op (C i j)) := by
    intro V hV i
    have h1 := hf.localFrameMap_coord le_rfl (e i)
    have h2 := Ringed.localFrameMap_restrict (R := X.sheaf) E f le_rfl hV (hf.coord le_rfl (e i))
    rw [h1] at h2
    exact h2
  let φ : Γ(X, U') →+* X.presheaf.stalk x := (X.presheaf.germ U' x hx).hom
  let d := C.det
  have hgerm_e : ∀ i, E.presheaf.germ U' x hx (e i) =
      ∑ j, φ (C i j) • E.presheaf.germ U' x hx (f j) := by
    intro i
    have h := congrArg (E.presheaf.germ U' x hx) (hC le_rfl i)
    rw [← E.presheaf.germ_res_apply (homOfLE (le_refl U')) x hx (e i)]
    refine h.trans ?_
    rw [localFrameMap_apply_scheme, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [germ_smul_frame]
    congr 1
    · exact X.presheaf.germ_res_apply _ x hx _
    · exact E.presheaf.germ_res_apply _ x hx _
  -- `C` is invertible at `x`
  have hli := linearIndependent_germ_of_isLocalFrame hf hx
  have hB : ∀ j, ∃ b : κ → X.presheaf.stalk x,
      ∑ i, b i • E.presheaf.germ U' x hx (e i) = E.presheaf.germ U' x hx (f j) := by
    intro j
    have : E.presheaf.germ U' x hx (f j) ∈ Submodule.span (X.presheaf.stalk x)
        (Set.range fun i => E.presheaf.germ U' x hx (e i)) := by
      rw [hspan]; exact Submodule.mem_top
    exact (Submodule.mem_span_range_iff_exists_fun _).mp this
  choose B hB using hB
  have hBC : Matrix.of B * φ.mapMatrix C = 1 := by
    ext j j'
    have h := hB j
    simp only [hgerm_e, Finset.smul_sum, smul_smul] at h
    rw [Finset.sum_comm, ← Finset.sum_congr rfl fun j' _ => Finset.sum_smul] at h
    have h' : ∑ j', (∑ i, B j i * φ (C i j') -
        (Pi.single j (1 : X.presheaf.stalk x) : κ → X.presheaf.stalk x) j') •
          E.presheaf.germ U' x hx (f j') = 0 := by
      simp [sub_smul, Finset.sum_sub_distrib, h, Pi.single_apply, ite_smul]
    have := Fintype.linearIndependent_iff.mp hli _ h' j'
    rw [sub_eq_zero] at this
    rw [Matrix.mul_apply, Matrix.one_apply]
    simpa [Pi.single_apply, eq_comm] using this
  have hdet : IsUnit (φ d) := by
    rw [RingHom.map_det]
    exact Matrix.isUnit_det_of_left_inverse hBC
  refine ⟨d, (X.mem_basicOpen d x hx).mpr hdet, fun V hV => ?_⟩
  have hVU' : V ≤ U' := hV.trans (X.basicOpen_le d)
  let ρ : Γ(X, U') →+* Γ(X, V) := (X.presheaf.map (homOfLE hVU').op).hom
  let N : Matrix κ κ Γ(X, V) := ρ.mapMatrix C
  have hN : IsUnit N := by
    rw [Matrix.isUnit_iff_isUnit_det]
    change IsUnit (ρ.mapMatrix C).det
    rw [← RingHom.map_det]
    refine X.toRingedSpace.isUnit_of_isUnit_germ V _ fun y hy => ?_
    have hy' := hV hy
    rw [X.mem_basicOpen d y (hVU' hy)] at hy'
    convert hy' using 1
    exact X.presheaf.germ_res_apply _ y hy _
  have key : ⇑(Ringed.localFrameMap (R := X.sheaf) E
      (fun i => E.presheaf.map (homOfLE (X.basicOpen_le d)).op (e i)) hV) =
      ⇑(Ringed.localFrameMap (R := X.sheaf) E f hVU') ∘ fun a => Matrix.vecMul a N := by
    refine funext fun (a : κ → Γ(X, V)) => ?_
    have h3 : ∀ i, E.presheaf.map (homOfLE hV).op
        (E.presheaf.map (homOfLE (X.basicOpen_le d)).op (e i)) =
          ∑ j, N i j • E.presheaf.map (homOfLE hVU').op (f j) := by
      intro i
      erw [res_res_frame E (X.basicOpen_le d) hV hVU' (e i)]
      exact (hC hVU' i).trans (localFrameMap_apply_scheme f hVU' _)
    have h4 : ∑ i, a i • E.presheaf.map (homOfLE hV).op
        (E.presheaf.map (homOfLE (X.basicOpen_le d)).op (e i)) =
          ∑ j, Matrix.vecMul a N j • E.presheaf.map (homOfLE hVU').op (f j) := by
      simp_rw [h3, Finset.smul_sum, smul_smul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← Finset.sum_smul]
      congr 1
    exact (localFrameMap_apply_scheme _ hV a).trans
      (h4.trans (localFrameMap_apply_scheme f hVU' _).symm)
  rw [key]
  exact (hf V hVU').comp ⟨Matrix.vecMul_injective_of_isUnit hN,
    Matrix.vecMul_surjective_iff_isUnit.mpr hN⟩

/-- **Frames among generating sections.** Let `E` be locally free of rank `r`, generated by
finitely many global sections `v_l`. Then every point has an open neighbourhood over which the
restrictions of some `r` of the `v_l` form a local frame. -/
theorem exists_embedding_isLocalFrame {r : ℕ} (hE : E.IsLocallyFreeOfRank r) {ι : Type u}
    [Fintype ι] (v : ι → Γ(E, ⊤)) (hv : E.IsGeneratedBySections v) (x : X) :
    ∃ (σ : Fin r ↪ ι) (U : X.Opens), x ∈ U ∧ Ringed.IsLocalFrame (R := X.sheaf) E U
      (fun j => E.presheaf.map (homOfLE le_top).op (v (σ j))) := by
  classical
  obtain ⟨U', f₀, hxU', hf₀⟩ := Ringed.exists_isLocalFrame_of_isLocallyFreeOfRank
    ((Scheme.Modules.isLocallyFreeOfRank_iff_ringed E r).mp hE) x
  have hf := hf₀.reindex Equiv.ulift.symm
  obtain ⟨bf, -⟩ := exists_basis_germ_of_isLocalFrame hf hxU'
  have : Module.Free (X.presheaf.stalk x) (E.presheaf.stalk x) := Module.Free.of_basis bf
  have : Module.Finite (X.presheaf.stalk x) (E.presheaf.stalk x) := Module.Finite.of_basis bf
  have : Module.FinitePresentation (X.presheaf.stalk x) (E.presheaf.stalk x) :=
    Module.finitePresentation_of_projective _ _
  obtain ⟨κ', a, b, hb⟩ := Module.exists_basis_of_span_of_flat
    (fun l => E.presheaf.germ ⊤ x trivial (v l)) (hv x)
  have : Finite κ' := Module.Finite.finite_basis b
  have : Fintype κ' := Fintype.ofFinite κ'
  have hcard : Fintype.card κ' = r := by
    rw [← Module.finrank_eq_card_basis b, Module.finrank_eq_card_basis bf, Fintype.card_fin]
  have ha : Function.Injective a := fun i j hij => b.injective (by rw [hb, hb, hij])
  let eκ : κ' ≃ Fin r := Fintype.equivFinOfCardEq hcard
  let σ : Fin r ↪ ι := eκ.symm.toEmbedding.trans ⟨a, ha⟩
  have hσ : ∀ j, σ j = a (eκ.symm j) := fun _ => rfl
  let e : Fin r → Γ(E, U') := fun j => E.presheaf.map (homOfLE le_top).op (v (σ j))
  have hspan : Submodule.span (X.presheaf.stalk x)
      (Set.range fun j => E.presheaf.germ U' x hxU' (e j)) = ⊤ := by
    have hrange : (Set.range fun j => E.presheaf.germ U' x hxU' (e j)) = Set.range b := by
      ext z
      constructor
      · rintro ⟨j, rfl⟩
        refine ⟨eκ.symm j, ?_⟩
        rw [hb, ← hσ]
        exact (E.presheaf.germ_res_apply _ x hxU' _).symm
      · rintro ⟨i, rfl⟩
        refine ⟨eκ i, ?_⟩
        change E.presheaf.germ U' x hxU' (E.presheaf.map _ (v (a (eκ.symm (eκ i))))) = _
        rw [Equiv.symm_apply_apply, hb]
        exact E.presheaf.germ_res_apply _ x hxU' _
    rw [hrange, b.span_eq]
  obtain ⟨d, hxd, hd⟩ := exists_isLocalFrame_basicOpen_of_span_germ hf e hxU' hspan
  refine ⟨σ, X.basicOpen d, hxd, ?_⟩
  have hfam : (fun j => E.presheaf.map (homOfLE (X.basicOpen_le d)).op (e j)) =
      (fun j => E.presheaf.map (homOfLE le_top).op (v (σ j))) := by
    funext j
    exact res_res_frame E le_top (X.basicOpen_le d) le_top (v (σ j))
  rw [← hfam]
  exact hd

end NowhereVanishingSection

end Hartshorne
