/-!
# Embedding a relative Proj after an ample twist

Auxiliary results for Hartshorne, *Algebraic Geometry*, II, Proposition 7.10(b) (pp. 161–162).

Let `X` be a Noetherian scheme, `S` a quasi-coherent graded `𝒪_X`-algebra satisfying Hartshorne's
hypotheses (†), `π : P = Proj_X S ⟶ X` the projection and `L` an ample invertible sheaf on `X`.

* `RelativeProjData.exists_isImmersion_twist`: for some `m` there is an immersion
  `φ : P ⟶ ℙᴺ_X` over `X` with `φ^* 𝒪(1) ≅ 𝒪(1) ⊗ π^* L^m`. The argument works on `P`:
  - finitely many affine `X_w`, `w ∈ Γ(X, L^a)`, cover `X`, and each `S(X_w)₁` is generated by
    finitely many `g_{w j}`;
  - the sections `g_{w j}` of `𝒪(1)` over `π⁻¹(X_w)`, multiplied by a power of `π^* w`, extend
    to global sections of `𝒪(1) ⊗ (π^* L^a)^{⊗ n}` (the argument of Lemma II.5.14);
  - these sections generate, so they define `φ` (Theorem 7.1). Over the affine
    `p⁻¹(X_w) ∩ D₊(x_{w j})` of `ℙᴺ_X` (`p : ℙᴺ_X ⟶ X` the projection) the preimage is
    `D₊(g_{w j}) ⊆ Proj S(X_w)` and the ring map onto `S(X_w)_(g_{w j})` is surjective, since that
    ring is generated by `Γ(X_w, 𝒪_X)` and the fractions `g_{w b}/g_{w j}`.
* `isVeryAmpleRelative_moduleSheafTensor_of_hom`: if `L` is very ample relative to `Y` and `M`
  is pulled back from `𝒪(1)` along some `Y`-morphism to `ℙˢ_Y`, then `L ⊗ M` is very ample.
* `IsAmple.exists_hom_projectiveSpace_tensorPower`: high powers of an ample sheaf define
  `X`-morphisms `X ⟶ ℙˢ_X`.

The proof of `exists_isImmersion_twist` is one long chart computation; it needs a heartbeat
budget of `1000000`.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry

namespace Hartshorne

/-! ### Twisting a very ample sheaf by a sheaf with a morphism to projective space -/

/-- Very ampleness relative to `Y` is invariant under isomorphism of sheaves. -/
theorem IsVeryAmpleRelative.of_iso {X Y : Scheme.{u}} {p : X ⟶ Y} {L L' : X.Modules}
    (hL : IsVeryAmpleRelative p L) (α : L ≅ L') : IsVeryAmpleRelative p L' := by
  obtain ⟨hinv, r, Z, o, c, ho, hc, hp, ⟨e⟩⟩ := hL
  refine ⟨(Scheme.Modules.isInvertible_iff_ringed _).mpr
    (Ringed.IsInvertible.of_iso ((Scheme.Modules.isInvertible_iff_ringed _).mp hinv) α),
    r, Z, o, c, ho, hc, hp, ⟨e ≪≫ α⟩⟩

/-- Let `L` be very ample relative to `Y` on a `Y`-scheme `X` quasi-compact over `Y`, and let `M`
be an invertible sheaf with a `Y`-morphism `j : X ⟶ ℙˢ_Y` such that `j^* 𝒪(1) ≅ M`. Then `L ⊗ M`
is very ample relative to `Y`: if `i` is the immersion for `L`, then the Segre embedding composed
with `(i, j)` is an immersion pulling `𝒪(1)` back to `L ⊗ M`. This supplements Hartshorne II,
Exercise 5.12(a), where `j` is also an immersion. -/
theorem isVeryAmpleRelative_moduleSheafTensor_of_hom {X Y : Scheme.{u}} {p : X ⟶ Y}
    [QuasiCompact p] {L M : X.Modules} (hL : IsVeryAmpleRelative p L) (hM : M.IsInvertible)
    {s : ℕ} (j : X ⟶ projectiveSpaceOverScheme s Y)
    (hj : j ≫ projectiveSpaceOverSchemeProjection s Y = p)
    (eM : (Scheme.Modules.pullback j).obj (projectiveSpaceTwistingSheaf s Y 1) ≅ M) :
    IsVeryAmpleRelative p (moduleSheafTensor L M) := by
  obtain ⟨hLinv, r, Z, o, c, ho, hc, hp, ⟨eL⟩⟩ := hL
  have hij : (o ≫ c) ≫ projectiveSpaceOverSchemeProjection r Y =
      j ≫ projectiveSpaceOverSchemeProjection s Y := hp.trans hj.symm
  let φ : X ⟶ relativeSegreSource r s Y := pullback.lift (o ≫ c) j hij
  let ι : X ⟶ projectiveSpaceOverScheme (r * s + r + s) Y := φ ≫ relativeSegre r s Y
  have hιp : ι ≫ projectiveSpaceOverSchemeProjection (r * s + r + s) Y = p := by
    simp only [ι, φ, Category.assoc, relativeSegre_projection, relativeSegreSourceProjection,
      pullback.lift_fst_assoc, hp]
  have : IsImmersion (φ ≫ pullback.fst _ _) := by
    rw [pullback.lift_fst]
    infer_instance
  have : IsImmersion φ := IsImmersion.of_comp φ (pullback.fst _ _)
  have : QuasiCompact (ι ≫ projectiveSpaceOverSchemeProjection (r * s + r + s) Y) := by
    rw [hιp]
    infer_instance
  have := projectiveSpaceOverSchemeProjection_isProper (r * s + r + s) Y
  have : QuasiCompact ι := QuasiCompact.of_comp ι (projectiveSpaceOverSchemeProjection _ Y)
  obtain ⟨e⟩ := nonempty_relativeSegre_pullback_iso r s Y
  have i1 := ringed_isInvertible_projectiveSpaceTwistingSheaf r Y
  have i2 := ringed_isInvertible_projectiveSpaceTwistingSheaf s Y
  have hinv : Scheme.Modules.IsInvertible (X := X) (moduleSheafTensor L M) :=
    (Scheme.Modules.isInvertible_iff_ringed _).mpr (Ringed.isInvertible_moduleSheafTensor
      ((Scheme.Modules.isInvertible_iff_ringed _).mp hLinv)
      ((Scheme.Modules.isInvertible_iff_ringed _).mp hM))
  refine ⟨hinv, r * s + r + s, ι.image, ι.toImage, ι.imageι, inferInstance, inferInstance,
    by rw [Scheme.Hom.toImage_imageι, hιp], ⟨?_⟩⟩
  exact (Scheme.Modules.pullbackCongr (Scheme.Hom.toImage_imageι ι)).app _ ≪≫
    ((Scheme.Modules.pullbackComp φ (relativeSegre r s Y)).app _).symm ≪≫
    (Scheme.Modules.pullback φ).mapIso e ≪≫
    pullbackTensorIso φ (isInvertible_pullback _ i1) (isInvertible_pullback _ i2) ≪≫
    Ringed.moduleSheafTensorIsoOfIso
      ((Scheme.Modules.pullbackComp _ _).app _ ≪≫
        (Scheme.Modules.pullbackCongr (pullback.lift_fst _ _ _)).app _ ≪≫ eL)
      ((Scheme.Modules.pullbackComp _ _).app _ ≪≫
        (Scheme.Modules.pullbackCongr (pullback.lift_snd _ _ _)).app _ ≪≫ eM)

/-- On a Noetherian scheme `X` with an ample invertible sheaf `L`, for every sufficiently large
`r` the power `L^r` is generated by finitely many global sections, so it defines an `X`-morphism
`g : X ⟶ ℙˢ_X` with `g^* 𝒪(1) ≅ L^r` (Hartshorne II, Theorem 7.1). -/
theorem IsAmple.exists_hom_projectiveSpace_tensorPower {X : Scheme.{u}} [IsNoetherian X]
    {L : X.Modules} (hL : L.IsAmple) :
    ∃ N₀ : ℕ, ∀ r ≥ N₀, ∃ (s : ℕ) (g : X ⟶ projectiveSpaceOverScheme s X),
      g ≫ projectiveSpaceOverSchemeProjection s X = 𝟙 X ∧
      Nonempty ((Scheme.Modules.pullback g).obj (projectiveSpaceTwistingSheaf s X 1) ≅
        moduleSheafTensorPower r L) := by
  classical
  obtain ⟨N₀, hN⟩ := hL.exists_isAffineOpen_nonvanishingLocus
  refine ⟨N₀, fun r hr => ?_⟩
  have hLr : Scheme.Modules.IsInvertible (moduleSheafTensorPower r L) :=
    isInvertible_moduleSheafTensorPower hL.1 r
  choose w hw using hN r hr
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover
    (fun x => nonvanishingLocus (moduleSheafTensorPower r L) (w x))
    (fun x => isOpen_nonvanishingLocus hLr (w x)) (fun x _ => Set.mem_iUnion.mpr ⟨x, (hw x).1⟩)
  let J := Option T
  let N' := Fintype.card T
  let ε : J ≃ Fin (N' + 1) := Fintype.equivFinOfCardEq (by simp [J, N'])
  let t : Fin (N' + 1) → Γ(moduleSheafTensorPower r L, ⊤) := fun k =>
    Option.elim (ε.symm k) 0 (fun y => w y.1)
  have hgen : Scheme.Modules.IsGeneratedBySections (moduleSheafTensorPower r L : X.Modules)
      (fun k : ULift.{u} (Fin (N' + 1)) => t k.down) :=
    isGeneratedBySections_of_forall_isTrivializingSection _ fun x => by
      obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (hT (Set.mem_univ x))
      refine ⟨⟨ε (some ⟨y, hy⟩)⟩, nonvanishingLocusOpens hLr (w y), hxy, ?_⟩
      have ht : t (ε (some ⟨y, hy⟩)) = w y := by simp [t]
      simp only [ht]
      exact isTrivializingSection_nonvanishingLocusOpens hLr (w y)
  obtain ⟨g, ⟨hg, e, -⟩, -⟩ := existsUnique_morphism_of_isGeneratedBySections (𝟙 X) hLr t hgen
  exact ⟨N', g, hg, ⟨e⟩⟩

/-! ### The embedding of `Proj_X S` -/

namespace RelativeProjData

variable {X : Scheme.{u}} [IsNoetherian X] (D : RelativeProjData X)

-- One long chart computation (closed immersion over each chart of ℙᴺ_X); needs 1000000.
set_option maxHeartbeats 1000000 in
/-- For some `m`, there is an immersion
`φ : Proj_X S ⟶ ℙᴺ_X` over `X` with `φ^* 𝒪(1) ≅ 𝒪(1) ⊗ π^* L^m`. -/
theorem exists_isImmersion_twist {L : X.Modules} (hL : L.IsAmple) :
    ∃ (m N : ℕ) (φ : D.relativeProj ⟶ projectiveSpaceOverScheme N X),
      IsImmersion φ ∧ φ ≫ projectiveSpaceOverSchemeProjection N X = D.projection ∧
      Nonempty ((Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf N X 1) ≅
        moduleSheafTensor (D.algebra.relTwistingSheaf 1)
          ((Scheme.Modules.pullback D.projection).obj (moduleSheafTensorPower m L))) := by
  classical
  let S := D.algebra
  let P := S.relProj
  let π : P ⟶ X := S.relProjToBase
  have hS : S.GeneratedInDegreeOne := D.generated
  let O : P.Modules := S.relTwistingSheaf 1
  have hO : O.IsInvertible := S.isInvertible_relTwistingSheaf 1 hS
  have : O.IsQuasicoherent := Ringed.IsFiniteLocallyFree.isQuasicoherent
    (Ringed.IsInvertible.isFiniteLocallyFree ((Scheme.Modules.isInvertible_iff_ringed O).1 hO))
  -- Finitely many affine `X_{w}`, `w ∈ Γ(X, L^a)`, cover `X`.
  obtain ⟨a, ha⟩ := hL.exists_isAffineOpen_nonvanishingLocus
  have hLa : Scheme.Modules.IsInvertible (moduleSheafTensorPower a L) :=
    isInvertible_moduleSheafTensorPower hL.1 a
  choose w hw using ha a le_rfl
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover
    (fun x => nonvanishingLocus (moduleSheafTensorPower a L) (w x))
    (fun x => isOpen_nonvanishingLocus hLa (w x)) (fun x _ => Set.mem_iUnion.mpr ⟨x, (hw x).1⟩)
  let U : T → X.AffineZariskiSite := fun y => ⟨nonvanishingLocusOpens hLa (w y), (hw y).2⟩
  -- Generators of `S(U)₁` over `Γ(U, 𝒪_X)`.
  choose k g hg hspan using fun y => D.degreeOne_coherent (U y)
  have hadj : ∀ y, Algebra.adjoin (S.grading (U y) 0) (Set.range (g y)) = ⊤ := fun y => by
    rw [eq_top_iff, ← S.adjoin_eq_top_of_generatedInDegreeOne hS (U y), Algebra.adjoin_le_iff]
    intro x hx
    obtain ⟨cf, rfl⟩ := hspan y x hx
    refine Subalgebra.sum_mem _ fun i _ => Subalgebra.mul_mem _ ?_ (Algebra.subset_adjoin ⟨i, rfl⟩)
    exact Subalgebra.algebraMap_mem _ (S.toZero (U y) (cf i))
  let J := Σ y : T, Fin (k y)
  let V : J → P.Opens := fun p => S.projι (U p.1) ''ᵁ Proj.basicOpen _ (g p.1 p.2)
  have hVle : ∀ p : J, V p ≤ S.projι (U p.1) ''ᵁ ⊤ := fun p => Scheme.Hom.image_mono _ le_top
  have hVsup : ⨆ p, V p = ⊤ := by
    refine top_le_iff.mp fun x _ => ?_
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (hT (Set.mem_univ (π x)))
    have hx : x ∈ π ⁻¹ᵁ (U ⟨y, hy⟩).1 := hxy
    rw [S.relProjToBase_preimage] at hx
    obtain ⟨z, rfl⟩ := hx
    have hz : z ∈ ⨆ j, Proj.basicOpen (S.grading (U ⟨y, hy⟩)) (g ⟨y, hy⟩ j) := by
      rw [Proj.iSup_basicOpen_eq_top' _ _ (fun j => ⟨1, hg _ j⟩) (hadj _)]
      trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨y, hy⟩, j⟩, z, hj, rfl⟩
  have hVaff : ∀ p, IsAffineOpen (V p) := fun p =>
    (Proj.isAffineOpen_basicOpen _ _ (hg p.1 p.2) Nat.one_pos).image_of_isOpenImmersion _
  have : IsProper π := D.isProper_projection
  have : IsNoetherian P := by
    have : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian π
    have : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace π
    exact {}
  have hqc : ∀ p q, IsCompact ((V p ⊓ V q : P.Opens) : Set P) := fun _ _ =>
    NoetherianSpace.isCompact _
  -- The pullback `L' = π^* L^a` and its sections `π^* w`.
  let L' : P.Modules := (Scheme.Modules.pullback π).obj (moduleSheafTensorPower a L)
  have hL' : L'.IsInvertible := Scheme.Modules.IsInvertible.pullback π hLa
  let f : T → Γ(L', ⊤) := fun y => pullbackGlobalSection π (w y)
  have hnl : ∀ y, nonvanishingLocusOpens hL' (f y) = S.projι (U y) ''ᵁ ⊤ := fun y => by
    rw [Scheme.Hom.image_top_eq_opensRange, ← S.relProjToBase_preimage]
    ext x
    exact mem_nonvanishingLocus_pullbackGlobalSection_iff π hLa (w y) x
  let ef : ∀ p : J, Γ(L', V p) := fun p => L'.presheaf.map (homOfLE le_top).op (f p.1)
  have hef : ∀ p, IsTrivializingSection L' (V p) (ef p) := fun p => by
    have h := (isTrivializingSection_nonvanishingLocusOpens hL' (f p.1)).restrictLE
      ((hVle p).trans (hnl p.1).ge)
    rwa [Scheme.Modules.map_map_homOfLE] at h
  -- The degree-one sections `g_{y j}` of `𝒪(1)` over `π⁻¹(U_y)`.
  let α := S.relTwistingSheafRestrictIso 1
  let piece : ∀ y : T, Fin (k y) → Γ(O, S.projι (U y) ''ᵁ ⊤) := fun y j =>
    QuasiCoherentGradedAlgebra.pieceDegreeOneSection O α (U y) (hg y j)
  let σ : ∀ p : J, Γ(O, nonvanishingLocusOpens hL' (f p.1)) := fun p =>
    O.presheaf.map (homOfLE (hnl p.1).le).op (piece p.1 p.2)
  -- Serre's extension: `f^n σ` extends to a global section of `O ⊗ L'^{⊗ n}`.
  have hext := fun p : J => exists_forall_sectionPowSMul_extension hL' (f p.1) O V hVsup hVaff
    ef hef hqc (σ p)
  choose K hK using hext
  let n := Finset.univ.sup K
  choose u hu using fun p => hK p n (Finset.le_sup (Finset.mem_univ p))
  let M : P.Modules := tensorPowerTwist O L' n
  have hM : M.IsInvertible := (Scheme.Modules.isInvertible_iff_ringed _).mpr
    (Ringed.isInvertible_moduleSheafTensor ((Scheme.Modules.isInvertible_iff_ringed _).mp hO)
      (Ringed.isInvertible_moduleSheafTensorPower
        ((Scheme.Modules.isInvertible_iff_ringed _).mp hL') n))
  have hu' : ∀ (y : T) (j j' : Fin (k y)),
      M.presheaf.map (homOfLE (le_top : V ⟨y, j'⟩ ≤ ⊤)).op (u ⟨y, j⟩) =
        sectionPowSMul O L' n (ef ⟨y, j'⟩)
          (O.presheaf.map (homOfLE (hVle ⟨y, j'⟩)).op (piece y j)) := fun y j j' => by
    have hle : V ⟨y, j'⟩ ≤ nonvanishingLocusOpens hL' (f y) := (hVle ⟨y, j'⟩).trans (hnl y).ge
    calc M.presheaf.map (homOfLE le_top).op (u ⟨y, j⟩)
        = M.presheaf.map (homOfLE hle).op (M.presheaf.map (homOfLE le_top).op (u ⟨y, j⟩)) := by
          rw [Scheme.Modules.map_map_homOfLE]
      _ = _ := by
          erw [hu ⟨y, j⟩, sectionPowSMul_map]
          simp only [ef, σ, Scheme.Modules.map_map_homOfLE]
  have htriv : ∀ p, IsTrivializingSection M (V p) (M.presheaf.map (homOfLE le_top).op (u p)) :=
    fun p => by
      rw [hu' p.1 p.2 p.2]
      exact (QuasiCoherentGradedAlgebra.isTrivializingSection_pieceDegreeOneSection α
        (hg p.1 p.2)).sectionPowSMul
        (hef p) n
  -- The coefficient `g_{y j} / g_{y j'}` on `V (y, j')`.
  let c : ∀ (y : T) (j j' : Fin (k y)), Γ(P, V ⟨y, j'⟩) := fun y j j' =>
    ((S.projι (U y)).appIso _).inv (Proj.awayToSection _ (g y j')
      (HomogeneousLocalization.Away.mk _ (hg y j') 1 (g y j)
        (by rw [smul_eq_mul, mul_one]; exact hg y j)))
  have hc : ∀ (y : T) (j j' : Fin (k y)),
      M.presheaf.map (homOfLE (le_top : V ⟨y, j'⟩ ≤ ⊤)).op (u ⟨y, j⟩) =
        c y j j' • M.presheaf.map (homOfLE (le_top : V ⟨y, j'⟩ ≤ ⊤)).op (u ⟨y, j'⟩) :=
    fun y j j' => by
      rw [hu' y j j', hu' y j' j']
      erw [QuasiCoherentGradedAlgebra.pieceDegreeOneSection_eq_smul (M := O) α (hg y j') (hg y j)]
      exact sectionPowSMul_smul_section _ _ _
  -- Theorem 7.1: the sections `u` define `φ : Proj_X S ⟶ ℙᴺ_X`.
  let N' := Fintype.card J
  let ε : Option J ≃ Fin (N' + 1) := Fintype.equivFinOfCardEq (by simp [N'])
  let t : Fin (N' + 1) → Γ(M, ⊤) := fun i => Option.elim (ε.symm i) 0 u
  have ht : ∀ p, t (ε (some p)) = u p := fun p => by simp [t]
  have hgen : M.IsGeneratedBySections (fun i : ULift.{u} (Fin (N' + 1)) => t i.down) :=
    isGeneratedBySections_of_forall_isTrivializingSection _ fun x => by
      obtain ⟨p, hp⟩ := TopologicalSpace.Opens.mem_iSup.mp (hVsup.ge (Set.mem_univ x))
      refine ⟨⟨ε (some p)⟩, V p, hp, ?_⟩
      change IsTrivializingSection M (V p) (M.presheaf.map _ (t (ε (some p))))
      rw [ht]
      exact htriv p
  obtain ⟨φ, ⟨hφ, e, he⟩, -⟩ := existsUnique_morphism_of_isGeneratedBySections π hM t hgen
  -- `φ` is a closed immersion over `W p = π⁻¹(U) ∩ D₊(x_p)`.
  let W : J → (projectiveSpaceOverScheme N' X).Opens := fun p =>
    projectiveSpaceOverSchemeProjection N' X ⁻¹ᵁ (U p.1).1 ⊓ projectiveSpaceChart N' X (ε (some p))
  have hWaff : ∀ p, IsAffineOpen (W p) := fun p =>
    isAffineOpen_preimage_inf_projectiveSpaceChart N' (U p.1).2 _
  have hpreW : ∀ p, φ ⁻¹ᵁ W p = V p := by
    rintro ⟨y, j⟩
    have h1 : φ ⁻¹ᵁ (projectiveSpaceOverSchemeProjection N' X ⁻¹ᵁ (U y).1) =
        S.projι (U y) ''ᵁ ⊤ := by
      rw [← Scheme.Hom.comp_preimage, hφ, Scheme.Hom.image_top_eq_opensRange,
        ← S.relProjToBase_preimage]
    have h2 := preimage_projectiveSpaceChart_eq_nonvanishingLocusOpens hM t φ e he
      (ε (some ⟨y, j⟩))
    simp only [W, Scheme.Hom.preimage_inf, h1, h2]
    apply le_antisymm
    · rintro x ⟨hx1, hx2⟩
      obtain ⟨z, -, rfl⟩ := hx1
      have hz : z ∈ ⨆ j', Proj.basicOpen (S.grading (U y)) (g y j') := by
        rw [Proj.iSup_basicOpen_eq_top' _ _ (fun j => ⟨1, hg _ j⟩) (hadj _)]
        trivial
      obtain ⟨j', hj'⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
      have hxV : S.projι (U y) z ∈ V ⟨y, j'⟩ := ⟨z, hj', rfl⟩
      have hx2' : S.projι (U y) z ∈ nonvanishingLocus M (u ⟨y, j⟩) := by
        rw [← ht]
        exact hx2
      rw [(htriv ⟨y, j'⟩).mem_nonvanishingLocus_iff (hc y j j') hxV] at hx2'
      rw [← Scheme.image_basicOpen, Proj.basicOpen_awayToSection_eq] at hx2'
      exact Scheme.Hom.image_mono _ inf_le_right hx2'
    · refine le_inf (hVle ⟨y, j⟩) fun x hx => ?_
      change x ∈ nonvanishingLocus M (t (ε (some ⟨y, j⟩)))
      rw [ht]
      exact mem_nonvanishingLocus_of_isTrivializingSection (htriv ⟨y, j⟩) hx
  have hsurj : ∀ p, Function.Surjective (φ.appLE (W p) (V p) (hpreW p).ge) := by
    rintro ⟨y, j⟩ z
    let 𝒜 := S.grading (U y)
    let ψ : HomogeneousLocalization.Away 𝒜 (g y j) →+* Γ(P, V ⟨y, j⟩) :=
      ((S.projι (U y)).appIso _).inv.hom.comp (Proj.awayToSection 𝒜 (g y j)).hom
    have hψ : Function.Surjective ψ :=
      (ConcreteCategory.bijective_of_isIso ((S.projι (U y)).appIso _).inv).2.comp
        (ConcreteCategory.bijective_of_isIso
          (Proj.basicOpenIsoAway 𝒜 (g y j) (hg y j) Nat.one_pos).hom).2
    obtain ⟨w', rfl⟩ := hψ z
    have hVnl : V ⟨y, j⟩ ≤ nonvanishingLocusOpens hM (t (ε (some ⟨y, j⟩))) := fun x hx => by
      change x ∈ nonvanishingLocus M (t (ε (some ⟨y, j⟩)))
      rw [ht]
      exact mem_nonvanishingLocus_of_isTrivializingSection (htriv ⟨y, j⟩) hx
    refine (Subring.closure_le.mpr ?_ : _ ≤ (φ.appLE _ _ (hpreW ⟨y, j⟩).ge).hom.range.comap ψ)
      (away_mem_closure_of_adjoin_eq_top (hg y j) (g y) (hg y) (hadj y) w')
    rintro _ (⟨a0, rfl⟩ | ⟨b, rfl⟩)
    · obtain ⟨r, rfl⟩ := (D.degreeZero (U y)).2 a0
      refine ⟨(projectiveSpaceOverSchemeProjection N' X).appLE (U y).1 (W ⟨y, j⟩) inf_le_left r,
        ?_⟩
      have hle0 : Proj.basicOpen 𝒜 (g y j) ≤ (S.projι (U y) ≫ S.relProjToBase) ⁻¹ᵁ (U y).1 := by
        rw [S.projι_relProjToBase, Scheme.Hom.comp_preimage, Scheme.Opens.ι_preimage_self,
          Scheme.Hom.preimage_top]
        exact le_top
      have key := appIso_inv_comp_appLE (S.projι (U y)) π (U y).1 (Proj.basicOpen 𝒜 (g y j)) hle0
        ((hVle ⟨y, j⟩).trans (by
          rw [Scheme.Hom.image_top_eq_opensRange, ← S.relProjToBase_preimage])) r
      change _ = ((S.projι (U y)).appIso _).inv (Proj.awayToSection 𝒜 (g y j)
        (HomogeneousLocalization.fromZeroRingHom 𝒜 _ (S.toZero (U y) r)))
      rw [← QuasiCoherentGradedAlgebra.projι_relProjToBase_appLE S (U y) (hg y j) hle0 r, key,
        ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
      exact congrArg (fun h => (ConcreteCategory.hom h) r)
        (QuasiCoherentGradedAlgebra.appLE_eq_of_eq hφ (U y).1 (V ⟨y, j⟩) _)
    · refine ⟨(projectiveSpaceOverScheme N' X).presheaf.map
        (homOfLE (inf_le_right : W ⟨y, j⟩ ≤ _)).op
        (projectiveSpaceChartRatio N' X (ε (some ⟨y, j⟩)) (ε (some ⟨y, b⟩))), ?_⟩
      apply eq_of_smul_eq hM t (ε (some ⟨y, j⟩)) hVnl
      have hc' := hc y b j
      rw [← ht, ← ht] at hc'
      change _ = c y b j • _
      rw [← hc']
      have h3 := appLE_projectiveSpaceChartRatio_smul hM t φ e he (ε (some ⟨y, j⟩))
        (ε (some ⟨y, b⟩))
      have h4 := congrArg (M.presheaf.map (homOfLE hVnl).op) h3
      rw [Scheme.Modules.map_smul, Scheme.Modules.map_map_homOfLE,
        Scheme.Modules.map_map_homOfLE] at h4
      refine Eq.trans ?_ h4
      congr 1
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE,
        Scheme.Hom.appLE_map]
  have hcl : ∀ p, IsClosedImmersion (φ ∣_ W p) := fun p => by
    rw [isClosedImmersion_morphismRestrict_iff φ (hWaff p) (hpreW p)]
    exact ⟨hVaff p, hsurj p⟩
  have himm : IsImmersion φ := isImmersion_of_forall_isClosedImmersion_morphismRestrict φ W
    (by simp_rw [hpreW]; exact hVsup) hcl
  refine ⟨a * n, N', φ, himm, hφ, ⟨e ≪≫ Ringed.moduleSheafTensorIsoOfIso (Iso.refl O)
    ((nonempty_pullback_tensorPower_iso π hLa n).some.symm ≪≫
      (Scheme.Modules.pullback π).mapIso (Ringed.moduleSheafTensorPowerMulIso L a n))⟩⟩

