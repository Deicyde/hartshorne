/-!
# Eliminating the base locus of finitely many sections by blowing up

Hartshorne, *Algebraic Geometry*, II, Example 7.17.3 (pp. 168–169).

Let `X` be a Noetherian scheme, `L` an invertible sheaf on `X` and `s₀, …, sₙ ∈ Γ(X, L)`. On the
open set `U` where the `sᵢ` generate `L` they define a morphism `φ : U ⟶ ℙⁿ` (Theorem 7.1). Let `I`
be the base ideal of the `sᵢ`: where `ψ : L|_V ≅ 𝒪_V`, `I|_V` is generated by the `ψ(sᵢ)`. Let
`π : X̃ ⟶ X` be the blowing-up of `I`. Then the `π^* sᵢ` generate an invertible subsheaf
`L' = π^* L · I𝒪_{X̃}` of `π^* L` and define a morphism `φ̃ : X̃ ⟶ ℙⁿ` whose restriction to
`π⁻¹(U) ≅ U` is `φ`. Projective spaces are taken over an arbitrary base `Y` to which `X` maps.

## Main definitions and results

* `baseIdeal hL s`: the base ideal `I`, the sum of the ideals of the zero schemes of the `sᵢ`;
  `baseLocusIdeal_range_ideal_eq_span`: where `e` trivializes `L` and `sᵢ = gᵢ e`, it is
  generated by the `gᵢ`. `isCoherent_baseIdeal`: it is coherent on a Noetherian scheme.
* `baseBlowup hL s`, `baseBlowupProjection hL s`: the blowing-up `π : X̃ ⟶ X` of `I`.
* `baseBlowupSheaf hL s`, `baseBlowupSheafι hL s`: the subsheaf `L' = π^* L · I𝒪_{X̃} ⊆ π^* L`;
  `baseBlowupSection hL s i`: the section `π^* sᵢ` of `L'`.
* `isInvertible_baseBlowupSheaf`, `isGeneratedBySections_baseBlowupSection`: `L'` is invertible and
  generated by the `π^* sᵢ`.
* `existsUnique_baseBlowupMorphism`, `baseBlowupMorphism`: the morphism `φ̃ : X̃ ⟶ ℙⁿ_Y` they
  define (Theorem 7.1).
* `linearSystemDomain_eq_centerCompl`, `isIso_baseBlowupProjection_restrict`: `U` is the
  complement of the center, and `π⁻¹(U) ⟶ U` is an isomorphism (Proposition 7.13(b)).
* `baseBlowupMorphism_restrict`: `φ̃` restricted to `π⁻¹(U)` is `φ ∘ π|_{π⁻¹(U)}`.
* `isBasePointFree_baseBlowup`: for a linear system spanned by the `sᵢ`, the pulled-back linear
  system of `L'` is base-point-free.

## Proof

Near a point of `X̃`, take an affine open `V ⊆ X` on which `e` trivializes `L`, with `sᵢ = gᵢ e`,
so that `I(V) = (g₀, …, gₙ)`. On an affine open `W₀ ⊆ π⁻¹(V)` the exceptional ideal `I𝒪_{X̃}` is
generated by the `hᵢ = π^♯ gᵢ`, and by Proposition 7.13(a) also by one element `a` which is a unit
of the total quotient ring. Writing `hᵢ = dᵢ a` and `a = ∑ cᵢ hᵢ` gives `∑ cᵢ dᵢ = 1`, so the
basic opens `D(dᵢ)` cover `W₀`; on `D(dᵢ)` the element `hᵢ` generates `I𝒪_{X̃}`, and
`π^* sᵢ = hᵢ π^* e` trivializes `L'`. Hence `L'` is invertible and generated by the `π^* sᵢ`, and
Theorem 7.1 gives `φ̃`. Over `π⁻¹(U)` the base ideal is the unit ideal, so `L' = π^* L` there, and
both `φ̃|_{π⁻¹(U)}` and `φ ∘ π|_{π⁻¹(U)}` are defined by the sections `π^* sᵢ` of `π^* L`; they
agree by the uniqueness in Theorem 7.1. The statement for linear systems is Lemma 7.8.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry
open Hartshorne.ArtinReesKernelSheaf

namespace Hartshorne

/-! ### A local generator of `I · E` -/

section IdealSmul

variable {X : Scheme.{u}} (E : X.Modules) (I : X.IdealSheafData)

/-- If `h` generates `I` on all affine opens of `W`, is a unit of the total quotient ring and `ε`
trivializes `E` on `W`, then `h ε` is a section of the subsheaf `I · E ⊆ E`. -/
private theorem smul_mem_powSmul {W : X.Opens} {ε : Γ(E, W)} (h : Γ(X, W))
    (hI : ∀ V : X.affineOpens, (hV : (V : X.Opens) ≤ W) →
      I.ideal V = Ideal.span {X.presheaf.map (homOfLE hV).op h}) :
    h • ε ∈ sub (powSmul I 1 ⊤) W := by
  intro x hx
  obtain ⟨V, hVW, hxV⟩ := exists_affine_le hx
  refine ⟨V, hVW, hxV, ?_⟩
  change res E hVW (h • ε) ∈ I.ideal V ^ 1 • sub (⊤ : E.val.Submodule) (V : X.Opens)
  rw [res_apply, Scheme.Modules.map_smul, pow_one, hI V hVW]
  exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self _) trivial

/-- **A local generator of `I · E`.** If `ε` trivializes `E` on `W`, `h ∈ Γ(W, 𝒪_X)` is a unit of
the total quotient ring, and `I` is generated by `h` on every affine open of `W`, then `h ε`
trivializes the subsheaf `I · E ⊆ E` on `W`. -/
private theorem isTrivializingSection_powSmul {W : X.Opens} {ε : Γ(E, W)}
    (hε : IsTrivializingSection E W ε) (h : Γ(X, W)) (hh : IsUnit (X.toK W h))
    (hI : ∀ V : X.affineOpens, (hV : (V : X.Opens) ≤ W) →
      I.ideal V = Ideal.span {X.presheaf.map (homOfLE hV).op h}) :
    IsTrivializingSection (toModules (powSmul I 1 ⊤) (isLocal_powSmul I 1 ⊤)) W
      ⟨h • ε, smul_mem_powSmul E I h hI⟩ := by
  intro W₁ hW₁
  set h₁ := X.presheaf.map (homOfLE hW₁).op h
  set ε₁ := E.presheaf.map (homOfLE hW₁).op ε
  have hh₁ : IsUnit (X.toK W₁ h₁) := by
    rw [← Scheme.toK_naturality]
    exact hh.map _
  have hval : ∀ b : Γ(X, W₁), (b • (toModules (powSmul I 1 ⊤) (isLocal_powSmul I 1 ⊤)).presheaf.map
      (homOfLE hW₁).op ⟨h • ε, smul_mem_powSmul E I h hI⟩).1 = (b * h₁) • ε₁ := by
    intro b
    change b • E.presheaf.map (homOfLE hW₁).op (h • ε) = _
    rw [Scheme.Modules.map_smul, smul_smul]
  constructor
  · intro b b' hbb'
    have := congrArg Subtype.val hbb'
    rw [hval, hval] at this
    have h2 := (hε W₁ hW₁).1 this
    apply X.toK_injective W₁
    have h3 := congrArg (X.toK W₁) h2
    rw [map_mul, map_mul] at h3
    exact hh₁.mul_left_injective h3
  · rintro ⟨t, ht⟩
    obtain ⟨c, rfl⟩ := (hε W₁ hW₁).2 t
    set u := hh₁.unit
    obtain ⟨b, hb⟩ := Scheme.exists_toK_eq_of_locally (X.toK W₁ c * (u⁻¹ : _ˣ).1) fun x hx => by
      obtain ⟨V, hVW, hxV, hV⟩ := ht x hx
      refine ⟨V, hVW, hxV, ?_⟩
      change res E hVW (c • ε₁) ∈ I.ideal V ^ 1 • sub (⊤ : E.val.Submodule) (V : X.Opens) at hV
      have hεV := hε.restrict hW₁ V hVW
      set εV : Γ(E, V) := E.presheaf.map (homOfLE hVW).op ε₁
      rw [res_apply, Scheme.Modules.map_smul, pow_one] at hV
      have key : ∀ z ∈ I.ideal V • sub (⊤ : E.val.Submodule) (V : X.Opens),
          ∃ y ∈ I.ideal V, y • εV = z := by
        intro z hz
        refine Submodule.smul_induction_on hz (fun a ha n _ => ?_)
          (fun z₁ z₂ ⟨y₁, hy₁, e₁⟩ ⟨y₂, hy₂, e₂⟩ => ⟨y₁ + y₂, add_mem hy₁ hy₂, ?_⟩)
        · obtain ⟨r, rfl⟩ := hεV.2 n
          exact ⟨a * r, Ideal.mul_mem_right _ _ ha, (smul_smul a r εV).symm⟩
        · rw [add_smul, e₁, e₂]
      obtain ⟨y, hy, hyc⟩ := key _ hV
      rw [hI V (hVW.trans hW₁)] at hy
      have hyc' := hεV.1 hyc
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hy
      refine ⟨r, ?_⟩
      have hhV : X.presheaf.map (homOfLE (hVW.trans hW₁)).op h =
          X.presheaf.map (homOfLE hVW).op h₁ := by
        rw [← CommRingCat.comp_apply, ← Functor.map_comp]; rfl
      rw [hhV] at hr
      have hu : X.totalQuotientSheaf.obj.map (homOfLE hVW).op (u⁻¹ : _ˣ).1 *
          X.toK V (X.presheaf.map (homOfLE hVW).op h₁) = 1 := by
        rw [← Scheme.toK_naturality]
        exact (map_mul _ _ _).symm.trans ((congrArg _ hh₁.unit.inv_mul).trans (map_one _))
      have key : X.toK V r = X.totalQuotientSheaf.obj.map (homOfLE hVW).op (X.toK W₁ c) *
          X.totalQuotientSheaf.obj.map (homOfLE hVW).op (u⁻¹ : _ˣ).1 := by
        rw [Scheme.toK_naturality, ← hyc', ← hr, map_mul, mul_assoc,
          mul_comm (X.toK V (X.presheaf.map (homOfLE hVW).op h₁)), hu, mul_one]
      exact key.trans (map_mul _ _ _).symm
    refine ⟨b, Subtype.ext ?_⟩
    rw [hval]
    congr 1
    apply X.toK_injective W₁
    rw [map_mul, hb, mul_assoc, show (u⁻¹ : _ˣ).1 * X.toK W₁ h₁ = 1 from hh₁.unit.inv_mul, mul_one]

end IdealSmul

/-! ### The base ideal and its blowing-up -/

section Blowup

variable {X : Scheme.{u}} {L : X.Modules} (hL : L.IsInvertible) {n : ℕ}
  (s : Fin (n + 1) → Γ(L, ⊤))

/-- **The base ideal** `I` of the sections `s₀, …, sₙ` of an invertible sheaf `L`, as a
quasi-coherent sheaf of ideals: the sum of the ideals of the zero schemes of the `sᵢ`. Where `ψ`
trivializes `L`, it is generated by the `ψ(sᵢ)` (`baseLocusIdeal_range_ideal_eq_span`). -/
def baseIdeal : QuasicoherentIdealSubsheaf X :=
  quasicoherentIdealSubsheafEquiv.symm (baseLocusIdeal hL (Set.range s))

theorem quasicoherentIdealSubsheafEquiv_baseIdeal :
    quasicoherentIdealSubsheafEquiv (baseIdeal hL s) = baseLocusIdeal hL (Set.range s) :=
  Equiv.apply_symm_apply _ _

/-- **Local generators of the base ideal.** On an affine open `V` on which `e` trivializes `L`,
if `sᵢ|_V = gᵢ e`, the base ideal is generated by `g₀, …, gₙ`. -/
theorem baseLocusIdeal_range_ideal_eq_span {V : X.affineOpens} {e : Γ(L, V)}
    (he : IsTrivializingSection L V e) {g : Fin (n + 1) → Γ(X, V)}
    (hg : ∀ i, L.presheaf.map (homOfLE le_top).op (s i) = g i • e) :
    (baseLocusIdeal hL (Set.range s)).ideal V = Ideal.span (Set.range g) := by
  rw [baseLocusIdeal, iSup_range, Scheme.IdealSheafData.ideal_iSup, iSup_apply, Ideal.span,
    Submodule.span_range_eq_iSup]
  exact iSup_congr fun i => invertibleZeroIdeal_ideal_eq_span hL he (hg i)

variable [IsNoetherian X]

/-- On a Noetherian scheme the base ideal is coherent. -/
theorem isCoherent_baseIdeal : IsCoherent (baseIdeal hL s).toModules :=
  SerreAffineness.isCoherent_toModules _

/-- The blowing-up `X̃` of `X` along the base ideal of `s₀, …, sₙ`. -/
abbrev baseBlowup : Scheme.{u} := (baseIdeal hL s).blowup (isCoherent_baseIdeal hL s)

/-- The projection `π : X̃ ⟶ X` of the blowing-up along the base ideal. -/
abbrev baseBlowupProjection : baseBlowup hL s ⟶ X :=
  (baseIdeal hL s).blowupProjection (isCoherent_baseIdeal hL s)

/-- The exceptional ideal of the blowing-up along the base ideal is `π⁻¹I · 𝒪_{X̃}`. -/
theorem exceptionalIdeal_baseIdeal :
    (baseIdeal hL s).exceptionalIdeal (isCoherent_baseIdeal hL s) =
      inverseImageIdeal (baseBlowupProjection hL s) (baseLocusIdeal hL (Set.range s)) := by
  rw [QuasicoherentIdealSubsheaf.exceptionalIdeal, quasicoherentIdealSubsheafEquiv_baseIdeal]

/-- **The sheaf `L'`**: the subsheaf `π^* L · I𝒪_{X̃} ⊆ π^* L`, where `I𝒪_{X̃}` is the exceptional
ideal; its sections are those lying locally in `Γ(V, I𝒪_{X̃}) · Γ(V, π^* L)` on affine opens. -/
def baseBlowupSheaf : (baseBlowup hL s).Modules :=
  toModules (E := (Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L)
    (powSmul ((baseIdeal hL s).exceptionalIdeal (isCoherent_baseIdeal hL s)) 1 ⊤)
    (isLocal_powSmul _ _ _)

/-- The inclusion `L' ⟶ π^* L`. -/
def baseBlowupSheafι :
    baseBlowupSheaf hL s ⟶ (Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L :=
  ⟨PresheafOfModules.Submodule.ι _⟩

/-- `L'` is a subsheaf of `π^* L`. -/
instance : Mono (baseBlowupSheafι hL s) := by
  have : Mono ((SheafOfModules.forget _).map (baseBlowupSheafι hL s)) :=
    PresheafOfModules.mono_of_injective fun _ => Subtype.val_injective
  exact (SheafOfModules.forget _).mono_of_mono_map this

/-- Local data on the blowing-up: near every point `x` of `X̃` there are an affine open `W₀`, a
trivialization `ε` of `π^* L` on `W₀`, a generator `a` of `I𝒪_{X̃}` on `W₀` which is a unit of the
total quotient ring, and functions `hᵢ` with `π^* sᵢ = hᵢ ε` on `W₀` generating `I𝒪_{X̃}` there. -/
private theorem exists_localData (x : baseBlowup hL s) :
    ∃ (W₀ : (baseBlowup hL s).affineOpens)
      (ε : Γ((Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L, W₀))
      (a : Γ(baseBlowup hL s, W₀)) (h : Fin (n + 1) → Γ(baseBlowup hL s, W₀)),
      x ∈ (W₀ : (baseBlowup hL s).Opens) ∧
      IsTrivializingSection ((Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L) W₀ ε ∧
      IsUnit ((baseBlowup hL s).toK W₀ a) ∧
      ((baseIdeal hL s).exceptionalIdeal (isCoherent_baseIdeal hL s)).ideal W₀ =
        Ideal.span {a} ∧
      ((baseIdeal hL s).exceptionalIdeal (isCoherent_baseIdeal hL s)).ideal W₀ =
        Ideal.span (Set.range h) ∧
      ∀ i, ((Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L).presheaf.map
        (homOfLE le_top).op (pullbackGlobalSection (baseBlowupProjection hL s) (s i)) =
          h i • ε := by
  set π := baseBlowupProjection hL s
  obtain ⟨V, e, hxV, hV, he⟩ := exists_isAffineOpen_isTrivializingSection hL (π x)
  choose g hg using fun i => he.exists_eq_smul (s i)
  have hB := baseLocusIdeal_range_ideal_eq_span hL s (V := ⟨V, hV⟩) he hg
  obtain ⟨U', a', hxU', hU'span, hU'unit⟩ :=
    ((baseIdeal hL s).isLocallyPrincipalNonZeroDivisor_exceptionalIdeal
      (isCoherent_baseIdeal hL s)).exists_isUnit x
  obtain ⟨W₀, hW₀, hxW₀⟩ := exists_affine_le (U := (U' : (baseBlowup hL s).Opens) ⊓ π ⁻¹ᵁ V)
    ⟨hxU', hxV⟩
  have ι₁ : (W₀ : (baseBlowup hL s).Opens) ≤ U' := hW₀.trans inf_le_left
  have ι₂ : (W₀ : (baseBlowup hL s).Opens) ≤ π ⁻¹ᵁ V := hW₀.trans inf_le_right
  refine ⟨W₀, ((Scheme.Modules.pullback π).obj L).presheaf.map (homOfLE ι₂).op
      (pullbackSection π e), (baseBlowup hL s).presheaf.map (homOfLE ι₁).op a',
    fun i => π.appLE V W₀ ι₂ (g i), hxW₀, (he.pullback π).restrict ι₂, ?_, ?_, ?_, fun i => ?_⟩
  · rw [← Scheme.toK_naturality]
    exact hU'unit.map _
  · rw [← Scheme.IdealSheafData.map_ideal _ (U := W₀) (V := U') ι₁, hU'span, Ideal.map_span,
      Set.image_singleton]
    rfl
  · rw [exceptionalIdeal_baseIdeal, inverseImageIdeal_ideal π _ ⟨V, hV⟩ W₀ ι₂, hB,
      Ideal.map_span, ← Set.range_comp]
    rfl
  · rw [← Scheme.Modules.map_map_homOfLE _ (le_top : π ⁻¹ᵁ V ≤ ⊤) ι₂,
      pullbackGlobalSection_restrict, hg i, pullbackSection_smul, Scheme.Modules.map_smul]
    rfl

/-- The pulled-back sections `π^* sᵢ` lie in `L' = π^* L · I𝒪_{X̃}`. -/
theorem pullbackGlobalSection_mem_baseBlowupSheaf (i : Fin (n + 1)) :
    pullbackGlobalSection (baseBlowupProjection hL s) (s i) ∈
      sub (powSmul ((baseIdeal hL s).exceptionalIdeal (isCoherent_baseIdeal hL s)) 1 ⊤) ⊤ := by
  intro x _
  obtain ⟨W₀, ε, a, h, hxW₀, -, -, -, hspan, hsec⟩ := exists_localData hL s x
  refine ⟨W₀, le_top, hxW₀, ?_⟩
  change ((Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L).presheaf.map
    (homOfLE le_top).op (pullbackGlobalSection (baseBlowupProjection hL s) (s i)) ∈
      _ ^ 1 • sub (⊤ : (((Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L).val).Submodule)
        (W₀ : (baseBlowup hL s).Opens)
  rw [hsec i, pow_one, hspan]
  exact Submodule.smul_mem_smul (Ideal.subset_span ⟨i, rfl⟩) trivial

/-- **The sections `π^* sᵢ` of `L'`.** -/
def baseBlowupSection (i : Fin (n + 1)) : Γ(baseBlowupSheaf hL s, ⊤) :=
  ⟨pullbackGlobalSection (baseBlowupProjection hL s) (s i),
    pullbackGlobalSection_mem_baseBlowupSheaf hL s i⟩

/-- Under `L' ⊆ π^* L`, the section `baseBlowupSection i` is `π^* sᵢ`. -/
theorem baseBlowupSheafι_app_baseBlowupSection (i : Fin (n + 1)) :
    (baseBlowupSheafι hL s).app ⊤ (baseBlowupSection hL s i) =
      pullbackGlobalSection (baseBlowupProjection hL s) (s i) :=
  rfl

/-- Near every point of `X̃` one of the `π^* sᵢ` trivializes `L'`. -/
theorem exists_isTrivializingSection_baseBlowupSection (x : baseBlowup hL s) :
    ∃ i, ∃ W : (baseBlowup hL s).Opens, x ∈ W ∧
      IsTrivializingSection (baseBlowupSheaf hL s) W
        ((baseBlowupSheaf hL s).presheaf.map (homOfLE le_top).op (baseBlowupSection hL s i)) := by
  set E := (Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L
  set I' := (baseIdeal hL s).exceptionalIdeal (isCoherent_baseIdeal hL s)
  obtain ⟨W₀, ε, a, h, hxW₀, hε, ha, hspana, hspan, hsec⟩ := exists_localData hL s x
  have hd : ∀ j, ∃ d : Γ(baseBlowup hL s, W₀), d * a = h j := fun j =>
    Ideal.mem_span_singleton'.mp (hspana ▸ hspan ▸ Ideal.subset_span ⟨j, rfl⟩)
  choose d hd using hd
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp
    (show a ∈ Ideal.span (Set.range h) from hspan ▸ hspana ▸ Ideal.mem_span_singleton_self a)
  have hsum : ∑ j, c j * d j = 1 := by
    have h1 : (∑ j, c j * d j) * a = 1 * a := by
      rw [one_mul, Finset.sum_mul]
      conv_rhs => rw [← hc]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [mul_assoc, hd j, smul_eq_mul]
    apply (baseBlowup hL s).toK_injective W₀
    have h2 := congrArg ((baseBlowup hL s).toK W₀) h1
    rw [map_mul, map_mul] at h2
    exact ha.mul_left_injective h2
  obtain ⟨i, hi⟩ : ∃ i, x ∈ (baseBlowup hL s).basicOpen (d i) := by
    by_contra hno
    push Not at hno
    have hmem : (baseBlowup hL s).presheaf.germ W₀ x hxW₀ (∑ j, c j * d j) ∈
        IsLocalRing.maximalIdeal ((baseBlowup hL s).presheaf.stalk x) := by
      rw [map_sum]
      refine Ideal.sum_mem _ fun j _ => ?_
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ ((IsLocalRing.mem_maximalIdeal _).mpr
        (((baseBlowup hL s).mem_basicOpen _ x hxW₀).not.mp (hno j)))
    rw [hsum, map_one] at hmem
    exact (IsLocalRing.mem_maximalIdeal _).mp hmem isUnit_one
  set W := (baseBlowup hL s).basicOpen (d i)
  have hWW₀ : W ≤ W₀ := (baseBlowup hL s).basicOpen_le (d i)
  have hdu : IsUnit ((baseBlowup hL s).presheaf.map (homOfLE hWW₀).op (d i)) :=
    (baseBlowup hL s).toRingedSpace.isUnit_res_basicOpen (d i)
  have hhW : (baseBlowup hL s).presheaf.map (homOfLE hWW₀).op (h i) =
      (baseBlowup hL s).presheaf.map (homOfLE hWW₀).op (d i) * (baseBlowup hL s).presheaf.map (homOfLE hWW₀).op a := by
    rw [← hd i, map_mul]
  have hunit : IsUnit ((baseBlowup hL s).toK W ((baseBlowup hL s).presheaf.map (homOfLE hWW₀).op (h i))) := by
    rw [hhW, map_mul, ← Scheme.toK_naturality (h := hWW₀) a]
    exact (hdu.map _).mul (ha.map _)
  have hI : ∀ V : (baseBlowup hL s).affineOpens, (hV : (V : (baseBlowup hL s).Opens) ≤ W) →
      I'.ideal V = Ideal.span {(baseBlowup hL s).presheaf.map (homOfLE hV).op
        ((baseBlowup hL s).presheaf.map (homOfLE hWW₀).op (h i))} := by
    intro V hV
    rw [← Scheme.IdealSheafData.map_ideal _ (U := V) (V := W₀) (hV.trans hWW₀), hspana,
      Ideal.map_span, Set.image_singleton, hhW, map_mul, Scheme.presheaf_map_map_homOfLE,
      Scheme.presheaf_map_map_homOfLE, Ideal.span_singleton_mul_left_unit]
    · rfl
    · rw [← Scheme.presheaf_map_map_homOfLE hWW₀ hV]
      exact hdu.map _
  have key := isTrivializingSection_powSmul E I' (hε.restrict hWW₀) _ hunit hI
  refine ⟨i, W, hi, ?_⟩
  have heq : ((baseBlowupSheaf hL s).presheaf.map (homOfLE le_top).op (baseBlowupSection hL s i) :
      Γ(toModules (powSmul I' 1 ⊤) (isLocal_powSmul _ _ _), W)) =
        ⟨_, smul_mem_powSmul E I' (ε := E.presheaf.map (homOfLE hWW₀).op ε) _ hI⟩ := by
    apply Subtype.ext
    change E.presheaf.map (homOfLE le_top).op
      (pullbackGlobalSection (baseBlowupProjection hL s) (s i)) = _
    rw [← Scheme.Modules.map_map_homOfLE _ (le_top : (W₀ : (baseBlowup hL s).Opens) ≤ ⊤) hWW₀,
      hsec i, Scheme.Modules.map_smul]
  exact heq ▸ key

/-- **Hartshorne II, Example 7.17.3: `L'` is invertible.** -/
theorem isInvertible_baseBlowupSheaf : (baseBlowupSheaf hL s).IsInvertible :=
  (Scheme.Modules.isInvertible_iff_ringed _).mpr
    (Ringed.isLocallyFreeOfRank_of_isLocalFrame fun x => by
      obtain ⟨i, W, hx, he⟩ := exists_isTrivializingSection_baseBlowupSection hL s x
      exact ⟨W, _, hx, isLocalFrame_of_isTrivializingSection he⟩)

/-- **Hartshorne II, Example 7.17.3: the `π^* sᵢ` generate `L'`.** -/
theorem isGeneratedBySections_baseBlowupSection :
    (baseBlowupSheaf hL s).IsGeneratedBySections
      (fun i : ULift.{u} (Fin (n + 1)) => baseBlowupSection hL s i.down) :=
  isGeneratedBySections_of_forall_isTrivializingSection _ fun x => by
    obtain ⟨i, W, hx, he⟩ := exists_isTrivializingSection_baseBlowupSection hL s x
    exact ⟨⟨i⟩, W, hx, he⟩

end Blowup

/-! ### The morphism `X̃ ⟶ ℙⁿ` and its restriction to `π⁻¹(U)` -/

section Morphism

variable {X : Scheme.{u}} {L : X.Modules} (hL : L.IsInvertible) {n : ℕ}
  (s : Fin (n + 1) → Γ(L, ⊤))

/-- The open set `U` on which the `sᵢ` generate `L` (the complement of the base locus) is the
complement of the center of the blowing-up. -/
theorem linearSystemDomain_eq_centerCompl :
    linearSystemDomain hL s = (baseIdeal hL s).centerCompl := by
  ext x
  change x ∈ linearSystemDomain hL s ↔
    x ∉ Set.range (quasicoherentIdealSubsheafEquiv (baseIdeal hL s)).subschemeι
  rw [quasicoherentIdealSubsheafEquiv_baseIdeal, Scheme.IdealSheafData.range_subschemeι]
  change _ ↔ x ∉ (baseLocusIdeal hL (Set.range s)).support
  rw [mem_support_baseLocusIdeal_iff, linearSystemDomain, Opens.mem_iSup]
  simp only [Set.forall_mem_range, not_forall, not_not]
  rfl

variable [IsNoetherian X]

/-- **Over `U` the blowing-up is an isomorphism** `π⁻¹(U) ⟶ U` (Proposition 7.13(b)). -/
theorem isIso_baseBlowupProjection_restrict :
    IsIso (baseBlowupProjection hL s ∣_ linearSystemDomain hL s) := by
  rw [linearSystemDomain_eq_centerCompl]
  exact (baseIdeal hL s).isIso_blowupProjection_restrict_centerCompl _

/-- Over `π⁻¹(U)` the subsheaf `L' ⊆ π^* L` is everything: there the base ideal is the unit ideal. -/
private theorem mem_baseBlowupSheaf_of_le {W : (baseBlowup hL s).Opens}
    (hW : W ≤ baseBlowupProjection hL s ⁻¹ᵁ linearSystemDomain hL s)
    (t : Γ((Scheme.Modules.pullback (baseBlowupProjection hL s)).obj L, W)) :
    t ∈ sub (powSmul ((baseIdeal hL s).exceptionalIdeal (isCoherent_baseIdeal hL s)) 1 ⊤) W := by
  intro x hx
  obtain ⟨V, hVU, hxV⟩ :=
    exists_affine_le (show baseBlowupProjection hL s x ∈ linearSystemDomain hL s from hW hx)
  obtain ⟨V'', hV''W, hxV''⟩ :=
    exists_affine_le (U := W ⊓ baseBlowupProjection hL s ⁻¹ᵁ (V : X.Opens)) ⟨hx, hxV⟩
  refine ⟨V'', hV''W.trans inf_le_left, hxV'', ?_⟩
  have hBV : (baseLocusIdeal hL (Set.range s)).ideal V = ⊤ := by
    have := (baseIdeal hL s).ideal_eq_top_of_le_centerCompl V.2
      (hVU.trans (linearSystemDomain_eq_centerCompl hL s).le)
    change (quasicoherentIdealSubsheafEquiv (baseIdeal hL s)).ideal V = ⊤ at this
    rwa [quasicoherentIdealSubsheafEquiv_baseIdeal] at this
  change _ ∈ _ ^ 1 • _
  rw [exceptionalIdeal_baseIdeal,
    inverseImageIdeal_ideal _ _ V V'' (hV''W.trans inf_le_right), hBV, Ideal.map_top, pow_one,
    Submodule.top_smul]
  trivial

/-- Over `π⁻¹(U)`, the inclusion `L' ⟶ π^* L` pulls back to an isomorphism. -/
private theorem isIso_pullback_map_baseBlowupSheafι :
    IsIso ((Scheme.Modules.pullback
      (baseBlowupProjection hL s ⁻¹ᵁ linearSystemDomain hL s).ι).map (baseBlowupSheafι hL s)) := by
  set j := (baseBlowupProjection hL s ⁻¹ᵁ linearSystemDomain hL s).ι
  have h1 : IsIso ((Scheme.Modules.restrictFunctor j).map (baseBlowupSheafι hL s)) := by
    refine ModuleGluing.isIso_of_bijective _ fun A => ⟨fun a b hab => Subtype.ext hab, fun t => ?_⟩
    exact ⟨⟨t, mem_baseBlowupSheaf_of_le hL s (Scheme.Opens.ι_image_le _ A.unop) t⟩, rfl⟩
  exact (NatIso.isIso_map_iff (Scheme.Modules.restrictFunctorIsoPullback j) _).mp h1

variable {Y : Scheme.{u}} (p : X ⟶ Y)

/-- **Hartshorne II, Example 7.17.3: the morphism `φ̃ : X̃ ⟶ ℙⁿ`.** The sections `π^* sᵢ` of `L'`
determine (Theorem 7.1) a unique `Y`-morphism `φ̃ : X̃ ⟶ ℙⁿ_Y` with `φ̃^* 𝒪(1) ≅ L'` carrying each
`φ̃^* xᵢ` to `π^* sᵢ`. -/
theorem existsUnique_baseBlowupMorphism :
    ∃! φ : baseBlowup hL s ⟶ projectiveSpaceOverScheme n Y,
      φ ≫ projectiveSpaceOverSchemeProjection n Y = baseBlowupProjection hL s ≫ p ∧
      ∃ e : (Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf n Y 1) ≅
          baseBlowupSheaf hL s,
        ∀ i, e.hom.app ⊤ (pullbackGlobalSection φ (projectiveSpaceCoordinate n Y i)) =
          baseBlowupSection hL s i :=
  existsUnique_morphism_of_isGeneratedBySections _ (isInvertible_baseBlowupSheaf hL s)
    (baseBlowupSection hL s) (isGeneratedBySections_baseBlowupSection hL s)

/-- The morphism `φ̃ : X̃ ⟶ ℙⁿ_Y` defined by the sections `π^* sᵢ` of `L'`. -/
def baseBlowupMorphism : baseBlowup hL s ⟶ projectiveSpaceOverScheme n Y :=
  (existsUnique_baseBlowupMorphism hL s p).exists.choose

/-- The defining property of `baseBlowupMorphism`. -/
theorem baseBlowupMorphism_spec :
    baseBlowupMorphism hL s p ≫ projectiveSpaceOverSchemeProjection n Y =
        baseBlowupProjection hL s ≫ p ∧
      ∃ e : (Scheme.Modules.pullback (baseBlowupMorphism hL s p)).obj
          (projectiveSpaceTwistingSheaf n Y 1) ≅ baseBlowupSheaf hL s,
        ∀ i, e.hom.app ⊤ (pullbackGlobalSection (baseBlowupMorphism hL s p)
          (projectiveSpaceCoordinate n Y i)) = baseBlowupSection hL s i :=
  (existsUnique_baseBlowupMorphism hL s p).exists.choose_spec

/-- On `π⁻¹(U)` the pulled-back sections `π^* sᵢ` generate `π^* L`. -/
private theorem isGeneratedBySections_restrict :
    ((Scheme.Modules.pullback ((baseBlowupProjection hL s ⁻¹ᵁ linearSystemDomain hL s).ι ≫
        baseBlowupProjection hL s)).obj L).IsGeneratedBySections
      (fun i : ULift.{u} (Fin (n + 1)) => pullbackGlobalSection
        ((baseBlowupProjection hL s ⁻¹ᵁ linearSystemDomain hL s).ι ≫ baseBlowupProjection hL s)
        (s i.down)) := by
  refine isGeneratedBySections_of_forall_isTrivializingSection _ fun y => ?_
  obtain ⟨i, hi⟩ := Opens.mem_iSup.mp y.2
  refine ⟨⟨i⟩, ((baseBlowupProjection hL s ⁻¹ᵁ linearSystemDomain hL s).ι ≫
    baseBlowupProjection hL s) ⁻¹ᵁ nonvanishingLocusOpens hL (s i), hi, ?_⟩
  rw [pullbackGlobalSection_restrict]
  exact IsTrivializingSection.pullback _ (isTrivializingSection_nonvanishingLocusOpens _ _)

/-- **Hartshorne II, Example 7.17.3: `φ̃` extends `φ`.** Let `φ : U ⟶ ℙⁿ_Y` be the morphism
defined (Theorem 7.1) by the sections `sᵢ|_U` on the open set `U` where they generate `L`. Then
the restriction of `φ̃` to `π⁻¹(U)` is `φ ∘ π|_{π⁻¹(U)}`, where `π|_{π⁻¹(U)} : π⁻¹(U) ⟶ U` is an
isomorphism (`isIso_baseBlowupProjection_restrict`). -/
theorem baseBlowupMorphism_restrict
    (φ : (linearSystemDomain hL s).toScheme ⟶ projectiveSpaceOverScheme n Y)
    (hφ : φ ≫ projectiveSpaceOverSchemeProjection n Y = (linearSystemDomain hL s).ι ≫ p)
    (e : (Scheme.Modules.pullback φ).obj (projectiveSpaceTwistingSheaf n Y 1) ≅
      linearSystemTwist hL s)
    (he : ∀ i, e.hom.app ⊤ (pullbackGlobalSection φ (projectiveSpaceCoordinate n Y i)) =
      linearSystemSections hL s i) :
    (baseBlowupProjection hL s ⁻¹ᵁ linearSystemDomain hL s).ι ≫ baseBlowupMorphism hL s p =
      (baseBlowupProjection hL s ∣_ linearSystemDomain hL s) ≫ φ := by
  set j := (baseBlowupProjection hL s ⁻¹ᵁ linearSystemDomain hL s).ι
  set ρ := baseBlowupProjection hL s ∣_ linearSystemDomain hL s
  have hcomm : ρ ≫ (linearSystemDomain hL s).ι = j ≫ baseBlowupProjection hL s :=
    morphismRestrict_ι _ _
  obtain ⟨hφ', e', he'⟩ := baseBlowupMorphism_spec hL s p
  obtain ⟨eA, heA⟩ := exists_iso_of_comp j (baseBlowupMorphism hL s p) rfl e' he'
  obtain ⟨eB, heB⟩ := exists_iso_of_comp ρ φ rfl e he
  have := isIso_pullback_map_baseBlowupSheafι hL s
  have hA : ∃ e : (Scheme.Modules.pullback (j ≫ baseBlowupMorphism hL s p)).obj
      (projectiveSpaceTwistingSheaf n Y 1) ≅ (Scheme.Modules.pullback (j ≫ baseBlowupProjection hL s)).obj L,
      ∀ i, e.hom.app ⊤ (pullbackGlobalSection (j ≫ baseBlowupMorphism hL s p)
        (projectiveSpaceCoordinate n Y i)) = pullbackGlobalSection (j ≫ baseBlowupProjection hL s) (s i) := by
    refine ⟨eA ≪≫ asIso ((Scheme.Modules.pullback j).map (baseBlowupSheafι hL s)) ≪≫
      (Scheme.Modules.pullbackComp j (baseBlowupProjection hL s)).app L, fun i => ?_⟩
    simp only [Iso.trans_hom, asIso_hom, Iso.app_hom, Scheme.Modules.Hom.comp_app,
      ConcreteCategory.comp_apply]
    rw [heA, pullback_map_pullbackGlobalSection, baseBlowupSheafι_app_baseBlowupSection,
      pullbackComp_hom_pullbackGlobalSection]
  have hB : ∃ e : (Scheme.Modules.pullback (ρ ≫ φ)).obj
      (projectiveSpaceTwistingSheaf n Y 1) ≅ (Scheme.Modules.pullback (j ≫ baseBlowupProjection hL s)).obj L,
      ∀ i, e.hom.app ⊤ (pullbackGlobalSection (ρ ≫ φ)
        (projectiveSpaceCoordinate n Y i)) = pullbackGlobalSection (j ≫ baseBlowupProjection hL s) (s i) := by
    have : ∃ e : (Scheme.Modules.pullback (ρ ≫ φ)).obj
        (projectiveSpaceTwistingSheaf n Y 1) ≅ (Scheme.Modules.pullback (ρ ≫ (linearSystemDomain hL s).ι)).obj L,
        ∀ i, e.hom.app ⊤ (pullbackGlobalSection (ρ ≫ φ)
          (projectiveSpaceCoordinate n Y i)) = pullbackGlobalSection (ρ ≫ (linearSystemDomain hL s).ι) (s i) := by
      refine ⟨eB ≪≫ (Scheme.Modules.pullbackComp ρ (linearSystemDomain hL s).ι).app L, fun i => ?_⟩
      simp only [Iso.trans_hom, Iso.app_hom, Scheme.Modules.Hom.comp_app,
        ConcreteCategory.comp_apply]
      rw [heB, pullbackComp_hom_pullbackGlobalSection]
    rwa [hcomm] at this
  exact (existsUnique_morphism_of_isGeneratedBySections (j ≫ baseBlowupProjection hL s ≫ p) (hL.pullback (j ≫ baseBlowupProjection hL s))
    (fun i => pullbackGlobalSection (j ≫ baseBlowupProjection hL s) (s i)) (isGeneratedBySections_restrict hL s)).unique
    ⟨by rw [Category.assoc, hφ'], hA⟩
    ⟨by rw [Category.assoc, hφ, ← Category.assoc, hcomm, Category.assoc], hB⟩

end Morphism

/-! ### Linear systems -/

section LinearSystem

variable {k : Type u} [Field k] {X : Scheme.{u}} [IsNoetherian X] (q : X ⟶ Spec (.of k))
  {L : X.Modules} (hL : L.IsInvertible) {n : ℕ} (s : Fin (n + 1) → globalSectionsOverField q L)

/-- **Hartshorne II, Example 7.17.3, for a linear system.** Let `𝔡` be the linear system of `L`
spanned by `s₀, …, sₙ`, and `π : X̃ ⟶ X` the blowing-up of its base ideal. The pulled-back linear
system of `L'`, spanned by the `π^* sᵢ`, is base-point-free. -/
theorem isBasePointFree_baseBlowup :
    (LinearSystem.ofFamily (k := k)
      (q := baseBlowupProjection hL (fun i => LinearSystem.toSection (s i)) ≫ q)
      (isInvertible_baseBlowupSheaf hL _)
      (fun i => (baseBlowupSection hL (fun i => LinearSystem.toSection (s i)) i :
        globalSectionsOverField (baseBlowupProjection hL (fun i => LinearSystem.toSection (s i)) ≫ q)
          (baseBlowupSheaf hL (fun i => LinearSystem.toSection (s i)))))).IsBasePointFree :=
  (LinearSystem.isBasePointFree_iff_isGeneratedBySections_of_span_eq _ _ rfl).mpr
    (isGeneratedBySections_baseBlowupSection hL _)

end LinearSystem

end Hartshorne
