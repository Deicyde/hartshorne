import Hartshorne.Scheme.CoherentAffineLocalCriterion
import Hartshorne.Scheme.GloballyGenerated
import Hartshorne.Scheme.LocallyFreeInvertible
import Hartshorne.Scheme.ModuleSheafTensor
import Hartshorne.Scheme.SheafTensorOperations

/-!
# Ample invertible sheaves

Hartshorne, *Algebraic Geometry*, II.7 (p. 153).

Let `X` be a Noetherian scheme. An invertible sheaf `L` on `X` is *ample* if for every coherent
sheaf `F` on `X` there is an integer `n₀` such that for every `n ≥ n₀` the sheaf `F ⊗ L^n` is
generated by global sections. Here `L^n` is the `n`-th tensor power `L^{⊗ n}`
(`Hartshorne.moduleSheafTensorPower n L`) and `F ⊗ L^n` is the tensor product of module sheaves
(`Hartshorne.moduleSheafTensor`).

## Main definitions

* `AlgebraicGeometry.Scheme.Modules.IsAmple L`: `L` is an ample invertible sheaf.
-/

universe u

open Hartshorne

namespace AlgebraicGeometry

namespace Scheme.Modules

variable {X : Scheme.{u}}

/-- **Ample invertible sheaves** (Hartshorne II.7, p. 153). On a Noetherian scheme `X`, an
invertible sheaf `L` is *ample* if for every coherent sheaf `F` on `X` there is an integer `n₀`
such that `F ⊗ L^n` is generated by global sections for every `n ≥ n₀`. -/
def IsAmple [IsNoetherian X] (L : X.Modules) : Prop :=
  L.IsInvertible ∧
    ∀ F : X.Modules, IsCoherent F → ∃ n₀ : ℕ, ∀ n ≥ n₀,
      IsGloballyGenerated (moduleSheafTensor F (moduleSheafTensorPower n L))

end Scheme.Modules

end AlgebraicGeometry
