/-!
# The denominator ideal of a birational line bundle

Hartshorne, *Algebraic Geometry*, II.7, proof of Theorem 7.17, Step 4 (p. 167), first half.

Let `f : Z ⟶ X` be a morphism of integral schemes sending the generic point to the generic point
whose pullback of rational functions `K(X) → K(Z)` is bijective, so that `X` and `Z` have the same
function field `K`. For an invertible sheaf `L` on `Z`:

* `f_* L` is a sub-`O_X`-module of the constant sheaf `K`, namely of the sheaf `K_X` of total
  quotient rings of `X`
  (`AlgebraicGeometry.Scheme.exists_pushforward_toTotalQuotientModule_injective`);
* if `f` is projective and `X` is locally of finite type over a field, `f_* L` is coherent
  (`AlgebraicGeometry.Scheme.isCoherent_pushforward_of_isInvertible`, from Corollary II.5.20).

Thus `f_* L` is a coherent fractional ideal. For any coherent `O_X`-module `F` with a morphism
`ι : F ⟶ K_X` on an integral scheme:

* over every affine open `U` containing the generic point there is a common denominator: a nonzero
  `a ∈ O_X(U)` with `a · ι(F(U)) ⊆ O_X(U)` (`AlgebraicGeometry.Scheme.exists_ne_zero_smul_mem_toK`),
  because `F(U)` is finitely generated over `O_X(U)` and `K(X)` is the fraction field of `O_X(U)`;
* the ideals of denominators `{a ∈ O_X(U) | a · ι(F(U)) ⊆ O_X(U)}` on the affine opens form ideal
  sheaf data (`AlgebraicGeometry.Scheme.denominatorIdeal`), hence a quasi-coherent ideal sheaf
  `J ⊆ O_X`, the *denominator ideal* (`AlgebraicGeometry.Scheme.denominatorIdealSheaf`); it is
  coherent on a locally Noetherian scheme, nonzero, and satisfies `J · F ⊆ O_X` over every open set
  (`AlgebraicGeometry.Scheme.exists_smul_eq_toK_of_mem_denominatorIdealSheaf`);
* for `A` ample, `J ⊗ A^n` is generated by global sections for some `n > 0`
  (`AlgebraicGeometry.Scheme.exists_isGloballyGenerated_denominatorIdealSheaf_tensor`).

`AlgebraicGeometry.Scheme.exists_denominatorIdealSheaf_of_birational` collects these facts for
`F = f_* L`.

## Construction

Sections of `f_* K_Z` over `U` are sections of `K_Z` over `f⁻¹ U`; when `U` contains the generic
point of `X` these are rational functions on `Z`, and we send them to `K(X)` by the inverse of the
pullback of rational functions (`AlgebraicGeometry.Scheme.totalQuotientPushforward`). This is an
injective morphism `f_* K_Z ⟶ K_X` of `O_X`-modules. Composing it with the direct image of an
embedding `L ≅ M ⊆ K_Z` given by Proposition II.6.15 embeds `f_* L` in `K_X`.

Compatibility of the ideals of denominators with restriction to a basic open set `D(g) ⊆ U`: if
`a · ι(F(U)) ⊆ O_X(U)` then `a · ι(F(V)) ⊆ O_X(V)` for every open `V ⊆ U`, since near each point a
section of `F` over `V` is `t / c` with `t ∈ F(U)` and `c` invertible there
(`AlgebraicGeometry.Scheme.exists_res_smul_eq_toK`); conversely if `a / g^m` clears the
denominators of the restrictions of finitely many generators of `F(U)`, then so does `g^k a` over
`U` for large `k`.
-/

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry Limits Hartshorne

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace AlgebraicGeometry.Scheme

/-- A morphism of `O_X`-modules that is injective on sections over every open set is a
monomorphism. -/
private theorem mono_of_app_injective {X : Scheme.{u}} {F G : X.Modules} (φ : F ⟶ G)
    (h : ∀ U : X.Opens, Function.Injective (φ.app U)) : Mono φ :=
  (SheafOfModules.forget _).mono_of_mono_map
    (PresheafOfModules.mono_of_injective fun U ↦ h U.unop)

section Pushforward

variable {X Z : Scheme.{u}} [IsIntegral X] [IsIntegral Z] (f : Z ⟶ X)
  (hf : f.base (genericPoint Z) = genericPoint X)
  (θ : Z.functionField →+* X.functionField)
  (hθ : ∀ g, θ (f.genericFunctionFieldMap hf g) = g)

open Classical in
/-- Sections of `f_* K_Z` over `U`, viewed as rational functions on `X` through a left inverse `θ`
of the pullback of rational functions. -/
def totalQuotientPushforwardApp (U : X.Opens)
    (t : Z.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ U))) : X.totalQuotientSheaf.obj.obj (op U) :=
  if h : genericPoint X ∈ U then
    (totalQuotientSheafEquivFunctionField U h).symm
      (θ (totalQuotientSheafEquivFunctionField (f ⁻¹ᵁ U)
        (genericPoint_mem_preimage_of_mem f hf h) t))
  else 0

/-- The rational function of the image of a section of `f_* K_Z`. -/
theorem totalQuotientPushforwardApp_spec {U : X.Opens} (h : genericPoint X ∈ U)
    (t : Z.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ U))) :
    totalQuotientSheafEquivFunctionField U h (totalQuotientPushforwardApp f hf θ U t) =
      θ (totalQuotientSheafEquivFunctionField (f ⁻¹ᵁ U)
        (genericPoint_mem_preimage_of_mem f hf h) t) := by
  rw [totalQuotientPushforwardApp, dif_pos h, RingEquiv.apply_symm_apply]

/-- The map `f_* K_Z ⟶ K_X` is additive. -/
theorem totalQuotientPushforwardApp_add (U : X.Opens)
    (t t' : Z.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ U))) :
    totalQuotientPushforwardApp f hf θ U (t + t') =
      totalQuotientPushforwardApp f hf θ U t + totalQuotientPushforwardApp f hf θ U t' := by
  refine totalQuotientSheaf_ext_of_isIntegral fun h ↦ ?_
  rw [map_add, totalQuotientPushforwardApp_spec, totalQuotientPushforwardApp_spec,
    totalQuotientPushforwardApp_spec, map_add, map_add]

include hθ in
/-- The map `f_* K_Z ⟶ K_X` is `O_X`-linear. -/
theorem totalQuotientPushforwardApp_toK_mul (U : X.Opens) (r : Γ(X, U))
    (t : Z.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ U))) :
    totalQuotientPushforwardApp f hf θ U (Z.toK (f ⁻¹ᵁ U) (f.app U r) * t) =
      X.toK U r * totalQuotientPushforwardApp f hf θ U t := by
  refine totalQuotientSheaf_ext_of_isIntegral fun h ↦ ?_
  rw [map_mul, totalQuotientPushforwardApp_spec, totalQuotientPushforwardApp_spec, map_mul,
    map_mul, totalQuotientSheafEquivFunctionField_toK, totalQuotientSheafEquivFunctionField_toK,
    ← genericFunctionFieldMap_germ f hf h, hθ]

/-- The map `f_* K_Z ⟶ K_X` commutes with restriction. -/
theorem totalQuotientPushforwardApp_map {U V : X.Opens} (i : V ≤ U)
    (t : Z.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ U))) :
    totalQuotientPushforwardApp f hf θ V
        (Z.totalQuotientSheaf.obj.map (homOfLE (f.preimage_mono i)).op t) =
      X.totalQuotientSheaf.obj.map (homOfLE i).op (totalQuotientPushforwardApp f hf θ U t) := by
  refine totalQuotientSheaf_ext_of_isIntegral fun h ↦ ?_
  rw [totalQuotientPushforwardApp_spec, totalQuotientSheafEquivFunctionField_map,
    totalQuotientSheafEquivFunctionField_map, totalQuotientPushforwardApp_spec]

/-- The map `f_* K_Z ⟶ K_X` is injective on sections. -/
theorem totalQuotientPushforwardApp_injective (U : X.Opens) :
    Function.Injective (totalQuotientPushforwardApp f hf θ U) := by
  intro t t' htt'
  by_cases h : genericPoint X ∈ U
  · have h' := genericPoint_mem_preimage_of_mem f hf h
    apply (totalQuotientSheafEquivFunctionField (f ⁻¹ᵁ U) h').injective
    apply θ.injective
    rw [← totalQuotientPushforwardApp_spec f hf θ h, ← totalQuotientPushforwardApp_spec f hf θ h,
      htt']
  · have : genericPoint Z ∉ f ⁻¹ᵁ U := fun h' ↦ h (genericPoint_mem_of_mem_preimage f hf h')
    have := totalQuotientSheaf_subsingleton_of_genericPoint_notMem this
    exact Subsingleton.elim _ _

/-- The morphism `f_* K_Z ⟶ K_X` of `O_X`-modules identifying rational functions on `Z` with
rational functions on `X` through a left inverse `θ` of the pullback `K(X) → K(Z)`. -/
def totalQuotientPushforward :
    (Modules.pushforward f).obj Z.totalQuotientModule ⟶ X.totalQuotientModule :=
  ⟨{ app := fun U ↦
        let g : ((Modules.pushforward f).obj Z.totalQuotientModule).val.obj U
            →ₗ[X.ringCatSheaf.obj.obj U] X.totalQuotientModule.val.obj U :=
          { toFun := totalQuotientPushforwardApp f hf θ U.unop
            map_add' := totalQuotientPushforwardApp_add f hf θ U.unop
            map_smul' := fun r t ↦ totalQuotientPushforwardApp_toK_mul f hf θ hθ U.unop r t }
        ConcreteCategory.ofHom (C := ModuleCat (X.ringCatSheaf.obj.obj U))
          (X := ((Modules.pushforward f).obj Z.totalQuotientModule).val.obj U)
          (Y := X.totalQuotientModule.val.obj U) g
     naturality := fun {U V} i ↦ by
        ext t
        exact totalQuotientPushforwardApp_map f hf θ (leOfHom i.unop) t }⟩

/-- The morphism `f_* K_Z ⟶ K_X` is injective on sections over every open set. -/
theorem totalQuotientPushforward_app_injective (U : X.Opens) :
    Function.Injective ((totalQuotientPushforward f hf θ hθ).app U) :=
  totalQuotientPushforwardApp_injective f hf θ U

end Pushforward

section FractionalIdeal

variable {X Z : Scheme.{u}} [IsIntegral X] [IsIntegral Z] (f : Z ⟶ X)
  (hf : f.base (genericPoint Z) = genericPoint X)

/-- **Hartshorne II, proof of Theorem 7.17, Step 4.** Let `f : Z ⟶ X` be a morphism of integral
schemes mapping the generic point to the generic point such that the pullback of rational
functions `K(X) → K(Z)` is bijective. For every invertible sheaf `L` on `Z`, the direct image
`f_* L` is a sub-`O_X`-module of the constant sheaf `K_X = K(X)`: there is a morphism
`f_* L ⟶ K_X` of `O_X`-modules that is injective on sections over every open set. Here `L`
is first identified with a subsheaf of `K_Z` by Proposition II.6.15. -/
theorem exists_pushforward_toTotalQuotientModule_injective
    (hbij : Function.Bijective (f.genericFunctionFieldMap hf))
    {L : Z.Modules} (hL : L.IsInvertible) :
    ∃ ι : (Modules.pushforward f).obj L ⟶ X.totalQuotientModule,
      ∀ U : X.Opens, Function.Injective (ι.app U) := by
  obtain ⟨M, ⟨χ⟩⟩ := exists_invertibleTotalQuotientSubmodule_iso hL
  let θ := (RingEquiv.ofBijective (f.genericFunctionFieldMap hf).hom hbij).symm.toRingHom
  have hθ : ∀ g, θ (f.genericFunctionFieldMap hf g) = g := fun g ↦
    (RingEquiv.ofBijective (f.genericFunctionFieldMap hf).hom hbij).symm_apply_apply g
  refine ⟨(Modules.pushforward f).map (χ.inv ≫ M.ι) ≫ totalQuotientPushforward f hf θ hθ,
    fun U ↦ ?_⟩
  have hmono : Mono (χ.inv ≫ M.ι) := inferInstance
  rw [Modules.Hom.comp_app]
  exact (totalQuotientPushforward_app_injective f hf θ hθ U).comp
    (@Ringed.modules_injective_app_of_mono _ Z.sheaf _ _ (χ.inv ≫ M.ι) hmono (f ⁻¹ᵁ U))

end FractionalIdeal

section Coherence

variable {X Z : Scheme.{u}} (f : Z ⟶ X)

/-- On a locally Noetherian scheme, an invertible sheaf is coherent. -/
theorem isCoherent_of_isInvertible [IsLocallyNoetherian Z] {L : Z.Modules} (hL : L.IsInvertible) :
    IsCoherent L :=
  isCoherent_of_iso (Hartshorne.Ringed.moduleSheafUnitTensor (R := Z.sheaf) L)
    (Hartshorne.isCoherent_moduleSheafTensor_of_isInvertible
      (isCoherent_structureSheafModule Z) hL)

/-- **Hartshorne II, Corollary 5.20, for line bundles.** If `f : Z ⟶ X` is projective and `X` is
locally of finite type over a field, the direct image of an invertible sheaf on `Z` is
coherent. -/
theorem isCoherent_pushforward_of_isInvertible (k : Type u) [Field k] (pX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType pX] (hfp : Hartshorne.Projective f) {L : Z.Modules}
    (hL : L.IsInvertible) : IsCoherent ((Modules.pushforward f).obj L) := by
  have : IsProper f := hfp.isProper
  have : LocallyOfFiniteType (f ≫ pX) := inferInstance
  have : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian (f ≫ pX)
  exact Hartshorne.isCoherent_pushforward_of_projective_of_locallyOfFiniteType k pX f hfp L
    (isCoherent_of_isInvertible hL)

end Coherence

section CommonDenominator

variable {X : Scheme.{u}} [IsIntegral X]

/-- **Common denominators for a finite set of local generators** (Hartshorne II, proof of
Theorem 7.17, Step 4). Let `F` be a coherent `O_X`-module on an integral scheme with a morphism
`ι : F ⟶ K_X` to the constant sheaf of rational functions. Over every nonempty affine open `U`
there is a nonzero regular function `a` with `a · ι(F(U)) ⊆ O_X(U)` inside `K_X(U)`. -/
theorem exists_ne_zero_smul_mem_toK {F : X.Modules} (hF : IsCoherent F)
    (ι : F ⟶ X.totalQuotientModule) (U : X.affineOpens) (hU : genericPoint X ∈ (U : X.Opens)) :
    ∃ a : Γ(X, U), a ≠ 0 ∧ ∀ s : Γ(F, U), ∃ b : Γ(X, U), ι.app U (a • s) = X.toK U b := by
  classical
  have : Nonempty (U : X.Opens) := ⟨⟨_, hU⟩⟩
  have := functionField_isFractionRing_of_isAffineOpen X (U : X.Opens) U.2
  have hfin := (forall_affine_finite_of_isCoherent F hF U).1
  obtain ⟨S, hS⟩ := hfin.fg_top
  let φ := totalQuotientSheafEquivFunctionField (U : X.Opens) hU
  have hφ : ∀ b : Γ(X, U), φ (X.toK U b) = algebraMap Γ(X, U) X.functionField b := fun b ↦
    totalQuotientSheafEquivFunctionField_toK _ hU b
  obtain ⟨⟨a, ha⟩, hint⟩ := IsLocalization.exist_integer_multiples_of_finset
    (nonZeroDivisors Γ(X, U)) (S.image fun s ↦ φ (ι.app U s))
  refine ⟨a, nonZeroDivisors.ne_zero ha, fun s ↦ ?_⟩
  have hs : s ∈ Submodule.span Γ(X, U) (S : Set Γ(F, U)) := hS ▸ Submodule.mem_top
  induction hs using Submodule.span_induction with
  | mem s hs =>
    obtain ⟨b, hb⟩ := hint _ (Finset.mem_image_of_mem _ hs)
    refine ⟨b, φ.injective ?_⟩
    rw [hφ, hb, Modules.Hom.app_smul]
    change φ (X.toK U a * (show X.totalQuotientSheaf.obj.obj (op (U : X.Opens)) from
      ι.app U s)) = a • φ (ι.app U s)
    rw [map_mul, hφ, Algebra.smul_def]
  | zero => exact ⟨0, by rw [smul_zero, map_zero, map_zero]⟩
  | add s t _ _ hs ht =>
    obtain ⟨b, hb⟩ := hs
    obtain ⟨c, hc⟩ := ht
    exact ⟨b + c, by rw [smul_add, map_add, hb, hc, map_add]⟩
  | smul r s _ hs =>
    obtain ⟨b, hb⟩ := hs
    refine ⟨r * b, ?_⟩
    rw [smul_comm, Modules.Hom.app_smul, hb, map_mul]
    rfl

end CommonDenominator

section RationalFunction

variable {X : Scheme.{u}} [IsIntegral X] {F : X.Modules} (ι : F ⟶ X.totalQuotientModule)

/-- The rational function `ι(s) ∈ K(X)` of a section `s` of `F` over an open set containing the
generic point. -/
private def ratFun {V : X.Opens} (hV : genericPoint X ∈ V) (s : Γ(F, V)) : X.functionField :=
  totalQuotientSheafEquivFunctionField V hV (ι.app V s)

private theorem ratFun_smul {V : X.Opens} (hV : genericPoint X ∈ V) (r : Γ(X, V))
    (s : Γ(F, V)) :
    ratFun ι hV (r • s) = X.presheaf.germ V (genericPoint X) hV r * ratFun ι hV s := by
  unfold ratFun
  rw [Modules.Hom.app_smul]
  change totalQuotientSheafEquivFunctionField V hV
    (X.toK V r * (show X.totalQuotientSheaf.obj.obj (op V) from ι.app V s)) = _
  rw [map_mul, totalQuotientSheafEquivFunctionField_toK]

private theorem ratFun_res {V W : X.Opens} (i : W ⟶ V) (hW : genericPoint X ∈ W)
    (s : Γ(F, V)) : ratFun ι hW (F.presheaf.map i.op s) = ratFun ι (leOfHom i hW) s := by
  unfold ratFun
  have := ConcreteCategory.congr_hom (ι.mapPresheaf.naturality i.op) s
  simp only [Modules.mapPresheaf_app, ConcreteCategory.comp_apply] at this
  rw [this]
  exact totalQuotientSheafEquivFunctionField_map (leOfHom i) hW _

private theorem app_eq_toK_iff {V : X.Opens} (hV : genericPoint X ∈ V) (s : Γ(F, V))
    (b : Γ(X, V)) :
    ι.app V s = X.toK V b ↔ ratFun ι hV s = X.presheaf.germ V (genericPoint X) hV b := by
  unfold ratFun
  rw [← totalQuotientSheafEquivFunctionField_toK V hV b]
  exact (totalQuotientSheafEquivFunctionField V hV).injective.eq_iff.symm

/-- **Clearing denominators is local.** Let `F` be a coherent `O_X`-module on an integral scheme
with a morphism `ι : F ⟶ K_X`, let `U` be an affine open and let `a ∈ O_X(U)` satisfy
`a · ι(F(U)) ⊆ O_X(U)`. Then `a · ι(F(V)) ⊆ O_X(V)` for every open `V ⊆ U`. -/
theorem exists_res_smul_eq_toK {F : X.Modules} (hF : IsCoherent F)
    (ι : F ⟶ X.totalQuotientModule) (U : X.affineOpens) (a : Γ(X, U))
    (ha : ∀ t : Γ(F, U), ∃ b : Γ(X, U), ι.app U (a • t) = X.toK U b) {V : X.Opens}
    (hVU : V ≤ U) (s : Γ(F, V)) :
    ∃ b : Γ(X, V), ι.app V (X.presheaf.map (homOfLE hVU).op a • s) = X.toK V b := by
  have hiso := (forall_affine_finite_of_isCoherent F hF U).2
  suffices h : ∃ b : Γ(X, V), X.toK V b =
      (show X.totalQuotientSheaf.obj.obj (op V) from
        ι.app V (X.presheaf.map (homOfLE hVU).op a • s)) by
    obtain ⟨b, hb⟩ := h
    exact ⟨b, hb.symm⟩
  refine exists_toK_eq_of_locally _ fun x hx ↦ ?_
  have hxU : x ∈ (U : X.Opens) := hVU hx
  have hloc := FiberDimAux.isLocalizedModule_germₗ F U.2 hiso ⟨x, hxU⟩
  obtain ⟨⟨t, c⟩, hc⟩ := IsLocalizedModule.surj (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
    (FiberDimAux.germₗ F ⟨x, hxU⟩) (F.presheaf.germ V x hx s)
  change X.presheaf.germ U x hxU c • F.presheaf.germ V x hx s = F.presheaf.germ U x hxU t at hc
  rw [ArtinReesKernelSheaf.germ_smul_germ] at hc
  obtain ⟨W, hxW, iU, iV, hW⟩ := TopCat.Presheaf.germ_eq _ x _ hxU _ t hc
  have hxc : x ∈ X.basicOpen (c : Γ(X, U)) :=
    ArtinReesKernelSheaf.mem_basicOpen_of_mem_primeCompl U hxU c.2
  have hW'V : W ⊓ X.basicOpen (c : Γ(X, U)) ≤ V :=
    inf_le_left.trans ((leOfHom iU).trans inf_le_right)
  have hW'U : W ⊓ X.basicOpen (c : Γ(X, U)) ≤ U := inf_le_right.trans (X.basicOpen_le _)
  have hηW : genericPoint X ∈ W := genericPoint_mem_opens_of_mem hxW
  have hηW' : genericPoint X ∈ W ⊓ X.basicOpen (c : Γ(X, U)) :=
    genericPoint_mem_opens_of_mem (show x ∈ W ⊓ X.basicOpen (c : Γ(X, U)) from ⟨hxW, hxc⟩)
  have hηU : genericPoint X ∈ (U : X.Opens) := hW'U hηW'
  have hηV : genericPoint X ∈ V := hW'V hηW'
  obtain ⟨b, hb⟩ := ha t
  obtain ⟨u, hu⟩ := ArtinReesKernelSheaf.isUnit_res_of_le_basicOpen (c : Γ(X, U)) hW'U
    inf_le_right
  refine ⟨W ⊓ X.basicOpen (c : Γ(X, U)), hW'V, ⟨hxW, hxc⟩,
    ↑u⁻¹ * X.presheaf.map (homOfLE hW'U).op b, ?_⟩
  -- Everything is compared in the function field.
  set γ := fun (V' : X.Opens) (h : genericPoint X ∈ V') ↦ X.presheaf.germ V' (genericPoint X) h
  -- (i) `c · s = t` near `x`.
  have h1 : γ U hηU c * ratFun ι hηV s = ratFun ι hηU t := by
    have := congrArg (ratFun ι hηW) hW
    rw [ratFun_res, ratFun_res, ratFun_smul, ratFun_res] at this
    rw [← this]
    congr 1
    exact (X.presheaf.germ_res_apply _ _ _ _).symm
  -- (ii) `a · t = b`.
  have h2 : γ U hηU a * ratFun ι hηU t = γ U hηU b := by
    rw [← ratFun_smul]
    exact (app_eq_toK_iff ι hηU _ b).1 hb
  -- (iii) `u⁻¹ c = 1` on `W'`.
  have h3 : γ _ hηW' (↑u⁻¹ : Γ(X, W ⊓ X.basicOpen (c : Γ(X, U)))) * γ U hηU c = 1 := by
    rw [← X.presheaf.germ_res_apply (homOfLE hW'U) _ hηW', ← hu, ← map_mul, Units.inv_mul,
      map_one]
  refine totalQuotientSheaf_ext_of_isIntegral fun h ↦ ?_
  rw [totalQuotientSheafEquivFunctionField_toK, totalQuotientSheafEquivFunctionField_map]
  change _ = ratFun ι hηV _
  rw [ratFun_smul, map_mul, X.presheaf.germ_res_apply, X.presheaf.germ_res_apply]
  change γ _ h _ * γ U hηU b = γ U hηU a * ratFun ι hηV s
  rw [← h2, ← h1, ← mul_one (γ U hηU a * ratFun ι hηV s), ← h3]
  ring

end RationalFunction

section DenominatorIdeal

variable {X : Scheme.{u}} {F : X.Modules} (ι : F ⟶ X.totalQuotientModule)

/-- The ideal of regular functions `a ∈ O_X(U)` with `a · ι(F(U)) ⊆ O_X(U)` inside `K_X(U)`: the
denominators of the sections of `F` over `U`. -/
def denominatorIdealObj (U : X.Opens) : Ideal Γ(X, U) where
  carrier := {a | ∀ t : Γ(F, U), ∃ b : Γ(X, U), ι.app U (a • t) = X.toK U b}
  zero_mem' := fun t ↦ ⟨0, by rw [zero_smul, map_zero, map_zero]⟩
  add_mem' := fun {a a'} ha ha' t ↦ by
    obtain ⟨b, hb⟩ := ha t
    obtain ⟨b', hb'⟩ := ha' t
    exact ⟨b + b', by rw [add_smul, map_add, hb, hb', map_add]⟩
  smul_mem' := fun r a ha t ↦ by
    obtain ⟨b, hb⟩ := ha t
    refine ⟨r * b, ?_⟩
    rw [smul_eq_mul, mul_smul, Modules.Hom.app_smul, hb, map_mul]
    rfl

/-- Membership in the ideal of denominators. -/
theorem mem_denominatorIdealObj_iff {U : X.Opens} (a : Γ(X, U)) :
    a ∈ denominatorIdealObj ι U ↔ ∀ t : Γ(F, U), ∃ b : Γ(X, U), ι.app U (a • t) = X.toK U b :=
  Iff.rfl

/-- It suffices to clear the denominators of a generating set. -/
theorem mem_denominatorIdealObj_of_span_eq_top {U : X.Opens} {S : Set Γ(F, U)}
    (hS : Submodule.span Γ(X, U) S = ⊤) (a : Γ(X, U))
    (ha : ∀ t ∈ S, ∃ b : Γ(X, U), ι.app U (a • t) = X.toK U b) :
    a ∈ denominatorIdealObj ι U := by
  intro t
  have ht : t ∈ Submodule.span Γ(X, U) S := hS ▸ Submodule.mem_top
  induction ht using Submodule.span_induction with
  | mem t ht => exact ha t ht
  | zero => exact ⟨0, by rw [smul_zero, map_zero, map_zero]⟩
  | add t t' _ _ ht ht' =>
    obtain ⟨b, hb⟩ := ht
    obtain ⟨b', hb'⟩ := ht'
    exact ⟨b + b', by rw [smul_add, map_add, hb, hb', map_add]⟩
  | smul r t _ ht =>
    obtain ⟨b, hb⟩ := ht
    refine ⟨r * b, ?_⟩
    rw [smul_comm, Modules.Hom.app_smul, hb, map_mul]
    rfl

variable [IsIntegral X] {ι}

/-- **The denominator ideal** (Hartshorne II, proof of Theorem 7.17, Step 4). For a coherent
`O_X`-module `F` on an integral scheme with a morphism `ι : F ⟶ K_X`, the ideals of
denominators `{a ∈ O_X(U) | a · ι(F(U)) ⊆ O_X(U)}` on the affine opens `U` form ideal sheaf data:
they are compatible with restriction to basic open sets. -/
def denominatorIdeal (hF : IsCoherent F) (ι : F ⟶ X.totalQuotientModule) : X.IdealSheafData where
  ideal U := denominatorIdealObj ι U
  map_ideal_basicOpen U g := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha s
      exact exists_res_smul_eq_toK hF ι U a ha (X.basicOpen_le g) s
    intro a' ha'
    by_cases hη : genericPoint X ∈ X.basicOpen g
    swap
    · have h0 : X.basicOpen g = ⊥ := opens_eq_bot_of_genericPoint_notMem hη
      have : Subsingleton Γ(X, X.basicOpen g) :=
        CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty h0)
      rw [Subsingleton.elim a' 0]
      exact zero_mem _
    have hηU : genericPoint X ∈ (U : X.Opens) := X.basicOpen_le g hη
    have := U.2.isLocalization_basicOpen g
    obtain ⟨S, hS⟩ := (forall_affine_finite_of_isCoherent F hF U).1.fg_top
    set γ := fun (V' : X.Opens) (h : genericPoint X ∈ V') ↦
      X.presheaf.germ V' (genericPoint X) h
    have hγ : ∀ r : Γ(X, U), γ _ hη (algebraMap Γ(X, U) Γ(X, X.basicOpen g) r) = γ _ hηU r :=
      fun r ↦ X.presheaf.germ_res_apply (homOfLE (X.basicOpen_le g)) _ hη r
    obtain ⟨⟨a, ⟨_, m, rfl⟩⟩, hm⟩ := IsLocalization.surj (Submonoid.powers g) a'
    have hm' : γ _ hη a' * γ _ hηU g ^ m = γ _ hηU a := by
      have := congrArg (γ _ hη) hm
      simp only [map_mul, map_pow, hγ] at this
      exact this
    -- Each generator `t` has `g ^ k * a * t` regular for some `k`.
    have key : ∀ t : Γ(F, U), ∃ (k : ℕ) (c : Γ(X, U)),
        ι.app U ((g ^ k * a) • t) = X.toK U (c * g ^ m) := by
      intro t
      obtain ⟨b', hb'⟩ := ha' (F.presheaf.map (homOfLE (X.basicOpen_le g)).op t)
      obtain ⟨⟨c, ⟨_, k, rfl⟩⟩, hk⟩ := IsLocalization.surj (Submonoid.powers g)
        (show Γ(X, X.basicOpen g) from b')
      refine ⟨k, c, (app_eq_toK_iff ι hηU _ _).2 ?_⟩
      have h1 := (app_eq_toK_iff ι hη _ _).1 hb'
      rw [ratFun_smul, ratFun_res] at h1
      have h2 : γ _ hη b' * γ _ hηU g ^ k = γ _ hηU c := by
        have := congrArg (γ _ hη) hk
        simp only [map_mul, map_pow, hγ] at this
        exact this
      rw [ratFun_smul, map_mul, map_mul, map_pow, map_pow]
      change γ _ hηU g ^ k * γ _ hηU a * ratFun ι hηU t = γ _ hηU c * γ _ hηU g ^ m
      rw [← hm', ← h2, ← h1]
      ring
    choose k c hkc using key
    set K := ∑ t ∈ S, k t
    have hK : g ^ K * a ∈ denominatorIdealObj ι U := by
      refine mem_denominatorIdealObj_of_span_eq_top ι hS _ fun t ht ↦ ?_
      have hle : k t ≤ K := Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) ht
      refine ⟨g ^ (K - k t) * (c t * g ^ m), ?_⟩
      rw [show g ^ K * a = g ^ (K - k t) * (g ^ k t * a) by
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle], mul_smul, Modules.Hom.app_smul,
        hkc, map_mul (X.toK U) (g ^ (K - k t)) (c t * g ^ m)]
      rfl
    have hu : IsUnit (algebraMap Γ(X, U) Γ(X, X.basicOpen g) (g ^ (K + m))) :=
      IsLocalization.map_units _ (⟨g ^ (K + m), K + m, rfl⟩ : Submonoid.powers g)
    obtain ⟨u, hu⟩ := hu
    have ha'eq : a' = algebraMap Γ(X, U) Γ(X, X.basicOpen g) (g ^ K * a) * ↑u⁻¹ := by
      rw [Units.eq_mul_inv_iff_mul_eq, hu, pow_add, map_mul, map_mul, ← hm, mul_comm]
      ring
    rw [ha'eq]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hK)

/-- The denominator ideal over an affine open. -/
theorem denominatorIdeal_ideal (hF : IsCoherent F) (ι : F ⟶ X.totalQuotientModule)
    (U : X.affineOpens) : (denominatorIdeal hF ι).ideal U = denominatorIdealObj ι U :=
  rfl

/-- **The denominator ideal is nonzero** on every affine open containing the generic point. -/
theorem denominatorIdeal_ideal_ne_bot (hF : IsCoherent F) (ι : F ⟶ X.totalQuotientModule)
    (U : X.affineOpens) (hU : genericPoint X ∈ (U : X.Opens)) :
    (denominatorIdeal hF ι).ideal U ≠ ⊥ := by
  obtain ⟨a, ha, h⟩ := exists_ne_zero_smul_mem_toK hF ι U hU
  exact fun hbot ↦ ha ((Ideal.mem_bot).1 (hbot ▸ (h : a ∈ denominatorIdealObj ι U)))

/-- **The denominator ideal sheaf** `J ⊆ O_X` of a coherent `O_X`-module `F` with a morphism
`ι : F ⟶ K_X`, as a quasi-coherent ideal subsheaf of `O_X`: over an affine open `U` its sections
are the `a ∈ O_X(U)` with `a · ι(F(U)) ⊆ O_X(U)`. -/
def denominatorIdealSheaf (hF : IsCoherent F) (ι : F ⟶ X.totalQuotientModule) :
    QuasicoherentIdealSubsheaf X :=
  quasicoherentIdealSubsheafEquiv.symm (denominatorIdeal hF ι)

/-- Sections of the denominator ideal sheaf over an affine open. -/
theorem denominatorIdealSheaf_ideal (hF : IsCoherent F) (ι : F ⟶ X.totalQuotientModule)
    (U : X.affineOpens) :
    (denominatorIdealSheaf hF ι).ideal U = denominatorIdealObj ι U :=
  quasicoherentIdealSubsheafEquiv_symm_ideal _ U

/-- The denominator ideal sheaf is coherent on a locally Noetherian integral scheme. -/
theorem isCoherent_denominatorIdealSheaf [IsLocallyNoetherian X] (hF : IsCoherent F)
    (ι : F ⟶ X.totalQuotientModule) : IsCoherent (denominatorIdealSheaf hF ι).toModules :=
  SerreAffineness.isCoherent_toModules _

/-- The denominator ideal sheaf is nonzero over every affine open containing the generic
point. -/
theorem denominatorIdealSheaf_ideal_ne_bot (hF : IsCoherent F) (ι : F ⟶ X.totalQuotientModule)
    (U : X.affineOpens) (hU : genericPoint X ∈ (U : X.Opens)) :
    (denominatorIdealSheaf hF ι).ideal U ≠ ⊥ := by
  rw [denominatorIdealSheaf_ideal]
  exact denominatorIdeal_ideal_ne_bot hF ι U hU

/-- **`J · F ⊆ O_X`.** Over every open `V`, a section `a` of the denominator ideal sheaf
multiplies `ι(F(V))` into `O_X(V)`. -/
theorem exists_smul_eq_toK_of_mem_denominatorIdealSheaf (hF : IsCoherent F)
    (ι : F ⟶ X.totalQuotientModule) {V : X.Opens} {a : Γ(X, V)}
    (ha : a ∈ (denominatorIdealSheaf hF ι).ideal V) (s : Γ(F, V)) :
    ∃ b : Γ(X, V), ι.app V (a • s) = X.toK V b := by
  suffices h : ∃ b : Γ(X, V), X.toK V b =
      (show X.totalQuotientSheaf.obj.obj (op V) from ι.app V (a • s)) by
    obtain ⟨b, hb⟩ := h
    exact ⟨b, hb.symm⟩
  refine exists_toK_eq_of_locally _ fun x hx ↦ ?_
  obtain ⟨W, hWV, hxW⟩ := ArtinReesKernelSheaf.exists_affine_le hx
  have haW : X.presheaf.map (homOfLE hWV).op a ∈ denominatorIdealObj ι W := by
    rw [← denominatorIdealSheaf_ideal hF ι W]
    exact ArtinReesKernelSheaf.res_mem _ hWV ha
  obtain ⟨b, hb⟩ := haW (F.presheaf.map (homOfLE hWV).op s)
  refine ⟨W, hWV, hxW, b, ?_⟩
  rw [← hb]
  have := ConcreteCategory.congr_hom (ι.mapPresheaf.naturality (homOfLE hWV).op) (a • s)
  simp only [Modules.mapPresheaf_app, ConcreteCategory.comp_apply] at this
  rw [Modules.map_smul] at this
  exact this

/-- **A sufficiently positive twist of the denominator ideal is globally generated.** If `A` is an
ample invertible sheaf on the Noetherian integral scheme `X`, then `J ⊗ A^n` is generated by global
sections for some `n > 0`, where `J` is the denominator ideal sheaf. -/
theorem exists_isGloballyGenerated_denominatorIdealSheaf_tensor [IsNoetherian X]
    (hF : IsCoherent F) (ι : F ⟶ X.totalQuotientModule) {A : X.Modules} (hA : A.IsAmple) :
    ∃ n : ℕ, 0 < n ∧ Modules.IsGloballyGenerated
      (moduleSheafTensor (denominatorIdealSheaf hF ι).toModules (moduleSheafTensorPower n A)) := by
  obtain ⟨n₀, hn₀⟩ := hA.2 _ (isCoherent_denominatorIdealSheaf hF ι)
  exact ⟨n₀ + 1, Nat.succ_pos n₀, hn₀ _ (Nat.le_succ n₀)⟩

end DenominatorIdeal

section Birational

variable {X Z : Scheme.{u}} [IsIntegral X] [IsIntegral Z] (f : Z ⟶ X)
  (hf : f.base (genericPoint Z) = genericPoint X)

/-- **The denominator ideal of a birational line bundle** (Hartshorne II, proof of
Theorem 7.17, Step 4, first half). Let `f : Z ⟶ X` be a projective morphism of integral schemes,
with `X` locally of finite type over a field, mapping the generic point to the generic point and
inducing a bijection of function fields, and let `L` be invertible on `Z`. Then `f_* L` is a
coherent sub-`O_X`-module of the constant sheaf `K_X = K(X)`, and its denominator ideal `J` is a
coherent ideal sheaf of `O_X`, nonzero over every nonempty affine open, with `J · f_* L ⊆ O_X`. -/
theorem exists_denominatorIdealSheaf_of_birational (k : Type u) [Field k] (pX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType pX] (hfp : Hartshorne.Projective f)
    (hbij : Function.Bijective (f.genericFunctionFieldMap hf)) {L : Z.Modules}
    (hL : L.IsInvertible) :
    ∃ ι : (Modules.pushforward f).obj L ⟶ X.totalQuotientModule, Mono ι ∧
      IsCoherent (denominatorIdealSheaf (isCoherent_pushforward_of_isInvertible f k pX hfp hL)
        ι).toModules ∧
      (∀ U : X.affineOpens, genericPoint X ∈ (U : X.Opens) →
        (denominatorIdealSheaf (isCoherent_pushforward_of_isInvertible f k pX hfp hL) ι).ideal
          U ≠ ⊥) ∧
      ∀ (V : X.Opens) (a : Γ(X, V)),
        a ∈ (denominatorIdealSheaf (isCoherent_pushforward_of_isInvertible f k pX hfp hL)
          ι).ideal V →
        ∀ s : Γ((Modules.pushforward f).obj L, V), ∃ b : Γ(X, V), ι.app V (a • s) = X.toK V b := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian pX
  obtain ⟨ι, hι⟩ := exists_pushforward_toTotalQuotientModule_injective f hf hbij hL
  exact ⟨ι, mono_of_app_injective ι hι, isCoherent_denominatorIdealSheaf _ ι,
    fun U hU ↦ denominatorIdealSheaf_ideal_ne_bot _ ι U hU,
    fun V a ha s ↦ exists_smul_eq_toK_of_mem_denominatorIdealSheaf _ ι ha s⟩

end Birational

end AlgebraicGeometry.Scheme
