import Hartshorne.Scheme.ProjectiveGlobalSectionsFinite

/-!
# Eventual recovery of a graded module from its graded sections

Hartshorne, *Algebraic Geometry*, II, Exercise 5.9(a,b) (p. 125).

Let `S` be a graded ring generated by `S_1` as an `S_0`-algebra, `M` a graded `S`-module and
`X = Proj S`.

* **(a)** There is a natural graded homomorphism `α : M → Γ_*(M~)` (`EventualSectionRecovery.alpha`).
  For `m ∈ M_d` the element `m ∈ M(d)_0` gives the global section `m / 1` of `M(d)~`
  (`constSection`), and `α(m)` is its image under `M(d)~ ≅ M~ ⊗ 𝒪_X(d)` (Proposition 5.12(b),
  `ProjTwist.twistIso`) in `Γ(X, M~(d))` (`alphaComponent`). It is `S`-linear (`alpha` is a linear
  map; `mulGlobal_alphaSec`), graded (`alpha_of_mem`) and natural in `M` for degree-preserving
  linear maps (`gammaStarMap_alpha`).
* **(b)** If `S_0` is a finitely generated algebra over a field and `S` is generated over `S_0` by
  finitely many elements of degree one, and `M` is finitely generated, then `α_d` is bijective for
  all large `d` (`exists_bijective_alphaComponent`).

## Proof of (b)

Following Hartshorne's hint to use the methods of the proof of Theorem 5.19. It suffices that
`M_d → Γ(X, M(d)~)`, `m ↦ m / 1` (`constHom`) is eventually bijective (`EventuallyBijective`).

* This passes through a short exact sequence `0 → M' → M → M'' → 0` (`eventuallyBijective_of_exact`):
  global sections are left exact (`exists_sections_of_gradedLocMap_eq_zero`), and a diagram chase
  gives bijectivity in the middle.
* By Proposition I.7.4, `M` has a filtration with factors `(S/𝔭)(l)`
  (`eventuallyBijective_of_primeFactors`).
* For `(S/𝔭)(l)` (`exists_bijective_constHom0_primeFactor`): if `S₊ ⊆ 𝔭` both sides vanish in
  positive degrees. Otherwise a global section of `(S/𝔭)(l)~` is determined by its value `z` in the
  fraction field of `S/𝔭` at the point `𝔭`, which satisfies the chart condition of the proof of
  Theorem 5.19 in degree `l`. All such elements, in all degrees, span a finitely generated module
  (they are integral over `S/𝔭`, whose integral closure is finite); a generator `g` of degree `n_g`
  multiplies `(S/𝔭)_d` into `(S/𝔭)_{d + n_g}` for `d ≥ D_g`, and comparing homogeneous components
  shows that every such `z` of degree `l ≥ ∑ (n_g + D_g)` lies in `(S/𝔭)_l`
  (`exists_bound_of_chartCond`).

Several private helpers of `Hartshorne.Scheme.ProjectiveGlobalSectionsFinite` are copied privately.
-/

universe u

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace Hartshorne

open AlgebraicGeometry CategoryTheory MonoidalCategory HomogeneousLocalization TopologicalSpace
  Opposite

namespace EventualSectionRecovery

open ProjGradedModuleSheaf GradedGlobalSections Ringed ProjTwist

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]
  {M σM : Type u} [AddCommGroup M] [Module A M] [SetLike σM M] [AddSubgroupClass σM M]
  (ℳ : ℤ → σM) [SetLike.GradedSMul 𝒜 ℳ]

/-! ### The section `m / 1` of `M(n)~` -/

omit [AddCommGroup M] [AddSubgroupClass σM M] [SetLike.GradedSMul 𝒜 ℳ] in
theorem mem_twist_zero {n : ℤ} {m : M} (hm : m ∈ ℳ n) :
    m ∈ gradedModuleTwist ℳ n ((0 : ℕ) : ℤ) := by
  change m ∈ ℳ (((0 : ℕ) : ℤ) + n)
  rwa [Nat.cast_zero, zero_add]

variable {ℳ} in
/-- The fraction `m / 1` in `M(n)_(x)` of an element `m ∈ M_n = M(n)_0`. -/
def constFraction (n : ℤ) (x : ProjectiveSpectrum 𝒜) {m : M} (hm : m ∈ ℳ n) :
    HomogeneousLocalizedModule 𝒜 (gradedModuleTwist ℳ n)
      x.asHomogeneousIdeal.toIdeal.primeCompl :=
  HomogeneousLocalizedModule.mk 0 m (mem_twist_zero ℳ hm) 1 SetLike.GradedOne.one_mem
    x.asHomogeneousIdeal.toIdeal.primeCompl.one_mem

theorem constFraction_val (n : ℤ) (x : ProjectiveSpectrum 𝒜) {m : M} (hm : m ∈ ℳ n) :
    (constFraction n x hm).val = LocalizedModule.mk m 1 := rfl

/-- The global section `x ↦ m / 1` of `M(n)~`, for `m ∈ M_n`. -/
def constSection (n : ℤ) {m : M} (hm : m ∈ ℳ n) :
    (projGradedModuleSheaf 𝒜 (gradedModuleTwist ℳ n)).val.obj (op ⊤) :=
  (⟨fun y => constFraction n y.1 hm, fun y =>
    ⟨⊤, y.2, 𝟙 _, 0, m, mem_twist_zero ℳ hm, 1, SetLike.GradedOne.one_mem,
      fun z => z.1.asHomogeneousIdeal.toIdeal.primeCompl.one_mem, fun _ => rfl⟩⟩ :
    (sheafInType 𝒜 (gradedModuleTwist ℳ n)).1.obj (op ⊤))

@[simp]
theorem constSection_apply (n : ℤ) {m : M} (hm : m ∈ ℳ n) (x : (⊤ : Opens (Proj 𝒜))) :
    ((constSection ℳ n hm : (sheafInType 𝒜 (gradedModuleTwist ℳ n)).1.obj (op ⊤)).1 x) =
      constFraction n x.1 hm := rfl

theorem constSection_add (n : ℤ) {m m' : M} (hm : m ∈ ℳ n) (hm' : m' ∈ ℳ n) :
    constSection (𝒜 := 𝒜) ℳ n (add_mem hm hm') = constSection ℳ n hm + constSection ℳ n hm' := by
  refine section_ext fun x => HomogeneousLocalizedModule.ext ?_
  change LocalizedModule.mk (m + m') 1 = LocalizedModule.mk m 1 + LocalizedModule.mk m' 1
  rw [LocalizedModule.mk_add_mk, one_smul, one_smul, mul_one]

/-! ### The degree-`n` component `M_n → Γ(X, M~(n))` -/

variable (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤)

/-- The section `α_n(m) ∈ Γ(X, M~(n))` of `m ∈ M_n`: the image of `m / 1 ∈ Γ(X, M(n)~)` under
`M(n)~ ≅ M~ ⊗ 𝒪_X(n)`. -/
def alphaSec (n : ℤ) {m : M} (hm : m ∈ ℳ n) : twistGlobal (projGradedModuleSheaf 𝒜 ℳ) n :=
  (twistIso ℳ hgen n).inv.val.app (op ⊤) (constSection ℳ n hm)

theorem twistIso_hom_alphaSec (n : ℤ) {m : M} (hm : m ∈ ℳ n) :
    (twistIso ℳ hgen n).hom.val.app (op ⊤) (alphaSec ℳ hgen n hm) = constSection ℳ n hm := by
  change ((twistIso ℳ hgen n).inv ≫ (twistIso ℳ hgen n).hom).val.app (op ⊤) _ = _
  rw [Iso.inv_hom_id]
  rfl

theorem alphaSec_eq_iff (n : ℤ) {m : M} (hm : m ∈ ℳ n)
    (t : twistGlobal (projGradedModuleSheaf 𝒜 ℳ) n) :
    alphaSec ℳ hgen n hm = t ↔ constSection ℳ n hm = (twistIso ℳ hgen n).hom.val.app (op ⊤) t := by
  constructor
  · rintro rfl
    exact (twistIso_hom_alphaSec ℳ hgen n hm).symm
  · intro h
    rw [alphaSec, h]
    change ((twistIso ℳ hgen n).hom ≫ (twistIso ℳ hgen n).inv).val.app (op ⊤) t = t
    rw [Iso.hom_inv_id]
    rfl

/-- **The degree-`n` component** `α_n : M_n → Γ(X, M~(n))` of Hartshorne's map
`α : M → Γ_*(M~)` (Exercise II.5.9(a)). -/
def alphaComponent (n : ℤ) : ℳ n →+ twistGlobal (projGradedModuleSheaf 𝒜 ℳ) n where
  toFun m := alphaSec ℳ hgen n m.2
  map_zero' := by
    rw [alphaSec_eq_iff, map_zero]
    exact section_ext fun x => HomogeneousLocalizedModule.ext (LocalizedModule.zero_mk 1)
  map_add' m m' := by
    rw [alphaSec_eq_iff, map_add, twistIso_hom_alphaSec, twistIso_hom_alphaSec]
    exact constSection_add (𝒜 := 𝒜) ℳ n m.2 m'.2

theorem alphaComponent_apply (n : ℤ) (m : ℳ n) :
    alphaComponent ℳ hgen n m = alphaSec ℳ hgen n m.2 := rfl

theorem of_alphaSec_congr {n n' : ℤ} (h : n = n') {m : M} (hm : m ∈ ℳ n) (hm' : m ∈ ℳ n') :
    DirectSum.of (fun k => twistGlobal (projGradedModuleSheaf 𝒜 ℳ) k) n (alphaSec ℳ hgen n hm) =
      DirectSum.of (fun k => twistGlobal (projGradedModuleSheaf 𝒜 ℳ) k) n'
        (alphaSec ℳ hgen n' hm') := by
  subst h
  rfl

/-! ### Multiplication by a homogeneous element -/

/-- Multiplication by `s ∈ S_e` as a graded map `M(n) → M(n + e)`. -/
def smulTwistMap (n : ℤ) (e : ℕ) (s : 𝒜 e) :
    projGradedModuleSheaf 𝒜 (gradedModuleTwist ℳ n) ⟶
      projGradedModuleSheaf 𝒜 (gradedModuleTwist ℳ (n + e)) :=
  projGradedModuleSheafMap ((s : A) • LinearMap.id) fun i m hm => by
    have := smul_mem_graded_nat 𝒜 ℳ s.2 hm
    change (s : A) • m ∈ ℳ (i + (n + e))
    convert this using 2
    ring

/-- Under `M~(n) ≅ M(n)~`, multiplication by `s / 1 ∈ Γ(X, 𝒪_X(e))` is multiplication by `s`. -/
theorem mulMap_twistIso_hom (n : ℤ) (e : ℕ) (s : 𝒜 e) :
    mulMap (projGradedModuleSheaf 𝒜 ℳ) n e s ≫ (twistIso ℳ hgen (n + e)).hom =
      (twistIso ℳ hgen n).hom ≫ smulTwistMap ℳ n e s := by
  apply tensor_hom_ext
  intro U f g
  change (twistIso ℳ hgen (n + e)).hom.val.app U
      ((mulMap (projGradedModuleSheaf 𝒜 ℳ) n e s).val.app U (tmulSection _ _ f g)) =
    (smulTwistMap ℳ n e s).val.app U ((twistIso ℳ hgen n).hom.val.app U (tmulSection _ _ f g))
  rw [mulMap_tmulSection, twistIso_hom_tmulSection, twistIso_hom_tmulSection]
  refine section_ext fun x => HomogeneousLocalizedModule.ext ?_
  rw [smulTwistMap, projGradedModuleSheafMap_app_apply, twistBilinear_apply, twistBilinear_apply,
    val_gradedLocMap, val_twistPair, val_twistPair, twistMulHom_tmul_twistSection_apply]
  generalize ((g : (sheafInType 𝒜 (gradedTwist 𝒜 n)).1.obj U).1 x).val = r
  generalize ((f : (sheafInType 𝒜 ℳ).1.obj U).1 x).val = v
  induction r using Localization.induction_on with
  | H p =>
    induction v using LocalizedModule.induction_on with
    | h m t =>
      rw [smul_assoc, LocalizedModule.mk_smul_mk, IsLocalizedModule.map_LocalizedModules,
        LocalizedModule.smul'_mk]
      rfl

theorem smulTwistMap_constSection (n : ℤ) (e : ℕ) (s : 𝒜 e) {m : M} (hm : m ∈ ℳ n)
    (hsm : (s : A) • m ∈ ℳ (n + e)) :
    (smulTwistMap ℳ n e s).val.app (op ⊤) (constSection ℳ n hm) = constSection ℳ (n + e) hsm := by
  refine section_ext fun x => HomogeneousLocalizedModule.ext ?_
  rw [smulTwistMap, projGradedModuleSheafMap_app_apply, val_gradedLocMap, constSection_apply,
    constSection_apply, constFraction_val, constFraction_val]
  exact IsLocalizedModule.map_LocalizedModules _ _ _ _

/-- `α` is compatible with multiplication by `s ∈ S_e`: `s · α_n(m) = α_{n + e}(s m)`. -/
theorem mulGlobal_alphaSec (n : ℤ) (e : ℕ) (s : 𝒜 e) {m : M} (hm : m ∈ ℳ n)
    (hsm : (s : A) • m ∈ ℳ (n + e)) :
    mulGlobal (projGradedModuleSheaf 𝒜 ℳ) n e s (alphaSec ℳ hgen n hm) =
      alphaSec ℳ hgen (n + e) hsm := by
  symm
  rw [alphaSec_eq_iff]
  calc constSection ℳ (n + e) hsm
      = (smulTwistMap ℳ n e s).val.app (op ⊤) (constSection ℳ n hm) :=
        (smulTwistMap_constSection ℳ n e s hm hsm).symm
    _ = (smulTwistMap ℳ n e s).val.app (op ⊤)
          ((twistIso ℳ hgen n).hom.val.app (op ⊤) (alphaSec ℳ hgen n hm)) := by
        rw [twistIso_hom_alphaSec]
    _ = ((twistIso ℳ hgen n).hom ≫ smulTwistMap ℳ n e s).val.app (op ⊤)
          (alphaSec ℳ hgen n hm) := rfl
    _ = (mulMap (projGradedModuleSheaf 𝒜 ℳ) n e s ≫ (twistIso ℳ hgen (n + e)).hom).val.app (op ⊤)
          (alphaSec ℳ hgen n hm) := by rw [mulMap_twistIso_hom]
    _ = _ := rfl

/-! ### The graded map `α : M → Γ_*(M~)` -/

section Alpha

variable [DirectSum.Decomposition ℳ]

/-- `α` as an additive map: on `M_n` it is `alphaComponent n` into the summand `Γ(X, M~(n))`. -/
def alphaAdd : M →+ GammaStar (projGradedModuleSheaf 𝒜 ℳ) :=
  (DirectSum.toAddMonoid fun n =>
      (DirectSum.of (fun k => twistGlobal (projGradedModuleSheaf 𝒜 ℳ) k) n).comp
        (alphaComponent ℳ hgen n)).comp
    (DirectSum.decomposeAddEquiv ℳ).toAddMonoidHom

theorem alphaAdd_of_mem {n : ℤ} {m : M} (hm : m ∈ ℳ n) :
    alphaAdd ℳ hgen m =
      DirectSum.of (fun k => twistGlobal (projGradedModuleSheaf 𝒜 ℳ) k) n (alphaSec ℳ hgen n hm) := by
  change DirectSum.toAddMonoid _ (DirectSum.decompose ℳ m) = _
  rw [DirectSum.decompose_of_mem ℳ hm, DirectSum.toAddMonoid_of]
  rfl

attribute [local instance] GradedGlobalSections.gammaStarModule

theorem alphaAdd_smul (s : A) (m : M) : alphaAdd ℳ hgen (s • m) = s • alphaAdd ℳ hgen m := by
  induction s using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => rw [zero_smul, zero_smul, map_zero]
  | add s s' hs hs' => rw [add_smul, map_add, hs, hs', add_smul]
  | @homogeneous e s =>
    induction m using DirectSum.Decomposition.inductionOn ℳ with
    | zero => rw [smul_zero, map_zero, smul_zero]
    | add m m' hm hm' => rw [smul_add, map_add, hm, hm', map_add, smul_add]
    | @homogeneous n m =>
      have hsm : (s : A) • (m : M) ∈ ℳ (n + e) := by
        have := smul_mem_graded_nat 𝒜 ℳ s.2 m.2
        rwa [add_comm] at this
      rw [alphaAdd_of_mem ℳ hgen m.2, alphaAdd_of_mem ℳ hgen hsm, smul_of _ s.2,
        ← mulGlobal_alphaSec ℳ hgen n e s m.2 hsm]

/-- **Hartshorne, Exercise II.5.9(a): the natural homomorphism `α : M → Γ_*(M~)`.** Let `S` be
generated by `S_1` as an `S_0`-algebra and `M` a graded `S`-module. For `m ∈ M_n`, `α(m)` is the
global section of `M~(n)` corresponding to the section `m / 1` of `M(n)~` under
`M(n)~ ≅ M~(n)`; `α` is `S`-linear (`alpha_of_mem`, `alpha_mem_gammaStarGrading` give the
grading). -/
def alpha : M →ₗ[A] GammaStar (projGradedModuleSheaf 𝒜 ℳ) where
  toFun := alphaAdd ℳ hgen
  map_add' := map_add _
  map_smul' := alphaAdd_smul ℳ hgen

theorem alpha_of_mem {n : ℤ} {m : M} (hm : m ∈ ℳ n) :
    alpha ℳ hgen m =
      DirectSum.of (fun k => twistGlobal (projGradedModuleSheaf 𝒜 ℳ) k) n
        (alphaComponent ℳ hgen n ⟨m, hm⟩) :=
  alphaAdd_of_mem ℳ hgen hm

/-- `α` is graded: it sends `M_n` into the summand `Γ(X, M~(n))` of `Γ_*(M~)`. -/
theorem alpha_mem_gammaStarGrading {n : ℤ} {m : M} (hm : m ∈ ℳ n) :
    alpha ℳ hgen m ∈ GammaStarReconstruction.gammaStarGrading (projGradedModuleSheaf 𝒜 ℳ) n := by
  rw [alpha_of_mem ℳ hgen hm]
  exact GammaStarReconstruction.of_mem_gammaStarGrading _ n _

end Alpha

/-! ### Naturality -/

section Naturality

/-- The map `Γ_*(F) → Γ_*(G)` of a morphism `φ : F ⟶ G`, summand-wise `Γ(X, φ ⊗ 𝒪_X(n))`. -/
def gammaStarMap {F G : (Proj 𝒜).Modules} (φ : F ⟶ G) : GammaStar F →+ GammaStar G :=
  DirectSum.toAddMonoid fun n =>
    (DirectSum.of (fun k => twistGlobal G k) n).comp
      ((φ ▷ projTwistingSheaf 𝒜 n).val.app (op ⊤)).hom.toAddMonoidHom

theorem gammaStarMap_of {F G : (Proj 𝒜).Modules} (φ : F ⟶ G) (n : ℤ) (t : twistGlobal F n) :
    gammaStarMap φ (DirectSum.of (fun k => twistGlobal F k) n t) =
      DirectSum.of (fun k => twistGlobal G k) n ((φ ▷ projTwistingSheaf 𝒜 n).val.app (op ⊤) t) :=
  DirectSum.toAddMonoid_of _ _ _

variable {ℳ} {N σN : Type u} [AddCommGroup N] [Module A N] [SetLike σN N] [AddSubgroupClass σN N]
  {𝒩 : ℤ → σN} [SetLike.GradedSMul 𝒜 𝒩]
  (g : M →ₗ[A] N) (hg : ∀ (i : ℤ) (m : M), m ∈ ℳ i → g m ∈ 𝒩 i)

theorem whiskerRight_alphaSec (n : ℤ) {m : M} (hm : m ∈ ℳ n) :
    (projGradedModuleSheafMap g hg ▷ projTwistingSheaf 𝒜 n).val.app (op ⊤)
        (alphaSec ℳ hgen n hm) = alphaSec 𝒩 hgen n (hg n m hm) := by
  symm
  rw [alphaSec_eq_iff]
  calc constSection 𝒩 n (hg n m hm)
      = (projGradedModuleSheafMap (ℳ := gradedModuleTwist ℳ n) (𝒩 := gradedModuleTwist 𝒩 n) g
          (fun i m hm => hg (i + n) m hm)).val.app (op ⊤) (constSection ℳ n hm) := by
        refine section_ext fun x => HomogeneousLocalizedModule.ext ?_
        rw [projGradedModuleSheafMap_app_apply, val_gradedLocMap, constSection_apply,
          constSection_apply, constFraction_val, constFraction_val]
        exact (IsLocalizedModule.map_LocalizedModules _ _ _ _).symm
    _ = (projGradedModuleSheafMap (ℳ := gradedModuleTwist ℳ n) (𝒩 := gradedModuleTwist 𝒩 n) g
          (fun i m hm => hg (i + n) m hm)).val.app (op ⊤)
          ((twistIso ℳ hgen n).hom.val.app (op ⊤) (alphaSec ℳ hgen n hm)) := by
        rw [twistIso_hom_alphaSec]
    _ = ((twistIso ℳ hgen n).hom ≫ projGradedModuleSheafMap (ℳ := gradedModuleTwist ℳ n)
          (𝒩 := gradedModuleTwist 𝒩 n) g (fun i m hm => hg (i + n) m hm)).val.app (op ⊤)
          (alphaSec ℳ hgen n hm) := rfl
    _ = ((projGradedModuleSheafMap g hg ▷ projTwistingSheaf 𝒜 n) ≫
          (twistIso 𝒩 hgen n).hom).val.app (op ⊤) (alphaSec ℳ hgen n hm) := by
        rw [twistIso_hom_naturality]
    _ = _ := rfl

variable [DirectSum.Decomposition ℳ] [DirectSum.Decomposition 𝒩]

/-- **Naturality of `α`** (Hartshorne, Exercise II.5.9(a)): for a degree-preserving linear map
`g : M → N` of graded modules, `Γ_*(g~) ∘ α_M = α_N ∘ g`. -/
theorem gammaStarMap_alpha (m : M) :
    gammaStarMap (projGradedModuleSheafMap g hg) (alpha ℳ hgen m) = alpha 𝒩 hgen (g m) := by
  induction m using DirectSum.Decomposition.inductionOn ℳ with
  | zero => rw [map_zero, map_zero, map_zero, map_zero]
  | add m m' hm hm' => rw [map_add, map_add, hm, hm', map_add, map_add]
  | @homogeneous n m =>
    rw [alpha_of_mem ℳ hgen m.2, alpha_of_mem 𝒩 hgen (hg n m m.2), gammaStarMap_of]
    exact congrArg _ (whiskerRight_alphaSec hgen g hg n m.2)

end Naturality

/-! ### Eventual bijectivity -/

section Eventual

/-- `m ↦ m / 1`, `M_n → Γ(X, M(n)~)`. Composed with `M(n)~ ≅ M~(n)` it is `alphaComponent n`. -/
def constHom (n : ℤ) :
    ℳ n →+ (projGradedModuleSheaf 𝒜 (gradedModuleTwist ℳ n)).val.obj (op ⊤) where
  toFun m := constSection ℳ n m.2
  map_zero' := section_ext fun _ => HomogeneousLocalizedModule.ext (LocalizedModule.zero_mk 1)
  map_add' m m' := constSection_add ℳ n m.2 m'.2

theorem bijective_alphaComponent_iff (n : ℤ) :
    Function.Bijective (alphaComponent ℳ hgen n) ↔ Function.Bijective (constHom (𝒜 := 𝒜) ℳ n) := by
  have h : ⇑(alphaComponent ℳ hgen n) =
      (twistIso ℳ hgen n).symm.hom.val.app (op ⊤) ∘ constHom (𝒜 := 𝒜) ℳ n := rfl
  rw [h]
  exact ⟨fun hb => (Function.Bijective.of_comp_iff' (GammaStarReconstruction.app_bijective_of_iso _ _) _).1 hb,
    fun hb => (GammaStarReconstruction.app_bijective_of_iso _ _).comp hb⟩

/-- `M_n → Γ(X, M(n)~)` is bijective for all large `n`. -/
def EventuallyBijective : Prop :=
  ∃ n₀ : ℤ, ∀ n ≥ n₀, Function.Bijective (constHom (𝒜 := 𝒜) ℳ n)

variable {ℳ}
variable {M' σM' : Type u} [AddCommGroup M'] [Module A M'] [SetLike σM' M']
  [AddSubgroupClass σM' M'] {ℳ' : ℤ → σM'} [SetLike.GradedSMul 𝒜 ℳ']
  {M'' σM'' : Type u} [AddCommGroup M''] [Module A M''] [SetLike σM'' M'']
  [AddSubgroupClass σM'' M''] {ℳ'' : ℤ → σM''} [SetLike.GradedSMul 𝒜 ℳ'']

theorem gradedMap_constSection (g : M' →ₗ[A] M) (hg : ∀ (i : ℤ) (m : M'), m ∈ ℳ' i → g m ∈ ℳ i)
    (n : ℤ) {m : M'} (hm : m ∈ ℳ' n) :
    (projGradedModuleSheafMap (ℳ := gradedModuleTwist ℳ' n) (𝒩 := gradedModuleTwist ℳ n) g
      (fun i m hm => hg (i + n) m hm)).val.app (op ⊤) (constSection (𝒜 := 𝒜) ℳ' n hm) =
      constSection ℳ n (hg n m hm) := by
  refine section_ext fun x => HomogeneousLocalizedModule.ext ?_
  rw [projGradedModuleSheafMap_app_apply, val_gradedLocMap, constSection_apply,
    constSection_apply, constFraction_val, constFraction_val]
  exact IsLocalizedModule.map_LocalizedModules _ _ _ _

private theorem gradedMap_app_injective (g : M' →ₗ[A] M)
    (hg : ∀ (i : ℤ) (m : M'), m ∈ ℳ' i → g m ∈ ℳ i) (hginj : Function.Injective g) :
    Function.Injective ((projGradedModuleSheafMap (𝒜 := 𝒜) g hg).val.app (op ⊤)) := by
  intro t t' htt'
  refine section_ext fun x => HomogeneousLocalizedModule.ext ?_
  have := congrArg (fun z : (projGradedModuleSheaf 𝒜 ℳ).val.obj (op ⊤) =>
    ((z : (sheafInType 𝒜 ℳ).1.obj (op ⊤)).1 x).val) htt'
  exact IsLocalizedModule.map_injective _ _ _ g hginj this

/-- A graded linear map commutes with taking homogeneous components. -/
private theorem decompose_map [DirectSum.Decomposition ℳ'] [DirectSum.Decomposition ℳ]
    (g : M' →ₗ[A] M) (hg : ∀ (i : ℤ) (m : M'), m ∈ ℳ' i → g m ∈ ℳ i) (m : M') (j : ℤ) :
    (DirectSum.decompose ℳ (g m) j : M) = g (DirectSum.decompose ℳ' m j) := by
  classical
  conv_lhs => rw [← DirectSum.sum_support_decompose ℳ' m]
  rw [map_sum, DirectSum.decompose_sum, DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum,
    Finset.sum_eq_single j]
  · exact DirectSum.decompose_of_mem_same ℳ (hg j _ (SetLike.coe_mem _))
  · intro b _ hb
    exact DirectSum.decompose_of_mem_ne ℳ (hg b _ (SetLike.coe_mem _)) hb
  · intro hj
    rw [DFinsupp.notMem_support_iff.1 hj]
    simp

private theorem pointwise_eq_zero {N σN : Type u} [AddCommGroup N] [Module A N] [SetLike σN N]
    [AddSubgroupClass σN N] {𝒩 : ℤ → σN} [SetLike.GradedSMul 𝒜 𝒩] (q : M →ₗ[A] N)
    (hq : ∀ (i : ℤ) (m : M), m ∈ ℳ i → q m ∈ 𝒩 i)
    {t : (projGradedModuleSheaf 𝒜 ℳ).val.obj (op ⊤)}
    (ht : (projGradedModuleSheafMap q hq).val.app (op ⊤) t = 0) :
    ∀ x, gradedLocMap q hq _ ((show (sheafInType 𝒜 ℳ).1.obj (op ⊤) from t).1 x) = 0 := fun x =>
  congrArg (fun z : (projGradedModuleSheaf 𝒜 𝒩).val.obj (op ⊤) =>
    (show (sheafInType 𝒜 𝒩).1.obj (op ⊤) from z).1 x) ht

variable [DirectSum.Decomposition ℳ'] [DirectSum.Decomposition ℳ] [DirectSum.Decomposition ℳ'']

/-- **Eventual bijectivity through a short exact sequence.** If `0 → M' → M → M'' → 0` is exact
and `M' → Γ_*`, `M'' → Γ_*` are eventually bijective, so is `M → Γ_*`: the bottom row
`0 → Γ(M'(n)~) → Γ(M(n)~) → Γ(M''(n)~)` is left exact. -/
theorem eventuallyBijective_of_exact (g : M' →ₗ[A] M)
    (hg : ∀ (i : ℤ) (m : M'), m ∈ ℳ' i → g m ∈ ℳ i) (q : M →ₗ[A] M'')
    (hq : ∀ (i : ℤ) (m : M), m ∈ ℳ i → q m ∈ ℳ'' i) (hginj : Function.Injective g)
    (hqsurj : Function.Surjective q) (hexact : ∀ m, q m = 0 → ∃ m', g m' = m)
    (h' : EventuallyBijective (𝒜 := 𝒜) ℳ') (h'' : EventuallyBijective (𝒜 := 𝒜) ℳ'') :
    EventuallyBijective (𝒜 := 𝒜) ℳ := by
  obtain ⟨n₁, hn₁⟩ := h'
  obtain ⟨n₂, hn₂⟩ := h''
  refine ⟨max n₁ n₂, fun n hn => ?_⟩
  obtain ⟨inj', surj'⟩ := hn₁ n (le_of_max_le_left hn)
  obtain ⟨inj'', surj''⟩ := hn₂ n (le_of_max_le_right hn)
  have hgn : ∀ (i : ℤ) (m : M'), m ∈ gradedModuleTwist ℳ' n i → g m ∈ gradedModuleTwist ℳ n i :=
    fun i m hm => hg (i + n) m hm
  have hqn : ∀ (i : ℤ) (m : M), m ∈ gradedModuleTwist ℳ n i → q m ∈ gradedModuleTwist ℳ'' n i :=
    fun i m hm => hq (i + n) m hm
  set G := projGradedModuleSheafMap (𝒜 := 𝒜) g hgn
  set Q := projGradedModuleSheafMap (𝒜 := 𝒜) q hqn
  have hG : ∀ m : ℳ' n, G.val.app (op ⊤) (constHom ℳ' n m) = constHom ℳ n ⟨g m, hg n m m.2⟩ :=
    fun m => gradedMap_constSection g hg n m.2
  have hQ : ∀ m : ℳ n, Q.val.app (op ⊤) (constHom ℳ n m) = constHom ℳ'' n ⟨q m, hq n m m.2⟩ :=
    fun m => gradedMap_constSection q hq n m.2
  -- homogeneous preimages under `g`
  have hpre : ∀ m : ℳ n, q m = 0 → ∃ m' : ℳ' n, g m' = m := by
    intro m hm
    obtain ⟨m₁, hm₁⟩ := hexact m hm
    refine ⟨DirectSum.decompose ℳ' m₁ n, ?_⟩
    rw [← decompose_map g hg, hm₁]
    exact DirectSum.decompose_of_mem_same ℳ m.2
  refine ⟨(injective_iff_map_eq_zero _).2 fun m hm => ?_, fun t => ?_⟩
  · have hqm : q m = 0 := by
      have := hQ m
      rw [hm, map_zero] at this
      have h0 := inj'' (this.symm.trans (map_zero _).symm)
      exact congrArg Subtype.val h0
    obtain ⟨m', hm'⟩ := hpre m hqm
    have hc : constHom (𝒜 := 𝒜) ℳ' n m' = 0 := by
      refine gradedMap_app_injective g hgn hginj ?_
      change G.val.app (op ⊤) _ = G.val.app (op ⊤) 0
      rw [hG, map_zero, ← hm]
      congr 1
      exact Subtype.ext hm'
    rw [← map_zero (constHom (𝒜 := 𝒜) ℳ' n)] at hc
    have := inj' hc
    apply Subtype.ext
    rw [← hm', this]
    simp
  · obtain ⟨m'', hm''⟩ := surj'' (Q.val.app (op ⊤) t)
    obtain ⟨m₀, hm₀⟩ := hqsurj m''
    set m : ℳ n := DirectSum.decompose ℳ m₀ n
    have hqm : (⟨q m, hq n m m.2⟩ : ℳ'' n) = m'' := by
      apply Subtype.ext
      change q (DirectSum.decompose ℳ m₀ n : M) = m''
      rw [← decompose_map q hq, hm₀]
      exact DirectSum.decompose_of_mem_same ℳ'' m''.2
    have hker : Q.val.app (op ⊤) (t - constHom ℳ n m) = 0 := by
      rw [map_sub, hQ, hqm, hm'', sub_self]
    obtain ⟨t', ht'⟩ := ProjectiveGlobalSectionsFinite.exists_sections_of_gradedLocMap_eq_zero
      g hgn q hqn hginj hexact _ (pointwise_eq_zero q hqn hker)
    obtain ⟨m', hm'⟩ := surj' t'
    refine ⟨m + ⟨g m', hg n m' m'.2⟩, ?_⟩
    rw [map_add, ← hG, hm']
    have : G.val.app (op ⊤) t' = t - constHom ℳ n m := Subtype.ext (funext ht')
    rw [this, add_sub_cancel]

/-- **Eventual bijectivity along a graded linear bijection.** -/
theorem eventuallyBijective_of_bijective (g : M' →ₗ[A] M)
    (hg : ∀ (i : ℤ) (m : M'), m ∈ ℳ' i ↔ g m ∈ ℳ i) (hgbij : Function.Bijective g)
    (h' : EventuallyBijective (𝒜 := 𝒜) ℳ') : EventuallyBijective (𝒜 := 𝒜) ℳ := by
  obtain ⟨n₁, hn₁⟩ := h'
  refine ⟨n₁, fun n hn => ?_⟩
  obtain ⟨inj', surj'⟩ := hn₁ n hn
  have hgn : ∀ (i : ℤ) (m : M'), m ∈ gradedModuleTwist ℳ' n i → g m ∈ gradedModuleTwist ℳ n i :=
    fun i m hm => (hg (i + n) m).1 hm
  set G := projGradedModuleSheafMap (𝒜 := 𝒜) g hgn
  have hG : ∀ m : ℳ' n, G.val.app (op ⊤) (constHom ℳ' n m) =
      constHom ℳ n ⟨g m, (hg n m).1 m.2⟩ :=
    fun m => gradedMap_constSection g (fun i m => (hg i m).1) n m.2
  have hpre : ∀ m : ℳ n, ∃ m' : ℳ' n, g m' = m := by
    intro m
    obtain ⟨m', hm'⟩ := hgbij.2 m
    exact ⟨⟨m', (hg n m').2 (hm' ▸ m.2)⟩, hm'⟩
  refine ⟨(injective_iff_map_eq_zero _).2 fun m hm => ?_, fun t => ?_⟩
  · obtain ⟨m', hm'⟩ := hpre m
    have hc : constHom (𝒜 := 𝒜) ℳ' n m' = 0 := by
      refine gradedMap_app_injective g hgn hgbij.1 ?_
      change G.val.app (op ⊤) _ = G.val.app (op ⊤) 0
      rw [hG, map_zero, ← hm]
      congr 1
      exact Subtype.ext hm'
    rw [← map_zero (constHom (𝒜 := 𝒜) ℳ' n)] at hc
    have := inj' hc
    apply Subtype.ext
    rw [← hm', this]
    simp
  · have hq : ∀ (i : ℤ) (m : M), m ∈ gradedModuleTwist ℳ n i →
        (0 : M →ₗ[A] M) m ∈ gradedModuleTwist ℳ n i := fun i m _ => zero_mem _
    obtain ⟨t', ht'⟩ := ProjectiveGlobalSectionsFinite.exists_sections_of_gradedLocMap_eq_zero
      (ℳ'' := gradedModuleTwist ℳ n) g hgn 0 hq hgbij.1 (fun m _ => hgbij.2 m) t
      (fun x => by
        apply HomogeneousLocalizedModule.ext
        rw [val_gradedLocMap, map_zero, LinearMap.zero_apply]
        rfl)
    obtain ⟨m', hm'⟩ := surj' t'
    refine ⟨⟨g m', (hg n m').1 m'.2⟩, ?_⟩
    rw [← hG, hm']
    exact Subtype.ext (funext ht')

end Eventual

/-! ### Reduction to the factors `(S/𝔭)(l)` of a graded prime filtration -/

section Filtration

open ProjectiveGlobalSectionsFinite ProjectiveSectionRing

attribute [local instance] gradedSMul_of_intGrading

variable {ℳ} [DirectSum.Decomposition ℳ]

/-- **Reduction to the prime factors** (as in Hartshorne's proof of Theorem 5.19). Let `S` be
Noetherian and `M` a finitely generated graded `S`-module. If `M → Γ_*` is eventually bijective for
every factor `(S/𝔭)(l)`, `𝔭` a homogeneous prime, then it is eventually bijective for `M`. -/
theorem eventuallyBijective_of_primeFactors [IsNoetherianRing A] [Module.Finite A M]
    (hfac : ∀ (p : PrimeSpectrum A) (hp : p.1.IsHomogeneous (intGrading 𝒜)) (l : ℤ),
      EventuallyBijective (𝒜 := 𝒜) (primeFactor 𝒜 p hp l)) :
    EventuallyBijective (𝒜 := 𝒜) ℳ := by
  classical
  obtain ⟨s, hhead, hlast⟩ := exists_gradedPrimeFiltration (intGrading 𝒜) (intModuleGrading ℳ)
  let P : HomogeneousSubmodule (intGrading 𝒜) (intModuleGrading ℳ) → Prop := fun N =>
    EventuallyBijective (𝒜 := 𝒜) (gradedSubmodulePiece (intGrading 𝒜) (intModuleGrading ℳ) N)
  have hbot : P ⊥ := by
    have h0 : Subsingleton (⊥ : HomogeneousSubmodule (intGrading 𝒜) (intModuleGrading ℳ)) :=
      ⟨fun a b => Subtype.ext (((Submodule.mem_bot A).1 a.2).trans
        ((Submodule.mem_bot A).1 b.2).symm)⟩
    have : ∀ T : Submonoid A, Subsingleton (LocalizedModule T
        (⊥ : HomogeneousSubmodule (intGrading 𝒜) (intModuleGrading ℳ))) := fun T =>
      ⟨fun a b => by
        induction a using LocalizedModule.induction_on with | h m t =>
        induction b using LocalizedModule.induction_on with | h m' t' =>
        rw [Subsingleton.elim m 0, Subsingleton.elim m' 0, LocalizedModule.zero_mk,
          LocalizedModule.zero_mk]⟩
    refine ⟨0, fun n _ => ⟨fun a b _ => Subtype.ext (Subsingleton.elim _ _), fun t => ⟨0, ?_⟩⟩⟩
    exact globalValue_injective 𝒜 _ (funext fun x =>
      HomogeneousLocalizedModule.ext (Subsingleton.elim _ _))
  have hstep : ∀ N₁ N₂, IsGradedPrimeFiltrationStep (intGrading 𝒜) (intModuleGrading ℳ) N₁ N₂ →
      P N₁ → P N₂ := by
    rintro N₁ N₂ ⟨h, p, hp, l, ⟨e⟩⟩ hN₁
    let g : N₁ →ₗ[A] N₂ :=
      { toFun := fun m => ⟨m.1, h m.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    let q := e.toLinearEquiv.symm.toLinearMap ∘ₗ (gradedSubmoduleOf _ _ N₁ N₂ h).toSubmodule.mkQ
    refine eventuallyBijective_of_exact (ℳ' := gradedSubmodulePiece _ _ N₁)
      (ℳ := gradedSubmodulePiece _ _ N₂) (ℳ'' := primeFactor 𝒜 p hp l) g
      (fun _ _ hm => hm) q (fun i m hm => ?_)
      (fun a b hab => Subtype.ext (congrArg (fun z : N₂ => (z : M)) hab))
      (e.toLinearEquiv.symm.surjective.comp (Submodule.mkQ_surjective _)) (fun m hm => ?_)
      hN₁ (hfac p hp l)
    · obtain ⟨x, hx, hxe⟩ := (Set.ext_iff.1 (e.map_piece i)
        ((gradedSubmoduleOf _ _ N₁ N₂ h).toSubmodule.mkQ m)).2 ⟨m, hm, rfl⟩
      change e.toLinearEquiv.symm _ ∈ _
      rw [← hxe]
      simpa using hx
    · have hm' : (gradedSubmoduleOf _ _ N₁ N₂ h).toSubmodule.mkQ m = 0 :=
        e.toLinearEquiv.symm.injective (hm.trans (map_zero _).symm)
      have hmem : m ∈ (gradedSubmoduleOf _ _ N₁ N₂ h).toSubmodule :=
        (Submodule.Quotient.mk_eq_zero (gradedSubmoduleOf _ _ N₁ N₂ h).toSubmodule).1 hm'
      exact ⟨⟨m.1, hmem⟩, rfl⟩
  have hall : ∀ i, P (s i) := by
    intro i
    induction i using Fin.induction with
    | zero =>
      change P s.head
      rw [hhead]
      exact hbot
    | succ i ih => exact hstep _ _ (s.step i) ih
  have htop : P ⊤ := hlast ▸ hall (Fin.last _)
  let ι : (⊤ : HomogeneousSubmodule (intGrading 𝒜) (intModuleGrading ℳ)) →ₗ[A] M :=
    { toFun := fun m => m.1
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  exact eventuallyBijective_of_bijective
    (ℳ' := gradedSubmodulePiece (intGrading 𝒜) (intModuleGrading ℳ) ⊤) (ℳ := ℳ) ι
    (fun _ _ => Iff.rfl) ⟨fun a b hab => Subtype.ext hab,
      fun m => ⟨⟨m, show m ∈ (⊤ : Submodule A M) from Submodule.mem_top⟩, rfl⟩⟩ htop

end Filtration

/-! ### A uniform degree bound for the chart condition

The private helpers below are copied from `Hartshorne.Scheme.ProjectiveGlobalSectionsFinite`
(the proof of Theorem 5.19), where they are private. -/

section Bound

open ProjectiveGlobalSectionsFinite ProjectiveSectionRing

variable {ι : Type*}

/-! ### Monomials in degree-one generators -/

private theorem prod_pow_mem {f : ι → A} (hf : ∀ i, f i ∈ 𝒜 1) (β : ι →₀ ℕ) :
    (β.prod fun i e => f i ^ e) ∈ 𝒜 β.degree := by
  rw [Finsupp.prod, Finsupp.degree_apply]
  exact SetLike.prod_mem_graded 𝒜 (fun i => β i) (fun i => f i ^ β i) fun i _ => by
    simpa using SetLike.pow_mem_graded (β i) (hf i)

/-- If `fᵢ^{jᵢ} z = aᵢ ∈ S_{jᵢ + n}` for every `i`, then `z` times a monomial of degree `d ≥ ∑ jᵢ`
in the `fᵢ` lies in `S_{d + n}`. -/
private theorem exists_mem_mul_monomial [Fintype ι] [Nonempty ι] {f : ι → A}
    (hf : ∀ i, f i ∈ 𝒜 1) {n : ℕ} {z : FractionRing A} {j : ι → ℕ} {a : ι → A}
    (ha : ∀ i, a i ∈ 𝒜 (j i + n))
    (hza : ∀ i, algebraMap A (FractionRing A) (a i) =
      algebraMap A (FractionRing A) (f i) ^ j i * z)
    {d : ℕ} (hd : ∑ i, j i ≤ d) (β : ι →₀ ℕ) (hβd : β.degree = d) :
    ∃ b ∈ 𝒜 (d + n), algebraMap A (FractionRing A) b =
      z * algebraMap A (FractionRing A) (β.prod fun i e => f i ^ e) := by
  obtain ⟨i, hi⟩ : ∃ i, j i ≤ β i := by
    by_contra! hlt
    have : ∑ i, β i < ∑ i, j i :=
      Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty fun i _ => hlt i
    rw [← Finsupp.degree_eq_sum, hβd] at this
    omega
  set β' := β - Finsupp.single i (j i) with hβ'
  have hβ : β = Finsupp.single i (j i) + β' := by
    rw [hβ', add_tsub_cancel_of_le]
    exact Finsupp.single_le_iff.2 hi
  have hdeg : d = j i + β'.degree := by
    rw [← hβd, hβ, map_add, Finsupp.degree_single]
  have hprod : (β.prod fun i e => f i ^ e) = f i ^ j i * β'.prod fun i e => f i ^ e := by
    rw [hβ, Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)]
    congr 1
    exact Finsupp.prod_single_index (pow_zero _)
  refine ⟨a i * β'.prod fun i e => f i ^ e, ?_, ?_⟩
  · have := SetLike.mul_mem_graded (ha i) (prod_pow_mem hf β')
    rwa [show j i + n + β'.degree = d + n by omega] at this
  · rw [hprod, map_mul, map_mul, hza i, map_pow]
    ring

/-- If `fᵢ^{jᵢ} z = aᵢ ∈ S_{jᵢ + n}` for every `i`, and the `fᵢ ∈ S₁` generate `S` over `S₀`, then
`z · S_d ⊆ S_{d + n}` once `d ≥ ∑ jᵢ`. -/
private theorem exists_mem_mul_of_le [Fintype ι] [Nonempty ι] {f : ι → A}
    (hf : ∀ i, f i ∈ 𝒜 1) (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤)
    {n : ℕ} {z : FractionRing A} {j : ι → ℕ} {a : ι → A}
    (ha : ∀ i, a i ∈ 𝒜 (j i + n))
    (hza : ∀ i, algebraMap A (FractionRing A) (a i) =
      algebraMap A (FractionRing A) (f i) ^ j i * z)
    {d : ℕ} (hd : ∑ i, j i ≤ d) {g : A} (hg : g ∈ 𝒜 d) :
    ∃ b ∈ 𝒜 (d + n), algebraMap A (FractionRing A) b = z * algebraMap A (FractionRing A) g := by
  classical
  have hmono := fun β hβ => exists_mem_mul_monomial hf ha hza hd β hβ
  choose! b hb hbz using hmono
  obtain ⟨P, rfl⟩ : ∃ P : MvPolynomial ι (𝒜 0), MvPolynomial.aeval f P = g := by
    have : g ∈ Algebra.adjoin (𝒜 0) (Set.range f) := hgen ▸ Algebra.mem_top
    rw [Algebra.adjoin_range_eq_range_aeval] at this
    exact this
  have hmem : ∀ β : ι →₀ ℕ, ((P.coeff β).1 * β.prod fun i e => f i ^ e) ∈ 𝒜 β.degree := by
    intro β
    have := SetLike.mul_mem_graded (P.coeff β).2 (prod_pow_mem hf β)
    rwa [zero_add] at this
  have h1 : MvPolynomial.aeval f P =
      ∑ β ∈ P.support, (P.coeff β).1 * β.prod fun i e => f i ^ e := by
    conv_lhs => rw [P.as_sum]
    rw [map_sum]
    refine Finset.sum_congr rfl fun β _ => ?_
    rw [MvPolynomial.aeval_monomial]
    rfl
  have hexp : MvPolynomial.aeval f P =
      ∑ β ∈ P.support with β.degree = d, (P.coeff β).1 * β.prod fun i e => f i ^ e := by
    calc MvPolynomial.aeval f P
        = (DirectSum.decompose 𝒜 (MvPolynomial.aeval f P) d : A) :=
          (DirectSum.decompose_of_mem_same 𝒜 hg).symm
      _ = ∑ β ∈ P.support,
          (DirectSum.decompose 𝒜 ((P.coeff β).1 * β.prod fun i e => f i ^ e) d : A) := by
          rw [h1, DirectSum.decompose_sum, DFinsupp.finsetSum_apply,
            AddSubmonoidClass.coe_finsetSum]
      _ = _ := by
          rw [Finset.sum_filter]
          refine Finset.sum_congr rfl fun β _ => ?_
          split_ifs with h
          · exact DirectSum.decompose_of_mem_same 𝒜 (h ▸ hmem β)
          · exact DirectSum.decompose_of_mem_ne 𝒜 (hmem β) h
  refine ⟨∑ β ∈ P.support with β.degree = d, (P.coeff β).1 * b β, ?_, ?_⟩
  · refine sum_mem fun β hβ => ?_
    have := SetLike.mul_mem_graded (P.coeff β).2 (hb β (Finset.mem_filter.1 hβ).2)
    rwa [zero_add] at this
  · rw [hexp, map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun β hβ => ?_
    rw [map_mul, map_mul, hbz β (Finset.mem_filter.1 hβ).2]
    ring

/-! ### The chart condition and integrality -/

omit [GradedRing 𝒜] in
private theorem chartCond_choose {f : ι → A} {n : ℕ} {z : FractionRing A}
    (hz : ChartCond 𝒜 f n z) :
    ∃ (j : ι → ℕ) (a : ι → A), (∀ i, a i ∈ 𝒜 (j i + n)) ∧
      ∀ i, algebraMap A (FractionRing A) (a i) = algebraMap A (FractionRing A) (f i) ^ j i * z := by
  classical
  have h : ∀ i, ∃ (j : ℕ) (a : A), a ∈ 𝒜 (j + n) ∧
      algebraMap A (FractionRing A) a = algebraMap A (FractionRing A) (f i) ^ j * z := by
    intro i
    by_cases hi : f i = 0
    · exact ⟨1, 0, zero_mem _, by rw [hi, map_zero, zero_pow one_ne_zero, zero_mul]⟩
    · exact hz i hi
  choose j a ha hza using h
  exact ⟨j, a, ha, hza⟩

/-- **The determinant trick.** An element `z ∈ K` satisfying the chart condition is integral over
`S`: it multiplies the nonzero finitely generated ideal `S_{≥ ∑ jᵢ}` into itself. -/
private theorem isIntegral_of_chartCond [Fintype ι] [IsDomain A] [IsNoetherianRing A]
    {f : ι → A} (hf : ∀ i, f i ∈ 𝒜 1) (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤)
    (hne : ∃ i, f i ≠ 0) {n : ℕ} {z : FractionRing A} (hz : ChartCond 𝒜 f n z) :
    IsIntegral A z := by
  obtain ⟨j, a, ha, hza⟩ := chartCond_choose hz
  obtain ⟨i₀, hi₀⟩ := hne
  have : Nonempty ι := ⟨i₀⟩
  set N := ∑ i, j i
  let G : Set A := {g | ∃ d, N ≤ d ∧ g ∈ 𝒜 d}
  let M : Submodule A (FractionRing A) :=
    Submodule.span A (algebraMap A (FractionRing A) '' G)
  have hMfg : M.FG := by
    have h1 : (Submodule.span A G).FG := IsNoetherian.noetherian _
    have h2 := h1.map (Algebra.linearMap A (FractionRing A))
    rwa [Submodule.map_span] at h2
  have hM0 : M ≠ ⊥ := by
    intro hM
    have hmem : algebraMap A (FractionRing A) (f i₀ ^ N) ∈ M :=
      Submodule.subset_span ⟨_, ⟨N, le_rfl, by
        simpa using SetLike.pow_mem_graded N (hf i₀)⟩, rfl⟩
    rw [hM, Submodule.mem_bot,
      map_eq_zero_iff _ (IsFractionRing.injective A (FractionRing A))] at hmem
    exact pow_ne_zero N hi₀ hmem
  refine isIntegral_of_smul_mem_submodule M hM0 hMfg z fun w hw => ?_
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨g, ⟨d, hd, hg⟩, rfl⟩ := hw
    obtain ⟨b, hb, hbz⟩ := exists_mem_mul_of_le hf hgen ha hza hd hg
    rw [smul_eq_mul, ← hbz]
    exact Submodule.subset_span ⟨b, ⟨d + n, by omega, hb⟩, rfl⟩
  | zero => simp
  | add w w' _ _ hw hw' =>
    rw [smul_add]
    exact add_mem hw hw'
  | smul c w _ hw =>
    rw [smul_comm]
    exact M.smul_mem c hw

/-! ### Homogeneous fractions -/

section HomFrac

variable [IsDomain A]

private theorem isHomFrac_zero (n : ℕ) : IsHomFrac (𝒜 := 𝒜) n 0 :=
  ⟨0, 0, 1, zero_mem _, SetLike.GradedOne.one_mem, one_ne_zero, by simp⟩

private theorem isHomFrac_add {n : ℕ} {z w : FractionRing A} (hz : IsHomFrac (𝒜 := 𝒜) n z)
    (hw : IsHomFrac (𝒜 := 𝒜) n w) : IsHomFrac (𝒜 := 𝒜) n (z + w) := by
  have := hz.sub ((isHomFrac_zero n).sub hw)
  rwa [zero_sub, sub_neg_eq_add] at this

private theorem isHomFrac_smul {n e : ℕ} {z : FractionRing A} (hz : IsHomFrac (𝒜 := 𝒜) n z)
    {c : A} (hc : c ∈ 𝒜 e) : IsHomFrac (𝒜 := 𝒜) (n + e) (c • z) := by
  obtain ⟨e', a, s, ha, hs, hs0, rfl⟩ := hz
  refine ⟨e', c * a, s, ?_, hs, hs0, ?_⟩
  · have := SetLike.mul_mem_graded hc ha
    rwa [show e + (e' + n) = e' + (n + e) by ring] at this
  · rw [Algebra.smul_def, map_mul, mul_div_assoc]

private theorem isHomFrac_of_chartCond {f : ι → A} (hf : ∀ i, f i ∈ 𝒜 1) {n : ℕ}
    {z : FractionRing A} (hz : ChartCond 𝒜 f n z) {i : ι} (hi : f i ≠ 0) :
    IsHomFrac (𝒜 := 𝒜) n z := by
  obtain ⟨j, a, ha, hza⟩ := hz i hi
  have h0 : algebraMap A (FractionRing A) (f i ^ j) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).2 (pow_ne_zero j hi)
  refine ⟨j, a, f i ^ j, ha, by simpa using SetLike.pow_mem_graded j (hf i), pow_ne_zero j hi, ?_⟩
  rw [eq_div_iff h0, hza, map_pow, mul_comm]


end HomFrac

/-- **A uniform degree bound.** Let `S` be a Noetherian graded domain, generated over `S₀` by
finitely many `fᵢ ∈ S₁`, not all zero, whose integral closure in `K` is a finite `S`-module. Then
there is `N` such that every `z ∈ K` satisfying the chart condition in a degree `n ≥ N` lies in
`S_n`. The span of all elements satisfying a chart condition is finitely generated (it lies in the
integral closure); a generator `g` of degree `n_g` multiplies `S_d` into `S_{d + n_g}` for
`d ≥ D_g`, and comparing homogeneous components of `z = ∑ c_g g` gives `z ∈ S_n` once
`n ≥ ∑ (n_g + D_g)`. -/
theorem exists_bound_of_chartCond [Fintype ι] [IsDomain A] [IsNoetherianRing A]
    (hfin : Module.Finite A (integralClosure A (FractionRing A)))
    {f : ι → A} (hf : ∀ i, f i ∈ 𝒜 1) (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤)
    (hne : ∃ i, f i ≠ 0) :
    ∃ N : ℕ, ∀ n ≥ N, ∀ z, ChartCond 𝒜 f n z →
      ∃ b ∈ 𝒜 n, algebraMap A (FractionRing A) b = z := by
  classical
  obtain ⟨i₀, hi₀⟩ := hne
  let V : Set (FractionRing A) := {z | ∃ n, ChartCond 𝒜 f n z}
  have hle : Submodule.span A V ≤ Subalgebra.toSubmodule (integralClosure A (FractionRing A)) := by
    rw [Submodule.span_le]
    rintro z ⟨n, hz⟩
    exact isIntegral_of_chartCond hf hgen ⟨i₀, hi₀⟩ hz
  have hfg : (Submodule.span A V).FG := Submodule.FG.of_le (Module.Finite.iff_fg.1 hfin) hle
  obtain ⟨G, hGV, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset V).1 hfg
  have hG : ∀ g ∈ G, ∃ (n D : ℕ), ChartCond 𝒜 f n g ∧ ∀ d, D ≤ d → ∀ c ∈ 𝒜 d,
      ∃ b ∈ 𝒜 (d + n), algebraMap A (FractionRing A) b = g * algebraMap A (FractionRing A) c := by
    intro g hg
    obtain ⟨n, hn⟩ := hGV hg
    obtain ⟨j, a, ha, hza⟩ := chartCond_choose hn
    have : Nonempty ι := ⟨i₀⟩
    exact ⟨n, ∑ i, j i, hn, fun d hd c hc => exists_mem_mul_of_le hf hgen ha hza hd hc⟩
  choose! deg D hcc hD using hG
  refine ⟨∑ g ∈ G, (deg g + D g), fun n hn z hz => ?_⟩
  have hbound : ∀ g ∈ G, deg g + D g ≤ n := fun g hg =>
    le_trans (Finset.single_le_sum (f := fun g => deg g + D g) (fun _ _ => Nat.zero_le _) hg) hn
  have hzG : z ∈ Submodule.span A (G : Set (FractionRing A)) :=
    hspan ▸ Submodule.subset_span ⟨n, hz⟩
  obtain ⟨c, -, hcz⟩ := Submodule.mem_span_finset.1 hzG
  -- the components of the coefficients
  let comp : FractionRing A → ℕ → A := fun g m =>
    if deg g ≤ m then (DirectSum.decompose 𝒜 (c g) (m - deg g) : A) else 0
  have hcomp_mem : ∀ g ∈ G, ∀ m, IsHomFrac (𝒜 := 𝒜) m (comp g m • g) := by
    intro g hg m
    by_cases hm : deg g ≤ m
    · have h1 := isHomFrac_smul (isHomFrac_of_chartCond hf (hcc g hg) hi₀)
        (SetLike.coe_mem (DirectSum.decompose 𝒜 (c g) (m - deg g)))
      rw [show deg g + (m - deg g) = m by omega] at h1
      simpa [comp, hm] using h1
    · simpa [comp, hm] using isHomFrac_zero (𝒜 := 𝒜) m
  let E : Finset ℕ := insert n (G.biUnion fun g =>
    (DirectSum.decompose 𝒜 (c g)).support.image (· + deg g))
  let u : ℕ → FractionRing A := fun m =>
    (∑ g ∈ G, comp g m • g) - if m = n then z else 0
  have hu : ∀ m ∈ E, IsHomFrac (𝒜 := 𝒜) m (u m) := by
    intro m _
    refine IsHomFrac.sub (Finset.sum_induction _ (IsHomFrac (𝒜 := 𝒜) m)
      (fun _ _ => isHomFrac_add) (isHomFrac_zero _) fun g hg => hcomp_mem g hg m) ?_
    split_ifs with h
    · rw [h]
      exact isHomFrac_of_chartCond hf hz hi₀
    · exact isHomFrac_zero _
  have hsum_g : ∀ g ∈ G, ∑ m ∈ E, comp g m = c g := by
    intro g hg
    have hsub : (DirectSum.decompose 𝒜 (c g)).support.image (· + deg g) ⊆ E := fun m hm =>
      Finset.mem_insert_of_mem (Finset.mem_biUnion.2 ⟨g, hg, hm⟩)
    rw [← Finset.sum_subset hsub, Finset.sum_image (fun _ _ _ _ h => Nat.add_right_cancel h)]
    · conv_rhs => rw [← DirectSum.sum_support_decompose 𝒜 (c g)]
      refine Finset.sum_congr rfl fun e _ => ?_
      simp only [comp, if_pos (Nat.le_add_left (deg g) e)]
      rw [Nat.add_sub_cancel]
    · intro m _ hm
      simp only [comp]
      split_ifs with h
      · have : m - deg g ∉ (DirectSum.decompose 𝒜 (c g)).support := fun h' =>
          hm (Finset.mem_image.2 ⟨m - deg g, h', by omega⟩)
        rw [DFinsupp.notMem_support_iff.1 this]
        rfl
      · rfl
  have hsum : ∑ m ∈ E, u m = 0 := by
    simp only [u, Finset.sum_sub_distrib]
    rw [Finset.sum_comm, Finset.sum_ite_eq' E n (fun _ => z), if_pos (Finset.mem_insert_self _ _),
      sub_eq_zero, ← hcz]
    refine Finset.sum_congr rfl fun g hg => ?_
    rw [← Finset.sum_smul, hsum_g g hg]
  have h0 := eq_zero_of_sum_isHomFrac_eq_zero E u hu hsum n (Finset.mem_insert_self _ _)
  replace h0 : ∑ g ∈ G, comp g n • g = z := by simpa [u, sub_eq_zero] using h0
  -- each term of the degree-`n` part lies in `S_n`
  have hterm : ∀ g ∈ G, ∃ b ∈ 𝒜 n, algebraMap A (FractionRing A) b = comp g n • g := by
    intro g hg
    have hle' : deg g ≤ n := by have := hbound g hg; omega
    obtain ⟨b, hb, hbe⟩ := hD g hg (n - deg g) (by have := hbound g hg; omega) _
      (SetLike.coe_mem (DirectSum.decompose 𝒜 (c g) (n - deg g)))
    refine ⟨b, by rwa [show n - deg g + deg g = n by omega] at hb, ?_⟩
    rw [hbe, Algebra.smul_def, mul_comm]
    simp [comp, hle']
  choose! b hb hbe using hterm
  exact ⟨∑ g ∈ G, b g, sum_mem hb, by rw [map_sum, ← h0]; exact Finset.sum_congr rfl hbe⟩

end Bound

/-! ### Degree-zero sections and regrading -/

section DegreeZero

variable {N σN : Type u} [AddCommGroup N] [Module A N] [SetLike σN N] [AddSubgroupClass σN N]

omit [AddCommGroup N] [Module A N] [AddSubgroupClass σN N] in
theorem mem_zero_natCast {𝒩 : ℤ → σN} {m : N} (hm : m ∈ 𝒩 0) : m ∈ 𝒩 ((0 : ℕ) : ℤ) := by
  rwa [Nat.cast_zero]

/-- The global section `x ↦ m / 1` of `N~`, for `m ∈ N_0`. -/
def constSection0 (𝒩 : ℤ → σN) [SetLike.GradedSMul 𝒜 𝒩] {m : N} (hm : m ∈ 𝒩 0) :
    (projGradedModuleSheaf 𝒜 𝒩).val.obj (op ⊤) :=
  (⟨fun y => HomogeneousLocalizedModule.mk 0 m (mem_zero_natCast hm) 1
      SetLike.GradedOne.one_mem y.1.asHomogeneousIdeal.toIdeal.primeCompl.one_mem, fun y =>
    ⟨⊤, y.2, 𝟙 _, 0, m, mem_zero_natCast hm, 1, SetLike.GradedOne.one_mem,
      fun z => z.1.asHomogeneousIdeal.toIdeal.primeCompl.one_mem, fun _ => rfl⟩⟩ :
    (sheafInType 𝒜 𝒩).1.obj (op ⊤))

theorem constSection0_val (𝒩 : ℤ → σN) [SetLike.GradedSMul 𝒜 𝒩] {m : N} (hm : m ∈ 𝒩 0)
    (x : (⊤ : Opens (Proj 𝒜))) :
    (((constSection0 𝒩 hm : (sheafInType 𝒜 𝒩).1.obj (op ⊤)).1 x).val) =
      LocalizedModule.mk m 1 := rfl

/-- `m ↦ m / 1`, `N_0 → Γ(X, N~)`. -/
def constHom0 (𝒩 : ℤ → σN) [SetLike.GradedSMul 𝒜 𝒩] :
    𝒩 0 →+ (projGradedModuleSheaf 𝒜 𝒩).val.obj (op ⊤) where
  toFun m := constSection0 𝒩 m.2
  map_zero' := section_ext fun _ => HomogeneousLocalizedModule.ext (LocalizedModule.zero_mk 1)
  map_add' m m' := by
    refine section_ext fun x => HomogeneousLocalizedModule.ext ?_
    change LocalizedModule.mk ((m : N) + m') 1 =
      LocalizedModule.mk (m : N) 1 + LocalizedModule.mk (m' : N) 1
    rw [LocalizedModule.mk_add_mk, one_smul, one_smul, mul_one]

theorem bijective_constHom_iff (n : ℤ) :
    Function.Bijective (constHom (𝒜 := 𝒜) ℳ n) ↔
      Function.Bijective (constHom0 (𝒜 := 𝒜) (gradedModuleTwist ℳ n)) := by
  have hmem : ∀ m : M, m ∈ ℳ n ↔ m ∈ gradedModuleTwist ℳ n 0 := fun m => by
    change m ∈ ℳ n ↔ m ∈ ℳ (0 + n)
    rw [zero_add]
  let e : ℳ n ≃ ↥(gradedModuleTwist ℳ n 0 : σM) :=
    { toFun := fun m => ⟨m, (hmem m).1 m.2⟩
      invFun := fun m => ⟨m, (hmem m).2 m.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have h : ⇑(constHom (𝒜 := 𝒜) ℳ n) = constHom0 (𝒜 := 𝒜) (gradedModuleTwist ℳ n) ∘ e := rfl
  rw [h]
  exact Function.Bijective.of_comp_iff _ e.bijective

/-- Bijectivity of `N_0 → Γ(X, N~)` depends only on the homogeneous pieces. -/
theorem bijective_constHom0_congr {σN' : Type u} [SetLike σN' N] [AddSubgroupClass σN' N]
    (𝒩 : ℤ → σN) [SetLike.GradedSMul 𝒜 𝒩] (𝒩' : ℤ → σN') [SetLike.GradedSMul 𝒜 𝒩']
    (h : ∀ (i : ℤ) (m : N), m ∈ 𝒩 i ↔ m ∈ 𝒩' i) :
    Function.Bijective (constHom0 (𝒜 := 𝒜) 𝒩) ↔ Function.Bijective (constHom0 (𝒜 := 𝒜) 𝒩') := by
  let e : 𝒩 0 ≃ 𝒩' 0 :=
    { toFun := fun m => ⟨m, (h 0 m).1 m.2⟩
      invFun := fun m => ⟨m, (h 0 m).2 m.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have hc : ⇑((regradeIso 𝒩 𝒩' h).hom.val.app (op ⊤)) ∘ constHom0 (𝒜 := 𝒜) 𝒩 =
      constHom0 (𝒜 := 𝒜) 𝒩' ∘ e := by
    funext m
    refine section_ext fun x => HomogeneousLocalizedModule.ext ?_
    exact regradeIso_hom_app_val h _ x
  rw [← Function.Bijective.of_comp_iff _ e.bijective, ← hc]
  exact ⟨fun hb => (GammaStarReconstruction.app_bijective_of_iso _ _).comp hb,
    fun hb => (Function.Bijective.of_comp_iff' (GammaStarReconstruction.app_bijective_of_iso _ _)
      _).1 hb⟩

end DegreeZero

/-! ### The factors `(S/𝔭)(l)`

The private helpers in the next section are copied from
`Hartshorne.Scheme.ProjectiveGlobalSectionsFinite` (the proof of Theorem 5.19), where they are
private. -/

section PrimeFactorCopy

open ProjectiveGlobalSectionsFinite ProjectiveSectionRing

variable {ι : Type*}

section PrimeFactor

attribute [local instance] gradedSMul_of_intGrading

/-- The `𝒜`-component of `r` in degree `k` is its `intGrading 𝒜`-component. -/
private theorem coe_decompose_intGrading (r : A) (k : ℕ) :
    (DirectSum.decompose (intGrading 𝒜) r (k : ℤ) : A) = DirectSum.decompose 𝒜 r k := by
  classical
  conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 r]
  rw [DirectSum.decompose_sum, DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum,
    Finset.sum_eq_single k]
  · exact DirectSum.decompose_of_mem_same _ (mem_intGrading_natCast.2 (SetLike.coe_mem _))
  · intro b _ hb
    exact DirectSum.decompose_of_mem_ne _ (mem_intGrading_natCast.2 (SetLike.coe_mem _))
      (by exact_mod_cast hb)
  · intro hk
    rw [DFinsupp.notMem_support_iff.1 hk]
    simp

private theorem isHomogeneous_of_intGrading {I : Ideal A}
    (hI : I.IsHomogeneous (intGrading 𝒜)) : I.IsHomogeneous 𝒜 := fun k r hr => by
  rw [← coe_decompose_intGrading]
  exact hI (k : ℤ) hr

/-- `a / s ↦ a / s̄ ∈ Frac(S/𝔭)`, for denominators outside `𝔭`. -/
private def toFracQ (I : Ideal A) [I.IsPrime] {T : Submonoid A} (hT : T ≤ I.primeCompl)
    (m : LocalizedModule T (A ⧸ I)) : FractionRing (A ⧸ I) :=
  m.liftOn (fun q => algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) q.1 /
      algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) (Ideal.Quotient.mk I q.2)) (by
    rintro ⟨a, s⟩ ⟨b, t⟩ ⟨w, hw⟩
    have hne : ∀ u : T, algebraMap (A ⧸ I) (FractionRing (A ⧸ I))
        (Ideal.Quotient.mk I u) ≠ 0 := fun u => by
      rw [map_ne_zero_iff _ (IsFractionRing.injective _ _), ne_eq,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hT u.2
    simp only [Submonoid.smul_def] at hw
    rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def] at hw
    simp only [Ideal.Quotient.algebraMap_eq] at hw
    have h := congrArg (algebraMap (A ⧸ I) (FractionRing (A ⧸ I))) hw
    simp only [map_mul] at h
    change algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) a /
        algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) (Ideal.Quotient.mk I s) =
      algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) b /
        algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) (Ideal.Quotient.mk I t)
    rw [div_eq_div_iff (hne s) (hne t)]
    have := mul_left_cancel₀ (hne w) h
    linear_combination this)

private theorem toFracQ_mk (I : Ideal A) [I.IsPrime] {T : Submonoid A} (hT : T ≤ I.primeCompl) (a : A ⧸ I) (s : T) :
    toFracQ I hT (LocalizedModule.mk a s) =
      algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) a /
        algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) (Ideal.Quotient.mk I s) :=
  LocalizedModule.liftOn_mk _ _ _

private theorem toFracQ_add (I : Ideal A) [I.IsPrime] {T : Submonoid A} (hT : T ≤ I.primeCompl)
    (m m' : LocalizedModule T (A ⧸ I)) : toFracQ I hT (m + m') = toFracQ I hT m + toFracQ I hT m' := by
  induction m using LocalizedModule.induction_on with | h a s =>
  induction m' using LocalizedModule.induction_on with | h b t =>
  have hne : ∀ u : T, algebraMap (A ⧸ I) (FractionRing (A ⧸ I))
      (Ideal.Quotient.mk I u) ≠ 0 := fun u => by
    rw [map_ne_zero_iff _ (IsFractionRing.injective _ _), ne_eq, Ideal.Quotient.eq_zero_iff_mem]
    exact hT u.2
  have hs := hne s
  have ht := hne t
  rw [LocalizedModule.mk_add_mk, toFracQ_mk, toFracQ_mk, toFracQ_mk]
  simp only [Submonoid.smul_def, Algebra.smul_def, Ideal.Quotient.algebraMap_eq, Submonoid.coe_mul,
    map_add, map_mul]
  field_simp

private theorem toFracQ_mk_smul (I : Ideal A) [I.IsPrime] {T : Submonoid A} (hT : T ≤ I.primeCompl) (c : A)
    (m : LocalizedModule T (A ⧸ I)) :
    toFracQ I hT ((Localization.mk c 1 : Localization T) • m) =
      algebraMap (A ⧸ I) (FractionRing (A ⧸ I)) (Ideal.Quotient.mk I c) * toFracQ I hT m := by
  induction m using LocalizedModule.induction_on with | h b t =>
  rw [LocalizedModule.mk_smul_mk, toFracQ_mk, toFracQ_mk, one_mul, Algebra.smul_def,
    Ideal.Quotient.algebraMap_eq, map_mul, mul_div_assoc]

variable (p : PrimeSpectrum A) (hp : p.1.IsHomogeneous (intGrading 𝒜))

variable (𝒜) in
/-- The prime `𝔭` as a homogeneous ideal of `S`. -/
private def primeIdeal : HomogeneousIdeal 𝒜 := ⟨p.1, isHomogeneous_of_intGrading hp⟩

/-- The point `𝔭` of `Proj S`, when `S₊ ⊄ 𝔭`. -/
private def primePoint (h : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ primeIdeal 𝒜 p hp) : Proj 𝒜 :=
  (⟨primeIdeal 𝒜 p hp, p.isPrime, h⟩ : ProjectiveSpectrum 𝒜)

private instance primeIdeal_isPrime : (primeIdeal 𝒜 p hp).toIdeal.IsPrime := p.isPrime

/-- Away from `V₊(𝔭)` the sheaf `(S/𝔭)(l)~` vanishes: an element `a ∈ 𝔭` outside the point
kills every fraction. -/
private theorem globalValue_val_eq_zero (l : ℤ) (x : Proj 𝒜) {a : A} (hap : a ∈ p.1)
    (hax : a ∉ x.asHomogeneousIdeal)
    (s : (projGradedModuleSheaf 𝒜 (primeFactor 𝒜 p hp l)).val.obj (op ⊤)) :
    (globalValue 𝒜 (primeFactor 𝒜 p hp l) s x).val = 0 := by
  generalize (globalValue 𝒜 (primeFactor 𝒜 p hp l) s x).val = y
  induction y using LocalizedModule.induction_on with | h m t =>
  rw [← LocalizedModule.mk_cancel_common_left ⟨a, hax⟩ t m]
  have ham : a • m = 0 := by
    induction m using Submodule.Quotient.induction_on with | H b =>
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul]
    exact p.1.mul_mem_right b hap
  rw [Submonoid.smul_def]
  change LocalizedModule.mk (a • m) _ = 0
  rw [ham, LocalizedModule.zero_mk]

variable (l : ℤ) (h : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ primeIdeal 𝒜 p hp)

/-- The value in `Frac(S/𝔭)` at the point `𝔭` of a global section of `(S/𝔭)(l)~`. -/
private def primeValue (s : (projGradedModuleSheaf 𝒜 (primeFactor 𝒜 p hp l)).val.obj (op ⊤)) :
    FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) :=
  toFracQ (primeIdeal 𝒜 p hp).toIdeal le_rfl (globalValue 𝒜 (primeFactor 𝒜 p hp l) s (primePoint p hp h)).val

private theorem primeValue_add (s s' : (projGradedModuleSheaf 𝒜 (primeFactor 𝒜 p hp l)).val.obj (op ⊤)) :
    primeValue p hp l h (s + s') = primeValue p hp l h s + primeValue p hp l h s' :=
  toFracQ_add _ le_rfl _ _

private theorem primeValue_smul (c : 𝒜 0)
    (s : (projGradedModuleSheaf 𝒜 (primeFactor 𝒜 p hp l)).val.obj (op ⊤)) :
    primeValue p hp l h (degreeZeroToGlobal 𝒜 c • s) =
      algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)) (Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal c) *
        primeValue p hp l h s := by
  unfold primeValue
  change toFracQ (primeIdeal 𝒜 p hp).toIdeal le_rfl (((degreeZeroToGlobal 𝒜 c).1 ⟨primePoint p hp h, trivial⟩ •
    globalValue 𝒜 (primeFactor 𝒜 p hp l) s (primePoint p hp h)).val) = _
  rw [HomogeneousLocalizedModule.val_smul, degreeZeroToGlobal_val]
  erw [toFracQ_mk_smul]

private theorem eq_zero_of_primeValue_eq_zero
    {s : (projGradedModuleSheaf 𝒜 (primeFactor 𝒜 p hp l)).val.obj (op ⊤)}
    (hs : primeValue p hp l h s = 0) : s = 0 := by
  apply globalValue_injective 𝒜 (primeFactor 𝒜 p hp l)
  funext x
  apply HomogeneousLocalizedModule.ext
  change (globalValue 𝒜 (primeFactor 𝒜 p hp l) s x).val = 0
  let s' : (sheafInType 𝒜 (primeFactor 𝒜 p hp l)).1.obj (op ⊤) := s
  by_cases hpx : p.1 ≤ x.asHomogeneousIdeal.toIdeal
  · obtain ⟨V, hxV, i, d, m, hm, f, hf, f_nin, w⟩ := s'.2 ⟨x, trivial⟩
    beta_reduce at w
    have hηV : (primePoint p hp h : ProjectiveSpectrum 𝒜) ∈ V := by
      have hcl : x ∈ closure ({(primePoint p hp h : ProjectiveSpectrum 𝒜)} :
          Set (ProjectiveSpectrum 𝒜)) :=
        (ProjectiveSpectrum.le_iff_mem_closure (𝒜 := 𝒜) _ x).1 hpx
      obtain ⟨y, hyV, hy⟩ := mem_closure_iff.1 hcl (show Set (ProjectiveSpectrum 𝒜) from V.1)
        V.2 hxV
      rw [Set.mem_singleton_iff.1 hy] at hyV
      exact hyV
    have e1 := congrArg HomogeneousLocalizedModule.val (w ⟨x, hxV⟩)
    have e2 := congrArg HomogeneousLocalizedModule.val (w ⟨_, hηV⟩)
    unfold primeValue at hs
    change toFracQ (primeIdeal 𝒜 p hp).toIdeal le_rfl (s'.1 (i ⟨_, hηV⟩)).val = 0 at hs
    rw [e2, HomogeneousLocalizedModule.val_mk] at hs
    erw [toFracQ_mk] at hs
    rw [div_eq_zero_iff] at hs
    have hm0 : m = 0 := by
      rcases hs with hs | hs
      · exact (map_eq_zero_iff (algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)))
          (IsFractionRing.injective (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)))).1 hs
      · exfalso
        rw [map_eq_zero_iff (algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)))
          (IsFractionRing.injective (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))),
          Ideal.Quotient.eq_zero_iff_mem] at hs
        exact f_nin ⟨_, hηV⟩ hs
    change (s'.1 (i ⟨x, hxV⟩)).val = 0
    rw [e1, HomogeneousLocalizedModule.val_mk]
    subst hm0
    exact LocalizedModule.zero_mk _
  · obtain ⟨a, hap, hax⟩ := Set.not_subset.1 hpx
    exact globalValue_val_eq_zero p hp l x hap hax s


/-- On a chart `D₊(f)` with `f ∈ S₁`, `f ∉ 𝔭`, the value of a section of `(S/𝔭)(l)~` is
`ā / f̄^j` with `a ∈ S_{j + l}` (zero if `j + l < 0`). -/
private theorem exists_primeValue_chart {f : A} (f_deg : f ∈ 𝒜 1) (hf : f ∉ p.1)
    (s : (projGradedModuleSheaf 𝒜 (primeFactor 𝒜 p hp l)).val.obj (op ⊤)) :
    ∃ (j : ℕ) (a : A), a ∈ intGrading 𝒜 (j + l) ∧
      algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
          (Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal a) =
        algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
          (Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal f) ^ j * primeValue p hp l h s := by
  obtain ⟨m, hm⟩ := exists_globalValue_eq_mapOfLE 𝒜 (primeFactor 𝒜 p hp l) f_deg one_pos s
  have hη : primePoint p hp h ∈ Proj.basicOpen 𝒜 f := hf
  obtain ⟨d, a', ha', t, ht, htx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective m
  obtain ⟨j, rfl⟩ := htx
  have hfj : f ^ j ∉ p.1 := fun hmem => hf (p.isPrime.mem_of_pow_mem _ hmem)
  have hdj : d = j := DirectSum.degree_eq_of_mem_mem 𝒜 ht
    (by simpa using SetLike.pow_mem_graded j f_deg) (fun h0 => hfj (by
      simp only at h0
      rw [h0]
      exact zero_mem _))
  subst hdj
  obtain ⟨a, ha, rfl⟩ := ha'
  refine ⟨d, a, ha, ?_⟩
  unfold primeValue
  rw [hm _ hη, HomogeneousLocalizedModule.mapOfLE_mk, HomogeneousLocalizedModule.val_mk]
  erw [toFracQ_mk]
  have h0 : algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
      (Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal (f ^ d)) ≠ 0 := by
    rw [map_ne_zero_iff _ (IsFractionRing.injective _ _), ne_eq, Ideal.Quotient.eq_zero_iff_mem]
    exact hfj
  rw [map_pow, map_pow] at h0 ⊢
  field_simp
  rfl

/-- The value of a section of `(S/𝔭)(l)~`, multiplied by `f̄_{i₀}^m` with `l + m = d ≥ 0`,
satisfies the chart condition in degree `d` for `S/𝔭` and the images of the `fᵢ`. -/
private theorem chartCond_primeValue {f : ι → A} (hf : ∀ i, f i ∈ 𝒜 1) {m d : ℕ}
    (hlmd : l + m = d) (i₀ : ι)
    (s : (projGradedModuleSheaf 𝒜 (primeFactor 𝒜 p hp l)).val.obj (op ⊤)) :
    ChartCond (gradedQuotient 𝒜 (primeIdeal 𝒜 p hp))
      (fun i => Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal (f i)) d
      (algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
        (Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal (f i₀)) ^ m * primeValue p hp l h s) := by
  intro i hi
  have hfi : f i ∉ p.1 := fun hmem => hi (Ideal.Quotient.eq_zero_iff_mem.2 hmem)
  obtain ⟨j, a, ha, hza⟩ := exists_primeValue_chart p hp l h (hf i) hfi s
  have hne : algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
      (Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal (f i)) ^ j ≠ 0 :=
    pow_ne_zero _ ((map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hi)
  by_cases hneg : 0 + ((j : ℤ) + l) < 0
  · refine ⟨0, 0, zero_mem _, ?_⟩
    rw [eq_zero_of_mem_gradedTwist ha hneg, map_zero, map_zero] at hza
    rw [(mul_eq_zero.1 hza.symm).resolve_left hne]
    simp
  · refine ⟨j, Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal (a * f i₀ ^ m), ?_, ?_⟩
    · apply mk_mem_gradedQuotient
      have h1 : a ∈ 𝒜 (0 + ((j : ℤ) + l)).toNat := mem_of_mem_gradedTwist ha
      have := SetLike.mul_mem_graded h1 (by simpa using SetLike.pow_mem_graded m (hf i₀))
      rwa [show (0 + ((j : ℤ) + l)).toNat + m = j + d by omega] at this
    · rw [map_mul, map_mul, hza, map_pow, map_pow]
      ring

end PrimeFactor

end PrimeFactorCopy

section PrimeFactorRecovery

open ProjectiveGlobalSectionsFinite ProjectiveSectionRing

attribute [local instance] gradedSMul_of_intGrading

variable {ι : Type*}

/-- **The factor `(S/𝔭)(l)`.** Let `S` be a finite-type algebra over a field, generated over `S₀`
by finitely many `fᵢ ∈ S₁`, and `𝔭` a homogeneous prime. Then `(S/𝔭)_l → Γ(X, (S/𝔭)(l)~)` is
bijective for all large `l`. If `S₊ ⊆ 𝔭` both sides vanish for `l ≥ 1`. Otherwise a section is
determined by its value `z` in the fraction field of `S/𝔭` at the point `𝔭`, injectivity holds as
`S/𝔭` is a domain, and `z` satisfies the chart condition in degree `l`, so lies in `(S/𝔭)_l` for
`l` large by the uniform bound `exists_bound_of_chartCond`. -/
theorem exists_bijective_constHom0_primeFactor (k : Type u) [Field k] [Algebra k A]
    [Algebra.FiniteType k A] [Fintype ι] {f : ι → A} (hf : ∀ i, f i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤)
    (p : PrimeSpectrum A) (hp : p.1.IsHomogeneous (intGrading 𝒜)) :
    ∃ L : ℤ, ∀ l ≥ L, Function.Bijective (constHom0 (𝒜 := 𝒜) (primeFactor 𝒜 p hp l)) := by
  classical
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  have hcov : ∀ x : Proj 𝒜, ∃ i, f i ∉ x.asHomogeneousIdeal := by
    intro x
    have hx : x ∈ (⊤ : (Proj 𝒜).Opens) := trivial
    rw [← Proj.iSup_basicOpen_eq_top' 𝒜 f (fun i => ⟨1, hf i⟩) hgen] at hx
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.1 hx
    exact ⟨i, hi⟩
  by_cases h : HomogeneousIdeal.irrelevant 𝒜 ≤ primeIdeal 𝒜 p hp
  · refine ⟨1, fun l hl => ⟨fun a b _ => ?_, fun t => ⟨0, ?_⟩⟩⟩
    · have hz : ∀ c : primeFactor 𝒜 p hp l 0, c = 0 := by
        rintro ⟨c, a', ha', rfl⟩
        apply Subtype.ext
        change Submodule.Quotient.mk a' = (0 : A ⧸ p.1)
        rw [Submodule.Quotient.mk_eq_zero]
        have h1 := mem_of_mem_gradedTwist ((mem_intGrading_iff (d := 0 + l)).1 ha')
        exact h (by
          rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply,
            DirectSum.decompose_of_mem_ne 𝒜 h1 (by omega)])
      rw [hz a, hz b]
    · exact globalValue_injective 𝒜 _ (funext fun x => by
        obtain ⟨i, hi⟩ := hcov x
        have hfi : f i ∈ p.1 := h (by
          rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply,
            DirectSum.decompose_of_mem_ne 𝒜 (hf i) (by omega)])
        exact HomogeneousLocalizedModule.ext ((globalValue_val_eq_zero p hp l x hfi hi _).trans
          (globalValue_val_eq_zero p hp l x hfi hi t).symm))
  have : Algebra.FiniteType k (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k (primeIdeal 𝒜 p hp).toIdeal)
      (Ideal.Quotient.mkₐ_surjective k (primeIdeal 𝒜 p hp).toIdeal)
  have : IsNoetherianRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal) :=
    Algebra.FiniteType.isNoetherianRing k _
  have hfb : ∀ i, Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal (f i) ∈
      gradedQuotient 𝒜 (primeIdeal 𝒜 p hp) 1 :=
    fun i => mk_mem_gradedQuotient (hf i)
  have hgenb : Algebra.adjoin (gradedQuotient 𝒜 (primeIdeal 𝒜 p hp) 0)
      (Set.range fun i => Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal (f i)) = ⊤ := by
    rw [eq_top_iff]
    rintro t -
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective t
    have ha : a ∈ Algebra.adjoin (𝒜 0) (Set.range f) := hgen ▸ Algebra.mem_top
    induction ha using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact Algebra.subset_adjoin ⟨i, rfl⟩
    | algebraMap c =>
      exact Subalgebra.algebraMap_mem _
        (⟨Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal c, mk_mem_gradedQuotient c.2⟩ :
          gradedQuotient 𝒜 (primeIdeal 𝒜 p hp) 0)
    | add x y _ _ hx hy =>
      rw [map_add]
      exact add_mem hx hy
    | mul x y _ _ hx hy =>
      rw [map_mul]
      exact mul_mem hx hy
  obtain ⟨i₀, hi₀⟩ : ∃ i, f i ∉ p.1 := hcov (primePoint p hp h)
  have hfb0 : Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal (f i₀) ≠ 0 := fun h0 =>
    hi₀ (Ideal.Quotient.eq_zero_iff_mem.1 h0)
  have hfin : Module.Finite (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)
      (integralClosure (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)
        (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))) :=
    moduleFinite_integralClosure_of_finiteType_of_field k (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)
      (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
      (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
  obtain ⟨N, hN⟩ := exists_bound_of_chartCond hfin hfb hgenb ⟨i₀, hfb0⟩
  -- the value of a constant section
  have hval : ∀ (l : ℤ) (c : primeFactor 𝒜 p hp l 0),
      primeValue p hp l h (constHom0 (𝒜 := 𝒜) (primeFactor 𝒜 p hp l) c) =
        algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)
          (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
            (show A ⧸ (primeIdeal 𝒜 p hp).toIdeal from c.1) := by
    intro l c
    unfold primeValue
    change toFracQ (primeIdeal 𝒜 p hp).toIdeal le_rfl
      (LocalizedModule.mk (show A ⧸ (primeIdeal 𝒜 p hp).toIdeal from c.1) 1) = _
    rw [toFracQ_mk]
    simp
  refine ⟨N, fun l hl => ⟨(injective_iff_map_eq_zero _).2 fun c hc => ?_, fun t => ?_⟩⟩
  · have h1 := hval l c
    rw [hc] at h1
    have h0 : primeValue p hp l h 0 = 0 := by
      have := primeValue_add p hp l h 0 0
      rw [add_zero] at this
      exact (add_eq_left.mp this.symm)
    rw [h0] at h1
    exact Subtype.ext ((map_eq_zero_iff (algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)
      (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)))
      (IsFractionRing.injective (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)
        (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)))).1 h1.symm)
  · have hlmd : l + ((0 : ℕ) : ℤ) = ((l.toNat : ℕ) : ℤ) := by omega
    have hcc := chartCond_primeValue p hp l h hf hlmd i₀ t
    rw [pow_zero, one_mul] at hcc
    obtain ⟨b, hb, hbz⟩ := hN l.toNat (by omega) _ hcc
    obtain ⟨a, ha, rfl⟩ := mem_gradedQuotient_iff.1 hb
    have hamem : (Submodule.Quotient.mk a : A ⧸ p.1) ∈ primeFactor 𝒜 p hp l 0 :=
      ⟨a, (mem_intGrading_iff).2 ((mem_gradedTwist_of_eq (by omega)).2 ha), rfl⟩
    refine ⟨⟨_, hamem⟩, (sub_eq_zero.1 (eq_zero_of_primeValue_eq_zero p hp l h ?_)).symm⟩
    have hs := primeValue_add p hp l h (t - constHom0 (𝒜 := 𝒜) (primeFactor 𝒜 p hp l) ⟨_, hamem⟩)
      (constHom0 (𝒜 := 𝒜) (primeFactor 𝒜 p hp l) ⟨_, hamem⟩)
    rw [sub_add_cancel, hval] at hs
    rw [← hbz] at hs
    have : primeValue p hp l h (t - constHom0 (𝒜 := 𝒜) (primeFactor 𝒜 p hp l) ⟨_, hamem⟩) +
        algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)
          (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
          (Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal a) =
        0 + algebraMap (A ⧸ (primeIdeal 𝒜 p hp).toIdeal)
          (FractionRing (A ⧸ (primeIdeal 𝒜 p hp).toIdeal))
          (Ideal.Quotient.mk (primeIdeal 𝒜 p hp).toIdeal a) := by
      rw [zero_add]
      exact hs.symm
    exact add_right_cancel this

end PrimeFactorRecovery

/-! ### Exercise 5.9(b) -/

section Main

open ProjectiveGlobalSectionsFinite

attribute [local instance] gradedSMul_of_intGrading

theorem eventuallyBijective_primeFactor (k : Type u) [Field k] [Algebra k A]
    [Algebra.FiniteType k A] {ι : Type*} [Fintype ι] {f : ι → A} (hf : ∀ i, f i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤)
    (p : PrimeSpectrum A) (hp : p.1.IsHomogeneous (intGrading 𝒜)) (l₀ : ℤ) :
    EventuallyBijective (𝒜 := 𝒜) (primeFactor 𝒜 p hp l₀) := by
  obtain ⟨L, hL⟩ := exists_bijective_constHom0_primeFactor k hf hgen p hp
  refine ⟨L - l₀, fun n hn => ?_⟩
  rw [bijective_constHom_iff, bijective_constHom0_congr _ (primeFactor 𝒜 p hp (l₀ + n))
    (fun i m => ?_)]
  · exact hL _ (by omega)
  · change m ∈ gradedQuotientPiece _ _ _ ((i + n) + l₀) ↔
      m ∈ gradedQuotientPiece _ _ _ (i + (l₀ + n))
    rw [show i + n + l₀ = i + (l₀ + n) by ring]

/-- **Hartshorne, Exercise II.5.9(b).** Let `S` be a graded ring (here the ring `A` with grading
`𝒜`) whose degree-zero part `S_0 = 𝒜 0` is a finitely generated algebra over a field `k`, let `S`
be generated over `S_0` by finitely many elements of degree one (that is, `S` is generated by `S_1`
and `S_1` is a finitely generated `S_0`-module), and let `M` be a finitely generated graded
`S`-module (`Module.Finite A M`: finite over the whole graded ring). Then the natural map
`α_d : M_d → Γ(Proj S, M~(d))` is bijective for all large `d`.

Following the hint ("use the methods of the proof of (5.19)"): filter `M` with factors `(S/𝔭)(l)`;
eventual bijectivity passes through short exact sequences since global sections are left exact,
and for `(S/𝔭)(l)` the sections are elements of the fraction field of `S/𝔭` integral over `S/𝔭`,
which lie in `S/𝔭` in large degrees because the integral closure is a finite module. -/
theorem exists_bijective_alphaComponent (k : Type u) [Field k] [Algebra k (𝒜 0)]
    [Algebra.FiniteType k (𝒜 0)] {s : Finset A} (hs : ∀ a ∈ s, a ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (s : Set A) = ⊤) [DirectSum.Decomposition ℳ]
    [Module.Finite A M] :
    ∃ d₀ : ℤ, ∀ d ≥ d₀, Function.Bijective
      (alphaComponent ℳ (GammaStarReconstruction.adjoin_one_eq_top hs hgen) d) := by
  let _ : Algebra k A := ((algebraMap (𝒜 0) A).comp (algebraMap k (𝒜 0))).toAlgebra
  have : IsScalarTower k (𝒜 0) A := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Algebra.FiniteType (𝒜 0) A := ⟨⟨s, hgen⟩⟩
  have : Algebra.FiniteType k A := Algebra.FiniteType.trans (S := 𝒜 0) inferInstance inferInstance
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  have hgen' : Algebra.adjoin (𝒜 0) (Set.range ((↑) : s → A)) = ⊤ := by
    rw [Subtype.range_coe]
    exact hgen
  obtain ⟨n₀, hn₀⟩ := eventuallyBijective_of_primeFactors (ℳ := ℳ) fun p hp l =>
    eventuallyBijective_primeFactor k (f := ((↑) : s → A)) (fun i => hs i i.2) hgen' p hp l
  exact ⟨n₀, fun d hd => (bijective_alphaComponent_iff ℳ _ d).2 (hn₀ d hd)⟩

end Main

end EventualSectionRecovery

end Hartshorne
