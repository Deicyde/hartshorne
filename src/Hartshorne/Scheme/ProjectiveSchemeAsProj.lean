import Hartshorne.Scheme.ProjectiveClosedSubschemeHomogeneousIdeal
import Hartshorne.Scheme.ProjectiveSpaceOverSpec
import Hartshorne.Scheme.GeneratedProjProjective
import Hartshorne.Scheme.ProjPartialMap

/-!
# Projective schemes over `Spec A` are `Proj S`

Hartshorne, *Algebraic Geometry*, II, Corollary 5.16(b) (p. 120).

A scheme `Y` over `Spec A` is projective if and only if `Y ≅ Proj S` over `Spec A` for a graded
ring `S` with `S₀ = A` that is finitely generated by `S₁` as an `A`-algebra
(`projective_iff_exists_iso_proj`).

## Proof

If `Y ⟶ Spec A` is projective, it factors through a closed immersion `Y ⟶ ℙʳ_A`, and
`ℙʳ_A ≅ Proj S` over `Spec A` for `S = A[x₀, …, xᵣ]` (`projectiveSpaceOverSpecIso`). By
Corollary 5.16(a) (`ProjectiveClosedSubscheme.exists_iso_projQuotientι_gammaStarIdeal`),
`Y ≅ Proj (S/I)` over `ℙʳ_A` for the homogeneous ideal `I = Γ_*(I_Y) ∩ S`. The degree-zero part
`I₀` of `I` need not vanish, so we replace `I` by its truncation `I_{≥1}`, which defines the same
closed subscheme (Exercise II.3.12(b), `exists_iso_projQuotientι_homogeneousTruncation`). Then
`(S/I_{≥1})₀ = A`, and `S/I_{≥1}` is generated over `A` by the images of `x₀, …, xᵣ`, which have
degree one. Conversely, `Proj S ⟶ Spec S₀` is projective when `S` is finitely generated by `S₁`
over `S₀` (Example II.4.8.1, `projective_projToSpecZero_of_degreeOne_generators`), and
projectivity is invariant under isomorphism.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial

universe u

namespace Hartshorne

attribute [local instance] MvPolynomial.gradedAlgebra

namespace ProjectiveSchemeAsProj

variable {A : Type u} [CommRing A] {r : ℕ}

local notation "𝒮" => homogeneousSubmodule (Fin (r + 1)) A

/-- The map `A → (S/J)₀` for a homogeneous ideal `J` of `S = A[x₀, …, xᵣ]`. -/
private def degreeZeroHom (J : HomogeneousIdeal 𝒮) : A →+* gradedQuotient 𝒮 J 0 :=
  (gradedQuotientMk 𝒮 J).gradedZeroRingHom.comp (algebraMap A (𝒮 0))

/-- For the truncation `J = I_{≥1}`, the map `A → (S/J)₀` is bijective: `(S/I_{≥1})₀ = A`. -/
private theorem degreeZeroHom_bijective (I : HomogeneousIdeal 𝒮) :
    Function.Bijective (degreeZeroHom (homogeneousTruncation 𝒮 I 1)) := by
  constructor
  · refine (injective_iff_map_eq_zero _).mpr fun a ha => ?_
    have h0 : Ideal.Quotient.mk (homogeneousTruncation 𝒮 I 1).toIdeal (C a) = 0 :=
      congrArg Subtype.val ha
    rw [Ideal.Quotient.eq_zero_iff_mem] at h0
    have hC : (C a : MvPolynomial (Fin (r + 1)) A) ∈ 𝒮 0 := (algebraMap A (𝒮 0) a).2
    rcases (mem_homogeneousTruncation_of_mem_iff hC).mp h0 with h | ⟨h, -⟩
    · exact C_injective _ _ (h.trans C_0.symm)
    · exact absurd h (by norm_num)
  · intro y
    obtain ⟨b, hb, hby⟩ := mem_gradedQuotient_iff.mp y.2
    obtain ⟨a, ha⟩ := (bijective_algebraMap_mvPolynomial_homogeneousSubmodule_zero A r).2 ⟨b, hb⟩
    refine ⟨a, Subtype.ext ?_⟩
    change Ideal.Quotient.mk _ ((algebraMap A (𝒮 0) a : MvPolynomial (Fin (r + 1)) A)) = _
    rw [ha]
    exact hby

/-- The images of `x₀, …, xᵣ` generate `S/J` over `(S/J)₀`. -/
private theorem adjoin_mk_X_eq_top (J : HomogeneousIdeal 𝒮) :
    Algebra.adjoin (gradedQuotient 𝒮 J 0)
      (Set.range fun j : Fin (r + 1) => Ideal.Quotient.mk J.toIdeal (X j)) = ⊤ := by
  rw [eq_top_iff]
  rintro y -
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
  induction p using MvPolynomial.induction_on with
  | C a =>
    exact Subalgebra.algebraMap_mem _ (degreeZeroHom J a)
  | add p q hp hq =>
    rw [map_add]
    exact add_mem hp hq
  | mul_X p j hp =>
    rw [map_mul]
    exact mul_mem hp (Algebra.subset_adjoin ⟨j, rfl⟩)

/-- The closed immersion `Proj (S/J) ⟶ ℙʳ_A` lies over `Spec A`, via `A → (S/J)₀`. -/
private theorem projQuotientι_comp_projection (J : HomogeneousIdeal 𝒮) :
    projQuotientι 𝒮 J ≫ (projectiveSpaceOverSpecIso A r (Equiv.refl _)).hom ≫
        projectiveSpaceOverSchemeProjection r (Spec (.of A)) =
      Proj.toSpecZero (gradedQuotient 𝒮 J) ≫
        Spec.map (CommRingCat.ofHom (degreeZeroHom J)) := by
  rw [projectiveSpaceOverSpecIso_hom, projToProjectiveSpaceOverSpec_projection,
    projQuotientι_eq_map, ← Category.assoc, projMap_toSpecZero, Category.assoc, ← Spec.map_comp]
  rfl

end ProjectiveSchemeAsProj

open ProjectiveSchemeAsProj in
/-- **Hartshorne II, Corollary 5.16(b).** A scheme `Y` over `Spec A` is projective if and only if
`Y ≅ Proj S` over `Spec A` for a graded ring `S` with `S₀ = A` (an isomorphism `φ : A ≃ S₀`,
through which `Proj S ⟶ Spec S₀` becomes a morphism to `Spec A`) that is finitely generated by
`S₁` as an `A`-algebra. -/
theorem projective_iff_exists_iso_proj {A : Type u} [CommRing A] {Y : Scheme.{u}}
    (f : Y ⟶ Spec (.of A)) :
    Projective f ↔
      ∃ (S : Type u) (_ : CommRing S) (𝒜 : ℕ → AddSubgroup S) (_ : GradedRing 𝒜)
        (φ : A ≃+* 𝒜 0),
        (∃ s : Finset S, (∀ x ∈ s, x ∈ 𝒜 1) ∧ Algebra.adjoin (𝒜 0) (s : Set S) = ⊤) ∧
        ∃ e : Y ≅ Proj 𝒜,
          e.hom ≫ Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom (φ : A →+* 𝒜 0)) = f := by
  constructor
  · rintro ⟨r, i, hi, hfac⟩
    classical
    let P := projectiveSpaceOverSpecIso A r (Equiv.refl _)
    let g : Y ⟶ Proj (homogeneousSubmodule (Fin (r + 1)) A) := i ≫ P.inv
    let I := ProjectiveClosedSubscheme.gammaStarIdeal A r
      (quasicoherentIdealSubsheafEquiv.symm g.ker)
    let J := homogeneousTruncation (homogeneousSubmodule (Fin (r + 1)) A) I 1
    obtain ⟨e₁, he₁⟩ := ProjectiveClosedSubscheme.exists_iso_projQuotientι_gammaStarIdeal g
    obtain ⟨e₂, he₂⟩ := exists_iso_projQuotientι_homogeneousTruncation I 1
    let φ : A ≃+* gradedQuotient _ J 0 :=
      RingEquiv.ofBijective (degreeZeroHom J) (degreeZeroHom_bijective I)
    let s : Finset (MvPolynomial (Fin (r + 1)) A ⧸ J.toIdeal) :=
      Finset.univ.image fun j => Ideal.Quotient.mk J.toIdeal (X j)
    have hs : ∀ x ∈ s, x ∈ gradedQuotient _ J 1 := by
      simp only [s, Finset.mem_image, Finset.mem_univ, true_and, forall_exists_index]
      rintro x j rfl
      exact mk_mem_gradedQuotient (X_mem_homogeneousSubmodule_one _ j)
    have hadj : Algebra.adjoin (gradedQuotient _ J 0)
        (s : Set (MvPolynomial (Fin (r + 1)) A ⧸ J.toIdeal)) = ⊤ := by
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
      exact adjoin_mk_X_eq_top J
    have h₁ : e₁.hom ≫ projQuotientι _ I = g := he₁
    have h₂ : e₂.hom ≫ projQuotientι _ J = projQuotientι _ I := he₂
    have hiFac : i = e₁.hom ≫ e₂.hom ≫ projQuotientι _ J ≫ P.hom := by
      rw [reassoc_of% h₂, reassoc_of% h₁]
      simp [g]
    have hcomp : (e₁ ≪≫ e₂).hom ≫ Proj.toSpecZero (gradedQuotient _ J) ≫
        Spec.map (CommRingCat.ofHom (φ : A →+* gradedQuotient _ J 0)) = f := by
      rw [← hfac, hiFac, Iso.trans_hom, Category.assoc, Category.assoc, Category.assoc,
        Category.assoc, projQuotientι_comp_projection]
      rfl
    exact ⟨_, inferInstance, gradedQuotient _ J, inferInstance, φ, ⟨s, hs, hadj⟩, e₁ ≪≫ e₂,
      hcomp⟩
  · rintro ⟨S, _, 𝒜, _, φ, hgen, e, rfl⟩
    have : IsIso (CommRingCat.ofHom (φ : A →+* 𝒜 0)) := φ.toCommRingCatIso.isIso_hom
    exact MorphismProperty.RespectsIso.precomp _ e.hom _
      (MorphismProperty.RespectsIso.postcomp _ _ _
        (projective_projToSpecZero_of_degreeOne_generators 𝒜 hgen))

end Hartshorne
