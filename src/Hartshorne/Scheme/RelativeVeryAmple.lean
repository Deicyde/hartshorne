import Hartshorne.Scheme.ProjectiveSpaceOverScheme
import Hartshorne.Scheme.VeroneseDuple
import Hartshorne.Scheme.PicardPullback
import Hartshorne.Scheme.ProjTwistingSheaf
import Mathlib.AlgebraicGeometry.Morphisms.Immersion

/-!
# Relative twisting sheaves and relative very ampleness

Hartshorne, *Algebraic Geometry*, II.5, p. 120.

For a scheme `Y`, the twisting sheaf `𝒪(k)` on `ℙⁿ_Y = ℙⁿ_ℤ ×_ℤ Y` is the pullback of the twisting
sheaf `𝒪(k)` of `ℙⁿ_ℤ = Proj ℤ[x₀, …, xₙ]` along the first projection. An invertible sheaf `L` on
a `Y`-scheme `X` is *very ample relative to `Y`* if there is an immersion `i : X ⟶ ℙʳ_Y` over `Y`
with `i^* 𝒪(1) ≅ L`.

## Main definitions

* `projectiveSpaceTwistingSheaf n Y k`: the sheaf `𝒪(k)` on `ℙⁿ_Y`.
* `IsVeryAmpleRelative p L`: `L` is very ample relative to `p : X ⟶ Y`.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace Hartshorne

open AlgebraicGeometry

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The twisting sheaf `𝒪(k)` on projective space `ℙⁿ_ℤ = Proj ℤ[x₀, …, xₙ]`. -/
def projectiveSpaceIntTwistingSheaf (n : ℕ) (k : ℤ) :
    (projectiveSpaceScheme (ULift.{u} ℤ) n).Modules :=
  projTwistingSheaf (GeneratedProj.intGrading.{u} n) k

/-- `ℤ[x₀, …, xₙ]` is generated by its degree-one part over its degree-zero part. -/
theorem adjoin_intGrading_one_eq_top (n : ℕ) :
    Algebra.adjoin (GeneratedProj.intGrading.{u} n 0)
      (GeneratedProj.intGrading.{u} n 1 : Set (MvPolynomial (Fin (n + 1)) (ULift.{u} ℤ))) = ⊤ :=
  top_le_iff.1 ((Veronese.adjoin_range_X_intGrading n).ge.trans
    (Algebra.adjoin_mono (Set.range_subset_iff.2 fun j =>
      X_mem_homogeneousSubmodule_one (ULift.{u} ℤ) j)))

/-- The twisting sheaf `𝒪(k)` on `ℙⁿ_ℤ` is invertible. -/
theorem isInvertible_projectiveSpaceIntTwistingSheaf (n : ℕ) (k : ℤ) :
    (projectiveSpaceIntTwistingSheaf.{u} n k).IsInvertible :=
  ProjTwistingSheaf.isInvertible (adjoin_intGrading_one_eq_top n) k

/-- **The twisting sheaf `𝒪(k)` on `ℙⁿ_Y`** for a scheme `Y`: the pullback of `𝒪(k)` on `ℙⁿ_ℤ`
along the projection `ℙⁿ_Y = ℙⁿ_ℤ ×_ℤ Y ⟶ ℙⁿ_ℤ`. -/
def projectiveSpaceTwistingSheaf (n : ℕ) (Y : Scheme.{u}) (k : ℤ) :
    (projectiveSpaceOverScheme n Y).Modules :=
  (Scheme.Modules.pullback (pullback.fst (projectiveSpaceOverIntegersMap n) (schemeToSpecZ Y))).obj
    (projectiveSpaceIntTwistingSheaf n k)

/-- The twisting sheaf `𝒪(k)` on `ℙⁿ_Y` is invertible. -/
theorem isInvertible_projectiveSpaceTwistingSheaf (n : ℕ) (Y : Scheme.{u}) (k : ℤ) :
    (projectiveSpaceTwistingSheaf n Y k).IsInvertible :=
  Scheme.Modules.IsInvertible.pullback _ (isInvertible_projectiveSpaceIntTwistingSheaf n k)

/-- **Very ample relative to `Y`.** For a morphism `p : X ⟶ Y`, an invertible `𝒪_X`-module `L` is
very ample relative to `Y` if there are `r` and an immersion `i : X ⟶ ℙʳ_Y` over `Y` (that is,
`i` followed by the projection `ℙʳ_Y ⟶ Y` is `p`) with `i^* 𝒪(1) ≅ L`. -/
def IsVeryAmpleRelative {X Y : Scheme.{u}} (p : X ⟶ Y) (L : X.Modules) : Prop :=
  L.IsInvertible ∧ ∃ (r : ℕ) (i : X ⟶ projectiveSpaceOverScheme r Y), IsImmersion i ∧
    i ≫ projectiveSpaceOverSchemeProjection r Y = p ∧
    Nonempty ((Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf r Y 1) ≅ L)

end Hartshorne
