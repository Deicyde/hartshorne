import Hartshorne.Scheme.CartierDivisorSheaf
import Hartshorne.RingedSpace.PicardGroup

/-!
# Arithmetic of the sheaves `O_X(D)`

Hartshorne, *Algebraic Geometry*, II.6, Proposition 6.13(b) (p. 144).

For Cartier divisors `D`, `D'` on a scheme `X`, with `O_X(D) ⊆ K_X` the invertible submodule
locally generated by the inverses of local equations of `D`, we prove:

* the product of local equations of `D` and `D'` is a local equation of `D + D'`, so the product
  `s t` in `K_X` of sections of `O_X(D)` and `O_X(D')` is a section of `O_X(D + D')`; the
  multiplication map `O_X(D) ⊗ O_X(D') ⟶ K_X`, `s ⊗ t ↦ s t` (`mulTotalQuotient`), factors as an
  isomorphism `O_X(D) ⊗ O_X(D') ≅ O_X(D + D')` (`tensorIso`) followed by the embedding
  `O_X(D + D') ⊆ K_X` (`tensorIso_hom_comp_sheafι`);
* the pairing `O_X(D) × O_X(-D) → O_X`, `(s, t) ↦ s t`, induces an isomorphism
  `O_X(-D) ≅ O_X(D)^∨ = ℋom(O_X(D), O_X)` (`negIsoDual`, `toK_dualEval_negToDual`);
* consequently `O_X(D₁ - D₂) ≅ O_X(D₁) ⊗ O_X(D₂)^∨` (`subIsoTensorDual`), compatibly with the
  embeddings into `K_X`: the embedding of `O_X(D₁ - D₂)` corresponds to the product map
  `s ⊗ t ↦ s t` (`subIsoTensorDual_inv_comp_sheafι`, `subIsoTensorDual_inv_tmul`).

Both isomorphisms are checked locally. On an open `V₀` carrying local equations `f` of `D` and
`g` of `D'`, the sections of `O_X(D)` over `V ⊆ V₀` are exactly the multiples `r f⁻¹`, uniquely
(`generatorEquiv`), so the presheaf-level product map
`O_X(D)(V) ⊗ O_X(D')(V) → O_X(D + D')(V)` is the bijection `r f⁻¹ ⊗ r' g⁻¹ ↦ r r' (f g)⁻¹`; since
sheafification does not change stalks, the multiplication map is an isomorphism. Similarly
`f⁻¹` is a one-element local frame of `O_X(D)`, and evaluation of the functional attached to
`t = r f` at `f⁻¹` is `r`.
-/

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

universe u

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace Scheme.CartierDivisor

open Hartshorne Hartshorne.Ringed

variable {X : Scheme.{u}}

theorem restrict_add (D D' : X.CartierDivisor) (V : X.Opens) :
    (D + D').restrict V = D.restrict V + D'.restrict V :=
  map_add _ _ _

theorem restrict_neg (D : X.CartierDivisor) (V : X.Opens) :
    (-D).restrict V = -D.restrict V :=
  map_neg _ _

/-- The product of local equations of `D` and `D'` is a local equation of `D + D'`. -/
theorem restrict_add_eq {D D' : X.CartierDivisor} {V : X.Opens}
    {f g : X.totalQuotientUnitsSheaf.obj.obj (op V)}
    (hf : D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f))
    (hg : D'.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul g)) :
    (D + D').restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul (f * g)) := by
  rw [restrict_add, hf, hg]
  exact (map_add _ _ _).symm

/-- The inverse of a local equation of `D` is a local equation of `-D`. -/
theorem restrict_neg_eq {D : X.CartierDivisor} {V : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V)}
    (hf : D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f)) :
    (-D).restrict V = X.toCartierDivisorSheaf.hom.app (op V)
      (Additive.ofMul (f⁻¹ : X.totalQuotientUnitsSheaf.obj.obj (op V))) := by
  rw [restrict_neg, hf]
  exact (map_neg _ _).symm

/-- The value in `K_X` of the product of two local units is the product of their values. -/
theorem kUnitVal_mul {V : X.Opens} (f g : X.totalQuotientUnitsSheaf.obj.obj (op V)) :
    kUnitVal (f * g) = kUnitVal f * kUnitVal g :=
  rfl

/-- Multiplication of sections of `K_X`, valued in the sections of the `O_X`-module `K_X`. -/
abbrev tqMul {U : (Opens X)ᵒᵖ} (a b : X.totalQuotientSheaf.obj.obj U) :
    X.totalQuotientModule.val.obj U :=
  a * b

theorem kUnitVal_mul_inv {V : X.Opens} (f g : X.totalQuotientUnitsSheaf.obj.obj (op V)) :
    kUnitVal (f * g)⁻¹ = kUnitVal f⁻¹ * kUnitVal g⁻¹ := by
  rw [mul_inv]
  rfl

/-- If `s` is a section of `O_X(D)` and `t` one of `O_X(D')`, then `s t` is a section of
`O_X(D + D')`. -/
theorem isSection_mul {D D' : X.CartierDivisor} {U : X.Opens}
    {s t : X.totalQuotientSheaf.obj.obj (op U)} (hs : D.IsSection s) (ht : D'.IsSection t) :
    (D + D').IsSection (s * t) := by
  apply isSection_of_locally
  intro x hx
  obtain ⟨V₁, f, hx₁, hf⟩ := D.exists_localEquation x
  obtain ⟨V₂, g, hx₂, hg⟩ := D'.exists_localEquation x
  have h₁ : V₁ ⊓ V₂ ⊓ U ≤ V₁ := inf_le_left.trans inf_le_left
  have h₂ : V₁ ⊓ V₂ ⊓ U ≤ V₂ := inf_le_left.trans inf_le_right
  have hU : V₁ ⊓ V₂ ⊓ U ≤ U := inf_le_right
  have hf' := D.restrict_eq_of_le h₁ hf
  have hg' := D'.restrict_eq_of_le h₂ hg
  obtain ⟨r, hr⟩ := hs _ hU _ hf'
  obtain ⟨r', hr'⟩ := ht _ hU _ hg'
  refine ⟨_, hU, _, ⟨⟨hx₁, hx₂⟩, hx⟩, restrict_add_eq hf' hg', r * r', ?_⟩
  rw [map_mul, hr, hr', map_mul, kUnitVal_mul]
  ring

/-- The multiplication `O_X(D) × O_X(D') → K_X`, `(s, t) ↦ s t`. -/
def mulTotalQuotientBilinear (D D' : X.CartierDivisor) :
    ModuleSheafBilinear D.sheaf D'.sheaf X.totalQuotientModule where
  app U := LinearMap.mk₂ _
    (fun s t ↦ tqMul s.1 t.1)
    (fun _ _ _ ↦ add_mul (R := X.totalQuotientSheaf.obj.obj U) _ _ _)
    (fun _ _ _ ↦ mul_assoc (G := X.totalQuotientSheaf.obj.obj U) _ _ _)
    (fun _ _ _ ↦ mul_add (R := X.totalQuotientSheaf.obj.obj U) _ _ _)
    (fun _ _ _ ↦ mul_left_comm (G := X.totalQuotientSheaf.obj.obj U) _ _ _)
  naturality i _ _ := map_mul (X.totalQuotientSheaf.obj.map i).hom _ _

/-- The multiplication map `O_X(D) ⊗ O_X(D') ⟶ K_X`, `s ⊗ t ↦ s t`. -/
def mulTotalQuotient (D D' : X.CartierDivisor) :
    moduleSheafTensor D.sheaf D'.sheaf ⟶ X.totalQuotientModule :=
  (moduleSheafTensorHomEquiv _ _ _).symm (mulTotalQuotientBilinear D D')

/-- The multiplication `O_X(D) × O_X(D') → O_X(D + D')`, `(s, t) ↦ s t`. -/
def mulBilinear (D D' : X.CartierDivisor) :
    ModuleSheafBilinear D.sheaf D'.sheaf (D + D').sheaf where
  app U := LinearMap.mk₂ _
    (fun s t ↦ ⟨tqMul s.1 t.1, isSection_mul s.2 t.2⟩)
    (fun _ _ _ ↦ Subtype.ext (add_mul (R := X.totalQuotientSheaf.obj.obj U) _ _ _))
    (fun _ _ _ ↦ Subtype.ext (mul_assoc (G := X.totalQuotientSheaf.obj.obj U) _ _ _))
    (fun _ _ _ ↦ Subtype.ext (mul_add (R := X.totalQuotientSheaf.obj.obj U) _ _ _))
    (fun _ _ _ ↦ Subtype.ext (mul_left_comm (G := X.totalQuotientSheaf.obj.obj U) _ _ _))
  naturality i _ _ := Subtype.ext (map_mul (X.totalQuotientSheaf.obj.map i).hom _ _)

/-- The multiplication map `O_X(D) ⊗ O_X(D') ⟶ O_X(D + D')`, `s ⊗ t ↦ s t`. -/
def mulHom (D D' : X.CartierDivisor) : moduleSheafTensor D.sheaf D'.sheaf ⟶ (D + D').sheaf :=
  (moduleSheafTensorHomEquiv _ _ _).symm (mulBilinear D D')

theorem mulHom_tmul (D D' : X.CartierDivisor) {U : X.Opens} (s : D.sheaf.val.presheaf.obj (op U))
    (t : D'.sheaf.val.presheaf.obj (op U)) :
    sectionsMap (mulHom D D') U ((moduleSheafTensorBilinear _ _).app (op U) s t) =
      (mulBilinear D D').app (op U) s t :=
  moduleSheafTensorHomEquiv_symm_tmul _ s t

theorem mulTotalQuotient_tmul (D D' : X.CartierDivisor) {U : X.Opens}
    (s : D.sheaf.val.presheaf.obj (op U)) (t : D'.sheaf.val.presheaf.obj (op U)) :
    sectionsMap (mulTotalQuotient D D') U ((moduleSheafTensorBilinear _ _).app (op U) s t) =
      (mulTotalQuotientBilinear D D').app (op U) s t :=
  moduleSheafTensorHomEquiv_symm_tmul _ s t

/-- The multiplication map into `K_X` factors through `O_X(D + D') ⊆ K_X`. -/
theorem mulHom_comp_sheafι (D D' : X.CartierDivisor) :
    mulHom D D' ≫ (D + D').sheafι = mulTotalQuotient D D' := by
  refine modulesTensor_hom_ext fun U s t ↦ ?_
  refine (congrArg (sectionsMap (D + D').sheafι U) (mulHom_tmul D D' s t)).trans ?_
  refine Eq.trans ?_ (mulTotalQuotient_tmul D D' s t).symm
  rfl

/-- The sections of an `O_X`-module over an open, as an abelian group, are a module over the
regular functions. (Instance search does not find the corresponding ringed-space instance for the
structure sheaf of a scheme.) -/
local instance moduleSectionsScheme (M : SheafOfModules.{u} (ringCatSheafOf X.sheaf))
    (U : X.Opensᵒᵖ) : Module (X.sheaf.obj.obj U) (M.val.presheaf.obj U) :=
  inferInstanceAs (Module (X.sheaf.obj.obj U) (M.val.obj U))

/-- `O_X(D)`, as a module over the ringed space `(X, O_X)`. -/
abbrev sheafR (D : X.CartierDivisor) : SheafOfModules.{u} (ringCatSheafOf X.sheaf) := D.sheaf

/-- The underlying section of `K_X` of a section of `O_X(D)`. -/
abbrev kVal (D : X.CartierDivisor) {U : X.Opens} (s : D.sheafR.val.presheaf.obj (op U)) :
    X.totalQuotientSheaf.obj.obj (op U) :=
  s.1

/-- The restriction to `V ⊆ V₀` of the inverse `f⁻¹` of a local equation `f` of `D` on `V₀`, as a
section of `O_X(D)` over `V`. -/
def generator (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    {V : X.Opens} (h : V ≤ V₀) : D.sheafR.val.presheaf.obj (op V) :=
  ⟨X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹), D.isSection_inv hf h⟩

/-- Multiplication by the generator `f⁻¹`, `O_X(V) → O_X(D)(V)`. -/
def generatorMap (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    {V : X.Opens} (h : V ≤ V₀) : X.sheaf.obj.obj (op V) →ₗ[X.sheaf.obj.obj (op V)] D.sheafR.val.presheaf.obj (op V) :=
  LinearMap.toSpanSingleton (X.sheaf.obj.obj (op V)) _ (D.generator hf h)

theorem generatorMap_val (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    {V : X.Opens} (h : V ≤ V₀) (r : Γ(X, V)) :
    D.kVal (D.generatorMap hf h r) =
      X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹) :=
  rfl

theorem generatorMap_bijective (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    {V : X.Opens} (h : V ≤ V₀) : Function.Bijective (D.generatorMap hf h) := by
  have hinv : X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹) *
      X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f) = 1 := by
    rw [← map_mul, show kUnitVal f⁻¹ * kUnitVal f = 1 from Units.inv_mul _, map_one]
  refine ⟨fun r r' hrr' ↦ ?_, fun t ↦ ?_⟩
  · have h' := congrArg (fun s : D.sheafR.val.presheaf.obj (op V) ↦
      D.kVal s * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f)) hrr'
    change X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹) * _ =
      X.toK V r' * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹) * _ at h'
    rw [mul_assoc, mul_assoc, hinv, mul_one, mul_one] at h'
    exact toK_injective V h'
  · obtain ⟨r, hr⟩ := t.2 V le_rfl _ (D.restrict_eq_of_le h hf)
    refine ⟨r, Subtype.ext ?_⟩
    have e : X.totalQuotientSheaf.obj.map (homOfLE (le_refl V)).op (D.kVal t) = D.kVal t :=
      kMap_id _
    change X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹) = D.kVal t
    calc X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹) =
        X.totalQuotientSheaf.obj.map (homOfLE (le_refl V)).op (D.kVal t) *
          (X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f) *
            X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹)) := by
          rw [hr, mul_assoc]
          rfl
      _ = D.kVal t := by
          rw [mul_comm (X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f)), hinv,
            mul_one, e]

/-- The trivialization `O_X(V) ≅ O_X(D)(V)`, `r ↦ r f⁻¹`, given by a local equation `f`. -/
def generatorEquiv (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    {V : X.Opens} (h : V ≤ V₀) : X.sheaf.obj.obj (op V) ≃ₗ[X.sheaf.obj.obj (op V)] D.sheafR.val.presheaf.obj (op V) :=
  LinearEquiv.ofBijective _ (D.generatorMap_bijective hf h)

/-- The map of underlying presheaves of `O_X(D) ⊗ O_X(D') ⟶ O_X(D + D')` restricted along the
presheaf tensor product. -/
abbrev mulPresheafMap (D D' : X.CartierDivisor) :=
  (PresheafOfModules.toPresheaf _).map (moduleSheafTensorUnit D.sheaf D'.sheaf ≫ (mulHom D D').val)

theorem mulPresheafMap_tmul (D D' : X.CartierDivisor) {V : X.Opens}
    (s : D.sheafR.val.presheaf.obj (op V)) (t : D'.sheafR.val.presheaf.obj (op V)) :
    (mulPresheafMap D D').app (op V)
        (show (moduleSheafTensorPresheaf D.sheaf D'.sheaf).obj (op V) from s ⊗ₜ t) =
      (mulBilinear D D').app (op V) s t :=
  mulHom_tmul D D' s t

theorem mulPresheafMap_bijective {D D' : X.CartierDivisor} {V₀ : X.Opens}
    {f g : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    (hg : D'.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul g))
    {V : X.Opens} (h : V ≤ V₀) :
    Function.Bijective ((mulPresheafMap D D').app (op V)) := by
  let c := D.generatorEquiv hf h
  let d := D'.generatorEquiv hg h
  let e := generatorEquiv (D + D') (restrict_add_eq hf hg) h
  let T : TensorProduct (X.sheaf.obj.obj (op V)) (D.sheafR.val.presheaf.obj (op V))
      (D'.sheafR.val.presheaf.obj (op V)) ≃ₗ[X.sheaf.obj.obj (op V)] (D + D').sheafR.val.presheaf.obj (op V) :=
    (TensorProduct.congr c d).symm.trans ((TensorProduct.lid (X.sheaf.obj.obj (op V)) (X.sheaf.obj.obj (op V))).trans e)
  have key : ∀ t, (mulPresheafMap D D').app (op V) t = T t := by
    intro t
    change TensorProduct (X.sheaf.obj.obj (op V)) (D.sheafR.val.presheaf.obj (op V))
      (D'.sheafR.val.presheaf.obj (op V)) at t
    induction t using TensorProduct.induction_on with
    | zero => exact (map_zero _).trans (map_zero T).symm
    | tmul s t =>
      refine (mulPresheafMap_tmul D D' s t).trans ?_
      obtain ⟨a, rfl⟩ := c.surjective s
      obtain ⟨b, rfl⟩ := d.surjective t
      simp only [T, LinearEquiv.trans_apply, TensorProduct.congr_symm_tmul,
        LinearEquiv.symm_apply_apply, TensorProduct.lid_tmul, smul_eq_mul]
      apply Subtype.ext
      change (X.toK V a * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹)) *
          (X.toK V b * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal g⁻¹)) =
        X.toK V (a * b) * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal (f * g)⁻¹)
      rw [kUnitVal_mul_inv, map_mul, map_mul]
      ring
    | add a b ha hb => exact (map_add _ a b).trans ((congrArg₂ (· + ·) ha hb).trans
        (map_add T a b).symm)
  have : ⇑((mulPresheafMap D D').app (op V)) = ⇑T := funext key
  rw [this]
  exact T.bijective

/-- A morphism of presheaves of abelian groups that is bijective on all opens inside a
neighbourhood of `x` is bijective on stalks at `x`. (A copy of a private lemma of
`Hartshorne.RingedSpace.FiniteLocallyFreeDuality`.) -/
private lemma stalkFunctor_map_bijective_of_locally_bijective' {Y : TopCat.{u}}
    {P Q : TopCat.Presheaf AddCommGrpCat.{u} Y} (p : P ⟶ Q) {x : Y} {U : TopologicalSpace.Opens Y}
    (hx : x ∈ U) (hp : ∀ V : TopologicalSpace.Opens Y, V ≤ U → Function.Bijective (p.app (op V))) :
    Function.Bijective ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map p) := by
  constructor
  · intro s t hst
    obtain ⟨V, hVU, hxV, s, rfl⟩ := P.exists_le_germ_eq s hx
    obtain ⟨V', hV'U, hxV', t, rfl⟩ := P.exists_le_germ_eq t hx
    rw [TopCat.Presheaf.stalkFunctor_map_germ_apply,
      TopCat.Presheaf.stalkFunctor_map_germ_apply] at hst
    obtain ⟨W, hxW, iV, iV', heq⟩ := Q.germ_eq x hxV hxV' _ _ hst
    have hWU : W ≤ U := (leOfHom iV).trans hVU
    have e : ∀ {V₁ V₂ : TopologicalSpace.Opens Y} (i : V₂ ⟶ V₁) (a : ToType (P.obj (op V₁))),
        Q.map i.op (p.app (op V₁) a) = p.app (op V₂) (P.map i.op a) := fun i a => by
      rw [← ConcreteCategory.comp_apply, ← p.naturality, ConcreteCategory.comp_apply]
    rw [e, e] at heq
    have := (hp W hWU).1 heq
    rw [← TopCat.Presheaf.germ_res_apply P iV x hxW,
      ← TopCat.Presheaf.germ_res_apply P iV' x hxW, this]
  · intro t
    obtain ⟨V, hVU, hxV, t, rfl⟩ := Q.exists_le_germ_eq t hx
    obtain ⟨s, rfl⟩ := (hp V hVU).2 t
    exact ⟨P.germ V x hxV s, TopCat.Presheaf.stalkFunctor_map_germ_apply _ _ _ _ _⟩

/-- The multiplication map `O_X(D) ⊗ O_X(D') ⟶ O_X(D + D')` is an isomorphism. -/
theorem isIso_mulHom (D D' : X.CartierDivisor) : IsIso (mulHom D D') := by
  refine modules_isIso_of_stalk_bijective _ fun x => ?_
  obtain ⟨V₁, f, hx₁, hf⟩ := D.exists_localEquation x
  obtain ⟨V₂, g, hx₂, hg⟩ := D'.exists_localEquation x
  have hf' := D.restrict_eq_of_le (inf_le_left : V₁ ⊓ V₂ ≤ V₁) hf
  have hg' := D'.restrict_eq_of_le (inf_le_right : V₁ ⊓ V₂ ≤ V₂) hg
  have h1 := stalkFunctor_map_bijective_of_locally_bijective' (mulPresheafMap D D')
    (show x ∈ V₁ ⊓ V₂ from ⟨hx₁, hx₂⟩) (fun V h => mulPresheafMap_bijective hf' hg' h)
  have h2 := ModuleSheafTensor.moduleSheafTensorUnitStalk_bijective D.sheaf D'.sheaf x
  have hc : mulPresheafMap D D' =
      @CategoryStruct.comp (TopCat.Presheaf AddCommGrpCat.{u} X) _ _ _ _
        (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
          (moduleSheafTensorPresheaf D.sheaf D'.sheaf).presheaf)
        (modulesMapPresheaf (mulHom D D')) :=
    (PresheafOfModules.toPresheaf _).map_comp _ _
  have e := (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map_comp
    (CategoryTheory.toSheafify (Opens.grothendieckTopology X)
      (moduleSheafTensorPresheaf D.sheaf D'.sheaf).presheaf)
    (modulesMapPresheaf (mulHom D D'))
  rw [hc, e] at h1
  exact (Function.Bijective.of_comp_iff _ h2).mp h1

/-- **Hartshorne II.6, Proposition 6.13(b), product form.** Multiplication in `K_X` induces an
isomorphism `O_X(D) ⊗ O_X(D') ≅ O_X(D + D')`, `s ⊗ t ↦ s t`. -/
def tensorIso (D D' : X.CartierDivisor) : moduleSheafTensor D.sheaf D'.sheaf ≅ (D + D').sheaf :=
  haveI := isIso_mulHom D D'
  asIso (mulHom D D')

/-- **Hartshorne II.6, Proposition 6.13(b), product form, compatibility with `K_X`.** The
multiplication map `O_X(D) ⊗ O_X(D') ⟶ K_X`, `s ⊗ t ↦ s t`, is the isomorphism
`O_X(D) ⊗ O_X(D') ≅ O_X(D + D')` followed by the embedding `O_X(D + D') ⊆ K_X`. -/
theorem tensorIso_hom_comp_sheafι (D D' : X.CartierDivisor) :
    (tensorIso D D').hom ≫ (D + D').sheafι = mulTotalQuotient D D' :=
  mulHom_comp_sheafι D D'

/-! ### The dual of `O_X(D)` -/

/-- A section of `O_X(0)` is regular. -/
theorem exists_toK_eq_of_isSection_zero {U : X.Opens} {s : X.totalQuotientSheaf.obj.obj (op U)}
    (hs : (0 : X.CartierDivisor).IsSection s) : ∃ r : Γ(X, U), X.toK U r = s := by
  have h0 : (0 : X.CartierDivisor).restrict U = X.toCartierDivisorSheaf.hom.app (op U)
      (Additive.ofMul (1 : X.totalQuotientUnitsSheaf.obj.obj (op U))) := by
    rw [show (0 : X.CartierDivisor).restrict U = 0 from map_zero _]
    exact (map_zero _).symm
  obtain ⟨r, hr⟩ := hs U le_rfl 1 h0
  have e : X.totalQuotientSheaf.obj.map (homOfLE (le_refl U)).op s = s := kMap_id _
  refine ⟨r, hr.trans ?_⟩
  change X.totalQuotientSheaf.obj.map (homOfLE (le_refl U)).op s * 1 = s
  rw [mul_one, e]

/-- The product of a section of `O_X(D)` and a section of `O_X(-D)` is regular. -/
theorem exists_toK_eq_mul_neg (D : X.CartierDivisor) {U : X.Opens}
    (s : D.sheafR.val.presheaf.obj (op U)) (t : (-D).sheafR.val.presheaf.obj (op U)) :
    ∃ r : Γ(X, U), X.toK U r = D.kVal s * (-D).kVal t := by
  have h := isSection_mul s.2 t.2
  rw [add_neg_cancel] at h
  exact exists_toK_eq_of_isSection_zero h

/-- The regular function `s t` for sections `s` of `O_X(D)` and `t` of `O_X(-D)`. -/
def pairingVal (D : X.CartierDivisor) {U : X.Opens} (s : D.sheafR.val.presheaf.obj (op U))
    (t : (-D).sheafR.val.presheaf.obj (op U)) : Γ(X, U) :=
  (D.exists_toK_eq_mul_neg s t).choose

theorem toK_pairingVal (D : X.CartierDivisor) {U : X.Opens} (s : D.sheafR.val.presheaf.obj (op U))
    (t : (-D).sheafR.val.presheaf.obj (op U)) :
    X.toK U (D.pairingVal s t) = D.kVal s * (-D).kVal t :=
  (D.exists_toK_eq_mul_neg s t).choose_spec

theorem pairingVal_add_left (D : X.CartierDivisor) {U : X.Opens}
    (s s' : D.sheafR.val.presheaf.obj (op U)) (t : (-D).sheafR.val.presheaf.obj (op U)) :
    D.pairingVal (s + s') t = D.pairingVal s t + D.pairingVal s' t := by
  apply toK_injective
  rw [map_add, toK_pairingVal, toK_pairingVal, toK_pairingVal]
  exact add_mul (R := X.totalQuotientSheaf.obj.obj (op U)) _ _ _

theorem pairingVal_add_right (D : X.CartierDivisor) {U : X.Opens}
    (s : D.sheafR.val.presheaf.obj (op U)) (t t' : (-D).sheafR.val.presheaf.obj (op U)) :
    D.pairingVal s (t + t') = D.pairingVal s t + D.pairingVal s t' := by
  apply toK_injective
  rw [map_add, toK_pairingVal, toK_pairingVal, toK_pairingVal]
  exact mul_add (R := X.totalQuotientSheaf.obj.obj (op U)) _ _ _

theorem pairingVal_smul_left (D : X.CartierDivisor) {U : X.Opens} (r : X.sheaf.obj.obj (op U))
    (s : D.sheafR.val.presheaf.obj (op U)) (t : (-D).sheafR.val.presheaf.obj (op U)) :
    D.pairingVal (r • s) t = @id Γ(X, U) r * D.pairingVal s t := by
  apply toK_injective
  rw [map_mul, toK_pairingVal, toK_pairingVal]
  exact mul_assoc (G := X.totalQuotientSheaf.obj.obj (op U)) _ _ _

theorem pairingVal_smul_right (D : X.CartierDivisor) {U : X.Opens} (r : X.sheaf.obj.obj (op U))
    (s : D.sheafR.val.presheaf.obj (op U)) (t : (-D).sheafR.val.presheaf.obj (op U)) :
    D.pairingVal s (r • t) = @id Γ(X, U) r * D.pairingVal s t := by
  apply toK_injective
  rw [map_mul, toK_pairingVal, toK_pairingVal]
  exact mul_left_comm (G := X.totalQuotientSheaf.obj.obj (op U)) _ _ _

theorem pairingVal_restrict (D : X.CartierDivisor) {U V : X.Opens} (h : V ≤ U)
    (s : D.sheafR.val.presheaf.obj (op U)) (t : (-D).sheafR.val.presheaf.obj (op U)) :
    X.presheaf.map (homOfLE h).op (D.pairingVal s t) =
      D.pairingVal (D.sheafR.val.presheaf.map (homOfLE h).op s)
        ((-D).sheafR.val.presheaf.map (homOfLE h).op t) := by
  apply toK_injective
  rw [← toK_naturality, toK_pairingVal, toK_pairingVal]
  exact map_mul (X.totalQuotientSheaf.obj.map (homOfLE h).op).hom _ _

/-- The pairing `O_X(D) × O_X(-D) → O_X`, `(s, t) ↦ s t`. -/
def pairingBilinear (D : X.CartierDivisor) :
    ModuleSheafBilinear D.sheaf (-D).sheaf (structureModule X.sheaf) where
  app U := LinearMap.mk₂ _ (fun s t ↦ D.pairingVal (U := U.unop) s t)
    (fun s s' t ↦ D.pairingVal_add_left s s' t)
    (fun r s t ↦ D.pairingVal_smul_left r s t)
    (fun s t t' ↦ D.pairingVal_add_right s t t')
    (fun r s t ↦ D.pairingVal_smul_right r s t)
  naturality i s t := D.pairingVal_restrict (leOfHom i.unop) s t

/-- The map `O_X(-D) ⟶ O_X(D)^∨` induced by the pairing `(s, t) ↦ s t`. -/
def negToDual (D : X.CartierDivisor) : (-D).sheaf ⟶ moduleSheafDual D.sheaf :=
  bilinearCurry D.pairingBilinear

theorem sheafR_map_id (D : X.CartierDivisor) {V : X.Opens} (t : D.sheafR.val.presheaf.obj (op V)) :
    D.sheafR.val.presheaf.map (homOfLE (le_refl V)).op t = t :=
  Subtype.ext (kMap_id (X := X) _)

theorem generator_restrict (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    {V W : X.Opens} (h : V ≤ W) (hW : W ≤ V₀) :
    D.sheafR.val.presheaf.map (homOfLE h).op (D.generator hf hW) =
      D.generator hf (h.trans hW) :=
  Subtype.ext (kMap_map (X := X) _ _ _)

/-- The inverse `f⁻¹` of a local equation `f` of `D` on `V₀` is a local frame of `O_X(D)`
over `V₀`. -/
theorem isLocalFrame_generator (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f)) :
    IsLocalFrame D.sheafR V₀ (fun _ : Fin 1 ↦ D.generator hf le_rfl) := by
  intro V h
  have : ⇑(localFrameMap D.sheafR (fun _ : Fin 1 ↦ D.generator hf le_rfl) h) =
      D.generatorMap hf h ∘ fun a ↦ a 0 := by
    funext a
    rw [localFrameMap_apply, Fintype.sum_unique, generator_restrict]
    rfl
  rw [this]
  exact (D.generatorMap_bijective hf h).comp (Equiv.funUnique (Fin 1) _).bijective

/-- The map `O_X(-D) ⟶ O_X(D)^∨` sends `t` to the functional `s ↦ s t`. -/
theorem toK_dualEval_negToDual (D : X.CartierDivisor) {U V : X.Opens} (h : V ≤ U)
    (t : (-D).sheafR.val.presheaf.obj (op U)) (s : D.sheafR.val.presheaf.obj (op V)) :
    X.toK V (dualEval (sectionsMap D.negToDual U t) h s) =
      D.kVal s * (-D).kVal ((-D).sheafR.val.presheaf.map (homOfLE h).op t) :=
  D.toK_pairingVal _ _

/-- The map `O_X(-D) ⟶ O_X(D)^∨` induced by multiplication is an isomorphism. -/
theorem isIso_negToDual (D : X.CartierDivisor) : IsIso D.negToDual := by
  refine modules_isIso_of_locally_bijective _ fun x ↦ ?_
  obtain ⟨W, f, hx, hf⟩ := D.exists_localEquation x
  refine ⟨W, hx, fun V hV ↦ ?_⟩
  have hA := D.isLocalFrame_generator hf
  have hL := hA.localFrameEval_bijective (G := structureModule X.sheaf) hV
  rw [← Function.Bijective.of_comp_iff' hL]
  let ψ : (-D).sheafR.val.presheaf.obj (op V) → Γ(X, V) := fun t ↦ D.pairingVal (D.generator hf hV) t
  have hψ : Function.Bijective ψ := by
    have hneg := restrict_neg_eq hf
    rw [← Function.Bijective.of_comp_iff ψ (generatorMap_bijective (-D) hneg hV)]
    have : ψ ∘ generatorMap (-D) hneg hV = id := by
      funext r
      apply toK_injective
      rw [Function.comp_apply, toK_pairingVal]
      change X.totalQuotientSheaf.obj.map (homOfLE hV).op (kUnitVal f⁻¹) *
          (X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE hV).op (kUnitVal f⁻¹⁻¹)) = X.toK V r
      rw [inv_inv, mul_left_comm, ← map_mul,
        show kUnitVal f⁻¹ * kUnitVal f = 1 from Units.inv_mul _, map_one, mul_one]
    rw [this]
    exact Function.bijective_id
  have : ⇑(localFrameEval (G := structureModule X.sheaf)
      (fun _ : Fin 1 ↦ D.generator hf le_rfl) hV) ∘ ⇑(sectionsMap D.negToDual V) =
      (Equiv.funUnique (Fin 1) Γ(X, V)).symm ∘ ψ := by
    funext t j
    change D.pairingVal (D.sheafR.val.presheaf.map (homOfLE hV).op (D.generator hf le_rfl))
      ((-D).sheafR.val.presheaf.map (homOfLE (le_refl V)).op t) = D.pairingVal (D.generator hf hV) t
    rw [generator_restrict, sheafR_map_id]
  rw [this]
  exact (Equiv.funUnique (Fin 1) _).symm.bijective.comp hψ

/-- **Hartshorne II.6, Proposition 6.13(b), inverse form.** Multiplication in `K_X` induces an
isomorphism `O_X(-D) ≅ O_X(D)^∨ = ℋom(O_X(D), O_X)`, sending `t` to the functional `s ↦ s t`
(`toK_dualEval_negToDual`). -/
def negIsoDual (D : X.CartierDivisor) : (-D).sheaf ≅ moduleSheafDual D.sheaf :=
  haveI := D.isIso_negToDual
  asIso D.negToDual

@[simp]
theorem negIsoDual_hom (D : X.CartierDivisor) : D.negIsoDual.hom = D.negToDual :=
  rfl

theorem eqToHom_sheafι {D D' : X.CartierDivisor} (h : D.sheaf = D'.sheaf) (hD : D = D') :
    eqToHom h ≫ D'.sheafι = D.sheafι := by
  subst hD
  simp

/-- **Hartshorne II.6, Proposition 6.13(b).** The isomorphism
`O_X(D₁ - D₂) ≅ O_X(D₁) ⊗ O_X(D₂)^∨`, the composite of `O_X(D₁ - D₂) = O_X(D₁ + (-D₂))`, the
inverse of the multiplication isomorphism `O_X(D₁) ⊗ O_X(-D₂) ≅ O_X(D₁ + (-D₂))`, and the
isomorphism `O_X(-D₂) ≅ O_X(D₂)^∨`. -/
def subIsoTensorDual (D₁ D₂ : X.CartierDivisor) :
    (D₁ - D₂).sheaf ≅ moduleSheafTensor D₁.sheaf (moduleSheafDual D₂.sheaf) :=
  eqToIso (congrArg sheaf (sub_eq_add_neg D₁ D₂)) ≪≫ (tensorIso D₁ (-D₂)).symm ≪≫
    moduleSheafTensorIsoOfIso (Iso.refl _) D₂.negIsoDual

/-- **Hartshorne II.6, Proposition 6.13(b), compatibility with `K_X`.** Under the isomorphism
`O_X(D₁) ⊗ O_X(D₂)^∨ ≅ O_X(D₁ - D₂)`, the embedding `O_X(D₁ - D₂) ⊆ K_X` becomes the product map
`O_X(D₁) ⊗ O_X(D₂)^∨ ≅ O_X(D₁) ⊗ O_X(-D₂) ⟶ K_X`, `s ⊗ t ↦ s t`. -/
theorem subIsoTensorDual_inv_comp_sheafι (D₁ D₂ : X.CartierDivisor) :
    (subIsoTensorDual D₁ D₂).inv ≫ (D₁ - D₂).sheafι =
      modulesTensorMap (𝟙 D₁.sheaf) D₂.negIsoDual.inv ≫ mulTotalQuotient D₁ (-D₂) := by
  simp only [subIsoTensorDual, Iso.trans_inv, Iso.symm_inv, eqToIso.inv, Category.assoc]
  rw [eqToHom_sheafι _ (sub_eq_add_neg D₁ D₂).symm, tensorIso_hom_comp_sheafι]
  rfl

/-- **Hartshorne II.6, Proposition 6.13(b), on sections.** For sections `s` of `O_X(D₁)` and
`t` of `O_X(-D₂)`, the isomorphism `O_X(D₁) ⊗ O_X(D₂)^∨ ≅ O_X(D₁ - D₂) ⊆ K_X` sends `s ⊗ t` to the
product `s t` in `K_X`, where `t` is viewed in `O_X(D₂)^∨` as the functional `s' ↦ s' t`. -/
theorem subIsoTensorDual_inv_tmul (D₁ D₂ : X.CartierDivisor) {U : X.Opens}
    (s : D₁.sheafR.val.presheaf.obj (op U)) (t : (-D₂).sheafR.val.presheaf.obj (op U)) :
    sectionsMap ((subIsoTensorDual D₁ D₂).inv ≫ (D₁ - D₂).sheafι) U
        ((moduleSheafTensorBilinear D₁.sheaf (moduleSheafDual D₂.sheaf)).app (op U) s
          (sectionsMap D₂.negToDual U t)) =
      tqMul (D₁.kVal s) ((-D₂).kVal t) := by
  rw [subIsoTensorDual_inv_comp_sheafι]
  change sectionsMap (mulTotalQuotient D₁ (-D₂)) U
    (sectionsMap (modulesTensorMap (𝟙 D₁.sheaf) D₂.negIsoDual.inv) U _) = _
  rw [modulesTensorMap_tmul]
  have ht : sectionsMap D₂.negIsoDual.inv U (sectionsMap D₂.negToDual U t) = t := by
    rw [← negIsoDual_hom]
    exact ConcreteCategory.congr_hom
      (congrArg (fun φ ↦ sectionsMap φ U) D₂.negIsoDual.hom_inv_id) t
  rw [ht]
  exact mulTotalQuotient_tmul D₁ (-D₂) s t

end Scheme.CartierDivisor

end

