import Hartshorne.Scheme.QuadricSurfaceClassGroup
import Hartshorne.Scheme.QuadricSurfaceSegre
import Hartshorne.Scheme.ProjHomogeneousFraction
import Hartshorne.Scheme.ProjectiveSpaceClassGroup
import Mathlib.RingTheory.MvPolynomial.IrreducibleQuadratic

/-!
# Hyperplane sections of the split quadric surface

Let `Q ⊆ ℙ³_k` be the split quadric (`Hartshorne.quadricSurfaceι`). For a hyperplane `H` of
`ℙ³_k`, the divisor `H · Q` cut on `Q` (Exercise II.6.2(a),
`Hartshorne.projectiveIntersectionDivisor`) has class `(1, 1)` in `Cl Q ≅ ℤ × ℤ`.

The hyperplane `x = s₀u₀ = 0` cuts `L₁ + L₂`: along `L₁` the local equation `x / w` is the
coordinate `s₀ / s₁` of the chart `D₊(w)`, and along `L₂` the local equation `x / z` is the
coordinate `u₀ / u₁` of the chart `D₊(z)`. For any hyperplane `ℓ = 0`, `H · Q - H₀ · Q` is the
divisor of the rational function `ℓ / x` on `Q`.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory AddMonoidAlgebra HomogeneousLocalization Order

namespace Hartshorne

universe u

variable (k : Type u) [Field k]

local notation "𝒬" => quadricGrading k

instance quadricRing_isDomain : IsDomain (QuadricRing k) := inferInstance

section LineOrders

/-- The point of the chart `D₊(f)` over a point of `Q` in `D₊(f)`. -/
theorem quadric_exists_chart_point {i j : Fin 2} {x : quadricSurface k}
    (hx : x ∈ Proj.basicOpen 𝒬 (quadricChart k i j)) :
    ∃ y : Spec (projChart 𝒬 (quadricChart k i j)),
      (projChartι 𝒬 (quadricChart_mem k i j) Nat.one_pos).base y = x := by
  rw [← Proj.opensRange_awayι 𝒬 _ (quadricChart_mem k i j) Nat.one_pos] at hx
  exact hx

/-- On a chart `D₊(sᵢuⱼ)`, the order along a prime divisor of the dehomogenization of a
degree-one monomial `m` is one when the prime ideal of the divisor on the chart is generated by
`m / sᵢuⱼ` and `m / sᵢuⱼ` maps to a variable of `k[X₀, X₁]`. -/
theorem ord_quadric_projDehom_eq_one {i j : Fin 2} {p : quadricExponents}
    (hp : single p (1 : k) ∈ 𝒬 1) {l : Fin 2}
    (hdehom : quadricDehom k i j (single p 1) = MvPolynomial.X l)
    {y : Spec (projChart 𝒬 (quadricChart k i j))}
    (hy : coheight ((projChartι 𝒬 (quadricChart_mem k i j) Nat.one_pos).base y) = 1)
    (hmem : single p (1 : k) ∈
      ((projChartι 𝒬 (quadricChart_mem k i j) Nat.one_pos).base y).asHomogeneousIdeal) :
    let _ : IsDomain (projChart 𝒬 (quadricChart k i j)) :=
      isDomain_projChart 𝒬 (quadricChart_ne_zero k i j)
    let _ : IsNoetherianRing (projChart 𝒬 (quadricChart k i j)) :=
      isNoetherianRing_projChart 𝒬 (quadricChart_mem k i j) Nat.one_pos
    (Spec (projChart 𝒬 (quadricChart k i j))).ord
      (algebraMap (projChart 𝒬 (quadricChart k i j))
        (Spec (projChart 𝒬 (quadricChart k i j))).functionField
        (projDehom 𝒬 (quadricChart_mem k i j) hp)) y = 1 := by
  intro _ _
  have hf := quadricChart_mem k i j
  have := y.isPrime
  have hy' : coheight y = 1 := by rwa [coheight_eq_of_isOpenImmersion] at hy
  have hchart : (Spec (projChart 𝒬 (quadricChart k i j))).SatisfiesConditionStar :=
    ⟨inferInstance, inferInstance, inferInstance,
      (quadricSurface_satisfiesConditionStar k).isRegularInCodimensionOne.of_isOpenImmersion
        (projChartι 𝒬 hf Nat.one_pos)⟩
  have hπy : projDehom 𝒬 hf hp ∈ y.asIdeal :=
    (ProjGradedModuleSheaf.awayι_mem_asIdeal_iff 𝒬 hf Nat.one_pos y _).mpr hmem
  have hprime : Prime (projDehom 𝒬 hf hp) := by
    have hX : Prime (quadricChartAwayEquiv k i j (projDehom 𝒬 hf hp)) := by
      change Prime (quadricAwayDehom k i j (Localization.mk _ _))
      rw [quadricAwayDehom_mk, hdehom]
      exact MvPolynomial.X_prime
    exact (MulEquiv.prime_iff (quadricChartAwayEquiv k i j).toMulEquiv).mp hX
  have hheight : y.asIdeal.height = 1 := by
    rw [idealHeight_eq_coheight]
    exact hy'
  have hspan := Ideal.eq_span_singleton_of_height_eq_one hheight hπy hprime
  exact spec_ord_algebraMap_eq_one_of_span_eq hchart hy' hspan.symm

theorem projDehom_self {i j : Fin 2} :
    projDehom 𝒬 (quadricChart_mem k i j) (quadricChart_mem k i j) = 1 := by
  apply HomogeneousLocalization.val_injective
  rw [projDehom, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_one]
  convert Localization.mk_self (⟨quadricChart k i j, 1, pow_one _⟩ : Submonoid.powers _) using 2
  exact Subtype.ext (pow_one _)

theorem Scheme.ord_one_eq_zero {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] (x : X) :
    X.ord 1 x = 0 := by
  have h := Scheme.ord_mul (x := x) (one_ne_zero (α := X.functionField)) one_ne_zero
  rw [mul_one] at h
  omega

/-- The hyperplane `x = 0` vanishes to order one along `L₁`: the order of `x / w` there is one. -/
theorem ord_quadricLineOne_projHomogeneousFraction :
    (quadricSurface k).ord (projHomogeneousFraction 𝒬 (quadricChart_mem k 0 0)
      (quadricChart_mem k 1 0) (quadricChart_ne_zero k 1 0)) (quadricLineOne k) = 1 := by
  have hx : quadricLineOne k ∈ Proj.basicOpen 𝒬 (quadricChart k 1 0) := by
    rw [Proj.mem_basicOpen]
    intro h
    exact (mem_quadricLineIdeal_iff k quadricExpS _).mp h (quadricChartExp 1 0)
      (by simp [quadricChart, coeff_single]) rfl
  have := isDomain_projChart 𝒬 (quadricChart_ne_zero k 1 0)
  have := isNoetherianRing_projChart 𝒬 (quadricChart_mem k 1 0) Nat.one_pos
  obtain ⟨y, hy⟩ := quadric_exists_chart_point k hx
  have hy1 : coheight ((projChartι 𝒬 (quadricChart_mem k 1 0) Nat.one_pos).base y) = 1 := by
    rw [hy]
    exact coheight_quadricLineOne k
  have h := ord_projHomogeneousFraction 𝒬 (quadricChart_mem k 1 0) (quadricChart_ne_zero k 1 0)
    (quadricSurface_satisfiesConditionStar k) (quadricChart_mem k 0 0) (quadricChart_mem k 1 0)
    (quadricChart_ne_zero k 0 0) (quadricChart_ne_zero k 1 0) hy1
  have h1 := ord_quadric_projDehom_eq_one k (i := 1) (j := 0) (p := quadricChartExp 0 0)
    (quadricChart_mem k 0 0) (l := 0) (by simp [quadricDehom_single, quadricChartExp]) hy1
    (by rw [hy]; exact single_mem_quadricLineIdeal k quadricExpS (by decide) 1)
  dsimp only at h h1
  rw [hy, projDehom_self] at h
  erw [map_one] at h
  rw [Scheme.ord_one_eq_zero, sub_zero] at h
  rw [h]
  exact h1

/-- The hyperplane `x = 0` vanishes to order one along `L₂`: the order of `x / z` there is one. -/
theorem ord_quadricLineTwo_projHomogeneousFraction :
    (quadricSurface k).ord (projHomogeneousFraction 𝒬 (quadricChart_mem k 0 0)
      (quadricChart_mem k 0 1) (quadricChart_ne_zero k 0 1)) (quadricLineTwo k) = 1 := by
  have hx : quadricLineTwo k ∈ Proj.basicOpen 𝒬 (quadricChart k 0 1) := by
    rw [Proj.mem_basicOpen]
    intro h
    exact (mem_quadricLineIdeal_iff k quadricExpU _).mp h (quadricChartExp 0 1)
      (by simp [quadricChart, coeff_single]) rfl
  have := isDomain_projChart 𝒬 (quadricChart_ne_zero k 0 1)
  have := isNoetherianRing_projChart 𝒬 (quadricChart_mem k 0 1) Nat.one_pos
  obtain ⟨y, hy⟩ := quadric_exists_chart_point k hx
  have hy1 : coheight ((projChartι 𝒬 (quadricChart_mem k 0 1) Nat.one_pos).base y) = 1 := by
    rw [hy]
    exact coheight_quadricLineTwo k
  have h := ord_projHomogeneousFraction 𝒬 (quadricChart_mem k 0 1) (quadricChart_ne_zero k 0 1)
    (quadricSurface_satisfiesConditionStar k) (quadricChart_mem k 0 0) (quadricChart_mem k 0 1)
    (quadricChart_ne_zero k 0 0) (quadricChart_ne_zero k 0 1) hy1
  have h1 := ord_quadric_projDehom_eq_one k (i := 0) (j := 1) (p := quadricChartExp 0 0)
    (quadricChart_mem k 0 0) (l := 1) (by simp [quadricDehom_single, quadricChartExp]) hy1
    (by rw [hy]; exact single_mem_quadricLineIdeal k quadricExpU (by decide) 1)
  dsimp only at h h1
  rw [hy, projDehom_self] at h
  erw [map_one] at h
  rw [Scheme.ord_one_eq_zero, sub_zero] at h
  rw [h]
  exact h1

/-- The chart `D₊(sᵢuⱼ)` satisfies `(*)`. -/
theorem quadric_projChart_satisfiesConditionStar (i j : Fin 2) :
    let _ : IsDomain (projChart 𝒬 (quadricChart k i j)) :=
      isDomain_projChart 𝒬 (quadricChart_ne_zero k i j)
    let _ : IsNoetherianRing (projChart 𝒬 (quadricChart k i j)) :=
      isNoetherianRing_projChart 𝒬 (quadricChart_mem k i j) Nat.one_pos
    (Spec (projChart 𝒬 (quadricChart k i j))).SatisfiesConditionStar := by
  intro _ _
  exact ⟨inferInstance, inferInstance, inferInstance,
    (quadricSurface_satisfiesConditionStar k).isRegularInCodimensionOne.of_isOpenImmersion
      (projChartι 𝒬 (quadricChart_mem k i j) Nat.one_pos)⟩

/-- On a chart `D₊(sᵢuⱼ)`, the dehomogenization of a nonzero degree-one form `g` has order zero
at a codimension-one point whose homogeneous prime does not contain `g`. -/
theorem ord_quadric_projDehom_eq_zero {i j : Fin 2} {g : QuadricRing k} (hg : g ∈ 𝒬 1)
    (g0 : g ≠ 0) {y : Spec (projChart 𝒬 (quadricChart k i j))}
    (hy : coheight ((projChartι 𝒬 (quadricChart_mem k i j) Nat.one_pos).base y) = 1)
    (hgy : g ∉ ((projChartι 𝒬 (quadricChart_mem k i j) Nat.one_pos).base y).asHomogeneousIdeal) :
    let _ : IsDomain (projChart 𝒬 (quadricChart k i j)) :=
      isDomain_projChart 𝒬 (quadricChart_ne_zero k i j)
    let _ : IsNoetherianRing (projChart 𝒬 (quadricChart k i j)) :=
      isNoetherianRing_projChart 𝒬 (quadricChart_mem k i j) Nat.one_pos
    (Spec (projChart 𝒬 (quadricChart k i j))).ord
      (algebraMap (projChart 𝒬 (quadricChart k i j))
        (Spec (projChart 𝒬 (quadricChart k i j))).functionField
        (projDehom 𝒬 (quadricChart_mem k i j) hg)) y = 0 := by
  intro _ _
  have hy' : coheight y = 1 := by rwa [coheight_eq_of_isOpenImmersion] at hy
  refine (spec_ord_algebraMap_eq_zero_iff (quadric_projChart_satisfiesConditionStar k i j) hy'
    (projDehom_ne_zero 𝒬 (quadricChart_mem k i j) (quadricChart_ne_zero k i j) hg g0)).mpr ?_
  exact fun h ↦ hgy ((ProjGradedModuleSheaf.awayι_mem_asIdeal_iff 𝒬 (quadricChart_mem k i j)
    Nat.one_pos y _).mp h)

/-- The order of `g / sᵢuⱼ` at a point of the chart `D₊(sᵢuⱼ)` is the order of its
dehomogenization. -/
theorem ord_projHomogeneousFraction_quadricChart {i j : Fin 2} {g : QuadricRing k}
    (hg : g ∈ 𝒬 1) (g0 : g ≠ 0) {y : Spec (projChart 𝒬 (quadricChart k i j))}
    (hy : coheight ((projChartι 𝒬 (quadricChart_mem k i j) Nat.one_pos).base y) = 1) :
    let _ : IsDomain (projChart 𝒬 (quadricChart k i j)) :=
      isDomain_projChart 𝒬 (quadricChart_ne_zero k i j)
    let _ : IsNoetherianRing (projChart 𝒬 (quadricChart k i j)) :=
      isNoetherianRing_projChart 𝒬 (quadricChart_mem k i j) Nat.one_pos
    (quadricSurface k).ord (projHomogeneousFraction 𝒬 hg (quadricChart_mem k i j)
        (quadricChart_ne_zero k i j)) ((projChartι 𝒬 (quadricChart_mem k i j) Nat.one_pos).base y) =
      (Spec (projChart 𝒬 (quadricChart k i j))).ord
        (algebraMap (projChart 𝒬 (quadricChart k i j))
          (Spec (projChart 𝒬 (quadricChart k i j))).functionField
          (projDehom 𝒬 (quadricChart_mem k i j) hg)) y := by
  intro _ _
  have h := ord_projHomogeneousFraction 𝒬 (quadricChart_mem k i j) (quadricChart_ne_zero k i j)
    (quadricSurface_satisfiesConditionStar k) hg (quadricChart_mem k i j) g0
    (quadricChart_ne_zero k i j) hy
  dsimp only at h
  rw [h, projDehom_self]
  erw [map_one]
  rw [Scheme.ord_one_eq_zero, sub_zero]

end LineOrders

section Rulings

local notation "hQ" => quadricSurface_satisfiesConditionStar k

/-- A nonconstant linear polynomial `β - αXₗ` in two variables is prime. -/
theorem prime_C_sub_C_mul_X {α β : k} (hα : α ≠ 0) (l : Fin 2) :
    Prime (MvPolynomial.C β - MvPolynomial.C α * MvPolynomial.X l : MvPolynomial (Fin 2) k) := by
  classical
  rw [← UniqueFactorizationMonoid.irreducible_iff_prime]
  have hcoeff : (MvPolynomial.C β - MvPolynomial.C α * MvPolynomial.X l :
      MvPolynomial (Fin 2) k).coeff (Finsupp.single l 1) = -α := by
    rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_C, MvPolynomial.coeff_C_mul,
      MvPolynomial.coeff_X, if_neg (Finsupp.single_ne_zero.mpr one_ne_zero).symm]
    simp
  apply MvPolynomial.irreducible_of_totalDegree_eq_one
  · apply le_antisymm
    · refine (MvPolynomial.totalDegree_sub _ _).trans (max_le ?_ ?_)
      · rw [MvPolynomial.totalDegree_C]
        exact zero_le_one
      · exact (MvPolynomial.totalDegree_mul _ _).trans (by
          rw [MvPolynomial.totalDegree_C, MvPolynomial.totalDegree_X, zero_add])
    · have hmem : Finsupp.single l 1 ∈ (MvPolynomial.C β - MvPolynomial.C α * MvPolynomial.X l :
          MvPolynomial (Fin 2) k).support := by
        rw [MvPolynomial.mem_support_iff, hcoeff]
        exact neg_ne_zero.mpr hα
      have := MvPolynomial.le_totalDegree hmem
      simpa using this
  · intro x hx
    exact isUnit_of_dvd_unit (hx (Finsupp.single l 1))
      (by rw [hcoeff]; exact (neg_ne_zero.mpr hα).isUnit)

/-- The point `(π)` of the chart `Spec S_(s₀u₀)`, for a prime element `π`. -/
def quadricChartPrimeSpecPoint {π : projChart 𝒬 (quadricChart k 0 0)} (hπ : Prime π) :
    Spec (projChart 𝒬 (quadricChart k 0 0)) :=
  ⟨Ideal.span {π}, (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ⟩

theorem quadricChartPrimeSpecPoint_asIdeal {π : projChart 𝒬 (quadricChart k 0 0)}
    (hπ : Prime π) : (quadricChartPrimeSpecPoint k hπ).asIdeal = Ideal.span {π} :=
  rfl

/-- The point of `Q` over the prime `(π)` of the chart `D₊(s₀u₀)`, for a prime element `π`. -/
def quadricChartPrimePoint {π : projChart 𝒬 (quadricChart k 0 0)} (hπ : Prime π) :
    quadricSurface k :=
  (projChartι 𝒬 (quadricChart_mem k 0 0) Nat.one_pos).base (quadricChartPrimeSpecPoint k hπ)

theorem coheight_quadricChartPrimePoint {π : projChart 𝒬 (quadricChart k 0 0)} (hπ : Prime π) :
    coheight (quadricChartPrimePoint k hπ) = 1 := by
  rw [quadricChartPrimePoint, coheight_eq_of_isOpenImmersion, ← idealHeight_eq_coheight,
    quadricChartPrimeSpecPoint_asIdeal]
  have hP : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  have := isNoetherianRing_projChart 𝒬 (quadricChart_mem k 0 0) Nat.one_pos
  have := isDomain_projChart 𝒬 (quadricChart_ne_zero k 0 0)
  have hprin : (Ideal.span {π}).IsPrincipal := ⟨⟨π, rfl⟩⟩
  apply le_antisymm
  · exact Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ _
      ⟨⟨hP, le_rfl⟩, fun q hq _ ↦ hq.2⟩
  · rw [Order.one_le_iff_ne_zero]
    intro h
    have hbot : Ideal.span {π} = ⊥ := Ideal.height_eq_zero_iff_eq_bot.mp h
    exact hπ.ne_zero (Ideal.span_singleton_eq_bot.mp hbot)

theorem quadricChartPrimePoint_mem_basicOpen {π : projChart 𝒬 (quadricChart k 0 0)} (hπ : Prime π) :
    quadricChartPrimePoint k hπ ∈ Proj.basicOpen 𝒬 (quadricChart k 0 0) :=
  projChartι_base_mem 𝒬 _ _ _

/-- The prime divisor of `Q` over the prime `(π)` of the chart `D₊(s₀u₀)`. -/
def quadricChartPrimeDivisor {π : projChart 𝒬 (quadricChart k 0 0)} (hπ : Prime π) :
    (quadricSurface k).PrimeDivisor :=
  ⟨quadricChartPrimePoint k hπ, coheight_quadricChartPrimePoint k hπ⟩

open Classical in
/-- On the chart `D₊(s₀u₀)`, the order of `π` is one at `(π)` and zero at the other
codimension-one points. -/
theorem ord_quadricChartPrime {π : projChart 𝒬 (quadricChart k 0 0)} (hπ : Prime π)
    {y : Spec (projChart 𝒬 (quadricChart k 0 0))} (hy : coheight y = 1) :
    let _ : IsDomain (projChart 𝒬 (quadricChart k 0 0)) :=
      isDomain_projChart 𝒬 (quadricChart_ne_zero k 0 0)
    let _ : IsNoetherianRing (projChart 𝒬 (quadricChart k 0 0)) :=
      isNoetherianRing_projChart 𝒬 (quadricChart_mem k 0 0) Nat.one_pos
    (Spec (projChart 𝒬 (quadricChart k 0 0))).ord
      (algebraMap (projChart 𝒬 (quadricChart k 0 0))
        (Spec (projChart 𝒬 (quadricChart k 0 0))).functionField π) y =
      if (projChartι 𝒬 (quadricChart_mem k 0 0) Nat.one_pos).base y =
        quadricChartPrimePoint k hπ then 1 else 0 := by
  intro _ _
  have := y.isPrime
  have hheight : y.asIdeal.height = 1 := by rw [idealHeight_eq_coheight]; exact hy
  split_ifs with h
  · have hy' : y = ⟨Ideal.span {π}, (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ⟩ :=
      (projChartι 𝒬 (quadricChart_mem k 0 0) Nat.one_pos).isOpenEmbedding.injective h
    exact spec_ord_algebraMap_eq_one_of_span_eq (quadric_projChart_satisfiesConditionStar k 0 0)
      hy (by rw [hy'])
  · refine (spec_ord_algebraMap_eq_zero_iff (quadric_projChart_satisfiesConditionStar k 0 0) hy
      hπ.ne_zero).mpr fun hmem ↦ h ?_
    have hspan := Ideal.eq_span_singleton_of_height_eq_one hheight hmem hπ
    rw [quadricChartPrimePoint]
    congr 1
    exact PrimeSpectrum.ext hspan

/-- The relation `wz = yx`, i.e. `(s₁u₀)(s₀u₁) = (s₁u₁)(s₀u₀)`. -/
theorem quadricChart_relation :
    quadricChart k 1 0 * quadricChart k 0 1 = quadricChart k 1 1 * quadricChart k 0 0 := by
  rw [quadricChart, quadricChart, quadricChart, quadricChart, single_mul_single,
    single_mul_single]
  congr 1
  apply Subtype.ext
  apply Prod.ext <;> funext l <;> fin_cases l <;> simp [quadricChartExp]

/-- The form `βs₀uⱼ - αs₁uⱼ`, vanishing on the line `{[α : β]} × ℙ¹` of the first ruling. -/
def quadricRulingFormOne (α β : k) (j : Fin 2) : QuadricRing k :=
  β • quadricChart k 0 j - α • quadricChart k 1 j

theorem quadricRulingFormOne_mem (α β : k) (j : Fin 2) : quadricRulingFormOne k α β j ∈ 𝒬 1 :=
  sub_mem (Submodule.smul_mem _ _ (quadricChart_mem k 0 j))
    (Submodule.smul_mem _ _ (quadricChart_mem k 1 j))

theorem quadricRulingFormOne_coeff (α β : k) (j : Fin 2) :
    (quadricRulingFormOne k α β j).coeff (quadricChartExp 1 j) = -α := by
  have hne : quadricChartExp 0 j ≠ quadricChartExp 1 j := by
    intro h
    have := congrArg (fun p : quadricExponents => p.1.1 0) h
    simp [quadricChartExp] at this
  simp [quadricRulingFormOne, quadricChart, coeff_sub, coeff_single, hne]

theorem quadricRulingFormOne_ne_zero {α : k} (hα : α ≠ 0) (β : k) (j : Fin 2) :
    quadricRulingFormOne k α β j ≠ 0 := by
  intro h
  have := quadricRulingFormOne_coeff k α β j
  rw [h] at this
  exact hα (neg_eq_zero.mp (by simpa using this.symm))

/-- `βs₀u₀ - αs₁u₀ ∉ L₁` when `α ≠ 0`. -/
theorem quadricRulingFormOne_notMem_lineOne {α : k} (hα : α ≠ 0) (β : k) (j : Fin 2) :
    quadricRulingFormOne k α β j ∉ (quadricLineOne k).asHomogeneousIdeal := by
  intro h
  refine (mem_quadricLineIdeal_iff k quadricExpS _).mp h (quadricChartExp 1 j) ?_ rfl
  rw [Finsupp.mem_support_iff, quadricRulingFormOne_coeff]
  exact neg_ne_zero.mpr hα

/-- `βs₀u₁ - αs₁u₁ ∉ L₂` when `α ≠ 0`. -/
theorem quadricRulingFormOne_notMem_lineTwo {α : k} (hα : α ≠ 0) (β : k) :
    quadricRulingFormOne k α β 1 ∉ (quadricLineTwo k).asHomogeneousIdeal := by
  intro h
  refine (mem_quadricLineIdeal_iff k quadricExpU _).mp h (quadricChartExp 1 1) ?_ rfl
  rw [Finsupp.mem_support_iff, quadricRulingFormOne_coeff]
  exact neg_ne_zero.mpr hα

/-- The element `β - α (s₁u₀ / s₀u₀)` of the chart `D₊(s₀u₀)`. -/
def quadricRulingOneElem (α β : k) : projChart 𝒬 (quadricChart k 0 0) :=
  projDehom 𝒬 (quadricChart_mem k 0 0) (quadricRulingFormOne_mem k α β 0)

theorem prime_quadricRulingOneElem {α : k} (hα : α ≠ 0) (β : k) :
    Prime (quadricRulingOneElem k α β) := by
  have hX : Prime (quadricChartAwayEquiv k 0 0 (quadricRulingOneElem k α β)) := by
    change Prime (quadricAwayDehom k 0 0 (Localization.mk _ _))
    rw [quadricAwayDehom_mk]
    convert prime_C_sub_C_mul_X k (β := β) hα 0 using 1
    simp [quadricRulingFormOne, quadricDehom_single, quadricChart, quadricChartExp,
      MvPolynomial.smul_eq_C_mul]
  exact (MulEquiv.prime_iff (quadricChartAwayEquiv k 0 0).toMulEquiv).mp hX

/-- **The lines of the first ruling.** For `α ≠ 0`, the line `{[α : β]} × ℙ¹ = V(βs₀ - αs₁)` of
`Q`, as the prime divisor over the prime `(β - α s₁/s₀)` of the chart `D₊(s₀u₀)`. (The remaining
line of the ruling, over `[0 : 1]`, is `L₁`.) -/
def quadricRulingOneDivisor {α : k} (hα : α ≠ 0) (β : k) : (quadricSurface k).PrimeDivisor :=
  quadricChartPrimeDivisor k (prime_quadricRulingOneElem k hα β)

/-- The forms `βs₀uⱼ - αs₁uⱼ` vanish on the line `{[α : β]} × ℙ¹`. -/
theorem quadricRulingFormOne_mem_rulingOneDivisor {α : k} (hα : α ≠ 0) (β : k) (j : Fin 2) :
    quadricRulingFormOne k α β j ∈ (quadricRulingOneDivisor k hα β).1.asHomogeneousIdeal := by
  have h0 : quadricRulingFormOne k α β 0 ∈ (quadricRulingOneDivisor k hα β).1.asHomogeneousIdeal :=
    (ProjGradedModuleSheaf.awayι_mem_asIdeal_iff 𝒬 (quadricChart_mem k 0 0) Nat.one_pos
      (quadricChartPrimeSpecPoint k (prime_quadricRulingOneElem k hα β))
      ⟨1, ⟨_, quadricRulingFormOne_mem k α β 0⟩,
        ⟨_, pow_mem_graded_one 𝒬 (quadricChart_mem k 0 0) 1⟩, ⟨1, rfl⟩⟩).mp
      (Ideal.mem_span_singleton_self (quadricRulingOneElem k α β))
  fin_cases j
  · exact h0
  · -- `(βs₀u₁ - αs₁u₁) · s₀u₀ = (βs₀u₀ - αs₁u₀) · s₀u₁`, and `s₀u₀` is not on the line
    have hrel : quadricRulingFormOne k α β 1 * quadricChart k 0 0 =
        quadricRulingFormOne k α β 0 * quadricChart k 0 1 := by
      simp only [quadricRulingFormOne, Algebra.smul_def]
      linear_combination (algebraMap k (QuadricRing k) α) * quadricChart_relation k
    have hmem := Ideal.mul_mem_right (quadricChart k 0 1) _ h0
    rw [← hrel] at hmem
    exact (Ideal.IsPrime.mem_or_mem (quadricRulingOneDivisor k hα β).1.isPrime hmem).resolve_right
      (quadricChartPrimePoint_mem_basicOpen k _)

theorem quadricRulingOneDivisor_ne_lineOne {α : k} (hα : α ≠ 0) (β : k) :
    quadricLineOne k ≠ (quadricRulingOneDivisor k hα β).1 :=
  fun h ↦ quadricLineOne_ne_of_mem k (quadricChartPrimePoint_mem_basicOpen k _) h.symm
/-- The rational function `(βs₀ - αs₁)/s₀ = (βs₀u₀ - αs₁u₀)/(s₀u₀)` on `Q`. -/
def quadricRulingOneRatio {α : k} (hα : α ≠ 0) (β : k) : (quadricSurface k).functionFieldˣ :=
  Units.mk0 (projHomogeneousFraction 𝒬 (quadricRulingFormOne_mem k α β 0) (quadricChart_mem k 0 0)
      (quadricChart_ne_zero k 0 0))
    (projHomogeneousFraction_ne_zero 𝒬 _ _ _ (quadricRulingFormOne_ne_zero k hα β 0))

/-- **The line `{[α : β]} × ℙ¹` is linearly equivalent to `L₁`**:
`div((βs₀ - αs₁)/s₀) = {[α : β]} × ℙ¹ - L₁`. -/
theorem quadricRulingOneDivisor_sub_lineOne {α : k} (hα : α ≠ 0) (β : k) :
    (quadricRulingOneDivisor k hα β).toWeilDivisor - (quadricLineOneDivisor k).toWeilDivisor =
      (quadricSurface k).principalDivisor hQ (quadricRulingOneRatio k hα β) := by
  have := isDomain_projChart 𝒬 (quadricChart_ne_zero k 0 0)
  have := isNoetherianRing_projChart 𝒬 (quadricChart_mem k 0 0) Nat.one_pos
  apply Scheme.WeilDivisor.ext_apply
  intro x
  rw [Scheme.principalDivisor_apply hQ, quadricRulingOneRatio, Units.val_mk0]
  simp only [AddSubgroup.coe_sub, Function.locallyFinsuppWithin.coe_sub, Pi.sub_apply]
  by_cases hx1 : coheight x = 1
  swap
  · rw [Scheme.ord_eq_zero_of_coheight_neq_one hx1,
      (quadricRulingOneDivisor k hα β).toWeilDivisor.2 x hx1,
      (quadricLineOneDivisor k).toWeilDivisor.2 x hx1, sub_zero]
  by_cases hxU : x ∈ Proj.basicOpen 𝒬 (quadricChart k 0 0)
  · obtain ⟨y, rfl⟩ := quadric_exists_chart_point k hxU
    have hy' : coheight y = 1 := by rwa [coheight_eq_of_isOpenImmersion] at hx1
    have h := ord_projHomogeneousFraction_quadricChart k (quadricRulingFormOne_mem k α β 0)
      (quadricRulingFormOne_ne_zero k hα β 0) hx1
    have h' := ord_quadricChartPrime k (prime_quadricRulingOneElem k hα β) hy'
    dsimp only at h h'
    rw [h]
    erw [h']
    rw [Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _ (quadricLineOne_ne_of_mem k hxU),
      sub_zero]
    split_ifs with hM
    · rw [hM]
      exact Scheme.PrimeDivisor.toWeilDivisor_apply_self _
    · exact Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _ hM
  rcases eq_quadricLine_of_notMem_basicOpen k hx1 hxU with rfl | rfl
  · have hxw : quadricLineOne k ∈ Proj.basicOpen 𝒬 (quadricChart k 1 0) := by
      rw [Proj.mem_basicOpen]
      intro h
      exact (mem_quadricLineIdeal_iff k quadricExpS _).mp h (quadricChartExp 1 0)
        (by simp [quadricChart, coeff_single]) rfl
    have := isDomain_projChart 𝒬 (quadricChart_ne_zero k 1 0)
    have := isNoetherianRing_projChart 𝒬 (quadricChart_mem k 1 0) Nat.one_pos
    obtain ⟨y, hy⟩ := quadric_exists_chart_point k hxw
    have hy1 : coheight ((projChartι 𝒬 (quadricChart_mem k 1 0) Nat.one_pos).base y) = 1 := by
      rw [hy]
      exact coheight_quadricLineOne k
    have h := ord_projHomogeneousFraction 𝒬 (quadricChart_mem k 1 0) (quadricChart_ne_zero k 1 0)
      (quadricSurface_satisfiesConditionStar k) (quadricRulingFormOne_mem k α β 0)
      (quadricChart_mem k 0 0) (quadricRulingFormOne_ne_zero k hα β 0)
      (quadricChart_ne_zero k 0 0) hy1
    have h0 := ord_quadric_projDehom_eq_zero k (quadricRulingFormOne_mem k α β 0)
      (quadricRulingFormOne_ne_zero k hα β 0) hy1
      (by rw [hy]; exact quadricRulingFormOne_notMem_lineOne k hα β 0)
    have h1 := ord_quadric_projDehom_eq_one k (i := 1) (j := 0) (p := quadricChartExp 0 0)
      (quadricChart_mem k 0 0) (l := 0) (by simp [quadricDehom_single, quadricChartExp]) hy1
      (by rw [hy]; exact single_mem_quadricLineIdeal k quadricExpS (by decide) 1)
    dsimp only at h h0 h1
    rw [hy, h0] at h
    erw [h1] at h
    rw [h, Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _
        (quadricRulingOneDivisor_ne_lineOne k hα β),
      show quadricLineOne k = (quadricLineOneDivisor k).1 from rfl,
      Scheme.PrimeDivisor.toWeilDivisor_apply_self]
  · have hxz : quadricLineTwo k ∈ Proj.basicOpen 𝒬 (quadricChart k 0 1) := by
      rw [Proj.mem_basicOpen]
      intro h
      exact (mem_quadricLineIdeal_iff k quadricExpU _).mp h (quadricChartExp 0 1)
        (by simp [quadricChart, coeff_single]) rfl
    have := isDomain_projChart 𝒬 (quadricChart_ne_zero k 0 1)
    have := isNoetherianRing_projChart 𝒬 (quadricChart_mem k 0 1) Nat.one_pos
    obtain ⟨y, hy⟩ := quadric_exists_chart_point k hxz
    have hy1 : coheight ((projChartι 𝒬 (quadricChart_mem k 0 1) Nat.one_pos).base y) = 1 := by
      rw [hy]
      exact coheight_quadricLineTwo k
    have heq : projHomogeneousFraction 𝒬 (quadricRulingFormOne_mem k α β 0)
        (quadricChart_mem k 0 0) (quadricChart_ne_zero k 0 0) =
        projHomogeneousFraction 𝒬 (quadricRulingFormOne_mem k α β 1)
          (quadricChart_mem k 0 1) (quadricChart_ne_zero k 0 1) := by
      apply projHomogeneousFraction_eq_of_mul_eq
      simp only [quadricRulingFormOne, Algebra.smul_def]
      linear_combination (-(algebraMap k (QuadricRing k) α)) * quadricChart_relation k
    have h := ord_projHomogeneousFraction_quadricChart k (quadricRulingFormOne_mem k α β 1)
      (quadricRulingFormOne_ne_zero k hα β 1) hy1
    have h0 := ord_quadric_projDehom_eq_zero k (quadricRulingFormOne_mem k α β 1)
      (quadricRulingFormOne_ne_zero k hα β 1) hy1
      (by rw [hy]; exact quadricRulingFormOne_notMem_lineTwo k hα β)
    dsimp only at h h0
    rw [hy, h0] at h
    have hM : quadricLineTwo k ≠ (quadricRulingOneDivisor k hα β).1 :=
      fun h ↦ quadricLineTwo_ne_of_mem k (quadricChartPrimePoint_mem_basicOpen k _) h.symm
    rw [heq, h, Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _ hM,
      Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _ (quadricLineOne_ne_quadricLineTwo k).symm]
    rfl

/-- **The first ruling has class `(1, 0)`**: every line `{[α : β]} × ℙ¹` (`α ≠ 0`; the line
over `[0 : 1]` is `L₁`, `quadricSurfaceClassGroupEquiv_lineOne`). -/
theorem quadricSurfaceClassGroupEquiv_rulingOne {α : k} (hα : α ≠ 0) (β : k) :
    quadricSurfaceClassGroupEquiv k ((quadricSurface k).weilDivisorClassHom hQ
      (quadricRulingOneDivisor k hα β).toWeilDivisor) = (1, 0) := by
  have hcl : (quadricSurface k).weilDivisorClassHom hQ
      (quadricRulingOneDivisor k hα β).toWeilDivisor =
      (quadricSurface k).weilDivisorClassHom hQ (quadricLineOneDivisor k).toWeilDivisor :=
    ((quadricSurface k).weilDivisorClass_eq_iff hQ _ _).mpr
      ⟨quadricRulingOneRatio k hα β, quadricRulingOneDivisor_sub_lineOne k hα β⟩
  rw [hcl]
  exact quadricSurfaceClassGroupEquiv_lineOne k

end Rulings

section Hyperplane

attribute [local instance] MvPolynomial.gradedAlgebra

local notation "𝒮" => MvPolynomial.homogeneousSubmodule (Fin (3 + 1)) k

local notation "hQ" => quadricSurface_satisfiesConditionStar k

theorem quadricCoordinateHom_X_ne_zero (i : Fin (3 + 1)) :
    quadricCoordinateHom k (MvPolynomial.X i) ≠ 0 := by
  rw [quadricCoordinateHom_apply, quadricCoordinateAlgHom_X]
  fin_cases i <;> exact quadricChart_ne_zero k _ _

theorem quadricCoordinateHom_X_mem (i : Fin (3 + 1)) :
    quadricCoordinateHom k (MvPolynomial.X i) ∈ 𝒬 1 :=
  (quadricCoordinateHom k).map_mem (Hartshorne.X_mem_homogeneousSubmodule_one k i)

theorem quadricCoordinateHom_mem_of_isHomogeneous {ℓ : MvPolynomial (Fin (3 + 1)) k}
    (hℓ : ℓ.IsHomogeneous 1) : quadricCoordinateHom k ℓ ∈ 𝒬 1 :=
  (quadricCoordinateHom k).map_mem ((MvPolynomial.mem_homogeneousSubmodule 1 ℓ).mpr hℓ)

theorem quadricRelation_isHomogeneous : (quadricRelation k).IsHomogeneous 2 :=
  ((MvPolynomial.isHomogeneous_X k 0).mul (MvPolynomial.isHomogeneous_X k 1)).sub
    ((MvPolynomial.isHomogeneous_X k 2).mul (MvPolynomial.isHomogeneous_X k 3))

theorem quadricRelation_ne_zero : quadricRelation k ≠ 0 := by
  intro h
  have := congrArg (MvPolynomial.eval ![(1 : k), 1, 0, 0]) h
  simp [quadricRelation] at this

/-- A nonzero linear form does not vanish on `Q`. -/
theorem quadricCoordinateHom_ne_zero_of_isHomogeneous_one {ℓ : MvPolynomial (Fin (3 + 1)) k}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) : quadricCoordinateHom k ℓ ≠ 0 := by
  intro h
  have hker : ℓ ∈ RingHom.ker (quadricCoordinateAlgHom k) := h
  rw [ker_quadricCoordinateAlgHom, Ideal.mem_span_singleton] at hker
  obtain ⟨r, rfl⟩ := hker
  have hr : r ≠ 0 := by
    rintro rfl
    exact hℓ0 (mul_zero _)
  have hdeg := MvPolynomial.totalDegree_mul_of_isDomain (quadricRelation_ne_zero k) hr
  rw [hℓ.totalDegree hℓ0, (quadricRelation_isHomogeneous k).totalDegree
    (quadricRelation_ne_zero k)] at hdeg
  omega

/-- No hyperplane contains `Q`. -/
theorem quadricSurface_not_subset_hyperplane {ℓ : MvPolynomial (Fin (3 + 1)) k}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) :
    ¬Set.range (quadricSurfaceι k).base ⊆
      closure ({(projectiveHyperplanePrimeDivisor (n := 3) (by norm_num) hℓ hℓ0).1} :
        Set (Proj 𝒮)) := by
  intro hsub
  have hmem := hsub ⟨genericPoint (quadricSurface k), rfl⟩
  rw [← specializes_iff_mem_closure, projectiveSpace_specializes_iff_le] at hmem
  have hℓmem : ℓ ∈ ((quadricSurfaceι k).base (genericPoint (quadricSurface k))).asHomogeneousIdeal :=
    hmem (Ideal.subset_span rfl)
  have hφ : quadricCoordinateHom k ℓ ∈
      (genericPoint (quadricSurface k)).asHomogeneousIdeal.toIdeal := hℓmem
  rw [genericPoint_proj_asIdeal_eq_bot] at hφ
  exact quadricCoordinateHom_ne_zero_of_isHomogeneous_one k hℓ hℓ0
    ((Submodule.mem_bot _).mp hφ)

set_option backward.isDefEq.respectTransparency false in
/-- **The coefficients of a hyperplane section.** For a hyperplane `ℓ = 0` and a point `x` of `Q`
off the coordinate hyperplane `X_i = 0`, the coefficient of `H · Q` at `x` is the order at `x` of
the rational function `ℓ / X_i` on `Q`. -/
theorem quadricHyperplaneSection_apply {ℓ : MvPolynomial (Fin (3 + 1)) k}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) (x : quadricSurface k) (i : Fin (3 + 1))
    (hi : quadricCoordinateHom k (MvPolynomial.X i) ∉ x.asHomogeneousIdeal) :
    (projectiveIntersectionDivisor (quadricSurfaceι k) hQ
        (projectiveHyperplanePrimeDivisor (n := 3) (by norm_num) hℓ hℓ0)).1 x =
      (quadricSurface k).ord (projHomogeneousFraction 𝒬
        (quadricCoordinateHom_mem_of_isHomogeneous k hℓ) (quadricCoordinateHom_X_mem k i)
        (quadricCoordinateHom_X_ne_zero k i)) x := by
  have hx : (quadricSurfaceι k).base x ∈ Proj.basicOpen 𝒮 (MvPolynomial.X i) := hi
  have hh : IsProjectiveHypersurfaceLocalEquation
      (projectiveHyperplanePrimeDivisor (n := 3) (by norm_num) hℓ hℓ0)
      (Proj.basicOpen 𝒮 (MvPolynomial.X i))
      (hypersurfaceChartEquation ℓ (MvPolynomial.X i) hℓ (MvPolynomial.isHomogeneous_X k i)) :=
    fun _ hq ↦ ⟨ℓ, MvPolynomial.X i, 1, hℓ, MvPolynomial.isHomogeneous_X k i, hq, rfl,
      Associated.refl _⟩
  have h := projectiveIntersectionDivisor_apply_eq_ord (quadricSurfaceι k) hQ _
    (quadricSurface_not_subset_hyperplane k hℓ hℓ0) x _ _ hx hh
  dsimp only at h
  rw [h]
  congr 1
  have : Nonempty ((quadricSurfaceι k) ⁻¹ᵁ Proj.basicOpen 𝒮 (MvPolynomial.X i)) := ⟨⟨x, hx⟩⟩
  rw [Scheme.algebraMap_germ_eq_germToFunctionField, ← germ_awayToSection_mk]
  have happ := ConcreteCategory.congr_hom (Proj.awayToSection_comp_appLE
    (quadricCoordinateHom k) (irrelevant_le_map_quadricCoordinateHom k)
    (Hartshorne.X_mem_homogeneousSubmodule_one k i))
    (HomogeneousLocalization.mk ⟨1, ⟨ℓ, (MvPolynomial.mem_homogeneousSubmodule 1 ℓ).mpr hℓ⟩,
      ⟨MvPolynomial.X i, Hartshorne.X_mem_homogeneousSubmodule_one k i⟩,
      Submonoid.mem_powers _⟩)
  rw [Scheme.Hom.app_eq_appLE]
  exact congrArg _ happ

theorem quadricCoordinateHom_X_eq (l : Fin (3 + 1)) :
    quadricCoordinateHom k (MvPolynomial.X l) = quadricCoordinates k l := by
  rw [quadricCoordinateHom_apply, quadricCoordinateAlgHom_X]

/-- Every point of `Q` lies off one of the coordinate hyperplanes. -/
theorem quadric_exists_coordinate_notMem (x : quadricSurface k) :
    ∃ i : Fin (3 + 1), quadricCoordinateHom k (MvPolynomial.X i) ∉ x.asHomogeneousIdeal := by
  by_contra hall
  push Not at hall
  apply x.not_irrelevant_le
  refine (quadric_irrelevant_le_span k).trans (Ideal.span_le.mpr ?_)
  rintro _ ⟨⟨a, b⟩, rfl⟩
  have h : ∀ l, quadricCoordinates k l ∈ x.asHomogeneousIdeal := fun l ↦ by
    rw [← quadricCoordinateHom_X_eq]
    exact hall l
  fin_cases a <;> fin_cases b
  · exact h 0
  · exact h 2
  · exact h 3
  · exact h 1

/-- The coordinate hyperplane `x = s₀u₀ = 0` of `ℙ³_k`. -/
abbrev quadricHyperplaneX : (Proj 𝒮).PrimeDivisor :=
  projectiveHyperplanePrimeDivisor (n := 3) (by norm_num) (MvPolynomial.isHomogeneous_X k 0)
    (MvPolynomial.X_ne_zero 0)

/-- **The section `x = 0`.** The hyperplane `x = s₀u₀ = 0` cuts `L₁ + L₂` on `Q`. -/
theorem quadricHyperplaneSection_X :
    projectiveIntersectionDivisor (quadricSurfaceι k) hQ (quadricHyperplaneX k) =
      (quadricLineOneDivisor k).toWeilDivisor + (quadricLineTwoDivisor k).toWeilDivisor := by
  apply Scheme.WeilDivisor.ext_apply
  intro x
  simp only [AddSubgroup.coe_add, Function.locallyFinsuppWithin.coe_add, Pi.add_apply]
  by_cases hx1 : coheight x = 1
  swap
  · rw [(projectiveIntersectionDivisor _ hQ _).2 x hx1,
      (quadricLineOneDivisor k).toWeilDivisor.2 x hx1,
      (quadricLineTwoDivisor k).toWeilDivisor.2 x hx1, add_zero]
  by_cases hxU : x ∈ Proj.basicOpen 𝒬 (quadricChart k 0 0)
  · have hi : quadricCoordinateHom k (MvPolynomial.X 0) ∉ x.asHomogeneousIdeal := by
      rw [quadricCoordinateHom_X_eq]
      exact hxU
    rw [quadricHyperplaneSection_apply k _ _ x 0 hi, projHomogeneousFraction_self,
      Scheme.ord_one_eq_zero,
      Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _ (quadricLineOne_ne_of_mem k hxU),
      Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _ (quadricLineTwo_ne_of_mem k hxU), add_zero]
  rcases eq_quadricLine_of_notMem_basicOpen k hx1 hxU with rfl | rfl
  · have hi : quadricCoordinateHom k (MvPolynomial.X 3) ∉
        (quadricLineOne k).asHomogeneousIdeal := by
      rw [quadricCoordinateHom_X_eq]
      intro h
      exact (mem_quadricLineIdeal_iff k quadricExpS _).mp h (quadricChartExp 1 0)
        (by simp [quadricCoordinates, quadricChart, coeff_single]) rfl
    rw [quadricHyperplaneSection_apply k _ _ _ 3 hi,
      projHomogeneousFraction_eq_of_mul_eq 𝒬 _ _ _ (quadricChart_mem k 0 0)
        (quadricChart_mem k 1 0) (quadricChart_ne_zero k 1 0)
        (by rw [quadricCoordinateHom_X_eq, quadricCoordinateHom_X_eq]; rfl),
      ord_quadricLineOne_projHomogeneousFraction,
      show quadricLineOne k = (quadricLineOneDivisor k).1 from rfl,
      Scheme.PrimeDivisor.toWeilDivisor_apply_self,
      Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _ (quadricLineOne_ne_quadricLineTwo k),
      add_zero]
  · have hi : quadricCoordinateHom k (MvPolynomial.X 2) ∉
        (quadricLineTwo k).asHomogeneousIdeal := by
      rw [quadricCoordinateHom_X_eq]
      intro h
      exact (mem_quadricLineIdeal_iff k quadricExpU _).mp h (quadricChartExp 0 1)
        (by simp [quadricCoordinates, quadricChart, coeff_single]) rfl
    rw [quadricHyperplaneSection_apply k _ _ _ 2 hi,
      projHomogeneousFraction_eq_of_mul_eq 𝒬 _ _ _ (quadricChart_mem k 0 0)
        (quadricChart_mem k 0 1) (quadricChart_ne_zero k 0 1)
        (by rw [quadricCoordinateHom_X_eq, quadricCoordinateHom_X_eq]; rfl),
      ord_quadricLineTwo_projHomogeneousFraction,
      show quadricLineTwo k = (quadricLineTwoDivisor k).1 from rfl,
      Scheme.PrimeDivisor.toWeilDivisor_apply_self,
      Scheme.PrimeDivisor.toWeilDivisor_apply_of_ne _ (quadricLineOne_ne_quadricLineTwo k).symm,
      zero_add]

/-- The rational function `ℓ / x` on `Q`, for a nonzero linear form `ℓ`. -/
def quadricHyperplaneRatio {ℓ : MvPolynomial (Fin (3 + 1)) k} (hℓ : ℓ.IsHomogeneous 1)
    (hℓ0 : ℓ ≠ 0) : (quadricSurface k).functionFieldˣ :=
  Units.mk0 (projHomogeneousFraction 𝒬 (quadricCoordinateHom_mem_of_isHomogeneous k hℓ)
      (quadricCoordinateHom_X_mem k 0) (quadricCoordinateHom_X_ne_zero k 0))
    (projHomogeneousFraction_ne_zero 𝒬 _ _ _
      (quadricCoordinateHom_ne_zero_of_isHomogeneous_one k hℓ hℓ0))

/-- **Hyperplane sections are linearly equivalent.** For a hyperplane `ℓ = 0`,
`H · Q = (x = 0) · Q + div(ℓ / x)`. -/
theorem quadricHyperplaneSection_eq_add_principalDivisor {ℓ : MvPolynomial (Fin (3 + 1)) k}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) :
    projectiveIntersectionDivisor (quadricSurfaceι k) hQ
        (projectiveHyperplanePrimeDivisor (n := 3) (by norm_num) hℓ hℓ0) =
      projectiveIntersectionDivisor (quadricSurfaceι k) hQ (quadricHyperplaneX k) +
        (quadricSurface k).principalDivisor hQ (quadricHyperplaneRatio k hℓ hℓ0) := by
  apply Scheme.WeilDivisor.ext_apply
  intro x
  simp only [AddSubgroup.coe_add, Function.locallyFinsuppWithin.coe_add, Pi.add_apply]
  rw [Scheme.principalDivisor_apply hQ]
  obtain ⟨i, hi⟩ := quadric_exists_coordinate_notMem k x
  rw [quadricHyperplaneSection_apply k hℓ hℓ0 x i hi,
    quadricHyperplaneSection_apply k _ _ x i hi, quadricHyperplaneRatio, Units.val_mk0]
  have h := Scheme.ord_mul (x := x) (projHomogeneousFraction_ne_zero 𝒬
      (quadricCoordinateHom_mem_of_isHomogeneous k hℓ) (quadricCoordinateHom_X_mem k 0)
      (quadricCoordinateHom_X_ne_zero k 0)
      (quadricCoordinateHom_ne_zero_of_isHomogeneous_one k hℓ hℓ0))
      (projHomogeneousFraction_ne_zero 𝒬 (quadricCoordinateHom_X_mem k 0)
        (quadricCoordinateHom_X_mem k i) (quadricCoordinateHom_X_ne_zero k i)
        (quadricCoordinateHom_X_ne_zero k 0))
  rw [projHomogeneousFraction_mul, projHomogeneousFraction_eq_of_mul_eq 𝒬 _ _ _
    (quadricCoordinateHom_mem_of_isHomogeneous k hℓ) (quadricCoordinateHom_X_mem k i)
    (quadricCoordinateHom_X_ne_zero k i) (by ring)] at h
  rw [h]
  ring

/-- **The hyperplane class of `Q` is `(1, 1)`.** For every hyperplane `H` of `ℙ³_k`, the divisor
`H · Q` cut on `Q` has class `(1, 1)` in `Cl Q ≅ ℤ × ℤ`. -/
theorem quadricSurfaceClassGroupEquiv_hyperplaneSection {ℓ : MvPolynomial (Fin (3 + 1)) k}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) :
    quadricSurfaceClassGroupEquiv k ((quadricSurface k).weilDivisorClassHom hQ
      (projectiveIntersectionDivisor (quadricSurfaceι k) hQ
        (projectiveHyperplanePrimeDivisor (n := 3) (by norm_num) hℓ hℓ0))) = (1, 1) := by
  have hcl : (quadricSurface k).weilDivisorClassHom hQ
      (projectiveIntersectionDivisor (quadricSurfaceι k) hQ
        (projectiveHyperplanePrimeDivisor (n := 3) (by norm_num) hℓ hℓ0)) =
      (quadricSurface k).weilDivisorClassHom hQ
        ((quadricLineOneDivisor k).toWeilDivisor + (quadricLineTwoDivisor k).toWeilDivisor) := by
    refine ((quadricSurface k).weilDivisorClass_eq_iff hQ _ _).mpr
      ⟨quadricHyperplaneRatio k hℓ hℓ0, ?_⟩
    rw [quadricHyperplaneSection_eq_add_principalDivisor k hℓ hℓ0, quadricHyperplaneSection_X,
      add_sub_cancel_left]
  rw [hcl]
  exact quadricSurfaceClassGroupEquiv_lineOne_add_lineTwo k

end Hyperplane

end Hartshorne
