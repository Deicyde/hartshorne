import Hartshorne.Scheme.ModuleGluingDirected
import Hartshorne.Scheme.RelativeProjTwist
import Hartshorne.Scheme.LocallyFreeInvertible

/-!
# The relative twisting sheaf

Hartshorne, *Algebraic Geometry*, II.7, the relative `Proj` construction (pp. 160–161); see also
Stacks Project, tag 01NM.

Let `S` be a quasi-coherent sheaf of graded `𝒪_X`-algebras and `n ∈ ℤ`. The twisting sheaves
`𝒪_{Proj S(U)}(n)` of the affine pieces of `Proj_X S`, with the transition isomorphisms along the
basic open inclusions of affine opens of `X`, glue to the relative twisting sheaf
`𝒪_{Proj_X S}(n)`. It is invertible when `S` is generated by `S₁` as an `S₀`-algebra, and over
an affine open `U ⊆ X` it restricts to `𝒪_{Proj S(U)}(n)` under `π⁻¹(U) ≅ Proj S(U)`.

## Main definitions and results

* `Hartshorne.QuasiCoherentGradedAlgebra.relTwistingSheaf`: `𝒪_{Proj_X S}(n)`.
* `Hartshorne.QuasiCoherentGradedAlgebra.relTwistingSheafRestrictIso`: its restrictions to the
  affine pieces (compatible with the transition isomorphisms, by
  `Hartshorne.DirectedModuleGluing.DataTr.ψ_compat`).
* `Hartshorne.QuasiCoherentGradedAlgebra.isInvertible_relTwistingSheaf`: invertibility.
* `Hartshorne.QuasiCoherentGradedAlgebra.relTwistingSheafAffineIso`: compatibility with
  restriction to affine opens of the base.
-/

universe u

open CategoryTheory TopologicalSpace

namespace AlgebraicGeometry.Scheme.Modules

/-- A module that is locally, on an open cover, isomorphic to modules locally free of rank `r`
is locally free of rank `r`. -/
theorem isLocallyFreeOfRank_of_cover {Y : Scheme.{u}} (F : Y.Modules) (𝒰 : Y.OpenCover)
    (N : ∀ i, (𝒰.X i).Modules) (ψ : ∀ i, F.restrict (𝒰.f i) ≅ N i) {r : ℕ}
    (h : ∀ i, (N i).IsLocallyFreeOfRank r) : F.IsLocallyFreeOfRank r := by
  intro y
  obtain ⟨x, hx⟩ := 𝒰.covers y
  obtain ⟨V, hxV, ⟨e⟩⟩ := h (𝒰.idx y) x
  let g := (𝒰.f (𝒰.idx y)).isoImage V
  let V' := 𝒰.f (𝒰.idx y) ''ᵁ V
  refine ⟨V', ⟨x, hxV, hx⟩, ⟨?_⟩⟩
  let E : (F.restrict V'.ι).restrict g.hom ≅ SheafOfModules.free (ULift.{u} (Fin r)) :=
    ((restrictFunctorComp g.hom V'.ι).app F).symm ≪≫
      (restrictFunctorCongr (Scheme.Hom.isoImage_hom_ι _ V)).app F ≪≫
      (restrictFunctorComp V.ι (𝒰.f (𝒰.idx y))).app F ≪≫
      (restrictFunctor V.ι).mapIso (ψ (𝒰.idx y)) ≪≫ e
  exact (restrictFunctorId.app (F.restrict V'.ι)).symm ≪≫
    (restrictFunctorCongr g.inv_hom_id).symm.app _ ≪≫
    (restrictFunctorComp g.inv g.hom).app _ ≪≫
    (restrictFunctor g.inv).mapIso E ≪≫ restrictFreeIso g.inv _

end AlgebraicGeometry.Scheme.Modules

namespace Hartshorne

namespace QuasiCoherentGradedAlgebra

open AlgebraicGeometry Scheme.Modules

variable {X : Scheme.{u}} (S : QuasiCoherentGradedAlgebra X) (n : ℤ)

instance : Quiver.IsThin S.relativeGluingData.cover.I₀ :=
  inferInstanceAs (Quiver.IsThin X.AffineZariskiSite)

/-- The descent datum of the twisting sheaves `𝒪_{Proj S(U)}(n)` along the cover of `Proj_X S` by
the affine pieces `Proj S(U)`, with transition maps `Proj.map (S.restrict f) _`. -/
noncomputable def twistData : DirectedModuleGluing.DataTr S.relativeGluingData.cover where
  M U := S.twistingSheaf n U
  tr := fun {U V : X.AffineZariskiSite} (f : U ⟶ V) => Proj.map (S.restrict f) (S.irrelevant_le f)
  tr_open := fun {U V : X.AffineZariskiSite} (f : U ⟶ V) => S.isOpenImmersion_projMap_restrict f
  tr_eq _ := rfl
  tr_comp := fun {U V W : X.AffineZariskiSite} (f : U ⟶ V) (g : V ⟶ W) =>
    S.projMap_restrict_comp f g
  θ := fun {U V : X.AffineZariskiSite} (f : U ⟶ V) => S.twistTransition n f
  θ_comp := fun {U V W : X.AffineZariskiSite} (f : U ⟶ V) (g : V ⟶ W) =>
    S.twistTransitionHom_comp n f g

/-- **The relative twisting sheaf** `𝒪_{Proj_X S}(n)`, glued from the twisting sheaves
`𝒪_{Proj S(U)}(n)` of the affine pieces. -/
noncomputable def relTwistingSheaf : S.relProj.Modules := (S.twistData n).glue

/-- The restriction of `𝒪_{Proj_X S}(n)` to the affine piece `Proj S(U)` is `𝒪_{Proj S(U)}(n)`. -/
noncomputable def relTwistingSheafRestrictIso (U : X.AffineZariskiSite) :
    (S.relTwistingSheaf n).restrict (S.projι U) ≅ S.twistingSheaf n U :=
  (S.twistData n).ψ U

/-- **The relative twisting sheaf is invertible** when `S` is generated by `S₁` as an
`S₀`-algebra. -/
theorem isInvertible_relTwistingSheaf (hS : S.GeneratedInDegreeOne) :
    (S.relTwistingSheaf n).IsInvertible :=
  isLocallyFreeOfRank_of_cover _ S.relativeGluingData.cover (fun U => S.twistingSheaf n U)
    (fun U => S.relTwistingSheafRestrictIso n U) (fun U => S.isInvertible_twistingSheaf n hS U)

theorem restrictIso_hom_projι (U : X.AffineZariskiSite) :
    (S.restrictIso U).hom ≫ S.projι U = (S.relProjToBase ⁻¹ᵁ U.1).ι := by
  simp [restrictIso]

/-- **Compatibility with restriction to affine opens of the base**: over an affine open
`U ⊆ X`, the restriction of `𝒪_{Proj_X S}(n)` to `π⁻¹(U)` corresponds to `𝒪_{Proj S(U)}(n)` under
the identification `π⁻¹(U) ≅ Proj S(U)`. -/
noncomputable def relTwistingSheafAffineIso (U : X.AffineZariskiSite) :
    (S.relTwistingSheaf n).restrict (S.relProjToBase ⁻¹ᵁ U.1).ι ≅
      (S.twistingSheaf n U).restrict (S.restrictIso U).hom :=
  (restrictFunctorCongr (S.restrictIso_hom_projι U)).symm.app _ ≪≫
    (restrictFunctorComp (S.restrictIso U).hom (S.projι U)).app _ ≪≫
    (restrictFunctor (S.restrictIso U).hom).mapIso (S.relTwistingSheafRestrictIso n U)

end QuasiCoherentGradedAlgebra

end Hartshorne
