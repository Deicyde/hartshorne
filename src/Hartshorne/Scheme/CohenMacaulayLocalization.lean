import Mathlib.RingTheory.Ideal.AssociatedPrime.Finiteness
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.Regular.Flat
import Hartshorne.Scheme.CohenMacaulayRegularSequence

/-!
# Localization of Cohen--Macaulay rings

Hartshorne, *Algebraic Geometry*, II, Theorem 8.21A(b), p. 184 (Stacks, tag 00NB).

If `A` is a Noetherian Cohen--Macaulay local ring and `p` is a prime ideal of `A`, then the
localization `A_p` is Cohen--Macaulay.

## Main results

* `IsCohenMacaulayLocalRing.of_isLocalization_atPrime`: any localization of `A` at a prime `p`
  (in the sense of `IsLocalization.AtPrime`) is Cohen--Macaulay.
* `IsCohenMacaulayLocalRing.localization_atPrime`: the case of `Localization.AtPrime p`.

## Proof outline

* (Unmixedness) If `x₁, …, xᵢ` is a regular sequence in `A`, then every associated prime `q`
  of `A/(x₁, …, xᵢ)` is minimal over `(x₁, …, xᵢ)`: the quotient carries a regular sequence of
  length `dim A - i = dim A/(x₁, …, xᵢ)` in the maximal ideal, which bounds `dim A/q` from below,
  while a strictly smaller prime containing the `xⱼ` would make `dim A/q` too small. By Krull's
  height theorem, `ht q ≤ i`.
* Hence, while `i < ht p`, the prime `p` is not contained in any associated prime of
  `A/(x₁, …, xᵢ)`, and prime avoidance gives an element of `p` that is regular on the quotient.
  This builds a regular sequence of length `ht p` inside `p`.
* Its image in `A_p` is a regular sequence in the maximal ideal (localization is flat) of length
  `ht p = dim A_p`, so `A_p` is Cohen--Macaulay.
-/

open IsLocalRing RingTheory.Sequence Module

universe u v

namespace Hartshorne.CohenMacaulay

variable {A : Type u} [CommRing A] [IsCohenMacaulayLocalRing A]

/-- **Unmixedness** for a Cohen–Macaulay local ring: every associated prime of the quotient of
`A` by a regular sequence is a minimal prime of the ideal generated by the sequence. -/
lemma mem_minimalPrimes_ofList_of_mem_associatedPrimes (xs : List A) (hxs : IsRegular A xs)
    {q : Ideal A} (hq : q ∈ associatedPrimes A (A ⧸ (Ideal.ofList xs • ⊤ : Submodule A A))) :
    q ∈ (Ideal.ofList xs).minimalPrimes := by
  have hqp : q.IsPrime := hq.isPrime
  have hI : (Ideal.ofList xs • ⊤ : Submodule A A) = Ideal.ofList xs := by
    rw [smul_eq_mul, Ideal.mul_top]
  have hne : Ideal.ofList xs ≠ ⊤ := by
    intro h
    apply hxs.top_ne_smul
    rw [hI, h]
  have hxm : ∀ x ∈ xs, x ∈ maximalIdeal A := fun x hx => by
    by_contra hx'
    exact hne (Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span hx)
      (IsLocalRing.notMem_maximalIdeal.mp hx'))
  have hIq : Ideal.ofList xs ≤ q := by
    obtain ⟨-, z, rfl⟩ := (isAssociatedPrime_iff).mp hq
    intro a ha
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    rw [Submodule.mem_colon_singleton, Submodule.mem_bot, ← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero, hI, smul_eq_mul]
    exact Ideal.mul_mem_right _ _ ha
  -- `dim A/(xs) = k` and `A/(xs)` carries a regular sequence of length `k`.
  have : Nontrivial (A ⧸ Ideal.ofList xs) := Ideal.Quotient.nontrivial_iff.mpr hne
  obtain ⟨k, hk⟩ := exists_supportDim_eq_natCast (A := A) (A ⧸ Ideal.ofList xs)
  rw [supportDim_quotient_eq_ringKrullDim] at hk
  have hdim := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular xs hxs
  obtain ⟨rs, hlen, hmem, hrs⟩ := IsCohenMacaulayLocalRing.exists_isRegular_length_eq_ringKrullDim
    (A := A)
  have hklen : rs.length = k + xs.length := by
    rw [hk, ← hlen] at hdim
    exact_mod_cast hdim.symm
  obtain ⟨rs', hlen', hmem', hrs'⟩ := exists_isRegular_quotient_ofList xs hxm A hxs k rs hklen
    hmem hrs
  have hkq : (k : WithBot ℕ∞) ≤ ringKrullDim (A ⧸ q) := by
    simpa [hlen'] using length_le_ringKrullDim_quotient_of_mem_associatedPrimes rs' hmem'
      (A ⧸ (Ideal.ofList xs • ⊤ : Submodule A A)) hrs'.toIsWeaklyRegular q hq
  refine ⟨⟨hqp, hIq⟩, fun q' hq' hle => ?_⟩
  obtain ⟨hq'p, hIq'⟩ := hq'
  by_contra hqq'
  obtain ⟨x, hxq, hxq'⟩ := SetLike.not_le_iff_exists.mp hqq'
  have h1 := ringKrullDim_quotient_add_one_le hle hxq hxq'
  have h2 : ringKrullDim (A ⧸ q') ≤ ringKrullDim (A ⧸ Ideal.ofList xs) :=
    ringKrullDim_le_of_surjective (Ideal.Quotient.factor hIq')
      (Ideal.Quotient.factor_surjective hIq')
  rw [hk] at h2
  have h3 : (k : WithBot ℕ∞) + 1 ≤ ringKrullDim (A ⧸ q) + 1 := by gcongr
  have h4 : ((k + 1 : ℕ) : WithBot ℕ∞) ≤ (k : WithBot ℕ∞) := by
    push_cast
    exact h3.trans (h1.trans h2)
  have : k + 1 ≤ k := by exact_mod_cast h4
  omega

/-- In a Cohen–Macaulay local ring, every associated prime of the quotient by a regular
sequence of length `i` has height at most `i`. -/
lemma height_le_length_of_mem_associatedPrimes (xs : List A) (hxs : IsRegular A xs)
    {q : Ideal A} (hq : q ∈ associatedPrimes A (A ⧸ (Ideal.ofList xs • ⊤ : Submodule A A))) :
    q.height ≤ xs.length := by
  classical
  have hmin := mem_minimalPrimes_ofList_of_mem_associatedPrimes xs hxs hq
  have h := Ideal.height_le_card_of_mem_minimalPrimes_span_finset (s := xs.toFinset)
    (by simpa [Ideal.ofList] using hmin)
  exact h.trans (by exact_mod_cast List.toFinset_card_le xs)

/-- A prime ideal `p` of a Cohen–Macaulay local ring contains a regular sequence of every length
`n ≤ ht p`. -/
lemma exists_isRegular_length_eq_of_le_height (p : Ideal A) [p.IsPrime] (n : ℕ)
    (hn : (n : ℕ∞) ≤ p.height) :
    ∃ xs : List A, xs.length = n ∧ (∀ x ∈ xs, x ∈ p) ∧ IsRegular A xs := by
  induction n with
  | zero => exact ⟨[], rfl, by simp, IsRegular.nil A A⟩
  | succ n ih =>
    obtain ⟨xs, hlen, hmem, hxs⟩ := ih (le_trans (by exact_mod_cast n.le_succ) hn)
    let M := A ⧸ (Ideal.ofList xs • ⊤ : Submodule A A)
    obtain ⟨x, hxp, hx⟩ : ∃ x ∈ p, IsSMulRegular M x := by
      by_contra! hcon
      have hsub : (p : Set A) ⊆ ⋃ q ∈ associatedPrimes A M, (id q : Set A) := by
        rw [show (⋃ q ∈ associatedPrimes A M, (id q : Set A)) = _ from
          biUnion_associatedPrimes_eq_compl_regular A M]
        exact fun x hx => hcon x hx
      obtain ⟨q, hq, hpq⟩ := (Ideal.subset_union_prime_finite (associatedPrimes.finite A M)
        (f := id) 0 0 (fun q hq _ _ => hq.isPrime)).1 hsub
      have h := hn.trans ((Ideal.height_mono hpq).trans
        (height_le_length_of_mem_associatedPrimes xs hxs hq))
      rw [hlen] at h
      have : n + 1 ≤ n := by exact_mod_cast h
      omega
    have hpm : p ≤ maximalIdeal A := le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)
    have hmem' : ∀ y ∈ xs ++ [x], y ∈ p := by
      intro y hy
      rcases List.mem_append.mp hy with hy | hy
      · exact hmem y hy
      · rw [List.mem_singleton.mp hy]
        exact hxp
    refine ⟨xs ++ [x], by simp [hlen], hmem', ?_⟩
    refine IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal A (fun y hy => hpm (hmem' y hy)) ?_
    rw [isWeaklyRegular_append_iff]
    exact ⟨hxs.toIsWeaklyRegular, (isWeaklyRegular_singleton_iff M x).mpr hx⟩

end Hartshorne.CohenMacaulay

open Hartshorne.CohenMacaulay

namespace IsCohenMacaulayLocalRing

variable {A : Type u} [CommRing A] [IsCohenMacaulayLocalRing A]

/-- **Hartshorne II, Theorem 8.21A(b)**: the localization of a Noetherian Cohen–Macaulay local
ring `A` at a prime ideal `p` is Cohen–Macaulay. Stated for any `IsLocalization.AtPrime` model
`Aₚ` of the localization. -/
theorem of_isLocalization_atPrime (p : Ideal A) [p.IsPrime] (Aₚ : Type v) [CommRing Aₚ]
    [Algebra A Aₚ] [IsLocalization.AtPrime Aₚ p] : IsCohenMacaulayLocalRing Aₚ := by
  have : IsLocalRing Aₚ := IsLocalization.AtPrime.isLocalRing Aₚ p
  have : IsNoetherianRing Aₚ := IsLocalization.isNoetherianRing p.primeCompl Aₚ inferInstance
  have hdim := IsLocalization.AtPrime.ringKrullDim_eq_height p Aₚ
  obtain ⟨h, hh⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := p))
  obtain ⟨xs, hlen, hmem, hxs⟩ := exists_isRegular_length_eq_of_le_height p h hh.le
  refine isCohenMacaulayLocalRing_of_isRegular Aₚ (xs.map (algebraMap A Aₚ)) ?_ ?_
    (hxs.toIsWeaklyRegular.isRegular_of_isLocalization_of_mem Aₚ p hmem)
  · rw [hdim, ← hh]
    simp [hlen]
  · intro y hy
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hy
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff Aₚ p x).mpr (hmem x hx)

/-- **Hartshorne II, Theorem 8.21A(b)**: if `A` is a Noetherian Cohen–Macaulay local ring and
`p` is a prime ideal of `A`, then `A_p` is Cohen–Macaulay. -/
theorem localization_atPrime (p : Ideal A) [p.IsPrime] :
    IsCohenMacaulayLocalRing (Localization.AtPrime p) :=
  of_isLocalization_atPrime p (Localization.AtPrime p)

end IsCohenMacaulayLocalRing
