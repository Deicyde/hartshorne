import Hartshorne.RingedSpace.ModuleSheafTensorPowerIso
import Hartshorne.Scheme.AmpleInvertibleSheaf
import Hartshorne.Scheme.FiniteLocallyFreeProjectionFormula
import Hartshorne.Scheme.QuasicoherentAbelianClosure
import Hartshorne.Scheme.LocallyFreeRinged

/-!
# Ampleness and tensor powers

Hartshorne, *Algebraic Geometry*, II, Proposition 7.5 (p. 154).

Let `L` be an invertible sheaf on a Noetherian scheme `X`. Then the following are equivalent
(`AlgebraicGeometry.Scheme.Modules.isAmple_tfae`):

1. `L` is ample;
2. `L^m` is ample for every `m > 0`;
3. `L^m` is ample for some `m > 0`.

Here `L^m` is the tensor power `Hartshorne.moduleSheafTensorPower m L`.

## Proof

(1 ⇒ 2) For coherent `F`, `F ⊗ (L^m)^n ≅ F ⊗ L^{mn}` (`moduleSheafTensorPowerMulIso`), and
`mn ≥ n`. (2 ⇒ 3) is trivial. (3 ⇒ 1) For coherent `F`, each `F ⊗ L^i` is coherent
(`isCoherent_moduleSheafTensor_of_isInvertible`), so ampleness of `L^m` gives `N` with
`(F ⊗ L^i) ⊗ (L^m)^q` generated by global sections for all `q ≥ N` and `0 ≤ i < m`. For
`n ≥ mN`, write `n = i + mq` with `0 ≤ i < m`, `q ≥ N`; then
`F ⊗ L^n ≅ (F ⊗ L^i) ⊗ (L^m)^q` (`moduleSheafTensorPowerAddIso`, `moduleSheafTensorAssoc`).

Coherence of `F ⊗ L` for coherent `F` and invertible `L` is local: on an affine open `V` where
`L` has a one-element frame `e`, the map `s ↦ s ⊗ e` identifies the restrictions of `F` and
`F ⊗ L` to `V` (`AmplePower.twistRestrictHom`), by the frame description of sections of
`F ⊗ L` (`IsLocalFrame.tensorFrameMap_bijective`).
-/

universe u

open CategoryTheory Opposite TopologicalSpace AlgebraicGeometry Limits

namespace Hartshorne

variable {X : Scheme.{u}}

/-- Generation by global sections is invariant under isomorphism. -/
theorem isGloballyGenerated_of_iso {F G : X.Modules} (e : F ≅ G)
    (hF : F.IsGloballyGenerated) : G.IsGloballyGenerated := by
  obtain ⟨I, p, hp⟩ := (Scheme.Modules.isGloballyGenerated_iff_exists_epi F).mp hF
  have : @Epi (SheafOfModules.{u} X.ringCatSheaf) _ _ _ e.hom :=
    @IsIso.epi_of_iso _ _ _ _ e.hom ⟨⟨e.inv, e.hom_inv_id, e.inv_hom_id⟩⟩
  exact (Scheme.Modules.isGloballyGenerated_iff_exists_epi G).mpr ⟨I, p ≫ e.hom, epi_comp _ _⟩

namespace AmplePower

variable (F L : X.Modules) (V : X.affineOpens)

instance (V : X.affineOpens) : IsOpenImmersion V.2.fromSpec :=
  IsAffineOpen.isOpenImmersion_fromSpec (U := (V : X.Opens)) V.2

lemma image_le_affineOpen (U : (Spec Γ(X, (V : X.Opens))).Opens) :
    V.2.fromSpec ''ᵁ U ≤ (V : X.Opens) :=
  (Scheme.Hom.image_mono _ le_top).trans ((Scheme.Hom.image_top_eq_opensRange _).trans
    (IsAffineOpen.opensRange_fromSpec (U := (V : X.Opens)) V.2)).le

/-- On an affine open `V` and for a section `e` of `L` over `V`, the morphism
`F|_V ⟶ (F ⊗ L)|_V`, `s ↦ s ⊗ e`. -/
noncomputable def twistRestrictHom (e : Γ(L, (V : X.Opens))) :
    F.restrict V.2.fromSpec ⟶
      Scheme.Modules.restrict (moduleSheafTensor F L : X.Modules) V.2.fromSpec :=
  modulesHomMk
    (fun U =>
      { toFun := fun s => (moduleSheafTensorBilinear F L).app (op (V.2.fromSpec ''ᵁ U)) s
          (L.presheaf.map (homOfLE (image_le_affineOpen V U)).op e)
        map_add' := fun s s' => LinearMap.map_add₂ ((moduleSheafTensorBilinear F L).app
          (op (V.2.fromSpec ''ᵁ U))) (show Γ(F, V.2.fromSpec ''ᵁ U) from s)
          (show Γ(F, V.2.fromSpec ''ᵁ U) from s') _
        map_smul' := fun r s => LinearMap.map_smul₂ ((moduleSheafTensorBilinear F L).app
          (op (V.2.fromSpec ''ᵁ U))) ((V.2.fromSpec.appIso U).inv r)
          (show Γ(F, V.2.fromSpec ''ᵁ U) from s) _ })
    (fun U U' i s => by
      change (moduleSheafTensorBilinear F L).app (op (V.2.fromSpec ''ᵁ U'))
          (F.presheaf.map (homOfLE (Scheme.Hom.image_mono _ i)).op s)
          (L.presheaf.map (homOfLE (image_le_affineOpen V U')).op e) =
        (moduleSheafTensor F L).val.map (homOfLE (Scheme.Hom.image_mono _ i)).op
          ((moduleSheafTensorBilinear F L).app (op (V.2.fromSpec ''ᵁ U)) s
            (L.presheaf.map (homOfLE (image_le_affineOpen V U)).op e))
      have hL : L.presheaf.map (homOfLE (image_le_affineOpen V U')).op e =
          L.presheaf.map (homOfLE (Scheme.Hom.image_mono _ i)).op
            (L.presheaf.map (homOfLE (image_le_affineOpen V U)).op e) := by
        rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
        rfl
      refine Eq.trans ?_ ((moduleSheafTensorBilinear F L).naturality
        (homOfLE (Scheme.Hom.image_mono V.2.fromSpec i)).op
        (show Γ(F, V.2.fromSpec ''ᵁ U) from s) _).symm
      rw [hL]
      rfl)

variable {F L V} in
lemma twistRestrictHom_bijective {e : ULift.{u} (Fin 1) → Γ(L, (V : X.Opens))}
    (he : IsLocalFrame L V e) (U : (Spec Γ(X, (V : X.Opens))).Opens) :
    Function.Bijective ((twistRestrictHom F L V (e default)).app U) := by
  have key : ⇑((twistRestrictHom F L V (e default)).app U) =
      tensorFrameMap F e (image_le_affineOpen V U) ∘
        (fun (s : Γ(F, V.2.fromSpec ''ᵁ U)) (_ : ULift.{u} (Fin 1)) => s) := by
    funext s
    change _ = ∑ i : ULift.{u} (Fin 1), (moduleSheafTensorBilinear F L).app
      (op (V.2.fromSpec ''ᵁ U)) (show Γ(F, V.2.fromSpec ''ᵁ U) from s)
        (L.presheaf.map (homOfLE (image_le_affineOpen V U)).op (e i))
    rw [Fintype.sum_unique]
    rfl
  rw [key]
  refine (he.tensorFrameMap_bijective (F := F) _).comp ⟨fun s t h => congr_fun h default,
    fun g => ⟨g default, funext fun k => ?_⟩⟩
  rw [Subsingleton.elim k default]

variable {F L V} in
lemma twistRestrictHom_isIso {e : ULift.{u} (Fin 1) → Γ(L, (V : X.Opens))}
    (he : IsLocalFrame L V e) : IsIso (twistRestrictHom F L V (e default)) :=
  modules_isIso_of_locally_bijective _ fun _ =>
    ⟨⊤, trivial, fun U _ => twistRestrictHom_bijective he U⟩

end AmplePower

open AmplePower in
/-- **Twisting a coherent sheaf by an invertible sheaf.** On a locally Noetherian scheme, if `F`
is coherent and `L` is invertible, then `F ⊗ L` is coherent. -/
theorem isCoherent_moduleSheafTensor_of_isInvertible [IsLocallyNoetherian X] {F L : X.Modules}
    (hF : IsCoherent F) (hL : L.IsInvertible) : IsCoherent (moduleSheafTensor F L) := by
  have hL' := (Scheme.Modules.isInvertible_iff_ringed L).mp hL
  have hF' := ((coherent_affine_local_tfae F).out 0 2).mp hF
  refine ⟨{V : X.affineOpens // ∃ e : ULift.{u} (Fin 1) → Γ(L, (V : X.Opens)),
      IsLocalFrame L V e}, fun V => V.1, ?_, fun V => ?_⟩
  · refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨U, e, hx, he⟩ := Ringed.exists_isLocalFrame_of_isLocallyFreeOfRank hL' x
    obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWU⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hx U.2
    exact Opens.mem_iSup.mpr ⟨⟨⟨W, hW⟩, _, show IsLocalFrame L W _ from he.restrictLE hWU⟩, hxW⟩
  · obtain ⟨e, he⟩ := V.2
    obtain ⟨M, hM, ⟨α⟩⟩ := hF' V.1
    have := twistRestrictHom_isIso (F := F) he
    exact ⟨M, hM, ⟨α ≪≫ asIso (twistRestrictHom F L V.1 (e default))⟩⟩

end Hartshorne

namespace AlgebraicGeometry.Scheme.Modules

open Hartshorne

variable {X : Scheme.{u}}

/-- **Hartshorne II, Proposition 7.5.** Let `L` be an invertible sheaf on a Noetherian scheme
`X`. The following are equivalent: `L` is ample; `L^m` is ample for every `m > 0`; `L^m` is ample
for some `m > 0`. -/
theorem isAmple_tfae [IsNoetherian X] (L : X.Modules) (hL : L.IsInvertible) :
    List.TFAE [L.IsAmple,
      ∀ m : ℕ, 0 < m → IsAmple (X := X) (moduleSheafTensorPower m L),
      ∃ m : ℕ, 0 < m ∧ IsAmple (X := X) (moduleSheafTensorPower m L)] := by
  have hL' := (isInvertible_iff_ringed L).mp hL
  have hpow : ∀ n : ℕ, IsInvertible (X := X) (moduleSheafTensorPower n L) := fun n =>
    (isInvertible_iff_ringed _).mpr (Ringed.isInvertible_moduleSheafTensorPower hL' n)
  tfae_have 1 → 2 := by
    rintro ⟨-, hamp⟩ m hm
    refine ⟨hpow m, fun F hF => ?_⟩
    obtain ⟨n₀, hn₀⟩ := hamp F hF
    refine ⟨n₀, fun n hn => ?_⟩
    exact isGloballyGenerated_of_iso
      (Ringed.moduleSheafTensorIsoOfIso (Iso.refl F)
        (Ringed.moduleSheafTensorPowerMulIso L m n).symm)
      (hn₀ (m * n) (hn.trans (Nat.le_mul_of_pos_left n hm)))
  tfae_have 2 → 3 := fun h => ⟨1, Nat.one_pos, h 1 Nat.one_pos⟩
  tfae_have 3 → 1 := by
    rintro ⟨m, hm, -, hamp⟩
    refine ⟨hL, fun F hF => ?_⟩
    have hG : ∀ i : ℕ, IsCoherent (moduleSheafTensor F (moduleSheafTensorPower i L)) :=
      fun i => isCoherent_moduleSheafTensor_of_isInvertible hF (hpow i)
    choose N hN using fun i => hamp _ (hG i)
    refine ⟨m * (Finset.range m).sup N, fun n hn => ?_⟩
    have hq : (Finset.range m).sup N ≤ n / m :=
      (Nat.le_div_iff_mul_le hm).mpr (by rw [mul_comm]; exact hn)
    have hgg := hN (n % m) (n / m)
      ((Finset.le_sup (Finset.mem_range.mpr (Nat.mod_lt n hm))).trans hq)
    rw [show n = n % m + m * (n / m) from (Nat.mod_add_div n m).symm]
    exact isGloballyGenerated_of_iso
      (Ringed.moduleSheafTensorAssoc _ _ _ ≪≫ Ringed.moduleSheafTensorIsoOfIso (Iso.refl F)
        (Ringed.moduleSheafTensorIsoOfIso (Iso.refl _)
          (Ringed.moduleSheafTensorPowerMulIso L m (n / m)) ≪≫
          (Ringed.moduleSheafTensorPowerAddIso L (n % m) (m * (n / m))).symm)) hgg
  tfae_finish

end AlgebraicGeometry.Scheme.Modules
