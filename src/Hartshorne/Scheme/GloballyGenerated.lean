import Hartshorne.Scheme.CoherentFreeLocus
import Hartshorne.Scheme.AffineGlobalSectionsExact
import Hartshorne.Scheme.ProjTwistingSheaf
import Mathlib.Topology.Sheaves.Skyscraper

/-!
# Sheaves of modules generated by global sections

Hartshorne, *Algebraic Geometry*, II.5, the definition preceding Example 5.16.2 and
Examples 5.16.2–5.16.3 (p. 121).

An `𝒪_X`-module `F` on a scheme `X` is *generated by global sections* if there is a family of
global sections `s i ∈ Γ(X, F)` whose germs generate every stalk `F_x` as an `𝒪_{X,x}`-module.
(Families are indexed by types in the universe of `X`; this loses nothing, since any family can
be reindexed by its image in `Γ(X, F)`.)

## Main definitions and results

* `AlgebraicGeometry.Scheme.Modules.IsGeneratedBySections F s`: the germs of the global sections
  `s i` generate every stalk of `F`.
* `AlgebraicGeometry.Scheme.Modules.IsGloballyGenerated F`: `F` is generated by global sections.
* `AlgebraicGeometry.Scheme.Modules.isGloballyGenerated_iff_exists_epi`: `F` is generated by
  global sections if and only if it is the target of an epimorphism from a free module sheaf.
* `AlgebraicGeometry.Scheme.Modules.isGloballyGenerated_of_isAffine`: a quasi-coherent sheaf on
  an affine scheme is generated by global sections (Example 5.16.2).
* `Hartshorne.ProjTwistingSheaf.degreeOneSection`: the global section `s / 1` of `𝒪_X(1)` on
  `X = Proj S` given by `s ∈ S_1`.
* `Hartshorne.ProjTwistingSheaf.isGeneratedBySections_degreeOneSection`: if `S` is generated by
  `S_1` as an `S_0`-algebra, these sections generate `𝒪_X(1)` (Example 5.16.3).

For the converse direction of the characterization we compute stalks of the free sheaf
`⨁_I 𝒪_X`: the stalk functor (a left adjoint, to the skyscraper sheaf) and the forgetful functor
from module sheaves to abelian sheaves preserve coproducts, so the stalk of `⨁_I 𝒪_X` is
generated by the germs of the basis sections.
-/

universe u

open CategoryTheory Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

namespace Scheme.Modules

variable {X : Scheme.{u}}

open Hartshorne

/-- A family `s` of global sections of an `𝒪_X`-module `F` **generates** `F` if for every point
`x`, the germs of the `s i` generate the stalk `F_x` as an `𝒪_{X,x}`-module. -/
def IsGeneratedBySections (F : X.Modules) {ι : Type u} (s : ι → Γ(F, ⊤)) : Prop :=
  ∀ x : X, Submodule.span (X.presheaf.stalk x)
    (Set.range fun i => F.presheaf.germ ⊤ x trivial (s i)) = ⊤

/-- **Hartshorne II.5 (p. 121).** An `𝒪_X`-module `F` is *generated by global sections* if there
is a family of global sections `s i ∈ Γ(X, F)` such that for every `x ∈ X` the images of the `s i`
in the stalk `F_x` generate it as an `𝒪_{X,x}`-module. -/
def IsGloballyGenerated (F : X.Modules) : Prop :=
  ∃ (ι : Type u) (s : ι → Γ(F, ⊤)), F.IsGeneratedBySections s

namespace GloballyGenerated

/-- The compatible family of sections of `F` obtained by restricting a global section. -/
noncomputable def sectionsOfTop (F : X.Modules) (t : Γ(F, ⊤)) : SheafOfModules.sections F :=
  PresheafOfModules.sectionsMk (fun U => F.presheaf.map (homOfLE le_top : U.unop ⟶ ⊤).op t)
    (fun U V f => by
      change F.presheaf.map f (F.presheaf.map _ t) = _
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      rfl)

theorem sectionsOfTop_top (F : X.Modules) (t : Γ(F, ⊤)) :
    (sectionsOfTop F t).val (op ⊤) = t := by
  change F.presheaf.map (𝟙 _) t = t
  rw [CategoryTheory.Functor.map_id]
  rfl

/-- The value over `W` of a compatible family of sections. -/
noncomputable def secAt (F : X.Modules) (σ : SheafOfModules.sections F) (W : X.Opens) :
    Γ(F, W) :=
  σ.val (op W)

/-- The global section underlying a compatible family of sections. -/
noncomputable abbrev topOfSections (F : X.Modules) (σ : SheafOfModules.sections F) : Γ(F, ⊤) :=
  secAt F σ ⊤

theorem secAt_eq (F : X.Modules) (σ : SheafOfModules.sections F) (W : X.Opens) :
    secAt F σ W = F.presheaf.map (homOfLE le_top : W ⟶ ⊤).op (topOfSections F σ) :=
  (σ.property (homOfLE le_top : W ⟶ ⊤).op).symm

/-- The key computation: for a morphism `p` from a free module sheaf, the germ of the image of
`a • e_i` is `a • (germ of p(e_i))`. -/
theorem germ_ιFree_comp_app {I : Type u} {F : X.Modules} (p : SheafOfModules.free I ⟶ F) (i : I)
    {W : X.Opens} {x : X} (hx : x ∈ W) (a : Γ(X, W)) :
    F.presheaf.germ W x hx
        (Hom.app (M := SheafOfModules.unit X.ringCatSheaf) (SheafOfModules.ιFree i ≫ p) W a) =
      X.presheaf.germ W x hx a •
        F.presheaf.germ ⊤ x trivial (topOfSections F (F.freeHomEquiv p i)) := by
  have h1 : Hom.app (M := SheafOfModules.unit X.ringCatSheaf) (SheafOfModules.ιFree i ≫ p) W a =
      a • secAt F (F.freeHomEquiv p i) W := by
    have := Hom.app_smul (M := SheafOfModules.unit X.ringCatSheaf) (SheafOfModules.ιFree i ≫ p)
      a (1 : Γ(X, W))
    exact (congrArg (Hom.app (M := SheafOfModules.unit X.ringCatSheaf)
      (SheafOfModules.ιFree i ≫ p) W) (mul_one a).symm).trans this
  rw [h1, schemeModules_germ_smul, secAt_eq, TopCat.Presheaf.germ_res_apply]

/-- The germ of the image of `a • e_i` under `p`, as the stalk map of `p` applied to a germ. -/
theorem germ_smul_mem_range {I : Type u} {F : X.Modules} (p : SheafOfModules.free I ⟶ F) (i : I)
    (x : X) (c : X.presheaf.stalk x) :
    c • F.presheaf.germ ⊤ x trivial (topOfSections F (F.freeHomEquiv p i)) ∈
      ((TopCat.Presheaf.stalkFunctor Ab x).map (Hom.mapPresheaf p)).hom.range := by
  obtain ⟨W, hxW, b, rfl⟩ := X.presheaf.exists_germ_eq c
  rw [← germ_ιFree_comp_app p i hxW b]
  refine ⟨(Scheme.Modules.presheaf (X := X) (SheafOfModules.free I)).germ W x hxW
    (Hom.app (M := SheafOfModules.unit X.ringCatSheaf) (SheafOfModules.ιFree i) W b), ?_⟩
  rw [TopCat.Presheaf.stalkFunctor_map_germ_apply]
  rfl

/-- A morphism of `𝒪_X`-modules which is surjective on all stalks is an epimorphism. -/
theorem epi_of_stalk_surjective {F G : X.Modules} (p : F ⟶ G)
    (h : ∀ x : X, Function.Surjective ((TopCat.Presheaf.stalkFunctor Ab x).map (Hom.mapPresheaf p))) :
    Epi p := by
  have h1 : Epi ((SheafOfModules.toSheaf X.ringCatSheaf).map p) :=
    (TopCat.Sheaf.isLocallySurjective_iff_epi _).1
      ((TopCat.Presheaf.locally_surjective_iff_surjective_on_stalks _).2 h)
  exact (SheafOfModules.toSheaf X.ringCatSheaf).epi_of_epi_map h1

/-- The underlying sheaf of abelian groups of a colimit of `𝒪_X`-modules is the colimit of the
underlying sheaves (sheafification of presheaves of modules preserves colimits). -/
theorem toSheaf_preservesColimit {K : Type u} [SmallCategory K]
    (D : K ⥤ SheafOfModules.{u} X.ringCatSheaf) :
    PreservesColimit D (SheafOfModules.toSheaf X.ringCatSheaf) := by
  let adj := PresheafOfModules.sheafificationAdjunction (𝟙 X.ringCatSheaf.obj)
  let D₀ : K ⥤ X.PresheafOfModules := D ⋙ SheafOfModules.forget _
  let D' : K ⥤ SheafOfModules.{u} X.ringCatSheaf := D₀ ⋙ PresheafOfModules.sheafification (𝟙 X.ringCatSheaf.obj)
  let e : D ≅ D' := Functor.isoWhiskerLeft D (asIso adj.counit).symm
  have hc₀ := colimit.isColimit D₀
  have : PreservesColimitsOfSize.{u, u}
      (PresheafOfModules.sheafification (𝟙 X.ringCatSheaf.obj)) :=
    adj.leftAdjoint_preservesColimits
  have : PreservesColimit D₀
      (PresheafOfModules.sheafification (𝟙 X.ringCatSheaf.obj) ⋙
        SheafOfModules.toSheaf X.ringCatSheaf) :=
    preservesColimit_of_natIso D₀
      (PresheafOfModules.sheafificationCompToSheaf (𝟙 X.ringCatSheaf.obj)).symm
  have : PreservesColimit D' (SheafOfModules.toSheaf X.ringCatSheaf) :=
    preservesColimit_of_preserves_colimit_cocone
      (isColimitOfPreserves (PresheafOfModules.sheafification (𝟙 X.ringCatSheaf.obj)) hc₀)
      (isColimitOfPreserves (PresheafOfModules.sheafification (𝟙 X.ringCatSheaf.obj) ⋙
        SheafOfModules.toSheaf X.ringCatSheaf) hc₀)
  exact preservesColimit_of_iso_diagram _ e.symm

/-- The stalk at `x` of an `𝒪_X`-module, as a functor to abelian groups. -/
noncomputable abbrev stalkAb (x : X) : SheafOfModules.{u} X.ringCatSheaf ⥤ Ab.{u} :=
  SheafOfModules.toSheaf X.ringCatSheaf ⋙
    TopCat.Sheaf.forget Ab.{u} X ⋙ TopCat.Presheaf.stalkFunctor Ab.{u} x

/-- Stalks of the free module sheaf: the stalk of `⨁_I 𝒪_X` at `x` is the direct sum of copies
of the stalk of `𝒪_X`, via the stalk maps of the inclusions. -/
noncomputable def isColimitStalkFreeCofan (I : Type u) (x : X) :
    IsColimit ((stalkAb x).mapCocone
      (SheafOfModules.freeCofan (R := X.ringCatSheaf) I)) := by
  have : PreservesColimit (Discrete.functor fun _ : I => SheafOfModules.unit X.ringCatSheaf)
      (SheafOfModules.toSheaf X.ringCatSheaf) :=
    toSheaf_preservesColimit _
  have : PreservesColimit
      (Discrete.functor (fun _ : I => SheafOfModules.unit X.ringCatSheaf) ⋙
        SheafOfModules.toSheaf X.ringCatSheaf)
      (TopCat.Sheaf.forget Ab.{u} X ⋙ TopCat.Presheaf.stalkFunctor Ab.{u} x) := by
    have : ∀ U : X.Opens, Decidable (x ∈ U) := fun _ => Classical.dec _
    have h : PreservesColimitsOfSize.{u, u}
        (TopCat.Sheaf.forget Ab.{u} X ⋙ TopCat.Presheaf.stalkFunctor Ab.{u} x) :=
      (stalkSkyscraperSheafAdjunction x).leftAdjoint_preservesColimits
    have h2 := h.preservesColimitsOfShape (J := Discrete I)
    exact h2.preservesColimit
  have : PreservesColimit (Discrete.functor fun _ : I => SheafOfModules.unit X.ringCatSheaf)
      (stalkAb x) :=
    inferInstanceAs (PreservesColimit _ (SheafOfModules.toSheaf X.ringCatSheaf ⋙
      (TopCat.Sheaf.forget Ab.{u} X ⋙ TopCat.Presheaf.stalkFunctor Ab.{u} x)))
  exact isColimitOfPreserves (stalkAb x) (SheafOfModules.isColimitFreeCofan I)

/-- An epimorphism of `𝒪_X`-modules is surjective on stalks. -/
theorem stalk_surjective_of_epi {F G : X.Modules} (p : F ⟶ G) [Epi p] (x : X) :
    Function.Surjective ((TopCat.Presheaf.stalkFunctor Ab x).map (Hom.mapPresheaf p)) := by
  refine (TopCat.Presheaf.locally_surjective_iff_surjective_on_stalks _).1 ?_ x
  refine (TopCat.Presheaf.isLocallySurjective_iff _).2 fun U t y hy => ?_
  obtain ⟨V, hVU, hyV, s, hs⟩ := Hartshorne.modules_exists_local_lift p t hy
  exact ⟨V, hVU, ⟨s, hs⟩, hyV⟩

/-- If `p : ⨁_I 𝒪_X ⟶ F` is an epimorphism, the images of the basis sections generate `F`. -/
theorem isGeneratedBySections_of_epi {I : Type u} {F : X.Modules}
    (p : SheafOfModules.free I ⟶ F) [Epi p] :
    F.IsGeneratedBySections (fun i => topOfSections F (F.freeHomEquiv p i)) := by
  intro x
  set N : Submodule (X.presheaf.stalk x) (F.presheaf.stalk x) := Submodule.span _
    (Set.range fun i => F.presheaf.germ ⊤ x trivial (topOfSections F (F.freeHomEquiv p i)))
  let q : F.presheaf.stalk x →+ F.presheaf.stalk x ⧸ N.toAddSubgroup :=
    QuotientAddGroup.mk' _
  let π : (stalkAb x).obj (SheafOfModules.free I) ⟶
      AddCommGrpCat.of (F.presheaf.stalk x ⧸ N.toAddSubgroup) :=
    (TopCat.Presheaf.stalkFunctor Ab x).map (Hom.mapPresheaf p) ≫ AddCommGrpCat.ofHom q
  have hπ : π = 0 := (isColimitStalkFreeCofan I x).hom_ext fun j => by
    obtain ⟨i⟩ := j
    ext z
    obtain ⟨W, hxW, b, rfl⟩ :=
      (Scheme.Modules.presheaf (X := X) (SheafOfModules.unit X.ringCatSheaf)).exists_germ_eq z
    change q ((TopCat.Presheaf.stalkFunctor Ab x).map (Hom.mapPresheaf p)
      ((TopCat.Presheaf.stalkFunctor Ab x).map
        (Hom.mapPresheaf (M := SheafOfModules.unit X.ringCatSheaf) (SheafOfModules.ιFree i))
        ((Scheme.Modules.presheaf (X := X) (SheafOfModules.unit X.ringCatSheaf)).germ W x hxW b)))
      = 0
    rw [TopCat.Presheaf.stalkFunctor_map_germ_apply, TopCat.Presheaf.stalkFunctor_map_germ_apply]
    change q (F.presheaf.germ W x hxW
      (Hom.app (M := SheafOfModules.unit X.ringCatSheaf) (SheafOfModules.ιFree i ≫ p) W b)) = 0
    refine (congrArg q (germ_ιFree_comp_app p i hxW b)).trans ?_
    exact (QuotientAddGroup.eq_zero_iff _).2
      (N.smul_mem _ (Submodule.subset_span ⟨i, rfl⟩))
  rw [eq_top_iff]
  rintro y -
  have hp : @Epi X.Modules _ (SheafOfModules.free I) F p := ‹Epi p›
  obtain ⟨z, rfl⟩ := stalk_surjective_of_epi (F := (SheafOfModules.free I : X.Modules)) p x y
  have h := congrArg (fun φ => φ z) congr(ConcreteCategory.hom $hπ)
  exact (QuotientAddGroup.eq_zero_iff _).1 h

end GloballyGenerated

open GloballyGenerated in
/-- **Hartshorne II.5 (p. 121).** An `𝒪_X`-module `F` is generated by global sections if and only
if it is a quotient of a free module sheaf, i.e. the target of an epimorphism
`⨁_{i ∈ I} 𝒪_X ⟶ F`: generating sections `s i` define the surjection `e_i ↦ s i`, and conversely
the images of the basis sections under such a surjection generate `F`. -/
theorem isGloballyGenerated_iff_exists_epi (F : X.Modules) :
    F.IsGloballyGenerated ↔ ∃ (I : Type u) (p : SheafOfModules.free I ⟶ F), Epi p := by
  constructor
  · rintro ⟨ι, s, hs⟩
    let p : SheafOfModules.free ι ⟶ F := F.freeHomEquiv.symm fun i => sectionsOfTop F (s i)
    have hp : ∀ i, topOfSections F (F.freeHomEquiv p i) = s i := fun i => by
      simp only [p, Equiv.apply_symm_apply]
      exact sectionsOfTop_top F (s i)
    refine ⟨ι, p, ?_⟩
    have : @Epi X.Modules _ _ _ p := epi_of_stalk_surjective p fun x (y : F.presheaf.stalk x) => by
      have hy : y ∈ Submodule.span (X.presheaf.stalk x)
          (Set.range fun i => F.presheaf.germ ⊤ x trivial (s i)) := by
        rw [hs x]
        trivial
      obtain ⟨c, rfl⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).1 hy
      suffices h : (c.sum fun i a => a • F.presheaf.germ ⊤ x trivial (s i)) ∈
          ((TopCat.Presheaf.stalkFunctor Ab x).map (Hom.mapPresheaf p)).hom.range from h
      refine AddSubgroup.sum_mem _ fun i _ => ?_
      have := germ_smul_mem_range p i x (c i)
      rwa [hp i] at this
    exact this
  · rintro ⟨I, p, hp⟩
    exact ⟨I, _, isGeneratedBySections_of_epi p⟩

/-- A quasi-coherent module on `Spec R` is generated by global sections: it is `M~` for
`M = Γ(Spec R, F)`, which is a quotient of the free sheaf `(⨁_{m ∈ M} R)~`. -/
theorem isGloballyGenerated_of_isQuasicoherent_spec {R : CommRingCat.{u}}
    (F : (Spec R).Modules) [F.IsQuasicoherent] : F.IsGloballyGenerated := by
  let P := presentationTilde.{u} ((modulesSpecToSheaf.obj F).presheaf.obj (.op ⊤)) .univ
    (by simp) _ (Submodule.span_eq _)
  have h1 : @Epi (Spec R).Modules _ _ _ P.generators.π := P.generators.epi
  have h2 : Epi (Scheme.Modules.fromTildeΓ (R := R) F) := inferInstance
  exact (isGloballyGenerated_iff_exists_epi F).2
    ⟨_, @CategoryStruct.comp (Spec R).Modules _ _ _ _ P.generators.π
      (Scheme.Modules.fromTildeΓ (R := R) F), @epi_comp (Spec R).Modules _ _ _ _ _ h1 _ h2⟩

/-- **Hartshorne II.5, Example 5.16.2.** Every quasi-coherent sheaf on an affine scheme is
generated by global sections. -/
theorem isGloballyGenerated_of_isAffine [IsAffine X] (F : X.Modules) [F.IsQuasicoherent] :
    F.IsGloballyGenerated := by
  let g := X.isoSpec.inv
  let h := X.isoSpec.hom
  obtain ⟨I, q, hq⟩ := (isGloballyGenerated_iff_exists_epi _).1
    (isGloballyGenerated_of_isQuasicoherent_spec (R := Γ(X, ⊤)) ((restrictFunctor g).obj F))
  have hq' : @Epi (Spec Γ(X, ⊤)).Modules _ _ _ q := hq
  have hq'' : Epi ((restrictFunctor h).map q) := Functor.map_epi _ _
  let e : (restrictFunctor h).obj ((restrictFunctor g).obj F) ≅ F :=
    ((restrictFunctorComp h g).app F).symm ≪≫
      (restrictFunctorCongr X.isoSpec.hom_inv_id).app F ≪≫ restrictFunctorId.app F
  have h0 : @Epi X.Modules _ _ _ (Scheme.Modules.restrictFreeIso h I).inv :=
    @IsIso.epi_of_iso X.Modules _ _ _ _ (Iso.isIso_inv _)
  exact (isGloballyGenerated_iff_exists_epi F).2 ⟨I,
    @CategoryStruct.comp X.Modules _ _ _ _ (Scheme.Modules.restrictFreeIso h I).inv
      ((restrictFunctor h).map q ≫ e.hom), @epi_comp X.Modules _ _ _ _ _ h0 _ (epi_comp _ _)⟩

end Scheme.Modules

end AlgebraicGeometry

namespace Hartshorne

open AlgebraicGeometry

namespace ProjTwistingSheaf

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]

omit [GradedRing 𝒜] in
theorem mem_gradedTwist_one_zero {s : A} (hs : s ∈ 𝒜 1) : s ∈ gradedTwist 𝒜 1 ((0 : ℕ) : ℤ) :=
  (mem_gradedTwist_of_eq (k := 1) (by omega)).2 hs

theorem one_mem_primeCompl (x : ProjectiveSpectrum 𝒜) :
    (1 : A) ∈ x.asHomogeneousIdeal.toIdeal.primeCompl :=
  x.asHomogeneousIdeal.toIdeal.primeCompl.one_mem

/-- The fraction `s / 1` in `S(1)_(x)` of a degree-one element `s ∈ S_1 = S(1)_0`. -/
noncomputable def degreeOneFraction (x : ProjectiveSpectrum 𝒜) {s : A} (hs : s ∈ 𝒜 1) :
    HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 1) x.asHomogeneousIdeal.toIdeal.primeCompl :=
  HomogeneousLocalizedModule.mk 0 s (mem_gradedTwist_one_zero hs) 1 SetLike.GradedOne.one_mem
    (one_mem_primeCompl x)

/-- **The global section of `𝒪_X(1)` given by a degree-one element.** An element `s ∈ S_1`, which
is a degree-zero element of `S(1)`, defines the global section `x ↦ s / 1 ∈ S(1)_(x)` of
`𝒪_X(1) = S(1)~` on `X = Proj S`. -/
noncomputable def degreeOneSection (s : 𝒜 1) : Γ(projTwistingSheaf 𝒜 1, ⊤) :=
  (⟨fun y => degreeOneFraction y.1 s.2, fun y =>
    ⟨⊤, y.2, 𝟙 _, 0, s, mem_gradedTwist_one_zero s.2, 1, SetLike.GradedOne.one_mem,
      fun z => one_mem_primeCompl z.1, fun _ => rfl⟩⟩ :
    (ProjGradedModuleSheaf.sheafInType 𝒜 (gradedTwist 𝒜 1)).1.obj (op ⊤))

/-- For `f ∈ S_1` not in the homogeneous prime `x`, every element of `S(1)_(x)` is an
`S_(x)`-multiple of `f / 1`: `m / g = (m / (f g)) · (f / 1)`. -/
theorem exists_eq_smul_degreeOneFraction (x : ProjectiveSpectrum 𝒜) {f : A} (f_deg : f ∈ 𝒜 1)
    (hfx : f ∉ x.asHomogeneousIdeal)
    (z : HomogeneousLocalizedModule 𝒜 (gradedTwist 𝒜 1) x.asHomogeneousIdeal.toIdeal.primeCompl) :
    ∃ c : HomogeneousLocalization.AtPrime 𝒜 x.asHomogeneousIdeal.toIdeal,
      z = c • degreeOneFraction x f_deg := by
  obtain ⟨n, m, hm, g, hg, hgx, rfl⟩ := HomogeneousLocalizedModule.mk_surjective z
  have hm' : m ∈ 𝒜 (1 + n) := (mem_gradedTwist_of_eq (k := 1 + n) (by push_cast; ring)).1 hm
  have hfg : f * g ∈ 𝒜 (1 + n) := SetLike.GradedMul.mul_mem f_deg hg
  have hfgx : f * g ∈ x.asHomogeneousIdeal.toIdeal.primeCompl :=
    x.asHomogeneousIdeal.toIdeal.primeCompl.mul_mem hfx hgx
  refine ⟨HomogeneousLocalization.mk ⟨1 + n, ⟨m, hm'⟩, ⟨f * g, hfg⟩, hfgx⟩, ?_⟩
  ext
  rw [HomogeneousLocalizedModule.val_smul, degreeOneFraction, HomogeneousLocalizedModule.val_mk,
    HomogeneousLocalizedModule.val_mk, HomogeneousLocalization.val_mk,
    LocalizedModule.mk_smul_mk, LocalizedModule.mk_eq]
  refine ⟨1, ?_⟩
  simp only [one_smul, Submonoid.mk_smul, Submonoid.mk_mul_mk, smul_eq_mul]
  ring

open ProjGradedModuleSheaf in
/-- **Hartshorne II.5, Example 5.16.3.** Let `S` be a graded ring generated by `S_1` as an
`S_0`-algebra and `X = Proj S`. Then the elements of `S_1`, as global sections of `𝒪_X(1)`,
generate `𝒪_X(1)`: at every point their germs generate the stalk. -/
theorem isGeneratedBySections_degreeOneSection
    (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) :
    (projTwistingSheaf 𝒜 1).IsGeneratedBySections (degreeOneSection (𝒜 := 𝒜)) := by
  intro x
  obtain ⟨f, f_deg, hfx⟩ := exists_mem_one_notMem hgen x
  rw [eq_top_iff]
  rintro y -
  let L := stalkLinearEquiv 𝒜 (gradedTwist 𝒜 1) x
  obtain ⟨c, hc⟩ := exists_eq_smul_degreeOneFraction x f_deg hfx (L y)
  have hy : y = stalkRingHomInv 𝒜 x c •
      (projTwistingSheaf 𝒜 1).presheaf.germ ⊤ x trivial (degreeOneSection ⟨f, f_deg⟩) := by
    apply L.injective
    rw [hc]
    refine Eq.symm ((stalkToFiber_smul 𝒜 (gradedTwist 𝒜 1) x _ _).trans ?_)
    have hg := stalkToFiber_germ 𝒜 (gradedTwist 𝒜 1) ⊤ x trivial (degreeOneSection ⟨f, f_deg⟩)
    have hr : stalkRingEquiv 𝒜 x (stalkRingHomInv 𝒜 x c) = c :=
      (stalkRingEquiv 𝒜 x).apply_symm_apply c
    exact congrArg₂ (· • ·) hr hg
  rw [hy]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨f, f_deg⟩, rfl⟩)

/-- **Hartshorne II.5, Example 5.16.3.** If `S` is generated by `S_1` as an `S_0`-algebra, then
`𝒪_X(1)` on `X = Proj S` is generated by global sections. -/
theorem isGloballyGenerated (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) :
    (projTwistingSheaf 𝒜 1).IsGloballyGenerated :=
  ⟨_, _, isGeneratedBySections_degreeOneSection hgen⟩

end ProjTwistingSheaf

end Hartshorne
