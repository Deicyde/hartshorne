import Mathlib.RingTheory.RegularLocalRing.Defs
import Hartshorne.Scheme.CohenMacaulayRegularSequence

/-!
# Regular local rings are Cohen--Macaulay

Hartshorne, *Algebraic Geometry*, II, Theorem 8.21A(a), p. 184 (Stacks, tag 00NQ).

Every Noetherian regular local ring is Cohen--Macaulay.

## Main results

* `IsRegularLocalRing.isCohenMacaulayLocalRing`

## Proof outline

Let `(R, 𝔪)` be regular local of dimension `n`, so `𝔪` is generated by `n` elements.

* If `x ∈ 𝔪 \ 𝔪²`, then the class of `x` extends to a basis of `𝔪 ⧸ 𝔪²`; by Nakayama the
  maximal ideal of `R ⧸ (x)` is generated by `n - 1` elements, while Krull's height theorem gives
  `dim R ⧸ (x) ≥ n - 1`. Hence `R ⧸ (x)` is regular of dimension `n - 1`.
* A regular local ring is a domain, by induction on `n`: choose (prime avoidance) `x ∈ 𝔪`
  outside `𝔪²` and outside every minimal prime. By induction `(x)` is prime; a minimal prime
  `𝔭 ⊆ (x)` does not contain `x`, so `𝔭 = x𝔭` and `𝔭 = 0` by Nakayama.
* Hence any `x ∈ 𝔪 \ 𝔪²` is a non-zero-divisor, and lifting a regular sequence of length
  `n - 1` from `R ⧸ (x)` gives a regular sequence of length `n` in `𝔪`, so depth equals
  dimension.
-/

open IsLocalRing Ideal RingTheory.Sequence Pointwise

universe u

namespace Hartshorne.RegularLocal

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- If `x` lies in the maximal ideal `𝔪` of a regular local ring `R` but not in `𝔪²`, then
`R ⧸ (x)` is again a regular local ring, and its dimension is one less than that of `R`. -/
theorem isRegularLocalRing_quotient_of_notMem_sq {x : R} (hxm : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2) :
    IsRegularLocalRing (R ⧸ span {x}) ∧ ringKrullDim (R ⧸ span {x}) + 1 = ringKrullDim R := by
  set B := R ⧸ span {x}
  let π : R →+* B := Ideal.Quotient.mk (span {x})
  have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
  have hxB : span {x} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact (IsLocalRing.mem_maximalIdeal x).mp hxm
  have : Nontrivial B := Ideal.Quotient.nontrivial_iff.mpr hxB
  have : IsLocalRing B := IsLocalRing.of_surjective' π hπ
  have hcomap : (maximalIdeal B).comap π = maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective π hπ)
  have hmap : (maximalIdeal R).map π = maximalIdeal B := by
    rw [← hcomap, Ideal.map_comap_of_surjective π hπ]
  set n := (maximalIdeal R).spanFinrank
  have hA : (n : WithBot ℕ∞) = ringKrullDim R := (isRegularLocalRing_iff R).mp ‹_›
  -- Extend the class of `x` to a basis of `𝔪 ⧸ 𝔪²` and lift the other basis vectors to `𝔪`.
  set k := ResidueField R
  set V := CotangentSpace R
  set v : V := (maximalIdeal R).toCotangent ⟨x, hxm⟩
  have hv : v ≠ 0 := by
    rwa [Ne, Ideal.toCotangent_eq_zero]
  have hs : LinearIndepOn k id ({v} : Set V) := LinearIndepOn.singleton hv
  set E := hs.extend (Set.subset_univ _)
  let b : Module.Basis E k V := Module.Basis.extend hs
  have hvE : v ∈ E := hs.subset_extend _ (Set.mem_singleton v)
  have hEspan : Submodule.span k E = ⊤ := by
    have := b.span_eq
    rwa [Module.Basis.range_extend] at this
  have hEfin : E.Finite := Set.toFinite E
  have hEcard : E.ncard = n := by
    rw [← Nat.card_coe_set_eq, ← Module.finrank_eq_nat_card_basis b,
      ← spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
  obtain ⟨g, hg⟩ : ∃ g : V → maximalIdeal R, ∀ y, (maximalIdeal R).toCotangent (g y) = y :=
    ⟨_, Function.surjInv_eq (maximalIdeal R).toCotangent_surjective⟩
  set s : Set (maximalIdeal R) := insert ⟨x, hxm⟩ (g '' (E \ {v}))
  have himg : (maximalIdeal R).toCotangent '' s = E := by
    simp only [s, Set.image_insert_eq, ← Set.image_comp, Function.comp_def, hg,
      Set.image_id']
    exact Set.insert_sdiff_singleton.trans (Set.insert_eq_of_mem hvE)
  have hsR : Submodule.span R s = ⊤ := by
    rw [← CotangentSpace.span_image_eq_top_iff, himg, hEspan]
  set U : Set R := (fun y : V ↦ (g y : R)) '' (E \ {v})
  have hUfin : U.Finite := (hEfin.sdiff).image _
  have hmR : maximalIdeal R = span (insert x U) := by
    have := congrArg (Submodule.map (maximalIdeal R).subtype) hsR
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at this
    rw [← this]
    simp only [s, U, Set.image_insert_eq, ← Set.image_comp, Function.comp_def,
      Submodule.subtype_apply]
  have hmB : maximalIdeal B = span (π '' U) := by
    rw [← hmap, hmR, Ideal.map_span, Set.image_insert_eq,
      show π x = 0 from Ideal.Quotient.eq_zero_iff_mem.mpr (mem_span_singleton_self x),
      Ideal.span_insert_zero]
  have hsB : (maximalIdeal B).spanFinrank + 1 ≤ n := by
    rw [hmB]
    have h1 : (span (π '' U)).spanFinrank ≤ (E \ {v}).ncard :=
      (Submodule.spanFinrank_span_le_ncard_of_finite (hUfin.image _)).trans
        ((Set.ncard_image_le hUfin).trans (Set.ncard_image_le hEfin.sdiff))
    have h2 : (E \ {v}).ncard + 1 = n := by
      rw [Set.ncard_sdiff_singleton_add_one hvE hEfin, hEcard]
    omega
  -- Krull's height theorem: `dim R ≤ dim R ⧸ (x) + 1`.
  have hKrull : ringKrullDim R ≤ ringKrullDim B + 1 := by
    have := ringKrullDim_le_ringKrullDim_quotient_add_card ({x} : Finset R) (by
      rw [Finset.coe_singleton, Set.singleton_subset_iff, ringJacobson_eq_maximalIdeal]
      exact hxm)
    rw [Finset.coe_singleton, Finset.card_singleton, Nat.cast_one] at this
    exact this
  have hBle : ringKrullDim B ≤ (maximalIdeal B).spanFinrank :=
    ringKrullDim_le_spanFinrank_maximalIdeal B
  set d := (maximalIdeal B).spanFinrank
  rw [← hA] at hKrull ⊢
  have h0 : 0 ≤ ringKrullDim B := ringKrullDim_nonneg_of_nontrivial
  obtain ⟨e, he⟩ : ∃ e : ℕ, ringKrullDim B = e := by
    generalize ringKrullDim B = e at hBle h0 ⊢
    induction e using WithBot.recBotCoe with
    | bot => exact absurd h0 (by simp)
    | coe e =>
      induction e using ENat.recTopCoe with
      | top =>
        have : ((d : ℕ∞) : WithBot ℕ∞) < ((⊤ : ℕ∞) : WithBot ℕ∞) :=
          WithBot.coe_lt_coe.mpr (ENat.natCast_lt_top d)
        exact absurd hBle (not_le.mpr (by exact_mod_cast this))
      | coe e => exact ⟨e, rfl⟩
  rw [he] at hKrull hBle
  have hKrull' : n ≤ e + 1 := by exact_mod_cast hKrull
  have hBle' : e ≤ d := by exact_mod_cast hBle
  refine ⟨IsRegularLocalRing.of_spanFinrank_maximalIdeal_le B ?_, ?_⟩
  · rw [he]
    exact_mod_cast (show d ≤ e by omega)
  · rw [he]
    exact_mod_cast (show e + 1 = n by omega)

/-- In a regular local ring of positive dimension there is an element of the maximal ideal `𝔪`
lying neither in `𝔪²` nor in any minimal prime (prime avoidance). -/
theorem exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes
    (hn : 0 < (maximalIdeal R).spanFinrank) :
    ∃ x ∈ maximalIdeal R, x ∉ maximalIdeal R ^ 2 ∧ ∀ p ∈ minimalPrimes R, x ∉ p := by
  have hm2 : ¬ maximalIdeal R ≤ maximalIdeal R ^ 2 := by
    intro h
    have : maximalIdeal R = ⊥ := by
      refine Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal R) (maximalIdeal R)
        (maximalIdeal R).fg_of_isNoetherianRing ?_ (maximalIdeal_le_jacobson ⊥)
      rwa [smul_eq_mul, ← pow_two]
    rw [this, Submodule.spanFinrank_bot] at hn
    exact lt_irrefl 0 hn
  have hmin : ∀ p ∈ minimalPrimes R, ¬ maximalIdeal R ≤ p := by
    intro p hp h
    have hpm : p = maximalIdeal R :=
      ((maximalIdeal.isMaximal R).eq_of_le hp.1.1.ne_top h).symm
    subst hpm
    have h0 := (Ideal.height_eq_zero_iff (I := maximalIdeal R)).mpr hp
    have h1 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := R)
    rw [h0, ← (isRegularLocalRing_iff R).mp ‹_›] at h1
    have : (maximalIdeal R).spanFinrank = 0 := by exact_mod_cast h1.symm
    omega
  set S : Set (Ideal R) := insert (maximalIdeal R ^ 2) (minimalPrimes R)
  have hS : S.Finite := (minimalPrimes.finite_of_isNoetherianRing R).insert _
  have hnot : ¬ ((maximalIdeal R : Set R) ⊆ ⋃ i ∈ S, ((id i : Ideal R) : Set R)) := by
    rw [Ideal.subset_union_prime_finite hS (maximalIdeal R ^ 2) (maximalIdeal R ^ 2)]
    · rintro ⟨i, hi, hle⟩
      rcases hi with rfl | hi
      · exact hm2 hle
      · exact hmin i hi hle
    · rintro i (rfl | hi) h _
      · exact absurd rfl h
      · exact hi.1.1
  simp only [Set.not_subset, Set.mem_iUnion, not_exists, SetLike.mem_coe, id] at hnot
  obtain ⟨x, hxm, hx⟩ := hnot
  exact ⟨x, hxm, fun h => hx _ (Set.mem_insert _ _) h,
    fun p hp h => hx p (Set.mem_insert_of_mem _ hp) h⟩

/-- A commutative ring whose zero ideal is prime is a domain. -/
lemma isDomain_of_isPrime_bot {A : Type*} [CommRing A] (h : (⊥ : Ideal A).IsPrime) :
    IsDomain A := by
  have : Nontrivial A := ⟨⟨0, 1, fun h01 => h.ne_top (by
    rw [Ideal.eq_top_iff_one]; rw [← h01]; exact zero_mem _)⟩⟩
  have : NoZeroDivisors A := ⟨fun {a b} hab => by
    simpa using h.mem_or_mem (show a * b ∈ (⊥ : Ideal A) by simp [hab])⟩
  exact NoZeroDivisors.to_isDomain A

/-- A regular local ring whose maximal ideal is generated by `n`
elements is a domain. -/
theorem isDomain_of_spanFinrank_eq (n : ℕ) :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A],
      (maximalIdeal A).spanFinrank = n → IsDomain A := by
  induction n with
  | zero =>
    intro A _ _ hn
    have : maximalIdeal A = ⊥ :=
      (Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal A).fg_of_isNoetherianRing).mp hn
    exact isDomain_of_isPrime_bot (this ▸ (maximalIdeal.isMaximal A).isPrime)
  | succ n ih =>
    intro A _ _ hn
    obtain ⟨x, hxm, hx2, hxmin⟩ :=
      exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes (R := A) (by omega)
    obtain ⟨hreg, hdim⟩ := isRegularLocalRing_quotient_of_notMem_sq hxm hx2
    have hBn : (maximalIdeal (A ⧸ span {x})).spanFinrank = n := by
      have h1 := (isRegularLocalRing_iff (A ⧸ span {x})).mp hreg
      rw [← (isRegularLocalRing_iff A).mp ‹_›, hn, ← h1] at hdim
      have : ((maximalIdeal (A ⧸ span {x})).spanFinrank + 1 : ℕ) = n + 1 := by
        exact_mod_cast hdim
      omega
    have hdom := ih (A ⧸ span {x}) hBn
    have hprime : (span {x} : Ideal A).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hdom
    obtain ⟨p, hp, hpx⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A) ≤ span {x})
    have hpp : p.IsPrime := hp.1.1
    have hxp : x ∉ p := hxmin p hp
    have hle : p ≤ maximalIdeal A • p := by
      intro y hy
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp (hpx hy)
      have ha : a ∈ p := (hpp.mem_or_mem hy).resolve_right hxp
      rw [smul_eq_mul, mul_comm a x]
      exact Ideal.mul_mem_mul hxm ha
    have hp0 : p = ⊥ := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal A) p
      p.fg_of_isNoetherianRing hle (maximalIdeal_le_jacobson ⊥)
    exact isDomain_of_isPrime_bot (hp0 ▸ hpp)

variable (R) in
/-- A regular local ring is a domain. -/
theorem isDomain : IsDomain R :=
  isDomain_of_spanFinrank_eq _ R rfl

/-- A regular local ring whose maximal ideal is generated by `n` elements has a weakly regular
sequence of length `n` generating its maximal ideal. -/
theorem exists_isWeaklyRegular_of_spanFinrank_eq (n : ℕ) :
    ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A],
      (maximalIdeal A).spanFinrank = n →
        ∃ rs : List A, rs.length = n ∧ Ideal.ofList rs = maximalIdeal A ∧
          IsWeaklyRegular A rs := by
  induction n with
  | zero =>
    intro A _ _ h
    refine ⟨[], rfl, ?_, IsWeaklyRegular.nil A A⟩
    rw [Ideal.ofList_nil, eq_comm,
      ← Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal A).fg_of_isNoetherianRing]
    exact h
  | succ n ih =>
    intro A _ _ hn
    have := isDomain (R := A)
    obtain ⟨x, hxm, hx2, -⟩ :=
      exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes (R := A) (by omega)
    have hx0 : x ≠ 0 := by
      rintro rfl
      exact hx2 (zero_mem _)
    obtain ⟨hreg, hdim⟩ := isRegularLocalRing_quotient_of_notMem_sq hxm hx2
    set B := A ⧸ span {x}
    let π : A →+* B := Ideal.Quotient.mk (span {x})
    have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
    have hBn : (maximalIdeal B).spanFinrank = n := by
      have h1 := (isRegularLocalRing_iff B).mp hreg
      rw [← (isRegularLocalRing_iff A).mp ‹_›, hn, ← h1] at hdim
      have : ((maximalIdeal B).spanFinrank + 1 : ℕ) = n + 1 := by exact_mod_cast hdim
      omega
    obtain ⟨ys, hlen, hgen, hys⟩ := ih B hBn
    set zs := ys.map (Function.surjInv hπ)
    have hzs : zs.map π = ys := by
      simp only [zs, List.map_map, Function.comp_def, Function.surjInv_eq hπ, List.map_id']
    have hcomap : (maximalIdeal B).comap π = maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective π hπ)
    refine ⟨x :: zs, by simp [zs, hlen], ?_, ?_⟩
    · rw [Ideal.ofList_cons, ← hcomap, ← hgen, ← hzs, ← Ideal.map_ofList,
        Ideal.comap_map_of_surjective _ hπ, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_comm]
    · have hI : (x • (⊤ : Submodule A A)) = span {x} := by
        rw [← Submodule.ideal_span_singleton_smul, smul_eq_mul, Ideal.mul_top]
      rw [isWeaklyRegular_cons_iff, LinearEquiv.isWeaklyRegular_congr
        (Submodule.quotEquivOfEq _ _ hI), ← isWeaklyRegular_map_algebraMap_iff B B]
      refine ⟨IsSMulRegular.of_right_eq_zero_of_smul (fun y hy => ?_), ?_⟩
      · exact (mul_eq_zero.mp hy).resolve_left hx0
      · rw [Ideal.Quotient.algebraMap_eq]
        exact hzs ▸ hys

end Hartshorne.RegularLocal

open Hartshorne.RegularLocal in
/-- **Hartshorne II, Theorem 8.21A(a)**: every Noetherian regular local ring is
Cohen–Macaulay. -/
theorem IsRegularLocalRing.isCohenMacaulayLocalRing (R : Type u) [CommRing R]
    [IsRegularLocalRing R] : IsCohenMacaulayLocalRing R := by
  obtain ⟨rs, hlen, hgen, hrs⟩ := exists_isWeaklyRegular_of_spanFinrank_eq _ R rfl
  have hmem : ∀ r ∈ rs, r ∈ maximalIdeal R := fun r hr => hgen ▸ Ideal.subset_span hr
  refine Hartshorne.CohenMacaulay.isCohenMacaulayLocalRing_of_isRegular R rs ?_ hmem
    (IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal _ hmem hrs)
  rw [hlen, (isRegularLocalRing_iff R).mp ‹_›]
