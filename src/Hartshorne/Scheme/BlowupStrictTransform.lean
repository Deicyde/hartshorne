import Hartshorne.Scheme.BlowupFunctoriality
import Hartshorne.Scheme.BlowupIsoOffCenter
import Mathlib.AlgebraicGeometry.Morphisms.SchemeTheoreticallyDominant

/-!
# Strict transforms

Hartshorne, *Algebraic Geometry*, II.7, the definition after Corollary 7.15 and Example 7.15.1
(pp. 165–166).

Let `X` be a Noetherian scheme, `I` a coherent sheaf of ideals on `X`, `π : X̃ ⟶ X` the blowing-up
of `I`, and `f : Y ⟶ X` a closed immersion with `Y` Noetherian. The **strict transform** of `Y` is
the blowing-up `π' : Ỹ ⟶ Y` of the inverse image ideal sheaf `f⁻¹I · 𝒪_Y`, together with the closed
immersion `f̃ : Ỹ ⟶ X̃` of Corollary 7.15 (the unique morphism with `π ∘ f̃ = f ∘ π'`).

The strict transform is the scheme-theoretic closure in `X̃` of `π⁻¹(Y \ V(I))`, the fibre product
`(Y \ V(I)) ×_X X̃` of `Y \ V(I) ⟶ X` and `π`. Indeed, by Proposition 7.13(b) the blowing-ups `π`
and `π'` are isomorphisms off their centers, so `f̃` identifies the open subscheme
`π'⁻¹(Y \ V(I)) ⊆ Ỹ` with `π⁻¹(Y \ V(I))`; and since the inverse image of the center on `Ỹ` is
locally generated by one non-zero-divisor (Proposition 7.13(a)), the open subscheme
`π'⁻¹(Y \ V(I))`, its complement, is scheme-theoretically dense in `Ỹ`. In Example 7.15.1
(`X = 𝔸ⁿ`, `I` the ideal of the origin `P`, `Y` an integral closed subvariety through `P` other
than `{P}`) this is the identification of the strict transform with the closure of
`π⁻¹(Y - {P})`; the statement here needs none of those hypotheses.

## Main results

* `Hartshorne.QuasicoherentIdealSubsheaf.strictTransform`,
  `Hartshorne.QuasicoherentIdealSubsheaf.strictTransformι`: the strict transform `Ỹ` and the
  morphism `f̃ : Ỹ ⟶ X̃`;
  `Hartshorne.QuasicoherentIdealSubsheaf.strictTransformι_blowupProjection`: `π ∘ f̃ = f ∘ π'`;
  `Hartshorne.QuasicoherentIdealSubsheaf.isClosedImmersion_strictTransformι`: `f̃` is a closed
  immersion when `f` is.
* `Hartshorne.isSchemeTheoreticallyDominant_ι_of_isLocallyPrincipalNonZeroDivisor`: the open
  complement of the support of an ideal sheaf locally generated by one non-zero-divisor is
  scheme-theoretically dense.
* `Hartshorne.QuasicoherentIdealSubsheaf.ker_strictTransformι`: the ideal sheaf of `f̃(Ỹ) ⊆ X̃`
  is the ideal sheaf of the scheme-theoretic image of `π⁻¹(Y \ V(I)) ⟶ X̃`;
  `Hartshorne.QuasicoherentIdealSubsheaf.range_strictTransformι`: for a closed immersion `f`, the
  image of `f̃` is the closure of `π⁻¹(Y \ V(I))`;
  `Hartshorne.QuasicoherentIdealSubsheaf.strictTransformIsoClosure`: hence, for a closed
  immersion `f`, `Ỹ` is isomorphic over `X̃` to that scheme-theoretic closure.
-/

noncomputable section

universe u

open CategoryTheory Limits AlgebraicGeometry Opposite

namespace Hartshorne

/-- **The complement of an effective Cartier divisor is scheme-theoretically dense.** If the ideal
sheaf `K` on `S` is locally generated by one non-zero-divisor and `W ⊆ S` is the open complement
of its support, then the inclusion `W ⟶ S` is scheme-theoretically dominant: a section of `𝒪_S`
vanishing on `W` vanishes. -/
theorem isSchemeTheoreticallyDominant_ι_of_isLocallyPrincipalNonZeroDivisor {S : Scheme.{u}}
    {K : S.IdealSheafData} (hK : K.IsLocallyPrincipalNonZeroDivisor) (W : S.Opens)
    (hW : ∀ x, x ∈ W ↔ x ∉ K.support) : IsSchemeTheoreticallyDominant W.ι := by
  have key : ∀ (U : S.Opens) (s : Γ(S, U)), W.ι.app U s = 0 → s = 0 := by
    intro U s hs
    rw [Scheme.Opens.ι_app] at hs
    refine TopCat.Presheaf.section_ext S.sheaf U s 0 fun x hx => ?_
    obtain ⟨U₀, hxU₀, g, hg, hKU₀⟩ := hK x
    obtain ⟨b, hbU, hxb⟩ := U₀.2.exists_basicOpen_le (V := U) ⟨x, hx⟩ hxU₀
    have := U₀.2.isLocalization_basicOpen b
    set t : Γ(S, S.basicOpen b) := S.presheaf.map (homOfLE (S.basicOpen_le b)).op g with ht
    have htnz : t ∈ nonZeroDivisors Γ(S, S.basicOpen b) :=
      IsLocalization.nonZeroDivisors_le_comap (Submonoid.powers b) Γ(S, S.basicOpen b) hg
    set r : Γ(S, S.basicOpen b) := S.presheaf.map (homOfLE hbU).op s with hr
    have hle : S.basicOpen t ≤ W.ι ''ᵁ W.ι ⁻¹ᵁ U := by
      intro y hy
      rw [ht, Scheme.basicOpen_res] at hy
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      refine ⟨(hW y).2 fun hyK => ?_, hbU hy.1⟩
      rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := U₀) (S.basicOpen_le b hy.1),
        Scheme.mem_zeroLocus_iff, hKU₀] at hyK
      exact hyK g (Ideal.mem_span_singleton_self g) hy.2
    have H : S.presheaf.map (homOfLE (S.basicOpen_le t)).op r = 0 := by
      have e : S.presheaf.map ((homOfLE (x := W.ι ''ᵁ W.ι ⁻¹ᵁ U)
          (Set.image_preimage_subset _ _)).op ≫ (homOfLE hle).op) s = 0 := by
        rw [Functor.map_comp, CommRingCat.comp_apply]
        exact (congrArg (S.presheaf.map (homOfLE hle).op) hs).trans (map_zero _)
      have e' : S.presheaf.map ((homOfLE hbU).op ≫ (homOfLE (S.basicOpen_le t)).op) s = 0 := e
      rwa [Functor.map_comp, CommRingCat.comp_apply] at e'
    obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen S
      (U₀.2.basicOpen b) r t H
    have hr0 : r = 0 := by
      rw [mul_comm] at hn
      exact (mem_nonZeroDivisors_iff_right.mp (pow_mem htnz n)) r hn
    change S.presheaf.germ U x hx s = S.presheaf.germ U x hx 0
    rw [← S.presheaf.germ_res_apply (homOfLE hbU) x hxb, ← hr, hr0, map_zero, map_zero]
  rw [isSchemeTheoreticallyDominant_iff]
  ext U s
  simp only [Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, Ideal.mem_bot]
  refine ⟨fun hs => key U s (RingHom.mem_ker.1 (W.ι.ideal_ker_le U hs)), ?_⟩
  rintro rfl
  exact zero_mem _

namespace QuasicoherentIdealSubsheaf

variable {X Y : Scheme.{u}} [IsNoetherian X] [IsNoetherian Y] (f : Y ⟶ X)
  (I : QuasicoherentIdealSubsheaf X) (hI : IsCoherent I.toModules)

/-- **The strict transform** (Hartshorne II.7, p. 165): for a morphism `f : Y ⟶ X` of Noetherian
schemes and a coherent sheaf of ideals `I` on `X`, the blowing-up `Ỹ` of `Y` with respect to the
inverse image ideal sheaf `f⁻¹I · 𝒪_Y`. When `f` is a closed immersion, this is the strict
transform of the closed subscheme `Y` under the blowing-up `π : X̃ ⟶ X` of `I`, embedded in `X̃`
by `strictTransformι` (`isClosedImmersion_strictTransformι`). -/
abbrev strictTransform : Scheme.{u} :=
  (I.inverseImage f).blowup (I.isCoherent_inverseImage f)

/-- The projection `π' : Ỹ ⟶ Y` of the strict transform: the blowing-up of `f⁻¹I · 𝒪_Y`. -/
abbrev strictTransformProjection : I.strictTransform f ⟶ Y :=
  (I.inverseImage f).blowupProjection (I.isCoherent_inverseImage f)

/-- The morphism `f̃ : Ỹ ⟶ X̃` from the strict transform to the blowing-up of `I`: the unique
morphism with `π ∘ f̃ = f ∘ π'` (Hartshorne II, Corollary 7.15). -/
def strictTransformι : I.strictTransform f ⟶ I.blowup hI :=
  (I.existsUnique_blowup_map f hI).exists.choose

/-- `π ∘ f̃ = f ∘ π'`. -/
@[reassoc]
theorem strictTransformι_blowupProjection :
    I.strictTransformι f hI ≫ I.blowupProjection hI = I.strictTransformProjection f ≫ f :=
  (I.existsUnique_blowup_map f hI).exists.choose_spec

/-- `f̃` is the unique morphism `Ỹ ⟶ X̃` over `f`. -/
theorem eq_strictTransformι {g : I.strictTransform f ⟶ I.blowup hI}
    (hg : g ≫ I.blowupProjection hI = I.strictTransformProjection f ≫ f) :
    g = I.strictTransformι f hI :=
  (I.existsUnique_blowup_map f hI).unique hg (I.strictTransformι_blowupProjection f hI)

/-- **Hartshorne II.7, p. 165.** If `f : Y ⟶ X` is a closed immersion, the strict transform
`f̃ : Ỹ ⟶ X̃` is a closed immersion (Corollary 7.15). -/
instance isClosedImmersion_strictTransformι [IsClosedImmersion f] :
    IsClosedImmersion (I.strictTransformι f hI) :=
  I.isClosedImmersion_of_blowup_map f hI _ (I.strictTransformι_blowupProjection f hI)

omit [AlgebraicGeometry.IsNoetherian X] [AlgebraicGeometry.IsNoetherian Y] in
/-- The complement `Y \ V(f⁻¹I · 𝒪_Y)` of the center of the strict transform is the preimage
`f⁻¹(X \ V(I))`. -/
theorem centerCompl_inverseImage :
    (I.inverseImage f).centerCompl = f ⁻¹ᵁ I.centerCompl := by
  ext y
  change y ∈ (Set.range (quasicoherentIdealSubsheafEquiv (I.inverseImage f)).subschemeι)ᶜ ↔
    f y ∈ (Set.range (quasicoherentIdealSubsheafEquiv I).subschemeι)ᶜ
  rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.range_subschemeι]
  change y ∉ (quasicoherentIdealSubsheafEquiv (quasicoherentIdealSubsheafEquiv.symm
    (inverseImageIdeal f (quasicoherentIdealSubsheafEquiv I)))).support ↔ _
  rw [Equiv.apply_symm_apply, inverseImageIdeal, Scheme.IdealSheafData.support_comap]
  rfl

omit [AlgebraicGeometry.IsNoetherian Y] in
/-- On a Noetherian scheme, the open complement `X̃ \ E` of the exceptional divisor of the
blowing-up of `I` is scheme-theoretically dense in `X̃`. -/
theorem isSchemeTheoreticallyDominant_blowupProjection_preimage_centerCompl :
    IsSchemeTheoreticallyDominant (I.blowupProjection hI ⁻¹ᵁ I.centerCompl).ι := by
  refine isSchemeTheoreticallyDominant_ι_of_isLocallyPrincipalNonZeroDivisor
    (I.isLocallyPrincipalNonZeroDivisor_exceptionalIdeal hI) _ fun x => ?_
  change I.blowupProjection hI x ∈ (Set.range (quasicoherentIdealSubsheafEquiv I).subschemeι)ᶜ ↔ _
  rw [Scheme.IdealSheafData.range_subschemeι, exceptionalIdeal, inverseImageIdeal,
    Scheme.IdealSheafData.support_comap]
  rfl

/-- The inclusion `π'⁻¹(Y \ V(I)) ⟶ π⁻¹(Y \ V(I)) = (Y \ V(I)) ×_X X̃` induced by `π'` and
`f̃`. -/
private def strictTransformPuncturedLift :
    ((I.strictTransformProjection f) ⁻¹ᵁ (f ⁻¹ᵁ I.centerCompl)).toScheme ⟶
      pullback ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI) :=
  pullback.lift (I.strictTransformProjection f ∣_ (f ⁻¹ᵁ I.centerCompl))
    ((I.strictTransformProjection f ⁻¹ᵁ (f ⁻¹ᵁ I.centerCompl)).ι ≫ I.strictTransformι f hI)
    (by rw [morphismRestrict_ι_assoc, Category.assoc, strictTransformι_blowupProjection])

/-- Off the center, `f̃` identifies `π'⁻¹(Y \ V(I))` with `π⁻¹(Y \ V(I))`: both blowing-ups are
isomorphisms there (Hartshorne II.7.13(b)). -/
private theorem isIso_strictTransformPuncturedLift :
    IsIso (I.strictTransformPuncturedLift f hI) := by
  have h₁ : IsIso (I.strictTransformProjection f ∣_ (f ⁻¹ᵁ I.centerCompl)) := by
    rw [← centerCompl_inverseImage]
    exact (I.inverseImage f).isIso_blowupProjection_restrict_centerCompl _
  have h₂ : IsIso (pullback.fst ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI)) := by
    have hπ := I.isIso_blowupProjection_restrict_centerCompl hI
    have h₃ : IsIso (pullback.fst I.centerCompl.ι (I.blowupProjection hI)) :=
      IsIso.of_isIso_fac_left
        (isPullback_morphismRestrict (I.blowupProjection hI) I.centerCompl).isoPullback_hom_fst
    rw [← morphismRestrict_ι]
    exact IsIso.of_isIso_fac_left (pullbackRightPullbackFstIso_hom_fst I.centerCompl.ι
      (I.blowupProjection hI) (f ∣_ I.centerCompl))
  have : I.strictTransformPuncturedLift f hI ≫
      pullback.fst ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI) =
      I.strictTransformProjection f ∣_ (f ⁻¹ᵁ I.centerCompl) :=
    pullback.lift_fst _ _ _
  exact IsIso.of_isIso_fac_right this

/-- **Hartshorne II.7, Example 7.15.1 (strict transform as a closure), generalized.** Let `X`,
`Y` be Noetherian schemes, `f : Y ⟶ X`, `I` a coherent sheaf of ideals on `X` and `π : X̃ ⟶ X` its
blowing-up. Then the ideal sheaf of `f̃(Ỹ) ⊆ X̃` (the kernel of the strict transform
`f̃ : Ỹ ⟶ X̃`) is the ideal sheaf of the scheme-theoretic image of
`π⁻¹(Y \ V(I)) = (Y \ V(I)) ×_X X̃ ⟶ X̃`, that is, of its scheme-theoretic closure. -/
theorem ker_strictTransformι :
    (I.strictTransformι f hI).ker =
      (pullback.snd ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI)).ker := by
  have := I.isIso_strictTransformPuncturedLift f hI
  have hW : IsSchemeTheoreticallyDominant
      ((I.strictTransformProjection f) ⁻¹ᵁ (f ⁻¹ᵁ I.centerCompl)).ι := by
    have := (I.inverseImage f).isSchemeTheoreticallyDominant_blowupProjection_preimage_centerCompl
      (I.isCoherent_inverseImage f)
    rwa [centerCompl_inverseImage] at this
  have hsnd : pullback.snd ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI) =
      inv (I.strictTransformPuncturedLift f hI) ≫
        (I.strictTransformProjection f ⁻¹ᵁ (f ⁻¹ᵁ I.centerCompl)).ι ≫ I.strictTransformι f hI := by
    rw [IsIso.eq_inv_comp, strictTransformPuncturedLift, pullback.lift_snd]
  rw [hsnd, Scheme.Hom.ker_comp_of_isIso, Scheme.Hom.ker_comp,
    Scheme.Hom.ker_eq_bot (I.strictTransformProjection f ⁻¹ᵁ (f ⁻¹ᵁ I.centerCompl)).ι,
    Scheme.IdealSheafData.map_bot]

/-- **Hartshorne II.7, Example 7.15.1 (strict transform as a closure), generalized; underlying
sets.** If `f : Y ⟶ X` is a closed immersion of Noetherian schemes, the image of the strict
transform `f̃ : Ỹ ⟶ X̃` is the closure in `X̃` of `π⁻¹(Y \ V(I))`. -/
theorem range_strictTransformι [IsClosedImmersion f] :
    Set.range (I.strictTransformι f hI) =
      closure (Set.range (pullback.snd ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI))) := by
  have h := (pullback.snd ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI)).support_ker
  rw [← I.ker_strictTransformι f hI, Scheme.Hom.support_ker,
    (I.strictTransformι f hI).isClosedEmbedding.isClosed_range.closure_eq] at h
  exact h

/-- **Hartshorne II.7, Example 7.15.1 (strict transform as a closure), generalized.** If
`f : Y ⟶ X` is a closed immersion of Noetherian schemes, the strict transform `Ỹ` is isomorphic,
over the blowing-up `X̃` of `I`, to the scheme-theoretic closure in `X̃` (the scheme-theoretic
image) of `π⁻¹(Y \ V(I)) = (Y \ V(I)) ×_X X̃`. -/
def strictTransformIsoClosure [IsClosedImmersion f] :
    I.strictTransform f ≅
      (pullback.snd ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI)).image :=
  asIso (I.strictTransformι f hI).toImage ≪≫
    { hom := Scheme.IdealSheafData.inclusion (I.ker_strictTransformι f hI).ge
      inv := Scheme.IdealSheafData.inclusion (I.ker_strictTransformι f hI).le
      hom_inv_id := by
        rw [← cancel_mono (Scheme.IdealSheafData.subschemeι _)]
        simp
      inv_hom_id := by
        rw [← cancel_mono (Scheme.IdealSheafData.subschemeι _)]
        simp }

@[reassoc (attr := simp)]
theorem strictTransformIsoClosure_hom_imageι [IsClosedImmersion f] :
    (I.strictTransformIsoClosure f hI).hom ≫
        (pullback.snd ((f ⁻¹ᵁ I.centerCompl).ι ≫ f) (I.blowupProjection hI)).imageι =
      I.strictTransformι f hI := by
  simp [strictTransformIsoClosure, Scheme.Hom.imageι]

end QuasicoherentIdealSubsheaf

end Hartshorne
