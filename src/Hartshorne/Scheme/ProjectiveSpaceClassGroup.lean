import Hartshorne.Scheme.ClassGroupOpenRestriction
import Hartshorne.Scheme.CodimensionOneStalkDVR
import Hartshorne.Scheme.ProjectiveIntersectionDivisor
import Hartshorne.Scheme.ProjectiveSpaceRegular
import Hartshorne.Scheme.WeilClassGroup

/-!
# The class group of projective space

Hartshorne, *Algebraic Geometry*, II.6, Proposition 6.4 (pp. 132–133).

Let `k` be a field, `n ≥ 1` and `ℙⁿ_k = Proj k[x₀, …, xₙ]` (this is `projectiveSpaceScheme k n`
by definition). The homogeneous prime of a prime divisor `Y` of `ℙⁿ_k` is generated by one
irreducible homogeneous polynomial, of a well-defined degree `deg Y`, the degree of the
hypersurface `Y`. The degree of a Weil divisor `D = ∑ nᵢ Yᵢ` is `∑ nᵢ deg Yᵢ`.

## Proof

`ℙⁿ_k` is Noetherian, integral (its generic point is the zero ideal and its local rings are
subrings of the fraction field of `k[x₀, …, xₙ]`), separated and regular, so it satisfies
condition `(*)`. Its function field consists of the fractions `g / h` of homogeneous polynomials
of the same degree. At a prime divisor `Y` with homogeneous prime `(f)`, and on a chart `D₊(h)`
containing `Y`, the local ring is the degree-zero homogeneous localization, in which `f / h` is
irreducible (every non-unit `a / b` has `a ∈ (f)`, hence is divisible by `f / h`); so `f / h`
has order one along `Y`, while `g / h` with `g ∉ (f)` is a unit. Consequently, for an
irreducible homogeneous `q` of degree `d` and a hyperplane `H = V(ℓ)`, the principal divisor of
`q / ℓ^d` is `V(q) - d · H`. Applying this to every prime divisor gives `D ∼ deg(D) · H`.
Factoring a homogeneous `g` into (necessarily homogeneous) prime factors shows that the divisor
of `g / x₀^e` has degree zero; since every rational function is `g / h = (g / x₀^e) / (h / x₀^e)`,
every principal divisor has degree zero. Hence degree descends to `Cl(ℙⁿ_k)`; it is surjective
because `deg H = 1` and injective because `D ∼ deg(D) · H`.

## Main results

* `Hartshorne.projectiveSpace_satisfiesConditionStar`: `ℙⁿ_k` satisfies `(*)`.
* `Hartshorne.projectiveSpaceWeilDivisorDegree`: the degree `Div ℙⁿ_k →+ ℤ`.
* `Hartshorne.projectiveSpace_linearEquivalent_degree_smul_hyperplane`: `D ∼ deg(D) · H`.
* `Hartshorne.projectiveSpaceWeilDivisorDegree_principalDivisor`: principal divisors have
  degree zero.
* `Hartshorne.projectiveSpaceClassGroupEquiv`: `Cl(ℙⁿ_k) ≃+ ℤ`, sending the class of `D` to
  `deg D` and the class of a hyperplane to `1`.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial HomogeneousLocalization

namespace Hartshorne

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

variable {k : Type u} [Field k] {n : ℕ}

local notation "𝒜" => homogeneousSubmodule (Fin (n + 1)) k

local notation "S" => MvPolynomial (Fin (n + 1)) k

private instance projectiveSpace_isPrime (x : Proj 𝒜) : x.asHomogeneousIdeal.toIdeal.IsPrime :=
  x.isPrime

section ConditionStar

/-- The generic point of `ℙⁿ_k`: the zero ideal of `k[x₀, …, xₙ]`. -/
def projectiveSpaceGenericPoint : Proj 𝒜 :=
  ⟨⊥, Ideal.isPrime_bot, fun h ↦
    MvPolynomial.X_ne_zero 0 ((Submodule.mem_bot _).mp (h (X_mem_irrelevant_projectiveSpace 0)))⟩

theorem projectiveSpaceGenericPoint_specializes (x : Proj 𝒜) :
    (projectiveSpaceGenericPoint : Proj 𝒜) ⤳ x := by
  rw [projectiveSpace_specializes_iff_le]
  exact bot_le

theorem isGenericPoint_projectiveSpaceGenericPoint :
    IsGenericPoint (projectiveSpaceGenericPoint : Proj 𝒜) Set.univ :=
  isGenericPoint_iff_specializes.mpr fun x ↦
    ⟨fun _ ↦ trivial, fun _ ↦ projectiveSpaceGenericPoint_specializes x⟩

instance projectiveSpace_irreducibleSpace : IrreducibleSpace (Proj 𝒜) :=
  (irreducibleSpace_def _).mpr isGenericPoint_projectiveSpaceGenericPoint.isIrreducible

instance projectiveSpace_isDomain_stalk (x : Proj 𝒜) : IsDomain ((Proj 𝒜).presheaf.stalk x) := by
  have : IsDomain (AtPrime 𝒜 x.asHomogeneousIdeal.toIdeal) :=
    Function.Injective.isDomain
      (algebraMap (AtPrime 𝒜 x.asHomogeneousIdeal.toIdeal)
        (Localization x.asHomogeneousIdeal.toIdeal.primeCompl))
      (HomogeneousLocalization.val_injective _)
  have : IsDomain (CommRingCat.of (AtPrime 𝒜 x.asHomogeneousIdeal.toIdeal)) := this
  exact Function.Injective.isDomain (Proj.stalkIso 𝒜 x).hom.hom
    (ConcreteCategory.injective_of_mono_of_preservesPullback (Proj.stalkIso 𝒜 x).hom)

instance projectiveSpace_isReduced : IsReduced (Proj 𝒜) := isReduced_of_isReduced_stalk _

instance projectiveSpace_isIntegral : IsIntegral (Proj 𝒜) :=
  isIntegral_of_irreducibleSpace_of_isReduced _

theorem projectiveSpace_isRegular : (Proj 𝒜).IsRegular :=
  projectiveSpaceScheme_isRegular k n

instance projectiveSpace_isNoetherian : IsNoetherian (Proj 𝒜) :=
  have := projectiveSpace_isRegular (k := k) (n := n) |>.1
  have := compactSpace_of_isClosedImmersion_projectiveSpace (𝟙 (Proj 𝒜))
  {}

/-- **`ℙⁿ_k` satisfies condition `(*)`.** It is Noetherian, integral, separated and regular, in
particular regular in codimension one. -/
theorem projectiveSpace_satisfiesConditionStar : (Proj 𝒜).SatisfiesConditionStar :=
  ⟨inferInstance, inferInstance, inferInstance, fun x _ ↦ projectiveSpace_isRegular.2 x⟩

end ConditionStar

section Polynomial

/-- The degree of a nonzero homogeneous factor is at most the degree of the product. -/
theorem le_of_mul_isHomogeneous {a f : S} {d l : ℕ}
    (hf : f.IsHomogeneous d) (haf : (a * f).IsHomogeneous l) (haf0 : a * f ≠ 0) : d ≤ l := by
  have ha0 : a ≠ 0 := left_ne_zero_of_mul haf0
  have hf0 : f ≠ 0 := right_ne_zero_of_mul haf0
  have h1 := totalDegree_mul_of_isDomain ha0 hf0
  rw [haf.totalDegree haf0, hf.totalDegree hf0] at h1
  omega

/-- A prime factor of a nonzero homogeneous polynomial is homogeneous. -/
theorem exists_isHomogeneous_of_prime_dvd {q g : S} {e : ℕ} (hg : g.IsHomogeneous e)
    (hg0 : g ≠ 0) (hq : Prime q) (hqg : q ∣ g) : ∃ j, q.IsHomogeneous j := by
  classical
  set J := Ideal.span ({q} : Set S)
  have hJprime : J.IsPrime := (Ideal.span_singleton_prime hq.ne_zero).mpr hq
  set Jc := J.homogeneousCore 𝒜
  have hJcJ : Jc.toIdeal ≤ J := Ideal.toIdeal_homogeneousCore_le 𝒜 J
  have hgJc : g ∈ Jc.toIdeal :=
    Ideal.mem_homogeneousCore_of_homogeneous_of_mem
      ⟨e, (mem_homogeneousSubmodule e g).mpr hg⟩ (Ideal.mem_span_singleton.mpr hqg)
  have hJc_ne : Jc.toIdeal ≠ ⊥ := fun h ↦ hg0 (by rw [h] at hgJc; exact (Submodule.mem_bot _).mp hgJc)
  obtain ⟨p, hpJc, hp⟩ := hJprime.homogeneousCore.exists_mem_prime_of_ne_bot hJc_ne
  have hqp : q ∣ p := Ideal.mem_span_singleton.mp (hJcJ hpJc)
  have hpq : p ∣ q := hq.irreducible.dvd_symm hp.irreducible hqp
  have hqJc : q ∈ Jc.toIdeal := by
    obtain ⟨c, hc⟩ := hpq
    rw [hc]
    exact Ideal.mul_mem_right _ _ hpJc
  have hhom : J.IsHomogeneous 𝒜 := by
    have hJ : Jc.toIdeal = J :=
      le_antisymm hJcJ ((Ideal.span_singleton_le_iff_mem _).mpr hqJc)
    rw [← hJ]
    exact Jc.isHomogeneous
  have hq0 : q ≠ 0 := hq.ne_zero
  have hexists : ∃ j, homogeneousComponent j q ≠ 0 := by
    by_contra hall
    push Not at hall
    apply hq0
    rw [← sum_homogeneousComponent q]
    exact Finset.sum_eq_zero fun i _ ↦ hall i
  obtain ⟨j, hf0⟩ := hexists
  have hfj : homogeneousComponent j q ∈ J := by
    have := hhom.mem_iff.mp (Ideal.mem_span_singleton_self q) j
    rwa [← decomposition.decompose'_apply]
  set f := homogeneousComponent j q
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hfj
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hc
    exact hf0 hc.symm
  have hdeg := totalDegree_mul_of_isDomain hc0 hq0
  have hfdeg : f.totalDegree = j := (homogeneousComponent_isHomogeneous j q).totalDegree hf0
  have hjle : j ≤ q.totalDegree := by
    by_contra h
    push Not at h
    exact hf0 (homogeneousComponent_eq_zero j q h)
  rw [hc, hfdeg] at hdeg
  have hcdeg : c.totalDegree = 0 := by omega
  rw [totalDegree_eq_zero_iff_eq_C] at hcdeg
  obtain ⟨c0, rfl⟩ : ∃ c0, c = C c0 := ⟨_, hcdeg⟩
  have hc' : c0 ≠ 0 := fun h ↦ hc0 (by rw [h, map_zero])
  refine ⟨j, ?_⟩
  have hqf : q = C c0⁻¹ * f := by
    rw [← hc, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hc', map_one, one_mul]
  rw [hqf]
  simpa using (homogeneousComponent_isHomogeneous j q).C_mul c0⁻¹

end Polynomial

section FunctionField

theorem genericPoint_projectiveSpace :
    genericPoint (Proj 𝒜) = projectiveSpaceGenericPoint :=
  (genericPoint_spec (Proj 𝒜)).eq isGenericPoint_projectiveSpaceGenericPoint

theorem genericPoint_projectiveSpace_ideal :
    (genericPoint (Proj 𝒜)).asHomogeneousIdeal.toIdeal = ⊥ := by
  rw [genericPoint_projectiveSpace]
  rfl

theorem genericPoint_mem_basicOpen {h : S} (h0 : h ≠ 0) :
    genericPoint (Proj 𝒜) ∈ Proj.basicOpen 𝒜 h := by
  rw [Proj.mem_basicOpen]
  intro hm
  have hm' : h ∈ (genericPoint (Proj 𝒜)).asHomogeneousIdeal.toIdeal := hm
  rw [genericPoint_projectiveSpace_ideal] at hm'
  exact h0 ((Submodule.mem_bot _).mp hm')

/-- The rational function `g / h` on `ℙⁿ_k`, for homogeneous polynomials `g` and `h ≠ 0` of the
same degree. -/
def homogeneousFraction {g h : S} {d : ℕ} (hg : g.IsHomogeneous d) (hh : h.IsHomogeneous d)
    (h0 : h ≠ 0) : (Proj 𝒜).functionField :=
  (Proj 𝒜).presheaf.germ _ _ (genericPoint_mem_basicOpen h0) (hypersurfaceChartEquation g h hg hh)

theorem algebraMap_germ_hypersurfaceChartEquation {g h : S} {d : ℕ} (hg : g.IsHomogeneous d)
    (hh : h.IsHomogeneous d) (h0 : h ≠ 0) (x : Proj 𝒜) (hx : x ∈ Proj.basicOpen 𝒜 h) :
    algebraMap ((Proj 𝒜).presheaf.stalk x) (Proj 𝒜).functionField
      ((Proj 𝒜).presheaf.germ _ x hx (hypersurfaceChartEquation g h hg hh)) =
      homogeneousFraction hg hh h0 := by
  have : Nonempty (Proj.basicOpen 𝒜 h) := ⟨⟨x, hx⟩⟩
  rw [Scheme.algebraMap_germ_eq_germToFunctionField]
  rfl

/-- The embedding of the function field of `ℙⁿ_k` into the fraction field of `k[x₀, …, xₙ]`. -/
def functionFieldToLocalization :
    (Proj 𝒜).functionField →+*
      Localization (genericPoint (Proj 𝒜)).asHomogeneousIdeal.toIdeal.primeCompl :=
  (algebraMap (AtPrime 𝒜 (genericPoint (Proj 𝒜)).asHomogeneousIdeal.toIdeal) _).comp
    (Proj.stalkIso 𝒜 (genericPoint (Proj 𝒜))).hom.hom

theorem functionFieldToLocalization_injective :
    Function.Injective (functionFieldToLocalization (k := k) (n := n)) := by
  exact (HomogeneousLocalization.val_injective _).comp
    (Proj.stalkIso 𝒜 (genericPoint (Proj 𝒜))).commRingCatIsoToRingEquiv.injective

theorem functionFieldToLocalization_homogeneousFraction {g h : S} {d : ℕ}
    (hg : g.IsHomogeneous d) (hh : h.IsHomogeneous d) (h0 : h ≠ 0) :
    functionFieldToLocalization (homogeneousFraction hg hh h0) =
      Localization.mk g ⟨h, genericPoint_mem_basicOpen h0⟩ := by
  rw [homogeneousFraction, germ_hypersurfaceChartEquation]
  simp only [functionFieldToLocalization, RingHom.comp_apply]
  rw [← ConcreteCategory.comp_apply, Iso.inv_hom_id, CategoryTheory.id_apply]
  simp

theorem homogeneousFraction_eq_of_mul_eq {g h g' h' : S} {d d' : ℕ}
    (hg : g.IsHomogeneous d) (hh : h.IsHomogeneous d) (h0 : h ≠ 0)
    (hg' : g'.IsHomogeneous d') (hh' : h'.IsHomogeneous d') (h0' : h' ≠ 0)
    (H : g * h' = g' * h) :
    homogeneousFraction hg hh h0 = homogeneousFraction hg' hh' h0' := by
  rw [homogeneousFraction, homogeneousFraction, germ_hypersurfaceChartEquation,
    germ_hypersurfaceChartEquation]
  exact congrArg _ (atPrime_mk_eq_mk_of_mul_eq _ _ H)

theorem homogeneousFraction_mul {g h g' h' : S} {d d' : ℕ}
    (hg : g.IsHomogeneous d) (hh : h.IsHomogeneous d) (h0 : h ≠ 0)
    (hg' : g'.IsHomogeneous d') (hh' : h'.IsHomogeneous d') (h0' : h' ≠ 0) :
    homogeneousFraction hg hh h0 * homogeneousFraction hg' hh' h0' =
      homogeneousFraction (hg.mul hg') (hh.mul hh') (mul_ne_zero h0 h0') := by
  apply functionFieldToLocalization_injective
  rw [map_mul, functionFieldToLocalization_homogeneousFraction,
    functionFieldToLocalization_homogeneousFraction,
    functionFieldToLocalization_homogeneousFraction, Localization.mk_mul]
  rfl

theorem homogeneousFraction_ne_zero {g h : S} {d : ℕ}
    (hg : g.IsHomogeneous d) (hh : h.IsHomogeneous d) (h0 : h ≠ 0) (hg0 : g ≠ 0) :
    homogeneousFraction hg hh h0 ≠ 0 := by
  intro hz
  have := congrArg functionFieldToLocalization hz
  rw [functionFieldToLocalization_homogeneousFraction, map_zero, Localization.mk_eq_mk',
    IsLocalization.mk'_eq_zero_iff] at this
  obtain ⟨⟨c, hc⟩, hcg⟩ := this
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact hc (zero_mem _)
  exact hg0 ((mul_eq_zero.mp hcg).resolve_left hc0)

/-- Every rational function on `ℙⁿ_k` is a quotient of two homogeneous polynomials of the same
degree. -/
theorem exists_eq_homogeneousFraction (φ : (Proj 𝒜).functionField) :
    ∃ (g h : S) (d : ℕ) (hg : g.IsHomogeneous d) (hh : h.IsHomogeneous d) (h0 : h ≠ 0),
      φ = homogeneousFraction hg hh h0 := by
  obtain ⟨⟨d, ⟨g, hg⟩, ⟨h, hh⟩, hmem⟩, hz⟩ :=
    HomogeneousLocalization.mk_surjective ((Proj.stalkIso 𝒜 (genericPoint (Proj 𝒜))).hom φ)
  have h0 : h ≠ 0 := by
    rintro rfl
    exact hmem (zero_mem _)
  refine ⟨g, h, d, (mem_homogeneousSubmodule d g).mp hg, (mem_homogeneousSubmodule d h).mp hh,
    h0, ?_⟩
  rw [homogeneousFraction, germ_hypersurfaceChartEquation]
  apply (Proj.stalkIso 𝒜 (genericPoint (Proj 𝒜))).commRingCatIsoToRingEquiv.injective
  change (Proj.stalkIso 𝒜 _).hom φ = (Proj.stalkIso 𝒜 _).hom ((Proj.stalkIso 𝒜 _).inv _)
  rw [← ConcreteCategory.comp_apply, Iso.inv_hom_id, CategoryTheory.id_apply, ← hz]

end FunctionField

section Order

/-- In the homogeneous localization at a prime `𝔭 = (f)` generated by a nonzero homogeneous `f`,
the fraction `f / h` (with `h ∉ 𝔭` homogeneous of the same degree) is irreducible. -/
private theorem atPrime_mk_irreducible {𝔭 : Ideal S} [𝔭.IsPrime] {f h : S} {d : ℕ}
    (hf : f.IsHomogeneous d) (hh : h.IsHomogeneous d) (hh𝔭 : h ∈ 𝔭.primeCompl)
    (h𝔭 : 𝔭 = Ideal.span {f}) (hf0 : f ≠ 0) :
    Irreducible (HomogeneousLocalization.mk ⟨d, ⟨f, (mem_homogeneousSubmodule d f).mpr hf⟩,
      ⟨h, (mem_homogeneousSubmodule d h).mpr hh⟩, hh𝔭⟩ : AtPrime 𝒜 𝔭) := by
  have : IsDomain (AtPrime 𝒜 𝔭) :=
    Function.Injective.isDomain (algebraMap (AtPrime 𝒜 𝔭) (Localization 𝔭.primeCompl))
      (HomogeneousLocalization.val_injective _)
  set π : AtPrime 𝒜 𝔭 := HomogeneousLocalization.mk ⟨d, ⟨f, (mem_homogeneousSubmodule d f).mpr hf⟩,
      ⟨h, (mem_homogeneousSubmodule d h).mpr hh⟩, hh𝔭⟩ with hπ
  have hf𝔭 : f ∈ 𝔭 := h𝔭 ▸ Ideal.mem_span_singleton_self f
  have hnu : ¬IsUnit π := by
    rw [hπ, atPrime_mk_isUnit_iff]
    exact not_not.mpr hf𝔭
  have hπ0 : π ≠ 0 := by
    intro h0
    have := congrArg HomogeneousLocalization.val h0
    rw [hπ, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_zero, Localization.mk_eq_mk',
      IsLocalization.mk'_eq_zero_iff] at this
    obtain ⟨⟨c, hc⟩, hcf⟩ := this
    have hc0 : c ≠ 0 := by
      rintro rfl
      exact hc (zero_mem _)
    exact hf0 ((mul_eq_zero.mp hcf).resolve_left hc0)
  have hdvd : ∀ z : AtPrime 𝒜 𝔭, ¬IsUnit z → π ∣ z := by
    intro z hz
    obtain ⟨⟨i, ⟨a, ha⟩, ⟨b, hb⟩, hbm⟩, rfl⟩ := HomogeneousLocalization.mk_surjective z
    rw [atPrime_mk_isUnit_iff, not_not] at hz
    change a ∈ 𝔭 at hz
    rw [h𝔭, Ideal.mem_span_singleton'] at hz
    obtain ⟨c, rfl⟩ := hz
    by_cases hc0 : c = 0
    · subst hc0
      rw [HomogeneousLocalization.mk_eq_zero_of_num _ (Subtype.ext (zero_mul f))]
      exact dvd_zero _
    have ha' : (c * f).IsHomogeneous i := (mem_homogeneousSubmodule i _).mp ha
    have hc : c.IsHomogeneous (i - d) := isHomogeneous_of_mul_isHomogeneous hf hf0 ha'
    have hdi : d ≤ i := le_of_mul_isHomogeneous hf ha' (mul_ne_zero hc0 hf0)
    have hch : (c * h).IsHomogeneous i := by
      have := hc.mul hh
      rwa [Nat.sub_add_cancel hdi] at this
    refine ⟨HomogeneousLocalization.mk
      ⟨i, ⟨c * h, (mem_homogeneousSubmodule i _).mpr hch⟩, ⟨b, hb⟩, hbm⟩, ?_⟩
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, hπ, HomogeneousLocalization.val_mk,
      HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk, Localization.mk_mul,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul]
    ring
  refine irreducible_iff.mpr ⟨hnu, fun x y hxy ↦ ?_⟩
  by_contra hcon
  push Not at hcon
  obtain ⟨x', rfl⟩ := hdvd x hcon.1
  obtain ⟨y', rfl⟩ := hdvd y hcon.2
  apply hnu
  have h1 : π * 1 = π * (π * (x' * y')) := by
    rw [mul_one]
    nth_rw 1 [hxy]
    ring
  exact IsUnit.of_mul_eq_one (x' * y') (mul_left_cancel₀ hπ0 h1).symm

/-- A homogeneous fraction `g / h` whose numerator does not vanish at a point of `D₊(h)` has
order zero there. -/
theorem ord_homogeneousFraction_eq_zero {g h : S} {d : ℕ} (hg : g.IsHomogeneous d)
    (hh : h.IsHomogeneous d) (h0 : h ≠ 0) (x : Proj 𝒜) (hx : x ∈ Proj.basicOpen 𝒜 h)
    (hgx : g ∉ x.asHomogeneousIdeal) :
    (Proj 𝒜).ord (homogeneousFraction hg hh h0) x = 0 := by
  rw [← algebraMap_germ_hypersurfaceChartEquation hg hh h0 x hx]
  apply ord_algebraMap_stalk_of_isUnit
  rw [germ_hypersurfaceChartEquation]
  exact ((atPrime_mk_isUnit_iff _).mpr hgx).map _

/-- At a prime divisor whose homogeneous prime is `(f)`, the fraction `f / h` has order one. -/
theorem ord_homogeneousFraction_eq_one {f h : S} {d : ℕ} (hf : f.IsHomogeneous d)
    (hh : h.IsHomogeneous d) (h0 : h ≠ 0) (x : Proj 𝒜) (hx1 : Order.coheight x = 1)
    (hx : x ∈ Proj.basicOpen 𝒜 h) (hxf : x.asHomogeneousIdeal.toIdeal = Ideal.span {f})
    (hf0 : f ≠ 0) :
    (Proj 𝒜).ord (homogeneousFraction hf hh h0) x = 1 := by
  have := Scheme.codimensionOneStalk_isDiscreteValuationRing
    projectiveSpace_satisfiesConditionStar hx1
  have hirr : Irreducible
      ((Proj 𝒜).presheaf.germ _ x hx (hypersurfaceChartEquation f h hf hh)) := by
    rw [germ_hypersurfaceChartEquation]
    exact (MulEquiv.irreducible_iff
      (Proj.stalkIso 𝒜 x).commRingCatIsoToRingEquiv.symm).mpr
      (atPrime_mk_irreducible hf hh hx hxf hf0)
  rw [Scheme.ord_eq_iff hx1 (homogeneousFraction_ne_zero hf hh h0 hf0),
    ← algebraMap_germ_hypersurfaceChartEquation hf hh h0 x hx]
  exact Ring.ordFrac_irreducible hirr

end Order

section PrimeDivisors

theorem projectiveSpace_eq_of_coheight_eq_one {x y : Proj 𝒜} (hx : Order.coheight x = 1)
    (hy : Order.coheight y = 1) (hxy : x.asHomogeneousIdeal ≤ y.asHomogeneousIdeal) : x = y := by
  by_contra hne
  have hsp : x ⤳ y := (projectiveSpace_specializes_iff_le x y).mpr hxy
  have hlt : y < x := lt_iff_le_not_ge.mpr ⟨hsp, fun h ↦ hne (hsp.antisymm h).eq⟩
  have := Order.coheight_add_one_le hlt
  rw [hx, hy] at this
  norm_num at this

open Classical in
/-- The order of an irreducible homogeneous `q / h` along a prime divisor: one along the
hypersurface `V(q)` and zero elsewhere. -/
theorem ord_homogeneousFraction_irreducible (hn : 0 < n) {q h : S} {d : ℕ}
    (hq : q.IsHomogeneous d) (hirr : Irreducible q) (hh : h.IsHomogeneous d) (h0 : h ≠ 0)
    (Q : (Proj 𝒜).PrimeDivisor) (hQ : Q.1 ∈ Proj.basicOpen 𝒜 h) :
    (Proj 𝒜).ord (homogeneousFraction hq hh h0) Q.1 =
      if Q = projectiveHypersurfacePrimeDivisor hn hq hirr then 1 else 0 := by
  classical
  by_cases hqQ : q ∈ Q.1.asHomogeneousIdeal
  · have hPQ : projectiveHypersurfacePrimeDivisor hn hq hirr = Q := by
      refine Subtype.ext (projectiveSpace_eq_of_coheight_eq_one
        (projectiveHypersurfacePrimeDivisor hn hq hirr).2 Q.2 ?_)
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      exact Ideal.mul_mem_left _ c hqQ
    rw [if_pos hPQ.symm]
    refine ord_homogeneousFraction_eq_one hq hh h0 Q.1 Q.2 hQ ?_ hirr.ne_zero
    rw [← hPQ]
    rfl
  · have hne : Q ≠ projectiveHypersurfacePrimeDivisor hn hq hirr := by
      rintro rfl
      exact hqQ (show q ∈ Ideal.span {q} from Ideal.mem_span_singleton_self q)
    rw [if_neg hne]
    exact ord_homogeneousFraction_eq_zero hq hh h0 Q.1 hQ hqQ

/-- A nonzero linear form is irreducible. -/
theorem irreducible_of_isHomogeneous_one {ℓ : S} (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) :
    Irreducible ℓ := by
  have hdeg : ℓ.totalDegree = 1 := hℓ.totalDegree hℓ0
  refine irreducible_iff.mpr ⟨fun hu ↦ ?_, fun a b hab ↦ ?_⟩
  · obtain ⟨c, -, hc⟩ := (isUnit_iff_eq_C_of_isReduced (P := ℓ)).mp hu
    rw [hc, totalDegree_C] at hdeg
    exact zero_ne_one hdeg
  · have ha0 : a ≠ 0 := by
      rintro rfl
      exact hℓ0 (by rw [hab, zero_mul])
    have hb0 : b ≠ 0 := by
      rintro rfl
      exact hℓ0 (by rw [hab, mul_zero])
    have hsum := totalDegree_mul_of_isDomain ha0 hb0
    rw [← hab, hdeg] at hsum
    have hunit : ∀ c : S, c ≠ 0 → c.totalDegree = 0 → IsUnit c := by
      intro c hc0 hc
      rw [totalDegree_eq_zero_iff_eq_C] at hc
      rw [hc]
      exact (isUnit_iff_ne_zero.mpr fun h0 ↦ hc0 (by rw [hc, h0, map_zero])).map C
    rcases (show a.totalDegree = 0 ∨ b.totalDegree = 0 by omega) with h | h
    · exact Or.inl (hunit a ha0 h)
    · exact Or.inr (hunit b hb0 h)

/-- The hyperplane `H = V(ℓ)` of `ℙⁿ_k` cut out by a nonzero linear form `ℓ`, as a prime
divisor (for `n ≥ 1`). -/
def projectiveHyperplanePrimeDivisor (hn : 0 < n) {ℓ : S} (hℓ : ℓ.IsHomogeneous 1)
    (hℓ0 : ℓ ≠ 0) : (Proj 𝒜).PrimeDivisor :=
  projectiveHypersurfacePrimeDivisor hn hℓ (irreducible_of_isHomogeneous_one hℓ hℓ0)

/-- The degree of the hypersurface of a prime divisor does not depend on the chosen homogeneous
generator of its prime. -/
theorem projectivePrimeDivisorEquationDegree_eq {P : (Proj 𝒜).PrimeDivisor} {f : S} {d : ℕ}
    (hf : f.IsHomogeneous d) (hP : P.1.asHomogeneousIdeal.toIdeal = Ideal.span {f}) :
    projectivePrimeDivisorEquationDegree P = d := by
  have hspan := (span_projectivePrimeDivisorEquation P).symm.trans hP
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan.symm
  obtain ⟨c, hc, hcu⟩ := (isUnit_iff_eq_C_of_isReduced (P := (u : S))).mp u.isUnit
  have heq : projectivePrimeDivisorEquation P = f * C c := by rw [← hu, hcu]
  have h1 : (f * C c).IsHomogeneous (d + 0) := hf.mul (isHomogeneous_C _ c)
  rw [add_zero, ← heq] at h1
  exact (projectivePrimeDivisorEquation_isHomogeneous P).inj_right h1
    (projectivePrimeDivisorEquation_ne_zero P)

theorem projectivePrimeDivisorEquationDegree_hypersurface (hn : 0 < n) {q : S} {d : ℕ}
    (hq : q.IsHomogeneous d) (hirr : Irreducible q) :
    projectivePrimeDivisorEquationDegree (projectiveHypersurfacePrimeDivisor hn hq hirr) = d :=
  projectivePrimeDivisorEquationDegree_eq hq rfl

/-- The homogeneous equation of a prime divisor of `ℙⁿ_k` is irreducible. -/
theorem irreducible_projectivePrimeDivisorEquation (P : (Proj 𝒜).PrimeDivisor) :
    Irreducible (projectivePrimeDivisorEquation P) :=
  UniqueFactorizationMonoid.irreducible_iff_prime.mpr
    ((Ideal.span_singleton_prime (projectivePrimeDivisorEquation_ne_zero P)).mp
      (span_projectivePrimeDivisorEquation P ▸ P.1.isPrime))

/-- Every prime divisor of `ℙⁿ_k` is the hypersurface of its homogeneous equation. -/
theorem projectiveHypersurfacePrimeDivisor_equation (hn : 0 < n) (P : (Proj 𝒜).PrimeDivisor)
    (hirr : Irreducible (projectivePrimeDivisorEquation P)) :
    projectiveHypersurfacePrimeDivisor hn (projectivePrimeDivisorEquation_isHomogeneous P) hirr =
      P := by
  refine Subtype.ext (projectiveSpace_eq_of_coheight_eq_one
    (projectiveHypersurfacePrimeDivisor hn _ _).2 P.2 ?_)
  intro a ha
  change a ∈ P.1.asHomogeneousIdeal.toIdeal
  rw [span_projectivePrimeDivisorEquation]
  exact ha

end PrimeDivisors

section Divisors

variable {X : Scheme.{u}}

open Classical in
theorem toWeilDivisor_apply_primeDivisor (P Q : X.PrimeDivisor) :
    P.toWeilDivisor.1 Q.1 = if Q = P then 1 else 0 := by
  split_ifs with h
  · rw [h]
    exact P.toWeilDivisor_apply_self
  · exact P.toWeilDivisor_apply_of_ne fun h' ↦ h (Subtype.ext h')

theorem weilDivisor_sub_zsmul_apply (D E : X.WeilDivisor) (m : ℤ) (x : X) :
    (D - m • E).1 x = D.1 x - m * E.1 x := by
  simp

end Divisors

section PrincipalDivisors

local notation "hX" => (projectiveSpace_satisfiesConditionStar (k := k) (n := n))

/-- The rational function `g / h`, for nonzero homogeneous `g`, `h` of the same degree, as a unit
of the function field. -/
def homogeneousFractionUnit {g h : S} {d : ℕ} (hg : g.IsHomogeneous d) (hh : h.IsHomogeneous d)
    (h0 : h ≠ 0) (hg0 : g ≠ 0) : (Proj 𝒜).functionFieldˣ :=
  Units.mk0 (homogeneousFraction hg hh h0) (homogeneousFraction_ne_zero hg hh h0 hg0)

theorem principalDivisor_mul (u v : (Proj 𝒜).functionFieldˣ) :
    (Proj 𝒜).principalDivisor hX (u * v) =
      (Proj 𝒜).principalDivisor hX u + (Proj 𝒜).principalDivisor hX v := by
  apply Scheme.WeilDivisor.ext_apply
  intro x
  rw [Scheme.principalDivisor_apply hX (u * v) x]
  simp only [AddSubgroup.coe_add, Function.locallyFinsuppWithin.coe_add, Pi.add_apply]
  rw [Scheme.principalDivisor_apply hX u x, Scheme.principalDivisor_apply hX v x, Units.val_mul,
    Scheme.ord_mul u.ne_zero v.ne_zero]

theorem isHomogeneous_pow_of_isHomogeneous_one {ℓ : S} (hℓ : ℓ.IsHomogeneous 1) (d : ℕ) :
    (ℓ ^ d).IsHomogeneous d := by
  simpa using hℓ.pow d

theorem ord_homogeneousFraction_pow {g h : S} {e : ℕ} (hg : g.IsHomogeneous e)
    (hh : h.IsHomogeneous e) (h0 : h ≠ 0) (hg0 : g ≠ 0) (x : Proj 𝒜) (m : ℕ) :
    (Proj 𝒜).ord (homogeneousFraction (hg.pow m) (hh.pow m) (pow_ne_zero m h0)) x =
      m * (Proj 𝒜).ord (homogeneousFraction hg hh h0) x := by
  induction m with
  | zero =>
    rw [Nat.cast_zero, zero_mul]
    refine ord_homogeneousFraction_eq_zero _ _ _ x ?_ ?_
    · rw [Proj.mem_basicOpen, pow_zero]
      exact fun h1 ↦ x.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    · rw [pow_zero]
      exact fun h1 ↦ x.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  | succ m ih =>
    have hsplit : homogeneousFraction (hg.pow (m + 1)) (hh.pow (m + 1)) (pow_ne_zero _ h0) =
        homogeneousFraction (hg.pow m) (hh.pow m) (pow_ne_zero m h0) *
          homogeneousFraction hg hh h0 := by
      rw [homogeneousFraction_mul]
      apply homogeneousFraction_eq_of_mul_eq
      ring
    rw [hsplit, Scheme.ord_mul (homogeneousFraction_ne_zero _ _ _ (pow_ne_zero m hg0))
      (homogeneousFraction_ne_zero _ _ _ hg0), ih]
    push_cast
    ring

open Classical in
/-- **The divisor of `q / ℓ^d`.** For an irreducible homogeneous `q` of degree `d` and a nonzero
linear form `ℓ`, the principal divisor of `q / ℓ^d` is `V(q) - d · V(ℓ)`. -/
theorem principalDivisor_irreducible_div_linear_pow (hn : 0 < n) {q ℓ : S} {d : ℕ}
    (hq : q.IsHomogeneous d) (hirr : Irreducible q) (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) :
    (Proj 𝒜).principalDivisor hX
        (homogeneousFractionUnit hq (isHomogeneous_pow_of_isHomogeneous_one hℓ d)
          (pow_ne_zero d hℓ0) hirr.ne_zero) =
      (projectiveHypersurfacePrimeDivisor hn hq hirr).toWeilDivisor -
        (d : ℤ) • (projectiveHyperplanePrimeDivisor hn hℓ hℓ0).toWeilDivisor := by
  apply Scheme.WeilDivisor.ext_apply
  intro x
  rw [Scheme.principalDivisor_apply hX _ x, weilDivisor_sub_zsmul_apply]
  by_cases hx : Order.coheight x = 1
  swap
  · rw [Scheme.ord_eq_zero_of_coheight_neq_one hx,
      (projectiveHypersurfacePrimeDivisor hn hq hirr).toWeilDivisor.2 x hx,
      (projectiveHyperplanePrimeDivisor hn hℓ hℓ0).toWeilDivisor.2 x hx]
    ring
  set Q : (Proj 𝒜).PrimeDivisor := ⟨x, hx⟩
  change _ = (projectiveHypersurfacePrimeDivisor hn hq hirr).toWeilDivisor.1 Q.1 -
    _ * (projectiveHyperplanePrimeDivisor hn hℓ hℓ0).toWeilDivisor.1 Q.1
  rw [toWeilDivisor_apply_primeDivisor, toWeilDivisor_apply_primeDivisor]
  obtain ⟨i, hi⟩ := exists_X_notMem_projectiveSpace x
  have hxi : (MvPolynomial.X i : S).IsHomogeneous 1 := isHomogeneous_X k i
  have hxi0 : (MvPolynomial.X i : S) ≠ 0 := MvPolynomial.X_ne_zero i
  have hxid := isHomogeneous_pow_of_isHomogeneous_one hxi d
  have hℓd := isHomogeneous_pow_of_isHomogeneous_one hℓ d
  have hkey : homogeneousFraction hq hℓd (pow_ne_zero d hℓ0) *
      homogeneousFraction (hℓ.pow d) (hxi.pow d) (pow_ne_zero d hxi0) =
      homogeneousFraction hq hxid (pow_ne_zero d hxi0) := by
    rw [homogeneousFraction_mul]
    apply homogeneousFraction_eq_of_mul_eq
    ring
  have hne1 := homogeneousFraction_ne_zero hq hℓd (pow_ne_zero d hℓ0) hirr.ne_zero
  have hne2 := homogeneousFraction_ne_zero (hℓ.pow d) (hxi.pow d) (pow_ne_zero d hxi0)
    (pow_ne_zero d hℓ0)
  have hord := congrArg (fun φ ↦ (Proj 𝒜).ord φ x) hkey
  rw [Scheme.ord_mul hne1 hne2, ord_homogeneousFraction_pow hℓ hxi hxi0 hℓ0 x d,
    ord_homogeneousFraction_irreducible hn hq hirr hxid (pow_ne_zero d hxi0) Q
      (mem_basicOpen_X_pow hi d),
    ord_homogeneousFraction_irreducible hn hℓ (irreducible_of_isHomogeneous_one hℓ hℓ0) hxi hxi0 Q
      (by rw [Proj.mem_basicOpen]; exact hi)] at hord
  change (Proj 𝒜).ord (homogeneousFraction hq hℓd (pow_ne_zero d hℓ0)) Q.1 = _
  rw [projectiveHyperplanePrimeDivisor]
  linear_combination hord

theorem principalDivisor_mem_principalDivisorSubgroup (u : (Proj 𝒜).functionFieldˣ) :
    (Proj 𝒜).principalDivisor hX u ∈ (Proj 𝒜).principalDivisorSubgroup hX :=
  ⟨Additive.ofMul u, rfl⟩

end PrincipalDivisors

section Degree

local notation "hX" => (projectiveSpace_satisfiesConditionStar (k := k) (n := n))

/-- **The degree of a Weil divisor on `ℙⁿ_k`.** Each prime divisor is weighted by the degree of
its hypersurface, that is, of a homogeneous generator of its homogeneous prime: the additive
homomorphism `Div ℙⁿ_k → ℤ` sending `D = ∑ nᵢ Yᵢ` to `∑ nᵢ deg Yᵢ`. -/
def projectiveSpaceWeilDivisorDegree : (Proj 𝒜).WeilDivisor →+ ℤ where
  toFun D := ∑ᶠ P : (Proj 𝒜).PrimeDivisor, D.1 P.1 * projectivePrimeDivisorEquationDegree P
  map_zero' := by simp
  map_add' D E := by
    have hfin : ∀ F : (Proj 𝒜).WeilDivisor, (Function.support fun P : (Proj 𝒜).PrimeDivisor ↦
        F.1 P.1 * (projectivePrimeDivisorEquationDegree P : ℤ)).Finite := fun F ↦
      ((Scheme.WeilDivisor.support_finite F).preimage Subtype.val_injective.injOn).subset
        fun P hP ↦ left_ne_zero_of_mul hP
    simp only [AddSubgroup.coe_add, Function.locallyFinsuppWithin.coe_add, Pi.add_apply,
      add_mul]
    exact finsum_add_distrib (hfin D) (hfin E)

theorem projectiveSpaceWeilDivisorDegree_apply (D : (Proj 𝒜).WeilDivisor) :
    projectiveSpaceWeilDivisorDegree D =
      ∑ᶠ P : (Proj 𝒜).PrimeDivisor, D.1 P.1 * projectivePrimeDivisorEquationDegree P :=
  rfl

/-- The degree of the divisor `1 · Y` of a prime divisor `Y` is the degree of its hypersurface. -/
theorem projectiveSpaceWeilDivisorDegree_toWeilDivisor (P : (Proj 𝒜).PrimeDivisor) :
    projectiveSpaceWeilDivisorDegree P.toWeilDivisor = projectivePrimeDivisorEquationDegree P := by
  rw [projectiveSpaceWeilDivisorDegree_apply, finsum_eq_single _ P]
  · rw [P.toWeilDivisor_apply_self, one_mul]
  · intro Q hQ
    rw [P.toWeilDivisor_apply_of_ne (fun h ↦ hQ (Subtype.ext h)), zero_mul]

/-- The hypersurface of an irreducible homogeneous polynomial of degree `d` has degree `d`. -/
theorem projectiveSpaceWeilDivisorDegree_hypersurface (hn : 0 < n) {q : S} {d : ℕ}
    (hq : q.IsHomogeneous d) (hirr : Irreducible q) :
    projectiveSpaceWeilDivisorDegree (projectiveHypersurfacePrimeDivisor hn hq hirr).toWeilDivisor
      = d := by
  rw [projectiveSpaceWeilDivisorDegree_toWeilDivisor,
    projectivePrimeDivisorEquationDegree_hypersurface]

/-- A hyperplane has degree one. -/
theorem projectiveSpaceWeilDivisorDegree_hyperplane (hn : 0 < n) {ℓ : S}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) :
    projectiveSpaceWeilDivisorDegree (projectiveHyperplanePrimeDivisor hn hℓ hℓ0).toWeilDivisor
      = 1 := by
  rw [projectiveHyperplanePrimeDivisor, projectiveSpaceWeilDivisorDegree_hypersurface,
    Nat.cast_one]

/-- `D - deg(D) · H` is principal for every Weil divisor `D` and every hyperplane `H`. -/
theorem sub_degree_smul_hyperplane_mem_principalDivisorSubgroup (hn : 0 < n) {ℓ : S}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) (D : (Proj 𝒜).WeilDivisor) :
    D - projectiveSpaceWeilDivisorDegree D •
        (projectiveHyperplanePrimeDivisor hn hℓ hℓ0).toWeilDivisor ∈
      (Proj 𝒜).principalDivisorSubgroup hX := by
  set H := (projectiveHyperplanePrimeDivisor hn hℓ hℓ0).toWeilDivisor
  have hprime : ∀ P : (Proj 𝒜).PrimeDivisor,
      P.toWeilDivisor - (projectivePrimeDivisorEquationDegree P : ℤ) • H ∈
        (Proj 𝒜).principalDivisorSubgroup hX := by
    intro P
    have h := principalDivisor_irreducible_div_linear_pow hn
      (projectivePrimeDivisorEquation_isHomogeneous P)
      (irreducible_projectivePrimeDivisorEquation P) hℓ hℓ0
    rw [projectiveHypersurfacePrimeDivisor_equation hn P] at h
    rw [← h]
    exact principalDivisor_mem_principalDivisorSubgroup _
  have key : ∀ s : Finset (Proj 𝒜).PrimeDivisor, ∀ D : (Proj 𝒜).WeilDivisor,
      (∀ P : (Proj 𝒜).PrimeDivisor, D.1 P.1 ≠ 0 → P ∈ s) →
        D - projectiveSpaceWeilDivisorDegree D • H ∈ (Proj 𝒜).principalDivisorSubgroup hX := by
    classical
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro D hD
      have hD0 : D = 0 := by
        apply Scheme.WeilDivisor.ext_apply
        intro x
        by_cases hx : Order.coheight x = 1
        · by_contra hne
          exact Finset.notMem_empty _ (hD ⟨x, hx⟩ hne)
        · exact D.2 x hx
      rw [hD0, map_zero, zero_smul, sub_zero]
      exact zero_mem _
    | insert P s hPs ih =>
      intro D hD
      set D' := D - D.1 P.1 • P.toWeilDivisor with hD'def
      have hD' : ∀ Q : (Proj 𝒜).PrimeDivisor, D'.1 Q.1 ≠ 0 → Q ∈ s := by
        intro Q hQ
        rw [hD'def, weilDivisor_sub_zsmul_apply, toWeilDivisor_apply_primeDivisor] at hQ
        split_ifs at hQ with hQP
        · subst hQP
          simp at hQ
        · rw [mul_zero, sub_zero] at hQ
          exact (Finset.mem_insert.mp (hD Q hQ)).resolve_left hQP
      have h1 := ih D' hD'
      have h2 := zsmul_mem (hprime P) (D.1 P.1)
      have hdeg : projectiveSpaceWeilDivisorDegree D = projectiveSpaceWeilDivisorDegree D' +
          D.1 P.1 * projectivePrimeDivisorEquationDegree P := by
        rw [hD'def, map_sub, map_zsmul, projectiveSpaceWeilDivisorDegree_toWeilDivisor, smul_eq_mul]
        ring
      have heq : D - projectiveSpaceWeilDivisorDegree D • H =
          (D' - projectiveSpaceWeilDivisorDegree D' • H) +
            D.1 P.1 • (P.toWeilDivisor - (projectivePrimeDivisorEquationDegree P : ℤ) • H) := by
        rw [hdeg, hD'def]
        module
      rw [heq]
      exact add_mem h1 h2
  have hfin := (Scheme.WeilDivisor.support_finite D).preimage
    (Subtype.val_injective (p := fun x : Proj 𝒜 ↦ Order.coheight x = 1)).injOn
  exact key hfin.toFinset D fun P hP ↦ hfin.mem_toFinset.mpr hP

/-- The divisor of `g / x₀^e` has degree zero, for every nonzero homogeneous `g` of degree `e`. -/
theorem projectiveSpaceWeilDivisorDegree_principalDivisor_div_X_pow (hn : 0 < n) {g : S}
    {e : ℕ} (hg : g.IsHomogeneous e) (hg0 : g ≠ 0) :
    projectiveSpaceWeilDivisorDegree ((Proj 𝒜).principalDivisor hX
      (homogeneousFractionUnit hg (isHomogeneous_pow_of_isHomogeneous_one (isHomogeneous_X k 0) e)
        (pow_ne_zero e (MvPolynomial.X_ne_zero 0)) hg0)) = 0 := by
  induction g using UniqueFactorizationMonoid.induction_on_prime generalizing e with
  | h₁ => exact absurd rfl hg0
  | h₂ x hx =>
    obtain ⟨c, hc, rfl⟩ := (isUnit_iff_eq_C_of_isReduced (P := x)).mp hx
    have he : 0 = e := (isHomogeneous_C _ c).inj_right hg hg0
    subst he
    have hzero : (Proj 𝒜).principalDivisor hX
        (homogeneousFractionUnit hg (isHomogeneous_pow_of_isHomogeneous_one
          (isHomogeneous_X k 0) 0) (pow_ne_zero 0 (MvPolynomial.X_ne_zero 0)) hg0) = 0 := by
      apply Scheme.WeilDivisor.ext_apply
      intro y
      rw [Scheme.principalDivisor_apply hX _ y]
      refine ord_homogeneousFraction_eq_zero _ _ (pow_ne_zero 0 (MvPolynomial.X_ne_zero 0)) y ?_ ?_
      · rw [Proj.mem_basicOpen, pow_zero]
        exact fun h1 ↦ y.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      · exact fun h1 ↦ y.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 (hc.map C))
    rw [hzero, map_zero]
  | h₃ a p ha0 hp ih =>
    obtain ⟨j, hj⟩ := exists_isHomogeneous_of_prime_dvd hg hg0 hp (dvd_mul_right p a)
    have hpa : (a * p).IsHomogeneous e := by rwa [mul_comm]
    have ha : a.IsHomogeneous (e - j) := isHomogeneous_of_mul_isHomogeneous hj hp.ne_zero hpa
    have hje : j ≤ e := le_of_mul_isHomogeneous hj hpa (by rwa [mul_comm])
    have hsplit : homogeneousFractionUnit hg
        (isHomogeneous_pow_of_isHomogeneous_one (isHomogeneous_X k 0) e)
        (pow_ne_zero e (MvPolynomial.X_ne_zero 0)) hg0 =
        homogeneousFractionUnit hj
          (isHomogeneous_pow_of_isHomogeneous_one (isHomogeneous_X k 0) j)
          (pow_ne_zero j (MvPolynomial.X_ne_zero 0)) hp.ne_zero *
        homogeneousFractionUnit ha
          (isHomogeneous_pow_of_isHomogeneous_one (isHomogeneous_X k 0) (e - j))
          (pow_ne_zero (e - j) (MvPolynomial.X_ne_zero 0)) ha0 := by
      ext
      simp only [homogeneousFractionUnit, Units.val_mul, Units.val_mk0]
      rw [homogeneousFraction_mul]
      apply homogeneousFraction_eq_of_mul_eq
      rw [← pow_add, Nat.add_sub_cancel' hje]
    rw [hsplit, principalDivisor_mul, map_add, ih ha ha0, add_zero,
      principalDivisor_irreducible_div_linear_pow hn hj hp.irreducible (isHomogeneous_X k 0)
        (MvPolynomial.X_ne_zero 0), map_sub, map_zsmul,
      projectiveSpaceWeilDivisorDegree_hypersurface, projectiveSpaceWeilDivisorDegree_hyperplane]
    simp

/-- **Principal divisors on `ℙⁿ_k` have degree zero.** -/
theorem projectiveSpaceWeilDivisorDegree_principalDivisor (hn : 0 < n)
    (φ : (Proj 𝒜).functionFieldˣ) :
    projectiveSpaceWeilDivisorDegree ((Proj 𝒜).principalDivisor hX φ) = 0 := by
  obtain ⟨g, h, d, hg, hh, h0, hφ⟩ := exists_eq_homogeneousFraction (φ : (Proj 𝒜).functionField)
  have hg0 : g ≠ 0 := by
    rintro rfl
    apply φ.ne_zero
    rw [hφ]
    apply functionFieldToLocalization_injective
    rw [functionFieldToLocalization_homogeneousFraction, map_zero, Localization.mk_zero]
  have hsplit : φ * homogeneousFractionUnit hh
      (isHomogeneous_pow_of_isHomogeneous_one (isHomogeneous_X k 0) d)
      (pow_ne_zero d (MvPolynomial.X_ne_zero 0)) h0 =
      homogeneousFractionUnit hg
        (isHomogeneous_pow_of_isHomogeneous_one (isHomogeneous_X k 0) d)
        (pow_ne_zero d (MvPolynomial.X_ne_zero 0)) hg0 := by
    ext
    simp only [homogeneousFractionUnit, Units.val_mul, Units.val_mk0]
    rw [hφ, homogeneousFraction_mul]
    apply homogeneousFraction_eq_of_mul_eq
    ring
  have h1 := congrArg (fun u ↦ projectiveSpaceWeilDivisorDegree ((Proj 𝒜).principalDivisor hX u))
    hsplit
  simp only [principalDivisor_mul, map_add,
    projectiveSpaceWeilDivisorDegree_principalDivisor_div_X_pow hn, add_zero] at h1
  exact h1

/-- **Hartshorne II, Proposition 6.4: `D ∼ deg(D) · H`.** On `ℙⁿ_k` (`n ≥ 1`), every Weil divisor
`D` is linearly equivalent to `deg(D) · H` for any hyperplane `H`. -/
theorem projectiveSpace_linearEquivalent_degree_smul_hyperplane (hn : 0 < n) {ℓ : S}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) (D : (Proj 𝒜).WeilDivisor) :
    Scheme.WeilDivisor.LinearEquivalent hX D
      (projectiveSpaceWeilDivisorDegree D •
        (projectiveHyperplanePrimeDivisor hn hℓ hℓ0).toWeilDivisor) :=
  sub_degree_smul_hyperplane_mem_principalDivisorSubgroup hn hℓ hℓ0 D

/-- The degree homomorphism on divisor classes of `ℙⁿ_k`. -/
def projectiveSpaceClassGroupDegree (hn : 0 < n) : (Proj 𝒜).WeilClassGroup hX →+ ℤ :=
  QuotientAddGroup.lift _ projectiveSpaceWeilDivisorDegree fun D hD ↦ by
    change D ∈ ((Proj 𝒜).principalDivisorHom hX).range at hD
    obtain ⟨u, rfl⟩ := hD
    exact projectiveSpaceWeilDivisorDegree_principalDivisor hn u.toMul

theorem projectiveSpaceClassGroupDegree_weilDivisorClassHom (hn : 0 < n)
    (D : (Proj 𝒜).WeilDivisor) :
    projectiveSpaceClassGroupDegree hn ((Proj 𝒜).weilDivisorClassHom hX D) =
      projectiveSpaceWeilDivisorDegree D :=
  rfl

theorem projectiveSpaceClassGroupDegree_bijective (hn : 0 < n) :
    Function.Bijective (projectiveSpaceClassGroupDegree (k := k) hn) := by
  set H := (projectiveHyperplanePrimeDivisor hn (isHomogeneous_X k (0 : Fin (n + 1)))
    (MvPolynomial.X_ne_zero 0)).toWeilDivisor
  refine ⟨(injective_iff_map_eq_zero _).mpr fun c hc ↦ ?_, fun m ↦ ⟨(Proj 𝒜).weilDivisorClassHom hX (m • H), ?_⟩⟩
  · induction c using QuotientAddGroup.induction_on with
    | H D =>
      change projectiveSpaceWeilDivisorDegree D = 0 at hc
      have hmem := sub_degree_smul_hyperplane_mem_principalDivisorSubgroup hn
        (isHomogeneous_X k (0 : Fin (n + 1))) (MvPolynomial.X_ne_zero 0) D
      rw [hc, zero_smul, sub_zero] at hmem
      exact (QuotientAddGroup.eq_zero_iff D).mpr hmem
  · rw [projectiveSpaceClassGroupDegree_weilDivisorClassHom, map_zsmul,
      projectiveSpaceWeilDivisorDegree_hyperplane, smul_eq_mul, mul_one]

/-- **Hartshorne II, Proposition 6.4.** For `n ≥ 1`, the degree induces an isomorphism
`Cl(ℙⁿ_k) ≅ ℤ`. -/
def projectiveSpaceClassGroupEquiv (hn : 0 < n) : (Proj 𝒜).WeilClassGroup hX ≃+ ℤ :=
  AddEquiv.ofBijective (projectiveSpaceClassGroupDegree hn)
    (projectiveSpaceClassGroupDegree_bijective hn)

/-- The isomorphism `Cl(ℙⁿ_k) ≅ ℤ` sends the class of `D` to `deg D`. -/
theorem projectiveSpaceClassGroupEquiv_weilDivisorClassHom (hn : 0 < n)
    (D : (Proj 𝒜).WeilDivisor) :
    projectiveSpaceClassGroupEquiv hn ((Proj 𝒜).weilDivisorClassHom hX D) =
      projectiveSpaceWeilDivisorDegree D :=
  rfl

/-- The isomorphism `Cl(ℙⁿ_k) ≅ ℤ` sends the class of a hyperplane to `1`. -/
theorem projectiveSpaceClassGroupEquiv_hyperplane (hn : 0 < n) {ℓ : S}
    (hℓ : ℓ.IsHomogeneous 1) (hℓ0 : ℓ ≠ 0) :
    projectiveSpaceClassGroupEquiv hn
        ((Proj 𝒜).weilDivisorClassHom hX
          (projectiveHyperplanePrimeDivisor hn hℓ hℓ0).toWeilDivisor) = 1 :=
  projectiveSpaceWeilDivisorDegree_hyperplane hn hℓ hℓ0

end Degree

end Hartshorne
