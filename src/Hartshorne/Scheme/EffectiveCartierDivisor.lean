import Hartshorne.Scheme.CartierDivisorSheaf
import Hartshorne.Scheme.QuasicoherentIdealSheafData
import Hartshorne.Scheme.SymmetricAlgebraSheaf

/-!
# Effective Cartier divisors and locally principal closed subschemes

Hartshorne, *Algebraic Geometry*, II.6, definition of effective Cartier divisors and
Remark 6.17.1 (p. 145).

A Cartier divisor `D` is *effective* (`Scheme.CartierDivisor.IsEffective`) if it can be
represented by local equations `f_i ∈ Γ(U_i, 𝒪_X)`. Then every section of `𝒪_X(-D) ⊆ K_X` is
regular (`Scheme.CartierDivisor.exists_toK_eq_of_isSection_neg`), so `𝒪_X(-D)` is a
quasi-coherent ideal subsheaf of `𝒪_X` (`Scheme.CartierDivisor.idealSheafι`), giving ideal data
`Scheme.CartierDivisor.idealSheafData` on `X`, i.e. a closed subscheme. Over an affine open inside
the domain of a local equation `g`, its ideal is generated by `g`
(`Scheme.CartierDivisor.idealSheafData_ideal_eq_span`), and `g` is a non-zero-divisor.

Conversely, ideal data locally generated by one non-zero-divisor
(`Scheme.IdealSheafData.IsLocallyPrincipalNonZeroDivisor`) has local generators which are, after
shrinking, units of the total quotient sheaf; on overlaps they differ by regular units, so they
are local equations of an effective Cartier divisor with that ideal
(`Scheme.CartierDivisor.exists_idealSheafData_eq`). An effective divisor is determined by its
ideal (`Scheme.CartierDivisor.idealSheafData_injective`), which gives the bijection
`Scheme.effectiveCartierDivisorEquiv`.
-/

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

universe u

noncomputable section

variable {X : Scheme.{u}}

namespace Scheme.CartierDivisor

/-- A Cartier divisor is **effective** if every point has a neighbourhood carrying a regular local
equation (Hartshorne II.6, p. 145). -/
def IsEffective (D : X.CartierDivisor) : Prop :=
  ∀ x : X, ∃ (V : X.Opens) (f : X.totalQuotientUnitsSheaf.obj.obj (op V)), x ∈ V ∧
    D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f) ∧
    ∃ g : Γ(X, V), X.toK V g = kUnitVal f

/-- Restriction of `-D` is `-` the restriction of `D`. -/
theorem restrict_neg (D : X.CartierDivisor) (V : X.Opens) :
    (-D).restrict V = -D.restrict V :=
  map_neg (X.cartierDivisorSheaf.obj.map (homOfLE le_top).op).hom D

/-- If `f` is a local equation of `D`, then `f⁻¹` is a local equation of `-D`. -/
theorem restrict_neg_eq_of_restrict_eq (D : X.CartierDivisor) {V : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V)}
    (hf : D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f)) :
    (-D).restrict V = X.toCartierDivisorSheaf.hom.app (op V)
      (Additive.ofMul (f⁻¹ : X.totalQuotientUnitsSheaf.obj.obj (op V))) := by
  rw [restrict_neg, hf]
  exact (map_neg (X.toCartierDivisorSheaf.hom.app (op V)).hom (Additive.ofMul f)).symm

/-- **Sections of `𝒪_X(-D)` are regular** when `D` is effective. -/
theorem exists_toK_eq_of_isSection_neg {D : X.CartierDivisor} (hD : D.IsEffective)
    {U : X.Opens} {s : X.totalQuotientSheaf.obj.obj (op U)} (hs : (-D).IsSection s) :
    ∃ r : Γ(X, U), X.toK U r = s := by
  apply exists_toK_eq_of_locally
  intro x hx
  obtain ⟨V, f, hxV, hf, g, hg⟩ := hD x
  have h₁ : U ⊓ V ≤ U := inf_le_left
  have h₂ : U ⊓ V ≤ V := inf_le_right
  have hf' := D.restrict_eq_of_le h₂ hf
  obtain ⟨r, hr⟩ := hs (U ⊓ V) h₁ _ (D.restrict_neg_eq_of_restrict_eq hf')
  refine ⟨U ⊓ V, h₁, ⟨hx, hxV⟩, r * X.presheaf.map (homOfLE h₂).op g, ?_⟩
  set f' := X.totalQuotientUnitsSheaf.obj.map (homOfLE h₂).op f
  rw [map_mul, hr, ← toK_naturality, hg]
  change _ * kUnitVal f'⁻¹ * kUnitVal f' = _
  rw [mul_assoc, show kUnitVal f'⁻¹ * kUnitVal f' = 1 from Units.inv_mul _, mul_one]

/-- For effective `D`, the regular function underlying a section of `𝒪_X(-D)`. -/
def idealSection {D : X.CartierDivisor} (hD : D.IsEffective) {U : X.Opens}
    (s : (-D).sheaf.val.obj (op U)) : Γ(X, U) :=
  Classical.choose (exists_toK_eq_of_isSection_neg hD s.2)

/-- The regular function `idealSection hD s` is the section `s` of `𝒪_X(-D) ⊆ K_X`. -/
theorem toK_idealSection {D : X.CartierDivisor} (hD : D.IsEffective) {U : X.Opens}
    (s : (-D).sheaf.val.obj (op U)) :
    X.toK U (idealSection hD s) =
      (show X.totalQuotientSheaf.obj.obj (op U) from s.1) :=
  Classical.choose_spec (exists_toK_eq_of_isSection_neg hD s.2)

set_option backward.isDefEq.respectTransparency false in
/-- For effective `D`, the inclusion of the ideal sheaf `𝒪_X(-D)` into `𝒪_X`. -/
def idealSheafι {D : X.CartierDivisor} (hD : D.IsEffective) :
    (-D).sheaf ⟶ (SheafOfModules.unit X.ringCatSheaf : X.Modules) :=
  ⟨{ app U := ModuleCat.ofHom
      { toFun s := idealSection hD s
        map_add' s t := X.toK_injective U.unop (by
          rw [map_add, toK_idealSection, toK_idealSection, toK_idealSection]
          rfl)
        map_smul' c s := X.toK_injective U.unop (by
          change X.toK _ (idealSection hD (c • s)) =
            X.toK _ ((show Γ(X, U.unop) from c) * idealSection hD s)
          rw [map_mul, toK_idealSection, toK_idealSection]
          rfl) }
     naturality {U V} i := by
      ext s
      apply X.toK_injective V.unop
      change X.toK _ (idealSection hD _) = X.toK _ (X.presheaf.map i (idealSection hD s))
      rw [toK_idealSection]
      rw [show i = (homOfLE (leOfHom i.unop)).op from rfl, ← toK_naturality, toK_idealSection]
      rfl }⟩

/-- The ideal sheaf `𝒪_X(-D)` is a subsheaf of `𝒪_X`. -/
instance {D : X.CartierDivisor} (hD : D.IsEffective) : Mono (idealSheafι hD) :=
  (SheafOfModules.forget _).mono_of_mono_map (PresheafOfModules.mono_of_injective
    fun U s t h => Subtype.ext ((toK_idealSection hD s).symm.trans
      ((congrArg (X.toK U.unop) h).trans (toK_idealSection hD t))))

/-- The invertible sheaf `𝒪_X(D)` is quasi-coherent. -/
instance isQuasicoherent_sheaf (D : X.CartierDivisor) : D.sheaf.IsQuasicoherent :=
  Hartshorne.Ringed.IsFiniteLocallyFree.isQuasicoherent
    (Hartshorne.Ringed.IsLocallyFreeOfRank.isFiniteLocallyFree
      ((Modules.isInvertible_iff_ringed _).1 D.isInvertible_sheaf))

/-- The ideal sheaf `𝒪_X(-D) ⊆ 𝒪_X` of an effective Cartier divisor, as ideal data on `X`. Its
closed subscheme is the subscheme associated to `D`. -/
def idealSheafData {D : X.CartierDivisor} (hD : D.IsEffective) : X.IdealSheafData :=
  Hartshorne.idealSheafDataOfHom (idealSheafι hD)

set_option backward.isDefEq.respectTransparency false in
/-- A regular function lies in the ideal of an effective `D` exactly when it is a section of
`𝒪_X(-D)`. -/
theorem mem_idealSheafData_ideal_iff {D : X.CartierDivisor} (hD : D.IsEffective)
    (U : X.affineOpens) (r : Γ(X, U)) :
    r ∈ (idealSheafData hD).ideal U ↔ (-D).IsSection (X.toK U r) := by
  change r ∈ Hartshorne.homRangeIdeal (idealSheafι hD) U ↔ _
  rw [Hartshorne.mem_homRangeIdeal]
  constructor
  · rintro ⟨s, rfl⟩
    change (-D).IsSection (X.toK U (idealSection hD s))
    rw [toK_idealSection]
    exact s.2
  · intro hr
    refine ⟨⟨X.toK U r, hr⟩, X.toK_injective U ?_⟩
    change X.toK U (idealSection hD _) = _
    rw [toK_idealSection]

/-- Over an open carrying a local equation `f` of `D`, the sections of `𝒪_X(D)` are the `s`
with `s f` regular. -/
theorem isSection_iff_of_restrict_eq (D : X.CartierDivisor) {V : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V)}
    (hf : D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f))
    (s : X.totalQuotientSheaf.obj.obj (op V)) :
    D.IsSection s ↔ ∃ r : Γ(X, V), X.toK V r = s * kUnitVal f := by
  constructor
  · intro hs
    obtain ⟨r, hr⟩ := hs V le_rfl f hf
    exact ⟨r, by rw [hr, kMap_id]⟩
  · rintro ⟨r, hr⟩
    refine D.isSection_of_locally s fun x hx ↦ ⟨V, le_rfl, f, hx, hf, r, ?_⟩
    rw [hr, kMap_id]

/-- **The ideal of an effective divisor is locally principal.** If `g` is a regular local
equation of `D` on `V`, then over every affine open `W ⊆ V` the ideal of `D` is generated by
`g`. -/
theorem idealSheafData_ideal_eq_span {D : X.CartierDivisor} (hD : D.IsEffective) {V : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V)}
    (hf : D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f))
    {g : Γ(X, V)} (hg : X.toK V g = kUnitVal f) (W : X.affineOpens) (hW : (W : X.Opens) ≤ V) :
    (idealSheafData hD).ideal W = Ideal.span {X.presheaf.map (homOfLE hW).op g} := by
  set u := X.totalQuotientUnitsSheaf.obj.map (homOfLE hW).op f
  have hu : X.toK W (X.presheaf.map (homOfLE hW).op g) = kUnitVal u := by
    rw [← toK_naturality, hg]
    rfl
  ext r
  rw [mem_idealSheafData_ideal_iff, isSection_iff_of_restrict_eq (-D)
    (D.restrict_neg_eq_of_restrict_eq (D.restrict_eq_of_le hW hf)), Ideal.mem_span_singleton']
  constructor
  · rintro ⟨a, ha⟩
    refine ⟨a, X.toK_injective W ?_⟩
    rw [map_mul, ha, hu, mul_assoc, show kUnitVal u⁻¹ * kUnitVal u = 1 from Units.inv_mul _,
      mul_one]
  · rintro ⟨a, rfl⟩
    refine ⟨a, ?_⟩
    rw [map_mul, hu, mul_assoc, show kUnitVal u * kUnitVal u⁻¹ = 1 from Units.mul_inv _, mul_one]

/-- A regular function which is a unit of the total quotient ring is a non-zero-divisor. -/
theorem mem_nonZeroDivisors_of_isUnit_toK {U : X.Opens} {g : Γ(X, U)}
    (hg : IsUnit (X.toK U g)) : g ∈ nonZeroDivisors Γ(X, U) := by
  rw [mem_nonZeroDivisors_iff_right]
  intro r hr
  apply X.toK_injective U
  rw [map_zero]
  have : X.toK U r * X.toK U g = 0 := by rw [← map_mul, hr, map_zero]
  exact hg.mul_left_eq_zero.mp this

private theorem exists_affineOpens_mem_le {V : X.Opens} {x : X} (hx : x ∈ V) :
    ∃ W : X.affineOpens, x ∈ (W : X.Opens) ∧ (W : X.Opens) ≤ V := by
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWV⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open hx V.2
  exact ⟨⟨W, hW⟩, hxW, hWV⟩

end Scheme.CartierDivisor

/-- Ideal data on `X` which is **locally generated by one non-zero-divisor**: every point has an
affine neighbourhood `U` over which the ideal is generated by a non-zero-divisor of `Γ(X, U)`. -/
def Scheme.IdealSheafData.IsLocallyPrincipalNonZeroDivisor (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ U : X.affineOpens, x ∈ (U : X.Opens) ∧
    ∃ g ∈ nonZeroDivisors Γ(X, U), I.ideal U = Ideal.span {g}

namespace Scheme.CartierDivisor

/-- The ideal sheaf of an effective Cartier divisor is locally generated by one non-zero-divisor,
namely a local equation. -/
theorem isLocallyPrincipalNonZeroDivisor_idealSheafData {D : X.CartierDivisor}
    (hD : D.IsEffective) : (idealSheafData hD).IsLocallyPrincipalNonZeroDivisor := by
  intro x
  obtain ⟨V, f, hxV, hf, g, hg⟩ := hD x
  obtain ⟨W, hxW, hWV⟩ := exists_affineOpens_mem_le hxV
  refine ⟨W, hxW, X.presheaf.map (homOfLE hWV).op g, ?_,
    idealSheafData_ideal_eq_span hD hf hg W hWV⟩
  apply mem_nonZeroDivisors_of_isUnit_toK
  rw [← toK_naturality, hg]
  exact IsUnit.map (X.totalQuotientSheaf.obj.map (homOfLE hWV).op).hom
    (Units.isUnit (show (X.totalQuotientSheaf.obj.obj (op V))ˣ from f))

/-- Effective divisors with the same ideal sheaf have the same sections of `𝒪_X(-D)`. -/
theorem isSection_neg_of_idealSheafData_eq {D D' : X.CartierDivisor} (hD : D.IsEffective)
    (hD' : D'.IsEffective) (h : idealSheafData hD = idealSheafData hD') {U : X.Opens}
    {s : X.totalQuotientSheaf.obj.obj (op U)} (hs : (-D).IsSection s) : (-D').IsSection s := by
  obtain ⟨r, rfl⟩ := exists_toK_eq_of_isSection_neg hD hs
  apply isSection_of_locally_isSection
  intro x hx
  obtain ⟨W, hxW, hWU⟩ := exists_affineOpens_mem_le hx
  refine ⟨W, hWU, hxW, ?_⟩
  rw [toK_naturality, ← mem_idealSheafData_ideal_iff hD', ← h, mem_idealSheafData_ideal_iff,
    ← toK_naturality]
  exact (-D).isSection_restrict hWU hs

/-- **An effective Cartier divisor is determined by its ideal sheaf.** -/
theorem idealSheafData_injective {D D' : X.CartierDivisor} (hD : D.IsEffective)
    (hD' : D'.IsEffective) (h : idealSheafData hD = idealSheafData hD') : D = D' := by
  refine neg_injective (toInvertibleSubmodule_injective
    (InvertibleTotalQuotientSubmodule.ext (PresheafOfModules.Submodule.ext fun U ↦ ?_)))
  obtain ⟨U⟩ := U
  ext s
  change (-D).IsSection (U := U) s ↔ (-D').IsSection (U := U) s
  exact ⟨isSection_neg_of_idealSheafData_eq hD hD' h,
    isSection_neg_of_idealSheafData_eq hD' hD h.symm⟩

end Scheme.CartierDivisor

/-- A local non-zero-divisor generator of an ideal can be chosen, on a smaller affine
neighbourhood, to be a unit of the total quotient sheaf. -/
theorem Scheme.IdealSheafData.IsLocallyPrincipalNonZeroDivisor.exists_isUnit
    {I : X.IdealSheafData} (hI : I.IsLocallyPrincipalNonZeroDivisor) (x : X) :
    ∃ (W : X.affineOpens) (g : Γ(X, W)), x ∈ (W : X.Opens) ∧ I.ideal W = Ideal.span {g} ∧
      IsUnit (X.toK W g) := by
  obtain ⟨U, hxU, g, hg, hIU⟩ := hI x
  have hinj : ∀ (V : X.Opens) (h : V ≤ U) (r : Γ(X, V)),
      X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op (X.toK U g) = 0 → r = 0 := by
    intro V h r hr
    rw [toK_naturality, ← map_mul] at hr
    have hr' : r * X.presheaf.map (homOfLE h).op g = 0 :=
      X.toK_injective V (by rw [hr, map_zero])
    refine TopCat.Presheaf.section_ext X.sheaf V r 0 fun y hy ↦ ?_
    obtain ⟨b, hbV, hyb⟩ := U.2.exists_basicOpen_le ⟨y, hy⟩ (h hy)
    have := U.2.isLocalization_basicOpen b
    have hgb : X.presheaf.map (homOfLE (X.basicOpen_le b)).op g ∈
        nonZeroDivisors Γ(X, X.basicOpen b) :=
      IsLocalization.nonZeroDivisors_le_comap (Submonoid.powers b) Γ(X, X.basicOpen b) hg
    have hrb : X.presheaf.map (homOfLE hbV).op r = 0 := by
      refine (mem_nonZeroDivisors_iff_right.mp hgb) _ ?_
      have := congrArg (X.presheaf.map (homOfLE hbV).op) hr'
      rwa [map_mul, map_zero, ← CommRingCat.comp_apply, ← Functor.map_comp] at this
    change X.presheaf.germ V y hy r = X.presheaf.germ V y hy 0
    rw [← X.presheaf.germ_res_apply (homOfLE hbV) y hyb, hrb, map_zero, map_zero]
  obtain ⟨W', hW'U, hxW', hunit⟩ := Scheme.exists_isUnit_of_mul_injective
    (X.toK U g) hinj hxU
  obtain ⟨W, hxW, hWW'⟩ := Scheme.CartierDivisor.exists_affineOpens_mem_le hxW'
  refine ⟨W, X.presheaf.map (homOfLE (hWW'.trans hW'U)).op g, hxW, ?_, ?_⟩
  · rw [← I.map_ideal (U := W) (V := U) (hWW'.trans hW'U), hIU, Ideal.map_span,
      Set.image_singleton]
    rfl
  · rw [← toK_naturality, ← kMap_map hWW' hW'U]
    exact hunit.map (X.totalQuotientSheaf.obj.map (homOfLE hWW').op).hom

namespace Scheme.CartierDivisor

/-- **Every ideal locally generated by one non-zero-divisor is the ideal of an effective Cartier
divisor.** The local generators, which are units of the total quotient sheaf, are local
equations of the divisor. -/
theorem exists_idealSheafData_eq {I : X.IdealSheafData}
    (hI : I.IsLocallyPrincipalNonZeroDivisor) :
    ∃ (D : X.CartierDivisor) (hD : D.IsEffective), idealSheafData hD = I := by
  choose W g hxW hspan hunit using hI.exists_isUnit
  let f : ∀ x, X.totalQuotientUnitsSheaf.obj.obj (op (W x).1) := fun x ↦
    (show (X.totalQuotientSheaf.obj.obj (op (W x).1))ˣ from (hunit x).unit)
  have hfg : ∀ x, X.toK (W x).1 (g x) = kUnitVal (f x) := fun x ↦ (hunit x).unit_spec.symm
  have hdiv : ∀ (i j : X) (V : X.affineOpens) (hi : (V : X.Opens) ≤ (W i).1)
      (hj : (V : X.Opens) ≤ (W j).1),
      ∃ c : Γ(X, V), c * X.presheaf.map (homOfLE hj).op (g j) =
        X.presheaf.map (homOfLE hi).op (g i) := by
    intro i j V hi hj
    have hIi : I.ideal V = Ideal.span {X.presheaf.map (homOfLE hi).op (g i)} := by
      rw [← I.map_ideal (U := V) (V := W i) hi, hspan i, Ideal.map_span, Set.image_singleton]
      rfl
    have hIj : I.ideal V = Ideal.span {X.presheaf.map (homOfLE hj).op (g j)} := by
      rw [← I.map_ideal (U := V) (V := W j) hj, hspan j, Ideal.map_span, Set.image_singleton]
      rfl
    rw [← Ideal.mem_span_singleton', ← hIj, hIi]
    exact Ideal.mem_span_singleton_self _
  have key : ∀ (i j : X) (O : X.Opens) (hi : O ≤ (W i).1) (hj : O ≤ (W j).1),
      ∃ u : Γ(X, O), X.toK O u * X.totalQuotientSheaf.obj.map (homOfLE hj).op (kUnitVal (f j)) =
        X.totalQuotientSheaf.obj.map (homOfLE hi).op (kUnitVal (f i)) := by
    intro i j O hi hj
    obtain ⟨u, hu⟩ := exists_toK_eq_of_locally
      (X.totalQuotientSheaf.obj.map (homOfLE hi).op (kUnitVal (f i)) *
        X.totalQuotientSheaf.obj.map (homOfLE hj).op (kUnitVal (f j)⁻¹)) (fun z hz ↦ by
      obtain ⟨V, hzV, hVO⟩ := exists_affineOpens_mem_le hz
      obtain ⟨c, hc⟩ := hdiv i j V (hVO.trans hi) (hVO.trans hj)
      refine ⟨V, hVO, hzV, c, ?_⟩
      have hAi : X.totalQuotientSheaf.obj.map (homOfLE (hVO.trans hi)).op (kUnitVal (f i)) =
          X.toK V c *
            X.totalQuotientSheaf.obj.map (homOfLE (hVO.trans hj)).op (kUnitVal (f j)) := by
        rw [← hfg i, ← hfg j, toK_naturality, toK_naturality, ← map_mul, hc]
      rw [map_mul, kMap_map, kMap_map, hAi, mul_assoc, ← map_mul,
        show kUnitVal (f j) * kUnitVal (f j)⁻¹ = 1 from Units.mul_inv _, map_one, mul_one])
    refine ⟨u, ?_⟩
    rw [hu, mul_assoc, ← map_mul, show kUnitVal (f j)⁻¹ * kUnitVal (f j) = 1 from Units.inv_mul _,
      map_one, mul_one]
  have htrans : ∀ i j, ∃ a : X.structureUnitsSheaf.obj.obj (op ((W i).1 ⊓ (W j).1)),
      X.structureUnitsToTotalQuotientUnits.hom.app (op ((W i).1 ⊓ (W j).1)) a =
        X.totalQuotientUnitsSheaf.obj.map (Opens.infLELeft (W i).1 (W j).1).op (f i) /
          X.totalQuotientUnitsSheaf.obj.map (Opens.infLERight (W i).1 (W j).1).op (f j) := by
    intro i j
    have hi : (W i).1 ⊓ (W j).1 ≤ (W i).1 := inf_le_left
    have hj : (W i).1 ⊓ (W j).1 ≤ (W j).1 := inf_le_right
    obtain ⟨u, hu⟩ := key i j _ hi hj
    obtain ⟨v, hv⟩ := key j i _ hj hi
    set fi := X.totalQuotientSheaf.obj.map (homOfLE hi).op (kUnitVal (f i))
    set fj := X.totalQuotientSheaf.obj.map (homOfLE hj).op (kUnitVal (f j))
    set gj := X.totalQuotientSheaf.obj.map (homOfLE hj).op (kUnitVal (f j)⁻¹)
    have hfgj : fj * gj = 1 := by
      rw [← map_mul, show kUnitVal (f j) * kUnitVal (f j)⁻¹ = 1 from Units.mul_inv _, map_one]
    have hvu : v * u = 1 := by
      apply toK_injective
      calc X.toK _ (v * u) = X.toK _ (v * u) * (fj * gj) := by rw [hfgj, mul_one]
        _ = X.toK _ v * (X.toK _ u * fj) * gj := by rw [map_mul]; ring
        _ = 1 := by rw [hu, hv, hfgj]
        _ = X.toK _ 1 := (map_one _).symm
    refine ⟨(show Γ(X, (W i).1 ⊓ (W j).1)ˣ from ⟨u, v, by rw [mul_comm, hvu], hvu⟩),
      Units.ext ?_⟩
    change X.toK _ u = fi * gj
    calc X.toK _ u = X.toK _ u * (fj * gj) := by rw [hfgj, mul_one]
      _ = fi * gj := by rw [← mul_assoc, hu]
  let E : X.CartierLocalEquations X :=
    { U := fun x ↦ (W x).1
      cover := fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxW x⟩
      f := f
      transition := htrans }
  obtain ⟨D, hD, -⟩ := E.existsUnique_represents
  have hDeff : D.IsEffective := fun x ↦ ⟨(W x).1, f x, hxW x, hD x, g x, hfg x⟩
  refine ⟨D, hDeff, Scheme.IdealSheafData.ext_of_iSup_eq_top W
    (eq_top_iff.mpr fun y _ ↦ Opens.mem_iSup.mpr ⟨y, hxW y⟩) fun x ↦ ?_⟩
  rw [idealSheafData_ideal_eq_span hDeff (hD x) (hfg x) (W x) le_rfl, hspan x]
  change Ideal.span {X.presheaf.map (𝟙 _) (g x)} = _
  rw [CategoryTheory.Functor.map_id]
  rfl

/-- The ideal sheaf of an effective Cartier divisor, as an element of the set of ideal data
locally generated by one non-zero-divisor. -/
def toLocallyPrincipalIdealSheafData (D : {D : X.CartierDivisor // D.IsEffective}) :
    {I : X.IdealSheafData // I.IsLocallyPrincipalNonZeroDivisor} :=
  ⟨idealSheafData D.2, isLocallyPrincipalNonZeroDivisor_idealSheafData D.2⟩

/-- Sending an effective divisor to its ideal sheaf is a bijection onto ideal data locally
generated by one non-zero-divisor. -/
theorem toLocallyPrincipalIdealSheafData_bijective :
    Function.Bijective (toLocallyPrincipalIdealSheafData (X := X)) := by
  refine ⟨fun D D' h ↦ Subtype.ext (idealSheafData_injective D.2 D'.2 (congrArg Subtype.val h)),
    fun I ↦ ?_⟩
  obtain ⟨D, hD, h⟩ := exists_idealSheafData_eq I.2
  exact ⟨⟨D, hD⟩, Subtype.ext h⟩

end Scheme.CartierDivisor

/-- **Hartshorne II, Remark 6.17.1.** Effective Cartier divisors on `X` correspond bijectively to
closed subschemes locally cut out by one non-zero-divisor, via `D ↦ 𝒪_X(-D) ⊆ 𝒪_X`. -/
def Scheme.effectiveCartierDivisorEquiv (X : Scheme.{u}) :
    {D : X.CartierDivisor // D.IsEffective} ≃
      {I : X.IdealSheafData // I.IsLocallyPrincipalNonZeroDivisor} :=
  Equiv.ofBijective _ Scheme.CartierDivisor.toLocallyPrincipalIdealSheafData_bijective

@[simp]
theorem Scheme.effectiveCartierDivisorEquiv_apply_coe
    (D : {D : X.CartierDivisor // D.IsEffective}) :
    (X.effectiveCartierDivisorEquiv D : X.IdealSheafData) =
      Scheme.CartierDivisor.idealSheafData D.2 :=
  rfl

end

end AlgebraicGeometry
