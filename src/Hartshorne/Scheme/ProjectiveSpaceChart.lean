import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Coordinate charts of projective space over a ring

Hartshorne, *Algebraic Geometry*, II.2, Proposition 2.5 and Example 2.5.1 (p. 77),
and II.7, the standard affine charts of projective space.

For a commutative ring `R` and the polynomial ring `R[x_j : j ∈ σ]` with its
total-degree grading:

* the coordinate basic opens `D₊(xⱼ)` cover `Proj`, since the irrelevant ideal is
  contained in the ideal generated by the variables;
* dehomogenization `xᵢ ↦ 1` and the substitution `xⱼ ↦ xⱼ / xᵢ` are inverse ring
  isomorphisms between the degree-zero localization `R[x]_(xᵢ)` and the
  polynomial ring in the coordinates other than `xᵢ`.

No hypothesis on `R` is needed: the inverse is checked directly, using that a
homogeneous polynomial of degree `d` scales by `t ^ d` when every variable is
multiplied by `t`.
-/

namespace Hartshorne

open MvPolynomial

/-- A homogeneous polynomial of degree `d` scales by `t ^ d` when every variable
is multiplied by `t`. -/
theorem isHomogeneous_eval₂_mul_left
    {R S σ : Type*} [CommSemiring R] [CommSemiring S]
    {φ : MvPolynomial σ R} {d : ℕ} (hφ : φ.IsHomogeneous d)
    (f : R →+* S) (g : σ → S) (t : S) :
    eval₂ f (fun j => t * g j) φ = t ^ d * eval₂ f g φ := by
  rw [eval₂_eq, eval₂_eq, Finset.mul_sum]
  refine Finset.sum_congr rfl fun m hm => ?_
  have hdeg : ∑ j ∈ m.support, m j = d := by
    have h : Finsupp.degree m = d := by
      rw [Finsupp.degree_eq_weight_one, ← Pi.one_def]
      exact hφ (mem_support_iff.1 hm)
    exact h
  simp_rw [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
  ring

section Charts

variable (R : Type*) [CommRing R] {σ : Type*}

attribute [local instance] MvPolynomial.gradedAlgebra

/-- A variable is homogeneous of degree one for the total-degree grading. -/
theorem X_mem_homogeneousSubmodule_one (j : σ) :
    (X j : MvPolynomial σ R) ∈ homogeneousSubmodule σ R 1 :=
  (mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X R j)

/-- The irrelevant ideal of the total-degree grading is contained in the ideal
generated by the variables. -/
theorem irrelevant_le_span_range_X :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule σ R)).toIdeal ≤
      Ideal.span (Set.range (X : σ → MvPolynomial σ R)) := by
  rw [HomogeneousIdeal.toIdeal_irrelevant_le]
  intro d hd p hp
  change p ∈ MvPolynomial.idealOfVars σ R
  rw [← pow_one (MvPolynomial.idealOfVars σ R), MvPolynomial.mem_pow_idealOfVars_iff]
  intro m hm
  have hhom : p.IsHomogeneous d := (mem_homogeneousSubmodule d p).1 hp
  have hdeg : (Finsupp.weight 1) m = d := hhom (mem_support_iff.1 hm)
  have hdeg' : Finsupp.degree m = d := by
    rw [Finsupp.degree_eq_weight_one, ← Pi.one_def]
    exact hdeg
  rw [hdeg']
  exact hd

/-- The coordinate basic opens `D₊(xⱼ)` cover projective space. -/
theorem iSup_proj_basicOpen_X_eq_top :
    ⨆ j : σ, AlgebraicGeometry.Proj.basicOpen (homogeneousSubmodule σ R) (X j) = ⊤ :=
  AlgebraicGeometry.Proj.iSup_basicOpen_eq_top _ X (irrelevant_le_span_range_X R)

/-- The affine open cover of projective space by the coordinate charts
`Spec R[x]_(xⱼ)`. -/
noncomputable def projCoordinateAffineOpenCover :
    (AlgebraicGeometry.Proj (homogeneousSubmodule σ R)).AffineOpenCover :=
  AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan _ X
    (fun j => X_mem_homogeneousSubmodule_one R j) (fun _ => Nat.one_pos)
    (irrelevant_le_span_range_X R)

variable [DecidableEq σ]

/-- Dehomogenization at `xᵢ`: substitute `1` for `xᵢ` and keep the other
variables. -/
noncomputable def chartDehomogenize (i : σ) :
    MvPolynomial σ R →+* MvPolynomial {j : σ // j ≠ i} R :=
  eval₂Hom C fun j => if h : j = i then 1 else X ⟨j, h⟩

@[simp]
theorem chartDehomogenize_C (i : σ) (r : R) :
    chartDehomogenize R i (C r) = C r := by
  simp [chartDehomogenize]

@[simp]
theorem chartDehomogenize_X_self (i : σ) :
    chartDehomogenize R i (X i) = 1 := by
  simp [chartDehomogenize]

theorem chartDehomogenize_X_of_ne {i j : σ} (h : j ≠ i) :
    chartDehomogenize R i (X j) = X ⟨j, h⟩ := by
  simp [chartDehomogenize, h]

/-- Dehomogenization inverts `xᵢ`, so it factors through the localization. -/
noncomputable def chartAwayDehomogenize (i : σ) :
    Localization.Away (X i : MvPolynomial σ R) →+* MvPolynomial {j : σ // j ≠ i} R :=
  IsLocalization.lift (M := Submonoid.powers (X i : MvPolynomial σ R))
    (g := chartDehomogenize R i) (by
      rintro ⟨y, n, rfl⟩
      simp)

theorem chartAwayDehomogenize_mk (i : σ) (a : MvPolynomial σ R) (n : ℕ)
    (h : (X i : MvPolynomial σ R) ^ n ∈ Submonoid.powers (X i : MvPolynomial σ R)) :
    chartAwayDehomogenize R i (Localization.mk a ⟨_, h⟩) = chartDehomogenize R i a := by
  rw [Localization.mk_eq_mk', chartAwayDehomogenize, IsLocalization.lift_mk'_spec]
  simp

/-- The dehomogenization map `R[x]_(xᵢ) → R[xⱼ : j ≠ i]`. -/
noncomputable def chartToPoly (i : σ) :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) →+*
      MvPolynomial {j : σ // j ≠ i} R where
  toFun z := chartAwayDehomogenize R i z.val
  map_one' := by simp [HomogeneousLocalization.val_one]
  map_mul' a b := by simp [HomogeneousLocalization.val_mul]
  map_zero' := by simp [HomogeneousLocalization.val_zero]
  map_add' a b := by simp [HomogeneousLocalization.val_add]

theorem chartToPoly_mk (i : σ) (n : ℕ) (a : MvPolynomial σ R)
    (ha : a ∈ homogeneousSubmodule σ R (n • 1)) :
    chartToPoly R i (HomogeneousLocalization.Away.mk (homogeneousSubmodule σ R)
      (X_mem_homogeneousSubmodule_one R i) n a ha) = chartDehomogenize R i a := by
  change chartAwayDehomogenize R i _ = _
  rw [HomogeneousLocalization.Away.val_mk, chartAwayDehomogenize_mk]

/-- The fraction `xⱼ / xᵢ` in `R[x]_(xᵢ)`. -/
noncomputable def chartRatio (i j : σ) :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) :=
  HomogeneousLocalization.Away.mk (homogeneousSubmodule σ R)
    (X_mem_homogeneousSubmodule_one R i) 1 (X j) (by
      simpa using X_mem_homogeneousSubmodule_one R j)

/-- The constants `r / 1` in `R[x]_(xᵢ)`. -/
noncomputable def chartConst (i : σ) :
    R →+* HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) :=
  (HomogeneousLocalization.fromZeroRingHom (homogeneousSubmodule σ R) _).comp
    (algebraMap R (homogeneousSubmodule σ R 0))

/-- The substitution `xⱼ ↦ xⱼ / xᵢ`, the inverse of dehomogenization. -/
noncomputable def chartOfPoly (i : σ) :
    MvPolynomial {j : σ // j ≠ i} R →+*
      HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) :=
  eval₂Hom (chartConst R i) fun j => chartRatio R i j

omit [DecidableEq σ] in
theorem chartConst_val (i : σ) (r : R) :
    (chartConst R i r).val =
      algebraMap (MvPolynomial σ R) (Localization.Away (X i : MvPolynomial σ R)) (C r) := by
  rw [← Localization.mk_one_eq_algebraMap]
  rfl

omit [DecidableEq σ] in
theorem chartRatio_val (i j : σ) :
    (chartRatio R i j).val = Localization.mk (X j) ⟨X i ^ 1, by use 1⟩ := by
  simp [chartRatio, HomogeneousLocalization.Away.val_mk]

theorem chartToPoly_comp_chartOfPoly (i : σ) :
    (chartToPoly R i).comp (chartOfPoly R i) = RingHom.id _ := by
  apply MvPolynomial.ringHom_ext
  · intro r
    change chartAwayDehomogenize R i (chartOfPoly R i (C r)).val = C r
    rw [chartOfPoly, coe_eval₂Hom, eval₂_C, chartConst_val, chartAwayDehomogenize,
      IsLocalization.lift_eq, chartDehomogenize_C]
  · intro j
    change chartToPoly R i (eval₂ _ _ (X j)) = X j
    rw [eval₂_X, chartRatio, chartToPoly_mk, chartDehomogenize_X_of_ne R j.2]

theorem chartOfPoly_comp_chartToPoly (i : σ) :
    (chartOfPoly R i).comp (chartToPoly R i) = RingHom.id _ := by
  ext z
  obtain ⟨n, a, ha, rfl⟩ :=
    HomogeneousLocalization.Away.mk_surjective _ (X_mem_homogeneousSubmodule_one R i) z
  rw [RingHom.comp_apply, chartToPoly_mk, RingHom.id_apply]
  let L := Localization.Away (X i : MvPolynomial σ R)
  let ι : MvPolynomial σ R →+* L := algebraMap _ _
  let Θ : MvPolynomial σ R →+* L :=
    (algebraMap (HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i)) L).comp
      ((chartOfPoly R i).comp (chartDehomogenize R i))
  have hΘ : ∀ p, Θ p = (chartOfPoly R i (chartDehomogenize R i p)).val := fun _ => rfl
  have hΘC : Θ.comp C = ι.comp C := by
    ext r
    simp only [RingHom.comp_apply, hΘ, chartDehomogenize_C, chartOfPoly, coe_eval₂Hom,
      eval₂_C, chartConst_val, ι]
    rfl
  have hΘX : ∀ j, ι (X i) * Θ (X j) = ι (X j) := by
    intro j
    by_cases hj : j = i
    · subst hj
      rw [hΘ, chartDehomogenize_X_self, map_one, HomogeneousLocalization.val_one, mul_one]
    · rw [hΘ, chartDehomogenize_X_of_ne R hj, chartOfPoly, coe_eval₂Hom, eval₂_X,
        chartRatio_val]
      rw [Localization.mk_eq_mk', IsLocalization.mul_mk'_eq_mk'_of_mul,
        IsLocalization.mk'_eq_iff_eq_mul]
      simp [ι, mul_comm]
  have hhom : a.IsHomogeneous n := by
    simpa using (mem_homogeneousSubmodule _ _).1 ha
  have key : ι (X i ^ n) * Θ a = ι a := by
    have h1 : Θ a = eval₂ (Θ.comp C) (fun j => Θ (X j)) a := by
      conv_lhs => rw [← eval₂_eta a]
      exact eval₂_comp_left Θ C X a
    have h2 : ι a = eval₂ (ι.comp C) (fun j => ι (X j)) a := by
      conv_lhs => rw [← eval₂_eta a]
      exact eval₂_comp_left ι C X a
    rw [h1, h2, map_pow, ← isHomogeneous_eval₂_mul_left hhom, hΘC]
    simp_rw [hΘX]
  rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk',
    IsLocalization.eq_mk'_iff_mul_eq, ← hΘ, mul_comm]
  exact key

/-- **The standard chart of projective space.** Dehomogenization is a ring
isomorphism `R[x]_(xᵢ) ≃ R[xⱼ : j ≠ i]`. -/
noncomputable def chartAwayEquiv (i : σ) :
    HomogeneousLocalization.Away (homogeneousSubmodule σ R) (X i) ≃+*
      MvPolynomial {j : σ // j ≠ i} R :=
  RingEquiv.ofRingHom (chartToPoly R i) (chartOfPoly R i)
    (chartToPoly_comp_chartOfPoly R i) (chartOfPoly_comp_chartToPoly R i)

end Charts

end Hartshorne
