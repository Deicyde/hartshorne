import Hartshorne.Scheme.CartierDivisor
import Hartshorne.Scheme.LocallyFreeRinged
import Mathlib.Algebra.Category.ModuleCat.Presheaf.Abelian
import Mathlib.Algebra.Category.ModuleCat.Presheaf.Submodule
import Mathlib.Algebra.Category.ModuleCat.Sheaf.ChangeOfRings
import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free
import Mathlib.Topology.Sheaves.LocallySurjective

/-!
# The invertible sheaf associated to a Cartier divisor

Hartshorne, *Algebraic Geometry*, II.6, definition of `O_X(D)` and Proposition 6.13(a) (p. 144).

The total quotient sheaf `K_X` is an `O_X`-module by restriction of scalars along `O_X ⟶ K_X`.
For a Cartier divisor `D`, the `O_X`-submodule `O_X(D)` of `K_X` is the sub-`O_X`-module locally
generated by `f⁻¹`, where `f` is a local equation of `D`: a section `s` of `K_X` over `U` lies in
`O_X(D)(U)` when `s f` is regular on every open `V ⊆ U` carrying a local equation `f` of `D`.
Since two local equations on the same open differ by a regular unit, this is the submodule
locally generated by the inverses of the local equations of any presentation of `D`.

An *invertible submodule of `K_X`* is a family of `O_X(U)`-submodules of `K_X(U)`, stable under
restriction, which forms a sheaf and is an invertible `O_X`-module; the embedding into `K_X` is
part of the data. We prove that `O_X(D)` is invertible and that `D ↦ O_X(D)` is a bijection from
Cartier divisors to invertible submodules of `K_X`. The construction does not assume `X`
integral or reduced: surjectivity uses that a section `g` of `K_X` with `r g = 0 ⇒ r = 0` for
all local regular functions `r` is locally a unit of `K_X`, which follows from the definition of
`K_X` by inverting sections whose germs are non-zero-divisors at every point.
-/

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

universe u

noncomputable section

namespace Scheme

variable {X : Scheme.{u}}

/-- The total quotient sheaf `K_X`, viewed as a sheaf of (not necessarily commutative) rings. -/
noncomputable abbrev totalQuotientRingCatSheaf (X : Scheme.{u}) : TopCat.Sheaf RingCat.{u} X :=
  (sheafCompose _ (forget₂ CommRingCat RingCat.{u})).obj X.totalQuotientSheaf

/-- The canonical morphism `O_X ⟶ K_X` of sheaves of rings. -/
noncomputable abbrev toTotalQuotientRingCatSheaf (X : Scheme.{u}) :
    X.ringCatSheaf ⟶ X.totalQuotientRingCatSheaf :=
  (sheafCompose _ (forget₂ CommRingCat RingCat.{u})).map X.toTotalQuotientSheaf

/-- The total quotient sheaf `K_X` as an `O_X`-module, by restriction of scalars along
`O_X ⟶ K_X`. -/
noncomputable def totalQuotientModule (X : Scheme.{u}) : X.Modules :=
  (SheafOfModules.restrictScalars X.toTotalQuotientRingCatSheaf).obj (SheafOfModules.unit _)

/-- The ring map `O_X(U) ⟶ K_X(U)`. -/
noncomputable abbrev toK (X : Scheme.{u}) (U : X.Opens) :
    Γ(X, U) →+* X.totalQuotientSheaf.obj.obj (op U) :=
  (X.toTotalQuotientSheaf.hom.app (op U)).hom

/-- The underlying total-quotient section of a section of `K_X^*`. -/
abbrev kUnitVal {U : X.Opens} (f : X.totalQuotientUnitsSheaf.obj.obj (op U)) :
    X.totalQuotientSheaf.obj.obj (op U) :=
  ((show (X.totalQuotientSheaf.obj.obj (op U))ˣ from f) : X.totalQuotientSheaf.obj.obj (op U))

/-- The underlying regular function of a section of `O_X^*`. -/
abbrev oUnitVal {U : X.Opens} (a : X.structureUnitsSheaf.obj.obj (op U)) : Γ(X, U) :=
  ((show Γ(X, U)ˣ from a) : Γ(X, U))

set_option backward.isDefEq.respectTransparency false in
/-- The map `O_X(U) ⟶ K_X(U)` is injective. -/
theorem toK_injective (U : X.Opens) : Function.Injective (X.toK U) := by
  have : Mono X.toTotalQuotientSheaf := totalQuotientSheaf_mono X
  have h₁ : Mono X.toTotalQuotientSheaf.hom :=
    CategoryTheory.presheaf_mono_of_mono
      (Opens.grothendieckTopology X) CommRingCat X.toTotalQuotientSheaf
  have h₂ : Mono (X.toTotalQuotientSheaf.hom.app (op U)) :=
    (NatTrans.mono_iff_mono_app X.toTotalQuotientSheaf.hom).mp h₁ (op U)
  exact (ConcreteCategory.mono_iff_injective_of_preservesPullback _).mp h₂

/-- The map `O_X ⟶ K_X` commutes with restriction. -/
theorem toK_naturality {U V : X.Opens} (h : V ≤ U) (r : Γ(X, U)) :
    X.totalQuotientSheaf.obj.map (homOfLE h).op (X.toK U r) =
      X.toK V (X.presheaf.map (homOfLE h).op r) :=
  (ConcreteCategory.congr_hom (X.toTotalQuotientSheaf.hom.naturality (homOfLE h).op) r).symm

/-- Restricting a section of `K_X` twice is restricting it once. -/
theorem kMap_map {U V W : X.Opens} (h₁ : W ≤ V) (h₂ : V ≤ U)
    (s : X.totalQuotientSheaf.obj.obj (op U)) :
    X.totalQuotientSheaf.obj.map (homOfLE h₁).op (X.totalQuotientSheaf.obj.map (homOfLE h₂).op s) =
      X.totalQuotientSheaf.obj.map (homOfLE (h₁.trans h₂)).op s := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- A section of `K_X` which is locally regular is regular. -/
theorem exists_toK_eq_of_locally {U : X.Opens} (t : X.totalQuotientSheaf.obj.obj (op U))
    (h : ∀ x ∈ U, ∃ (V : X.Opens) (hVU : V ≤ U), x ∈ V ∧
      ∃ r : Γ(X, V), X.toK V r = X.totalQuotientSheaf.obj.map (homOfLE hVU).op t) :
    ∃ r : Γ(X, U), X.toK U r = t := by
  choose V hVU hxV r hr using fun x : U ↦ h x.1 x.2
  have cover : U ≤ ⨆ x, V x := fun x hx ↦ Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxV _⟩
  have compat : TopCat.Presheaf.IsCompatible X.sheaf.obj V r := by
    intro i j
    apply toK_injective
    change X.toK _ (X.presheaf.map (homOfLE inf_le_left).op (r i)) =
      X.toK _ (X.presheaf.map (homOfLE inf_le_right).op (r j))
    rw [← toK_naturality, ← toK_naturality, hr, hr, kMap_map,
      kMap_map]
  obtain ⟨r₀, hr₀, -⟩ := X.sheaf.existsUnique_gluing' V U (fun i ↦ homOfLE (hVU i)) cover r
    compat
  refine ⟨r₀, X.totalQuotientSheaf.eq_of_locally_eq' V U (fun i ↦ homOfLE (hVU i)) cover _ _
    fun i ↦ ?_⟩
  change X.totalQuotientSheaf.obj.map (homOfLE (hVU i)).op (X.toK U r₀) = _
  rw [toK_naturality (X := X) (hVU i) r₀, ← hr i]
  exact congrArg (X.toK (V i)) (hr₀ i)

/-- The map `O_X ⟶ K_X` factors through the presheaf of total quotient rings. -/
theorem toTotalQuotientSheaf_hom_eq (X : Scheme.{u}) :
    X.toTotalQuotientSheaf.hom = X.sheaf.presheaf.toTotalQuotientPresheaf ≫
      toSheafify (Opens.grothendieckTopology X) X.totalQuotientPresheaf := by
  simp only [toTotalQuotientSheaf, sheafificationIso, isoSheafify_hom]
  exact (toSheafify_naturality _ _).symm

/-- The map `O_X ⟶ K_X` on sections, through the total quotient presheaf. -/
theorem toSheafify_algebraMap (U : X.Opens) (a : Γ(X, U)) :
    (toSheafify (Opens.grothendieckTopology X) X.totalQuotientPresheaf).app (op U)
      (algebraMap Γ(X, U) (X.totalQuotientPresheaf.obj (op U)) a) = X.toK U a := by
  change _ = X.toTotalQuotientSheaf.hom.app (op U) a
  rw [toTotalQuotientSheaf_hom_eq]
  rfl

/-- A section `g` of `K_X` such that multiplication by `g` is injective on regular functions over
every smaller open set is locally a unit of `K_X`. -/
theorem exists_isUnit_of_mul_injective {U : X.Opens} (g : X.totalQuotientSheaf.obj.obj (op U))
    (hg : ∀ (V : X.Opens) (h : V ≤ U) (r : Γ(X, V)),
      X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op g = 0 → r = 0)
    {x : X} (hx : x ∈ U) :
    ∃ (W : X.Opens) (h : W ≤ U), x ∈ W ∧
      IsUnit (X.totalQuotientSheaf.obj.map (homOfLE h).op g) := by
  have hloc : TopCat.Presheaf.IsLocallySurjective
      (toSheafify (Opens.grothendieckTopology X) X.totalQuotientPresheaf) :=
    (inferInstance : Presheaf.IsLocallySurjective (Opens.grothendieckTopology X) _)
  obtain ⟨W, hWU, ⟨p, hp⟩, hxW⟩ := (TopCat.Presheaf.isLocallySurjective_iff _).1 hloc U g x hx
  let S := (X.presheaf.submonoidPresheafOfStalk
    (fun x ↦ nonZeroDivisors (X.presheaf.stalk x))).obj (op W)
  let σ : Localization S →+* X.totalQuotientSheaf.obj.obj (op W) :=
    ((toSheafify (Opens.grothendieckTopology X) X.totalQuotientPresheaf).app (op W)).hom
  have hσ : ∀ a : Γ(X, W), σ (algebraMap Γ(X, W) (Localization S) a) = X.toK W a :=
    toSheafify_algebraMap W
  obtain ⟨⟨a, t⟩, hat⟩ := IsLocalization.mk'_surjective S (show Localization S from p)
  have hkey : X.totalQuotientSheaf.obj.map (homOfLE hWU).op g * X.toK W t = X.toK W a := by
    have h₁ := IsLocalization.mk'_spec (Localization S) a t
    have h₂ : σ (IsLocalization.mk' (Localization S) a t) =
        X.totalQuotientSheaf.obj.map (homOfLE hWU).op g := by
      rw [show IsLocalization.mk' (Localization S) a t = p from hat]
      exact hp
    rw [← hσ, ← hσ, ← h₁, map_mul, h₂]
  have ht : IsUnit (X.toK W t) := by
    rw [← hσ]
    exact (IsLocalization.map_units (Localization S) t).map σ
  have ha : a ∈ S := by
    simp only [S, TopCat.Presheaf.submonoidPresheafOfStalk_obj, Submonoid.mem_iInf,
      Submonoid.mem_comap]
    intro y
    rw [mem_nonZeroDivisors_iff_left]
    intro z hz
    obtain ⟨W', hyW', b, rfl⟩ := X.presheaf.exists_germ_eq z
    have h0 : X.presheaf.germ (W' ⊓ W) y.1 ⟨hyW', y.2⟩
        (X.presheaf.map (homOfLE inf_le_left).op b *
          X.presheaf.map (homOfLE inf_le_right).op a) =
        X.presheaf.germ (W' ⊓ W) y.1 ⟨hyW', y.2⟩ 0 := by
      rw [map_mul, X.presheaf.germ_res_apply (homOfLE inf_le_left) y.1 ⟨hyW', y.2⟩ b,
        X.presheaf.germ_res_apply (homOfLE inf_le_right) y.1 ⟨hyW', y.2⟩ a, map_zero, mul_comm]
      exact hz
    obtain ⟨W'', hyW'', i₁, i₂, heq⟩ := X.presheaf.germ_eq y.1 _ _ _ _ h0
    have hW''W' : W'' ≤ W' := i₁.le.trans inf_le_left
    have hW''W : W'' ≤ W := i₁.le.trans inf_le_right
    have hW''U : W'' ≤ U := hW''W.trans hWU
    have hba : X.presheaf.map (homOfLE hW''W').op b * X.presheaf.map (homOfLE hW''W).op a = 0 := by
      rw [map_zero, map_mul, ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply,
        ← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp] at heq
      exact heq
    have hb : X.presheaf.map (homOfLE hW''W').op b = 0 := by
      apply hg W'' hW''U
      have hunit : IsUnit (X.toK W'' (X.presheaf.map (homOfLE hW''W).op t)) := by
        rw [← toK_naturality]
        exact ht.map _
      apply hunit.mul_left_eq_zero.1
      rw [← kMap_map hW''W hWU, ← toK_naturality hW''W (t : Γ(X, W)), mul_assoc,
        ← map_mul (ConcreteCategory.hom (X.totalQuotientSheaf.obj.map (homOfLE hW''W).op)), hkey,
        toK_naturality hW''W a, ← map_mul (X.toK W''), hba, map_zero]
    rw [← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hW''W') y.1 hyW'' b, hb, map_zero]
  have hau : IsUnit (X.toK W a) := by
    rw [← hσ]
    exact (IsLocalization.map_units (Localization S) ⟨a, ha⟩).map σ
  refine ⟨W, hWU, hxW, ?_⟩
  rw [← hkey] at hau
  exact isUnit_of_mul_isUnit_left hau

end Scheme

namespace Scheme.CartierDivisor

variable {X : Scheme.{u}}

/-- A local equation of `D` restricts to a local equation on a smaller open. -/
theorem restrict_eq_of_le (D : X.CartierDivisor) {V W : X.Opens} (h : W ≤ V)
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V)}
    (hf : D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f)) :
    D.restrict W = X.toCartierDivisorSheaf.hom.app (op W)
      (Additive.ofMul (X.totalQuotientUnitsSheaf.obj.map (homOfLE h).op f)) := by
  rw [← D.restrict_restrict h, hf, toCartierDivisorSheaf_naturality_apply]

/-- Two local equations of the same divisor on the same open differ by a regular function. -/
theorem exists_eq_mul_of_restrict_eq (D : X.CartierDivisor) {V : X.Opens}
    {f f' : X.totalQuotientUnitsSheaf.obj.obj (op V)}
    (hf : D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f))
    (hf' : D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f')) :
    ∃ a : Γ(X, V), kUnitVal f' = X.toK V a * kUnitVal f := by
  obtain ⟨a, ha⟩ := (X.toCartierDivisorSheaf_apply_eq_iff_ratio V f' f).1 (hf'.symm.trans hf)
  refine ⟨oUnitVal a, ?_⟩
  change kUnitVal f' = kUnitVal (X.structureUnitsToTotalQuotientUnits.hom.app (op V) a) * kUnitVal f
  rw [ha]
  change ((show (X.totalQuotientSheaf.obj.obj (op V))ˣ from f') : X.totalQuotientSheaf.obj.obj _) =
    ((show (X.totalQuotientSheaf.obj.obj (op V))ˣ from f' / f * f) :
      X.totalQuotientSheaf.obj.obj (op V))
  rw [div_mul_cancel]

/-- Every point has a neighbourhood carrying a local equation of `D`. -/
theorem exists_localEquation (D : X.CartierDivisor) (x : X) :
    ∃ (V : X.Opens) (f : X.totalQuotientUnitsSheaf.obj.obj (op V)), x ∈ V ∧
      D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f) := by
  obtain ⟨E, hE⟩ := CartierLocalEquations.exists_localEquations D
  obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (E.cover (show x ∈ (⊤ : X.Opens) from trivial))
  exact ⟨E.U i, E.f i, hi, hE i⟩

/-- A section `s` of `K_X` over `U` lies in `O_X(D)(U)` when, for every local equation `f` of
`D` on an open `V ⊆ U`, the product `s f` is regular on `V`. -/
def IsSection (D : X.CartierDivisor) {U : X.Opens} (s : X.totalQuotientSheaf.obj.obj (op U)) :
    Prop :=
  ∀ (V : X.Opens) (hVU : V ≤ U) (f : X.totalQuotientUnitsSheaf.obj.obj (op V)),
    D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f) →
      ∃ r : Γ(X, V), X.toK V r = X.totalQuotientSheaf.obj.map (homOfLE hVU).op s * kUnitVal f

theorem isSection_of_locally (D : X.CartierDivisor) {U : X.Opens}
    (s : X.totalQuotientSheaf.obj.obj (op U))
    (h : ∀ x ∈ U, ∃ (V : X.Opens) (hVU : V ≤ U) (f : X.totalQuotientUnitsSheaf.obj.obj (op V)),
      x ∈ V ∧ D.restrict V = X.toCartierDivisorSheaf.hom.app (op V) (Additive.ofMul f) ∧
      ∃ r : Γ(X, V), X.toK V r = X.totalQuotientSheaf.obj.map (homOfLE hVU).op s * kUnitVal f) :
    D.IsSection s := by
  intro W hWU f' hf'
  apply exists_toK_eq_of_locally
  intro x hxW
  obtain ⟨V, hVU, f, hxV, hf, r, hr⟩ := h x (hWU hxW)
  have h₁ : V ⊓ W ≤ V := inf_le_left
  have h₂ : V ⊓ W ≤ W := inf_le_right
  obtain ⟨a, ha⟩ := D.exists_eq_mul_of_restrict_eq (D.restrict_eq_of_le h₁ hf)
    (D.restrict_eq_of_le h₂ hf')
  refine ⟨V ⊓ W, h₂, ⟨hxV, hxW⟩, a * X.presheaf.map (homOfLE h₁).op r, ?_⟩
  rw [map_mul, map_mul, ← toK_naturality, hr, map_mul, kMap_map, kMap_map]
  change _ = _ * kUnitVal (X.totalQuotientUnitsSheaf.obj.map (homOfLE h₂).op f')
  rw [ha]
  change _ = _ * (_ * X.totalQuotientSheaf.obj.map (homOfLE h₁).op (kUnitVal f))
  ring

/-- Being a section of `O_X(D)` is a local condition. -/
theorem isSection_of_locally_isSection (D : X.CartierDivisor) {U : X.Opens}
    (s : X.totalQuotientSheaf.obj.obj (op U))
    (h : ∀ x ∈ U, ∃ (V : X.Opens) (hVU : V ≤ U), x ∈ V ∧
      D.IsSection (X.totalQuotientSheaf.obj.map (homOfLE hVU).op s)) :
    D.IsSection s := by
  apply isSection_of_locally
  intro x hx
  obtain ⟨V, hVU, hxV, hs⟩ := h x hx
  obtain ⟨W, f, hxW, hf⟩ := D.exists_localEquation x
  have h₁ : V ⊓ W ≤ V := inf_le_left
  have h₂ : V ⊓ W ≤ W := inf_le_right
  have hf' := D.restrict_eq_of_le h₂ hf
  obtain ⟨r, hr⟩ := hs (V ⊓ W) h₁ _ hf'
  refine ⟨V ⊓ W, h₁.trans hVU, _, ⟨hxV, hxW⟩, hf', r, ?_⟩
  rw [hr, kMap_map]

/-- Sections of `O_X(D)` restrict to sections of `O_X(D)`. -/
theorem isSection_restrict (D : X.CartierDivisor) {U V : X.Opens} (h : V ≤ U)
    {s : X.totalQuotientSheaf.obj.obj (op U)} (hs : D.IsSection s) :
    D.IsSection (X.totalQuotientSheaf.obj.map (homOfLE h).op s) := by
  intro W hWV f hf
  obtain ⟨r, hr⟩ := hs W (hWV.trans h) f hf
  exact ⟨r, by rw [hr, kMap_map]⟩

/-- The sections of `O_X(D)` over `U`, as a submodule of `K_X(U)`. -/
def submoduleObj (D : X.CartierDivisor) (U : X.Opens) :
    Submodule (X.ringCatSheaf.obj.obj (op U)) (X.totalQuotientModule.val.obj (op U)) where
  carrier := {s | D.IsSection (U := U) s}
  zero_mem' := by
    intro V hVU f _
    refine ⟨0, ?_⟩
    change X.toK V 0 = X.totalQuotientSheaf.obj.map (homOfLE hVU).op
      (0 : X.totalQuotientSheaf.obj.obj (op U)) * kUnitVal f
    rw [map_zero, map_zero, zero_mul]
  add_mem' := by
    intro s t hs ht V hVU f hf
    obtain ⟨r, hr⟩ := hs V hVU f hf
    obtain ⟨r', hr'⟩ := ht V hVU f hf
    refine ⟨r + r', ?_⟩
    change X.toK V (r + r') = X.totalQuotientSheaf.obj.map (homOfLE hVU).op
      ((show X.totalQuotientSheaf.obj.obj (op U) from s) +
        (show X.totalQuotientSheaf.obj.obj (op U) from t)) * kUnitVal f
    rw [map_add, map_add, hr, hr', add_mul]
  smul_mem' := by
    intro c s hs V hVU f hf
    obtain ⟨r, hr⟩ := hs V hVU f hf
    refine ⟨X.presheaf.map (homOfLE hVU).op c * r, ?_⟩
    change _ = X.totalQuotientSheaf.obj.map (homOfLE hVU).op
      (X.toK U c * (show X.totalQuotientSheaf.obj.obj (op U) from s)) * _
    rw [map_mul, map_mul, hr, toK_naturality (X := X) hVU c, mul_assoc]

/-- The `O_X`-submodule `O_X(D)` of `K_X`, as a family of submodules of the sections of `K_X`
stable under restriction. -/
def submodule (D : X.CartierDivisor) : X.totalQuotientModule.val.Submodule where
  obj U := D.submoduleObj U.unop
  map i _ hs := D.isSection_restrict (leOfHom i.unop) hs

/-- Membership in `O_X(D)(U)`. -/
@[simp]
theorem mem_submodule_iff (D : X.CartierDivisor) (U : X.Opens)
    (s : X.totalQuotientModule.val.obj (op U)) :
    s ∈ D.submodule.obj (op U) ↔ D.IsSection (U := U) s :=
  Iff.rfl

end Scheme.CartierDivisor

namespace Scheme

variable {X : Scheme.{u}}

/-- A family of submodules of a sheaf of `O_X`-modules that is stable under restriction and
local on `X` is again a sheaf. -/
theorem isSheaf_submodule_of_local {M : X.Modules} (N : M.val.Submodule)
    (hN : ∀ (U : X.Opens) (s : M.val.obj (op U)),
      (∀ x ∈ U, ∃ (V : X.Opens) (hVU : V ≤ U), x ∈ V ∧
        M.val.map (homOfLE hVU).op s ∈ N.obj (op V)) → s ∈ N.obj (op U)) :
    Presheaf.IsSheaf (Opens.grothendieckTopology X) N.toPresheafOfModules.presheaf := by
  change TopCat.Presheaf.IsSheaf _
  rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
  intro ι U sf hsf
  let M' : TopCat.Sheaf AddCommGrpCat.{u} X := ⟨M.val.presheaf, M.isSheaf⟩
  let sf' : ∀ i, ToType (M'.obj.obj (op (U i))) := fun i ↦ (sf i).1
  have hsf' : TopCat.Presheaf.IsCompatible M'.obj U sf' := fun i j ↦
    congrArg Subtype.val (hsf i j)
  obtain ⟨s, hs, hsu⟩ := M'.existsUnique_gluing U sf' hsf'
  have hmem : s ∈ N.obj (op (iSup U)) := by
    apply hN
    intro x hx
    obtain ⟨i, hi⟩ := Opens.mem_iSup.mp hx
    refine ⟨U i, le_iSup U i, hi, ?_⟩
    have := hs i
    change M.val.map (Opens.leSupr U i).op s = (sf i).1 at this
    change M.val.map (Opens.leSupr U i).op s ∈ _
    rw [this]
    exact (sf i).2
  refine ⟨⟨s, hmem⟩, fun i ↦ Subtype.ext (hs i), fun t ht ↦ Subtype.ext (hsu t.1 fun i ↦ ?_)⟩
  exact congrArg Subtype.val (ht i)

namespace CartierDivisor

theorem isSheaf_submodule (D : X.CartierDivisor) :
    Presheaf.IsSheaf (Opens.grothendieckTopology X) D.submodule.toPresheafOfModules.presheaf :=
  isSheaf_submodule_of_local _ fun _ s h ↦ D.isSection_of_locally_isSection s h

/-- The invertible sheaf `O_X(D)` attached to a Cartier divisor `D`, as an `O_X`-module. -/
def sheaf (D : X.CartierDivisor) : X.Modules :=
  ⟨D.submodule.toPresheafOfModules, D.isSheaf_submodule⟩

/-- The embedding `O_X(D) ⟶ K_X` of `O_X`-modules. -/
def sheafι (D : X.CartierDivisor) : D.sheaf ⟶ X.totalQuotientModule :=
  ⟨D.submodule.ι⟩

instance (D : X.CartierDivisor) : Mono D.sheafι :=
  (SheafOfModules.forget _).mono_of_mono_map (inferInstanceAs (Mono D.submodule.ι))

/-- The inverse of a local equation of `D` is a section of `O_X(D)`. -/
theorem isSection_inv (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    {W : X.Opens} (h : W ≤ V₀) :
    D.IsSection (X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹)) := by
  intro W' hW' f' hf'
  obtain ⟨a, ha⟩ := D.exists_eq_mul_of_restrict_eq (D.restrict_eq_of_le (hW'.trans h) hf) hf'
  refine ⟨a, ?_⟩
  rw [ha, kMap_map]
  change _ = _ * (_ * X.totalQuotientSheaf.obj.map (homOfLE (hW'.trans h)).op (kUnitVal f))
  rw [mul_left_comm, ← map_mul, show kUnitVal f⁻¹ * kUnitVal f = 1 from Units.inv_mul _, map_one,
    mul_one]

/-- Restriction of a section of `K_X` along the identity. -/
theorem kMap_id {U : X.Opens} (s : X.totalQuotientSheaf.obj.obj (op U)) :
    X.totalQuotientSheaf.obj.map (homOfLE (le_refl U)).op s = s := by
  rw [show (homOfLE (le_refl U)).op = 𝟙 (op U) from rfl, CategoryTheory.Functor.map_id]
  rfl

/-- The local generator `f⁻¹` of `O_X(D)` over an open carrying a local equation `f`, as a
section of the restriction of `O_X(D)`. -/
def generatorSection (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f)) :
    (D.sheaf.over V₀).sections :=
  PresheafOfModules.sectionsMk
    (fun V ↦ ⟨X.totalQuotientSheaf.obj.map (homOfLE (leOfHom V.unop.hom)).op (kUnitVal f⁻¹),
      D.isSection_inv hf _⟩)
    (fun _ _ _ ↦ Subtype.ext (kMap_map (X := X) _ _ _))

/-- Multiplication by the local generator `f⁻¹`, as a morphism `O_V ⟶ O_X(D)|_V`. -/
def generatorHom (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f)) :
    SheafOfModules.unit _ ⟶ D.sheaf.over V₀ :=
  (D.sheaf.over V₀).unitHomEquiv.symm (D.generatorSection hf)

/-- The morphism `generatorHom` sends `r` to `r f⁻¹`. -/
theorem generatorHom_app_val (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f))
    (V : (Over V₀)ᵒᵖ) (r : X.ringCatSheaf.obj.obj (op V.unop.left)) :
    ((D.generatorHom hf).val.app V r).1 =
      X.toK _ r * X.totalQuotientSheaf.obj.map (homOfLE (leOfHom V.unop.hom)).op
        (kUnitVal f⁻¹) :=
  rfl

instance (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f)) :
    IsIso (D.generatorHom hf) := by
  have : IsIso (D.generatorHom hf).val := by
    have : Mono (D.generatorHom hf).val := by
      refine PresheafOfModules.mono_of_injective fun V r r' hrr' ↦ ?_
      have h : X.toK V.unop.left r * X.totalQuotientSheaf.obj.map
          (homOfLE (leOfHom V.unop.hom)).op (kUnitVal f⁻¹) =
          X.toK V.unop.left r' * X.totalQuotientSheaf.obj.map
            (homOfLE (leOfHom V.unop.hom)).op (kUnitVal f⁻¹) :=
        congrArg Subtype.val hrr'
      apply toK_injective
      have h' := congrArg (· * X.totalQuotientSheaf.obj.map
        (homOfLE (leOfHom V.unop.hom)).op (kUnitVal f)) h
      simp only [mul_assoc, ← map_mul, show kUnitVal f⁻¹ * kUnitVal f = 1 from Units.inv_mul _,
        map_one, mul_one] at h'
      exact h'
    have : Epi (D.generatorHom hf).val := by
      refine PresheafOfModules.epi_of_surjective fun V t ↦ ?_
      have hle : V.unop.left ≤ V₀ := leOfHom V.unop.hom
      obtain ⟨r, hr⟩ := t.2 V.unop.left le_rfl _ (D.restrict_eq_of_le hle hf)
      refine ⟨r, Subtype.ext ?_⟩
      have key : ∀ s : X.totalQuotientSheaf.obj.obj (op V.unop.left),
          X.toK V.unop.left r = X.totalQuotientSheaf.obj.map (homOfLE le_rfl).op s *
            kUnitVal (X.totalQuotientUnitsSheaf.obj.map (homOfLE hle).op f) →
          X.toK V.unop.left r * X.totalQuotientSheaf.obj.map (homOfLE hle).op (kUnitVal f⁻¹) =
            s := by
        intro s hs
        rw [hs, kMap_id, mul_assoc]
        change _ * (X.totalQuotientSheaf.obj.map (homOfLE hle).op (kUnitVal f) * _) = _
        rw [← map_mul, show kUnitVal f * kUnitVal f⁻¹ = 1 from Units.mul_inv _, map_one, mul_one]
      exact key t.1 hr
    exact isIso_of_mono_of_epi _
  have : IsIso ((SheafOfModules.forget _).map (D.generatorHom hf)) := this
  exact isIso_of_reflects_iso _ (SheafOfModules.forget _)

/-- On an open carrying a local equation of `D`, the restriction of `O_X(D)` is free of
rank one. -/
def overIsoFree (D : X.CartierDivisor) {V₀ : X.Opens}
    {f : X.totalQuotientUnitsSheaf.obj.obj (op V₀)}
    (hf : D.restrict V₀ = X.toCartierDivisorSheaf.hom.app (op V₀) (Additive.ofMul f)) :
    D.sheaf.over V₀ ≅ SheafOfModules.free (ULift.{u} (Fin 1)) :=
  (asIso (D.generatorHom hf)).symm ≪≫
    (coproductUniqueIso (fun _ : ULift.{u} (Fin 1) ↦ SheafOfModules.unit _)).symm

/-- **Hartshorne II.6, p.144.** The sheaf `O_X(D)` of a Cartier divisor is invertible. -/
theorem isInvertible_sheaf (D : X.CartierDivisor) : D.sheaf.IsInvertible := by
  rw [Modules.isInvertible_iff_ringed]
  intro x
  obtain ⟨V, f, hx, hf⟩ := D.exists_localEquation x
  exact ⟨V, hx, ⟨D.overIsoFree hf⟩⟩

end CartierDivisor



/-- An invertible `O_X`-submodule of `K_X`: a family of `O_X(U)`-submodules of `K_X(U)`, stable
under restriction, which forms a sheaf and is invertible as an `O_X`-module. The embedding into
`K_X` is part of the data. -/
@[ext]
structure InvertibleTotalQuotientSubmodule (X : Scheme.{u}) where
  /-- The underlying family of submodules of the sections of `K_X`. -/
  submodule : X.totalQuotientModule.val.Submodule
  isSheaf : Presheaf.IsSheaf (Opens.grothendieckTopology X)
    submodule.toPresheafOfModules.presheaf
  isInvertible : Modules.IsInvertible (X := X) ⟨submodule.toPresheafOfModules, isSheaf⟩

namespace InvertibleTotalQuotientSubmodule

/-- The underlying `O_X`-module of an invertible submodule of `K_X`. -/
def toModules (L : X.InvertibleTotalQuotientSubmodule) : X.Modules :=
  ⟨L.submodule.toPresheafOfModules, L.isSheaf⟩

/-- The embedding of an invertible submodule into `K_X`. -/
def ι (L : X.InvertibleTotalQuotientSubmodule) : L.toModules ⟶ X.totalQuotientModule :=
  ⟨L.submodule.ι⟩

instance (L : X.InvertibleTotalQuotientSubmodule) : Mono L.ι :=
  (SheafOfModules.forget _).mono_of_mono_map (inferInstanceAs (Mono L.submodule.ι))

/-- Membership in an invertible submodule of `K_X` is local. -/
theorem mem_of_locally (L : X.InvertibleTotalQuotientSubmodule) {U : X.Opens}
    (s : X.totalQuotientSheaf.obj.obj (op U))
    (h : ∀ x ∈ U, ∃ (V : X.Opens) (hVU : V ≤ U), x ∈ V ∧
      (show X.totalQuotientModule.val.obj (op V) from
        X.totalQuotientSheaf.obj.map (homOfLE hVU).op s) ∈ L.submodule.obj (op V)) :
    (show X.totalQuotientModule.val.obj (op U) from s) ∈ L.submodule.obj (op U) := by
  choose V hVU hxV hs using fun x : U ↦ h x.1 x.2
  have cover : U ≤ ⨆ x, V x := fun x hx ↦ Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxV _⟩
  let L' : TopCat.Sheaf AddCommGrpCat.{u} X := ⟨L.submodule.toPresheafOfModules.presheaf, L.isSheaf⟩
  let sf : ∀ i, ToType (L'.obj.obj (op (V i))) := fun i ↦ ⟨_, hs i⟩
  have compat : TopCat.Presheaf.IsCompatible L'.obj V sf := by
    intro i j
    apply Subtype.ext
    exact (kMap_map (X := X) _ _ s).trans (kMap_map (X := X) _ _ s).symm
  obtain ⟨t, ht, -⟩ := L'.existsUnique_gluing' V U (fun i ↦ homOfLE (hVU i)) cover sf compat
  have hts : (t.1 : X.totalQuotientSheaf.obj.obj (op U)) = s := by
    refine X.totalQuotientSheaf.eq_of_locally_eq' V U (fun i ↦ homOfLE (hVU i)) cover _ _
      fun i ↦ ?_
    exact congrArg Subtype.val (ht i)
  rw [← hts]
  exact t.2

/-- An invertible submodule of `K_X` is locally generated by a single section `g`, such that
multiplication by `g` is injective on regular functions. -/
theorem exists_generator (L : X.InvertibleTotalQuotientSubmodule) (x : X) :
    ∃ (U : X.Opens) (g : X.totalQuotientSheaf.obj.obj (op U)), x ∈ U ∧
      (∀ (V : X.Opens) (h : V ≤ U) (r : Γ(X, V)),
        (show X.totalQuotientModule.val.obj (op V) from
          X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op g) ∈
            L.submodule.obj (op V)) ∧
      (∀ (V : X.Opens) (h : V ≤ U) (t : X.totalQuotientSheaf.obj.obj (op V)),
        (show X.totalQuotientModule.val.obj (op V) from t) ∈ L.submodule.obj (op V) →
          ∃ r : Γ(X, V), X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op g = t) ∧
      (∀ (V : X.Opens) (h : V ≤ U) (r : Γ(X, V)),
        X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op g = 0 → r = 0) := by
  obtain ⟨U, hxU, ⟨e⟩⟩ := (Modules.isInvertible_iff_ringed _).1 L.isInvertible x
  let e' : L.toModules.over U ≅ SheafOfModules.unit _ :=
    e ≪≫ coproductUniqueIso (fun _ : ULift.{u} (Fin 1) ↦ SheafOfModules.unit _)
  let φ := e'.inv
  let σ := (L.toModules.over U).unitHomEquiv φ
  have hφ : φ = (L.toModules.over U).unitHomEquiv.symm σ := (Equiv.symm_apply_apply _ _).symm
  let top : (Over U)ᵒᵖ := op (Over.mk (𝟙 U))
  let g : X.totalQuotientSheaf.obj.obj (op U) := (σ.val top).1
  have happ : ∀ (V : X.Opens) (h : V ≤ U) (r : Γ(X, V)),
      (φ.val.app (op (Over.mk (homOfLE h))) r).1 =
        X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op g := by
    intro V h r
    rw [hφ]
    have hσ := σ.2 (Over.homMk (homOfLE h) : Over.mk (homOfLE h) ⟶ Over.mk (𝟙 U)).op
    change X.toK V r * (show X.totalQuotientSheaf.obj.obj (op V) from
      (σ.val (op (Over.mk (homOfLE h)))).1) = _
    rw [← hσ]
    rfl
  have hiso : ∀ (V : X.Opens) (h : V ≤ U),
      Function.Bijective (φ.val.app (op (Over.mk (homOfLE h)))) := by
    intro V h
    have : IsIso φ.val := (inferInstance : IsIso ((SheafOfModules.forget _).map φ))
    have : IsIso (φ.val.app (op (Over.mk (homOfLE h)))) :=
      inferInstanceAs (IsIso ((PresheafOfModules.evaluation _ _).map φ.val))
    exact ConcreteCategory.bijective_of_isIso _
  refine ⟨U, g, hxU, fun V h r ↦ ?_, fun V h t ht ↦ ?_, fun V h r hr ↦ ?_⟩
  · rw [← happ]
    exact (φ.val.app (op (Over.mk (homOfLE h))) r).2
  · obtain ⟨r, hr⟩ := (hiso V h).2 ⟨t, ht⟩
    exact ⟨r, (happ V h r).symm.trans (congrArg Subtype.val hr)⟩
  · apply (hiso V h).1
    refine Eq.trans ?_ (map_zero _).symm
    exact Subtype.ext ((happ V h r).trans hr)

end InvertibleTotalQuotientSubmodule

namespace CartierDivisor

/-- The invertible `O_X`-submodule `O_X(D)` of `K_X` attached to a Cartier divisor `D`, locally
generated by the inverses of local equations of `D`. -/
def toInvertibleSubmodule (D : X.CartierDivisor) : X.InvertibleTotalQuotientSubmodule :=
  ⟨D.submodule, D.isSheaf_submodule, D.isInvertible_sheaf⟩

/-- If local equations `f` of `D` and `f'` of `D'` on `W` satisfy `f'/f` and `f/f'` regular,
then `D` and `D'` agree on `W`. -/
theorem restrict_eq_of_ratio {D D' : X.CartierDivisor} {W : X.Opens}
    {f f' : X.totalQuotientUnitsSheaf.obj.obj (op W)}
    (hf : D.restrict W = X.toCartierDivisorSheaf.hom.app (op W) (Additive.ofMul f))
    (hf' : D'.restrict W = X.toCartierDivisorSheaf.hom.app (op W) (Additive.ofMul f'))
    {a b : Γ(X, W)} (ha : X.toK W a = kUnitVal f⁻¹ * kUnitVal f')
    (hb : X.toK W b = kUnitVal f'⁻¹ * kUnitVal f) : D.restrict W = D'.restrict W := by
  have hab : a * b = 1 := by
    apply toK_injective
    rw [map_mul, ha, hb, map_one]
    calc kUnitVal f⁻¹ * kUnitVal f' * (kUnitVal f'⁻¹ * kUnitVal f) =
        (kUnitVal f' * kUnitVal f'⁻¹) * (kUnitVal f⁻¹ * kUnitVal f) := by ring
      _ = 1 := by
        rw [show kUnitVal f' * kUnitVal f'⁻¹ = 1 from Units.mul_inv _,
          show kUnitVal f⁻¹ * kUnitVal f = 1 from Units.inv_mul _, one_mul]
  rw [hf, hf']
  refine (X.toCartierDivisorSheaf_apply_eq_iff_ratio W f f').2
    ⟨(show Γ(X, W)ˣ from ⟨b, a, by rw [mul_comm, hab], hab⟩), Units.ext ?_⟩
  change X.toK W b = kUnitVal f * kUnitVal f'⁻¹
  rw [hb, mul_comm]

/-- Divisors with the same submodule of `K_X` have the same sections. -/
theorem isSection_of_submodule_eq {D D' : X.CartierDivisor} (h : D.submodule = D'.submodule)
    {U : X.Opens} {s : X.totalQuotientSheaf.obj.obj (op U)} (hs : D.IsSection s) :
    D'.IsSection s := by
  have : (show X.totalQuotientModule.val.obj (op U) from s) ∈ D'.submodule.obj (op U) := by
    rw [← h]
    exact hs
  exact this

/-- **Hartshorne II.6, Proposition 6.13(a), injectivity.** A Cartier divisor is determined by
its invertible submodule `O_X(D)` of `K_X`. -/
theorem toInvertibleSubmodule_injective :
    Function.Injective (toInvertibleSubmodule (X := X)) := by
  intro D D' hDD'
  have hsub : D.submodule = D'.submodule :=
    congrArg InvertibleTotalQuotientSubmodule.submodule hDD'
  have hloc : ∀ x : X, ∃ W : X.Opens, x ∈ W ∧ D.restrict W = D'.restrict W := by
    intro x
    obtain ⟨V₁, f₁, hx₁, hf₁⟩ := D.exists_localEquation x
    obtain ⟨V₂, f₂, hx₂, hf₂⟩ := D'.exists_localEquation x
    have h₁ : V₁ ⊓ V₂ ≤ V₁ := inf_le_left
    have h₂ : V₁ ⊓ V₂ ≤ V₂ := inf_le_right
    have hf := D.restrict_eq_of_le h₁ hf₁
    have hf' := D'.restrict_eq_of_le h₂ hf₂
    obtain ⟨a, ha⟩ := isSection_of_submodule_eq hsub (D.isSection_inv hf₁ h₁) _ le_rfl _ hf'
    obtain ⟨b, hb⟩ := isSection_of_submodule_eq hsub.symm (D'.isSection_inv hf₂ h₂) _ le_rfl _ hf
    refine ⟨V₁ ⊓ V₂, ⟨hx₁, hx₂⟩, restrict_eq_of_ratio hf hf' (a := a) (b := b) ?_ ?_⟩
    · rw [ha, kMap_id]
      rfl
    · rw [hb, kMap_id]
      rfl
  choose W hxW hW using hloc
  exact X.cartierDivisorSheaf.eq_of_locally_eq' W ⊤ (fun _ ↦ homOfLE le_top)
    (fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxW x⟩) D D' hW

/-- **Hartshorne II.6, Proposition 6.13(a), surjectivity.** Every invertible submodule of `K_X`
is `O_X(D)` for some Cartier divisor `D`. -/
theorem toInvertibleSubmodule_surjective :
    Function.Surjective (toInvertibleSubmodule (X := X)) := by
  intro L
  have hgen : ∀ x : X, ∃ (W : X.Opens) (f : X.totalQuotientUnitsSheaf.obj.obj (op W)), x ∈ W ∧
      (∀ (V : X.Opens) (h : V ≤ W) (r : Γ(X, V)),
        (show X.totalQuotientModule.val.obj (op V) from
          X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹)) ∈
            L.submodule.obj (op V)) ∧
      (∀ (V : X.Opens) (h : V ≤ W) (t : X.totalQuotientSheaf.obj.obj (op V)),
        (show X.totalQuotientModule.val.obj (op V) from t) ∈ L.submodule.obj (op V) →
          ∃ r : Γ(X, V),
            X.toK V r * X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal f⁻¹) = t) := by
    intro x
    obtain ⟨U, g, hxU, hmem, hgen, hinj⟩ := L.exists_generator x
    obtain ⟨W, hWU, hxW, hunit⟩ := exists_isUnit_of_mul_injective g hinj hxU
    let f : X.totalQuotientUnitsSheaf.obj.obj (op W) :=
      (show (X.totalQuotientSheaf.obj.obj (op W))ˣ from hunit.unit⁻¹)
    have hfinv : kUnitVal f⁻¹ = X.totalQuotientSheaf.obj.map (homOfLE hWU).op g := by
      change (((hunit.unit⁻¹)⁻¹ : (X.totalQuotientSheaf.obj.obj (op W))ˣ) :
        X.totalQuotientSheaf.obj.obj (op W)) = _
      rw [inv_inv]
      rfl
    refine ⟨W, f, hxW, fun V h r ↦ ?_, fun V h t ht ↦ ?_⟩
    · rw [hfinv, kMap_map]
      exact hmem V (h.trans hWU) r
    · rw [hfinv, kMap_map]
      exact hgen V (h.trans hWU) t ht
  choose W f hxW hmem hgen using hgen
  have hmem₁ : ∀ (x : X) (V : X.Opens) (h : V ≤ W x),
      (show X.totalQuotientModule.val.obj (op V) from
        X.totalQuotientSheaf.obj.map (homOfLE h).op (kUnitVal (f x)⁻¹)) ∈
          L.submodule.obj (op V) := by
    intro x V h
    have := hmem x V h 1
    rwa [map_one, one_mul] at this
  have htrans : ∀ i j, ∃ a : X.structureUnitsSheaf.obj.obj (op (W i ⊓ W j)),
      X.structureUnitsToTotalQuotientUnits.hom.app (op (W i ⊓ W j)) a =
        X.totalQuotientUnitsSheaf.obj.map (Opens.infLELeft (W i) (W j)).op (f i) /
          X.totalQuotientUnitsSheaf.obj.map (Opens.infLERight (W i) (W j)).op (f j) := by
    intro i j
    have hi : W i ⊓ W j ≤ W i := inf_le_left
    have hj : W i ⊓ W j ≤ W j := inf_le_right
    obtain ⟨u, hu⟩ := hgen i _ hi _ (hmem₁ j _ hj)
    obtain ⟨v, hv⟩ := hgen j _ hj _ (hmem₁ i _ hi)
    set gi := X.totalQuotientSheaf.obj.map (homOfLE hi).op (kUnitVal (f i)⁻¹)
    set gj := X.totalQuotientSheaf.obj.map (homOfLE hj).op (kUnitVal (f j)⁻¹)
    set fi := X.totalQuotientSheaf.obj.map (homOfLE hi).op (kUnitVal (f i))
    set fj := X.totalQuotientSheaf.obj.map (homOfLE hj).op (kUnitVal (f j))
    have hgfi : gi * fi = 1 := by
      rw [← map_mul, show kUnitVal (f i)⁻¹ * kUnitVal (f i) = 1 from Units.inv_mul _, map_one]
    have hgfj : gj * fj = 1 := by
      rw [← map_mul, show kUnitVal (f j)⁻¹ * kUnitVal (f j) = 1 from Units.inv_mul _, map_one]
    have hvu : v * u = 1 := by
      apply toK_injective
      have : X.toK _ (v * u) * gi * fi = X.toK _ 1 * gi * fi := by
        rw [map_mul, map_one, mul_assoc (X.toK _ v), hu, hv, one_mul]
      rwa [mul_assoc, hgfi, mul_one, mul_assoc, hgfi, mul_one] at this
    refine ⟨(show Γ(X, W i ⊓ W j)ˣ from ⟨u, v, by rw [mul_comm, hvu], hvu⟩), Units.ext ?_⟩
    change X.toK _ u = fi * X.totalQuotientSheaf.obj.map (homOfLE hj).op (kUnitVal (f j)⁻¹)
    calc X.toK _ u = X.toK _ u * (gi * fi) := by rw [hgfi, mul_one]
      _ = fi * gj := by rw [← mul_assoc, hu, mul_comm]
  let E : X.CartierLocalEquations X :=
    { U := W
      cover := fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxW x⟩
      f := f
      transition := htrans }
  obtain ⟨D, hD, -⟩ := E.existsUnique_represents
  refine ⟨D, InvertibleTotalQuotientSubmodule.ext (PresheafOfModules.Submodule.ext fun U ↦ ?_)⟩
  obtain ⟨U⟩ := U
  ext s
  change D.IsSection (U := U) s ↔ _
  constructor
  · intro hs
    apply L.mem_of_locally s
    intro x hx
    refine ⟨W x ⊓ U, inf_le_right, ⟨hxW x, hx⟩, ?_⟩
    obtain ⟨r, hr⟩ := hs (W x ⊓ U) inf_le_right _ (D.restrict_eq_of_le inf_le_left (hD x))
    have key : X.totalQuotientSheaf.obj.map (homOfLE inf_le_right).op
        (show X.totalQuotientSheaf.obj.obj (op U) from s) =
        X.toK _ r * X.totalQuotientSheaf.obj.map (homOfLE inf_le_left).op
          (kUnitVal (f x)⁻¹) := by
      rw [hr, mul_assoc]
      change _ = _ * (X.totalQuotientSheaf.obj.map (homOfLE inf_le_left).op (kUnitVal (f x)) * _)
      rw [← map_mul, show kUnitVal (f x) * kUnitVal (f x)⁻¹ = 1 from Units.mul_inv _, map_one,
        mul_one]
    rw [key]
    exact hmem x _ inf_le_left r
  · intro hs
    apply D.isSection_of_locally s
    intro x hx
    refine ⟨W x ⊓ U, inf_le_right, _, ⟨hxW x, hx⟩, D.restrict_eq_of_le inf_le_left (hD x), ?_⟩
    obtain ⟨r, hr⟩ := hgen x (W x ⊓ U) inf_le_left _
      (L.submodule.map_mem (homOfLE (inf_le_right : W x ⊓ U ≤ U)).op hs)
    have hr' : X.toK _ r * X.totalQuotientSheaf.obj.map (homOfLE inf_le_left).op
        (kUnitVal (f x)⁻¹) = X.totalQuotientSheaf.obj.map (homOfLE inf_le_right).op
          (show X.totalQuotientSheaf.obj.obj (op U) from s) := hr
    refine ⟨r, ?_⟩
    rw [← hr', mul_assoc]
    change _ = _ * (_ * X.totalQuotientSheaf.obj.map (homOfLE inf_le_left).op (kUnitVal (f x)))
    rw [← map_mul, show kUnitVal (f x)⁻¹ * kUnitVal (f x) = 1 from Units.inv_mul _, map_one,
      mul_one]

/-- **Hartshorne II.6, Proposition 6.13(a).** The assignment `D ↦ O_X(D)` is a bijection between
Cartier divisors on `X` and invertible `O_X`-submodules of `K_X`. -/
theorem toInvertibleSubmodule_bijective :
    Function.Bijective (toInvertibleSubmodule (X := X)) :=
  ⟨toInvertibleSubmodule_injective, toInvertibleSubmodule_surjective⟩

end CartierDivisor

/-- **Hartshorne II.6, Proposition 6.13(a).** Cartier divisors on `X` correspond bijectively to
invertible `O_X`-submodules of `K_X`, via `D ↦ O_X(D)`. -/
def cartierDivisorEquivInvertibleSubmodule (X : Scheme.{u}) :
    X.CartierDivisor ≃ X.InvertibleTotalQuotientSubmodule :=
  Equiv.ofBijective _ CartierDivisor.toInvertibleSubmodule_bijective

/-- The bijection of Proposition 6.13(a) sends `D` to `O_X(D)`. -/
@[simp]
theorem cartierDivisorEquivInvertibleSubmodule_apply (D : X.CartierDivisor) :
    X.cartierDivisorEquivInvertibleSubmodule D = D.toInvertibleSubmodule :=
  rfl

end Scheme

end

end AlgebraicGeometry
