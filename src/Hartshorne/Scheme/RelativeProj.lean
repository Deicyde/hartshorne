import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
import Mathlib.AlgebraicGeometry.Sites.SmallAffineZariski
import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
import Mathlib.AlgebraicGeometry.Noetherian

/-!
# Relative Proj

Hartshorne, *Algebraic Geometry*, II.7, pp. 160–161 (see also Stacks Project, tags 01NM and
01NS).

Let `X` be a Noetherian scheme and `S` a quasi-coherent sheaf of `ℕ`-graded `𝒪_X`-algebras with
`S₀ = 𝒪_X`, `S₁` coherent, and `S` locally generated by `S₁` as an `S₀`-algebra. Then
`Proj_X S` is obtained by gluing the schemes `Proj Γ(U, S)` over the affine opens `U ⊆ X`; it comes
with a projection `Proj_X S ⟶ X` whose restriction over every affine open `U` is canonically
`Proj Γ(U, S) ⟶ U`.

## Encoding of quasi-coherent graded algebras

Neither Mathlib nor the project has sheaves of graded algebras. Following Mathlib's treatment of
quasi-coherent `𝒪_X`-algebras on the small affine Zariski site (`X.AffineZariskiSite`, whose arrows
are the basic open inclusions `D(r) ⊆ U`; see
`Mathlib/AlgebraicGeometry/Sites/SmallAffineZariski.lean`), a quasi-coherent graded
`𝒪_X`-algebra (`QuasiCoherentGradedAlgebra`) is recorded by

* the rings of sections `S(U)` over affine opens with restriction maps along basic opens,
* the `𝒪_X`-algebra structure `Γ(U, 𝒪_X) → S(U)`, landing in degree zero,
* the quasi-coherence condition `S(D(r)) = S(U)_r` (`NatTrans.Coequifibered`; equivalently,
  restriction to `D(r)` is the localization at `r`, cf. condition 3 of the affine-local criterion
  for quasi-coherence), and
* a grading `S(U) = ⊕ₙ S(U)ₙ` preserved by restriction.

The hypotheses `S₀ = 𝒪_X`, `S₁` coherent (on a Noetherian scheme: `S₁(U)` is a finitely
generated `Γ(U, 𝒪_X)`-module for every affine `U`) and generation by `S₁` are the predicates
`DegreeZeroIsStructureSheaf`, `DegreeOneCoherent` and `GeneratedInDegreeOne`, bundled together
with the Noetherian hypothesis in `RelativeProjData`.

## Main construction

* `isPullback_projMap`: the compatibility of affine `Proj` with localization on the base: if
  `R' = R[1/r]` and `B = A[1/r]` for a graded `R`-algebra `A`, then
  `Proj B = Proj A ×_{Spec R} Spec R'`. Proved via `isOpenImmersion_projMap` and
  `range_projMap` (`Proj A[1/s] ⟶ Proj A` is an open immersion onto `D₊(s)` for `s` of degree 0).
* `QuasiCoherentGradedAlgebra.relativeGluingData`: the schemes `Proj S(U) ⟶ U` form a relative
  gluing datum over the affine opens of `X` (Mathlib's `Scheme.Cover.RelativeGluingData`).
* `QuasiCoherentGradedAlgebra.relProj`, `relProjToBase`: the glued scheme and its projection.
* `QuasiCoherentGradedAlgebra.isPullback_projι`, `restrictIso`, `restrictIso_hom_projToOpen`:
  over every affine open `U`, `(Proj_X S)|_U ≅ Proj S(U)` compatibly with the maps to `U`.
* `RelativeProjData.relativeProj`, `projection`, `restrictIso`, `restrictIso_hom_projToOpen`:
  the same in Hartshorne's setting. The gluing itself uses none of the extra hypotheses: the
  construction `QuasiCoherentGradedAlgebra.relProj` works for every quasi-coherent graded
  `𝒪_X`-algebra.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits
open HomogeneousIdeal HomogeneousLocalization TopologicalSpace
open AlgebraicGeometry Graded

universe u

namespace Hartshorne

section Algebra

variable {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]

/-- The inverse of a degree-zero unit of an `ℕ`-graded ring can be taken in degree zero. -/
theorem exists_mem_zero_mul_eq_one_of_isUnit {b : B} (hb : b ∈ ℬ 0) (hu : IsUnit b) :
    ∃ v ∈ ℬ 0, b * v = 1 := by
  classical
  obtain ⟨w, hw⟩ := hu.exists_right_inv
  refine ⟨DirectSum.decompose ℬ w 0, (DirectSum.decompose ℬ w 0).2, ?_⟩
  rw [← DirectSum.coe_decompose_mul_of_left_mem_zero ℬ hb, hw,
    DirectSum.decompose_of_mem_same ℬ SetLike.GradedOne.one_mem]

variable (φ : 𝒜 →+*ᵍ ℬ)

omit [GradedRing ℬ] in
theorem val_fromZeroRingHom (x : Submonoid A) (a : 𝒜 0) :
    (fromZeroRingHom 𝒜 x a).val = Localization.mk (a : A) 1 :=
  rfl

theorem away_map_fromZeroRingHom (t : A) (a : 𝒜 0) :
    Away.map φ t (fromZeroRingHom 𝒜 _ a) =
      fromZeroRingHom ℬ _ ⟨φ a, map_mem φ a.2⟩ := by
  ext
  change (HomogeneousLocalization.map φ _ (HomogeneousLocalization.mk _)).val =
    (HomogeneousLocalization.mk _).val
  rw [HomogeneousLocalization.map_mk]
  simp

variable {s : A} (hs : s ∈ 𝒜 0) [Algebra A B] [IsLocalization.Away s B]
  (hφ : ∀ a, φ a = algebraMap A B a)


include hs hφ in
/-- If `B = A[1/s]` with `s` of degree zero, every homogeneous element of `B` of degree `n`
is the image of a homogeneous element of degree `n` divided by a power of `s`. -/
theorem exists_mem_mul_pow_eq_of_isLocalizationAway {n : ℕ} {b : B} (hb : b ∈ ℬ n) :
    ∃ a ∈ 𝒜 n, ∃ k : ℕ, b * φ s ^ k = φ a := by
  classical
  obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, h⟩ := IsLocalization.surj (Submonoid.powers s) b
  refine ⟨DirectSum.decompose 𝒜 a n, (DirectSum.decompose 𝒜 a n).2, k, ?_⟩
  simp only at h
  have h0 : algebraMap A B (s ^ k) ∈ ℬ 0 := by
    rw [← hφ]; exact map_mem φ (SetLike.pow_mem_graded k hs)
  rw [GradedRingHom.map_directSumDecompose, hφ a, ← h,
    DirectSum.coe_decompose_mul_of_right_mem_zero ℬ h0,
    DirectSum.decompose_of_mem_same ℬ hb, hφ s, map_pow]

include hs hφ in
theorem irrelevant_le_map_of_isLocalizationAway : ℬ₊ ≤ 𝒜₊.map φ := by
  rw [← toIdeal_le_toIdeal_iff, HomogeneousIdeal.toIdeal_irrelevant_le]
  intro i hi b hb
  obtain ⟨a, ha, k, h⟩ := exists_mem_mul_pow_eq_of_isLocalizationAway φ hs hφ hb
  obtain ⟨v, -, hv⟩ := exists_mem_zero_mul_eq_one_of_isUnit (map_mem φ hs)
    (by rw [hφ s]; exact IsLocalization.Away.algebraMap_isUnit s)
  have : b = φ a * v ^ k := by
    rw [← h, mul_assoc, ← mul_pow, hv, one_pow, mul_one]
  rw [this]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (mem_irrelevant_of_mem 𝒜 hi ha))

include hs hφ in
/-- If `B = A[1/s]` with `s` of degree zero and the localization map `φ` is graded, then
`B₊ = A₊ B`. -/
theorem irrelevant_eq_map_of_isLocalizationAway : ℬ₊ = 𝒜₊.map φ :=
  le_antisymm (irrelevant_le_map_of_isLocalizationAway φ hs hφ)
    (HomogeneousIdeal.map_le_of_le_comap _ <| (HomogeneousIdeal.irrelevant_le 𝒜).2
      fun _ hi _ ha => mem_irrelevant_of_mem ℬ hi (map_mem φ ha))

include hφ in
/-- If `B = A[1/s]` with `s` of degree zero and `t` is homogeneous, then
`B_(t) = A_(t)[1/s]`. -/
theorem away_map_isLocalization {d : ℕ} {t : A} (ht : t ∈ 𝒜 d) :
    letI := (Away.map φ t).toAlgebra
    IsLocalization.Away (fromZeroRingHom 𝒜 (Submonoid.powers t) ⟨s, hs⟩) (Away ℬ (φ t)) := by
  let := (Away.map φ t).toAlgebra
  obtain ⟨v, hv0, hv⟩ := exists_mem_zero_mul_eq_one_of_isUnit (map_mem φ hs)
    (by rw [hφ s]; exact IsLocalization.Away.algebraMap_isUnit s)
  constructor; constructor
  · rintro ⟨_, n, rfl⟩
    rw [map_pow, RingHom.algebraMap_toAlgebra, away_map_fromZeroRingHom]
    refine (isUnit_iff_exists_inv.mpr ⟨fromZeroRingHom ℬ _ ⟨v, hv0⟩, ?_⟩).pow _
    rw [← map_mul]
    convert! map_one (fromZeroRingHom ℬ (Submonoid.powers (φ t)))
    exact Subtype.ext hv
  · intro z
    obtain ⟨n, b, hb, rfl⟩ := Away.mk_surjective ℬ (map_mem φ ht) z
    obtain ⟨a, ha, k, h⟩ := exists_mem_mul_pow_eq_of_isLocalizationAway φ hs hφ hb
    refine ⟨⟨Away.mk 𝒜 ht n a ha, ⟨_, k, rfl⟩⟩, ?_⟩
    ext
    simp only [map_pow, RingHom.algebraMap_toAlgebra, away_map_fromZeroRingHom, Away.map_mk,
      val_mul, val_pow, Away.val_mk, val_fromZeroRingHom, Localization.mk_pow,
      Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp [← h]⟩
  · intro x y e
    obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 ht x
    obtain ⟨m, a', ha', rfl⟩ := Away.mk_surjective 𝒜 ht y
    replace e := congr_arg val e
    simp only [RingHom.algebraMap_toAlgebra, Away.map_mk, Away.val_mk,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists] at e
    obtain ⟨⟨_, k, rfl⟩, hc⟩ := e
    simp only [← map_pow, ← map_mul, hφ] at hc
    obtain ⟨⟨_, j, rfl⟩, hj⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers s) hc
    refine ⟨⟨_, j, rfl⟩, ?_⟩
    ext
    simp only [val_mul, val_pow, Away.val_mk, val_fromZeroRingHom, Localization.mk_pow,
      Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨⟨_, k, rfl⟩, ?_⟩
    simp only [one_pow, one_mul]
    linear_combination hj

end Algebra

section Geometry

variable {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
  (φ : 𝒜 →+*ᵍ ℬ)

/-- The standard chart of `Proj 𝒜` at `t` pulls back along `Proj.map φ` to the standard chart
of `Proj ℬ` at `φ t`. -/
theorem isPullback_awayι_projMap (hf : ℬ₊ ≤ 𝒜₊.map φ) {d : ℕ} (hd : 0 < d) {t : A}
    (ht : t ∈ 𝒜 d) :
    IsPullback (Spec.map (CommRingCat.ofHom (Away.map φ t)))
      (Proj.awayι ℬ (φ t) (map_mem φ ht) hd) (Proj.awayι 𝒜 t ht hd) (Proj.map φ hf) :=
  IsOpenImmersion.isPullback _ _ _ _ (Proj.awayι_comp_map φ hf hd t ht) (by
    rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen])


omit [GradedRing ℬ] in
/-- On the standard chart `Spec A_(t)` of `Proj 𝒜`, the basic open of a degree-zero element
`s` is the basic open of `s / 1`. -/
theorem awayι_preimage_basicOpen_zero {d : ℕ} (hd : 0 < d) {t : A} (ht : t ∈ 𝒜 d) (s : 𝒜 0) :
    Proj.awayι 𝒜 t ht hd ⁻¹ᵁ Proj.basicOpen 𝒜 (s : A) =
      PrimeSpectrum.basicOpen (fromZeroRingHom 𝒜 (Submonoid.powers t) s) := by
  have hst : (s : A) * t ∈ 𝒜 d := by simpa using SetLike.mul_mem_graded s.2 ht
  have htop : Proj.awayι 𝒜 t ht hd ⁻¹ᵁ Proj.basicOpen 𝒜 t = ⊤ := by
    rw [← Proj.opensRange_awayι 𝒜 t ht hd, Scheme.Hom.preimage_opensRange]
  have helem : Away.isLocalizationElem ht hst = fromZeroRingHom 𝒜 (Submonoid.powers t) s ^ d := by
    ext
    simp only [Away.val_mk, val_pow, val_fromZeroRingHom, Localization.mk_pow]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp; ring⟩
  rw [← inf_top_eq (Proj.awayι 𝒜 t ht hd ⁻¹ᵁ Proj.basicOpen 𝒜 (s : A)), ← htop,
    ← Scheme.Hom.preimage_inf, ← Proj.basicOpen_mul, Proj.awayι_preimage_basicOpen 𝒜 ht hd hst hd,
    helem, PrimeSpectrum.basicOpen_pow _ _ hd]

omit [GradedRing ℬ] in
/-- The preimage of the basic open `D(s)` of `Spec 𝒜₀` in `Proj 𝒜` is `D₊(s)`. -/
theorem toSpecZero_preimage_basicOpen (s : 𝒜 0) :
    Proj.toSpecZero 𝒜 ⁻¹ᵁ PrimeSpectrum.basicOpen s = Proj.basicOpen 𝒜 (s : A) := by
  ext x
  obtain ⟨d, t, ht, q, rfl⟩ : ∃ (d : ℕ+) (t : A) (ht : t ∈ 𝒜 d),
      x ∈ Set.range (Proj.awayι 𝒜 t ht d.pos) :=
    ⟨_, _, _, (Proj.affineOpenCover 𝒜).covers x⟩
  have hd : 0 < (d : ℕ) := d.pos
  have e1 : Proj.toSpecZero 𝒜 (Proj.awayι 𝒜 t ht hd q) =
      Spec.map (CommRingCat.ofHom (fromZeroRingHom 𝒜 (Submonoid.powers t))) q := by
    rw [← Scheme.Hom.comp_apply, Proj.awayι_toSpecZero]
  change Proj.toSpecZero 𝒜 (Proj.awayι 𝒜 t ht hd q) ∈ PrimeSpectrum.basicOpen s ↔
    q ∈ Proj.awayι 𝒜 t ht hd ⁻¹ᵁ Proj.basicOpen 𝒜 (s : A)
  rw [e1, awayι_preimage_basicOpen_zero hd ht s]
  rfl

/-- `Proj.map` commutes with the structure maps to the spectra of the degree-zero parts. -/
theorem projMap_toSpecZero (hf : ℬ₊ ≤ 𝒜₊.map φ) :
    Proj.map φ hf ≫ Proj.toSpecZero 𝒜 =
      Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom (GradedRingHom.gradedZeroRingHom φ)) := by
  refine (Proj.mapAffineOpenCover φ hf).openCover.hom_ext _ _ fun i ↦ ?_
  obtain ⟨⟨d, hd⟩, t, ht⟩ := i
  replace ht : t ∈ 𝒜 d := ht
  change Proj.awayι ℬ (φ t) (map_mem φ ht) hd ≫ _ = Proj.awayι ℬ (φ t) (map_mem φ ht) hd ≫ _
  rw [Proj.awayι_comp_map_assoc φ hf hd t ht, Proj.awayι_toSpecZero,
    Proj.awayι_toSpecZero_assoc, ← Spec.map_comp, ← Spec.map_comp]
  congr 1
  ext a : 2
  simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
  exact away_map_fromZeroRingHom φ t a

variable {s : A} (hs : s ∈ 𝒜 0) [Algebra A B] [IsLocalization.Away s B]
  (hφ : ∀ a, φ a = algebraMap A B a)

include hs hφ in
theorem isOpenImmersion_projMap (hf : ℬ₊ ≤ 𝒜₊.map φ) : IsOpenImmersion (Proj.map φ hf) := by
  refine IsZariskiLocalAtTarget.of_openCover (Proj.affineOpenCover 𝒜).openCover fun i ↦ ?_
  have hsq := (isPullback_awayι_projMap φ hf i.1.2 i.2.2).flip
  let := (Away.map φ (i.2 : A)).toAlgebra
  have := away_map_isLocalization φ hs hφ i.2.2
  have : IsOpenImmersion (Spec.map (CommRingCat.ofHom (Away.map φ (i.2 : A)))) :=
    IsOpenImmersion.of_isLocalization (fromZeroRingHom 𝒜 (Submonoid.powers (i.2 : A)) ⟨s, hs⟩)
  have e : (Proj.affineOpenCover 𝒜).openCover.pullbackHom (Proj.map φ hf) i =
      hsq.isoPullback.inv ≫ Spec.map (CommRingCat.ofHom (Away.map φ (i.2 : A))) := by
    simp only [Scheme.Cover.pullbackHom, IsPullback.isoPullback_inv_snd]
    rfl
  rw [e]
  exact IsOpenImmersion.comp hsq.isoPullback.inv
    (Spec.map (CommRingCat.ofHom (Away.map φ (i.2 : A))))

include hs hφ in
/-- If `B = A[1/s]` with `s` of degree zero, then `Proj B ⟶ Proj A` has image `D₊(s)`. -/
theorem range_projMap (hf : ℬ₊ ≤ 𝒜₊.map φ) :
    Set.range (Proj.map φ hf) = Proj.basicOpen 𝒜 s := by
  apply le_antisymm
  · rintro _ ⟨y, rfl⟩
    change y ∈ Proj.map φ hf ⁻¹ᵁ Proj.basicOpen 𝒜 s
    rw [Proj.map_preimage_basicOpen, Proj.mem_basicOpen]
    intro h
    exact y.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h
      (by rw [hφ s]; exact IsLocalization.Away.algebraMap_isUnit s))
  · intro x hx
    obtain ⟨d, t, ht, q, rfl⟩ : ∃ (d : ℕ+) (t : A) (ht : t ∈ 𝒜 d),
        x ∈ Set.range (Proj.awayι 𝒜 t ht d.pos) :=
      ⟨_, _, _, (Proj.affineOpenCover 𝒜).covers x⟩
    have hd : 0 < (d : ℕ) := d.pos
    change q ∈ Proj.awayι 𝒜 t ht hd ⁻¹ᵁ Proj.basicOpen 𝒜 ((⟨s, hs⟩ : 𝒜 0) : A) at hx
    rw [awayι_preimage_basicOpen_zero hd ht] at hx
    let := (Away.map φ t).toAlgebra
    have := away_map_isLocalization φ hs hφ ht
    have hr := PrimeSpectrum.localization_away_comap_range (Away ℬ (φ t))
      (fromZeroRingHom 𝒜 (Submonoid.powers t) ⟨s, hs⟩)
    obtain ⟨q', hq'⟩ : q ∈ Set.range (Spec.map (CommRingCat.ofHom (Away.map φ t))) := by
      have hx' : q ∈ Set.range (PrimeSpectrum.comap (algebraMap (Away 𝒜 t) (Away ℬ (φ t)))) := by
        rw [hr]; exact hx
      exact hx'
    refine ⟨Proj.awayι ℬ (φ t) (map_mem φ ht) hd q', ?_⟩
    rw [← Scheme.Hom.comp_apply, Proj.awayι_comp_map φ hf hd t ht, Scheme.Hom.comp_apply, hq']

end Geometry

section Pullback

variable {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
  (φ : 𝒜 →+*ᵍ ℬ)

omit [GradedRing ℬ] in
theorem toSpecZero_comp_preimage_basicOpen {R : CommRingCat.{u}} (α : R ⟶ CommRingCat.of (𝒜 0))
    (r : R) :
    (Proj.toSpecZero 𝒜 ≫ Spec.map α) ⁻¹ᵁ PrimeSpectrum.basicOpen r =
      Proj.basicOpen 𝒜 ((α r : 𝒜 0) : A) := by
  ext x
  exact SetLike.ext_iff.mp (toSpecZero_preimage_basicOpen (α r)) x

/-- **Compatibility of affine Proj with localization on the base.** Let `A` be a graded ring over
`R` (via `R → A₀`), let `R' = R[1/r]`, and let `B` be a graded ring over `R'` with a graded map
`A → B` identifying `B` with `A[1/r]`. Then `Proj B ≅ Proj A ×_{Spec R} Spec R'`; more
precisely the square formed by `Proj B ⟶ Proj A` and the structure maps is a pullback. -/
theorem isPullback_projMap [Algebra A B] (hφ : ∀ a, φ a = algebraMap A B a)
    {R R' : CommRingCat.{u}} (ρ : R ⟶ R') (r : R)
    (hρ : letI := ρ.hom.toAlgebra; IsLocalization.Away r R')
    (α : R ⟶ CommRingCat.of (𝒜 0)) (α' : R' ⟶ CommRingCat.of (ℬ 0))
    (hα : α ≫ CommRingCat.ofHom (GradedRingHom.gradedZeroRingHom φ) = ρ ≫ α')
    [IsLocalization.Away ((α r : 𝒜 0) : A) B] (hf : ℬ₊ ≤ 𝒜₊.map φ) :
    IsPullback (Proj.map φ hf) (Proj.toSpecZero ℬ ≫ Spec.map α')
      (Proj.toSpecZero 𝒜 ≫ Spec.map α) (Spec.map ρ) := by
  have hs : ((α r : 𝒜 0) : A) ∈ 𝒜 0 := (α r).2
  have := isOpenImmersion_projMap φ hs hφ hf
  let := ρ.hom.toAlgebra
  have : IsOpenImmersion (Spec.map ρ) := IsOpenImmersion.of_isLocalization (R := R) (S := R') r
  refine (IsOpenImmersion.isPullback _ _ _ _ ?_ ?_).flip
  · rw [← Category.assoc, projMap_toSpecZero, Category.assoc, Category.assoc, ← Spec.map_comp,
      ← Spec.map_comp, hα]
  · have e : (Spec.map ρ).opensRange = PrimeSpectrum.basicOpen r := by
      exact TopologicalSpace.Opens.ext (PrimeSpectrum.localization_away_comap_range R' r)
    rw [e, toSpecZero_comp_preimage_basicOpen]
    exact TopologicalSpace.Opens.ext (range_projMap φ hs hφ hf).symm

end Pullback

/-! ### Quasi-coherent graded algebras and their relative Proj -/

open Scheme.AffineZariskiSite in
/-- A quasi-coherent sheaf `S` of `ℕ`-graded `𝒪_X`-algebras, recorded through its sections over
the affine opens of `X`: for each affine open `U` a graded ring `S(U)` with a ring map
`Γ(U, 𝒪_X) → S(U)₀`, compatible with restriction, such that restriction to a basic open `D(r)`
is the localization `S(U) → S(U)[1/r]` (the condition `S(D(r)) = S(U)_r` characterizing
quasi-coherence), and such that restriction preserves degrees. -/
structure QuasiCoherentGradedAlgebra (X : Scheme.{u}) where
  /-- The rings of sections `S(U)` over the affine opens `U` of `X`. -/
  obj : X.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u}
  /-- The `𝒪_X`-algebra structure `Γ(U, 𝒪_X) → S(U)`. -/
  structureMap : (toOpensFunctor X).op ⋙ X.presheaf ⟶ obj
  /-- Quasi-coherence: `S(D(r)) = S(U) ⊗_{Γ(U, 𝒪_X)} Γ(D(r), 𝒪_X) = S(U)_r`. -/
  coequifibered : structureMap.Coequifibered
  /-- The homogeneous components `S(U)_n`. -/
  grading : (U : X.AffineZariskiSite) → ℕ → AddSubgroup (obj.obj (.op U))
  /-- `S(U)` is the direct sum of its homogeneous components. -/
  gradedRing : ∀ U, GradedRing (grading U)
  /-- Restriction preserves degrees. -/
  map_mem : ∀ {U V : X.AffineZariskiSite} (f : U ⟶ V) {n : ℕ} {x : obj.obj (.op V)},
    x ∈ grading V n → obj.map f.op x ∈ grading U n
  /-- `𝒪_X` acts in degree zero. -/
  structureMap_mem : ∀ (U : X.AffineZariskiSite) (r : Γ(X, U.1)),
    structureMap.app (.op U) r ∈ grading U 0

namespace QuasiCoherentGradedAlgebra

open Scheme.AffineZariskiSite

variable {X : Scheme.{u}} (S : QuasiCoherentGradedAlgebra X)

instance (U : X.AffineZariskiSite) : GradedRing (S.grading U) := S.gradedRing U

/-- Restriction `S(V) → S(U)` along an arrow `U ⟶ V` of affine opens, as a graded ring map. -/
def restrict {U V : X.AffineZariskiSite} (f : U ⟶ V) : S.grading V →+*ᵍ S.grading U where
  __ := (S.obj.map f.op).hom
  map_mem := S.map_mem f

theorem restrict_apply {U V : X.AffineZariskiSite} (f : U ⟶ V) (x : S.obj.obj (.op V)) :
    S.restrict f x = S.obj.map f.op x :=
  rfl

/-- The structure map `Γ(U, 𝒪_X) → S(U)₀`. -/
def toZero (U : X.AffineZariskiSite) : Γ(X, U.1) ⟶ CommRingCat.of (S.grading U 0) :=
  CommRingCat.ofHom
    { toFun r := ⟨S.structureMap.app (.op U) r, S.structureMap_mem U r⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' _ _ := Subtype.ext (map_mul _ _ _)
      map_zero' := Subtype.ext (map_zero _)
      map_add' _ _ := Subtype.ext (map_add _ _ _) }

theorem coe_toZero_apply (U : X.AffineZariskiSite) (r : Γ(X, U.1)) :
    ((S.toZero U r : S.grading U 0) : S.obj.obj (.op U)) = S.structureMap.app (.op U) r :=
  rfl

theorem toZero_comp_restrict {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    S.toZero V ≫ CommRingCat.ofHom (GradedRingHom.gradedZeroRingHom (S.restrict f)) =
      X.presheaf.map ((toOpensFunctor X).map f).op ≫ S.toZero U := by
  ext r
  exact congr($(S.structureMap.naturality f.op) r).symm

theorem isLocalizationAway (U : X.AffineZariskiSite) (r : Γ(X, U.1)) :
    letI := (S.obj.map (homOfLE (U.basicOpen_le r)).op).hom.toAlgebra
    IsLocalization.Away (S.structureMap.app (.op U) r) (S.obj.obj (.op (U.basicOpen r))) :=
  coequifibered_iff_forall_isLocalizationAway.mp S.coequifibered U r

theorem irrelevant_le {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    (S.grading U)₊ ≤ (S.grading V)₊.map (S.restrict f) := by
  obtain ⟨r, hr⟩ := f.le
  obtain rfl : V.basicOpen r = U := Subtype.ext hr
  obtain rfl : f = homOfLE (V.basicOpen_le r) := rfl
  let := (S.obj.map (homOfLE (V.basicOpen_le r)).op).hom.toAlgebra
  have := S.isLocalizationAway V r
  exact irrelevant_le_map_of_isLocalizationAway (S.restrict _) (S.structureMap_mem V r)
    (fun _ ↦ rfl)

/-- The functor `U ↦ Proj S(U)` on affine opens. -/
def projFunctor : X.AffineZariskiSite ⥤ Scheme.{u} where
  obj U := Proj (S.grading U)
  map f := Proj.map (S.restrict f) (S.irrelevant_le f)
  map_id U := by
    rw [← Proj.map_id]
    congr 1
    exact GradedRingHom.ext fun x ↦ by simp [restrict_apply]
  map_comp f g := by
    rw [← Proj.map_comp]
    congr 1
    exact GradedRingHom.ext fun x ↦ by simp [restrict_apply]

theorem projMap_toSpec {U V : X.AffineZariskiSite} (f : U ⟶ V) :
    Proj.map (S.restrict f) (S.irrelevant_le f) ≫ Proj.toSpecZero (S.grading V) ≫
      Spec.map (S.toZero V) =
    (Proj.toSpecZero (S.grading U) ≫ Spec.map (S.toZero U)) ≫
      Spec.map (X.presheaf.map ((toOpensFunctor X).map f).op) := by
  rw [← Category.assoc, projMap_toSpecZero, Category.assoc, Category.assoc, ← Spec.map_comp,
    ← Spec.map_comp, toZero_comp_restrict]
  rfl

/-- The structure maps `Proj S(U) ⟶ Spec Γ(U, 𝒪_X)`. -/
def projToSpec : S.projFunctor ⟶ toOpensFunctor X ⋙ X.presheaf.rightOp ⋙ Scheme.Spec where
  app U := Proj.toSpecZero (S.grading U) ≫ Spec.map (S.toZero U)
  naturality _ _ f := S.projMap_toSpec f

theorem projToSpec_equifibered : S.projToSpec.Equifibered := by
  intro U V f
  obtain ⟨r, hr⟩ := f.le
  obtain rfl : V.basicOpen r = U := Subtype.ext hr
  obtain rfl : f = homOfLE (V.basicOpen_le r) := rfl
  let := (S.obj.map (homOfLE (V.basicOpen_le r)).op).hom.toAlgebra
  have : IsLocalization.Away ((S.toZero V r : S.grading V 0) : S.obj.obj (.op V))
      (S.obj.obj (.op (V.basicOpen r))) := S.isLocalizationAway V r
  exact isPullback_projMap (S.restrict _) (fun _ ↦ rfl)
    (X.presheaf.map ((toOpensFunctor X).map (homOfLE (V.basicOpen_le r))).op) r
    (V.2.isLocalization_basicOpen r)
    (S.toZero V) (S.toZero (V.basicOpen r)) (S.toZero_comp_restrict _) (S.irrelevant_le _)

set_option backward.isDefEq.respectTransparency.types false in
/-- The relative gluing datum `U ↦ (Proj S(U) ⟶ U)` over the affine opens of `X`. -/
def relativeGluingData : (directedCover X).RelativeGluingData where
  functor := S.projFunctor
  natTrans := S.projToSpec ≫ (restrictIsoSpec X).inv
  equifibered := S.projToSpec_equifibered.comp (.of_isIso _)

/-- The relative `Proj` of `S`: the scheme obtained by gluing the schemes `Proj S(U)` over the
affine opens `U` of `X`. -/
def relProj : Scheme.{u} :=
  S.relativeGluingData.glued

/-- The projection `Proj_X S ⟶ X`. -/
def relProjToBase : S.relProj ⟶ X :=
  S.relativeGluingData.toBase

/-- The structure map `Proj S(U) ⟶ U` of the affine piece over `U`. -/
def projToOpen (U : X.AffineZariskiSite) : Proj (S.grading U) ⟶ U.1.toScheme :=
  S.relativeGluingData.natTrans.app U

set_option backward.isDefEq.respectTransparency.types false in
theorem projToOpen_ι (U : X.AffineZariskiSite) :
    S.projToOpen U ≫ U.1.ι =
      Proj.toSpecZero (S.grading U) ≫ Spec.map (S.toZero U) ≫ U.2.fromSpec := by
  simp [projToOpen, relativeGluingData, projToSpec]
  rfl

/-- The open immersion of the affine piece `Proj S(U)` into `Proj_X S`. -/
def projι (U : X.AffineZariskiSite) : Proj (S.grading U) ⟶ S.relProj :=
  S.relativeGluingData.cover.f U

instance (U : X.AffineZariskiSite) : IsOpenImmersion (S.projι U) :=
  S.relativeGluingData.cover.map_prop U

theorem projι_relProjToBase (U : X.AffineZariskiSite) :
    S.projι U ≫ S.relProjToBase = S.projToOpen U ≫ U.1.ι :=
  S.relativeGluingData.ι_toBase U

/-- Over every affine open `U ⊆ X`, `Proj S(U)` is the fibre product `U ×_X Proj_X S`. -/
theorem isPullback_projι (U : X.AffineZariskiSite) :
    IsPullback (S.projToOpen U) (S.projι U) U.1.ι S.relProjToBase :=
  S.relativeGluingData.isPullback_natTrans_ι_toBase U

theorem relProjToBase_preimage (U : X.AffineZariskiSite) :
    S.relProjToBase ⁻¹ᵁ U.1 = (S.projι U).opensRange := by
  have := S.relativeGluingData.toBase_preimage_eq_opensRange_ι U
  simp only [Scheme.Opens.opensRange_ι] at this
  exact this

/-- The canonical comparison `(Proj_X S)|_U ≅ Proj S(U)` over an affine open `U ⊆ X`. -/
def restrictIso (U : X.AffineZariskiSite) :
    (S.relProjToBase ⁻¹ᵁ U.1).toScheme ≅ Proj (S.grading U) :=
  S.relProj.isoOfEq (S.relProjToBase_preimage U) ≪≫ (S.projι U).isoOpensRange.symm

theorem restrictIso_hom_projToOpen (U : X.AffineZariskiSite) :
    (S.restrictIso U).hom ≫ S.projToOpen U = S.relProjToBase ∣_ U.1 := by
  rw [← cancel_mono U.1.ι, Category.assoc, ← projι_relProjToBase, morphismRestrict_ι]
  simp [restrictIso]

/-! ### Hartshorne's hypotheses -/

/-- `S₀ = 𝒪_X`: the structure map identifies `Γ(U, 𝒪_X)` with the degree-zero part `S(U)₀`. -/
def DegreeZeroIsStructureSheaf : Prop :=
  ∀ U : X.AffineZariskiSite, Function.Bijective (S.toZero U)

/-- `S₁` is coherent: for every affine open `U`, `S(U)₁` is a finitely generated
`Γ(U, 𝒪_X)`-module. -/
def DegreeOneCoherent : Prop :=
  ∀ U : X.AffineZariskiSite, ∃ (k : ℕ) (m : Fin k → S.obj.obj (.op U)),
    (∀ i, m i ∈ S.grading U 1) ∧
      ∀ x ∈ S.grading U 1, ∃ c : Fin k → Γ(X, U.1),
        x = ∑ i, S.structureMap.app (.op U) (c i) * m i

/-- `S` is generated by `S₁` as an `S₀`-algebra: for every affine open `U`, `S(U)` is generated as
a ring by `S(U)₀ ∪ S(U)₁`. -/
def GeneratedInDegreeOne : Prop :=
  ∀ U : X.AffineZariskiSite,
    Subring.closure ((S.grading U 0 : Set (S.obj.obj (.op U))) ∪ S.grading U 1) = ⊤

end QuasiCoherentGradedAlgebra

/-- Hartshorne's setting for relative `Proj` (II.7, p. 160): a Noetherian scheme `X` and a
quasi-coherent graded `𝒪_X`-algebra `S` with `S₀ = 𝒪_X`, `S₁` coherent, and `S` generated by
`S₁` as an `S₀`-algebra. -/
structure RelativeProjData (X : Scheme.{u}) [IsNoetherian X] where
  /-- The quasi-coherent graded `𝒪_X`-algebra `S`. -/
  algebra : QuasiCoherentGradedAlgebra X
  /-- `S₀ = 𝒪_X`. -/
  degreeZero : algebra.DegreeZeroIsStructureSheaf
  /-- `S₁` is coherent. -/
  degreeOne_coherent : algebra.DegreeOneCoherent
  /-- `S` is generated by `S₁` as an `S₀`-algebra. -/
  generated : algebra.GeneratedInDegreeOne

namespace RelativeProjData

variable {X : Scheme.{u}} [IsNoetherian X] (D : RelativeProjData X)

/-- **Relative Proj** (Hartshorne II.7): `Proj_X S`, glued from the schemes `Proj Γ(U, S)` over
the affine opens `U` of `X`. -/
def relativeProj : Scheme.{u} :=
  D.algebra.relProj

/-- The projection `Proj_X S ⟶ X`. -/
def projection : D.relativeProj ⟶ X :=
  D.algebra.relProjToBase

/-- The canonical comparison `(Proj_X S)|_U ≅ Proj Γ(U, S)` over an affine open `U ⊆ X`. -/
def restrictIso (U : X.AffineZariskiSite) :
    (D.projection ⁻¹ᵁ U.1).toScheme ≅ Proj (D.algebra.grading U) :=
  D.algebra.restrictIso U

/-- The comparison `(Proj_X S)|_U ≅ Proj Γ(U, S)` is an isomorphism over `U`. -/
theorem restrictIso_hom_projToOpen (U : X.AffineZariskiSite) :
    (D.restrictIso U).hom ≫ D.algebra.projToOpen U = D.projection ∣_ U.1 :=
  D.algebra.restrictIso_hom_projToOpen U

end RelativeProjData

end Hartshorne
